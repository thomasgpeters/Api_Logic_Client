/* *   I M A G E R Y    B U S I N E S S     S Y S T E M S,   L L C * *   XIB Generator * *   Turns the ALS model held in gProjectDictionary into one Cocoa view XIB per *   resource, plus a "Model Tags.incl" that names every control tag, so a *   generated FB app can  nibview _customerView, @"CustomerView"  and address *   the fields by constant. * *   Model shape (from /metadata?include=attributes): *       resources -> { <Resource> -> attributes -> [ { name, type } ] } * *   Tag scheme (stable across runs; resources are sorted by name): *       view tag   = resourceIndex * 100            e.g. _customerView        = 200 *       field tag  = resourceIndex * 100 + n        e.g. _customerCompanyName = 202 * *   Type -> control *       VARCHAR(n) / CHAR(n) .......... text field, width from n *       VARCHAR(n >= 256), TEXT ....... multi-line wrapping text field *       SMALLINT / INTEGER / BIGINT ... right-aligned text field + integer formatter *       FLOAT / DECIMAL / NUMERIC ..... right-aligned text field + 2-place decimal formatter *       DATE / DATETIME / TIMESTAMP ... date picker *       BOOLEAN / BOOL / BIT .......... checkbox *       anything else ................. text field */// control kindsbegin enum 1_xibKindText_xibKindTextArea_xibKindInteger_xibKindDecimal_xibKindDate_xibKindCheckboxend enum// layout metrics, in points_xibMargin           = 20_xibLabelWidth       = 150_xibLabelHeight      = 16_xibLabelGap         = 8_xibColumnWidth      = 470_xibRowGap           = 10_xibMaxRowsPerColumn = 10_xibMinFieldWidth    = 60_xibMaxFieldWidth    = 290_xibCharWidth        = 7_xibTextAreaLength   = 256_xibTagsPerResource  = 100_xibListColumns      = 4/* *   naming helpers */local fn XibNewID as CFStringRefgXibNextID++end fn = fn StringWithFormat( @"gen-%04ld", gXibNextID )local fn XibEscape( s as CFStringRef ) as CFStringRefCFStringRef escaped = @""if ( s != NULL )escaped = fn StringByReplacingOccurrencesOfString( s,       @"&",  @"&amp;"  )escaped = fn StringByReplacingOccurrencesOfString( escaped, @"<",  @"&lt;"   )escaped = fn StringByReplacingOccurrencesOfString( escaped, @">",  @"&gt;"   )escaped = fn StringByReplacingOccurrencesOfString( escaped, @"\"", @"&quot;" )end ifend fn = escaped// "company_name" -> "Company Name",  "customer_id" -> "Customer ID"local fn XibLabelForAttribute( attrName as CFStringRef ) as CFStringRefCFStringRef label = fn StringCapitalizedString( fn StringByReplacingOccurrencesOfString( attrName, @"_", @" " ) )if ( fn StringHasSuffix( label, @" Id" ) )label = fn StringWithFormat( @"%@D", label )label = fn StringByReplacingOccurrencesOfString( label, @" IdD", @" ID" )end ifend fn = label// "Customer" -> "customer",  "OrderDetail" -> "orderDetail"local fn XibResourcePrefix( resourceName as CFStringRef ) as CFStringRefCFStringRef first = fn StringLowercaseString( fn StringSubstringToIndex( resourceName, 1 ) )end fn = fn StringWithFormat( @"%@%@", first, fn StringSubstringFromIndex( resourceName, 1 ) )// ( "Customer", "company_name" ) -> "_customerCompanyName"local fn XibConstantName( resourceName as CFStringRef, attrName as CFStringRef ) as CFStringRefCFStringRef camel = fn StringCapitalizedString( fn StringByReplacingOccurrencesOfString( attrName, @"_", @" " ) )camel = fn StringByReplacingOccurrencesOfString( camel, @" ", @"" )end fn = fn StringWithFormat( @"_%@%@", fn XibResourcePrefix( resourceName ), camel )/* *   type mapping */// "VARCHAR(40)" -> 40,  "DECIMAL(10,2)" -> 10,  "TEXT" -> 0local fn XibLengthForType( sqlType as CFStringRef ) as longlong       length = 0CFArrayRef partsif ( sqlType != NULL )parts = fn StringComponentsSeparatedByString( sqlType, @"(" )if ( fn ArrayCount( parts ) > 1 ) then length = fn StringIntegerValue( fn ArrayObjectAtIndex( parts, 1 ) )end ifend fn = lengthlocal fn XibControlKindForType( sqlType as CFStringRef ) as longlong        kind = _xibKindTextCFStringRef t    = @"TEXT"if ( sqlType != NULL ) then t = fn StringUppercaseString( sqlType )if ( fn StringHasPrefix( t, @"TEXT" ) || fn StringHasPrefix( t, @"CLOB" ) || fn StringHasPrefix( t, @"MEDIUMTEXT" ) || fn StringHasPrefix( t, @"LONGTEXT" ) ) then kind = _xibKindTextAreaif ( fn StringHasPrefix( t, @"SMALLINT" ) || fn StringHasPrefix( t, @"INT" ) || fn StringHasPrefix( t, @"BIGINT" ) || fn StringHasPrefix( t, @"TINYINT" ) ) then kind = _xibKindIntegerif ( fn StringHasPrefix( t, @"FLOAT" ) || fn StringHasPrefix( t, @"DOUBLE" ) || fn StringHasPrefix( t, @"REAL" ) || fn StringHasPrefix( t, @"DECIMAL" ) || fn StringHasPrefix( t, @"NUMERIC" ) || fn StringHasPrefix( t, @"MONEY" ) ) then kind = _xibKindDecimalif ( fn StringHasPrefix( t, @"DATE" ) || fn StringHasPrefix( t, @"TIMESTAMP" ) ) then kind = _xibKindDateif ( fn StringHasPrefix( t, @"BOOL" ) || fn StringIsEqual( t, @"BIT" ) ) then kind = _xibKindCheckbox// long strings read better wrappedif ( kind == _xibKindText && fn XibLengthForType( t ) >= _xibTextAreaLength ) then kind = _xibKindTextAreaend fn = kindlocal fn XibControlHeight( kind as long ) as longlong h = 22select ( kind )case _xibKindTextArea : h = 56case _xibKindDate     : h = 28case _xibKindCheckbox : h = 18end selectend fn = h// where the label's bottom edge sits below the row's top edgelocal fn XibLabelDrop( kind as long ) as longlong drop = 19                                   // centred on a 22pt fieldselect ( kind )case _xibKindDate     : drop = 22case _xibKindCheckbox : drop = 17end selectend fn = droplocal fn XibFieldWidth( kind as long, length as long ) as longlong w = 200select ( kind )case _xibKindTextif ( length > 0 ) then w = length * _xibCharWidth + 16case _xibKindTextArea : w = _xibMaxFieldWidthcase _xibKindInteger  : w = 80case _xibKindDecimal  : w = 100case _xibKindDate     : w = 110case _xibKindCheckbox : w = 22end selectif ( kind != _xibKindCheckbox && w < _xibMinFieldWidth ) then w = _xibMinFieldWidthif ( w > _xibMaxFieldWidth ) then w = _xibMaxFieldWidthend fn = w/* *   XML fragments */local fn XibLabelElement( text as CFStringRef, x as long, y as long ) as CFStringRefCFMutableStringRef s = fn MutableStringNewMutableStringAppendString( s, fn StringWithFormat( @"                <textField horizontalHuggingPriority=\"251\" verticalHuggingPriority=\"750\" id=\"%@\">\n", fn XibNewID ) )MutableStringAppendString( s, fn StringWithFormat( @"                    <rect key=\"frame\" x=\"%ld\" y=\"%ld\" width=\"%ld\" height=\"%ld\"/>\n", x, y, (long)_xibLabelWidth, (long)_xibLabelHeight ) )MutableStringAppendString( s,                      @"                    <autoresizingMask key=\"autoresizingMask\" flexibleMaxX=\"YES\" flexibleMinY=\"YES\"/>\n" )MutableStringAppendString( s, fn StringWithFormat( @"                    <textFieldCell key=\"cell\" lineBreakMode=\"clipping\" alignment=\"right\" title=\"%@:\" id=\"%@\">\n", fn XibEscape( text ), fn XibNewID ) )MutableStringAppendString( s,                      @"                        <font key=\"font\" usesAppearanceFont=\"YES\"/>\n" )MutableStringAppendString( s,                      @"                        <color key=\"textColor\" name=\"labelColor\" catalog=\"System\" colorSpace=\"catalog\"/>\n" )MutableStringAppendString( s,                      @"                        <color key=\"backgroundColor\" name=\"textBackgroundColor\" catalog=\"System\" colorSpace=\"catalog\"/>\n" )MutableStringAppendString( s,                      @"                    </textFieldCell>\n" )MutableStringAppendString( s,                      @"                </textField>\n" )end fn = slocal fn XibTextFieldElement( kind as long, tag as long, x as long, y as long, w as long, h as long ) as CFStringRefCFMutableStringRef s         = fn MutableStringNewCFStringRef        wrapAttrs = @"scrollable=\"YES\" lineBreakMode=\"clipping\""CFStringRef        alignment = @"left"if ( kind == _xibKindTextArea ) then wrapAttrs = @"lineBreakMode=\"wordWrapping\""if ( kind == _xibKindInteger || kind == _xibKindDecimal ) then alignment = @"right"MutableStringAppendString( s, fn StringWithFormat( @"                <textField verticalHuggingPriority=\"750\" tag=\"%ld\" id=\"%@\">\n", tag, fn XibNewID ) )MutableStringAppendString( s, fn StringWithFormat( @"                    <rect key=\"frame\" x=\"%ld\" y=\"%ld\" width=\"%ld\" height=\"%ld\"/>\n", x, y, w, h ) )MutableStringAppendString( s,                      @"                    <autoresizingMask key=\"autoresizingMask\" flexibleMaxX=\"YES\" flexibleMinY=\"YES\"/>\n" )MutableStringAppendString( s, fn StringWithFormat( @"                    <textFieldCell key=\"cell\" %@ selectable=\"YES\" editable=\"YES\" sendsActionOnEndEditing=\"YES\" borderStyle=\"bezel\" alignment=\"%@\" drawsBackground=\"YES\" id=\"%@\">\n", wrapAttrs, alignment, fn XibNewID ) )MutableStringAppendString( s,                      @"                        <font key=\"font\" usesAppearanceFont=\"YES\"/>\n" )select ( kind )case _xibKindIntegerMutableStringAppendString( s, fn StringWithFormat( @"                        <numberFormatter key=\"formatter\" formatterBehavior=\"default10_4\" usesGroupingSeparator=\"NO\" formatWidth=\"-1\" groupingSize=\"0\" minimumIntegerDigits=\"1\" maximumIntegerDigits=\"42\" id=\"%@\"/>\n", fn XibNewID ) )case _xibKindDecimalMutableStringAppendString( s, fn StringWithFormat( @"                        <numberFormatter key=\"formatter\" formatterBehavior=\"default10_4\" numberStyle=\"decimal\" formatWidth=\"-1\" minimumIntegerDigits=\"1\" maximumIntegerDigits=\"2000000000\" minimumFractionDigits=\"2\" maximumFractionDigits=\"2\" id=\"%@\"/>\n", fn XibNewID ) )end selectMutableStringAppendString( s,                      @"                        <color key=\"textColor\" name=\"controlTextColor\" catalog=\"System\" colorSpace=\"catalog\"/>\n" )MutableStringAppendString( s,                      @"                        <color key=\"backgroundColor\" name=\"textBackgroundColor\" catalog=\"System\" colorSpace=\"catalog\"/>\n" )MutableStringAppendString( s,                      @"                    </textFieldCell>\n" )MutableStringAppendString( s,                      @"                </textField>\n" )end fn = slocal fn XibDatePickerElement( tag as long, x as long, y as long, w as long, h as long ) as CFStringRefCFMutableStringRef s = fn MutableStringNewMutableStringAppendString( s, fn StringWithFormat( @"                <datePicker verticalHuggingPriority=\"750\" tag=\"%ld\" id=\"%@\">\n", tag, fn XibNewID ) )MutableStringAppendString( s, fn StringWithFormat( @"                    <rect key=\"frame\" x=\"%ld\" y=\"%ld\" width=\"%ld\" height=\"%ld\"/>\n", x, y, w, h ) )MutableStringAppendString( s,                      @"                    <autoresizingMask key=\"autoresizingMask\" flexibleMaxX=\"YES\" flexibleMinY=\"YES\"/>\n" )MutableStringAppendString( s, fn StringWithFormat( @"                    <datePickerCell key=\"cell\" borderStyle=\"bezel\" alignment=\"left\" id=\"%@\">\n", fn XibNewID ) )MutableStringAppendString( s,                      @"                        <font key=\"font\" metaFont=\"system\"/>\n" )MutableStringAppendString( s,                      @"                        <date key=\"date\" timeIntervalSinceReferenceDate=\"0.0\"/>\n" )MutableStringAppendString( s,                      @"                        <color key=\"textColor\" name=\"controlTextColor\" catalog=\"System\" colorSpace=\"catalog\"/>\n" )MutableStringAppendString( s,                      @"                        <color key=\"backgroundColor\" name=\"controlBackgroundColor\" catalog=\"System\" colorSpace=\"catalog\"/>\n" )MutableStringAppendString( s,                      @"                        <datePickerElements key=\"datePickerElements\" year=\"YES\" month=\"YES\" day=\"YES\"/>\n" )MutableStringAppendString( s,                      @"                    </datePickerCell>\n" )MutableStringAppendString( s,                      @"                </datePicker>\n" )end fn = slocal fn XibCheckboxElement( tag as long, x as long, y as long, w as long, h as long ) as CFStringRefCFMutableStringRef s = fn MutableStringNewMutableStringAppendString( s, fn StringWithFormat( @"                <button tag=\"%ld\" id=\"%@\">\n", tag, fn XibNewID ) )MutableStringAppendString( s, fn StringWithFormat( @"                    <rect key=\"frame\" x=\"%ld\" y=\"%ld\" width=\"%ld\" height=\"%ld\"/>\n", x, y, w, h ) )MutableStringAppendString( s,                      @"                    <autoresizingMask key=\"autoresizingMask\" flexibleMaxX=\"YES\" flexibleMinY=\"YES\"/>\n" )MutableStringAppendString( s, fn StringWithFormat( @"                    <buttonCell key=\"cell\" type=\"check\" bezelStyle=\"regularSquare\" imagePosition=\"left\" inset=\"2\" id=\"%@\">\n", fn XibNewID ) )MutableStringAppendString( s,                      @"                        <behavior key=\"behavior\" changeContents=\"YES\" doesNotDimImage=\"YES\" lightByContents=\"YES\"/>\n" )MutableStringAppendString( s,                      @"                        <font key=\"font\" metaFont=\"system\"/>\n" )MutableStringAppendString( s,                      @"                    </buttonCell>\n" )MutableStringAppendString( s,                      @"                </button>\n" )end fn = slocal fn XibFieldElement( kind as long, tag as long, x as long, y as long, w as long, h as long ) as CFStringRefCFStringRef elementselect ( kind )case _xibKindDate     : element = fn XibDatePickerElement( tag, x, y, w, h )case _xibKindCheckbox : element = fn XibCheckboxElement( tag, x, y, w, h )case else             : element = fn XibTextFieldElement( kind, tag, x, y, w, h )end selectend fn = element/* *   one resource -> one XIB document *   appends the resource's tag constants to tagGlobals, and describes the *   resource in resourceModel for Model.json (read by the generated app's ALS App.incl) */local fn XibViewDocument( resourceName as CFStringRef, attributes as CFArrayRef, baseTag as long, tagGlobals as CFMutableStringRef, resourceModel as CFMutableDictionaryRef ) as CFStringRefCFMutableStringRef xml = fn MutableStringNewCFMutableArrayRef  modelFields  = fn MutableArrayNewCFMutableArrayRef  listColumns  = fn MutableArrayNewCFDictionaryRef    attrCFStringRef        attrName, sqlType, prefixlong               count, i, kind, length, h, w, col, lastCol, rowsPerColumn, columnslong               col0Height = 0, col1Height = 0, viewWidth, viewHeight, yTop, x0, tagcount = fn ArrayCount( attributes )columns = 1rowsPerColumn = countif ( count > _xibMaxRowsPerColumn )columns = 2rowsPerColumn = count - ( count - ( count mod 2 ) ) / 2        // ceil( count / 2 ) without integer divisionend if// pass 1 - measure each columnfor i = 0 to count - 1attr    = fn ArrayObjectAtIndex( attributes, i )kind    = fn XibControlKindForType( fn DictionaryObjectForKey( attr, @"type" ) )h       = fn XibControlHeight( kind ) + _xibRowGapif ( i < rowsPerColumn ) then col0Height += h else col1Height += hnextviewHeight = col0Heightif ( col1Height > viewHeight ) then viewHeight = col1HeightviewHeight = viewHeight - _xibRowGap + ( _xibMargin * 2 )viewWidth  = _xibMargin + ( columns * _xibColumnWidth )// tag constants for the generated appprefix = fn XibResourcePrefix( resourceName )MutableStringAppendString( tagGlobals, fn StringWithFormat( @"\n// %@  ( %@View.xib )\n", resourceName, resourceName ) )MutableStringAppendString( tagGlobals, fn StringWithFormat( @"_%@View = %ld\n",       prefix, baseTag ) )MutableStringAppendString( tagGlobals, fn StringWithFormat( @"_%@ViewWidth = %ld\n",  prefix, viewWidth ) )MutableStringAppendString( tagGlobals, fn StringWithFormat( @"_%@ViewHeight = %ld\n", prefix, viewHeight ) )// document headerMutableStringAppendString( xml, @"<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n" )MutableStringAppendString( xml, @"<document type=\"com.apple.InterfaceBuilder3.Cocoa.XIB\" version=\"3.0\" toolsVersion=\"22146\" targetRuntime=\"MacOSX.Cocoa\" propertyAccessControl=\"none\" useAutolayout=\"YES\" customObjectInstantitationMethod=\"direct\">\n" )MutableStringAppendString( xml, @"    <dependencies>\n" )MutableStringAppendString( xml, @"        <plugIn identifier=\"com.apple.InterfaceBuilder.CocoaPlugin\" version=\"22146\"/>\n" )MutableStringAppendString( xml, @"        <capability name=\"documents saved in the Xcode 8 format\" minToolsVersion=\"8.0\"/>\n" )MutableStringAppendString( xml, @"    </dependencies>\n" )MutableStringAppendString( xml, @"    <objects>\n" )MutableStringAppendString( xml, @"        <customObject id=\"-2\" userLabel=\"File's Owner\"/>\n" )MutableStringAppendString( xml, @"        <customObject id=\"-1\" userLabel=\"First Responder\" customClass=\"FirstResponder\"/>\n" )MutableStringAppendString( xml, @"        <customObject id=\"-3\" userLabel=\"Application\" customClass=\"NSObject\"/>\n" )MutableStringAppendString( xml, fn StringWithFormat( @"        <customView id=\"%@\" userLabel=\"%@ View\">\n", fn XibNewID, fn XibEscape( resourceName ) ) )MutableStringAppendString( xml, fn StringWithFormat( @"            <rect key=\"frame\" x=\"0.0\" y=\"0.0\" width=\"%ld\" height=\"%ld\"/>\n", viewWidth, viewHeight ) )MutableStringAppendString( xml, @"            <autoresizingMask key=\"autoresizingMask\" flexibleMaxX=\"YES\" flexibleMinY=\"YES\"/>\n" )MutableStringAppendString( xml, @"            <subviews>\n" )// pass 2 - lay out label + control rows, top-down (Cocoa y grows upward)lastCol = -1for i = 0 to count - 1attr     = fn ArrayObjectAtIndex( attributes, i )attrName = fn DictionaryObjectForKey( attr, @"name" )sqlType  = fn DictionaryObjectForKey( attr, @"type" )kind     = fn XibControlKindForType( sqlType )length   = fn XibLengthForType( sqlType )h        = fn XibControlHeight( kind )w        = fn XibFieldWidth( kind, length )tag      = baseTag + i + 1col = 0if ( i >= rowsPerColumn ) then col = 1if ( col != lastCol )yTop    = viewHeight - _xibMarginlastCol = colend ifx0 = _xibMargin + ( col * _xibColumnWidth )MutableStringAppendString( xml, fn XibLabelElement( fn XibLabelForAttribute( attrName ), x0, yTop - fn XibLabelDrop( kind ) ) )MutableStringAppendString( xml, fn XibFieldElement( kind, tag, x0 + _xibLabelWidth + _xibLabelGap, yTop - h, w, h ) )MutableStringAppendString( tagGlobals, fn StringWithFormat( @"%@ = %ld\t\t// %@\n", fn XibConstantName( resourceName, attrName ), tag, sqlType ) )if ( sqlType == NULL ) then sqlType = @""MutableArrayAddObject( modelFields, @{ @"name":attrName, @"label":fn XibLabelForAttribute( attrName ), @"type":sqlType, @"kind":fn NumberWithInteger( kind ), @"tag":fn NumberWithInteger( tag ) } )// the records table shows the first few short fieldsif ( fn ArrayCount( listColumns ) < _xibListColumns && kind != _xibKindTextArea ) then MutableArrayAddObject( listColumns, attrName )yTop = yTop - h - _xibRowGapnext// document footerMutableStringAppendString( xml, @"            </subviews>\n" )MutableStringAppendString( xml, @"            <point key=\"canvasLocation\" x=\"0.0\" y=\"0.0\"/>\n" )MutableStringAppendString( xml, @"        </customView>\n" )MutableStringAppendString( xml, @"    </objects>\n" )MutableStringAppendString( xml, @"</document>\n" )MutableDictionarySetObjectForKey( resourceModel, resourceName,                                     @"name" )MutableDictionarySetObjectForKey( resourceModel, fn StringWithFormat( @"%@View", resourceName ),  @"nib" )MutableDictionarySetObjectForKey( resourceModel, fn NumberWithInteger( baseTag ),                 @"viewTag" )MutableDictionarySetObjectForKey( resourceModel, fn NumberWithInteger( viewWidth ),               @"viewWidth" )MutableDictionarySetObjectForKey( resourceModel, fn NumberWithInteger( viewHeight ),              @"viewHeight" )MutableDictionarySetObjectForKey( resourceModel, listColumns,                                      @"listColumns" )MutableDictionarySetObjectForKey( resourceModel, modelFields,                                      @"fields" )end fn = xml/* *   whole project -> <folder>/<Resource>View.xib  +  <folder>/Model Tags.incl *   adds one entry per written XIB to modelResources; returns the number of XIBs written */local fn XibGenerateProject( projectDict as CFDictionaryRef, folderURL as CFURLRef, projectLabel as CFStringRef, modelResources as CFMutableArrayRef ) as longCFDictionaryRef        resources, resourceCFArrayRef             names, attributesCFStringRef            name, xmlCFMutableStringRef     tagGlobalsCFMutableDictionaryRef resourceModelCFURLRef           fileURLErrorRef           err = NULLlong               resourceIndex = 0, written = 0if ( projectDict == NULL || folderURL == NULL ) then exit fn = 0resources = fn DictionaryObjectForKey( projectDict, @"resources" )if ( resources == NULL )if (isLoggingOn) then NSLog( @"XibGenerateProject: no resources loaded - fetch or open the metadata first." )exit fn = 0end iftagGlobals = fn MutableStringNewMutableStringAppendString( tagGlobals, fn StringWithFormat( @"/*\n *   %@\n *   Generated by Api Logic Client - view and control tags, for your own code in the generated app.\n *   Regenerating overwrites this file.\n */\n", projectLabel ) )// sorted so tags stay stable when the model is regeneratednames = fn ArraySortedArrayUsingSelector( fn DictionaryAllKeys( resources ), @"compare:" )for name in namesresourceIndex++resource   = fn DictionaryObjectForKey( resources, name )attributes = fn DictionaryObjectForKey( resource, @"attributes" )if ( attributes != NULL )if ( fn ArrayCount( attributes ) >= _xibTagsPerResource )if (isLoggingOn) then NSLog( @"Skipping %@: %ld attributes exceeds the %ld tags reserved per resource.", name, fn ArrayCount( attributes ), (long)_xibTagsPerResource )elsegXibNextID = 0resourceModel = fn MutableDictionaryNewxml     = fn XibViewDocument( name, attributes, resourceIndex * _xibTagsPerResource, tagGlobals, resourceModel )fileURL = fn URLByAppendingPathComponent( folderURL, fn StringWithFormat( @"%@View.xib", name ) )if ( fn StringWriteToURL( xml, fileURL, YES, NSUTF8StringEncoding, @err ) )written++MutableArrayAddObject( modelResources, resourceModel )if (isLoggingOn) then NSLog( @"Wrote %@", fn URLPath( fileURL ) )elseif (isLoggingOn) then NSLog( @"Could not write %@: %@", fn URLPath( fileURL ), fn ErrorLocalizedDescription( err ) )end ifend ifend ifnextfileURL = fn URLByAppendingPathComponent( folderURL, @"Model Tags.incl" )if ( fn StringWriteToURL( fn StringByReplacingOccurrencesOfString( tagGlobals, @"\n", @"\r" ), fileURL, YES, NSUTF8StringEncoding, @err ) == NO )if (isLoggingOn) then NSLog( @"Could not write %@: %@", fn URLPath( fileURL ), fn ErrorLocalizedDescription( err ) )end ifend fn = written