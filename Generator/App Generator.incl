/* *   I M A G E R Y    B U S I N E S S     S Y S T E M S,   L L C * *   App Generator * *   ALS model -> a complete FutureBasic project in ~/ApiLogicClient/<project>/ * *       <project>.fb        main program: connection settings, event hooks, includes *       Model.json          resources, fields, kinds and tags - read at run time by ALS App.incl *       Model Tags.incl     tag constants for your own code *       <Resource>View.xib  one detail view per resource (XIB Generator.incl) *       ALS Client.incl     ALS JSON:API client         \ *       ALS Binding.incl    record <-> control binding   >  runtime, copied from ../Runtime via this app's bundle *       ALS App.incl        master-detail window/events / * *   The generated project contains only our own code; it relies on the user's *   FutureBasic install for the Cocoa toolboxes, which are never copied. */#define APP_DEFAULT_LOGIN_PATH  @"/api/auth/login"#define APP_FALLBACK_LOGIN_PATH @"/api/authentication-User/login"#define APP_DEFAULT_PAGE_LIMIT  100// FB source files use classic-Mac line endingslocal fn AppWriteSource( source as CFStringRef, folderURL as CFURLRef, fileName as CFStringRef ) as BOOLErrorRef err = NULLCFURLRef url = fn URLByAppendingPathComponent( folderURL, fileName )BOOL     ok  = fn StringWriteToURL( fn StringByReplacingOccurrencesOfString( source, @"\n", @"\r" ), url, YES, NSUTF8StringEncoding, @err )if ( ok == NO && isLoggingOn ) then NSLog( @"Could not write %@: %@", fn URLPath( url ), fn ErrorLocalizedDescription( err ) )end fn = ok// text safe to place inside an FB @"..." literallocal fn AppQuote( s as CFStringRef ) as CFStringRefif ( s == NULL ) then exit fn = @""s = fn StringByReplacingOccurrencesOfString( s, @"\\", @"\\\\" )end fn = fn StringByReplacingOccurrencesOfString( s, @"\"", @"\\\"" )local fn AppCopyRuntimeFile( baseName as CFStringRef, folderURL as CFURLRef ) as BOOLCFURLRef srcURL, dstURLErrorRef err = NULLsrcURL = fn BundleURLForResource( fn BundleMain, baseName, @"incl", NULL )if ( srcURL == NULL )if (isLoggingOn) then NSLog( @"%@.incl is not in the app bundle - check the Runtime resources in the FB project.", baseName )exit fn = NOend ifdstURL = fn URLByAppendingPathComponent( folderURL, fn StringWithFormat( @"%@.incl", baseName ) )if ( fn FileManagerFileExistsAtURL( dstURL ) ) then fn FileManagerRemoveItemAtURL( dstURL, @err )if ( fn FileManagerCopyItemAtURL( srcURL, dstURL, @err ) == NO )if (isLoggingOn) then NSLog( @"Could not copy %@.incl: %@", baseName, fn ErrorLocalizedDescription( err ) )exit fn = NOend ifend fn = YESlocal fn AppWriteModel( modelResources as CFArrayRef, folderURL as CFURLRef, projectLabel as CFStringRef ) as BOOLCFDataRef jsonErrorRef  err = NULLCFURLRef  url = fn URLByAppendingPathComponent( folderURL, @"Model.json" )json = fn JSONSerializationDataWithJSONObject( @{ @"project":projectLabel, @"resources":modelResources }, NSJSONWritingPrettyPrinted, @err )if ( json == NULL ) then exit fn = NOif ( fn DataWriteToURL( json, url, NSDataWritingAtomic, @err ) == NO )if (isLoggingOn) then NSLog( @"Could not write %@: %@", fn URLPath( url ), fn ErrorLocalizedDescription( err ) )exit fn = NOend ifend fn = YESlocal fn AppMainProgram( projectLabel as CFStringRef, modelResources as CFArrayRef, hostURL as CFStringRef, userName as CFStringRef ) as CFStringRefCFMutableStringRef s = fn MutableStringNewCFDictionaryRef    resourceCFStringRef        securityOn = @"NO"if ( fn StringLength( userName ) > 0 ) then securityOn = @"YES"MutableStringAppendString( s, fn StringWithFormat( @"/*\n *   %@\n *\n", projectLabel ) )MutableStringAppendString( s, fn StringWithFormat( @" *   Generated by Api Logic Client from %@/metadata\n", hostURL ) )MutableStringAppendString( s, @" *   Regenerating overwrites every generated file, including this one.\n" )MutableStringAppendString( s, @" *   Put your own code in separate .incl files and include them below.\n */\n\n" )MutableStringAppendString( s, @"include \"ALS Client.incl\"\n" )MutableStringAppendString( s, @"include \"ALS Binding.incl\"\n" )MutableStringAppendString( s, @"include \"ALS App.incl\"\n" )MutableStringAppendString( s, @"include \"Model Tags.incl\"\n\n" )MutableStringAppendString( s, @"include resources \"Model.json\"\n" )for resource in modelResourcesMutableStringAppendString( s, fn StringWithFormat( @"include resources \"%@.xib\"\n", fn DictionaryObjectForKey( resource, @"nib" ) ) )nextMutableStringAppendString( s, @"\n// connection\n" )MutableStringAppendString( s, fn StringWithFormat( @"gALSHost              = @\"%@\"\n", fn AppQuote( hostURL ) ) )MutableStringAppendString( s, fn StringWithFormat( @"gALSLoginPath         = @\"%@\"   // stock ALS\n", APP_DEFAULT_LOGIN_PATH ) )MutableStringAppendString( s, fn StringWithFormat( @"gALSFallbackLoginPath = @\"%@\"   // tried when the first is not found\n", APP_FALLBACK_LOGIN_PATH ) )MutableStringAppendString( s, fn StringWithFormat( @"gALSUser              = @\"%@\"\n", fn AppQuote( userName ) ) )MutableStringAppendString( s, fn StringWithFormat( @"gALSSecurityOn        = %@\n", securityOn ) )MutableStringAppendString( s, fn StringWithFormat( @"gALSPageLimit         = %ld\n\n", (long)APP_DEFAULT_PAGE_LIMIT ) )MutableStringAppendString( s, @"// event hooks - add your own handling around the generated behaviour\n" )MutableStringAppendString( s, @"void local fn DoAppEvent( ev as long )\n" )MutableStringAppendString( s, @"fn ALSDoAppEvent( ev )\n" )MutableStringAppendString( s, @"end fn\n\n" )MutableStringAppendString( s, @"void local fn DoMenu( menuID as long, itemID as long )\n" )MutableStringAppendString( s, @"fn ALSDoMenu( menuID, itemID )\n" )MutableStringAppendString( s, @"end fn\n\n" )MutableStringAppendString( s, @"void local fn DoDialog( ev as long, tag as long, wnd as long )\n" )MutableStringAppendString( s, @"fn ALSDoDialog( ev, tag, wnd )\n" )MutableStringAppendString( s, @"end fn\n\n" )MutableStringAppendString( s, @"on appevent fn DoAppEvent\n" )MutableStringAppendString( s, @"on menu fn DoMenu\n" )MutableStringAppendString( s, @"on dialog fn DoDialog\n\n" )MutableStringAppendString( s, fn StringWithFormat( @"fn ALSAppStart( @\"%@\" )\n\n", fn AppQuote( projectLabel ) ) )MutableStringAppendString( s, @"HandleEvents\n" )end fn = s/* *   the whole pipeline - returns YES when every file was written */local fn AppGenerateProject( projectDict as CFDictionaryRef, folderURL as CFURLRef, projectLabel as CFStringRef, hostURL as CFStringRef, userName as CFStringRef ) as BOOLCFMutableArrayRef modelResources = fn MutableArrayNewlong              xibCountBOOL              okif ( fn StringHasSuffix( hostURL, @"/" ) ) then hostURL = fn StringSubstringToIndex( hostURL, fn StringLength( hostURL ) - 1 )xibCount = fn XibGenerateProject( projectDict, folderURL, projectLabel, modelResources )if ( xibCount == 0 ) then exit fn = NOok = fn AppWriteModel( modelResources, folderURL, projectLabel )if ( fn AppWriteSource( fn AppMainProgram( projectLabel, modelResources, hostURL, userName ), folderURL, fn StringWithFormat( @"%@.fb", projectLabel ) ) == NO ) then ok = NOif ( fn AppCopyRuntimeFile( @"ALS Client",  folderURL ) == NO ) then ok = NOif ( fn AppCopyRuntimeFile( @"ALS Binding", folderURL ) == NO ) then ok = NOif ( fn AppCopyRuntimeFile( @"ALS App",     folderURL ) == NO ) then ok = NOif (isLoggingOn) then NSLog( @"Generated %@: %ld views, %@", projectLabel, xibCount, fn URLPath( folderURL ) )end fn = ok