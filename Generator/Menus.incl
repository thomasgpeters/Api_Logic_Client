// menus_mApplication = 0begin enum 1_iSeparator// required for Application menu_iPreferencesend enum_mFile = 1begin enum 1_iCloseend enum_mHello = 2begin enum 1_iSayHelloend enum_mXibs = 3                  // the Model menu - item numbers are display positionsbegin enum 1_iOpenSQLite_iOpenMetadata_iModelSeparator1_iGenerateXIBs_iGenerateXIB_iGenerateBinding_iGenerateApp_iModelSeparator2_iOpenOneXibend enum_mHelp = 4void local fn BuildMenu// preferencesmenu _mApplication, _iSeparator// required for Application menumenu _mApplication, _iPreferences,, @"Preferences…", @","// filemenu _mFile,,, @"File"menu _mFile, _iClose,, @"Close", @"w"MenuItemSetAction( _mFile, _iClose, @"performClose:" )// hellomenu _mHello,,, @"Hello"menu _mHello, _iSayHello,, @"Say Hello", @"l"menu _mXibs,,, @"Model"menu _mXibs, _iOpenSQLite,,      @"Open SQLite Database…", @"d"menu _mXibs, _iOpenMetadata,,    @"Open Metadata JSON…", @"j"menu _mXibs, _iModelSeparator1menu _mXibs, _iGenerateXIBs,,    @"Generate XIBs", @"x"menu _mXibs, _iGenerateXIB,,     @"Generate XIB for Selected Entity", @"e"menu _mXibs, _iGenerateBinding,, @"Generate Binding Code", @"b"menu _mXibs, _iGenerateApp,,     @"Generate App", @"g"menu _mXibs, _iModelSeparator2menu _mXibs, _iOpenOneXib,,      @"Open One Xib", @"o"// helphelpmenu _mHelpend fn