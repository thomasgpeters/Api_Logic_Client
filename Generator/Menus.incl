// menus_mApplication = 0begin enum 1_iSeparator// required for Application menu_iPreferencesend enum_mFile = 1begin enum 1_iCloseend enum_mHello = 2begin enum 1_iSayHelloend enum_mXibs = 3begin enum 1_iCheckXibs_iOpenOneXib_iOpenMetadataend enum_mHelp = 4void local fn BuildMenu// preferencesmenu _mApplication, _iSeparator// required for Application menumenu _mApplication, _iPreferences,, @"Preferences…", @","// filemenu _mFile,,, @"File"menu _mFile, _iClose,, @"Close", @"w"MenuItemSetAction( _mFile, _iClose, @"performClose:" )// hellomenu _mHello,,, @"Hello"menu _mHello, _iSayHello,, @"Say Hello", @"l"menu _mXibs,,, @"XIBs"menu _mXibs, _iCheckXibs,, @"Generate App", @"x"menu _mXibs, _iOpenOneXib,, @"Open One Xib", @"o"menu _mXibs, _iOpenMetadata,, @"Open Metadata JSON…", @"j"// helphelpmenu _mHelpend fn