/* *   Rules.incl - the Customs sample's business rules (LogicBank for FutureBasic) * *   The Customs sample (samples/Customs, set in Bermuda, with automated clearance): copy this file over the *   generated app's Rules.incl (FBapp/Rules.incl - the starting template; regeneration never overwrites it). *   The same rules as samples/Customs/customs_rules.py, which test_rules.py runs scenario by scenario. *   Research and sources: docs/research/Customs Clearance Research.md. * *       value      the price paid (FOB) x the week's exchange rate, rounded first; CIF for statistics *       duty       ad valorem, specific or compound, stepped (cars); relief for approved importers; *                  wharfage except personal baggage; a personal allowance (resident 300, visitor 50) *       manifest   house bills' packages add up to the master bill's; a late security filing is a risk *       risk       the score and the lane: green, yellow (documents), red (examination), blue (audit *                  later), and a random draw to red *       release    the first reason it cannot be released; Releasable when none; Status R only then *       bond       open statements may owe no more than the importer's bond *       the gate   released goods, transponder, seal, truck, driver, route * *   MIT License. Copyright (c) 2026 Imagery Business Systems, LLC. */// --- helpers ------------------------------------------------------------------------------------------// floor( x + 0.5 ) at this many decimals - the reference rounds the same waylocal fn CustomsRounded( x as double, decimals as long ) as doubledouble scale = 1.0long ifor i = 1 to decimalsscale = scale * 10.0nextend fn = fn floor( x * scale + 0.5 ) / scale// text, never NULLlocal fn CustomsText( textValue as CFStringRef ) as CFStringRefif ( textValue == NULL ) then exit fn = @""end fn = textValue// is ISO date a before ISO date b?  (they compare as text)local fn CustomsBefore( a as CFStringRef, b as CFStringRef ) as BOOLend fn = ( fn StringCompare( fn CustomsText( a ), fn CustomsText( b ) ) == NSOrderedAscending )// the day number of an ISO date (yyyy-MM-dd) - the Julian day; -1 when it cannot be readlocal fn CustomsDayNumber( isoDate as CFStringRef ) as longlong y, m, d, aif ( isoDate == NULL ) then exit fn = -1if ( fn StringLength( isoDate ) < 10 ) then exit fn = -1y = fn StringIntegerValue( fn StringSubstringWithRange( isoDate, fn CFRangeMake( 0, 4 ) ) )m = fn StringIntegerValue( fn StringSubstringWithRange( isoDate, fn CFRangeMake( 5, 2 ) ) )d = fn StringIntegerValue( fn StringSubstringWithRange( isoDate, fn CFRangeMake( 8, 2 ) ) )if ( y < 1900 || m < 1 || m > 12 || d < 1 || d > 31 ) then exit fn = -1a = fix( ( m - 14 ) / 12.0 )end fn = d - 32075 + fix( 1461 * ( y + 4800 + a ) / 4.0 ) + fix( 367 * ( m - 2 - a * 12 ) / 12.0 ) - fix( 3 * fix( ( y + 4900 + a ) / 100.0 ) / 4.0 )// a stored yes / no (BOOLEAN: 1 / 0 / empty)local fn CustomsYes( value as CFTypeRef ) as BOOLif ( fn DataIsNull( value ) ) then exit fn = NOend fn = ( fn LogicNumberOf( value ) != 0 )local fn CustomsIs( logicRow as LogicRowRef, attrName as CFStringRef, code as CFStringRef ) as BOOLend fn = fn StringIsEqual( fn LogicString( logicRow, attrName ), code )// --- reference data ------------------------------------------------------------------------------------local fn TariffRatesValid( logicRow as LogicRowRef ) as BOOLdouble adValorem = fn LogicDouble( logicRow, @"DutyRate" )end fn = ( adValorem >= 0 && adValorem <= 300 && fn LogicDouble( logicRow, @"SpecificRate" ) >= 0 && fn LogicDouble( logicRow, @"RateAbove" ) >= 0 )local fn ExchangeRatePositive( logicRow as LogicRowRef ) as BOOLend fn = ( fn LogicDouble( logicRow, @"Rate" ) > 0 )// --- importers and statements ----------------------------------------------------------------------------local fn ImporterCompliancePoints( logicRow as LogicRowRef ) as CFTypeRefdouble points = fn LogicDouble( logicRow, @"ComplianceBase" ) - fn LogicDouble( logicRow, @"PenaltyPoints" )if ( points < 0 ) then points = 0end fn = fn NumberWithLong( points )local fn StatementOpen( logicRow as LogicRowRef ) as BOOLend fn = fn CustomsIs( logicRow, @"Status", @"O" )local fn ImporterWithinBond( logicRow as LogicRowRef ) as BOOLend fn = ( fn LogicDouble( logicRow, @"StatementBalance" ) <= fn LogicDouble( logicRow, @"BondAmount" ) )local fn DeclarationReleased( logicRow as LogicRowRef ) as BOOLend fn = fn CustomsIs( logicRow, @"Status", @"R" )// 10 % of the year's duty, at least 10,000local fn ImporterRequiredBond( logicRow as LogicRowRef ) as CFTypeRefdouble required = fn CustomsRounded( fn LogicDouble( logicRow, @"YearDuty" ) * 0.10, 0 )if ( required < 10000 ) then required = 10000end fn = fn NumberWithDouble( required )local fn ImporterBondSufficient( logicRow as LogicRowRef ) as CFTypeRefif ( fn LogicDouble( logicRow, @"BondAmount" ) >= fn LogicDouble( logicRow, @"RequiredBond" ) ) then exit fn = fn NumberWithLong( 1 )end fn = fn NumberWithLong( 0 )local fn StatementBalance( logicRow as LogicRowRef ) as CFTypeRefend fn = fn NumberWithDouble( fn CustomsRounded( fn LogicDouble( logicRow, @"Total" ) - fn LogicDouble( logicRow, @"Paid" ), 2 ) )local fn StatementClosesPaid( logicRow as LogicRowRef ) as BOOLif ( fn CustomsIs( logicRow, @"Status", @"C" ) == NO ) then exit fn = YESend fn = ( fn LogicDouble( logicRow, @"Balance" ) <= 0 )local fn StatementImporterOnStatement( logicRow as LogicRowRef ) as BOOLend fn = fn CustomsYes( fn LogicParentValue( logicRow, @"Importer", @"OnStatement" ) )// --- the manifest ------------------------------------------------------------------------------------------local fn MasterManifestMatch( logicRow as LogicRowRef ) as CFTypeRefif ( fn LogicDouble( logicRow, @"HouseCount" ) == 0 || fn LogicDouble( logicRow, @"HousePackages" ) == fn LogicDouble( logicRow, @"Packages" ) ) then exit fn = fn NumberWithLong( 1 )end fn = fn NumberWithLong( 0 )// filed less than a day before lading, or not at alllocal fn HouseLateFiling( logicRow as LogicRowRef ) as CFTypeReflong filedDay = fn CustomsDayNumber( fn LogicString( logicRow, @"SecurityFiled" ) ), ladingDay = fn CustomsDayNumber( fn LogicString( logicRow, @"LadingDate" ) )if ( filedDay < 0 || ladingDay < 0 ) then exit fn = fn NumberWithLong( 1 )if ( ladingDay - filedDay < 1 ) then exit fn = fn NumberWithLong( 1 )end fn = fn NumberWithLong( 0 )// --- declaration lines ---------------------------------------------------------------------------------------local fn LineValue( logicRow as LogicRowRef ) as CFTypeRefend fn = fn NumberWithDouble( fn CustomsRounded( fn LogicDouble( logicRow, @"InvoiceValue" ) * fn LogicParentDouble( logicRow, @"Declaration", @"Rate" ), 2 ) )// ad valorem (stepped above a value) + specific; none with relieflocal fn LineDuty( logicRow as LogicRowRef ) as CFTypeRefdouble lineValue = fn LogicDouble( logicRow, @"Value" ), stepValue = fn LogicDouble( logicRow, @"StepAbove" ), adValoremif ( fn CustomsYes( fn LogicValue( logicRow, @"ReliefClaimed" ) ) ) then exit fn = fn NumberWithDouble( 0.0 )if ( stepValue > 0 && lineValue > stepValue )adValorem = stepValue * fn LogicDouble( logicRow, @"DutyRate" ) / 100.0 + ( lineValue - stepValue ) * fn LogicDouble( logicRow, @"RateAbove" ) / 100.0elseadValorem = lineValue * fn LogicDouble( logicRow, @"DutyRate" ) / 100.0end ifend fn = fn NumberWithDouble( fn CustomsRounded( adValorem + fn LogicDouble( logicRow, @"Quantity" ) * fn LogicDouble( logicRow, @"SpecificRate" ), 2 ) )local fn LineWharfage( logicRow as LogicRowRef ) as CFTypeRefif ( fn StringIsEqual( fn LogicParentString( logicRow, @"Declaration", @"Kind" ), @"P" ) ) then exit fn = fn NumberWithDouble( 0.0 )end fn = fn NumberWithDouble( fn CustomsRounded( fn LogicDouble( logicRow, @"Value" ) * fn LogicParentDouble( logicRow, @"Declaration", @"WharfageRate" ) / 100.0, 2 ) )local fn LineUndervalued( logicRow as LogicRowRef ) as CFTypeRefdouble reference = fn LogicDouble( logicRow, @"ReferencePrice" ), quantity = fn LogicDouble( logicRow, @"Quantity" )if ( reference > 0 && quantity > 0 )if ( fn LogicDouble( logicRow, @"Value" ) / quantity < reference / 2.0 ) then exit fn = fn NumberWithLong( 1 )end ifend fn = fn NumberWithLong( 0 )local fn PermitApproved( logicRow as LogicRowRef ) as BOOLend fn = fn CustomsIs( logicRow, @"Status", @"A" )local fn LinePermitMissing( logicRow as LogicRowRef ) as CFTypeRefif ( fn StringLength( fn LogicString( logicRow, @"AgencyCode" ) ) > 0 && fn LogicDouble( logicRow, @"ApprovedPermits" ) == 0 ) then exit fn = fn NumberWithLong( 1 )end fn = fn NumberWithLong( 0 )local fn LineQuantityPositive( logicRow as LogicRowRef ) as BOOLend fn = ( fn LogicDouble( logicRow, @"Quantity" ) > 0 )local fn LineValueNotNegative( logicRow as LogicRowRef ) as BOOLend fn = ( fn LogicDouble( logicRow, @"InvoiceValue" ) >= 0 )local fn LineReliefApproved( logicRow as LogicRowRef ) as BOOLif ( fn CustomsYes( fn LogicValue( logicRow, @"ReliefClaimed" ) ) == NO ) then exit fn = YESend fn = fn CustomsYes( fn LogicParentValue( logicRow, @"Declaration", @"ReliefApproved" ) )local fn PermitRightAgency( logicRow as LogicRowRef ) as BOOLend fn = fn StringIsEqual( fn LogicString( logicRow, @"AgencyCode" ), fn LogicParentString( logicRow, @"DeclarationLine", @"AgencyCode" ) )// --- the declaration: value, duty, what is owed ------------------------------------------------------------------local fn DeclarationRate( logicRow as LogicRowRef ) as CFTypeRefend fn = fn NumberWithDouble( fn LogicParentDouble( logicRow, @"ExchangeRate", @"Rate" ) )// the rate's week is the week the entry was lodgedlocal fn DeclarationRateWeek( logicRow as LogicRowRef ) as BOOLlong weekDay = fn CustomsDayNumber( fn LogicParentString( logicRow, @"ExchangeRate", @"WeekOf" ) ), lodgedDay = fn CustomsDayNumber( fn LogicString( logicRow, @"LodgedDate" ) )if ( weekDay < 0 || lodgedDay < 0 ) then exit fn = NOend fn = ( lodgedDay - weekDay >= 0 && lodgedDay - weekDay < 7 )local fn DeclarationReliefApproved( logicRow as LogicRowRef ) as CFTypeRefif ( fn CustomsYes( fn LogicParentValue( logicRow, @"Importer", @"ReliefApproved" ) ) ) then exit fn = fn NumberWithLong( 1 )end fn = fn NumberWithLong( 0 )local fn DeclarationCifValue( logicRow as LogicRowRef ) as CFTypeRefdouble extras = fn CustomsRounded( ( fn LogicDouble( logicRow, @"Freight" ) + fn LogicDouble( logicRow, @"Insurance" ) ) * fn LogicDouble( logicRow, @"Rate" ), 2 )end fn = fn NumberWithDouble( fn CustomsRounded( fn LogicDouble( logicRow, @"TotalValue" ) + extras, 2 ) )local fn DeclarationAllowance( logicRow as LogicRowRef ) as CFTypeRefif ( fn CustomsIs( logicRow, @"Kind", @"P" ) == NO ) then exit fn = fn NumberWithDouble( 0.0 )if ( fn CustomsIs( logicRow, @"Declarant", @"R" ) ) then exit fn = fn NumberWithDouble( 300.0 )if ( fn CustomsIs( logicRow, @"Declarant", @"V" ) ) then exit fn = fn NumberWithDouble( 50.0 )end fn = fn NumberWithDouble( 0.0 )// the allowance's share of the dutylocal fn DeclarationAllowanceDuty( logicRow as LogicRowRef ) as CFTypeRefdouble total = fn LogicDouble( logicRow, @"TotalValue" ), allowed = fn LogicDouble( logicRow, @"Allowance" )if ( total <= 0 ) then exit fn = fn NumberWithDouble( 0.0 )if ( allowed > total ) then allowed = totalend fn = fn NumberWithDouble( fn CustomsRounded( allowed * fn LogicDouble( logicRow, @"TotalDuty" ) / total, 2 ) )local fn DeclarationAmountDue( logicRow as LogicRowRef ) as CFTypeRefend fn = fn NumberWithDouble( fn CustomsRounded( fn LogicDouble( logicRow, @"TotalDuty" ) - fn LogicDouble( logicRow, @"AllowanceDuty" ) + fn LogicDouble( logicRow, @"TotalWharfage" ), 2 ) )local fn DeclarationBalance( logicRow as LogicRowRef ) as CFTypeRefend fn = fn NumberWithDouble( fn CustomsRounded( fn LogicDouble( logicRow, @"AmountDue" ) - fn LogicDouble( logicRow, @"Paid" ), 2 ) )local fn DeclarationNotOverpaid( logicRow as LogicRowRef ) as BOOLend fn = ( fn LogicDouble( logicRow, @"Paid" ) <= fn LogicDouble( logicRow, @"AmountDue" ) )local fn DeclarationOwnStatement( logicRow as LogicRowRef ) as BOOLif ( fn LogicIsEmpty( logicRow, @"StatementId" ) ) then exit fn = YESend fn = ( fn LogicParentDouble( logicRow, @"Statement", @"ImporterId" ) == fn LogicDouble( logicRow, @"ImporterId" ) )local fn DeclarationHouseBillArrival( logicRow as LogicRowRef ) as BOOLif ( fn LogicIsEmpty( logicRow, @"HouseBillId" ) ) then exit fn = YESend fn = ( fn LogicParentDouble( logicRow, @"HouseBill", @"ArrivalId" ) == fn LogicDouble( logicRow, @"ArrivalId" ) )local fn DeclarationPersonalDeclarant( logicRow as LogicRowRef ) as BOOLif ( fn CustomsIs( logicRow, @"Kind", @"P" ) == NO ) then exit fn = YESend fn = ( fn CustomsIs( logicRow, @"Declarant", @"R" ) || fn CustomsIs( logicRow, @"Declarant", @"V" ) )local fn PaymentPositive( logicRow as LogicRowRef ) as BOOLend fn = ( fn LogicDouble( logicRow, @"Amount" ) > 0 )// for a declaration or for a statement: exactly onelocal fn PaymentForOne( logicRow as LogicRowRef ) as BOOLend fn = ( fn LogicIsEmpty( logicRow, @"DeclarationId" ) != fn LogicIsEmpty( logicRow, @"StatementId" ) )// --- what can hold it ---------------------------------------------------------------------------------------------local fn LineProhibited( logicRow as LogicRowRef ) as BOOLend fn = fn CustomsYes( fn LogicValue( logicRow, @"Prohibited" ) )local fn LineMissesPermit( logicRow as LogicRowRef ) as BOOLend fn = fn CustomsYes( fn LogicValue( logicRow, @"PermitMissing" ) )local fn LineIsUndervalued( logicRow as LogicRowRef ) as BOOLend fn = fn CustomsYes( fn LogicValue( logicRow, @"Undervalued" ) )local fn HoldIsOpen( logicRow as LogicRowRef ) as BOOLend fn = fn CustomsYes( fn LogicValue( logicRow, @"Open" ) )local fn InspectionPassed( logicRow as LogicRowRef ) as BOOLend fn = fn CustomsIs( logicRow, @"Result", @"P" )// a physical examination or an X-ray scan, passedlocal fn InspectionExamPassed( logicRow as LogicRowRef ) as BOOLif ( fn InspectionPassed( logicRow ) == NO ) then exit fn = NOend fn = ( fn CustomsIs( logicRow, @"Kind", @"P" ) || fn CustomsIs( logicRow, @"Kind", @"X" ) )local fn InspectionFailed( logicRow as LogicRowRef ) as BOOLend fn = fn CustomsIs( logicRow, @"Result", @"F" )local fn InspectionPenalty( logicRow as LogicRowRef ) as CFTypeRefif ( fn InspectionFailed( logicRow ) ) then exit fn = fn NumberWithLong( 25 )end fn = fn NumberWithLong( 0 )local fn HoldNamesAgency( logicRow as LogicRowRef ) as BOOLif ( fn CustomsIs( logicRow, @"Source", @"A" ) == NO ) then exit fn = YESend fn = ( fn StringLength( fn LogicString( logicRow, @"AgencyCode" ) ) > 0 )// --- risk and the lane --------------------------------------------------------------------------------------------local fn DeclarationRiskScore( logicRow as LogicRowRef ) as CFTypeRefdouble score = fn LogicParentDouble( logicRow, @"Country", @"RiskWeight" )long sinceDay = fn CustomsDayNumber( fn LogicParentString( logicRow, @"Importer", @"RegisteredSince" ) ), lodgedDay = fn CustomsDayNumber( fn LogicString( logicRow, @"LodgedDate" ) )score = score + ( 100 - fn LogicDouble( logicRow, @"CompliancePoints" ) ) / 2.0if ( fn CustomsYes( fn LogicParentValue( logicRow, @"Importer", @"Registered" ) ) == NO ) then score = score + 20if ( sinceDay < 0 || lodgedDay < 0 || lodgedDay - sinceDay < 365 ) then score = score + 15if ( fn StringIsEqual( fn LogicParentString( logicRow, @"Importer", @"TrustedTrader" ), @"AEO" ) ) then score = score - 30score = score + 20 * fn LogicDouble( logicRow, @"UndervaluedLines" )if ( fn LogicIsEmpty( logicRow, @"ContainerId" ) == NO )if ( fn CustomsYes( fn LogicParentValue( logicRow, @"Container", @"SealIntact" ) ) == NO ) then score = score + 40end ifif ( fn LogicIsEmpty( logicRow, @"HouseBillId" ) == NO )if ( fn CustomsYes( fn LogicParentValue( logicRow, @"HouseBill", @"LateFiling" ) ) ) then score = score + 20end ifscore = fn CustomsRounded( score, 0 )if ( score < 0 ) then score = 0end fn = fn NumberWithLong( score )// red under a random draw of 0.03, else by the score: green under 30, yellow under 60, red; blue: a trusted trader chosen for auditlocal fn DeclarationLane( logicRow as LogicRowRef ) as CFTypeRefdouble score = fn LogicDouble( logicRow, @"RiskScore" )if ( fn LogicDouble( logicRow, @"RandomDraw" ) < 0.03 ) then exit fn = @"R"if ( score >= 60 ) then exit fn = @"R"if ( score >= 30 ) then exit fn = @"Y"if ( fn StringIsEqual( fn LogicParentString( logicRow, @"Importer", @"TrustedTrader" ), @"AEO" ) && fn CustomsYes( fn LogicValue( logicRow, @"AuditFlag" ) ) ) then exit fn = @"B"end fn = @"G"// --- release --------------------------------------------------------------------------------------------------------// Declaration.ReleaseReason: the first reason it cannot be released; NULL when it canlocal fn DeclarationReleaseReason( logicRow as LogicRowRef ) as CFTypeRefif ( fn LogicDouble( logicRow, @"LineCount" ) == 0 ) then exit fn = @"It declares no goods"if ( fn LogicDouble( logicRow, @"ProhibitedLines" ) > 0 ) then exit fn = @"Prohibited goods: they are seized, never released"if ( fn StringLength( fn LogicParentString( logicRow, @"Arrival", @"ArrivedDate" ) ) == 0 ) then exit fn = @"The goods have not arrived"if ( fn LogicIsEmpty( logicRow, @"MasterBillId" ) == NO )if ( fn CustomsYes( fn LogicParentValue( logicRow, @"MasterBill", @"ManifestMatch" ) ) == NO ) then exit fn = @"The manifest does not add up: the master bill's packages and its house bills differ"end ifif ( fn LogicDouble( logicRow, @"OpenHolds" ) > 0 ) then exit fn = fn StringWithFormat( @"%ld hold(s) open", fn LogicLong( logicRow, @"OpenHolds" ) )if ( fn LogicDouble( logicRow, @"PermitsMissing" ) > 0 ) then exit fn = fn StringWithFormat( @"%ld line(s) need an agency permit", fn LogicLong( logicRow, @"PermitsMissing" ) )if ( fn LogicDouble( logicRow, @"FailedInspections" ) > 0 ) then exit fn = @"It failed an inspection"if ( fn CustomsIs( logicRow, @"Lane", @"R" ) && fn LogicDouble( logicRow, @"PassedExams" ) == 0 ) then exit fn = @"Red lane: it must pass a physical examination"if ( fn CustomsIs( logicRow, @"Lane", @"Y" ) && fn LogicDouble( logicRow, @"PassedChecks" ) == 0 ) then exit fn = @"Yellow lane: it must pass a document check"if ( fn LogicDouble( logicRow, @"Balance" ) > 0 && fn LogicIsEmpty( logicRow, @"StatementId" ) ) then exit fn = fn StringWithFormat( @"%.2f unpaid", fn LogicDouble( logicRow, @"Balance" ) )end fn = NULLlocal fn DeclarationReleasable( logicRow as LogicRowRef ) as CFTypeRefif ( fn LogicIsEmpty( logicRow, @"ReleaseReason" ) ) then exit fn = fn NumberWithLong( 1 )end fn = fn NumberWithLong( 0 )local fn DeclarationReleaseAllowed( logicRow as LogicRowRef ) as BOOLif ( fn CustomsIs( logicRow, @"Status", @"R" ) == NO ) then exit fn = YESend fn = ( fn LogicDouble( logicRow, @"Releasable" ) == 1 )// --- the gate -------------------------------------------------------------------------------------------------------// Movement.Reason: the first check that fails; NULL when the truck may golocal fn MovementReason( logicRow as LogicRowRef ) as CFTypeRefCFStringRef moveDay = fn LogicString( logicRow, @"MoveDate" )CFStringRef declared, sealReadif ( fn StringIsEqual( fn LogicParentString( logicRow, @"Declaration", @"Status" ), @"R" ) == NO ) then exit fn = @"The goods are not released yet"if ( fn LogicDouble( logicRow, @"TransponderRead" ) == 0 ) then exit fn = @"The truck's transponder was not read"declared = fn LogicParentString( logicRow, @"Container", @"SealNumber" )sealRead = fn LogicString( logicRow, @"ObservedSeal" )if ( fn StringIsEqual( sealRead, declared ) == NO )if ( fn StringLength( sealRead ) == 0 ) then sealRead = @"(none)"exit fn = fn StringWithFormat( @"Seal %@ does not match the declared seal %@", sealRead, declared )end ifif ( fn CustomsBefore( fn LogicParentString( logicRow, @"Truck", @"ClearedUntil" ), moveDay ) ) then exit fn = fn StringWithFormat( @"The truck is not cleared on %@", moveDay )if ( fn CustomsBefore( fn LogicParentString( logicRow, @"Driver", @"ClearedUntil" ), moveDay ) ) then exit fn = fn StringWithFormat( @"The driver is not cleared on %@", moveDay )if ( fn CustomsYes( fn LogicParentValue( logicRow, @"Route", @"Approved" ) ) == NO ) then exit fn = @"The route is not registered and approved"end fn = NULLlocal fn MovementLane( logicRow as LogicRowRef ) as CFTypeRefif ( fn LogicIsEmpty( logicRow, @"Reason" ) ) then exit fn = @"G"end fn = @"R"local fn MovementGateRule( logicRow as LogicRowRef ) as BOOLif ( fn CustomsIs( logicRow, @"Status", @"O" ) == NO ) then exit fn = YESend fn = fn CustomsIs( logicRow, @"Lane", @"G" )local fn MovementDeclaredContainer( logicRow as LogicRowRef ) as BOOLend fn = ( fn LogicDouble( logicRow, @"ContainerId" ) == fn LogicParentDouble( logicRow, @"Declaration", @"ContainerId" ) )void local fn DeclareRules// reference datafn LogicConstraint( @"Tariff", @fn TariffRatesValid, @"Tariff {Code}: rates cannot be negative, nor ad valorem over 300 percent" )fn LogicConstraint( @"ExchangeRate", @fn ExchangeRatePositive, @"An exchange rate must be more than 0" )fn LogicDeleteAction( @"Tariff", @"DeclarationLineList", @"prevent", @"Tariff {Code} is used by declarations" )// importers and statementsfn LogicCount( @"Importer", @"DeclarationCount", @"DeclarationList", NULL )fn LogicSum( @"Importer", @"PenaltyPoints", @"DeclarationList", @"Penalties", NULL )fn LogicFormula( @"Importer", @"CompliancePoints", @fn ImporterCompliancePoints, @[ @"ComplianceBase", @"PenaltyPoints" ] )fn LogicSum( @"Importer", @"StatementBalance", @"StatementList", @"Balance", @fn StatementOpen )fn LogicConstraint( @"Importer", @fn ImporterWithinBond, @"{Name}: its statements would owe {StatementBalance}, more than its bond {BondAmount} - pay first" )fn LogicSum( @"Importer", @"YearDuty", @"DeclarationList", @"TotalDuty", @fn DeclarationReleased )fn LogicFormula( @"Importer", @"RequiredBond", @fn ImporterRequiredBond, @[ @"YearDuty" ] )fn LogicFormula( @"Importer", @"BondSufficient", @fn ImporterBondSufficient, @[ @"BondAmount", @"RequiredBond" ] )fn LogicDeleteAction( @"Importer", @"DeclarationList", @"prevent", @"{Name} has declarations" )fn LogicDeleteAction( @"Importer", @"StatementList", @"prevent", @"{Name} has statements" )fn LogicSum( @"Statement", @"Total", @"DeclarationList", @"AmountDue", @fn DeclarationReleased )fn LogicSum( @"Statement", @"Paid", @"PaymentList", @"Amount", NULL )fn LogicFormula( @"Statement", @"Balance", @fn StatementBalance, @[ @"Total", @"Paid" ] )fn LogicConstraint( @"Statement", @fn StatementClosesPaid, @"Statement {Period} still owes {Balance}: it cannot be closed" )fn LogicConstraint( @"Statement", @fn StatementImporterOnStatement, @"The importer does not pay on statements" )// the manifestfn LogicCopy( @"Arrival", @"WharfageRate", @"PortOfEntry", @"WharfageRate" )fn LogicDeleteAction( @"Arrival", @"ContainerList", @"prevent", @"Arrival {VoyageNumber} still has containers" )fn LogicDeleteAction( @"Arrival", @"MasterBillList", @"prevent", @"Arrival {VoyageNumber} still has bills of lading" )fn LogicCount( @"MasterBill", @"HouseCount", @"HouseBillList", NULL )fn LogicSum( @"MasterBill", @"HousePackages", @"HouseBillList", @"Packages", NULL )fn LogicFormula( @"MasterBill", @"ManifestMatch", @fn MasterManifestMatch, @[ @"HouseCount", @"HousePackages", @"Packages" ] )fn LogicCopy( @"HouseBill", @"ArrivalId", @"MasterBill", @"ArrivalId" )fn LogicFormula( @"HouseBill", @"LateFiling", @fn HouseLateFiling, @[ @"SecurityFiled", @"LadingDate" ] )fn LogicDeleteAction( @"HouseBill", @"DeclarationList", @"prevent", @"House bill {Number} is declared" )fn LogicDeleteAction( @"MasterBill", @"HouseBillList", @"cascade", NULL )// declaration linesfn LogicParentCheck( @"DeclarationLine", @"Tariff", @"There is no tariff heading {TariffCode}" )fn LogicCopy( @"DeclarationLine", @"DutyRate", @"Tariff", @"DutyRate" )fn LogicCopy( @"DeclarationLine", @"SpecificRate", @"Tariff", @"SpecificRate" )fn LogicCopy( @"DeclarationLine", @"StepAbove", @"Tariff", @"StepAbove" )fn LogicCopy( @"DeclarationLine", @"RateAbove", @"Tariff", @"RateAbove" )fn LogicCopy( @"DeclarationLine", @"AgencyCode", @"Tariff", @"AgencyCode" )fn LogicCopy( @"DeclarationLine", @"Prohibited", @"Tariff", @"Prohibited" )fn LogicCopy( @"DeclarationLine", @"ReferencePrice", @"Tariff", @"ReferencePrice" )fn LogicFormula( @"DeclarationLine", @"Value", @fn LineValue, @[ @"InvoiceValue", @"DeclarationId", @"Declaration.Rate" ] )fn LogicFormula( @"DeclarationLine", @"Duty", @fn LineDuty, @[ @"ReliefClaimed", @"Value", @"StepAbove", @"DutyRate", @"RateAbove", @"Quantity", @"SpecificRate" ] )fn LogicFormula( @"DeclarationLine", @"Wharfage", @fn LineWharfage, @[ @"Value", @"DeclarationId", @"Declaration.Kind", @"Declaration.WharfageRate" ] )fn LogicFormula( @"DeclarationLine", @"Undervalued", @fn LineUndervalued, @[ @"ReferencePrice", @"Quantity", @"Value" ] )fn LogicCount( @"DeclarationLine", @"ApprovedPermits", @"PermitList", @fn PermitApproved )fn LogicFormula( @"DeclarationLine", @"PermitMissing", @fn LinePermitMissing, @[ @"AgencyCode", @"ApprovedPermits" ] )fn LogicConstraint( @"DeclarationLine", @fn LineQuantityPositive, @"Quantity {Quantity} must be more than 0" )fn LogicConstraint( @"DeclarationLine", @fn LineValueNotNegative, @"Value {InvoiceValue} cannot be negative" )fn LogicConstraint( @"DeclarationLine", @fn LineReliefApproved, @"Relief is claimed, but the importer is not approved for duty relief" )fn LogicConstraint( @"Permit", @fn PermitRightAgency, @"Permit {Number} is from {AgencyCode}: the goods need another agency's" )fn LogicDeleteAction( @"DeclarationLine", @"PermitList", @"cascade", NULL )// the declaration: value, duty, what is owedfn LogicCopy( @"Declaration", @"WharfageRate", @"Arrival", @"WharfageRate" )// the master bill, for the manifest check: a house bill's own formula would read the master's totals before they count itfn LogicCopy( @"Declaration", @"MasterBillId", @"HouseBill", @"MasterBillId" )fn LogicFormula( @"Declaration", @"Rate", @fn DeclarationRate, @[ @"ExchangeRateId", @"ExchangeRate.Rate" ] )fn LogicConstraint( @"Declaration", @fn DeclarationRateWeek, @"Exchange rate {ExchangeRateId} is not the week the entry was lodged" )// risk-scored with the importer's compliance points as they were when lodgedfn LogicCopy( @"Declaration", @"CompliancePoints", @"Importer", @"CompliancePoints" )fn LogicFormula( @"Declaration", @"ReliefApproved", @fn DeclarationReliefApproved, @[ @"ImporterId", @"Importer.ReliefApproved" ] )fn LogicCount( @"Declaration", @"LineCount", @"DeclarationLineList", NULL )fn LogicSum( @"Declaration", @"TotalValue", @"DeclarationLineList", @"Value", NULL )fn LogicSum( @"Declaration", @"TotalDuty", @"DeclarationLineList", @"Duty", NULL )fn LogicSum( @"Declaration", @"TotalWharfage", @"DeclarationLineList", @"Wharfage", NULL )fn LogicFormula( @"Declaration", @"CifValue", @fn DeclarationCifValue, @[ @"TotalValue", @"Freight", @"Insurance", @"Rate" ] )fn LogicFormula( @"Declaration", @"Allowance", @fn DeclarationAllowance, @[ @"Kind", @"Declarant" ] )fn LogicFormula( @"Declaration", @"AllowanceDuty", @fn DeclarationAllowanceDuty, @[ @"Allowance", @"TotalValue", @"TotalDuty" ] )fn LogicFormula( @"Declaration", @"AmountDue", @fn DeclarationAmountDue, @[ @"TotalDuty", @"AllowanceDuty", @"TotalWharfage" ] )fn LogicSum( @"Declaration", @"Paid", @"PaymentList", @"Amount", NULL )fn LogicFormula( @"Declaration", @"Balance", @fn DeclarationBalance, @[ @"AmountDue", @"Paid" ] )fn LogicConstraint( @"Declaration", @fn DeclarationNotOverpaid, @"Entry {EntryNumber}: paid {Paid}, more than the {AmountDue} due" )fn LogicConstraint( @"Declaration", @fn DeclarationOwnStatement, @"Statement {StatementId} is another importer's" )fn LogicConstraint( @"Declaration", @fn DeclarationHouseBillArrival, @"House bill {HouseBillId} came on another arrival" )fn LogicConstraint( @"Declaration", @fn DeclarationPersonalDeclarant, @"A personal declaration says resident (R) or visitor (V)" )fn LogicConstraint( @"Payment", @fn PaymentPositive, @"A payment must be more than 0" )fn LogicConstraint( @"Payment", @fn PaymentForOne, @"A payment is for a declaration or for a statement" )// what can hold itfn LogicCount( @"Declaration", @"ProhibitedLines", @"DeclarationLineList", @fn LineProhibited )fn LogicCount( @"Declaration", @"PermitsMissing", @"DeclarationLineList", @fn LineMissesPermit )fn LogicCount( @"Declaration", @"UndervaluedLines", @"DeclarationLineList", @fn LineIsUndervalued )fn LogicCount( @"Declaration", @"OpenHolds", @"HoldList", @fn HoldIsOpen )fn LogicCount( @"Declaration", @"PassedChecks", @"InspectionList", @fn InspectionPassed )fn LogicCount( @"Declaration", @"PassedExams", @"InspectionList", @fn InspectionExamPassed )fn LogicCount( @"Declaration", @"FailedInspections", @"InspectionList", @fn InspectionFailed )fn LogicFormula( @"Inspection", @"Penalty", @fn InspectionPenalty, @[ @"Result" ] )fn LogicSum( @"Declaration", @"Penalties", @"InspectionList", @"Penalty", NULL )fn LogicConstraint( @"Hold", @fn HoldNamesAgency, @"An agency hold names its agency" )// risk and the lanefn LogicFormula( @"Declaration", @"RiskScore", @fn DeclarationRiskScore, @[ @"CountryCode", @"Country.RiskWeight", @"ImporterId", @"CompliancePoints", @"Importer.Registered", @"Importer.RegisteredSince", @"LodgedDate", @"Importer.TrustedTrader", @"UndervaluedLines", @"ContainerId", @"Container.SealIntact", @"HouseBillId", @"HouseBill.LateFiling" ] )fn LogicFormula( @"Declaration", @"Lane", @fn DeclarationLane, @[ @"RandomDraw", @"RiskScore", @"Importer.TrustedTrader", @"AuditFlag" ] )// releasefn LogicFormula( @"Declaration", @"ReleaseReason", @fn DeclarationReleaseReason, @[ @"LineCount", @"ProhibitedLines", @"ArrivalId", @"Arrival.ArrivedDate", @"MasterBillId", @"MasterBill.ManifestMatch", @"OpenHolds", @"PermitsMissing", @"FailedInspections", @"Lane", @"PassedExams", @"PassedChecks", @"Balance", @"StatementId" ] )fn LogicFormula( @"Declaration", @"Releasable", @fn DeclarationReleasable, @[ @"ReleaseReason" ] )fn LogicConstraint( @"Declaration", @fn DeclarationReleaseAllowed, @"Entry {EntryNumber} is not released: {ReleaseReason}" )// refuse first (payments, movements, inspections), then cascade (lines, holds)fn LogicDeleteAction( @"Declaration", @"PaymentList", @"prevent", @"Entry {EntryNumber} has payments: it cannot be deleted" )fn LogicDeleteAction( @"Declaration", @"MovementList", @"prevent", @"Entry {EntryNumber} has moved through the gate" )fn LogicDeleteAction( @"Declaration", @"InspectionList", @"prevent", @"Entry {EntryNumber} was inspected: the record stays" )fn LogicDeleteAction( @"Declaration", @"DeclarationLineList", @"cascade", NULL )fn LogicDeleteAction( @"Declaration", @"HoldList", @"cascade", NULL )// the gatefn LogicFormula( @"Movement", @"Reason", @fn MovementReason, @[ @"DeclarationId", @"Declaration.Status", @"TransponderRead", @"ContainerId", @"Container.SealNumber", @"ObservedSeal", @"MoveDate", @"TruckId", @"Truck.ClearedUntil", @"DriverId", @"Driver.ClearedUntil", @"RouteId", @"Route.Approved" ] )fn LogicFormula( @"Movement", @"Lane", @fn MovementLane, @[ @"Reason" ] )fn LogicConstraint( @"Movement", @fn MovementGateRule, @"The gate stays closed: {Reason}" )fn LogicConstraint( @"Movement", @fn MovementDeclaredContainer, @"Container {ContainerId} is not the one entry {DeclarationId} declares" )end fn