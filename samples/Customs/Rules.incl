/* *   Rules.incl - the Customs sample's business rules (LogicBank for FutureBasic) * *   The Customs sample (samples/Customs, set in Bermuda): copy this file over the generated app's *   Rules.incl (FBapp/Rules.incl - the starting template; regeneration never overwrites it).  The same *   rules as samples/Customs/customs_rules.py, which test_rules.py runs scenario by scenario. * *       duty      a line copies its tariff's rate; Duty = Value x rate; the entry adds its lines up, *                 plus the port's processing fee; payments bring the balance down; released goods still *                 owing count against the importer's deferment bond *       lane      pre-cleared (green) when lodged before the goods arrived, by a registered importer, *                 with every licence its goods need; otherwise red: inspect before release; a failed *                 inspection holds the entry *       the gate  a truck goes out only when the entry is released, the transponder was read, the seal *                 read matches the declared one, truck and driver are cleared on the day, and the route *                 is registered and approved - else Movement.Reason says why * *   MIT License. Copyright (c) 2026 Imagery Business Systems, LLC. */// a stored yes / no (BOOLEAN: 1 / 0 / empty)local fn CustomsYes( value as CFTypeRef ) as BOOLif ( value == NULL ) then exit fn = NOend fn = ( fn LogicNumberOf( value ) != 0 )// text, never NULLlocal fn CustomsText( textValue as CFStringRef ) as CFStringRefif ( textValue == NULL ) then exit fn = @""end fn = textValue// is ISO date a before ISO date b?  (they compare as text)local fn CustomsBefore( a as CFStringRef, b as CFStringRef ) as BOOLend fn = ( fn StringCompare( fn CustomsText( a ), fn CustomsText( b ) ) == NSOrderedAscending )// --- the tariff and arrivals ---------------------------------------------------------------------local fn TariffRateInRange( logicRow as LogicRowRef ) as BOOLend fn = ( fn LogicDouble( logicRow, @"DutyRate" ) >= 0 && fn LogicDouble( logicRow, @"DutyRate" ) <= 100 )// --- declaration lines: duty -----------------------------------------------------------------------local fn LineDuty( logicRow as LogicRowRef ) as CFTypeRefdouble duty = fn LogicDouble( logicRow, @"Value" ) * fn LogicDouble( logicRow, @"DutyRate" ) / 100.0end fn = fn NumberWithDouble( fix( duty * 100.0 + 0.5 ) / 100.0 )local fn LineQuantityPositive( logicRow as LogicRowRef ) as BOOLend fn = ( fn LogicDouble( logicRow, @"Quantity" ) > 0 )local fn LineValueNotNegative( logicRow as LogicRowRef ) as BOOLend fn = ( fn LogicDouble( logicRow, @"Value" ) >= 0 )// a line that needs a licence and has nonelocal fn LineMissesLicence( logicRow as LogicRowRef ) as BOOLif ( fn LogicDouble( logicRow, @"LicenceRequired" ) == 0 ) then exit fn = NOend fn = ( fn StringLength( fn StringByTrimmingCharactersInSet( fn CustomsText( fn LogicString( logicRow, @"LicenceNumber" ) ), fn CharacterSetWhitespaceSet ) ) == 0 )// --- the declaration --------------------------------------------------------------------------------local fn DeclarationAmountDue( logicRow as LogicRowRef ) as CFTypeRefend fn = fn NumberWithDouble( fn LogicDouble( logicRow, @"TotalDuty" ) + fn LogicDouble( logicRow, @"ProcessingFee" ) )local fn DeclarationBalance( logicRow as LogicRowRef ) as CFTypeRefend fn = fn NumberWithDouble( fn LogicDouble( logicRow, @"AmountDue" ) - fn LogicDouble( logicRow, @"Paid" ) )local fn PaymentPositive( logicRow as LogicRowRef ) as BOOLend fn = ( fn LogicDouble( logicRow, @"Amount" ) > 0 )// pre-cleared: lodged before the goods arrived, by a registered importer, with every licence, with goodslocal fn DeclarationPreCleared( logicRow as LogicRowRef ) as CFTypeRefCFStringRef arrival = fn LogicParentString( logicRow, @"Arrival", @"ArrivalDate" )if ( arrival == NULL ) then exit fn = fn NumberWithLong( 0 )if ( fn CustomsBefore( fn LogicString( logicRow, @"LodgedDate" ), arrival ) == NO ) then exit fn = fn NumberWithLong( 0 )if ( fn CustomsYes( fn LogicParentValue( logicRow, @"Importer", @"Registered" ) ) == NO ) then exit fn = fn NumberWithLong( 0 )if ( fn LogicDouble( logicRow, @"MissingLicences" ) != 0 || fn LogicDouble( logicRow, @"LineCount" ) <= 0 ) then exit fn = fn NumberWithLong( 0 )end fn = fn NumberWithLong( 1 )local fn DeclarationLane( logicRow as LogicRowRef ) as CFTypeRefif ( fn LogicDouble( logicRow, @"PreCleared" ) != 0 ) then exit fn = @"G"end fn = @"R"local fn InspectionPassed( logicRow as LogicRowRef ) as BOOLend fn = fn StringIsEqual( fn CustomsText( fn LogicString( logicRow, @"Result" ) ), @"P" )local fn InspectionFailed( logicRow as LogicRowRef ) as BOOLend fn = fn StringIsEqual( fn CustomsText( fn LogicString( logicRow, @"Result" ) ), @"F" )local fn DeclarationReleasing( logicRow as LogicRowRef ) as BOOLend fn = fn StringIsEqual( fn CustomsText( fn LogicString( logicRow, @"Status" ) ), @"R" )local fn DeclarationHasGoods( logicRow as LogicRowRef ) as BOOLif ( fn DeclarationReleasing( logicRow ) == NO ) then exit fn = YESend fn = ( fn LogicDouble( logicRow, @"LineCount" ) > 0 )local fn DeclarationGreenOrInspected( logicRow as LogicRowRef ) as BOOLif ( fn DeclarationReleasing( logicRow ) == NO ) then exit fn = YESif ( fn StringIsEqual( fn CustomsText( fn LogicString( logicRow, @"Lane" ) ), @"G" ) ) then exit fn = YESend fn = ( fn LogicDouble( logicRow, @"PassedInspections" ) > 0 )local fn DeclarationNoFailedInspection( logicRow as LogicRowRef ) as BOOLif ( fn DeclarationReleasing( logicRow ) == NO ) then exit fn = YESend fn = ( fn LogicDouble( logicRow, @"FailedInspections" ) == 0 )// --- the importer: the deferment bond -----------------------------------------------------------------local fn ImporterWithinBond( logicRow as LogicRowRef ) as BOOLend fn = ( fn LogicDouble( logicRow, @"DeferredBalance" ) <= fn LogicDouble( logicRow, @"BondAmount" ) )// --- the gate ------------------------------------------------------------------------------------------// Movement.Reason: the first check that fails; NULL when the truck may golocal fn MovementReason( logicRow as LogicRowRef ) as CFTypeRefCFStringRef moveDay = fn CustomsText( fn LogicString( logicRow, @"MoveDate" ) )CFStringRef declared, sealReadif ( fn StringIsEqual( fn CustomsText( fn LogicParentString( logicRow, @"Declaration", @"Status" ) ), @"R" ) == NO ) then exit fn = @"The goods are not released yet"if ( fn LogicDouble( logicRow, @"TransponderRead" ) == 0 ) then exit fn = @"The truck's transponder was not read"declared = fn CustomsText( fn LogicParentString( logicRow, @"Container", @"SealNumber" ) )sealRead = fn CustomsText( fn LogicString( logicRow, @"ObservedSeal" ) )if ( fn StringIsEqual( sealRead, declared ) == NO )if ( fn StringLength( sealRead ) == 0 ) then sealRead = @"(none)"exit fn = fn StringWithFormat( @"Seal %@ does not match the declared seal %@", sealRead, declared )end ifif ( fn CustomsBefore( fn LogicParentString( logicRow, @"Truck", @"ClearedUntil" ), moveDay ) ) then exit fn = fn StringWithFormat( @"The truck is not cleared on %@", moveDay )if ( fn CustomsBefore( fn LogicParentString( logicRow, @"Driver", @"ClearedUntil" ), moveDay ) ) then exit fn = fn StringWithFormat( @"The driver is not cleared on %@", moveDay )if ( fn CustomsYes( fn LogicParentValue( logicRow, @"Route", @"Approved" ) ) == NO ) then exit fn = @"The route is not registered and approved"end fn = NULLlocal fn MovementLane( logicRow as LogicRowRef ) as CFTypeRefif ( fn LogicIsEmpty( logicRow, @"Reason" ) ) then exit fn = @"G"end fn = @"R"local fn MovementGateRule( logicRow as LogicRowRef ) as BOOLif ( fn StringIsEqual( fn CustomsText( fn LogicString( logicRow, @"Status" ) ), @"O" ) == NO ) then exit fn = YESend fn = fn StringIsEqual( fn CustomsText( fn LogicString( logicRow, @"Lane" ) ), @"G" )local fn MovementDeclaredContainer( logicRow as LogicRowRef ) as BOOLend fn = ( fn LogicDouble( logicRow, @"ContainerId" ) == fn LogicParentDouble( logicRow, @"Declaration", @"ContainerId" ) )void local fn DeclareRules// the tariff and arrivalsfn LogicConstraint( @"Tariff", @fn TariffRateInRange, @"Duty rate {DutyRate} must be between 0 and 100 percent" )fn LogicCopy( @"Arrival", @"ProcessingFee", @"PortOfEntry", @"ProcessingFee" )fn LogicDeleteAction( @"Arrival", @"ContainerList", @"prevent", @"Arrival {VoyageNumber} still has containers" )// declaration lines: dutyfn LogicParentCheck( @"DeclarationLine", @"Tariff", @"There is no tariff heading {TariffCode}" )fn LogicCopy( @"DeclarationLine", @"DutyRate", @"Tariff", @"DutyRate" )fn LogicCopy( @"DeclarationLine", @"LicenceRequired", @"Tariff", @"LicenceRequired" )fn LogicFormula( @"DeclarationLine", @"Duty", @fn LineDuty, @[ @"Value", @"DutyRate" ] )fn LogicConstraint( @"DeclarationLine", @fn LineQuantityPositive, @"Quantity {Quantity} must be more than 0" )fn LogicConstraint( @"DeclarationLine", @fn LineValueNotNegative, @"Value {Value} cannot be negative" )// the declaration: what is owedfn LogicCopy( @"Declaration", @"ProcessingFee", @"Arrival", @"ProcessingFee" )fn LogicCount( @"Declaration", @"LineCount", @"DeclarationLineList", NULL )fn LogicSum( @"Declaration", @"TotalValue", @"DeclarationLineList", @"Value", NULL )fn LogicSum( @"Declaration", @"TotalDuty", @"DeclarationLineList", @"Duty", NULL )fn LogicFormula( @"Declaration", @"AmountDue", @fn DeclarationAmountDue, @[ @"TotalDuty", @"ProcessingFee" ] )fn LogicSum( @"Declaration", @"Paid", @"PaymentList", @"Amount", NULL )fn LogicFormula( @"Declaration", @"Balance", @fn DeclarationBalance, @[ @"AmountDue", @"Paid" ] )fn LogicConstraint( @"Payment", @fn PaymentPositive, @"A payment must be more than 0" )// the declaration: pre-clearance and releasefn LogicCount( @"Declaration", @"MissingLicences", @"DeclarationLineList", @fn LineMissesLicence )fn LogicFormula( @"Declaration", @"PreCleared", @fn DeclarationPreCleared, @[ @"LodgedDate", @"ArrivalId", @"Arrival.ArrivalDate", @"ImporterId", @"Importer.Registered", @"MissingLicences", @"LineCount" ] )fn LogicFormula( @"Declaration", @"Lane", @fn DeclarationLane, @[ @"PreCleared" ] )fn LogicCount( @"Declaration", @"PassedInspections", @"InspectionList", @fn InspectionPassed )fn LogicCount( @"Declaration", @"FailedInspections", @"InspectionList", @fn InspectionFailed )fn LogicConstraint( @"Declaration", @fn DeclarationHasGoods, @"Entry {EntryNumber} declares no goods: it cannot be released" )fn LogicConstraint( @"Declaration", @fn DeclarationGreenOrInspected, @"Entry {EntryNumber} is in the red lane: it must pass an inspection before it is released" )fn LogicConstraint( @"Declaration", @fn DeclarationNoFailedInspection, @"Entry {EntryNumber} failed an inspection: it cannot be released" )// refuse first (payments), then cascade (lines): a cascade first would empty the entry, and another rule would refuse itfn LogicDeleteAction( @"Declaration", @"PaymentList", @"prevent", @"Entry {EntryNumber} has payments: it cannot be deleted" )fn LogicDeleteAction( @"Declaration", @"DeclarationLineList", @"cascade", NULL )// the importer: the deferment bondfn LogicCount( @"Importer", @"DeclarationCount", @"DeclarationList", NULL )fn LogicSum( @"Importer", @"DeferredBalance", @"DeclarationList", @"Balance", @fn DeclarationReleasing )fn LogicConstraint( @"Importer", @fn ImporterWithinBond, @"{Name}: released goods would owe {DeferredBalance}, more than the deferment bond {BondAmount} - pay first" )fn LogicDeleteAction( @"Importer", @"DeclarationList", @"prevent", @"{Name} has declarations" )// the gatefn LogicFormula( @"Movement", @"Reason", @fn MovementReason, @[ @"DeclarationId", @"Declaration.Status", @"TransponderRead", @"ContainerId", @"Container.SealNumber", @"ObservedSeal", @"MoveDate", @"TruckId", @"Truck.ClearedUntil", @"DriverId", @"Driver.ClearedUntil", @"RouteId", @"Route.Approved" ] )fn LogicFormula( @"Movement", @"Lane", @fn MovementLane, @[ @"Reason" ] )fn LogicConstraint( @"Movement", @fn MovementGateRule, @"The gate stays closed: {Reason}" )fn LogicConstraint( @"Movement", @fn MovementDeclaredContainer, @"Container {ContainerId} is not the one entry {DeclarationId} declares" )end fn