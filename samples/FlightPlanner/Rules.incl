/* *   Rules.incl - the Flight Planner sample's business rules (LogicBank for FutureBasic) * *   The Flight Planner sample (samples/FlightPlanner, VFR flights in New England): copy this file over the *   generated app's Rules.incl (FBapp/Rules.incl - the starting template; regeneration never overwrites it). *   The same rules as samples/FlightPlanner/flight_rules.py, which test_rules.py runs scenario by scenario. *   Research and regulations: docs/research/Flight Planning Research.md. * *       a leg        great circle, magnetic course, the wind triangle, minutes and fuel, the landing distance *                    at the density altitude, the crosswind, and its Problem *       the load     weight and balance: moments, ramp / takeoff / landing weight, the CG in the envelope *       the plan     totals; fuel = taxi + climb + trip + reserve; endurance; takeoff distance; ETA, SearchAt *       the pilot    medical (or BasicMed), flight review, landings in 90 days, a student's endorsements *       the aircraft annual, transponder, ELT and its battery, the 100-hour inspection when for hire *       go / no-go   the first reason the flight may not go; filed only on a GO; Draft - Filed - Active - Closed * *   sin, cos and asin are FB keywords (radians); atan2, sqrt, floor and fmod come from math.incl. *   NOT FOR NAVIGATION. * *   MIT License. Copyright (c) 2026 Imagery Business Systems, LLC. */// --- helpers ------------------------------------------------------------------------------------------// text, never NULLlocal fn FlightText( textValue as CFStringRef ) as CFStringRefif ( textValue == NULL ) then exit fn = @""end fn = textValue// floor( x + 0.5 ) at this many decimals - the reference rounds the same waylocal fn FlightRounded( x as double, decimals as long ) as doubledouble scale = 1.0long ifor i = 1 to decimalsscale = scale * 10.0nextend fn = fn floor( x * scale + 0.5 ) / scale// is ISO date a before ISO date b?  (they compare as text; an empty date is before any other)local fn FlightBefore( a as CFStringRef, b as CFStringRef ) as BOOLend fn = ( fn StringCompare( fn FlightText( a ), fn FlightText( b ) ) == NSOrderedAscending )// the day number of an ISO date (yyyy-MM-dd) - the Julian day; -1 when it cannot be readlocal fn FlightDayNumber( isoDate as CFStringRef ) as longlong y, m, d, aif ( isoDate == NULL ) then exit fn = -1if ( fn StringLength( isoDate ) < 10 ) then exit fn = -1y = fn StringIntegerValue( fn StringSubstringWithRange( isoDate, fn CFRangeMake( 0, 4 ) ) )m = fn StringIntegerValue( fn StringSubstringWithRange( isoDate, fn CFRangeMake( 5, 2 ) ) )d = fn StringIntegerValue( fn StringSubstringWithRange( isoDate, fn CFRangeMake( 8, 2 ) ) )if ( y < 1900 || m < 1 || m > 12 || d < 1 || d > 31 ) then exit fn = -1a = fix( ( m - 14 ) / 12.0 )end fn = d - 32075 + fix( 1461 * ( y + 4800 + a ) / 4.0 ) + fix( 367 * ( m - 2 - a * 12 ) / 12.0 ) - fix( 3 * fix( ( y + 4900 + a ) / 100.0 ) / 4.0 )// is the first date within the 90 days up to the second?local fn FlightWithin90( firstDate as CFStringRef, lastDate as CFStringRef ) as BOOLlong firstDay = fn FlightDayNumber( firstDate ), lastDay = fn FlightDayNumber( lastDate )if ( firstDay < 0 || lastDay < 0 ) then exit fn = NOend fn = ( lastDay - firstDay >= 0 && lastDay - firstDay <= 90 )// the last day of the month `months` calendar months after the date's month; NULL without a datelocal fn FlightEndOfMonthAfter( isoDate as CFStringRef, months as long ) as CFTypeReflong y, m, total, y2, m2, monthDaysif ( isoDate == NULL ) then exit fn = NULLif ( fn StringLength( isoDate ) < 7 ) then exit fn = NULLy = fn StringIntegerValue( fn StringSubstringWithRange( isoDate, fn CFRangeMake( 0, 4 ) ) )m = fn StringIntegerValue( fn StringSubstringWithRange( isoDate, fn CFRangeMake( 5, 2 ) ) )total = y * 12 + ( m - 1 ) + monthsy2 = fix( total / 12.0 )m2 = total mod 12 + 1monthDays = 31if ( m2 == 4 || m2 == 6 || m2 == 9 || m2 == 11 ) then monthDays = 30if ( m2 == 2 )monthDays = 28if ( ( y2 mod 4 == 0 && y2 mod 100 != 0 ) || y2 mod 400 == 0 ) then monthDays = 29end ifend fn = fn StringWithFormat( @"%04ld-%02ld-%02ld", y2, m2, monthDays )// whole years from the birth date to the daylocal fn FlightAgeOn( birthDate as CFStringRef, onDate as CFStringRef ) as longlong yearsif ( fn StringLength( fn FlightText( birthDate ) ) < 10 || fn StringLength( fn FlightText( onDate ) ) < 10 ) then exit fn = -1years = fn StringIntegerValue( fn StringSubstringWithRange( onDate, fn CFRangeMake( 0, 4 ) ) ) - fn StringIntegerValue( fn StringSubstringWithRange( birthDate, fn CFRangeMake( 0, 4 ) ) )if ( fn StringCompare( fn StringSubstringWithRange( onDate, fn CFRangeMake( 5, 5 ) ), fn StringSubstringWithRange( birthDate, fn CFRangeMake( 5, 5 ) ) ) == NSOrderedAscending ) then years = years - 1end fn = years// HH:MM + minutes, around the clock; NULL without a timelocal fn FlightClockPlus( clockText as CFStringRef, minutes as long ) as CFTypeReflong total, hoursif ( fn StringLength( fn FlightText( clockText ) ) < 5 ) then exit fn = NULLtotal = fn StringIntegerValue( fn StringSubstringWithRange( clockText, fn CFRangeMake( 0, 2 ) ) ) * 60 + fn StringIntegerValue( fn StringSubstringWithRange( clockText, fn CFRangeMake( 3, 2 ) ) ) + minutestotal = total mod 1440hours = fix( total / 60.0 )end fn = fn StringWithFormat( @"%02ld:%02ld", hours, total mod 60 )// knots across the runway (the gust if there is one); the runway's heading is magnetic, the wind truelocal fn FlightCrosswind( windFrom as double, windSpeed as double, gustSpeed as double, runwayHeading as double, variation as double ) as longdouble strongest = windSpeedif ( gustSpeed > strongest ) then strongest = gustSpeedend fn = fn FlightRounded( fn fabs( strongest * sin( ( windFrom - ( runwayHeading - variation ) ) * M_PI / 180.0 ) ), 0 )// takeoff and landing distances grow about 10 % a thousand feet of density altitudelocal fn FlightDistanceFactor( densityFt as double ) as doubleif ( densityFt < 0 ) then densityFt = 0end fn = 1.0 + 0.10 * densityFt / 1000.0local fn FlightIsSurfaceArea( airspace as CFStringRef ) as BOOLend fn = ( fn StringIsEqual( airspace, @"B" ) || fn StringIsEqual( airspace, @"C" ) || fn StringIsEqual( airspace, @"D" ) || fn StringIsEqual( airspace, @"E" ) )// 91.155 at the airport, and 61.89 for a student; hasCeiling NO when no layer is broken or overcastlocal fn FlightMinimumsOK( airspace as CFStringRef, atNight as BOOL, isStudent as BOOL, visibility as double, hasCeiling as BOOL, ceilingFt as double ) as BOOLdouble need = 1.0if ( atNight ) then need = 3.0if ( fn FlightIsSurfaceArea( fn FlightText( airspace ) ) )need = 3.0if ( hasCeiling && ceilingFt < 1000 ) then exit fn = NOend ifif ( isStudent )if ( atNight && need < 5.0 ) then need = 5.0if ( atNight == NO && need < 3.0 ) then need = 3.0end ifend fn = ( visibility >= need )// 91.159: more than 3,000 ft above the surface, magnetic course 0-179 at odd thousands + 500, 180-359 at evenlocal fn FlightAltitudeOK( altitudeFt as long, magneticCourse as double, highestGround as double ) as BOOLBOOL isOddif ( altitudeFt - highestGround <= 3000 ) then exit fn = YESif ( ( altitudeFt - 500 ) mod 1000 != 0 ) then exit fn = NOisOdd = ( fix( ( altitudeFt - 500 ) / 1000.0 ) mod 2 == 1 )end fn = ( isOdd == ( magneticCourse < 180 ) )// a number for a message: %g, as the reference writes itlocal fn FlightNumberText( x as double ) as CFStringRefend fn = fn StringWithFormat( @"%g", x )// --- airports, runways, weather --------------------------------------------------------------------------local fn NotamCloses( logicRow as LogicRowRef ) as BOOLif ( fn LogicDouble( logicRow, @"Active" ) == 0 ) then exit fn = NOend fn = ( fn StringIsEqual( fn LogicString( logicRow, @"Kind" ), @"C" ) || fn StringIsEqual( fn LogicString( logicRow, @"Kind" ), @"T" ) )local fn WeatherDensityAltitude( logicRow as LogicRowRef ) as CFTypeRefdouble pressureFt = fn LogicParentDouble( logicRow, @"Airport", @"Elevation" ) + ( 29.92 - fn LogicDouble( logicRow, @"Altimeter" ) ) * 1000.0end fn = fn NumberWithLong( fn FlightRounded( pressureFt + 120.0 * ( fn LogicDouble( logicRow, @"Temperature" ) - ( 15.0 - 2.0 * pressureFt / 1000.0 ) ), 0 ) )local fn WeatherCategory( logicRow as LogicRowRef ) as CFTypeRefdouble visibility = fn LogicDouble( logicRow, @"Visibility" ), ceilingFt = 99999if ( fn LogicIsEmpty( logicRow, @"Ceiling" ) == NO ) then ceilingFt = fn LogicDouble( logicRow, @"Ceiling" )if ( ceilingFt < 500 || visibility < 1 ) then exit fn = @"LIFR"if ( ceilingFt < 1000 || visibility < 3 ) then exit fn = @"IFR"if ( ceilingFt <= 3000 || visibility <= 5 ) then exit fn = @"MVFR"end fn = @"VFR"// --- aircraft --------------------------------------------------------------------------------------------local fn AircraftEmptyMoment( logicRow as LogicRowRef ) as CFTypeRefend fn = fn NumberWithDouble( fn FlightRounded( fn LogicDouble( logicRow, @"EmptyWeight" ) * fn LogicDouble( logicRow, @"EmptyArm" ), 1 ) )local fn AircraftAnnualDue( logicRow as LogicRowRef ) as CFTypeRefif ( fn LogicIsEmpty( logicRow, @"LastAnnual" ) ) then exit fn = NULLend fn = fn FlightEndOfMonthAfter( fn LogicString( logicRow, @"LastAnnual" ), 12 )local fn AircraftTransponderDue( logicRow as LogicRowRef ) as CFTypeRefif ( fn LogicIsEmpty( logicRow, @"LastTransponder" ) ) then exit fn = NULLend fn = fn FlightEndOfMonthAfter( fn LogicString( logicRow, @"LastTransponder" ), 24 )local fn AircraftEltDue( logicRow as LogicRowRef ) as CFTypeRefif ( fn LogicIsEmpty( logicRow, @"LastElt" ) ) then exit fn = NULLend fn = fn FlightEndOfMonthAfter( fn LogicString( logicRow, @"LastElt" ), 12 )local fn AircraftHoursSince100( logicRow as LogicRowRef ) as CFTypeRefend fn = fn NumberWithDouble( fn FlightRounded( fn LogicDouble( logicRow, @"Hours100Base" ) + fn LogicDouble( logicRow, @"FlownMinutes" ) / 60.0, 1 ) )// --- the pilot -------------------------------------------------------------------------------------------// 61.23: 60 calendar months when under 40 at the exam, else 24local fn PilotMedicalExpires( logicRow as LogicRowRef ) as CFTypeReflong age, months = 24if ( fn LogicIsEmpty( logicRow, @"MedicalClass" ) || fn LogicIsEmpty( logicRow, @"MedicalExam" ) ) then exit fn = NULLage = fn FlightAgeOn( fn LogicString( logicRow, @"BirthDate" ), fn LogicString( logicRow, @"MedicalExam" ) )if ( age >= 0 && age < 40 ) then months = 60end fn = fn FlightEndOfMonthAfter( fn LogicString( logicRow, @"MedicalExam" ), months )// BasicMed: the earlier of the course + 24 months and the exam + 48 monthslocal fn PilotBasicMedUntil( logicRow as LogicRowRef ) as CFTypeRefCFStringRef courseUntil, examUntilif ( fn LogicIsEmpty( logicRow, @"BasicMedCourse" ) || fn LogicIsEmpty( logicRow, @"BasicMedExam" ) ) then exit fn = NULLcourseUntil = fn FlightEndOfMonthAfter( fn LogicString( logicRow, @"BasicMedCourse" ), 24 )examUntil = fn FlightEndOfMonthAfter( fn LogicString( logicRow, @"BasicMedExam" ), 48 )if ( fn FlightBefore( examUntil, courseUntil ) ) then exit fn = examUntilend fn = courseUntillocal fn PilotReviewDue( logicRow as LogicRowRef ) as CFTypeRefif ( fn LogicIsEmpty( logicRow, @"FlightReview" ) ) then exit fn = NULLend fn = fn FlightEndOfMonthAfter( fn LogicString( logicRow, @"FlightReview" ), 24 )local fn LogbookRecent( logicRow as LogicRowRef ) as CFTypeRefif ( fn FlightWithin90( fn LogicString( logicRow, @"EntryDate" ), fn LogicParentString( logicRow, @"Pilot", @"AsOf" ) ) ) then exit fn = fn NumberWithLong( 1 )end fn = fn NumberWithLong( 0 )local fn LogbookNightWithinLandings( logicRow as LogicRowRef ) as BOOLend fn = ( fn LogicDouble( logicRow, @"NightLandings" ) <= fn LogicDouble( logicRow, @"Landings" ) )local fn EntryIsRecent( logicRow as LogicRowRef ) as BOOLend fn = ( fn LogicDouble( logicRow, @"Recent" ) != 0 )local fn EndorsementRecent( logicRow as LogicRowRef ) as CFTypeRefif ( fn FlightWithin90( fn LogicString( logicRow, @"EndorsedDate" ), fn LogicParentString( logicRow, @"Pilot", @"AsOf" ) ) ) then exit fn = fn NumberWithLong( 1 )end fn = fn NumberWithLong( 0 )local fn EndorsementRecentSolo( logicRow as LogicRowRef ) as BOOLend fn = ( fn StringIsEqual( fn LogicString( logicRow, @"Kind" ), @"S" ) && fn LogicDouble( logicRow, @"Recent" ) != 0 )local fn EndorsementRecentClassB( logicRow as LogicRowRef ) as BOOLend fn = ( fn StringIsEqual( fn LogicString( logicRow, @"Kind" ), @"B" ) && fn LogicDouble( logicRow, @"Recent" ) != 0 )local fn EndorsementCrossCountry( logicRow as LogicRowRef ) as BOOLend fn = fn StringIsEqual( fn LogicString( logicRow, @"Kind" ), @"X" )local fn EndorsementHasItsFlight( logicRow as LogicRowRef ) as BOOLif ( fn EndorsementCrossCountry( logicRow ) == NO ) then exit fn = YESend fn = ( fn LogicIsEmpty( logicRow, @"FlightPlanId" ) == NO )local fn PlanFlown( logicRow as LogicRowRef ) as BOOLend fn = fn StringIsEqual( fn LogicString( logicRow, @"Status" ), @"C" )local fn PlanStudent( logicRow as LogicRowRef ) as CFTypeRefif ( fn StringIsEqual( fn LogicParentString( logicRow, @"Pilot", @"Certificate" ), @"S" ) ) then exit fn = fn NumberWithLong( 1 )end fn = fn NumberWithLong( 0 )// --- a leg -----------------------------------------------------------------------------------------------// the distance (wantCourse NO, NM to 0.1) or the initial true course (YES, whole degrees 0-359); NULL without both airportslocal fn LegGreatCircle( logicRow as LogicRowRef, wantCourse as BOOL ) as CFTypeRefdouble lat1, lon1, lat2, lon2, dLon, h, miles, bearing, toRadians = M_PI / 180.0if ( fn LogicParent( logicRow, @"FromAirport" ) == NULL || fn LogicParent( logicRow, @"ToAirport" ) == NULL ) then exit fn = NULLlat1 = fn LogicParentDouble( logicRow, @"FromAirport", @"Latitude" ) * toRadianslon1 = fn LogicParentDouble( logicRow, @"FromAirport", @"Longitude" ) * toRadianslat2 = fn LogicParentDouble( logicRow, @"ToAirport", @"Latitude" ) * toRadianslon2 = fn LogicParentDouble( logicRow, @"ToAirport", @"Longitude" ) * toRadiansdLon = lon2 - lon1if ( wantCourse )bearing = fn atan2( sin( dLon ) * cos( lat2 ), cos( lat1 ) * sin( lat2 ) - sin( lat1 ) * cos( lat2 ) * cos( dLon ) ) / toRadiansexit fn = fn NumberWithLong( fn fmod( fn FlightRounded( bearing, 0 ) + 360.0, 360.0 ) )end ifh = sin( ( lat2 - lat1 ) / 2.0 ) * sin( ( lat2 - lat1 ) / 2.0 ) + cos( lat1 ) * cos( lat2 ) * sin( dLon / 2.0 ) * sin( dLon / 2.0 )miles = 2.0 * 3440.065 * fn atan2( fn sqrt( h ), fn sqrt( 1.0 - h ) )end fn = fn NumberWithDouble( fn FlightRounded( miles, 1 ) )local fn LegDistance( logicRow as LogicRowRef ) as CFTypeRefend fn = fn LegGreatCircle( logicRow, NO )local fn LegTrueCourse( logicRow as LogicRowRef ) as CFTypeRefend fn = fn LegGreatCircle( logicRow, YES )local fn LegMagneticCourse( logicRow as LogicRowRef ) as CFTypeRefif ( fn LogicIsEmpty( logicRow, @"TrueCourse" ) ) then exit fn = NULLend fn = fn NumberWithLong( fn fmod( fn LogicDouble( logicRow, @"TrueCourse" ) + fn LogicParentDouble( logicRow, @"FromAirport", @"Variation" ) + 360.0, 360.0 ) )// the wind triangle: wantSpeed NO for the wind correction angle, YES for the ground speed; NULL when the wind is as fast as the aircraftlocal fn LegWindTriangle( logicRow as LogicRowRef, wantSpeed as BOOL ) as CFTypeRefdouble tas = fn LogicParentDouble( logicRow, @"FlightPlan", @"CruiseKnots" ), windKnots = fn LogicDouble( logicRow, @"WindSpeed" )double windAngle, wcaif ( tas <= 0 || windKnots >= tas ) then exit fn = NULLwindAngle = ( fn LogicDouble( logicRow, @"WindDirection" ) - fn LogicDouble( logicRow, @"TrueCourse" ) ) * M_PI / 180.0wca = asin( windKnots * sin( windAngle ) / tas )if ( wantSpeed ) then exit fn = fn NumberWithLong( fn FlightRounded( tas * cos( wca ) - windKnots * cos( windAngle ), 0 ) )end fn = fn NumberWithLong( fn FlightRounded( wca * 180.0 / M_PI, 0 ) )local fn LegWindCorrection( logicRow as LogicRowRef ) as CFTypeRefend fn = fn LegWindTriangle( logicRow, NO )local fn LegGroundSpeed( logicRow as LogicRowRef ) as CFTypeRefend fn = fn LegWindTriangle( logicRow, YES )local fn LegTrueHeading( logicRow as LogicRowRef ) as CFTypeRefend fn = fn NumberWithLong( fn fmod( fn LogicDouble( logicRow, @"TrueCourse" ) + fn LogicDouble( logicRow, @"WindCorrection" ) + 360.0, 360.0 ) )local fn LegMagneticHeading( logicRow as LogicRowRef ) as CFTypeRefend fn = fn NumberWithLong( fn fmod( fn LogicDouble( logicRow, @"TrueHeading" ) + fn LogicParentDouble( logicRow, @"FromAirport", @"Variation" ) + 360.0, 360.0 ) )local fn LegMinutes( logicRow as LogicRowRef ) as CFTypeRefdouble speed = fn LogicDouble( logicRow, @"GroundSpeed" )if ( speed <= 0 ) then exit fn = NULLend fn = fn NumberWithLong( fn FlightRounded( fn LogicDouble( logicRow, @"Distance" ) / speed * 60.0, 0 ) )local fn LegFuel( logicRow as LogicRowRef ) as CFTypeRefend fn = fn NumberWithDouble( fn FlightRounded( fn LogicDouble( logicRow, @"Minutes" ) / 60.0 * fn LogicParentDouble( logicRow, @"FlightPlan", @"FuelBurn" ), 1 ) )local fn LegLandingDistance( logicRow as LogicRowRef ) as CFTypeRefend fn = fn NumberWithLong( fn FlightRounded( fn LogicParentDouble( logicRow, @"FlightPlan", @"LandingDistance" ) * fn FlightDistanceFactor( fn LogicParentDouble( logicRow, @"Weather", @"DensityAltitude" ) ), 0 ) )local fn LegCrosswind( logicRow as LogicRowRef ) as CFTypeRefif ( fn LogicIsEmpty( logicRow, @"WeatherId" ) || fn LogicIsEmpty( logicRow, @"RunwayId" ) ) then exit fn = NULLend fn = fn NumberWithLong( fn FlightCrosswind( fn LogicParentDouble( logicRow, @"Weather", @"WindDirection" ), fn LogicParentDouble( logicRow, @"Weather", @"WindSpeed" ), fn LogicParentDouble( logicRow, @"Weather", @"Gust" ), fn LogicParentDouble( logicRow, @"Runway", @"Heading" ), fn LogicParentDouble( logicRow, @"Runway", @"Variation" ) ) )local fn LegHighestGround( logicRow as LogicRowRef ) as doubledouble fromFt = fn LogicParentDouble( logicRow, @"FromAirport", @"Elevation" )double toFt = fn LogicParentDouble( logicRow, @"ToAirport", @"Elevation" )if ( toFt > fromFt ) then exit fn = toFtend fn = fromFt// Leg.Problem: the first thing wrong with the leg; NULL when nonelocal fn LegProblem( logicRow as LogicRowRef ) as CFTypeRefCFStringRef ident = fn LogicParentString( logicRow, @"ToAirport", @"Ident" )CFStringRef runwayIdent = fn LogicParentString( logicRow, @"Runway", @"Ident" )CFTypeRef ceilingValueBOOL hasCeilingif ( fn FlightAltitudeOK( fn LogicLong( logicRow, @"Altitude" ), fn LogicDouble( logicRow, @"MagneticCourse" ), fn LegHighestGround( logicRow ) ) == NO ) then exit fn = fn StringWithFormat( @"%ld ft is not a VFR cruising altitude for a magnetic course of %ld", fn LogicLong( logicRow, @"Altitude" ), fn LogicLong( logicRow, @"MagneticCourse" ) )if ( fn LogicParentDouble( logicRow, @"ToAirport", @"ClosedNotams" ) > 0 ) then exit fn = fn StringWithFormat( @"%@ is closed (NOTAM)", ident )if ( fn LogicIsEmpty( logicRow, @"RunwayId" ) ) then exit fn = fn StringWithFormat( @"No landing runway chosen at %@", ident )if ( fn LogicDouble( logicRow, @"LandingDistance" ) * 1.5 > fn LogicParentDouble( logicRow, @"Runway", @"Length" ) ) then exit fn = fn StringWithFormat( @"Landing needs %ld ft x 1.5: runway %@ at %@ is %ld ft", fn LogicLong( logicRow, @"LandingDistance" ), runwayIdent, ident, (long)fn LogicParentDouble( logicRow, @"Runway", @"Length" ) )if ( fn LogicIsEmpty( logicRow, @"WeatherId" ) ) then exit fn = fn StringWithFormat( @"No weather briefed for %@", ident )if ( fn LogicDouble( logicRow, @"Crosswind" ) > fn LogicParentDouble( logicRow, @"FlightPlan", @"MaxCrosswind" ) ) then exit fn = fn StringWithFormat( @"%ld kt crosswind on runway %@ at %@: the aircraft is demonstrated to %ld", fn LogicLong( logicRow, @"Crosswind" ), runwayIdent, ident, (long)fn LogicParentDouble( logicRow, @"FlightPlan", @"MaxCrosswind" ) )ceilingValue = fn LogicParentValue( logicRow, @"Weather", @"Ceiling" )hasCeiling = ( fn DataIsNull( ceilingValue ) == NO )if ( fn FlightMinimumsOK( fn LogicString( logicRow, @"ToAirspace" ), fn LogicParentDouble( logicRow, @"FlightPlan", @"Night" ) != 0, fn LogicParentDouble( logicRow, @"FlightPlan", @"Student" ) != 0, fn LogicParentDouble( logicRow, @"Weather", @"Visibility" ), hasCeiling, fn LogicNumberOf( ceilingValue ) ) == NO )if ( hasCeiling ) then exit fn = fn StringWithFormat( @"Below VFR minimums at %@: %@ SM, ceiling %ld ft", ident, fn FlightNumberText( fn LogicParentDouble( logicRow, @"Weather", @"Visibility" ) ), (long)fn LogicNumberOf( ceilingValue ) )exit fn = fn StringWithFormat( @"Below VFR minimums at %@: %@ SM", ident, fn FlightNumberText( fn LogicParentDouble( logicRow, @"Weather", @"Visibility" ) ) )end ifend fn = NULLlocal fn LegGoesSomewhere( logicRow as LogicRowRef ) as BOOLend fn = ( fn LogicDouble( logicRow, @"FromAirportId" ) != fn LogicDouble( logicRow, @"ToAirportId" ) )local fn LegWindSlowerThanAircraft( logicRow as LogicRowRef ) as BOOLend fn = ( fn LogicDouble( logicRow, @"WindSpeed" ) < fn LogicParentDouble( logicRow, @"FlightPlan", @"CruiseKnots" ) )local fn LegHighEnough( logicRow as LogicRowRef ) as BOOLend fn = ( fn LogicDouble( logicRow, @"Altitude" ) >= fn LegHighestGround( logicRow ) + 1000 )local fn LegRunwayAtDestination( logicRow as LogicRowRef ) as BOOLif ( fn LogicIsEmpty( logicRow, @"RunwayId" ) ) then exit fn = YESend fn = ( fn LogicParentDouble( logicRow, @"Runway", @"AirportId" ) == fn LogicDouble( logicRow, @"ToAirportId" ) )local fn LegWeatherAtDestination( logicRow as LogicRowRef ) as BOOLif ( fn LogicIsEmpty( logicRow, @"WeatherId" ) ) then exit fn = YESend fn = ( fn LogicParentDouble( logicRow, @"Weather", @"AirportId" ) == fn LogicDouble( logicRow, @"ToAirportId" ) )local fn LegHasProblem( logicRow as LogicRowRef ) as BOOLend fn = ( fn StringLength( fn LogicString( logicRow, @"Problem" ) ) > 0 )local fn LegToClassB( logicRow as LogicRowRef ) as BOOLend fn = fn StringIsEqual( fn LogicString( logicRow, @"ToAirspace" ), @"B" )// --- the load: weight and balance -------------------------------------------------------------------------local fn LoadMoment( logicRow as LogicRowRef ) as CFTypeRefend fn = fn NumberWithDouble( fn FlightRounded( fn LogicDouble( logicRow, @"Weight" ) * fn LogicDouble( logicRow, @"Arm" ), 1 ) )local fn LoadWithinStation( logicRow as LogicRowRef ) as BOOLend fn = ( fn LogicDouble( logicRow, @"Weight" ) <= fn LogicDouble( logicRow, @"MaxWeight" ) )local fn LoadInThisAircraft( logicRow as LogicRowRef ) as BOOLend fn = ( fn LogicParentDouble( logicRow, @"AircraftStation", @"AircraftId" ) == fn LogicParentDouble( logicRow, @"FlightPlan", @"AircraftId" ) )local fn PlanRampWeight( logicRow as LogicRowRef ) as CFTypeRefend fn = fn NumberWithDouble( fn FlightRounded( fn LogicParentDouble( logicRow, @"Aircraft", @"EmptyWeight" ) + fn LogicDouble( logicRow, @"PayloadWeight" ) + fn LogicDouble( logicRow, @"FuelOnBoard" ) * 6.0, 1 ) )local fn PlanTakeoffWeight( logicRow as LogicRowRef ) as CFTypeRefend fn = fn NumberWithDouble( fn FlightRounded( fn LogicDouble( logicRow, @"RampWeight" ) - fn LogicParentDouble( logicRow, @"Aircraft", @"TaxiFuel" ) * 6.0, 1 ) )local fn PlanCG( logicRow as LogicRowRef ) as CFTypeRefdouble takeoffLb = fn LogicDouble( logicRow, @"TakeoffWeight" ), fuelMomentif ( takeoffLb <= 0 ) then exit fn = NULLfuelMoment = ( fn LogicDouble( logicRow, @"FuelOnBoard" ) - fn LogicParentDouble( logicRow, @"Aircraft", @"TaxiFuel" ) ) * 6.0 * fn LogicParentDouble( logicRow, @"Aircraft", @"FuelArm" )end fn = fn NumberWithDouble( fn FlightRounded( ( fn LogicParentDouble( logicRow, @"Aircraft", @"EmptyMoment" ) + fn LogicDouble( logicRow, @"PayloadMoment" ) + fuelMoment ) / takeoffLb, 2 ) )// the forward CG limit at the takeoff weight: flat to the break weight, then a straight line to MaxTakeofflocal fn PlanForwardLimit( logicRow as LogicRowRef ) as CFTypeRefdouble fwdLight = fn LogicParentDouble( logicRow, @"Aircraft", @"FwdLimitLight" ), fwdHeavy = fn LogicParentDouble( logicRow, @"Aircraft", @"FwdLimitHeavy" )double breakLb = fn LogicParentDouble( logicRow, @"Aircraft", @"FwdBreakWeight" ), topLb = fn LogicParentDouble( logicRow, @"Aircraft", @"MaxTakeoff" )double takeoffLb = fn LogicDouble( logicRow, @"TakeoffWeight" )if ( takeoffLb <= breakLb || topLb <= breakLb ) then exit fn = fn NumberWithDouble( fwdLight )end fn = fn NumberWithDouble( fn FlightRounded( fwdLight + ( fwdHeavy - fwdLight ) * ( takeoffLb - breakLb ) / ( topLb - breakLb ), 2 ) )local fn PlanLandingWeight( logicRow as LogicRowRef ) as CFTypeRefend fn = fn NumberWithDouble( fn FlightRounded( fn LogicDouble( logicRow, @"TakeoffWeight" ) - ( fn LogicDouble( logicRow, @"TripFuel" ) + fn LogicParentDouble( logicRow, @"Aircraft", @"ClimbFuel" ) ) * 6.0, 1 ) )// --- the plan: fuel, departure, times -------------------------------------------------------------------------local fn PlanReserveFuel( logicRow as LogicRowRef ) as CFTypeRefdouble reserveMinutes = 30.0if ( fn LogicDouble( logicRow, @"Night" ) != 0 ) then reserveMinutes = 45.0end fn = fn NumberWithDouble( fn FlightRounded( fn LogicDouble( logicRow, @"FuelBurn" ) * reserveMinutes / 60.0, 1 ) )local fn PlanFuelRequired( logicRow as LogicRowRef ) as CFTypeRefend fn = fn NumberWithDouble( fn FlightRounded( fn LogicParentDouble( logicRow, @"Aircraft", @"TaxiFuel" ) + fn LogicParentDouble( logicRow, @"Aircraft", @"ClimbFuel" ) + fn LogicDouble( logicRow, @"TripFuel" ) + fn LogicDouble( logicRow, @"ReserveFuel" ), 1 ) )local fn PlanFuelMargin( logicRow as LogicRowRef ) as CFTypeRefend fn = fn NumberWithDouble( fn FlightRounded( fn LogicDouble( logicRow, @"FuelOnBoard" ) - fn LogicDouble( logicRow, @"FuelRequired" ), 1 ) )local fn PlanEndurance( logicRow as LogicRowRef ) as CFTypeRefdouble burn = fn LogicDouble( logicRow, @"FuelBurn" )if ( burn <= 0 ) then exit fn = fn NumberWithLong( 0 )end fn = fn NumberWithLong( fn FlightRounded( fn LogicDouble( logicRow, @"FuelOnBoard" ) / burn * 60.0, 0 ) )local fn PlanFuelFits( logicRow as LogicRowRef ) as BOOLend fn = ( fn LogicDouble( logicRow, @"FuelOnBoard" ) <= fn LogicParentDouble( logicRow, @"Aircraft", @"UsableFuel" ) )local fn PlanTakeoffDistance( logicRow as LogicRowRef ) as CFTypeRefdouble topLb = fn LogicParentDouble( logicRow, @"Aircraft", @"MaxTakeoff" )if ( topLb <= 0 ) then exit fn = NULLend fn = fn NumberWithLong( fn FlightRounded( fn LogicParentDouble( logicRow, @"Aircraft", @"TakeoffDistance" ) * fn FlightDistanceFactor( fn LogicParentDouble( logicRow, @"Weather", @"DensityAltitude" ) ) * fn LogicDouble( logicRow, @"TakeoffWeight" ) / topLb, 0 ) )local fn PlanCrosswind( logicRow as LogicRowRef ) as CFTypeRefif ( fn LogicIsEmpty( logicRow, @"WeatherId" ) || fn LogicIsEmpty( logicRow, @"RunwayId" ) ) then exit fn = NULLend fn = fn NumberWithLong( fn FlightCrosswind( fn LogicParentDouble( logicRow, @"Weather", @"WindDirection" ), fn LogicParentDouble( logicRow, @"Weather", @"WindSpeed" ), fn LogicParentDouble( logicRow, @"Weather", @"Gust" ), fn LogicParentDouble( logicRow, @"Runway", @"Heading" ), fn LogicParentDouble( logicRow, @"Runway", @"Variation" ) ) )local fn PlanDepartureSameAirport( logicRow as LogicRowRef ) as BOOLif ( fn LogicIsEmpty( logicRow, @"RunwayId" ) || fn LogicIsEmpty( logicRow, @"WeatherId" ) ) then exit fn = YESend fn = ( fn LogicParentDouble( logicRow, @"Runway", @"AirportId" ) == fn LogicParentDouble( logicRow, @"Weather", @"AirportId" ) )local fn PlanETA( logicRow as LogicRowRef ) as CFTypeRefCFStringRef leaving = fn LogicString( logicRow, @"ActualDeparture" )if ( fn StringLength( leaving ) == 0 ) then leaving = fn LogicString( logicRow, @"DepartureTime" )end fn = fn FlightClockPlus( leaving, fn LogicLong( logicRow, @"Minutes" ) )local fn PlanSearchAt( logicRow as LogicRowRef ) as CFTypeRefend fn = fn FlightClockPlus( fn LogicString( logicRow, @"ETA" ), 30 )// --- go / no-go -----------------------------------------------------------------------------------------------// is the aircraft's date (annual, transponder, ELT, battery) before the flight?local fn PlanAircraftLapsed( logicRow as LogicRowRef, attrName as CFStringRef, flightDate as CFStringRef ) as BOOLend fn = fn FlightBefore( fn LogicParentString( logicRow, @"Aircraft", attrName ), flightDate )// FlightPlan.NoGoReason: the first reason the flight may not go; NULL for a GOlocal fn PlanNoGoReason( logicRow as LogicRowRef ) as CFTypeRefCFStringRef flightDate = fn LogicString( logicRow, @"DepartureDate" )double persons = fn LogicDouble( logicRow, @"PersonsOnBoard" )BOOL basicMedCFTypeRef ceilingValueif ( fn LogicDouble( logicRow, @"LegCount" ) == 0 ) then exit fn = @"The plan has no legs"if ( persons < 1 ) then exit fn = @"No one on board: put the pilot in the load"basicMed = ( fn FlightBefore( fn LogicParentString( logicRow, @"Pilot", @"BasicMedUntil" ), flightDate ) == NO && persons <= 6 && fn LogicParentDouble( logicRow, @"Aircraft", @"MaxTakeoff" ) <= 6000 )if ( fn FlightBefore( fn LogicParentString( logicRow, @"Pilot", @"MedicalExpires" ), flightDate ) && basicMed == NO ) then exit fn = fn StringWithFormat( @"The pilot's medical is not valid on %@", flightDate )if ( fn LogicDouble( logicRow, @"Student" ) != 0 )if ( persons > 1 ) then exit fn = @"A student pilot carries no passengers"if ( fn LogicParentDouble( logicRow, @"Pilot", @"SoloEndorsements" ) == 0 ) then exit fn = @"No solo endorsement in the last 90 days"if ( fn LogicDouble( logicRow, @"Distance" ) > 25 && fn LogicDouble( logicRow, @"XcEndorsements" ) == 0 ) then exit fn = @"No cross-country endorsement for this flight"if ( fn LogicDouble( logicRow, @"ClassBLegs" ) > 0 && fn LogicParentDouble( logicRow, @"Pilot", @"ClassBEndorsements" ) == 0 ) then exit fn = @"No endorsement for Class B airspace"elseif ( fn FlightBefore( fn LogicParentString( logicRow, @"Pilot", @"ReviewDue" ), flightDate ) ) then exit fn = @"The pilot's flight review is due"end ifif ( persons > 1 && fn LogicParentDouble( logicRow, @"Pilot", @"Landings90" ) < 3 ) then exit fn = @"Not current to carry passengers: three landings in the last 90 days"if ( persons > 1 && fn LogicDouble( logicRow, @"Night" ) != 0 && fn LogicParentDouble( logicRow, @"Pilot", @"NightLandings90" ) < 3 ) then exit fn = @"Not night current to carry passengers: three full-stop night landings in the last 90 days"if ( fn PlanAircraftLapsed( logicRow, @"AnnualDue", flightDate ) ) then exit fn = fn StringWithFormat( @"The aircraft's annual inspection is not current on %@", flightDate )if ( fn PlanAircraftLapsed( logicRow, @"TransponderDue", flightDate ) ) then exit fn = fn StringWithFormat( @"The aircraft's transponder check is not current on %@", flightDate )if ( fn PlanAircraftLapsed( logicRow, @"EltDue", flightDate ) ) then exit fn = fn StringWithFormat( @"The aircraft's ELT inspection is not current on %@", flightDate )if ( fn PlanAircraftLapsed( logicRow, @"EltBatteryExpires", flightDate ) ) then exit fn = fn StringWithFormat( @"The aircraft's ELT battery is not current on %@", flightDate )if ( fn LogicParentDouble( logicRow, @"Aircraft", @"ForHire" ) != 0 && fn LogicParentDouble( logicRow, @"Aircraft", @"HoursSince100" ) + fn LogicDouble( logicRow, @"Minutes" ) / 60.0 > 100 ) then exit fn = @"The flight would run past the 100-hour inspection"if ( fn LogicDouble( logicRow, @"TakeoffWeight" ) > fn LogicParentDouble( logicRow, @"Aircraft", @"MaxTakeoff" ) ) then exit fn = fn StringWithFormat( @"%@ lb at takeoff: the maximum is %@", fn FlightNumberText( fn LogicDouble( logicRow, @"TakeoffWeight" ) ), fn FlightNumberText( fn LogicParentDouble( logicRow, @"Aircraft", @"MaxTakeoff" ) ) )if ( fn LogicDouble( logicRow, @"CG" ) < fn LogicDouble( logicRow, @"ForwardLimit" ) || fn LogicDouble( logicRow, @"CG" ) > fn LogicParentDouble( logicRow, @"Aircraft", @"AftLimit" ) ) then exit fn = fn StringWithFormat( @"The centre of gravity, %@ in, is outside %@ to %@", fn FlightNumberText( fn LogicDouble( logicRow, @"CG" ) ), fn FlightNumberText( fn LogicDouble( logicRow, @"ForwardLimit" ) ), fn FlightNumberText( fn LogicParentDouble( logicRow, @"Aircraft", @"AftLimit" ) ) )if ( fn LogicIsEmpty( logicRow, @"RunwayId" ) || fn LogicIsEmpty( logicRow, @"WeatherId" ) ) then exit fn = @"No departure runway or weather"if ( fn LogicDouble( logicRow, @"TakeoffDistance" ) * 1.5 > fn LogicParentDouble( logicRow, @"Runway", @"Length" ) ) then exit fn = fn StringWithFormat( @"Takeoff needs %ld ft x 1.5: the runway is %ld ft", fn LogicLong( logicRow, @"TakeoffDistance" ), (long)fn LogicParentDouble( logicRow, @"Runway", @"Length" ) )if ( fn LogicDouble( logicRow, @"Crosswind" ) > fn LogicDouble( logicRow, @"MaxCrosswind" ) ) then exit fn = fn StringWithFormat( @"%ld kt crosswind on departure: the aircraft is demonstrated to %ld", fn LogicLong( logicRow, @"Crosswind" ), fn LogicLong( logicRow, @"MaxCrosswind" ) )ceilingValue = fn LogicParentValue( logicRow, @"Weather", @"Ceiling" )if ( fn FlightMinimumsOK( fn LogicParentString( logicRow, @"Runway", @"Airspace" ), fn LogicDouble( logicRow, @"Night" ) != 0, fn LogicDouble( logicRow, @"Student" ) != 0, fn LogicParentDouble( logicRow, @"Weather", @"Visibility" ), fn DataIsNull( ceilingValue ) == NO, fn LogicNumberOf( ceilingValue ) ) == NO ) then exit fn = @"Below VFR minimums for departure"if ( fn LogicDouble( logicRow, @"LegProblems" ) > 0 ) then exit fn = fn StringWithFormat( @"%ld leg(s) with a problem: see the legs", fn LogicLong( logicRow, @"LegProblems" ) )if ( fn LogicDouble( logicRow, @"FuelMargin" ) < 0 ) then exit fn = fn StringWithFormat( @"Not enough fuel: %@ gallons needed with the reserve, %@ on board", fn FlightNumberText( fn LogicDouble( logicRow, @"FuelRequired" ) ), fn FlightNumberText( fn LogicDouble( logicRow, @"FuelOnBoard" ) ) )end fn = NULLlocal fn PlanGoNoGo( logicRow as LogicRowRef ) as CFTypeRefif ( fn LogicIsEmpty( logicRow, @"NoGoReason" ) ) then exit fn = @"GO"end fn = @"NO-GO"local fn PlanFiledOnlyIfGo( logicRow as LogicRowRef ) as BOOLif ( fn StringIsEqual( fn LogicString( logicRow, @"Status" ), @"F" ) == NO ) then exit fn = YESend fn = fn StringIsEqual( fn LogicString( logicRow, @"GoNoGo" ), @"GO" )// Draft - Filed - Active - Closed: D to D or F; F to D, F or A; A to A or C; C stays; a new plan is a draftlocal fn PlanNextStatus( logicRow as LogicRowRef ) as BOOLCFStringRef newStatus = fn LogicString( logicRow, @"Status" ), oldStatus, allowed = @"D"if ( fn LogicIsInsert( logicRow ) == NO )oldStatus = fn FlightText( (CFStringRef)fn LogicOldValue( logicRow, @"Status" ) )if ( fn DataIsNull( fn LogicOldValue( logicRow, @"Status" ) ) ) then oldStatus = @""if ( fn StringIsEqual( newStatus, oldStatus ) ) then exit fn = YESallowed = @""if ( fn StringIsEqual( oldStatus, @"D" ) ) then allowed = @"DF"if ( fn StringIsEqual( oldStatus, @"F" ) ) then allowed = @"DFA"if ( fn StringIsEqual( oldStatus, @"A" ) ) then allowed = @"AC"if ( fn StringIsEqual( oldStatus, @"C" ) ) then allowed = @"C"end ifif ( fn StringLength( newStatus ) != 1 ) then exit fn = NOend fn = fn StringContainsString( allowed, newStatus )local fn PlanActiveHasDeparture( logicRow as LogicRowRef ) as BOOLif ( fn StringIsEqual( fn LogicString( logicRow, @"Status" ), @"A" ) == NO && fn StringIsEqual( fn LogicString( logicRow, @"Status" ), @"C" ) == NO ) then exit fn = YESend fn = ( fn StringLength( fn LogicString( logicRow, @"ActualDeparture" ) ) > 0 )local fn ReportOnTheGlobe( logicRow as LogicRowRef ) as BOOLdouble lat = fn LogicDouble( logicRow, @"Latitude" ), lon = fn LogicDouble( logicRow, @"Longitude" )end fn = ( lat >= -90 && lat <= 90 && lon >= -180 && lon <= 180 )void local fn DeclareRulesCFArrayRef legPlaces = @[ @"FromAirportId", @"FromAirport.Latitude", @"FromAirport.Longitude", @"ToAirportId", @"ToAirport.Latitude", @"ToAirport.Longitude" ]CFArrayRef windParts = @[ @"TrueCourse", @"WindDirection", @"WindSpeed", @"FlightPlanId", @"FlightPlan.CruiseKnots" ]// airports, runways, weatherfn LogicCount( @"Airport", @"ClosedNotams", @"NotamList", @fn NotamCloses )fn LogicCopy( @"Runway", @"Variation", @"Airport", @"Variation" )fn LogicCopy( @"Runway", @"Airspace", @"Airport", @"Airspace" )fn LogicFormula( @"Weather", @"DensityAltitude", @fn WeatherDensityAltitude, @[ @"AirportId", @"Airport.Elevation", @"Altimeter", @"Temperature" ] )fn LogicFormula( @"Weather", @"Category", @fn WeatherCategory, @[ @"Visibility", @"Ceiling" ] )// aircraft: this airframe's figures, from its typefn LogicCopy( @"Aircraft", @"CruiseKnots", @"AircraftType", @"CruiseKnots" )fn LogicCopy( @"Aircraft", @"FuelBurn", @"AircraftType", @"FuelBurn" )fn LogicCopy( @"Aircraft", @"UsableFuel", @"AircraftType", @"UsableFuel" )fn LogicCopy( @"Aircraft", @"MaxCrosswind", @"AircraftType", @"MaxCrosswind" )fn LogicCopy( @"Aircraft", @"TakeoffDistance", @"AircraftType", @"TakeoffDistance" )fn LogicCopy( @"Aircraft", @"LandingDistance", @"AircraftType", @"LandingDistance" )fn LogicCopy( @"Aircraft", @"TaxiFuel", @"AircraftType", @"TaxiFuel" )fn LogicCopy( @"Aircraft", @"ClimbFuel", @"AircraftType", @"ClimbFuel" )fn LogicFormula( @"Aircraft", @"EmptyMoment", @fn AircraftEmptyMoment, @[ @"EmptyWeight", @"EmptyArm" ] )fn LogicFormula( @"Aircraft", @"AnnualDue", @fn AircraftAnnualDue, @[ @"LastAnnual" ] )fn LogicFormula( @"Aircraft", @"TransponderDue", @fn AircraftTransponderDue, @[ @"LastTransponder" ] )fn LogicFormula( @"Aircraft", @"EltDue", @fn AircraftEltDue, @[ @"LastElt" ] )fn LogicFormula( @"Aircraft", @"HoursSince100", @fn AircraftHoursSince100, @[ @"Hours100Base", @"FlownMinutes" ] )fn LogicDeleteAction( @"AircraftType", @"AircraftList", @"prevent", @"{Model}: aircraft of this type are on file" )fn LogicDeleteAction( @"Aircraft", @"FlightPlanList", @"prevent", @"{TailNumber} has flight plans" )fn LogicDeleteAction( @"Aircraft", @"AircraftStationList", @"cascade", NULL )// the pilotfn LogicFormula( @"Pilot", @"MedicalExpires", @fn PilotMedicalExpires, @[ @"MedicalClass", @"MedicalExam", @"BirthDate" ] )fn LogicFormula( @"Pilot", @"BasicMedUntil", @fn PilotBasicMedUntil, @[ @"BasicMedCourse", @"BasicMedExam" ] )fn LogicFormula( @"Pilot", @"ReviewDue", @fn PilotReviewDue, @[ @"FlightReview" ] )fn LogicFormula( @"LogbookEntry", @"Recent", @fn LogbookRecent, @[ @"EntryDate", @"PilotId", @"Pilot.AsOf" ] )fn LogicConstraint( @"LogbookEntry", @fn LogbookNightWithinLandings, @"{NightLandings} night landings, but only {Landings} landings" )fn LogicSum( @"Pilot", @"Landings90", @"LogbookEntryList", @"Landings", @fn EntryIsRecent )fn LogicSum( @"Pilot", @"NightLandings90", @"LogbookEntryList", @"NightLandings", @fn EntryIsRecent )fn LogicFormula( @"Endorsement", @"Recent", @fn EndorsementRecent, @[ @"EndorsedDate", @"PilotId", @"Pilot.AsOf" ] )fn LogicCount( @"Pilot", @"SoloEndorsements", @"EndorsementList", @fn EndorsementRecentSolo )fn LogicCount( @"Pilot", @"ClassBEndorsements", @"EndorsementList", @fn EndorsementRecentClassB )fn LogicConstraint( @"Endorsement", @fn EndorsementHasItsFlight, @"A cross-country endorsement is for one flight: choose its flight plan" )fn LogicCount( @"Pilot", @"FlightCount", @"FlightPlanList", @fn PlanFlown )fn LogicSum( @"Pilot", @"FlownMinutes", @"FlightPlanList", @"Minutes", @fn PlanFlown )fn LogicSum( @"Aircraft", @"FlownMinutes", @"FlightPlanList", @"Minutes", @fn PlanFlown )fn LogicDeleteAction( @"Pilot", @"FlightPlanList", @"prevent", @"{Name} has flight plans" )fn LogicDeleteAction( @"Pilot", @"LogbookEntryList", @"cascade", NULL )fn LogicDeleteAction( @"Pilot", @"EndorsementList", @"cascade", NULL )// the plan: what it fliesfn LogicCopy( @"FlightPlan", @"CruiseKnots", @"Aircraft", @"CruiseKnots" )fn LogicCopy( @"FlightPlan", @"FuelBurn", @"Aircraft", @"FuelBurn" )fn LogicCopy( @"FlightPlan", @"MaxCrosswind", @"Aircraft", @"MaxCrosswind" )fn LogicCopy( @"FlightPlan", @"LandingDistance", @"Aircraft", @"LandingDistance" )fn LogicFormula( @"FlightPlan", @"Student", @fn PlanStudent, @[ @"PilotId", @"Pilot.Certificate" ] )// a legfn LogicFormula( @"Leg", @"Distance", @fn LegDistance, legPlaces )fn LogicFormula( @"Leg", @"TrueCourse", @fn LegTrueCourse, legPlaces )fn LogicFormula( @"Leg", @"MagneticCourse", @fn LegMagneticCourse, @[ @"TrueCourse", @"FromAirport.Variation" ] )fn LogicFormula( @"Leg", @"WindCorrection", @fn LegWindCorrection, windParts )fn LogicFormula( @"Leg", @"GroundSpeed", @fn LegGroundSpeed, windParts )fn LogicFormula( @"Leg", @"TrueHeading", @fn LegTrueHeading, @[ @"TrueCourse", @"WindCorrection" ] )fn LogicFormula( @"Leg", @"MagneticHeading", @fn LegMagneticHeading, @[ @"TrueHeading", @"FromAirport.Variation" ] )fn LogicFormula( @"Leg", @"Minutes", @fn LegMinutes, @[ @"Distance", @"GroundSpeed" ] )fn LogicFormula( @"Leg", @"Fuel", @fn LegFuel, @[ @"Minutes", @"FlightPlanId", @"FlightPlan.FuelBurn" ] )fn LogicCopy( @"Leg", @"ToAirspace", @"ToAirport", @"Airspace" )fn LogicFormula( @"Leg", @"LandingDistance", @fn LegLandingDistance, @[ @"FlightPlanId", @"FlightPlan.LandingDistance", @"WeatherId", @"Weather.DensityAltitude" ] )fn LogicFormula( @"Leg", @"Crosswind", @fn LegCrosswind, @[ @"WeatherId", @"Weather.WindDirection", @"Weather.WindSpeed", @"Weather.Gust", @"RunwayId", @"Runway.Heading", @"Runway.Variation" ] )fn LogicFormula( @"Leg", @"Problem", @fn LegProblem, @[ @"Altitude", @"MagneticCourse", @"FromAirport.Elevation", @"ToAirport.Elevation", @"ToAirportId", @"ToAirport.Ident", @"ToAirport.ClosedNotams", @"RunwayId", @"Runway.Length", @"Runway.Ident", @"LandingDistance", @"WeatherId", @"Crosswind", @"FlightPlan.MaxCrosswind", @"ToAirspace", @"FlightPlan.Night", @"FlightPlan.Student", @"Weather.Visibility", @"Weather.Ceiling" ] )fn LogicParentCheck( @"Leg", @"FromAirport", @"There is no airport {FromAirportId} to leave from" )fn LogicParentCheck( @"Leg", @"ToAirport", @"There is no airport {ToAirportId} to fly to" )fn LogicConstraint( @"Leg", @fn LegGoesSomewhere, @"A leg goes somewhere: it starts and ends at the same airport" )fn LogicConstraint( @"Leg", @fn LegWindSlowerThanAircraft, @"A {WindSpeed} kt wind: as fast as the aircraft" )fn LogicConstraint( @"Leg", @fn LegHighEnough, @"{Altitude} ft is less than 1,000 ft above the airports" )fn LogicConstraint( @"Leg", @fn LegRunwayAtDestination, @"Runway {RunwayId} is not at the destination" )fn LogicConstraint( @"Leg", @fn LegWeatherAtDestination, @"Weather {WeatherId} is not the destination's" )// the load: weight and balancefn LogicCopy( @"LoadItem", @"Arm", @"AircraftStation", @"Arm" )fn LogicCopy( @"LoadItem", @"MaxWeight", @"AircraftStation", @"MaxWeight" )fn LogicFormula( @"LoadItem", @"Moment", @fn LoadMoment, @[ @"Weight", @"Arm" ] )fn LogicConstraint( @"LoadItem", @fn LoadWithinStation, @"{Description}: {Weight} lb, the station takes {MaxWeight}" )fn LogicConstraint( @"LoadItem", @fn LoadInThisAircraft, @"{Description}: that station is not in this plan's aircraft" )fn LogicSum( @"FlightPlan", @"PersonsOnBoard", @"LoadItemList", @"Persons", NULL )fn LogicSum( @"FlightPlan", @"PayloadWeight", @"LoadItemList", @"Weight", NULL )fn LogicSum( @"FlightPlan", @"PayloadMoment", @"LoadItemList", @"Moment", NULL )fn LogicFormula( @"FlightPlan", @"RampWeight", @fn PlanRampWeight, @[ @"AircraftId", @"Aircraft.EmptyWeight", @"PayloadWeight", @"FuelOnBoard" ] )fn LogicFormula( @"FlightPlan", @"TakeoffWeight", @fn PlanTakeoffWeight, @[ @"RampWeight", @"Aircraft.TaxiFuel" ] )fn LogicFormula( @"FlightPlan", @"CG", @fn PlanCG, @[ @"TakeoffWeight", @"PayloadMoment", @"FuelOnBoard", @"Aircraft.TaxiFuel", @"Aircraft.FuelArm", @"Aircraft.EmptyMoment" ] )fn LogicFormula( @"FlightPlan", @"ForwardLimit", @fn PlanForwardLimit, @[ @"TakeoffWeight", @"Aircraft.FwdLimitLight", @"Aircraft.FwdLimitHeavy", @"Aircraft.FwdBreakWeight", @"Aircraft.MaxTakeoff" ] )// the plan: legs, fuel, departure, timesfn LogicCount( @"FlightPlan", @"LegCount", @"LegList", NULL )fn LogicSum( @"FlightPlan", @"Distance", @"LegList", @"Distance", NULL )fn LogicSum( @"FlightPlan", @"Minutes", @"LegList", @"Minutes", NULL )fn LogicSum( @"FlightPlan", @"TripFuel", @"LegList", @"Fuel", NULL )fn LogicCount( @"FlightPlan", @"LegProblems", @"LegList", @fn LegHasProblem )fn LogicCount( @"FlightPlan", @"ClassBLegs", @"LegList", @fn LegToClassB )fn LogicCount( @"FlightPlan", @"XcEndorsements", @"EndorsementList", @fn EndorsementCrossCountry )fn LogicFormula( @"FlightPlan", @"LandingWeight", @fn PlanLandingWeight, @[ @"TakeoffWeight", @"TripFuel", @"Aircraft.ClimbFuel" ] )fn LogicFormula( @"FlightPlan", @"ReserveFuel", @fn PlanReserveFuel, @[ @"FuelBurn", @"Night" ] )fn LogicFormula( @"FlightPlan", @"FuelRequired", @fn PlanFuelRequired, @[ @"Aircraft.TaxiFuel", @"Aircraft.ClimbFuel", @"TripFuel", @"ReserveFuel" ] )fn LogicFormula( @"FlightPlan", @"FuelMargin", @fn PlanFuelMargin, @[ @"FuelOnBoard", @"FuelRequired" ] )fn LogicFormula( @"FlightPlan", @"Endurance", @fn PlanEndurance, @[ @"FuelOnBoard", @"FuelBurn" ] )fn LogicConstraint( @"FlightPlan", @fn PlanFuelFits, @"{FuelOnBoard} gallons on board: the tanks hold less" )fn LogicFormula( @"FlightPlan", @"TakeoffDistance", @fn PlanTakeoffDistance, @[ @"Aircraft.TakeoffDistance", @"Aircraft.MaxTakeoff", @"WeatherId", @"Weather.DensityAltitude", @"TakeoffWeight" ] )fn LogicFormula( @"FlightPlan", @"Crosswind", @fn PlanCrosswind, @[ @"WeatherId", @"Weather.WindDirection", @"Weather.WindSpeed", @"Weather.Gust", @"RunwayId", @"Runway.Heading", @"Runway.Variation" ] )fn LogicConstraint( @"FlightPlan", @fn PlanDepartureSameAirport, @"The departure weather is not for the departure runway's airport" )fn LogicFormula( @"FlightPlan", @"ETA", @fn PlanETA, @[ @"ActualDeparture", @"DepartureTime", @"Minutes" ] )fn LogicFormula( @"FlightPlan", @"SearchAt", @fn PlanSearchAt, @[ @"ETA" ] )// go / no-go and the life cyclefn LogicFormula( @"FlightPlan", @"NoGoReason", @fn PlanNoGoReason, @[ @"LegCount", @"DepartureDate", @"PersonsOnBoard", @"PilotId", @"Pilot.MedicalExpires", @"Pilot.BasicMedUntil", @"Student", @"Pilot.SoloEndorsements", @"Distance", @"XcEndorsements", @"ClassBLegs", @"Pilot.ClassBEndorsements", @"Pilot.ReviewDue", @"Pilot.Landings90", @"Night", @"Pilot.NightLandings90", @"AircraftId", @"Aircraft.AnnualDue", @"Aircraft.TransponderDue", @"Aircraft.EltDue", @"Aircraft.EltBatteryExpires", @"Aircraft.ForHire", @"Aircraft.HoursSince100", @"Minutes", @"TakeoffWeight", @"Aircraft.MaxTakeoff", @"CG", @"ForwardLimit", @"Aircraft.AftLimit", @"RunwayId", @"WeatherId", @"TakeoffDistance", @"Runway.Length", @"Crosswind", @"MaxCrosswind", @"Runway.Airspace", @"Weather.Visibility", @"Weather.Ceiling", @"LegProblems", @"FuelMargin", @"FuelRequired", @"FuelOnBoard" ] )fn LogicFormula( @"FlightPlan", @"GoNoGo", @fn PlanGoNoGo, @[ @"NoGoReason" ] )fn LogicConstraint( @"FlightPlan", @fn PlanFiledOnlyIfGo, @"Not filed - NO-GO: {NoGoReason}" )fn LogicConstraint( @"FlightPlan", @fn PlanNextStatus, @"A plan goes Draft - Filed - Active - Closed: it cannot go to {Status} from here" )fn LogicConstraint( @"FlightPlan", @fn PlanActiveHasDeparture, @"An active plan needs its actual departure time" )fn LogicCount( @"FlightPlan", @"ReportCount", @"PositionReportList", NULL )// refuse first (a flown flight's track), then cascadefn LogicDeleteAction( @"FlightPlan", @"PositionReportList", @"prevent", @"The flight was flown: its track is on file" )fn LogicDeleteAction( @"FlightPlan", @"LegList", @"cascade", NULL )fn LogicDeleteAction( @"FlightPlan", @"LoadItemList", @"cascade", NULL )fn LogicDeleteAction( @"FlightPlan", @"EndorsementList", @"cascade", NULL )// position reportsfn LogicConstraint( @"PositionReport", @fn ReportOnTheGlobe, @"There is no position {Latitude}, {Longitude}" )end fn