/* *   Rules.incl - the Flight Planner sample's business rules (LogicBank for FutureBasic) * *   The Flight Planner sample (samples/FlightPlanner, VFR flights in New England): copy this file over the *   generated app's Rules.incl (FBapp/Rules.incl - the starting template; regeneration never overwrites it). *   The same rules as samples/FlightPlanner/flight_rules.py, which test_rules.py runs scenario by scenario. * *       a leg        distance and initial true course from the airports' coordinates (great circle), the *                    magnetic course, ground speed, minutes and fuel; the VFR hemispheric altitude rule *                    (14 CFR 91.159) and whether the destination's runway is long enough *       the plan     its legs added up; a reserve of 30 minutes by day, 45 at night (14 CFR 91.151) *       go / no-go   the first reason the flight may not go; a plan is filed only when it is a GO *       the logbook  a closed (flown) plan adds its minutes to the pilot and the aircraft * *   sin and cos are FB keywords (radians); atan2, sqrt, floor and fmod come from math.incl. *   NOT FOR NAVIGATION. * *   MIT License. Copyright (c) 2026 Imagery Business Systems, LLC. */// text, never NULLlocal fn FlightText( textValue as CFStringRef ) as CFStringRefif ( textValue == NULL ) then exit fn = @""end fn = textValue// floor( x + 0.5 ) at this many decimals - the reference rounds the same waylocal fn FlightRounded( x as double, decimals as long ) as doubledouble scale = 1.0long ifor i = 1 to decimalsscale = scale * 10.0nextend fn = fn floor( x * scale + 0.5 ) / scale// the day number of an ISO date (yyyy-MM-dd) - the Julian day; -1 when it cannot be readlocal fn FlightDayNumber( isoDate as CFStringRef ) as longlong y, m, d, aif ( isoDate == NULL ) then exit fn = -1if ( fn StringLength( isoDate ) < 10 ) then exit fn = -1y = fn StringIntegerValue( fn StringSubstringWithRange( isoDate, fn CFRangeMake( 0, 4 ) ) )m = fn StringIntegerValue( fn StringSubstringWithRange( isoDate, fn CFRangeMake( 5, 2 ) ) )d = fn StringIntegerValue( fn StringSubstringWithRange( isoDate, fn CFRangeMake( 8, 2 ) ) )if ( y < 1900 || m < 1 || m > 12 || d < 1 || d > 31 ) then exit fn = -1a = fix( ( m - 14 ) / 12.0 )end fn = d - 32075 + fix( 1461 * ( y + 4800 + a ) / 4.0 ) + fix( 367 * ( m - 2 - a * 12 ) / 12.0 ) - fix( 3 * fix( ( y + 4900 + a ) / 100.0 ) / 4.0 )// is ISO date a before ISO date b?  (they compare as text)local fn FlightBefore( a as CFStringRef, b as CFStringRef ) as BOOLend fn = ( fn StringCompare( fn FlightText( a ), fn FlightText( b ) ) == NSOrderedAscending )// --- a leg: the great circle between its airports ---------------------------------------------------// the distance (wantCourse NO, NM to 0.1) or the initial true course (YES, whole degrees 0-359); NULL without both airportslocal fn LegGreatCircle( logicRow as LogicRowRef, wantCourse as BOOL ) as CFTypeRefdouble lat1, lon1, lat2, lon2, dLon, h, miles, bearing, toRadians = M_PI / 180.0if ( fn LogicParent( logicRow, @"FromAirport" ) == NULL || fn LogicParent( logicRow, @"ToAirport" ) == NULL ) then exit fn = NULLlat1 = fn LogicParentDouble( logicRow, @"FromAirport", @"Latitude" ) * toRadianslon1 = fn LogicParentDouble( logicRow, @"FromAirport", @"Longitude" ) * toRadianslat2 = fn LogicParentDouble( logicRow, @"ToAirport", @"Latitude" ) * toRadianslon2 = fn LogicParentDouble( logicRow, @"ToAirport", @"Longitude" ) * toRadiansdLon = lon2 - lon1if ( wantCourse )bearing = fn atan2( sin( dLon ) * cos( lat2 ), cos( lat1 ) * sin( lat2 ) - sin( lat1 ) * cos( lat2 ) * cos( dLon ) ) / toRadiansexit fn = fn NumberWithLong( fn fmod( fn FlightRounded( bearing, 0 ) + 360.0, 360.0 ) )end ifh = sin( ( lat2 - lat1 ) / 2.0 ) * sin( ( lat2 - lat1 ) / 2.0 ) + cos( lat1 ) * cos( lat2 ) * sin( dLon / 2.0 ) * sin( dLon / 2.0 )miles = 2.0 * 3440.065 * fn atan2( fn sqrt( h ), fn sqrt( 1.0 - h ) )end fn = fn NumberWithDouble( fn FlightRounded( miles, 1 ) )local fn LegDistance( logicRow as LogicRowRef ) as CFTypeRefend fn = fn LegGreatCircle( logicRow, NO )local fn LegTrueCourse( logicRow as LogicRowRef ) as CFTypeRefend fn = fn LegGreatCircle( logicRow, YES )// true course + the departure airport's variation (west positive)local fn LegMagneticCourse( logicRow as LogicRowRef ) as CFTypeRefif ( fn LogicIsEmpty( logicRow, @"TrueCourse" ) ) then exit fn = NULLend fn = fn NumberWithLong( fn fmod( fn LogicDouble( logicRow, @"TrueCourse" ) + fn LogicParentDouble( logicRow, @"FromAirport", @"Variation" ) + 360.0, 360.0 ) )local fn LegGroundSpeed( logicRow as LogicRowRef ) as CFTypeRefend fn = fn NumberWithLong( fix( fn LogicParentDouble( logicRow, @"FlightPlan", @"CruiseKnots" ) - fn LogicDouble( logicRow, @"Headwind" ) ) )local fn LegMinutes( logicRow as LogicRowRef ) as CFTypeRefdouble speed = fn LogicDouble( logicRow, @"GroundSpeed" )if ( speed <= 0 ) then exit fn = NULLend fn = fn NumberWithLong( fn FlightRounded( fn LogicDouble( logicRow, @"Distance" ) / speed * 60.0, 0 ) )local fn LegFuel( logicRow as LogicRowRef ) as CFTypeRefend fn = fn NumberWithDouble( fn FlightRounded( fn LogicDouble( logicRow, @"Minutes" ) / 60.0 * fn LogicParentDouble( logicRow, @"FlightPlan", @"FuelBurn" ), 1 ) )// the higher of the two airports' elevationslocal fn LegHighestGround( logicRow as LogicRowRef ) as doubledouble fromFt = fn LogicParentDouble( logicRow, @"FromAirport", @"Elevation" )double toFt = fn LogicParentDouble( logicRow, @"ToAirport", @"Elevation" )if ( toFt > fromFt ) then exit fn = toFtend fn = fromFt// 14 CFR 91.159: more than 3,000 ft above the surface, magnetic course 0-179 at odd thousands + 500,// 180-359 at even thousands + 500local fn LegAltitudeOK( logicRow as LogicRowRef ) as CFTypeReflong altitudeFt = fn LogicLong( logicRow, @"Altitude" )BOOL isOdd, eastboundif ( altitudeFt - fn LegHighestGround( logicRow ) <= 3000 ) then exit fn = fn NumberWithLong( 1 )if ( ( altitudeFt - 500 ) mod 1000 != 0 ) then exit fn = fn NumberWithLong( 0 )isOdd = ( fix( ( altitudeFt - 500 ) / 1000.0 ) mod 2 == 1 )eastbound = ( fn LogicDouble( logicRow, @"MagneticCourse" ) < 180 )if ( isOdd == eastbound ) then exit fn = fn NumberWithLong( 1 )end fn = fn NumberWithLong( 0 )local fn LegRunwayOK( logicRow as LogicRowRef ) as CFTypeRefif ( fn LogicParentDouble( logicRow, @"ToAirport", @"RunwayLength" ) >= fn LogicParentDouble( logicRow, @"FlightPlan", @"MinRunway" ) ) then exit fn = fn NumberWithLong( 1 )end fn = fn NumberWithLong( 0 )local fn LegGoesSomewhere( logicRow as LogicRowRef ) as BOOLend fn = ( fn LogicDouble( logicRow, @"FromAirportId" ) != fn LogicDouble( logicRow, @"ToAirportId" ) )local fn LegMoves( logicRow as LogicRowRef ) as BOOLend fn = ( fn LogicDouble( logicRow, @"GroundSpeed" ) > 0 )local fn LegHighEnough( logicRow as LogicRowRef ) as BOOLend fn = ( fn LogicDouble( logicRow, @"Altitude" ) >= fn LegHighestGround( logicRow ) + 1000 )local fn LegAltitudeBad( logicRow as LogicRowRef ) as BOOLend fn = ( fn LogicDouble( logicRow, @"AltitudeOK" ) == 0 )local fn LegRunwayShort( logicRow as LogicRowRef ) as BOOLend fn = ( fn LogicDouble( logicRow, @"RunwayOK" ) == 0 )// --- the plan: fuel -----------------------------------------------------------------------------------local fn PlanReserveFuel( logicRow as LogicRowRef ) as CFTypeRefdouble reserveMinutes = 30.0if ( fn LogicDouble( logicRow, @"Night" ) != 0 ) then reserveMinutes = 45.0end fn = fn NumberWithDouble( fn FlightRounded( fn LogicDouble( logicRow, @"FuelBurn" ) * reserveMinutes / 60.0, 1 ) )local fn PlanFuelRequired( logicRow as LogicRowRef ) as CFTypeRefend fn = fn NumberWithDouble( fn FlightRounded( fn LogicDouble( logicRow, @"TripFuel" ) + fn LogicDouble( logicRow, @"ReserveFuel" ), 1 ) )local fn PlanFuelMargin( logicRow as LogicRowRef ) as CFTypeRefend fn = fn NumberWithDouble( fn FlightRounded( fn LogicDouble( logicRow, @"FuelOnBoard" ) - fn LogicDouble( logicRow, @"FuelRequired" ), 1 ) )local fn PlanFuelFits( logicRow as LogicRowRef ) as BOOLend fn = ( fn LogicDouble( logicRow, @"FuelOnBoard" ) <= fn LogicDouble( logicRow, @"UsableFuel" ) )// --- go / no-go -----------------------------------------------------------------------------------------// FlightPlan.NoGoReason: the first reason the flight may not go; NULL for a GOlocal fn PlanNoGoReason( logicRow as LogicRowRef ) as CFTypeRefCFStringRef flightDay = fn FlightText( fn LogicString( logicRow, @"DepartureDate" ) )long landingDay, daysSinceif ( fn LogicDouble( logicRow, @"LegCount" ) == 0 ) then exit fn = @"The plan has no legs"if ( fn FlightBefore( fn LogicParentString( logicRow, @"Pilot", @"MedicalExpires" ), flightDay ) ) then exit fn = fn StringWithFormat( @"The pilot's medical certificate is not valid on %@", flightDay )if ( fn LogicDouble( logicRow, @"Night" ) != 0 )landingDay = fn FlightDayNumber( fn LogicParentString( logicRow, @"Pilot", @"LastNightLandings" ) )daysSince = fn FlightDayNumber( flightDay ) - landingDayif ( landingDay < 0 || daysSince < 0 || daysSince > 90 ) then exit fn = @"The pilot is not night current: three night landings in the last 90 days"end ifif ( fn FlightBefore( fn LogicParentString( logicRow, @"Aircraft", @"AnnualDue" ), flightDay ) ) then exit fn = fn StringWithFormat( @"The aircraft's annual inspection is not current on %@", flightDay )if ( fn LogicDouble( logicRow, @"BadAltitudeLegs" ) > 0 ) then exit fn = fn StringWithFormat( @"%ld leg(s) at a cruising altitude the VFR rule does not allow", fn LogicLong( logicRow, @"BadAltitudeLegs" ) )if ( fn LogicDouble( logicRow, @"ShortRunwayLegs" ) > 0 ) then exit fn = fn StringWithFormat( @"%ld leg(s) end at a runway shorter than the aircraft needs", fn LogicLong( logicRow, @"ShortRunwayLegs" ) )if ( fn LogicDouble( logicRow, @"FuelMargin" ) < 0 ) then exit fn = fn StringWithFormat( @"Not enough fuel: %g gallons needed with the reserve, %g on board", fn LogicDouble( logicRow, @"FuelRequired" ), fn LogicDouble( logicRow, @"FuelOnBoard" ) )end fn = NULLlocal fn PlanGoNoGo( logicRow as LogicRowRef ) as CFTypeRefif ( fn LogicIsEmpty( logicRow, @"NoGoReason" ) ) then exit fn = @"GO"end fn = @"NO-GO"// a plan is filed only when it is a GOlocal fn PlanFiledOnlyIfGo( logicRow as LogicRowRef ) as BOOLif ( fn StringIsEqual( fn FlightText( fn LogicString( logicRow, @"Status" ) ), @"F" ) == NO ) then exit fn = YESend fn = fn StringIsEqual( fn FlightText( fn LogicString( logicRow, @"GoNoGo" ) ), @"GO" )// --- the logbook and the track -----------------------------------------------------------------------------local fn PlanFlown( logicRow as LogicRowRef ) as BOOLend fn = fn StringIsEqual( fn FlightText( fn LogicString( logicRow, @"Status" ) ), @"C" )local fn ReportOnTheGlobe( logicRow as LogicRowRef ) as BOOLdouble lat = fn LogicDouble( logicRow, @"Latitude" ), lon = fn LogicDouble( logicRow, @"Longitude" )end fn = ( lat >= -90 && lat <= 90 && lon >= -180 && lon <= 180 )void local fn DeclareRulesCFArrayRef legPlaces = @[ @"FromAirportId", @"FromAirport.Latitude", @"FromAirport.Longitude", @"ToAirportId", @"ToAirport.Latitude", @"ToAirport.Longitude" ]// aircraft: this airframe's figures, from its typefn LogicCopy( @"Aircraft", @"CruiseKnots", @"AircraftType", @"CruiseKnots" )fn LogicCopy( @"Aircraft", @"FuelBurn", @"AircraftType", @"FuelBurn" )fn LogicCopy( @"Aircraft", @"UsableFuel", @"AircraftType", @"UsableFuel" )fn LogicCopy( @"Aircraft", @"MinRunway", @"AircraftType", @"MinRunway" )fn LogicDeleteAction( @"AircraftType", @"AircraftList", @"prevent", @"{Model}: aircraft of this type are on file" )// the plan: what it fliesfn LogicCopy( @"FlightPlan", @"CruiseKnots", @"Aircraft", @"CruiseKnots" )fn LogicCopy( @"FlightPlan", @"FuelBurn", @"Aircraft", @"FuelBurn" )fn LogicCopy( @"FlightPlan", @"UsableFuel", @"Aircraft", @"UsableFuel" )fn LogicCopy( @"FlightPlan", @"MinRunway", @"Aircraft", @"MinRunway" )// a legfn LogicFormula( @"Leg", @"Distance", @fn LegDistance, legPlaces )fn LogicFormula( @"Leg", @"TrueCourse", @fn LegTrueCourse, legPlaces )fn LogicFormula( @"Leg", @"MagneticCourse", @fn LegMagneticCourse, @[ @"TrueCourse", @"FromAirport.Variation" ] )fn LogicFormula( @"Leg", @"GroundSpeed", @fn LegGroundSpeed, @[ @"Headwind", @"FlightPlanId", @"FlightPlan.CruiseKnots" ] )fn LogicFormula( @"Leg", @"Minutes", @fn LegMinutes, @[ @"Distance", @"GroundSpeed" ] )fn LogicFormula( @"Leg", @"Fuel", @fn LegFuel, @[ @"Minutes", @"FlightPlanId", @"FlightPlan.FuelBurn" ] )fn LogicFormula( @"Leg", @"AltitudeOK", @fn LegAltitudeOK, @[ @"Altitude", @"MagneticCourse", @"FromAirport.Elevation", @"ToAirport.Elevation" ] )fn LogicFormula( @"Leg", @"RunwayOK", @fn LegRunwayOK, @[ @"ToAirportId", @"ToAirport.RunwayLength", @"FlightPlanId", @"FlightPlan.MinRunway" ] )fn LogicParentCheck( @"Leg", @"FromAirport", @"There is no airport {FromAirportId} to leave from" )fn LogicParentCheck( @"Leg", @"ToAirport", @"There is no airport {ToAirportId} to fly to" )fn LogicConstraint( @"Leg", @fn LegGoesSomewhere, @"A leg goes somewhere: it starts and ends at the same airport" )fn LogicConstraint( @"Leg", @fn LegMoves, @"A headwind of {Headwind} knots: the aircraft would not move" )fn LogicConstraint( @"Leg", @fn LegHighEnough, @"{Altitude} ft is less than 1,000 ft above the airports" )// the plan: its legs added up, and the fuelfn LogicCount( @"FlightPlan", @"LegCount", @"LegList", NULL )fn LogicSum( @"FlightPlan", @"Distance", @"LegList", @"Distance", NULL )fn LogicSum( @"FlightPlan", @"Minutes", @"LegList", @"Minutes", NULL )fn LogicSum( @"FlightPlan", @"TripFuel", @"LegList", @"Fuel", NULL )fn LogicCount( @"FlightPlan", @"BadAltitudeLegs", @"LegList", @fn LegAltitudeBad )fn LogicCount( @"FlightPlan", @"ShortRunwayLegs", @"LegList", @fn LegRunwayShort )fn LogicFormula( @"FlightPlan", @"ReserveFuel", @fn PlanReserveFuel, @[ @"FuelBurn", @"Night" ] )fn LogicFormula( @"FlightPlan", @"FuelRequired", @fn PlanFuelRequired, @[ @"TripFuel", @"ReserveFuel" ] )fn LogicFormula( @"FlightPlan", @"FuelMargin", @fn PlanFuelMargin, @[ @"FuelOnBoard", @"FuelRequired" ] )fn LogicConstraint( @"FlightPlan", @fn PlanFuelFits, @"{FuelOnBoard} gallons on board: the tanks hold {UsableFuel}" )// go / no-gofn LogicFormula( @"FlightPlan", @"NoGoReason", @fn PlanNoGoReason, @[ @"LegCount", @"DepartureDate", @"PilotId", @"Pilot.MedicalExpires", @"Night", @"Pilot.LastNightLandings", @"AircraftId", @"Aircraft.AnnualDue", @"BadAltitudeLegs", @"ShortRunwayLegs", @"FuelMargin", @"FuelRequired", @"FuelOnBoard" ] )fn LogicFormula( @"FlightPlan", @"GoNoGo", @fn PlanGoNoGo, @[ @"NoGoReason" ] )fn LogicConstraint( @"FlightPlan", @fn PlanFiledOnlyIfGo, @"Not filed - NO-GO: {NoGoReason}" )fn LogicCount( @"FlightPlan", @"ReportCount", @"PositionReportList", NULL )// refuse first (a flown flight's track), then cascade (the legs)fn LogicDeleteAction( @"FlightPlan", @"PositionReportList", @"prevent", @"The flight was flown: its track is on file" )fn LogicDeleteAction( @"FlightPlan", @"LegList", @"cascade", NULL )// the logbookfn LogicCount( @"Pilot", @"FlightCount", @"FlightPlanList", @fn PlanFlown )fn LogicSum( @"Pilot", @"FlownMinutes", @"FlightPlanList", @"Minutes", @fn PlanFlown )fn LogicSum( @"Aircraft", @"FlownMinutes", @"FlightPlanList", @"Minutes", @fn PlanFlown )fn LogicDeleteAction( @"Pilot", @"FlightPlanList", @"prevent", @"{Name} has flight plans" )fn LogicDeleteAction( @"Aircraft", @"FlightPlanList", @"prevent", @"{TailNumber} has flight plans" )// position reportsfn LogicConstraint( @"PositionReport", @fn ReportOnTheGlobe, @"There is no position {Latitude}, {Longitude}" )end fn