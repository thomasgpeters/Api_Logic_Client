/* *   Rules.incl - Northstar Mobile's business rules (LogicBank for FutureBasic) * *   The Telecom sample (samples/Telecom): copy this file over the generated app's Rules.incl *   (FBapp/Rules.incl - the starting template; regeneration never overwrites it).  The same rules *   as samples/Telecom/telecom_rules.py, which test_rules.py runs scenario by scenario. * *   The pricing engine is rules over data, no code of its own: *       Country.CostPerDay   a typical day abroad (0.5 GB, 30 minutes, 20 texts) at the rates of the *                            country's preferred roaming agreement - recomputed when they change *       Country.DayPrice     CostPerDay x the zone's markup, rounded up to the next 5 *       TravelPlanCountry    copies the day price when the leg is added (a quote keeps its price), *                            is free in the plan's home zone; Amount = Days x DayPrice *       TravelPlan.Price     the sum of its legs; purchased plans add up to the phone, the plan, the *                            account - and the account's credit limit can refuse the purchase * *   MIT License. Copyright (c) 2026 Imagery Business Systems, LLC. */#define TELECOM_DAY_GB       0.5        // a typical day abroad: what a day is priced on#define TELECOM_DAY_MINUTES  30.0#define TELECOM_DAY_TEXTS    20.0#define TELECOM_PRICE_STEP   5.0        // day prices round up to the next 5// the day number of an ISO date (yyyy-MM-dd) - the Julian day; -1 when it cannot be read.// Whole-number arithmetic: fix() truncates, as the formula expects.local fn TelecomDayNumber( isoDate as CFStringRef ) as longlong y, m, d, aif ( isoDate == NULL ) then exit fn = -1if ( fn StringLength( isoDate ) < 10 ) then exit fn = -1y = fn StringIntegerValue( fn StringSubstringWithRange( isoDate, fn CFRangeMake( 0, 4 ) ) )m = fn StringIntegerValue( fn StringSubstringWithRange( isoDate, fn CFRangeMake( 5, 2 ) ) )d = fn StringIntegerValue( fn StringSubstringWithRange( isoDate, fn CFRangeMake( 8, 2 ) ) )if ( y < 1900 || m < 1 || m > 12 || d < 1 || d > 31 ) then exit fn = -1a = fix( ( m - 14 ) / 12.0 )end fn = d - 32075 + fix( 1461 * ( y + 4800 + a ) / 4.0 ) + fix( 367 * ( m - 2 - a * 12 ) / 12.0 ) - fix( 3 * fix( ( y + 4900 + a ) / 100.0 ) / 4.0 )// inclusive days from the first date to the last (NULL when either cannot be read)local fn TelecomDays( firstDate as CFStringRef, lastDate as CFStringRef ) as CFTypeReflong first = fn TelecomDayNumber( firstDate )long last = fn TelecomDayNumber( lastDate )if ( first < 0 || last < 0 ) then exit fn = NULLend fn = fn NumberWithLong( last - first + 1 )// is date a on or after date b?  (ISO dates compare as text)local fn TelecomOnOrAfter( a as CFStringRef, b as CFStringRef ) as BOOLif ( a == NULL || b == NULL ) then exit fn = NOend fn = ( fn StringCompare( a, b ) != NSOrderedAscending )// --- the pricing world --------------------------------------------------------------------------// Country.CostPerDay: a typical day at the preferred agreement's rates; NULL without one (no service)local fn CountryCostPerDay( logicRow as LogicRowRef ) as CFTypeRefdouble costif ( fn LogicIsEmpty( logicRow, @"RoamingAgreementId" ) ) then exit fn = NULLif ( fn LogicParentValue( logicRow, @"RoamingAgreement", @"RatePerGB" ) == NULL ) then exit fn = NULLcost = TELECOM_DAY_GB * fn LogicParentDouble( logicRow, @"RoamingAgreement", @"RatePerGB" )cost = cost + TELECOM_DAY_MINUTES * fn LogicParentDouble( logicRow, @"RoamingAgreement", @"RatePerMinute" )cost = cost + TELECOM_DAY_TEXTS * fn LogicParentDouble( logicRow, @"RoamingAgreement", @"RatePerText" )end fn = fn NumberWithDouble( fix( cost * 100.0 + 0.5 ) / 100.0 )// Country.DayPrice: CostPerDay x the zone's markup, rounded up to the next 5local fn CountryDayPrice( logicRow as LogicRowRef ) as CFTypeRefdouble markup = 1.0, stepsif ( fn LogicIsEmpty( logicRow, @"CostPerDay" ) ) then exit fn = NULLif ( fn LogicParentValue( logicRow, @"Zone", @"Markup" ) != NULL ) then markup = fn LogicParentDouble( logicRow, @"Zone", @"Markup" )steps = fn LogicDouble( logicRow, @"CostPerDay" ) * markup / TELECOM_PRICE_STEPif ( steps > fix( steps ) + 0.000000001 ) then steps = fix( steps ) + 1 else steps = fix( steps )end fn = fn NumberWithDouble( steps * TELECOM_PRICE_STEP )local fn AgreementDatesInOrder( logicRow as LogicRowRef ) as BOOLend fn = fn TelecomOnOrAfter( fn LogicString( logicRow, @"ValidTo" ), fn LogicString( logicRow, @"ValidFrom" ) )local fn AgreementRatesNotNegative( logicRow as LogicRowRef ) as BOOLend fn = ( fn LogicDouble( logicRow, @"RatePerGB" ) >= 0 && fn LogicDouble( logicRow, @"RatePerMinute" ) >= 0 && fn LogicDouble( logicRow, @"RatePerText" ) >= 0 )// --- plans and phones ---------------------------------------------------------------------------local fn PlanLinesAllowed( logicRow as LogicRowRef ) as BOOLend fn = ( fn LogicDouble( logicRow, @"PhoneCount" ) <= fn LogicDouble( logicRow, @"MaxLines" ) )// Plan.DataOverGB: data over the allowance; never over an unlimited plan (no DataGB)local fn PlanDataOverGB( logicRow as LogicRowRef ) as CFTypeRefdouble overif ( fn LogicIsEmpty( logicRow, @"DataGB" ) ) then exit fn = fn NumberWithDouble( 0.0 )over = fn LogicDouble( logicRow, @"DataUsedGB" ) - fn LogicDouble( logicRow, @"DataGB" )if ( over < 0 ) then over = 0end fn = fn NumberWithDouble( fix( over * 1000.0 + 0.5 ) / 1000.0 )// --- travel plans -------------------------------------------------------------------------------local fn TravelPlanDays( logicRow as LogicRowRef ) as CFTypeRefend fn = fn TelecomDays( fn LogicString( logicRow, @"StartDate" ), fn LogicString( logicRow, @"EndDate" ) )local fn TravelPlanDatesInOrder( logicRow as LogicRowRef ) as BOOLend fn = fn TelecomOnOrAfter( fn LogicString( logicRow, @"EndDate" ), fn LogicString( logicRow, @"StartDate" ) )// a travel plan can be bought only for an active phone (a quote is fine)local fn TravelPlanPhoneActive( logicRow as LogicRowRef ) as BOOLif ( fn StringIsEqual( fn LogicString( logicRow, @"Status" ), @"P" ) == NO ) then exit fn = YESend fn = fn StringIsEqual( fn LogicParentString( logicRow, @"Phone", @"Status" ), @"A" )local fn TravelPlanIsPurchased( logicRow as LogicRowRef ) as BOOLend fn = fn StringIsEqual( fn LogicString( logicRow, @"Status" ), @"P" )local fn TravelPlanCountryDays( logicRow as LogicRowRef ) as CFTypeRefend fn = fn TelecomDays( fn LogicString( logicRow, @"ArriveDate" ), fn LogicString( logicRow, @"LeaveDate" ) )// TravelPlanCountry.Included: the country is in the plan's home zone (1) or not (0)local fn TravelPlanCountryIncluded( logicRow as LogicRowRef ) as CFTypeRefCFTypeRef countryZone = fn LogicParentValue( logicRow, @"Country", @"ZoneId" )CFTypeRef homeZone = fn LogicParentValue( logicRow, @"TravelPlan", @"ZoneId" )if ( countryZone == NULL || homeZone == NULL ) then exit fn = fn NumberWithLong( 0 )if ( fn LogicNumberOf( countryZone ) == fn LogicNumberOf( homeZone ) ) then exit fn = fn NumberWithLong( 1 )end fn = fn NumberWithLong( 0 )// TravelPlanCountry.Amount: 0 in the home zone, else Days x DayPricelocal fn TravelPlanCountryAmount( logicRow as LogicRowRef ) as CFTypeRefif ( fn LogicDouble( logicRow, @"Included" ) != 0 ) then exit fn = fn NumberWithDouble( 0.0 )end fn = fn NumberWithDouble( fn LogicDouble( logicRow, @"Days" ) * fn LogicDouble( logicRow, @"DayPrice" ) )local fn TravelPlanCountryDatesInOrder( logicRow as LogicRowRef ) as BOOLend fn = fn TelecomOnOrAfter( fn LogicString( logicRow, @"LeaveDate" ), fn LogicString( logicRow, @"ArriveDate" ) )local fn TravelPlanCountryWithinTrip( logicRow as LogicRowRef ) as BOOLif ( fn TelecomOnOrAfter( fn LogicString( logicRow, @"ArriveDate" ), fn LogicParentString( logicRow, @"TravelPlan", @"StartDate" ) ) == NO ) then exit fn = NOend fn = fn TelecomOnOrAfter( fn LogicParentString( logicRow, @"TravelPlan", @"EndDate" ), fn LogicString( logicRow, @"LeaveDate" ) )// a country abroad needs a partner network (the home zone is the carrier's own)local fn TravelPlanCountryHasService( logicRow as LogicRowRef ) as BOOLif ( fn LogicDouble( logicRow, @"Included" ) != 0 ) then exit fn = YESend fn = ( fn LogicParentValue( logicRow, @"Country", @"RoamingAgreementId" ) != NULL )// --- what the account owes ----------------------------------------------------------------------local fn AccountBalance( logicRow as LogicRowRef ) as CFTypeRefend fn = fn NumberWithDouble( fn LogicDouble( logicRow, @"MonthlyCharges" ) + fn LogicDouble( logicRow, @"TravelCharges" ) )local fn AccountWithinCredit( logicRow as LogicRowRef ) as BOOLend fn = ( fn LogicDouble( logicRow, @"Balance" ) <= fn LogicDouble( logicRow, @"CreditLimit" ) )void local fn DeclareRules// the pricing worldfn LogicFormula( @"Country", @"CostPerDay", @fn CountryCostPerDay, @[ @"RoamingAgreementId", @"RoamingAgreement.RatePerGB", @"RoamingAgreement.RatePerMinute", @"RoamingAgreement.RatePerText" ] )fn LogicFormula( @"Country", @"DayPrice", @fn CountryDayPrice, @[ @"CostPerDay", @"Zone.Markup" ] )fn LogicConstraint( @"RoamingAgreement", @fn AgreementDatesInOrder, @"The agreement ends ({ValidTo}) before it starts ({ValidFrom})" )fn LogicConstraint( @"RoamingAgreement", @fn AgreementRatesNotNegative, @"Rates cannot be negative" )// plans and phonesfn LogicCopy( @"Plan", @"MonthlyPrice", @"PlanOffer", @"MonthlyPrice" )fn LogicCopy( @"Plan", @"MaxLines", @"PlanOffer", @"MaxLines" )fn LogicCopy( @"Plan", @"DataGB", @"PlanOffer", @"DataGB" )fn LogicCopy( @"Plan", @"ZoneId", @"PlanOffer", @"ZoneId" )fn LogicCount( @"Plan", @"PhoneCount", @"PhoneList", NULL )fn LogicConstraint( @"Plan", @fn PlanLinesAllowed, @"The plan allows {MaxLines} phone(s); it would have {PhoneCount}" )fn LogicCopy( @"Phone", @"ZoneId", @"Plan", @"ZoneId" )fn LogicSum( @"Phone", @"DataUsedGB", @"UsageList", @"DataGB", NULL )fn LogicSum( @"Plan", @"DataUsedGB", @"PhoneList", @"DataUsedGB", NULL )fn LogicFormula( @"Plan", @"DataOverGB", @fn PlanDataOverGB, @[ @"DataUsedGB", @"DataGB" ] )// travel plansfn LogicCopy( @"TravelPlan", @"ZoneId", @"Phone", @"ZoneId" )fn LogicFormula( @"TravelPlan", @"Days", @fn TravelPlanDays, @[ @"StartDate", @"EndDate" ] )fn LogicConstraint( @"TravelPlan", @fn TravelPlanDatesInOrder, @"The trip ends ({EndDate}) before it starts ({StartDate})" )fn LogicConstraint( @"TravelPlan", @fn TravelPlanPhoneActive, @"Phone {PhoneId} is not active: the travel plan cannot be bought" )fn LogicCount( @"TravelPlan", @"CountryCount", @"TravelPlanCountryList", NULL )fn LogicSum( @"TravelPlan", @"Price", @"TravelPlanCountryList", @"Amount", NULL )fn LogicFormula( @"TravelPlanCountry", @"Days", @fn TravelPlanCountryDays, @[ @"ArriveDate", @"LeaveDate" ] )fn LogicCopy( @"TravelPlanCountry", @"DayPrice", @"Country", @"DayPrice" )fn LogicFormula( @"TravelPlanCountry", @"Included", @fn TravelPlanCountryIncluded, @[ @"CountryCode", @"Country.ZoneId", @"TravelPlan.ZoneId" ] )fn LogicFormula( @"TravelPlanCountry", @"Amount", @fn TravelPlanCountryAmount, @[ @"Included", @"Days", @"DayPrice" ] )fn LogicConstraint( @"TravelPlanCountry", @fn TravelPlanCountryDatesInOrder, @"Leaving {CountryCode} ({LeaveDate}) before arriving ({ArriveDate})" )fn LogicConstraint( @"TravelPlanCountry", @fn TravelPlanCountryWithinTrip, @"{CountryCode} ({ArriveDate} to {LeaveDate}) is outside the trip's dates" )fn LogicConstraint( @"TravelPlanCountry", @fn TravelPlanCountryHasService, @"No partner network in {CountryCode}: there is no service there" )fn LogicParentCheck( @"TravelPlanCountry", @"Country", @"There is no country {CountryCode}" )fn LogicDeleteAction( @"TravelPlan", @"TravelPlanCountryList", @"cascade", NULL )// what the account owesfn LogicSum( @"Phone", @"TravelTotal", @"TravelPlanList", @"Price", @fn TravelPlanIsPurchased )fn LogicSum( @"Plan", @"TravelTotal", @"PhoneList", @"TravelTotal", NULL )fn LogicSum( @"Account", @"MonthlyCharges", @"PlanList", @"MonthlyPrice", NULL )fn LogicSum( @"Account", @"TravelCharges", @"PlanList", @"TravelTotal", NULL )fn LogicFormula( @"Account", @"Balance", @fn AccountBalance, @[ @"MonthlyCharges", @"TravelCharges" ] )fn LogicConstraint( @"Account", @fn AccountWithinCredit, @"Account {AccountNumber}: the balance {Balance} would exceed the credit limit {CreditLimit}" )fn LogicDeleteAction( @"Account", @"PlanList", @"prevent", @"Account {AccountNumber} still has plans" )fn LogicDeleteAction( @"Plan", @"PhoneList", @"prevent", @"The plan still has phones" )fn LogicDeleteAction( @"Phone", @"TravelPlanList", @"cascade", NULL )fn LogicDeleteAction( @"Phone", @"UsageList", @"cascade", NULL )end fn