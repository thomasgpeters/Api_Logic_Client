void local fn SayHellotextlabel _textLabel, fn StringWithFormat(@"Hello, %@",fn NSUserName)end fn// application events arrive herevoid local fn DoAppEvent( ev as long )select ( ev )case _appWillFinishLaunching// app is about to finish launching - build menu and windowfn BuildMenufn BuildWindowcase _appShouldTerminateAfterLastWindowClosedAppEventSetBool( YES )// tell the runtime we can quitend selectend fn// menu events arrive herevoid local fn DoMenu( menuID as long, itemID as long )select ( menuID )case _mHelloselect ( itemID )case _iSayHello : fn SayHelloend selectend selectend fn// window and control events arrive herevoid local fn DoDialog( ev as long, tag as long )select ( ev )case _btnClickselect ( tag )case _pushBtn : fn SayHelloend selectend selectend fnon appevent fn DoAppEvent// assign application event handler functionon menu fn DoMenu// assign menu event handler functionon dialog fn DoDialog// assign window/control event handler function