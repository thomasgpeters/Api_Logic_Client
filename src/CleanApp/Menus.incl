// menus_mApplication = 0begin enum 1_iSeparator// required for Application menu_iPreferencesend enum_mFile = 1begin enum 1_iCloseend enum_mHelp = 2void local fn BuildMenu// preferencesmenu _mApplication, _iSeparator// required for Application menumenu _mApplication, _iPreferences,, @"Preferences…", @","// filemenu _mFile,,, @"File"menu _mFile, _iClose,, @"Close", @"w"MenuItemSetAction( _mFile, _iClose, @"performClose:" )// helphelpmenu _mHelpend fn