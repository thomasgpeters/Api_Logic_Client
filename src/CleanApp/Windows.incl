// window/control constants_window = 1begin enum 1_textLabel_pushBtnend enumvoid local fn BuildWindow// build the windowwindow _window, @"Hello World", (0,0,480,270)// add a textlabel to the windowtextlabel _textLabel,, (18,126,444,17)ControlSetAlignment( _textLabel, NSTextAlignmentCenter )// add a button to the windowbutton _pushBtn,,, @"Say Hello", (192,13,97,32)end fn