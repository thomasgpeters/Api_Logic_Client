/* *   Web Widgets.incl - Web Toolkit for FutureBasic: the widgets * *   A widget is a dictionary - its id, kind, properties, children and events - in its session. The app builds a tree of *   them (WebBuildPage) and changes their properties in its event functions; the browser is sent only the changes. *   Every widget is placed in a parent: "page", or a container's id. * *   Containers:   WebContainer( session, parentId, widgetId, layout )   layout: row, column, card, form, section, toolbar *   Text:         WebHeading, WebText, WebLabel, WebLink, WebImage, WebDivider, WebMessage *   Input:        WebButton, WebField (type: text, email, password, number, date, time, datetime-local, color, range, *                 search, tel, url), WebTextArea, WebCheckbox, WebRadioGroup, WebSelect *   Data:         WebTable (columns, rows, a selected row), WebList * *   Properties:   WebSetText, WebSetValue, WebSetChecked, WebSetEnabled, WebSetVisible, WebSetOptions, WebSetRows, *                 WebSetProperty; read: WebValue, WebChecked, WebProperty, WebSelectedRow *   A widget has no colour: it has a role (primary, secondary, danger, success, warning, info, light, dark), and the *   theme (web.css: base, light, dark, colourful) decides how a role looks. * *   MIT License. Copyright (c) 2026 Imagery Business Systems, LLC. See LICENSE. */// a record of what changed since the page was sent: { op, id, ... } (Web Render.incl turns them into the answer)void local fn WebQueue( session as WebSessionRef, update as CFDictionaryRef )if ( fn NumberBoolValue( fn DictionaryObjectForKey( session, @"rendered" ) ) == NO ) then exit fnMutableArrayAddObject( (CFMutableArrayRef)fn DictionaryObjectForKey( session, @"updates" ), update )end fnlocal fn WebWidget( session as WebSessionRef, widgetId as CFStringRef ) as CFMutableDictionaryRefend fn = (CFMutableDictionaryRef)fn DictionaryObjectForKey( fn DictionaryObjectForKey( session, @"widgets" ), widgetId )local fn WebProps( session as WebSessionRef, widgetId as CFStringRef ) as CFMutableDictionaryRefCFMutableDictionaryRef widget = fn WebWidget( session, widgetId )if ( widget == NULL ) then exit fn = NULLend fn = (CFMutableDictionaryRef)fn DictionaryObjectForKey( widget, @"props" )local fn WebProperty( session as WebSessionRef, widgetId as CFStringRef, propName as CFStringRef ) as CFTypeRefCFDictionaryRef props = fn WebProps( session, widgetId )if ( props == NULL ) then exit fn = NULLend fn = fn DictionaryObjectForKey( props, propName )// any value as the text a page shows: "" for none or null, numbers without trailing zeroslocal fn WebValueText( aValue as CFTypeRef ) as CFStringRefcln id v = (__bridge id)aValue; if ( v == nil || v == [NSNull null] ) return (__bridge CFStringRef)@""; if ( [v isKindOfClass:[NSString class]] ) return (__bridge CFStringRef)v; if ( [v isKindOfClass:[NSNumber class]] ) { double d = [v doubleValue]; if ( d == (double)(long long)d && fabs( d ) < 1e15 ) return (__bridge CFStringRef)[NSString stringWithFormat:@"%lld", (long long)d]; return (__bridge CFStringRef)[NSString stringWithFormat:@"%.10g", d]; } return (__bridge CFStringRef)[v description];end fn = @""// a new widget, placed at the end of its parent; NULL when the id is taken or the parent is unknownlocal fn WebAdd( session as WebSessionRef, parentId as CFStringRef, widgetId as CFStringRef, kind as CFStringRef ) as CFMutableDictionaryRefCFMutableDictionaryRef widgets = (CFMutableDictionaryRef)fn DictionaryObjectForKey( session, @"widgets" )CFMutableDictionaryRef widget, parentWidget = (CFMutableDictionaryRef)fn DictionaryObjectForKey( widgets, parentId )if ( parentWidget == NULL )if ( isLoggingOn ) then NSLog( @"Web Toolkit: no widget %@ to put %@ in", parentId, widgetId )exit fn = NULLend ifif ( fn DictionaryObjectForKey( widgets, widgetId ) )if ( isLoggingOn ) then NSLog( @"Web Toolkit: the widget id %@ is taken", widgetId )exit fn = NULLend ifwidget = fn MutableDictionaryNewMutableDictionarySetObjectForKey( widget, widgetId, @"id" )MutableDictionarySetObjectForKey( widget, kind, @"kind" )MutableDictionarySetObjectForKey( widget, parentId, @"parent" )MutableDictionarySetObjectForKey( widget, fn MutableDictionaryNew, @"props" )MutableDictionarySetObjectForKey( widget, fn MutableArrayNew, @"children" )MutableDictionarySetObjectForKey( widget, fn MutableDictionaryNew, @"events" )MutableDictionarySetObjectForKey( widgets, widget, widgetId )MutableArrayAddObject( (CFMutableArrayRef)fn DictionaryObjectForKey( parentWidget, @"children" ), widgetId )// added after the page was sent: the browser appends it (Web Render.incl writes its HTML when the answer is built)fn WebQueue( session, @{ @"op" : @"append", @"id" : widgetId, @"parent" : parentId } )end fn = widgetvoid local fn WebSetProp( widget as CFMutableDictionaryRef, propName as CFStringRef, aValue as CFTypeRef )if ( widget == NULL ) then exit fnif ( aValue == NULL ) then aValue = @""MutableDictionarySetObjectForKey( (CFMutableDictionaryRef)fn DictionaryObjectForKey( widget, @"props" ), aValue, propName )end fn// --- containers and text ---local fn WebContainer( session as WebSessionRef, parentId as CFStringRef, widgetId as CFStringRef, layout as CFStringRef ) as CFStringRefCFMutableDictionaryRef widget = fn WebAdd( session, parentId, widgetId, @"container" )fn WebSetProp( widget, @"layout", layout )end fn = widgetIdlocal fn WebHeading( session as WebSessionRef, parentId as CFStringRef, widgetId as CFStringRef, titleText as CFStringRef, level as long ) as CFStringRefCFMutableDictionaryRef widget = fn WebAdd( session, parentId, widgetId, @"heading" )if ( level < 1 || level > 6 ) then level = 2fn WebSetProp( widget, @"text", titleText )fn WebSetProp( widget, @"level", fn NumberWithLong( level ) )end fn = widgetId// look: "" (plain), muted, lead, small, mono, or a role (danger ...)local fn WebText( session as WebSessionRef, parentId as CFStringRef, widgetId as CFStringRef, content as CFStringRef, look as CFStringRef ) as CFStringRefCFMutableDictionaryRef widget = fn WebAdd( session, parentId, widgetId, @"text" )fn WebSetProp( widget, @"text", content )fn WebSetProp( widget, @"look", look )end fn = widgetId// a label for another widget (forId): clicking it focuses that widgetlocal fn WebLabel( session as WebSessionRef, parentId as CFStringRef, widgetId as CFStringRef, content as CFStringRef, forId as CFStringRef ) as CFStringRefCFMutableDictionaryRef widget = fn WebAdd( session, parentId, widgetId, @"label" )fn WebSetProp( widget, @"text", content )fn WebSetProp( widget, @"for", forId )end fn = widgetId// a link to an address; "" makes it an action link that sends "clicked" (WebOn)local fn WebLink( session as WebSessionRef, parentId as CFStringRef, widgetId as CFStringRef, content as CFStringRef, address as CFStringRef ) as CFStringRefCFMutableDictionaryRef widget = fn WebAdd( session, parentId, widgetId, @"link" )fn WebSetProp( widget, @"text", content )fn WebSetProp( widget, @"href", address )end fn = widgetIdlocal fn WebImage( session as WebSessionRef, parentId as CFStringRef, widgetId as CFStringRef, address as CFStringRef, description as CFStringRef ) as CFStringRefCFMutableDictionaryRef widget = fn WebAdd( session, parentId, widgetId, @"image" )fn WebSetProp( widget, @"src", address )fn WebSetProp( widget, @"alt", description )end fn = widgetIdlocal fn WebDivider( session as WebSessionRef, parentId as CFStringRef, widgetId as CFStringRef ) as CFStringReffn WebAdd( session, parentId, widgetId, @"divider" )end fn = widgetId// a message band (role: info, success, warning, danger); empty text hides itlocal fn WebMessage( session as WebSessionRef, parentId as CFStringRef, widgetId as CFStringRef, content as CFStringRef, role as CFStringRef ) as CFStringRefCFMutableDictionaryRef widget = fn WebAdd( session, parentId, widgetId, @"message" )fn WebSetProp( widget, @"text", content )fn WebSetProp( widget, @"role", role )end fn = widgetId// --- input ---// role: primary, secondary, danger, success, warning, info, light, dark, linklocal fn WebButton( session as WebSessionRef, parentId as CFStringRef, widgetId as CFStringRef, titleText as CFStringRef, role as CFStringRef ) as CFStringRefCFMutableDictionaryRef widget = fn WebAdd( session, parentId, widgetId, @"button" )fn WebSetProp( widget, @"text", titleText )fn WebSetProp( widget, @"role", role )end fn = widgetId// a one-line field with its label above it; inputType: text, email, password, number, date, time, datetime-local,// color, range, search, tel, urllocal fn WebField( session as WebSessionRef, parentId as CFStringRef, widgetId as CFStringRef, labelText as CFStringRef, inputType as CFStringRef, hint as CFStringRef ) as CFStringRefCFMutableDictionaryRef widget = fn WebAdd( session, parentId, widgetId, @"field" )fn WebSetProp( widget, @"label", labelText )fn WebSetProp( widget, @"type", inputType )fn WebSetProp( widget, @"placeholder", hint )fn WebSetProp( widget, @"value", @"" )end fn = widgetIdlocal fn WebTextArea( session as WebSessionRef, parentId as CFStringRef, widgetId as CFStringRef, labelText as CFStringRef, lineCount as long ) as CFStringRefCFMutableDictionaryRef widget = fn WebAdd( session, parentId, widgetId, @"textarea" )if ( lineCount < 2 ) then lineCount = 3fn WebSetProp( widget, @"label", labelText )fn WebSetProp( widget, @"lines", fn NumberWithLong( lineCount ) )fn WebSetProp( widget, @"value", @"" )end fn = widgetIdlocal fn WebCheckbox( session as WebSessionRef, parentId as CFStringRef, widgetId as CFStringRef, labelText as CFStringRef, isOn as BOOL ) as CFStringRefCFMutableDictionaryRef widget = fn WebAdd( session, parentId, widgetId, @"checkbox" )fn WebSetProp( widget, @"label", labelText )fn WebSetProp( widget, @"checked", fn NumberWithBool( isOn ) )end fn = widgetId// choices: an array of { code, title } - or of plain strings, each its own code; WebValue gives the chosen codelocal fn WebRadioGroup( session as WebSessionRef, parentId as CFStringRef, widgetId as CFStringRef, labelText as CFStringRef, choices as CFArrayRef ) as CFStringRefCFMutableDictionaryRef widget = fn WebAdd( session, parentId, widgetId, @"radio" )fn WebSetProp( widget, @"label", labelText )fn WebSetProp( widget, @"options", choices )fn WebSetProp( widget, @"value", @"" )end fn = widgetId// a drop-down: choices as for WebRadioGroup; a first choice with an empty code reads as "none chosen"local fn WebSelect( session as WebSessionRef, parentId as CFStringRef, widgetId as CFStringRef, labelText as CFStringRef, choices as CFArrayRef ) as CFStringRefCFMutableDictionaryRef widget = fn WebAdd( session, parentId, widgetId, @"select" )fn WebSetProp( widget, @"label", labelText )fn WebSetProp( widget, @"options", choices )fn WebSetProp( widget, @"value", @"" )end fn = widgetId// --- data ---// columns: an array of { key, title } (plain strings: each its own key and title); rows: an array of dictionaries// (records). Clicking a row selects it and sends "selected" with the row's number (0 first).local fn WebTable( session as WebSessionRef, parentId as CFStringRef, widgetId as CFStringRef, columnList as CFArrayRef ) as CFStringRefCFMutableDictionaryRef widget = fn WebAdd( session, parentId, widgetId, @"table" )fn WebSetProp( widget, @"columns", columnList )fn WebSetProp( widget, @"rows", @[] )fn WebSetProp( widget, @"selected", fn NumberWithLong( -1 ) )end fn = widgetId// a list of lines (strings); clicking one sends "selected" with its number when the app listenslocal fn WebList( session as WebSessionRef, parentId as CFStringRef, widgetId as CFStringRef, lines as CFArrayRef ) as CFStringRefCFMutableDictionaryRef widget = fn WebAdd( session, parentId, widgetId, @"list" )fn WebSetProp( widget, @"items", lines )fn WebSetProp( widget, @"selected", fn NumberWithLong( -1 ) )end fn = widgetId// --- changing properties (each one sent to the browser with the next answer) ---// a property the browser can show without redrawing the widget (text, value, checked, enabled, visible)void local fn WebChange( session as WebSessionRef, widgetId as CFStringRef, propName as CFStringRef, aValue as CFTypeRef )CFMutableDictionaryRef widget = fn WebWidget( session, widgetId )if ( widget == NULL ) then exit fnif ( aValue == NULL ) then aValue = @""fn WebSetProp( widget, propName, aValue )fn WebQueue( session, @{ @"op" : propName, @"id" : widgetId, @"value" : aValue } )end fn// any other property: the widget is drawn againvoid local fn WebSetProperty( session as WebSessionRef, widgetId as CFStringRef, propName as CFStringRef, aValue as CFTypeRef )CFMutableDictionaryRef widget = fn WebWidget( session, widgetId )if ( widget == NULL ) then exit fnfn WebSetProp( widget, propName, aValue )fn WebQueue( session, @{ @"op" : @"redraw", @"id" : widgetId } )end fnvoid local fn WebSetText( session as WebSessionRef, widgetId as CFStringRef, content as CFStringRef )if ( content == NULL ) then content = @""fn WebChange( session, widgetId, @"text", content )end fn// a field's, text area's, drop-down's or radio group's value (any value: numbers are shown without trailing zeros)void local fn WebSetValue( session as WebSessionRef, widgetId as CFStringRef, aValue as CFTypeRef )fn WebChange( session, widgetId, @"value", fn WebValueText( aValue ) )end fnvoid local fn WebSetChecked( session as WebSessionRef, widgetId as CFStringRef, isOn as BOOL )fn WebChange( session, widgetId, @"checked", fn NumberWithBool( isOn ) )end fnvoid local fn WebSetEnabled( session as WebSessionRef, widgetId as CFStringRef, isOn as BOOL )fn WebChange( session, widgetId, @"enabled", fn NumberWithBool( isOn ) )end fnvoid local fn WebSetVisible( session as WebSessionRef, widgetId as CFStringRef, isOn as BOOL )fn WebChange( session, widgetId, @"visible", fn NumberWithBool( isOn ) )end fn// a message band's text and role togethervoid local fn WebSetMessage( session as WebSessionRef, widgetId as CFStringRef, content as CFStringRef, role as CFStringRef )CFMutableDictionaryRef widget = fn WebWidget( session, widgetId )fn WebSetProp( widget, @"role", role )fn WebSetProperty( session, widgetId, @"text", content )end fnvoid local fn WebSetOptions( session as WebSessionRef, widgetId as CFStringRef, choices as CFArrayRef )fn WebSetProperty( session, widgetId, @"options", choices )end fn// a table's rows (records), or a list's lines; the selection is clearedvoid local fn WebSetRows( session as WebSessionRef, widgetId as CFStringRef, rowList as CFArrayRef )CFMutableDictionaryRef widget = fn WebWidget( session, widgetId )if ( widget == NULL ) then exit fnif ( rowList == NULL ) then rowList = @[]fn WebSetProp( widget, @"selected", fn NumberWithLong( -1 ) )if ( fn StringIsEqual( fn DictionaryObjectForKey( widget, @"kind" ), @"list" ) ) then fn WebSetProperty( session, widgetId, @"items", rowList ) else fn WebSetProperty( session, widgetId, @"rows", rowList )end fn// a table's or list's selected row (-1: none); changing it from FB redraws the widgetvoid local fn WebSetSelectedRow( session as WebSessionRef, widgetId as CFStringRef, rowNumber as long )fn WebSetProperty( session, widgetId, @"selected", fn NumberWithLong( rowNumber ) )end fn// --- reading what the user did (the browser sends every field's value with each event) ---local fn WebValue( session as WebSessionRef, widgetId as CFStringRef ) as CFStringRefend fn = fn WebValueText( fn WebProperty( session, widgetId, @"value" ) )local fn WebDoubleValue( session as WebSessionRef, widgetId as CFStringRef ) as doubleend fn = fn StringDoubleValue( fn WebValue( session, widgetId ) )local fn WebChecked( session as WebSessionRef, widgetId as CFStringRef ) as BOOLCFTypeRef isOn = fn WebProperty( session, widgetId, @"checked" )if ( isOn == NULL ) then exit fn = NOend fn = fn NumberBoolValue( isOn )local fn WebSelectedRow( session as WebSessionRef, widgetId as CFStringRef ) as longCFTypeRef rowNumber = fn WebProperty( session, widgetId, @"selected" )if ( rowNumber == NULL ) then exit fn = -1end fn = fn NumberLongValue( rowNumber )// the selected row's record (a table), or NULLlocal fn WebSelectedRecord( session as WebSessionRef, widgetId as CFStringRef ) as CFDictionaryRefCFArrayRef rowList = fn WebProperty( session, widgetId, @"rows" )long       rowNumber = fn WebSelectedRow( session, widgetId )if ( rowList == NULL || rowNumber < 0 || rowNumber >= fn ArrayCount( rowList ) ) then exit fn = NULLend fn = fn ArrayObjectAtIndex( rowList, rowNumber )// --- removing, focus, navigation, theme ---void local fn WebRemoveFrom( session as WebSessionRef, widgetId as CFStringRef )CFMutableDictionaryRef widgets = (CFMutableDictionaryRef)fn DictionaryObjectForKey( session, @"widgets" )CFMutableDictionaryRef widget = (CFMutableDictionaryRef)fn DictionaryObjectForKey( widgets, widgetId )CFArrayRef  childIdsCFStringRef childIdif ( widget == NULL ) then exit fnchildIds = fn ArrayWithArray( fn DictionaryObjectForKey( widget, @"children" ) )for childId in childIdsfn WebRemoveFrom( session, childId )nextMutableDictionaryRemoveObjectForKey( widgets, widgetId )end fn// a widget and everything in itvoid local fn WebRemove( session as WebSessionRef, widgetId as CFStringRef )CFMutableDictionaryRef widget = fn WebWidget( session, widgetId )CFMutableDictionaryRef parentWidgetif ( widget == NULL || fn StringIsEqual( widgetId, @"page" ) ) then exit fnparentWidget = fn WebWidget( session, fn DictionaryObjectForKey( widget, @"parent" ) )if ( parentWidget ) then MutableArrayRemoveObject( (CFMutableArrayRef)fn DictionaryObjectForKey( parentWidget, @"children" ), widgetId )fn WebRemoveFrom( session, widgetId )fn WebQueue( session, @{ @"op" : @"remove", @"id" : widgetId } )end fn// everything inside a container (the container stays)void local fn WebClear( session as WebSessionRef, widgetId as CFStringRef )CFMutableDictionaryRef widget = fn WebWidget( session, widgetId )CFArrayRef  childIdsCFStringRef childIdif ( widget == NULL ) then exit fnchildIds = fn ArrayWithArray( fn DictionaryObjectForKey( widget, @"children" ) )for childId in childIdsfn WebRemove( session, childId )nextend fnvoid local fn WebFocus( session as WebSessionRef, widgetId as CFStringRef )fn WebQueue( session, @{ @"op" : @"focus", @"id" : widgetId } )end fn// the browser goes to another address (another page, a download)void local fn WebNavigate( session as WebSessionRef, address as CFStringRef )fn WebQueue( session, @{ @"op" : @"navigate", @"id" : @"page", @"value" : address } )end fn// the page's theme: light, dark, colourful, base, or "" (the visitor's system setting)void local fn WebSetTheme( session as WebSessionRef, themeName as CFStringRef )if ( themeName == NULL ) then themeName = @""MutableDictionarySetObjectForKey( session, themeName, @"theme" )fn WebQueue( session, @{ @"op" : @"theme", @"id" : @"page", @"value" : themeName } )end fn// --- events ---// the app's function for a widget's event; handler: void local fn H( session as WebSessionRef, widgetId as CFStringRef,// eventValue as CFStringRef ). Events: clicked, changed, typed (as the user types, a moment after), entered (Return in// a field), selected (a table or list row: its number), submitted (a form). The page's lifecycle: WebOn( session,// @"page", @"shown" ...) - see Web Events.incl. A form bound to an entity also fires saved and deleted (Web Binding.incl).void local fn WebOn( session as WebSessionRef, widgetId as CFStringRef, eventName as CFStringRef, handler as ptr )CFMutableDictionaryRef widget = fn WebWidget( session, widgetId )if ( widget == NULL ) then exit fnMutableDictionarySetObjectForKey( (CFMutableDictionaryRef)fn DictionaryObjectForKey( widget, @"events" ), fn WebPointerNumber( handler ), eventName )// the browser learns which events to send from the widget's HTMLif ( fn StringIsEqual( widgetId, @"page" ) == NO ) then fn WebQueue( session, @{ @"op" : @"redraw", @"id" : widgetId } )end fnlocal fn WebListens( session as WebSessionRef, widgetId as CFStringRef, eventName as CFStringRef ) as BOOLCFDictionaryRef widget = fn WebWidget( session, widgetId )if ( widget == NULL ) then exit fn = NOend fn = ( fn DictionaryObjectForKey( fn DictionaryObjectForKey( widget, @"events" ), eventName ) != NULL )// calls the app's function for the event, if it listens; YES when one was calledlocal fn WebFire( session as WebSessionRef, widgetId as CFStringRef, eventName as CFStringRef, eventValue as CFStringRef ) as BOOLCFDictionaryRef widget = fn WebWidget( session, widgetId )CFTypeRef       handlerif ( widget == NULL ) then exit fn = NOhandler = fn DictionaryObjectForKey( fn DictionaryObjectForKey( widget, @"events" ), eventName )if ( handler == NULL ) then exit fn = NOif ( eventValue == NULL ) then eventValue = @""fn WebCallHandler( handler, session, widgetId, eventValue )end fn = YES