/* *   Pages.incl - the app's page: its widgets, and what its events do (Web Toolkit for FutureBasic: the app template) * *   This is the file you write. BuildPage makes a new visitor's page, once per session; the functions below answer *   its events. Change properties (WebSetText, WebSetValue ...), add or remove widgets: the toolkit sends only the *   changes to the browser, which applies them without reloading the page. * *   An event function:   void local fn Name( session as WebSessionRef, widgetId as CFStringRef, eventValue as CFStringRef ) *   connected with:      fn WebOn( session, @"widgetId", @"clicked", @fn Name ) *   events:              clicked, changed, typed, entered, selected, submitted; on "page": shown, hidden, visible, *                        leaving (the lifecycle); WebOnSessionEnd for a session that ends * *   MIT License. Copyright (c) 2026 Imagery Business Systems, LLC. See LICENSE. */// --- the app ---local fn AppTitle as CFStringRefend fn = @"My Web App"// before the first page is served: open the database, declare the rules ... (NO stops the app serving)local fn AppStarting as BOOLend fn = YES// the app's own menus, built at launch (FB adds the application menu's About, Hide and Quit)void local fn AppMenusBuildend fn// a menu item chosenvoid local fn AppMenu( menuID as long, itemID as long )end fn// the app's own windows: YES when the event was theirs (the server window gets the rest)local fn AppDialog( ev as long, tag as long, wnd as long ) as BOOLend fn = NO// --- the events ---void local fn GreetClicked( session as WebSessionRef, widgetId as CFStringRef, eventValue as CFStringRef )CFStringRef visitor = fn StringByTrimmingCharactersInSet( fn WebValue( session, @"visitorName" ), fn CharacterSetWhitespaceSet )if ( fn StringLength( visitor ) == 0 )fn WebSetMessage( session, @"greeting", @"Type your name first.", @"warning" )fn WebFocus( session, @"visitorName" )exit fnend iffn WebSetMessage( session, @"greeting", fn StringWithFormat( @"Hello, %@ - from FutureBasic.", visitor ), @"success" )end fnvoid local fn ThemeChanged( session as WebSessionRef, widgetId as CFStringRef, eventValue as CFStringRef )fn WebSetTheme( session, eventValue )end fn// --- the page's lifecycle ---// the page was sent to the browser: "first" (a new visitor) or "again" (a reload); show fresh data herevoid local fn PageShown( session as WebSessionRef, widgetId as CFStringRef, eventValue as CFStringRef )end fn// the visitor switched to another tab or window ("hidden"), came back ("visible"), or closed the page ("leaving");// work in progress can be kept here (auto-saving forms are saved by the toolkit: Web Binding.incl)void local fn PageHidden( session as WebSessionRef, widgetId as CFStringRef, eventValue as CFStringRef )end fnvoid local fn PageVisible( session as WebSessionRef, widgetId as CFStringRef, eventValue as CFStringRef )end fnvoid local fn PageLeaving( session as WebSessionRef, widgetId as CFStringRef, eventValue as CFStringRef )end fn// the session was idle too long and ends: the last chance to keep its workvoid local fn SessionEnded( session as WebSessionRef )end fn// --- the page ---void local fn BuildPage( session as WebSessionRef )fn WebHeading( session, @"page", @"title", @"My Web App", 1 )fn WebText( session, @"page", @"intro", @"Written in FutureBasic, served by nginx, answered by this program.", @"lead" )fn WebContainer( session, @"page", @"card", @"card" )fn WebField( session, @"card", @"visitorName", @"Your name", @"text", @"Jane Outerbridge" )fn WebButton( session, @"card", @"greet", @"Greet", @"primary" )fn WebMessage( session, @"card", @"greeting", @"", @"info" )fn WebOn( session, @"greet", @"clicked", @fn GreetClicked )fn WebOn( session, @"visitorName", @"entered", @fn GreetClicked )fn WebSelect( session, @"page", @"theme", @"Theme", @[ @{ @"code" : @"", @"title" : @"As the system" }, @{ @"code" : @"light", @"title" : @"Light" }, @{ @"code" : @"dark", @"title" : @"Dark" }, @{ @"code" : @"colourful", @"title" : @"Colourful" }, @{ @"code" : @"base", @"title" : @"Base" } ] )fn WebOn( session, @"theme", @"changed", @fn ThemeChanged )fn WebOn( session, @"page", @"shown", @fn PageShown )fn WebOn( session, @"page", @"hidden", @fn PageHidden )fn WebOn( session, @"page", @"visible", @fn PageVisible )fn WebOn( session, @"page", @"leaving", @fn PageLeaving )end fn