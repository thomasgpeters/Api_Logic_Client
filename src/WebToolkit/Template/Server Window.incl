/* *   Server Window.incl - the web app's own window: is it serving, how many visitors (Web Toolkit for FutureBasic: *   the app template). Identical in every app made from the template: the app itself is in Pages.incl. The app serves the pages whether the window is open or not; it runs until it is quit. * *   MIT License. Copyright (c) 2026 Imagery Business Systems, LLC. See LICENSE. */void local fn ServerWindowRefreshlong sessionCount = 0if ( gWebSessions ) then sessionCount = fn DictionaryCount( gWebSessions )ControlSetStringValue( _sessionsLabel, fn StringWithFormat( @"%ld requests answered, %ld sessions open", gWebRequestCount, sessionCount ) )end fnvoid local fn ServerWindowBuildwindow _serverWindow, fn AppTitle, ( 0, 0, 520, 150 ), NSWindowStyleMaskTitled + NSWindowStyleMaskClosable + NSWindowStyleMaskMiniaturizabletextlabel _statusLabel, @"Starting…", ( 20, 108, 480, 20 ), _serverWindowtextlabel _sessionsLabel, @"", ( 20, 82, 480, 20 ), _serverWindowbutton _openButton, YES, , @"Open in Browser", ( 20, 24, 160, 32 ), NSButtonTypeMomentaryPushIn, NSBezelStyleRounded, _serverWindowbutton _loggingCheck, YES, NSControlStateValueOff, @"Log to NSLog", ( 200, 30, 160, 20 ), NSButtonTypeSwitch, , _serverWindowend fnvoid local fn ServerStartlong problemif ( fn AppStarting == NO )ControlSetStringValue( _statusLabel, @"The app could not start - turn on Log to NSLog, and see the NSLog window." )exit fnend iffn WebOnSessionEnd( @fn SessionEnded )problem = fn WebStart( _fastCGIPort, @fn BuildPage, fn AppTitle )if ( problem != 0 )ControlSetStringValue( _statusLabel, fn StringWithFormat( @"Could not listen on 127.0.0.1:%d (error %ld - is the port in use?)", _fastCGIPort, problem ) )exit fnend ifControlSetStringValue( _statusLabel, fn StringWithFormat( @"Serving nginx on 127.0.0.1:%d - the site: http://127.0.0.1:%d/", _fastCGIPort, _sitePort ) )// the counts, every few secondstimerbegin 2.0, 2.0, YESfn ServerWindowRefreshtimerendend fnvoid local fn DoDialog( ev as long, tag as long, wnd as long )if ( ev != _btnClick ) then exit fnselect ( tag )case _openButton   : fn WorkspaceOpenURL( fn URLWithString( fn StringWithFormat( @"http://127.0.0.1:%d/", _sitePort ) ) )case _loggingCheck : isLoggingOn = ( fn ButtonState( _loggingCheck ) == NSControlStateValueOn )end selectend fnvoid local fn DoAppEvent( ev as long )select ( ev )case _appWillFinishLaunchingfn ServerWindowBuildcase _appDidFinishLaunchingfn ServerStartcase _appShouldTerminateAfterLastWindowClosedAppEventSetBool( NO )                      // a server: it keeps serving when its window is closedend selectend fn