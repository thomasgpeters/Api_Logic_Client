/* *   Web Events.incl - Web Toolkit for FutureBasic: requests in, answers out, and the page's lifecycle * *   Every request nginx passes on arrives in WebRequestArrived (called by Web Server.incl's FastCGI server): * *       GET  <base>                 the page: the session's widgets as HTML (a new session: its cookie, its page built) *       GET  <base>fbweb/web.js     the browser's half, and web.css, the themes (from the app's Resources) *       POST <base>fbweb/event      an event, asynchronously (AJAX): { token, widget, event, value, values } *                                   answered by { updates: [...] } - only what changed; the page never reloads * *   The values of every field on the page come with each event, so FB always reads what the user sees (WebValue). * *   The page's lifecycle - events on the widget "page" (WebOn( session, @"page", @"shown", @fn PageShown )): *       created    the session starts: the app's build function makes the page (WebStart) *       shown      the page is sent to the browser: first opened ("first") or reloaded ("again"); refresh data here *       hidden     the visitor switched tab or window; auto-saving forms with unsaved changes are saved first *       visible    the visitor came back; refresh what may have changed meanwhile *       leaving    the page is closed or left; auto-saving forms are saved first (the browser does not wait for *                  an answer) *       ended      the session was idle for WEB_SESSION_IDLE seconds: auto-saving forms are saved, then the app's *                  WebOnSessionEnd function is called, and the session is gone *   While the page is visible, web.js keeps the session alive; if it has ended anyway, the page says so and reloads. * *   The core knows no data model: what the widgets show and what an event does is the app's code. Web Binding.incl *   (optional) binds forms and tables to a model through LogicBank for FutureBasic, and plugs into the lifecycle here. * *   MIT License. Copyright (c) 2026 Imagery Business Systems, LLC. See LICENSE. */begin globalsCFStringRef gWebScript       // web.js and web.css, read once from the app's ResourcesCFStringRef gWebStyleslong        gWebRequestCountend globals// the app's function for a session that ends: void local fn Ended( session as WebSessionRef )void local fn WebOnSessionEnd( handler as ptr )gWebSessionEnded = fn WebKept( fn WebPointerNumber( handler ), gWebSessionEnded )end fn// an app-wide stylesheet linked before web.css (Bootstrap's, or the app's own)void local fn WebUseStylesheet( address as CFStringRef )if ( gWebStylesheets == NULL ) then gWebStylesheets = fn WebKept( fn MutableArrayNew, gWebStylesheets )MutableArrayAddObject( gWebStylesheets, address )end fn// a lifecycle event: the toolkit's own work first, then the app's functionvoid local fn WebLifecycle( session as WebSessionRef, phase as CFStringRef, detail as CFStringRef )// unsaved work is saved by whichever module keeps it (Web Binding.incl: auto-saving forms), if one is usedif ( gWebSaveDirtyHook != NULL && ( fn StringIsEqual( phase, @"hidden" ) || fn StringIsEqual( phase, @"leaving" ) || fn StringIsEqual( phase, @"ended" ) ) ) then fn WebCallWithSession( gWebSaveDirtyHook, session )fn WebFire( session, @"page", phase, detail )end fn// end the sessions nobody has used for a whilevoid local fn WebSessionsTidyCFArrayRef    idsCFStringRef   sessionIdWebSessionRef sessiondouble        now = fn WebNowif ( gWebSessions == NULL ) then exit fnids = fn DictionaryAllKeys( gWebSessions )for sessionId in idssession = (WebSessionRef)fn DictionaryObjectForKey( gWebSessions, sessionId )if ( now - fn NumberDoubleValue( fn DictionaryObjectForKey( session, @"lastSeen" ) ) > WEB_SESSION_IDLE )fn WebLifecycle( session, @"ended", @"" )if ( gWebSessionEnded ) then fn WebCallWithSession( gWebSessionEnded, session )MutableDictionaryRemoveObjectForKey( gWebSessions, sessionId )end ifnextend fn// --- answers (CGI responses, which nginx turns into HTTP) ---local fn WebAnswer( status as CFStringRef, contentType as CFStringRef, extraHeaders as CFStringRef, content as CFStringRef ) as CFStringRefCFMutableStringRef answer = fn MutableStringNewMutableStringAppendFormat( answer, @"Status: %@\r\nContent-Type: %@; charset=utf-8\r\nX-Content-Type-Options: nosniff\r\nReferrer-Policy: same-origin\r\n", status, contentType )MutableStringAppendString( answer, extraHeaders )MutableStringAppendFormat( answer, @"\r\n%@", content )end fn = answerlocal fn WebJSONAnswer( object as CFTypeRef ) as CFStringRefCFDataRef json = fn JSONSerializationDataWithJSONObject( object, 0, NULL )if ( json == NULL ) then exit fn = fn WebAnswer( @"500 Internal Server Error", @"application/json", @"Cache-Control: no-store\r\n", @"{\"updates\":[]}" )end fn = fn WebAnswer( @"200 OK", @"application/json", @"Cache-Control: no-store\r\n", fn StringWithData( json, NSUTF8StringEncoding ) )local fn WebResourceText( resourceName as CFStringRef, extension as CFStringRef ) as CFStringRefCFURLRef url = fn BundleURLForResource( fn BundleMain, resourceName, extension, NULL )if ( url == NULL )if ( isLoggingOn ) then NSLog( @"Web Toolkit: %@.%@ is not in the app's Resources", resourceName, extension )exit fn = @""end ifend fn = fn StringWithContentsOfURL( url, NSUTF8StringEncoding, NULL )// the page; a new visitor gets a session (and its cookie), a returning one the session as they left itlocal fn WebPageAnswer( params as CFDictionaryRef ) as CFStringRefWebSessionRef session = fn WebSessionFromCookie( fn DictionaryObjectForKey( params, @"HTTP_COOKIE" ) )CFStringRef   headers = @"Cache-Control: no-store\r\n", secure = @"", detail = @"again", policyif ( session == NULL )session = fn WebSessionNewdetail = @"first"if ( fn StringIsEqual( fn WebValueText( fn DictionaryObjectForKey( params, @"HTTPS" ) ), @"on" ) ) then secure = @"; Secure"headers = fn StringWithFormat( @"%@Set-Cookie: %@=%@; Path=%@; HttpOnly; SameSite=Strict%@\r\n", headers, WEB_COOKIE, fn DictionaryObjectForKey( session, @"id" ), gWebBase, secure )end if// the page's scripts and styles come from this server only: nothing injected can runpolicy = @"Content-Security-Policy: default-src 'self'; img-src 'self' data: https:; style-src 'self' https://cdn.jsdelivr.net; script-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'\r\n"fn WebLifecycle( session, @"shown", detail )end fn = fn WebAnswer( @"200 OK", @"text/html", fn StringWithFormat( @"%@%@", headers, policy ), fn WebPageHTML( session ) )// the values of the page's fields, as the browser has them: into the widgets (no updates: the page shows them already)void local fn WebApplyValues( session as WebSessionRef, values as CFDictionaryRef )CFArrayRef             widgetIds = fn DictionaryAllKeys( values )CFStringRef            widgetId, kind, oldText, newTextCFMutableDictionaryRef widgetCFTypeRef              aValuefor widgetId in widgetIdswidget = fn WebWidget( session, widgetId )if ( widget == NULL ) then continuekind   = fn DictionaryObjectForKey( widget, @"kind" )aValue = fn DictionaryObjectForKey( values, widgetId )if ( fn StringIsEqual( kind, @"checkbox" ) )if ( fn WebChecked( session, widgetId ) != ( fn StringDoubleValue( fn WebValueText( aValue ) ) != 0 || fn StringIsEqual( fn WebValueText( aValue ), @"true" ) ) )fn WebSetProp( widget, @"checked", fn NumberWithBool( fn WebChecked( session, widgetId ) == NO ) )if ( gWebFieldEditedHook ) then fn WebCallHandler( gWebFieldEditedHook, session, widgetId, @"" )end ifelseoldText = fn WebValue( session, widgetId )newText = fn WebValueText( aValue )if ( fn StringIsEqual( oldText, newText ) == NO )fn WebSetProp( widget, @"value", newText )if ( gWebFieldEditedHook ) then fn WebCallHandler( gWebFieldEditedHook, session, widgetId, @"" )end ifend ifnextend fn// an event from the page: { token, widget, event, value, values }local fn WebEventAnswer( params as CFDictionaryRef, body as CFStringRef ) as CFStringRefWebSessionRef   session = fn WebSessionFromCookie( fn DictionaryObjectForKey( params, @"HTTP_COOKIE" ) )CFDictionaryRef eventCFStringRef     widgetId, eventName, eventValueCFTypeRef       valuesif ( session == NULL ) then exit fn = fn WebJSONAnswer( @{ @"expired" : @YES, @"updates" : @[] } )event = fn JSONSerializationJSONObjectWithData( fn StringData( body, NSUTF8StringEncoding ), 0, NULL )if ( event == NULL ) then exit fn = fn WebJSONAnswer( @{ @"updates" : @[] } )// the session's token: an event a page of another site tries to send has the cookie, but not the tokenif ( fn StringIsEqual( fn WebValueText( fn DictionaryObjectForKey( event, @"token" ) ), fn DictionaryObjectForKey( session, @"token" ) ) == NO )if ( isLoggingOn ) then NSLog( @"Web Toolkit: an event without the session's token was refused" )exit fn = fn WebJSONAnswer( @{ @"expired" : @YES, @"updates" : @[] } )end ifwidgetId   = fn WebValueText( fn DictionaryObjectForKey( event, @"widget" ) )eventName  = fn WebValueText( fn DictionaryObjectForKey( event, @"event" ) )eventValue = fn WebValueText( fn DictionaryObjectForKey( event, @"value" ) )values     = fn DictionaryObjectForKey( event, @"values" )if ( values ) then fn WebApplyValues( session, values )if ( fn StringIsEqual( widgetId, @"page" ) )// the lifecycle; "alive" only keeps the sessionif ( fn StringIsEqual( eventName, @"alive" ) == NO ) then fn WebLifecycle( session, eventName, eventValue )else// a row chosen in a table or a list: the browser shows it alreadyif ( fn StringIsEqual( eventName, @"selected" ) ) then fn WebSetProp( fn WebWidget( session, widgetId ), @"selected", fn NumberWithLong( fn StringIntegerValue( eventValue ) ) )fn WebFire( session, widgetId, eventName, eventValue )end ifend fn = fn WebJSONAnswer( @{ @"updates" : fn WebTakeUpdates( session ) } )// every request from nginx: its parameters (REQUEST_METHOD, DOCUMENT_URI, HTTP_COOKIE ...) and its body;// NULL answers 404local fn WebRequestArrived( params as CFDictionaryRef, body as CFStringRef ) as CFStringRefCFStringRef method = fn WebValueText( fn DictionaryObjectForKey( params, @"REQUEST_METHOD" ) )CFStringRef path   = fn WebValueText( fn DictionaryObjectForKey( params, @"DOCUMENT_URI" ) )gWebRequestCount++if ( gWebRequestCount mod 100 == 0 ) then fn WebSessionsTidyif ( fn StringIsEqual( method, @"GET" ) || fn StringIsEqual( method, @"HEAD" ) )if ( fn StringIsEqual( path, gWebBase ) ) then exit fn = fn WebPageAnswer( params )if ( fn StringIsEqual( path, fn StringWithFormat( @"%@fbweb/web.js", gWebBase ) ) ) then exit fn = fn WebAnswer( @"200 OK", @"text/javascript", @"Cache-Control: no-cache\r\n", gWebScript )if ( fn StringIsEqual( path, fn StringWithFormat( @"%@fbweb/web.css", gWebBase ) ) ) then exit fn = fn WebAnswer( @"200 OK", @"text/css", @"Cache-Control: no-cache\r\n", gWebStyles )end ifif ( fn StringIsEqual( method, @"POST" ) && fn StringIsEqual( path, fn StringWithFormat( @"%@fbweb/event", gWebBase ) ) ) then exit fn = fn WebEventAnswer( params, body )end fn = NULL// starts the web app: FastCGI for nginx on 127.0.0.1:port; buildPage makes a new session's page:// void local fn BuildPage( session as WebSessionRef ). Answers 0, or the socket's error number.local fn WebStart( port as long, buildPage as ptr, titleText as CFStringRef ) as longlong problemgWebBuildPage = fn WebKept( fn WebPointerNumber( buildPage ), gWebBuildPage )gWebTitle = fn WebKept( titleText, gWebTitle )if ( gWebBase == NULL ) then gWebBase = fn WebKept( @"/", gWebBase )if ( gWebTheme == NULL ) then gWebTheme = fn WebKept( @"", gWebTheme )if ( gWebStylesheets == NULL ) then gWebStylesheets = fn WebKept( fn MutableArrayNew, gWebStylesheets )gWebScript = fn WebKept( fn WebResourceText( @"web", @"js" ), gWebScript )gWebStyles = fn WebKept( fn WebResourceText( @"web", @"css" ), gWebStyles )problem = fn FastCGIServerStart( port, @fn WebRequestArrived )if ( problem != 0 )if ( isLoggingOn ) then NSLog( @"Web Toolkit: could not listen on 127.0.0.1:%ld (error %ld - is the port in use?)", port, problem )exit fn = problemend if// sessions end on time even when no request comestimerbegin 60.0, 60.0, YESfn WebSessionsTidytimerendif ( isLoggingOn ) then NSLog( @"Web Toolkit: %@ listening for nginx on 127.0.0.1:%ld", titleText, port )end fn = 0