/* *   Web Layout.incl - Web Toolkit for FutureBasic: pages laid out in XIB files * *   A XIB - Interface Builder's file, the same one a desktop app loads - lays out a web page too: * *       fn WebLoadLayout( session, @"page", @"CustomerPanel" )     // the widgets of CustomerPanel.webxib *       fn WebOn( session, @"customerSave", @"clicked", @fn CustomerSave ) * *   Each control becomes a widget whose id is the control's Identifier (Interface Builder: Identity > Identifier), else *   "tag<n>" from its tag. Labels join their fields, controls side by side become rows (each its share of 12 columns, *   one under the other on a phone), a row of buttons a toolbar, a box a card - or a form when it holds inputs, and an *   empty label with an Identifier a message band (where WebSetMessage and the bound forms speak). *   The rules, and the tests that hold this code to them: tools/web_layout_reference.py, tools/check_web_layout.py. * *   The file: FutureBasic compiles a .xib resource into a nib, which has no XML left to read, so the web app carries *   the same XIB under the extension .webxib (App Builder and the layout tool write both). Lay pages out in Interface *   Builder (Xcode) or in the layout tool (Layout Tool/Layout Tool.html). * *   MIT License. Copyright (c) 2026 Imagery Business Systems, LLC. See LICENSE. */BeginCDeclarationCFArrayRef WebLayoutTree( CFStringRef xml, CFStringRef parentId, CFStringRef viewName );EndCBeginCFunction/* --- XIB layout core (portable Objective-C: tools/check_web_layout.py compiles and tests exactly this) --- *//* A XIB as a tree of web widgets - the rules of tools/web_layout_reference.py, which this follows step by step:   controls (frames from the top-left), labels paired with their inputs, rows (spans of 12), boxes as cards or forms.   Written without object literals or subscripts, so it also compiles with GNUstep for the tests. */static NSArray *WLChildren( NSXMLElement *el ) {    NSMutableArray *out = [NSMutableArray array];    for ( NSXMLNode *n in [el children] ) if ( [n kind] == NSXMLElementKind ) [out addObject:n];    return out;}static NSString *WLAttr( NSXMLElement *el, NSString *name ) {    NSXMLNode *a = el ? [el attributeForName:name] : nil;    return a ? [a stringValue] : nil;}static BOOL WLIs( NSXMLElement *el, NSString *name, NSString *value ) {    NSString *v = WLAttr( el, name );    return v != nil && [v isEqualToString:value];}static double WLNum( NSString *s ) { return s ? [s doubleValue] : 0.0; }static long WLHalfUp( double v ) { return (long)floor( v + 0.5 ); }static NSXMLElement *WLKeyed( NSXMLElement *el, NSString *tag, NSString *key ) {    if ( el == nil ) return nil;    for ( NSXMLElement *c in WLChildren( el ) ) if ( [[c name] isEqualToString:tag] && WLIs( c, @"key", key ) ) return c;    return nil;}static NSXMLElement *WLCell( NSXMLElement *el ) {    for ( NSXMLElement *c in WLChildren( el ) ) if ( WLIs( c, @"key", @"cell" ) ) return c;    return nil;}static NSArray *WLSubviews( NSXMLElement *el ) {    for ( NSXMLElement *c in WLChildren( el ) ) if ( [[c name] isEqualToString:@"subviews"] ) return WLChildren( c );    return [NSArray array];}static void WLDescendants( NSXMLElement *el, NSString *tag, NSMutableArray *out ) {    for ( NSXMLElement *c in WLChildren( el ) ) {        if ( [[c name] isEqualToString:tag] ) [out addObject:c];        WLDescendants( c, tag, out );    }}// x, y, width, height of the frame of the element (bottom-left based, as in the XIB)static void WLFrame( NSXMLElement *el, double *f ) {    f[0] = f[1] = f[2] = f[3] = 0;    for ( NSXMLElement *r in WLChildren( el ) ) {        if ( [[r name] isEqualToString:@"rect"] && WLIs( r, @"key", @"frame" ) ) {            f[0] = WLNum( WLAttr( r, @"x" ) ); f[1] = WLNum( WLAttr( r, @"y" ) );            f[2] = WLNum( WLAttr( r, @"width" ) ); f[3] = WLNum( WLAttr( r, @"height" ) );            return;        }    }}static NSString *WLStripColon( NSString *t ) {    NSString *s = [t stringByTrimmingCharactersInSet:[NSCharacterSet whitespaceAndNewlineCharacterSet]];    if ( [s hasSuffix:@":"] ) s = [[s substringToIndex:[s length] - 1] stringByTrimmingCharactersInSet:[NSCharacterSet whitespaceAndNewlineCharacterSet]];    return s;}static NSNumber *WLLong( long v ) { return [NSNumber numberWithLong:v]; }static NSNumber *WLDouble( double v ) { return [NSNumber numberWithDouble:v]; }static double WLGet( NSDictionary *c, NSString *key ) { return [[c objectForKey:key] doubleValue]; }static NSString *WLStr( NSDictionary *c, NSString *key ) { NSString *s = [c objectForKey:key]; return s ? s : @""; }static NSDictionary *WLChoice( NSString *code, NSString *title ) {    return [NSDictionary dictionaryWithObjectsAndKeys:code, @"code", title, @"title", nil];}// --- step 1: controls ---static NSString *WLUnique( NSMutableSet *used, NSString *wid ) {    NSString *base = wid; long n = 2;    while ( [used containsObject:wid] ) { wid = [NSString stringWithFormat:@"%@-%ld", base, n]; n++; }    [used addObject:wid];    return wid;}static NSString *WLWidgetId( NSMutableSet *used, NSXMLElement *el, NSXMLElement *fallback ) {    NSXMLElement *both[2] = { el, fallback };    for ( int i = 0; i < 2; i++ ) { NSString *v = WLAttr( both[i], @"identifier" ); if ( [v length] ) return WLUnique( used, v ); }    for ( int i = 0; i < 2; i++ ) {        NSString *v = WLAttr( both[i], @"tag" );        if ( [v length] && ![v isEqualToString:@"0"] ) return WLUnique( used, [@"tag" stringByAppendingString:v] );    }    NSString *v = WLAttr( el, @"id" );    return WLUnique( used, [v length] ? v : @"control" );}static NSMutableDictionary *WLCommon( NSXMLElement *el, NSMutableDictionary *c ) {    NSXMLElement *cell = WLCell( el );    if ( WLIs( el, @"hidden", @"YES" ) ) [c setObject:[NSNumber numberWithBool:NO] forKey:@"visible"];    if ( WLIs( el, @"enabled", @"NO" ) || WLIs( cell, @"enabled", @"NO" ) ) [c setObject:[NSNumber numberWithBool:NO] forKey:@"enabled"];    return c;}static NSMutableArray *WLControls( NSMutableSet *used, NSXMLElement *view, double height, double dx, double dy );static NSMutableDictionary *WLFrameDict( double x, double top, double w, double h ) {    NSMutableDictionary *c = [NSMutableDictionary dictionary];    [c setObject:WLDouble( x ) forKey:@"x"]; [c setObject:WLDouble( top ) forKey:@"top"];    [c setObject:WLDouble( w ) forKey:@"w"]; [c setObject:WLDouble( h ) forKey:@"h"];    return c;}static NSMutableDictionary *WLControl( NSMutableSet *used, NSXMLElement *el, NSMutableDictionary *c ) {    NSString *tag = [el name];    NSXMLElement *cell = WLCell( el );    double h = WLGet( c, @"h" );    if ( [tag isEqualToString:@"textField"] || [tag isEqualToString:@"secureTextField"] || [tag isEqualToString:@"searchField"] || [tag isEqualToString:@"comboBox"] ) {        NSString *title = WLAttr( cell, @"title" ); if ( title == nil ) title = @"";        BOOL editable = WLIs( cell, @"editable", @"YES" );        if ( ![tag isEqualToString:@"textField"] || editable ) {            if ( [tag isEqualToString:@"textField"] && WLIs( cell, @"lineBreakMode", @"wordWrapping" ) && h > 30 ) {                [c setObject:@"textarea" forKey:@"kind"]; [c setObject:WLLong( MAX( 2, WLHalfUp( h / 17 ) ) ) forKey:@"lines"];            } else {                NSString *itype = @"text";                if ( [tag isEqualToString:@"secureTextField"] ) itype = @"password";                if ( [tag isEqualToString:@"searchField"] ) itype = @"search";                if ( WLKeyed( cell, @"numberFormatter", @"formatter" ) ) itype = @"number";                [c setObject:@"field" forKey:@"kind"]; [c setObject:itype forKey:@"type"];            }            NSString *hint = WLAttr( cell, @"placeholderString" );            [c setObject:( hint ? hint : @"" ) forKey:@"placeholder"]; [c setObject:@"" forKey:@"label"];        } else {            NSXMLElement *font = WLKeyed( cell, @"font", @"font" ), *color = WLKeyed( cell, @"color", @"textColor" );            NSString *style = WLAttr( font, @"textStyle" );            NSDictionary *levels = [NSDictionary dictionaryWithObjectsAndKeys:WLLong( 1 ), @"largeTitle", WLLong( 2 ), @"title1", WLLong( 2 ), @"title2", WLLong( 3 ), @"title3", WLLong( 4 ), @"headline", nil];            if ( [[title stringByTrimmingCharactersInSet:[NSCharacterSet whitespaceAndNewlineCharacterSet]] length] == 0 && [WLAttr( el, @"identifier" ) length] ) {                // an empty, named label: where the app speaks (a message band)                [c setObject:@"message" forKey:@"kind"]; [c setObject:@"" forKey:@"text"]; [c setObject:@"info" forKey:@"role"];            } else if ( style && [levels objectForKey:style] ) {                [c setObject:@"heading" forKey:@"kind"]; [c setObject:title forKey:@"text"]; [c setObject:[levels objectForKey:style] forKey:@"level"];            } else {                NSString *look = @"";                if ( WLIs( color, @"name", @"secondaryLabelColor" ) || WLIs( color, @"name", @"tertiaryLabelColor" ) ) look = @"muted";                [c setObject:@"text" forKey:@"kind"]; [c setObject:title forKey:@"text"]; [c setObject:look forKey:@"look"];                [c setObject:[NSNumber numberWithBool:( [[title stringByTrimmingCharactersInSet:[NSCharacterSet whitespaceAndNewlineCharacterSet]] length] > 0 )] forKey:@"labelCandidate"];            }        }    } else if ( [tag isEqualToString:@"datePicker"] ) {        NSXMLElement *els = WLKeyed( cell, @"datePickerElements", @"datePickerElements" );        BOOL hasDate = WLIs( els, @"day", @"YES" ), hasTime = WLIs( els, @"hour", @"YES" );        [c setObject:@"field" forKey:@"kind"];        [c setObject:( hasDate && hasTime ? @"datetime-local" : ( hasTime ? @"time" : @"date" ) ) forKey:@"type"];        [c setObject:@"" forKey:@"placeholder"]; [c setObject:@"" forKey:@"label"];    } else if ( [tag isEqualToString:@"slider"] || [tag isEqualToString:@"colorWell"] ) {        [c setObject:@"field" forKey:@"kind"]; [c setObject:( [tag isEqualToString:@"slider"] ? @"range" : @"color" ) forKey:@"type"];        [c setObject:@"" forKey:@"placeholder"]; [c setObject:@"" forKey:@"label"];    } else if ( [tag isEqualToString:@"button"] ) {        NSString *btype = WLAttr( cell, @"type" ), *title = WLAttr( cell, @"title" );        if ( btype == nil ) btype = @"push";        if ( title == nil ) title = @"";        if ( [btype isEqualToString:@"check"] ) {            [c setObject:@"checkbox" forKey:@"kind"]; [c setObject:title forKey:@"label"];        } else if ( [btype isEqualToString:@"radio"] ) {            [c setObject:@"radio" forKey:@"kind"]; [c setObject:@"" forKey:@"label"];            [c setObject:[NSArray arrayWithObject:WLChoice( title, title )] forKey:@"options"];        } else {            if ( [[title stringByTrimmingCharactersInSet:[NSCharacterSet whitespaceAndNewlineCharacterSet]] length] == 0 ) return nil;            NSXMLElement *key = WLKeyed( cell, @"string", @"keyEquivalent" );            NSString *keyText = key ? [[key stringValue] stringByTrimmingCharactersInSet:[NSCharacterSet whitespaceAndNewlineCharacterSet]] : @"";            [c setObject:@"button" forKey:@"kind"]; [c setObject:title forKey:@"text"];            [c setObject:( [keyText isEqualToString:@"DQ"] ? @"primary" : @"secondary" ) forKey:@"role"];        }    } else if ( [tag isEqualToString:@"popUpButton"] ) {        NSMutableArray *items = [NSMutableArray array], *opts = [NSMutableArray array];        WLDescendants( el, @"menuItem", items );        for ( NSXMLElement *item in items ) {            if ( WLIs( item, @"isSeparatorItem", @"YES" ) ) continue;            NSString *t = WLAttr( item, @"title" ), *code = WLAttr( item, @"tag" );            if ( t == nil ) t = @"";            if ( code == nil || [code isEqualToString:@"0"] ) code = t;            [opts addObject:WLChoice( code, t )];        }        [c setObject:@"select" forKey:@"kind"]; [c setObject:opts forKey:@"options"]; [c setObject:@"" forKey:@"label"];    } else if ( [tag isEqualToString:@"scrollView"] ) {        NSXMLElement *clip = WLKeyed( el, @"clipView", @"contentView" ), *doc = nil;        if ( clip ) { NSArray *kids = WLSubviews( clip ); if ( [kids count] ) doc = [kids objectAtIndex:0]; }        if ( doc && ( [[doc name] isEqualToString:@"tableView"] || [[doc name] isEqualToString:@"outlineView"] ) ) {            NSMutableArray *cols = [NSMutableArray array], *found = [NSMutableArray array];            WLDescendants( doc, @"tableColumn", found );            for ( NSXMLElement *col in found ) {                NSXMLElement *head = WLKeyed( col, @"tableHeaderCell", @"headerCell" );                NSString *title = WLAttr( head, @"title" ), *ident = WLAttr( col, @"identifier" );                if ( [title length] == 0 ) title = ident ? ident : @"";                NSMutableDictionary *entry = [NSMutableDictionary dictionary];                [entry setObject:( [ident length] ? ident : title ) forKey:@"key"]; [entry setObject:title forKey:@"title"];                if ( WLIs( head, @"alignment", @"right" ) ) [entry setObject:@"end" forKey:@"align"];                [cols addObject:entry];            }            [c setObject:@"table" forKey:@"kind"]; [c setObject:cols forKey:@"columns"];            [c setObject:WLWidgetId( used, doc, el ) forKey:@"id"];            return WLCommon( el, c );        }        if ( doc && [[doc name] isEqualToString:@"textView"] ) {            [c setObject:@"textarea" forKey:@"kind"]; [c setObject:WLLong( MAX( 2, WLHalfUp( h / 17 ) ) ) forKey:@"lines"]; [c setObject:@"" forKey:@"label"];            [c setObject:WLWidgetId( used, doc, el ) forKey:@"id"];            return WLCommon( el, c );        }        return nil;    } else if ( [tag isEqualToString:@"box"] ) {        if ( WLIs( el, @"boxType", @"separator" ) ) {            [c setObject:@"divider" forKey:@"kind"];        } else {            NSXMLElement *content = WLKeyed( el, @"view", @"contentView" );            NSArray *kids = [NSArray array];            if ( content ) { double f[4]; WLFrame( content, f ); kids = WLControls( used, content, f[3], 0, 0 ); }            NSString *title = WLAttr( el, @"title" );            if ( title == nil || WLIs( el, @"titlePosition", @"noTitle" ) ) title = @"";            [c setObject:@"box" forKey:@"kind"]; [c setObject:title forKey:@"title"]; [c setObject:kids forKey:@"children"];        }    } else if ( [tag isEqualToString:@"imageView"] ) {        NSString *image = WLAttr( cell, @"image" );        if ( image == nil ) image = @"";        if ( [image length] && [image rangeOfString:@"."].location == NSNotFound ) image = [image stringByAppendingString:@".png"];        [c setObject:@"image" forKey:@"kind"]; [c setObject:image forKey:@"src"]; [c setObject:@"" forKey:@"alt"];    } else {        return nil;    }    [c setObject:WLWidgetId( used, el, nil ) forKey:@"id"];    return WLCommon( el, c );}static NSMutableArray *WLControls( NSMutableSet *used, NSXMLElement *view, double height, double dx, double dy ) {    NSMutableArray *out = [NSMutableArray array];    for ( NSXMLElement *el in WLSubviews( view ) ) {        double f[4]; WLFrame( el, f );        double top = height - ( f[1] + f[3] );        NSMutableDictionary *c = WLFrameDict( f[0] + dx, top + dy, f[2], f[3] );        NSString *tag = [el name];        if ( [tag isEqualToString:@"customView"] || [tag isEqualToString:@"view"] ) {            NSArray *kids = WLSubviews( el );            BOOL radios = [kids count] > 0;            for ( NSXMLElement *k in kids ) if ( !( [[k name] isEqualToString:@"button"] && WLIs( WLCell( k ), @"type", @"radio" ) ) ) radios = NO;            if ( radios ) {                NSMutableArray *opts = [NSMutableArray array];                for ( NSXMLElement *b in kids ) { NSString *t = WLAttr( WLCell( b ), @"title" ); if ( t == nil ) t = @""; [opts addObject:WLChoice( t, t )]; }                [c setObject:@"radio" forKey:@"kind"]; [c setObject:@"" forKey:@"label"]; [c setObject:opts forKey:@"options"];                [c setObject:WLWidgetId( used, el, nil ) forKey:@"id"];                [out addObject:WLCommon( el, c )];            } else {                [out addObjectsFromArray:WLControls( used, el, f[3], WLGet( c, @"x" ), WLGet( c, @"top" ) )];            }            continue;        }        NSMutableDictionary *made = WLControl( used, el, c );        if ( made ) [out addObject:made];    }    return out;}// --- step 2: labels ---static BOOL WLIsInput( NSDictionary *c ) {    NSString *k = WLStr( c, @"kind" );    return [k isEqualToString:@"field"] || [k isEqualToString:@"textarea"] || [k isEqualToString:@"select"] || [k isEqualToString:@"radio"];}static double WLCenter( NSDictionary *c ) { return WLGet( c, @"top" ) + WLGet( c, @"h" ) / 2; }static NSComparisonResult WLByTopThenX( id a, id b, void *context ) {    double ta = WLGet( a, @"top" ), tb = WLGet( b, @"top" );    if ( ta != tb ) return ta < tb ? NSOrderedAscending : NSOrderedDescending;    double xa = WLGet( a, @"x" ), xb = WLGet( b, @"x" );    if ( xa != xb ) return xa < xb ? NSOrderedAscending : NSOrderedDescending;    return NSOrderedSame;}static NSComparisonResult WLByX( id a, id b, void *context ) {    double xa = WLGet( a, @"x" ), xb = WLGet( b, @"x" );    if ( xa != xb ) return xa < xb ? NSOrderedAscending : NSOrderedDescending;    return NSOrderedSame;}static NSArray *WLStableSort( NSArray *items, NSComparisonResult (*cmp)( id, id, void * ) ) {    // a stable insertion sort (sortedArrayUsingFunction is not guaranteed stable; the Python sort is)    NSMutableArray *out = [NSMutableArray array];    for ( id item in items ) {        NSUInteger i = [out count];        while ( i > 0 && cmp( [out objectAtIndex:i - 1], item, NULL ) == NSOrderedDescending ) i--;        [out insertObject:item atIndex:i];    }    return out;}static NSMutableArray *WLPairLabels( NSArray *controls ) {    NSMutableArray *labels = [NSMutableArray array], *inputs = [NSMutableArray array];    for ( NSDictionary *c in controls ) {        if ( [[c objectForKey:@"labelCandidate"] boolValue] ) [labels addObject:c];        if ( WLIsInput( c ) ) [inputs addObject:c];    }    NSArray *sortedLabels = WLStableSort( labels, WLByTopThenX );    // an input already labelled is marked "paired"; a label used is marked "gone" (keys the widgets never copy)    NSNumber *yes = [NSNumber numberWithBool:YES];    for ( NSMutableDictionary *lab in sortedLabels ) {        NSMutableDictionary *best = nil; double bestGap = 0;        double right = WLGet( lab, @"x" ) + WLGet( lab, @"w" );        for ( NSMutableDictionary *inp in inputs ) {            if ( [inp objectForKey:@"paired"] ) continue;            double gap = WLGet( inp, @"x" ) - right;            BOOL sameBand = fabs( WLCenter( inp ) - WLCenter( lab ) ) <= MAX( WLGet( lab, @"h" ), 22 ) / 2 + 4                || ( WLGet( lab, @"top" ) >= WLGet( inp, @"top" ) - 4 && WLGet( lab, @"top" ) <= WLGet( inp, @"top" ) + 8 );            if ( sameBand && gap >= -8 && gap <= 40 && ( best == nil || gap < bestGap ) ) { best = inp; bestGap = gap; }        }        if ( best == nil ) {            double bottom = WLGet( lab, @"top" ) + WLGet( lab, @"h" );            for ( NSMutableDictionary *inp in inputs ) {                if ( [inp objectForKey:@"paired"] ) continue;                double gap = WLGet( inp, @"top" ) - bottom;                if ( gap >= -4 && gap <= 12 && fabs( WLGet( inp, @"x" ) - WLGet( lab, @"x" ) ) <= 16 && ( best == nil || gap < bestGap ) ) { best = inp; bestGap = gap; }            }            if ( best ) {                [best setObject:WLStripColon( WLStr( lab, @"text" ) ) forKey:@"label"];                [best setObject:yes forKey:@"paired"]; [lab setObject:yes forKey:@"gone"];            }            continue;        }        [best setObject:WLStripColon( WLStr( lab, @"text" ) ) forKey:@"label"];        [best setObject:WLDouble( WLGet( best, @"x" ) + WLGet( best, @"w" ) - WLGet( lab, @"x" ) ) forKey:@"w"];        [best setObject:[lab objectForKey:@"x"] forKey:@"x"];        [best setObject:yes forKey:@"paired"]; [lab setObject:yes forKey:@"gone"];    }    NSMutableArray *out = [NSMutableArray array];    for ( NSDictionary *c in controls ) if ( [c objectForKey:@"gone"] == nil ) [out addObject:c];    return out;}// --- step 3: rows, and the widgets ---static NSMutableArray *WLLayout( NSArray *controls, double width, NSString *parentId );static BOOL WLAnyInput( NSArray *widgets ) {    for ( NSDictionary *w in widgets ) {        NSString *k = WLStr( w, @"kind" );        if ( [k isEqualToString:@"field"] || [k isEqualToString:@"textarea"] || [k isEqualToString:@"select"] || [k isEqualToString:@"radio"] || [k isEqualToString:@"checkbox"] ) return YES;        if ( WLAnyInput( [w objectForKey:@"children"] ) ) return YES;    }    return NO;}static NSMutableDictionary *WLWidget( NSString *kind, NSString *wid, NSMutableDictionary *props, NSArray *children ) {    NSMutableDictionary *w = [NSMutableDictionary dictionary];    [w setObject:kind forKey:@"kind"]; [w setObject:wid forKey:@"id"]; [w setObject:props forKey:@"props"];    [w setObject:( children ? children : [NSArray array] ) forKey:@"children"];    return w;}static void WLCopy( NSMutableDictionary *props, NSDictionary *c, NSString *key ) {    id v = [c objectForKey:key];    [props setObject:( v ? v : @"" ) forKey:key];}static NSMutableDictionary *WLWidgetOf( NSDictionary *c, double width ) {    NSString *k = WLStr( c, @"kind" );    NSMutableDictionary *props = [NSMutableDictionary dictionary];    if ( [k isEqualToString:@"heading"] ) { WLCopy( props, c, @"text" ); WLCopy( props, c, @"level" ); }    else if ( [k isEqualToString:@"text"] ) { WLCopy( props, c, @"text" ); WLCopy( props, c, @"look" ); }    else if ( [k isEqualToString:@"field"] ) { WLCopy( props, c, @"label" ); WLCopy( props, c, @"type" ); WLCopy( props, c, @"placeholder" ); }    else if ( [k isEqualToString:@"textarea"] ) { WLCopy( props, c, @"label" ); WLCopy( props, c, @"lines" ); }    else if ( [k isEqualToString:@"checkbox"] ) { WLCopy( props, c, @"label" ); }    else if ( [k isEqualToString:@"radio"] || [k isEqualToString:@"select"] ) { WLCopy( props, c, @"label" ); WLCopy( props, c, @"options" ); }    else if ( [k isEqualToString:@"button"] ) { WLCopy( props, c, @"text" ); WLCopy( props, c, @"role" ); }    else if ( [k isEqualToString:@"table"] ) { WLCopy( props, c, @"columns" ); }    else if ( [k isEqualToString:@"image"] ) { WLCopy( props, c, @"src" ); WLCopy( props, c, @"alt" ); }    else if ( [k isEqualToString:@"message"] ) { WLCopy( props, c, @"text" ); WLCopy( props, c, @"role" ); }    if ( [c objectForKey:@"visible"] ) [props setObject:[c objectForKey:@"visible"] forKey:@"visible"];    if ( [c objectForKey:@"enabled"] ) [props setObject:[c objectForKey:@"enabled"] forKey:@"enabled"];    if ( [k isEqualToString:@"box"] ) {        NSMutableArray *inner = WLLayout( WLPairLabels( [c objectForKey:@"children"] ), WLGet( c, @"w" ), WLStr( c, @"id" ) );        BOOL hasInput = WLAnyInput( inner );        if ( [WLStr( c, @"title" ) length] ) {            NSMutableDictionary *hp = [NSMutableDictionary dictionary];            [hp setObject:WLStr( c, @"title" ) forKey:@"text"]; [hp setObject:WLLong( 3 ) forKey:@"level"];            [inner insertObject:WLWidget( @"heading", [WLStr( c, @"id" ) stringByAppendingString:@"-title"], hp, nil ) atIndex:0];        }        NSMutableDictionary *bp = [NSMutableDictionary dictionary];        [bp setObject:( hasInput ? @"form" : @"card" ) forKey:@"layout"];        if ( [c objectForKey:@"visible"] ) [bp setObject:[c objectForKey:@"visible"] forKey:@"visible"];        return WLWidget( @"container", WLStr( c, @"id" ), bp, inner );    }    return WLWidget( k, WLStr( c, @"id" ), props, nil );}static NSMutableArray *WLLayout( NSArray *controls, double width, NSString *parentId ) {    NSMutableArray *rows = [NSMutableArray array];       // each: { items, top, bottom, minH }    for ( NSDictionary *c in WLStableSort( controls, WLByTopThenX ) ) {        double top = WLGet( c, @"top" ), h = WLGet( c, @"h" );        NSMutableDictionary *r = [rows lastObject];        if ( r ) {            double overlap = MIN( WLGet( r, @"bottom" ), top + h ) - MAX( WLGet( r, @"top" ), top );            if ( overlap >= 0.5 * MIN( h, WLGet( r, @"minH" ) ) ) {                [[r objectForKey:@"items"] addObject:c];                [r setObject:WLDouble( MIN( WLGet( r, @"top" ), top ) ) forKey:@"top"];                [r setObject:WLDouble( MAX( WLGet( r, @"bottom" ), top + h ) ) forKey:@"bottom"];                [r setObject:WLDouble( MIN( WLGet( r, @"minH" ), h ) ) forKey:@"minH"];                continue;            }        }        r = [NSMutableDictionary dictionary];        [r setObject:[NSMutableArray arrayWithObject:c] forKey:@"items"];        [r setObject:WLDouble( top ) forKey:@"top"]; [r setObject:WLDouble( top + h ) forKey:@"bottom"]; [r setObject:WLDouble( h ) forKey:@"minH"];        [rows addObject:r];    }    NSMutableArray *out = [NSMutableArray array];    long n = 0;    for ( NSDictionary *r in rows ) {        n++;        NSArray *items = WLStableSort( [r objectForKey:@"items"], WLByX );        if ( [items count] == 1 ) { [out addObject:WLWidgetOf( [items objectAtIndex:0], width )]; continue; }        BOOL buttons = YES;        for ( NSDictionary *c in items ) if ( ![WLStr( c, @"kind" ) isEqualToString:@"button"] ) buttons = NO;        NSMutableArray *kids = [NSMutableArray array];        NSMutableDictionary *props = [NSMutableDictionary dictionary];        if ( buttons ) {            [props setObject:( WLGet( [items objectAtIndex:0], @"x" ) > width / 2 ? @"toolbar-end" : @"toolbar" ) forKey:@"layout"];            for ( NSDictionary *c in items ) [kids addObject:WLWidgetOf( c, width )];        } else {            [props setObject:@"row" forKey:@"layout"];            for ( NSDictionary *c in items ) {                NSMutableDictionary *w = WLWidgetOf( c, width );                long sp = width > 0 ? MAX( 1, MIN( 12, WLHalfUp( 12 * WLGet( c, @"w" ) / width ) ) ) : 12;                [[w objectForKey:@"props"] setObject:WLLong( sp ) forKey:@"span"];                [kids addObject:w];            }        }        [out addObject:WLWidget( @"container", [NSString stringWithFormat:@"%@-r%ld", parentId, n], props, kids )];    }    return out;}// the widget tree of the top-level view of a XIB (the one whose identifier or id is viewName, or the first)static NSArray *WLTreeFromXIB( NSString *xml, NSString *parentId, NSString *viewName ) {    NSError *problem = nil;    NSXMLDocument *doc = [[NSXMLDocument alloc] initWithXMLString:xml options:0 error:&problem];    if ( doc == nil ) return nil;    NSXMLElement *objects = nil, *view = nil;    for ( NSXMLElement *c in WLChildren( [doc rootElement] ) ) if ( [[c name] isEqualToString:@"objects"] ) objects = c;    for ( NSXMLElement *el in WLChildren( objects ) ) {        NSString *tag = [el name];        if ( ( [tag isEqualToString:@"customView"] || [tag isEqualToString:@"view"] ) && ( [viewName length] == 0 || WLIs( el, @"identifier", viewName ) || WLIs( el, @"id", viewName ) ) ) { view = el; break; }        if ( [tag isEqualToString:@"window"] && [viewName length] == 0 ) { view = WLKeyed( el, @"view", @"contentView" ); if ( view ) break; }    }    if ( view == nil ) return [NSArray array];    double f[4]; WLFrame( view, f );    NSMutableSet *used = [NSMutableSet set];    return WLLayout( WLPairLabels( WLControls( used, view, f[3], 0, 0 ) ), f[2], parentId );}/* --- end XIB layout core --- */// the widget tree, for FB (autoreleased, as Cocoa calls answer)CFArrayRef WebLayoutTree( CFStringRef xml, CFStringRef parentId, CFStringRef viewName ) {    NSArray *tree = WLTreeFromXIB( (__bridge NSString *)xml, (__bridge NSString *)parentId, (__bridge NSString *)viewName );    if ( tree == nil ) return NULL;    CFArrayRef answer = (CFArrayRef)CFBridgingRetain( tree );    CFAutorelease( answer );    return answer;}EndCtoolbox fn WebLayoutTree( CFStringRef xml, CFStringRef parentId, CFStringRef viewName ) = CFArrayRef// one widget of the tree, and what is inside itvoid local fn WebLayoutBuild( session as WebSessionRef, parentId as CFStringRef, widget as CFDictionaryRef )CFStringRef     kind = fn DictionaryObjectForKey( widget, @"kind" ), widgetId = fn DictionaryObjectForKey( widget, @"id" )CFDictionaryRef props = fn DictionaryObjectForKey( widget, @"props" )CFArrayRef      children = fn DictionaryObjectForKey( widget, @"children" )CFDictionaryRef childCFTypeRef       aValueif ( fn StringIsEqual( kind, @"container" ) ) then fn WebContainer( session, parentId, widgetId, fn DictionaryObjectForKey( props, @"layout" ) )if ( fn StringIsEqual( kind, @"heading" ) ) then fn WebHeading( session, parentId, widgetId, fn DictionaryObjectForKey( props, @"text" ), fn NumberLongValue( fn DictionaryObjectForKey( props, @"level" ) ) )if ( fn StringIsEqual( kind, @"text" ) ) then fn WebText( session, parentId, widgetId, fn DictionaryObjectForKey( props, @"text" ), fn DictionaryObjectForKey( props, @"look" ) )if ( fn StringIsEqual( kind, @"field" ) ) then fn WebField( session, parentId, widgetId, fn DictionaryObjectForKey( props, @"label" ), fn DictionaryObjectForKey( props, @"type" ), fn DictionaryObjectForKey( props, @"placeholder" ) )if ( fn StringIsEqual( kind, @"textarea" ) ) then fn WebTextArea( session, parentId, widgetId, fn DictionaryObjectForKey( props, @"label" ), fn NumberLongValue( fn DictionaryObjectForKey( props, @"lines" ) ) )if ( fn StringIsEqual( kind, @"checkbox" ) ) then fn WebCheckbox( session, parentId, widgetId, fn DictionaryObjectForKey( props, @"label" ), NO )if ( fn StringIsEqual( kind, @"radio" ) ) then fn WebRadioGroup( session, parentId, widgetId, fn DictionaryObjectForKey( props, @"label" ), fn DictionaryObjectForKey( props, @"options" ) )if ( fn StringIsEqual( kind, @"select" ) ) then fn WebSelect( session, parentId, widgetId, fn DictionaryObjectForKey( props, @"label" ), fn DictionaryObjectForKey( props, @"options" ) )if ( fn StringIsEqual( kind, @"button" ) ) then fn WebButton( session, parentId, widgetId, fn DictionaryObjectForKey( props, @"text" ), fn DictionaryObjectForKey( props, @"role" ) )if ( fn StringIsEqual( kind, @"table" ) ) then fn WebTable( session, parentId, widgetId, fn DictionaryObjectForKey( props, @"columns" ) )if ( fn StringIsEqual( kind, @"image" ) ) then fn WebImage( session, parentId, widgetId, fn DictionaryObjectForKey( props, @"src" ), fn DictionaryObjectForKey( props, @"alt" ) )if ( fn StringIsEqual( kind, @"divider" ) ) then fn WebDivider( session, parentId, widgetId )if ( fn StringIsEqual( kind, @"message" ) ) then fn WebMessage( session, parentId, widgetId, fn DictionaryObjectForKey( props, @"text" ), fn DictionaryObjectForKey( props, @"role" ) )if ( fn WebWidget( session, widgetId ) == NULL ) then exit fn// what the XIB says beyond the widget's own call: its share of a row, hidden, disabledaValue = fn DictionaryObjectForKey( props, @"span" )if ( aValue ) then fn WebSetProp( fn WebWidget( session, widgetId ), @"span", aValue )aValue = fn DictionaryObjectForKey( props, @"visible" )if ( aValue ) then fn WebSetProp( fn WebWidget( session, widgetId ), @"visible", aValue )aValue = fn DictionaryObjectForKey( props, @"enabled" )if ( aValue ) then fn WebSetProp( fn WebWidget( session, widgetId ), @"enabled", aValue )for child in childrenfn WebLayoutBuild( session, widgetId, child )nextend fn// a layout's XIB text from the app's Resources: <name>.webxib, else <name>.xib if it was copied as it islocal fn WebLayoutText( layoutName as CFStringRef ) as CFStringRefCFURLRef url = fn BundleURLForResource( fn BundleMain, layoutName, @"webxib", NULL )if ( url == NULL ) then url = fn BundleURLForResource( fn BundleMain, layoutName, @"xib", NULL )if ( url == NULL ) then exit fn = NULLend fn = fn StringWithContentsOfURL( url, NSUTF8StringEncoding, NULL )// the widgets of a layout, placed in parentId; YES when the layout was found and read. viewName picks one view of a// XIB that holds several (its Identifier); "" takes the firstlocal fn WebLoadLayoutView( session as WebSessionRef, parentId as CFStringRef, layoutName as CFStringRef, viewName as CFStringRef ) as BOOLCFStringRef     xml = fn WebLayoutText( layoutName )CFArrayRef      treeCFDictionaryRef widgetif ( xml == NULL )if ( isLoggingOn ) then NSLog( @"Web Toolkit: no layout %@.webxib in the app's Resources", layoutName )exit fn = NOend ifif ( viewName == NULL ) then viewName = @""tree = fn WebLayoutTree( xml, parentId, viewName )if ( tree == NULL )if ( isLoggingOn ) then NSLog( @"Web Toolkit: %@.webxib is not a XIB that can be read", layoutName )exit fn = NOend iffor widget in treefn WebLayoutBuild( session, parentId, widget )nextend fn = YESlocal fn WebLoadLayout( session as WebSessionRef, parentId as CFStringRef, layoutName as CFStringRef ) as BOOLend fn = fn WebLoadLayoutView( session, parentId, layoutName, @"" )