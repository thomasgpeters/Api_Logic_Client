/* *   Web Render.incl - Web Toolkit for FutureBasic: widgets as HTML * *   The whole page when the browser asks for it; afterwards only what changed, as a list of updates answering each *   event (web.js applies them in place, without reloading). Every text is escaped: nothing a user types is ever sent *   back as HTML. The HTML uses Bootstrap 5's class names (btn, form-control, table, alert ...): web.css styles them *   with the themes' colours, and an app can link Bootstrap itself instead (WebUseStylesheet). * *   Each widget's outer element carries data-fb-id (its id) and data-fb-events (the events the app listens to); *   the element holding its value carries data-fb-input. * *   MIT License. Copyright (c) 2026 Imagery Business Systems, LLC. See LICENSE. */begin globalsCFMutableArrayRef gWebStylesheets      // stylesheets linked before web.css (Bootstrap, the app's own)end globals// text made safe for HTML, in an element or an attributelocal fn WebEscape( aValue as CFTypeRef ) as CFStringRefCFStringRef content = fn WebValueText( aValue )cln NSString *s = (__bridge NSString *)content; NSMutableString *out = [NSMutableString stringWithCapacity:s.length + 16]; for ( NSUInteger i = 0; i < s.length; i++ ) { unichar c = [s characterAtIndex:i]; switch ( c ) { case '&': [out appendString:@"&amp;"]; break; case '<': [out appendString:@"&lt;"]; break; case '>': [out appendString:@"&gt;"]; break; case '"': [out appendString:@"&quot;"]; break; case '\'': [out appendString:@"&#39;"]; break; default: [out appendFormat:@"%C", c]; } } return (__bridge CFStringRef)out;end fn = @""// a name the page uses as a class or a type: letters, digits and - onlylocal fn WebToken( aValue as CFTypeRef ) as CFStringRefCFStringRef content = fn WebValueText( aValue )cln NSString *s = (__bridge NSString *)content; NSMutableString *out = [NSMutableString string]; for ( NSUInteger i = 0; i < s.length && i < 40; i++ ) { unichar c = [s characterAtIndex:i]; if ( ( c >= 'a' && c <= 'z' ) || ( c >= 'A' && c <= 'Z' ) || ( c >= '0' && c <= '9' ) || c == '-' ) [out appendFormat:@"%C", c]; } return (__bridge CFStringRef)out;end fn = @""local fn WebPropText( props as CFDictionaryRef, propName as CFStringRef ) as CFStringRefend fn = fn WebValueText( fn DictionaryObjectForKey( props, propName ) )local fn WebPropIsOff( props as CFDictionaryRef, propName as CFStringRef ) as BOOLCFTypeRef isOn = fn DictionaryObjectForKey( props, propName )if ( isOn == NULL ) then exit fn = NOend fn = ( fn NumberBoolValue( isOn ) == NO )// the attributes every widget's outer element carrieslocal fn WebCommonAttributes( widget as CFDictionaryRef ) as CFStringRefCFDictionaryRef    props = fn DictionaryObjectForKey( widget, @"props" )CFArrayRef         eventNames = fn DictionaryAllKeys( fn DictionaryObjectForKey( widget, @"events" ) )CFMutableStringRef attributes = fn MutableStringNewMutableStringAppendFormat( attributes, @" data-fb-id=\"%@\" id=\"fb-%@\"", fn WebEscape( fn DictionaryObjectForKey( widget, @"id" ) ), fn WebEscape( fn DictionaryObjectForKey( widget, @"id" ) ) )if ( fn ArrayCount( eventNames ) ) then MutableStringAppendFormat( attributes, @" data-fb-events=\"%@\"", fn WebEscape( fn ArrayComponentsJoinedByString( eventNames, @" " ) ) )if ( fn WebPropIsOff( props, @"visible" ) ) then MutableStringAppendString( attributes, @" hidden" )// a form bound to an entity: the browser guards its unsaved changes (Web Binding.incl)if ( fn DictionaryObjectForKey( props, @"entity" ) && fn StringIsEqual( fn DictionaryObjectForKey( widget, @"kind" ), @"container" ) ) then MutableStringAppendString( attributes, @" data-fb-bound" )if ( fn WebPropIsOff( props, @"dirty" ) == NO && fn DictionaryObjectForKey( props, @"dirty" ) ) then MutableStringAppendString( attributes, @" data-fb-dirty" )if ( fn WebPropIsOff( props, @"autosave" ) == NO && fn DictionaryObjectForKey( props, @"autosave" ) ) then MutableStringAppendString( attributes, @" data-fb-autosave" )end fn = attributeslocal fn WebDisabled( props as CFDictionaryRef ) as CFStringRefif ( fn WebPropIsOff( props, @"enabled" ) ) then exit fn = @" disabled"end fn = @""// a { code, title } choice, or a plain stringlocal fn WebChoiceCode( choice as CFTypeRef ) as CFStringRefcln if ( [(__bridge id)choice isKindOfClass:[NSDictionary class]] ) return (__bridge CFStringRef)[[(__bridge NSDictionary *)choice objectForKey:@"code"] description] ?: @"";end fn = fn WebValueText( choice )local fn WebChoiceTitle( choice as CFTypeRef ) as CFStringRefcln if ( [(__bridge id)choice isKindOfClass:[NSDictionary class]] ) { id t = [(__bridge NSDictionary *)choice objectForKey:@"title"]; if ( t == nil ) t = [(__bridge NSDictionary *)choice objectForKey:@"code"]; return (__bridge CFStringRef)( t ? [t description] : @"" ); }end fn = fn WebValueText( choice )// a { key, title } column, or a plain stringlocal fn WebColumnKey( column as CFTypeRef ) as CFStringRefcln if ( [(__bridge id)column isKindOfClass:[NSDictionary class]] ) return (__bridge CFStringRef)[[(__bridge NSDictionary *)column objectForKey:@"key"] description] ?: @"";end fn = fn WebValueText( column )local fn WebColumnTitle( column as CFTypeRef ) as CFStringRefcln if ( [(__bridge id)column isKindOfClass:[NSDictionary class]] ) { id t = [(__bridge NSDictionary *)column objectForKey:@"title"]; if ( t == nil ) t = [(__bridge NSDictionary *)column objectForKey:@"key"]; return (__bridge CFStringRef)( t ? [t description] : @"" ); }end fn = fn WebValueText( column )local fn WebColumnAlign( column as CFTypeRef ) as CFStringRefcln if ( [(__bridge id)column isKindOfClass:[NSDictionary class]] && [[(__bridge NSDictionary *)column objectForKey:@"align"] isEqual:@"end"] ) return (__bridge CFStringRef)@" class=\"text-end\"";end fn = @""// a field, text area, drop-down or radio group's labellocal fn WebLabelHTML( widgetId as CFStringRef, props as CFDictionaryRef ) as CFStringRefCFStringRef labelText = fn WebPropText( props, @"label" )if ( fn StringLength( labelText ) == 0 ) then exit fn = @""end fn = fn StringWithFormat( @"<label class=\"form-label\" for=\"fb-in-%@\">%@</label>", fn WebEscape( widgetId ), fn WebEscape( labelText ) )local fn WebStringIf( condition as BOOL, content as CFStringRef ) as CFStringRefif ( condition ) then exit fn = contentend fn = @""// the kinds, numbered for WebRenderWidget's selectlocal fn WebKindNumber( kind as CFStringRef ) as longCFArrayRef kinds = @[ @"container", @"heading", @"text", @"label", @"link", @"image", @"divider", @"message", @"button", @"field", @"textarea", @"checkbox", @"radio", @"select", @"table", @"list" ]NSUInteger found = fn ArrayIndexOfObject( kinds, kind )if ( found == NSNotFound ) then exit fn = 0end fn = found + 1void local fn WebRenderChoices( widgetId as CFStringRef, props as CFDictionaryRef, html as CFMutableStringRef, isRadio as BOOL )CFArrayRef  choices = fn DictionaryObjectForKey( props, @"options" )CFTypeRef   choiceCFStringRef chosen = fn WebPropText( props, @"value" ), code, marklong        n = 0for choice in choicescode = fn WebChoiceCode( choice )if ( isRadio )if ( fn StringIsEqual( code, chosen ) ) then mark = @" checked" else mark = @""MutableStringAppendFormat( html, @"<div class=\"form-check\"><input class=\"form-check-input\" type=\"radio\" name=\"fb-in-%@\" id=\"fb-in-%@-%ld\" value=\"%@\"%@%@>", fn WebEscape( widgetId ), fn WebEscape( widgetId ), n, fn WebEscape( code ), mark, fn WebDisabled( props ) )MutableStringAppendFormat( html, @"<label class=\"form-check-label\" for=\"fb-in-%@-%ld\">%@</label></div>", fn WebEscape( widgetId ), n, fn WebEscape( fn WebChoiceTitle( choice ) ) )elseif ( fn StringIsEqual( code, chosen ) ) then mark = @" selected" else mark = @""MutableStringAppendFormat( html, @"<option value=\"%@\"%@>%@</option>", fn WebEscape( code ), mark, fn WebEscape( fn WebChoiceTitle( choice ) ) )end ifn++nextend fnvoid local fn WebRenderTable( widget as CFDictionaryRef, html as CFMutableStringRef )CFDictionaryRef props = fn DictionaryObjectForKey( widget, @"props" )CFArrayRef      columnList = fn DictionaryObjectForKey( props, @"columns" ), rowList = fn DictionaryObjectForKey( props, @"rows" )CFTypeRef       columnCFDictionaryRef aRecordlong            rowNumber = 0, chosen = fn NumberLongValue( fn DictionaryObjectForKey( props, @"selected" ) )CFStringRef     markMutableStringAppendFormat( html, @"<div class=\"table-responsive fb-table\"%@><table class=\"table table-hover align-middle\"><thead><tr>", fn WebCommonAttributes( widget ) )for column in columnListMutableStringAppendFormat( html, @"<th scope=\"col\"%@>%@</th>", fn WebColumnAlign( column ), fn WebEscape( fn WebColumnTitle( column ) ) )nextMutableStringAppendString( html, @"</tr></thead><tbody>" )for aRecord in rowListif ( rowNumber == chosen ) then mark = @" class=\"table-active\" aria-selected=\"true\"" else mark = @""MutableStringAppendFormat( html, @"<tr data-fb-row=\"%ld\" tabindex=\"0\"%@>", rowNumber, mark )for column in columnListMutableStringAppendFormat( html, @"<td%@>%@</td>", fn WebColumnAlign( column ), fn WebEscape( fn DictionaryObjectForKey( aRecord, fn WebColumnKey( column ) ) ) )nextMutableStringAppendString( html, @"</tr>" )rowNumber++nextif ( rowNumber == 0 ) then MutableStringAppendFormat( html, @"<tr class=\"fb-empty\"><td colspan=\"%ld\">Nothing to show.</td></tr>", fn ArrayCount( columnList ) )MutableStringAppendString( html, @"</tbody></table></div>" )end fnvoid local fn WebRenderList( widget as CFDictionaryRef, html as CFMutableStringRef )CFDictionaryRef props = fn DictionaryObjectForKey( widget, @"props" )CFArrayRef      lines = fn DictionaryObjectForKey( props, @"items" )CFTypeRef       lineTextlong            rowNumber = 0, chosen = fn NumberLongValue( fn DictionaryObjectForKey( props, @"selected" ) )CFStringRef     markMutableStringAppendFormat( html, @"<ul class=\"list-group fb-list\"%@>", fn WebCommonAttributes( widget ) )for lineText in linesif ( rowNumber == chosen ) then mark = @" active" else mark = @""MutableStringAppendFormat( html, @"<li class=\"list-group-item%@\" data-fb-row=\"%ld\" tabindex=\"0\">%@</li>", mark, rowNumber, fn WebEscape( lineText ) )rowNumber++nextMutableStringAppendString( html, @"</ul>" )end fn// one widget and everything in it, appended to htmlvoid local fn WebRenderWidget( session as WebSessionRef, widgetId as CFStringRef, html as CFMutableStringRef )CFDictionaryRef widget = fn WebWidget( session, widgetId )CFDictionaryRef propsCFStringRef     kind, common, wid, look, tagName, address, mark, childIdCFArrayRef      childIdsif ( widget == NULL ) then exit fnprops  = fn DictionaryObjectForKey( widget, @"props" )kind   = fn DictionaryObjectForKey( widget, @"kind" )common = fn WebCommonAttributes( widget )wid    = fn WebEscape( widgetId )select ( fn WebKindNumber( kind ) )case 1 // containerlook = fn WebToken( fn DictionaryObjectForKey( props, @"layout" ) )if ( fn StringIsEqual( look, @"form" ) ) then tagName = @"form" else tagName = @"div"if ( fn StringIsEqual( look, @"section" ) ) then tagName = @"section"MutableStringAppendFormat( html, @"<%@ class=\"fb-container fb-%@\"%@%@>", tagName, look, common, fn WebStringIf( fn StringIsEqual( look, @"form" ), @" novalidate" ) )childIds = fn DictionaryObjectForKey( widget, @"children" )for childId in childIdsfn WebRenderWidget( session, childId, html )nextMutableStringAppendFormat( html, @"</%@>", tagName )case 2 // headingMutableStringAppendFormat( html, @"<h%@ class=\"fb-heading\"%@>%@</h%@>", fn WebPropText( props, @"level" ), common, fn WebEscape( fn DictionaryObjectForKey( props, @"text" ) ), fn WebPropText( props, @"level" ) )case 3 // textMutableStringAppendFormat( html, @"<p class=\"fb-text fb-%@\"%@>%@</p>", fn WebToken( fn DictionaryObjectForKey( props, @"look" ) ), common, fn WebEscape( fn DictionaryObjectForKey( props, @"text" ) ) )case 4 // labelMutableStringAppendFormat( html, @"<label class=\"form-label\" for=\"fb-in-%@\"%@>%@</label>", fn WebEscape( fn DictionaryObjectForKey( props, @"for" ) ), common, fn WebEscape( fn DictionaryObjectForKey( props, @"text" ) ) )case 5 // link: an address, or an action (the app's "clicked")address = fn WebPropText( props, @"href" )if ( fn StringLength( address ) == 0 ) then address = @"#"if ( fn StringHasPrefix( fn StringLowercaseString( address ), @"javascript:" ) ) then address = @"#"MutableStringAppendFormat( html, @"<a href=\"%@\"%@>%@</a>", fn WebEscape( address ), common, fn WebEscape( fn DictionaryObjectForKey( props, @"text" ) ) )case 6 // imageMutableStringAppendFormat( html, @"<img class=\"fb-image\" src=\"%@\" alt=\"%@\"%@>", fn WebEscape( fn DictionaryObjectForKey( props, @"src" ) ), fn WebEscape( fn DictionaryObjectForKey( props, @"alt" ) ), common )case 7 // dividerMutableStringAppendFormat( html, @"<hr class=\"fb-divider\"%@>", common )case 8 // message bandif ( fn StringLength( fn WebPropText( props, @"text" ) ) == 0 ) then mark = @" fb-empty" else mark = @""MutableStringAppendFormat( html, @"<div class=\"alert alert-%@%@\" role=\"status\" aria-live=\"polite\"%@>%@</div>", fn WebToken( fn DictionaryObjectForKey( props, @"role" ) ), mark, common, fn WebEscape( fn DictionaryObjectForKey( props, @"text" ) ) )case 9 // buttonlook = fn WebToken( fn DictionaryObjectForKey( props, @"role" ) )if ( fn StringLength( look ) == 0 ) then look = @"secondary"MutableStringAppendFormat( html, @"<button type=\"button\" class=\"btn btn-%@\" data-fb-input%@%@>%@</button>", look, common, fn WebDisabled( props ), fn WebEscape( fn DictionaryObjectForKey( props, @"text" ) ) )case 10 // fieldMutableStringAppendFormat( html, @"<div class=\"mb-3 fb-field\"%@>%@", common, fn WebLabelHTML( widgetId, props ) )look = fn WebToken( fn DictionaryObjectForKey( props, @"type" ) )if ( fn StringIsEqual( look, @"range" ) ) then mark = @"form-range" else mark = @"form-control"if ( fn StringIsEqual( look, @"color" ) ) then mark = @"form-control form-control-color"MutableStringAppendFormat( html, @"<input class=\"%@\" type=\"%@\" id=\"fb-in-%@\" data-fb-input value=\"%@\" placeholder=\"%@\"%@%@></div>", mark, look, wid, fn WebEscape( fn DictionaryObjectForKey( props, @"value" ) ), fn WebEscape( fn DictionaryObjectForKey( props, @"placeholder" ) ), fn WebStringIf( fn StringIsEqual( look, @"number" ), @" step=\"any\"" ), fn WebDisabled( props ) )case 11 // text areaMutableStringAppendFormat( html, @"<div class=\"mb-3 fb-field\"%@>%@<textarea class=\"form-control\" id=\"fb-in-%@\" data-fb-input rows=\"%@\"%@>%@</textarea></div>", common, fn WebLabelHTML( widgetId, props ), wid, fn WebPropText( props, @"lines" ), fn WebDisabled( props ), fn WebEscape( fn DictionaryObjectForKey( props, @"value" ) ) )case 12 // check boxif ( fn WebPropIsOff( props, @"checked" ) ) then mark = @"" else mark = @" checked"MutableStringAppendFormat( html, @"<div class=\"form-check mb-3 fb-check\"%@><input class=\"form-check-input\" type=\"checkbox\" id=\"fb-in-%@\" data-fb-input%@%@><label class=\"form-check-label\" for=\"fb-in-%@\">%@</label></div>", common, wid, mark, fn WebDisabled( props ), wid, fn WebEscape( fn DictionaryObjectForKey( props, @"label" ) ) )case 13 // radio groupMutableStringAppendFormat( html, @"<fieldset class=\"mb-3 fb-radio\" data-fb-input data-fb-radio%@><legend class=\"form-label\">%@</legend>", common, fn WebEscape( fn DictionaryObjectForKey( props, @"label" ) ) )fn WebRenderChoices( widgetId, props, html, YES )MutableStringAppendString( html, @"</fieldset>" )case 14 // drop-downMutableStringAppendFormat( html, @"<div class=\"mb-3 fb-field\"%@>%@<select class=\"form-select\" id=\"fb-in-%@\" data-fb-input%@>", common, fn WebLabelHTML( widgetId, props ), wid, fn WebDisabled( props ) )fn WebRenderChoices( widgetId, props, html, NO )MutableStringAppendString( html, @"</select></div>" )case 15 // tablefn WebRenderTable( widget, html )case 16 // listfn WebRenderList( widget, html )end selectend fn// the widget's HTML on its own (an added or redrawn widget)local fn WebWidgetHTML( session as WebSessionRef, widgetId as CFStringRef ) as CFStringRefCFMutableStringRef html = fn MutableStringNewfn WebRenderWidget( session, widgetId, html )end fn = html// the whole page: the shell, the theme, the session's token, and every widgetlocal fn WebPageHTML( session as WebSessionRef ) as CFStringRefCFMutableStringRef html = fn MutableStringNewCFStringRef        sheet, themeName = fn WebToken( fn DictionaryObjectForKey( session, @"theme" ) )CFArrayRef         childIds = fn DictionaryObjectForKey( fn WebWidget( session, @"page" ), @"children" )CFStringRef        childIdMutableStringAppendString( html, @"<!doctype html><html lang=\"en\"" )if ( fn StringLength( themeName ) ) then MutableStringAppendFormat( html, @" data-fb-theme=\"%@\"", themeName )MutableStringAppendFormat( html, @"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><title>%@</title>", fn WebEscape( gWebTitle ) )MutableStringAppendFormat( html, @"<meta name=\"fb-token\" content=\"%@\"><meta name=\"fb-base\" content=\"%@\">", fn WebEscape( fn DictionaryObjectForKey( session, @"token" ) ), fn WebEscape( gWebBase ) )for sheet in gWebStylesheetsMutableStringAppendFormat( html, @"<link rel=\"stylesheet\" href=\"%@\">", fn WebEscape( sheet ) )nextMutableStringAppendFormat( html, @"<link rel=\"stylesheet\" href=\"%@fbweb/web.css\"><script src=\"%@fbweb/web.js\" defer></script></head>", fn WebEscape( gWebBase ), fn WebEscape( gWebBase ) )MutableStringAppendFormat( html, @"<body><main class=\"fb-page container\" data-fb-id=\"page\" id=\"fb-page\">" )for childId in childIdsfn WebRenderWidget( session, childId, html )nextMutableStringAppendString( html, @"</main><div class=\"fb-busy\" aria-hidden=\"true\"></div></body></html>" )MutableDictionarySetObjectForKey( session, fn NumberWithBool( YES ), @"rendered" )MutableArrayRemoveAllObjects( (CFMutableArrayRef)fn DictionaryObjectForKey( session, @"updates" ) )end fn = html// what changed since the last answer, for web.js: an added or redrawn widget carries its HTML as it is nowlocal fn WebTakeUpdates( session as WebSessionRef ) as CFArrayRefCFMutableArrayRef      queued = (CFMutableArrayRef)fn DictionaryObjectForKey( session, @"updates" )CFMutableArrayRef      answer = fn MutableArrayNewCFMutableDictionaryRef updateCFDictionaryRef        queuedUpdateCFStringRef            opfor queuedUpdate in queuedop = fn DictionaryObjectForKey( queuedUpdate, @"op" )update = fn MutableDictionaryWithDictionary( queuedUpdate )if ( fn StringIsEqual( op, @"append" ) || fn StringIsEqual( op, @"redraw" ) )// a widget removed since, or inside one added in the same answer, needs nothing of its ownif ( fn WebWidget( session, fn DictionaryObjectForKey( queuedUpdate, @"id" ) ) == NULL ) then continueMutableDictionarySetObjectForKey( update, fn WebWidgetHTML( session, fn DictionaryObjectForKey( queuedUpdate, @"id" ) ), @"html" )end ifMutableArrayAddObject( answer, update )nextMutableArrayRemoveAllObjects( queued )end fn = answer