/* *   I M A G E R Y    B U S I N E S S     S Y S T E M S,   L L C * *   ALS Model.incl - Enterprise: the model of an API Logic Server project, from its model file * *   ALS generates the model; the Studio only reads it, as text (it never runs Python): *       database/models.py   - every project (the only model file from ALS 17.04 on); *                              ALSModelFromModelsPy, reference tools/models_py_reference.py *       app_model.yaml / admin.yaml - older projects; ALSModelFromYAML (below) *   ALSModelFromText / ALSModelFromURL take either and tell them apart by their contents. * *   The relationships (names, directions, key columns), every attribute, the primary keys and *   the column that names a record - what the JSON:API side of the SQL Generator needs to turn a *   join into include=<relationship>, and what a lookup shows.  ALS's /metadata endpoint leaves *   the relationships out on purpose, so they come from the project's model file: * *       app_model.yaml (ui/app/, ALS 17.3 and earlier)   admin.yaml (ui/admin/, every project) *       entities:                                        resources:                  indent 0 *         Student:                                         Customer:                 2 *           columns:                                         attributes:             4 -> attributes *           primary_key:                                     (none)                  4 -> keys *           - id                                                                     4 *           tab_groups:                                      tab_groups:             4 -> relationships *           favorite: name                                   user_key: CompanyName   4 -> display *           - name: student_id   (a list item)                                       4 *             type: INTEGER      (its other keys)                                    6 *             fks:               (a relationship's key columns follow ...)           6 *             - student_id       (... one per line)                                  6 * *   Read line by line by indentation - the design of the C++ Studio's Model::fromAppModelYaml - *   not with a general YAML parser.  tools/jsonapi_reference.py (read_model_yaml) is the *   reference, checked against PyYAML on a live server's admin.yaml and on an app_model.yaml. * *   ALSModelFromYAML( text ) -> *       { "Customer": { "attributes":    [ { "name":"CompanyName", "label":..., "required":... } ], *                       "relationships": [ { "name":"OrderList", "direction":"tomany", *                                            "resource":"Order", "fks":[ "CustomerId" ] } ], *                       "keys": [ "Id" ], "display": "CompanyName", "type": "Customer" } } * *   MIT License. Copyright (c) 2026 Imagery Business Systems, LLC. */begin globalsCFMutableDictionaryRef gALSModelEntity      // the entity being readCFStringRef            gALSModelSection     // "attributes", "relationships", "keys" or NULLCFMutableDictionaryRef gALSModelItem        // the attribute or relationship being readBOOL                   gALSModelInFks       // the lines now are a relationship's key columnsBOOL                   gALSModelInside      // under entities: / resources:end globals// 'text', "text" -> text; leading and trailing spaces offlocal fn ALSModelUnquote( textValue as CFStringRef ) as CFStringRefCFStringRef t = fn StringByTrimmingCharactersInSet( textValue, fn CharacterSetWhitespaceSet )CFStringRef first, lastif ( fn StringLength( t ) < 2 ) then exit fn = tfirst = fn StringSubstringToIndex( t, 1 )last  = fn StringSubstringFromIndex( t, fn StringLength( t ) - 1 )if ( fn StringIsEqual( first, last ) && ( fn StringIsEqual( first, @"'" ) || fn StringIsEqual( first, @"\"" ) ) ) then exit fn = fn StringSubstringWithRange( t, fn CFRangeMake( 1, fn StringLength( t ) - 2 ) )end fn = t// how many spaces a line starts withlocal fn ALSModelIndent( textLine as CFStringRef ) as longlong n = 0while ( n < fn StringLength( textLine ) )if ( fn StringCharacterAtIndex( textLine, n ) != 32 ) then exit fn = nn++wendend fn = n// "key: value" -> @[ key, value ] (value "" when there is none)local fn ALSModelKeyValue( textPart as CFStringRef ) as CFArrayRefCFRange colon = fn StringRangeOfString( textPart, @":" )if ( colon.location == NSNotFound ) then exit fn = @[ fn ALSModelUnquote( textPart ), @"" ]end fn = @[ fn ALSModelUnquote( fn StringSubstringToIndex( textPart, colon.location ) ), fn ALSModelUnquote( fn StringSubstringFromIndex( textPart, colon.location + 1 ) ) ]// a section's key -> where its items go in the model ("columns" and "attributes" are the same)local fn ALSModelSectionFor( key as CFStringRef ) as CFStringRefif ( fn StringIsEqual( key, @"columns" ) || fn StringIsEqual( key, @"attributes" ) ) then exit fn = @"attributes"if ( fn StringIsEqual( key, @"tab_groups" ) ) then exit fn = @"relationships"if ( fn StringIsEqual( key, @"primary_key" ) ) then exit fn = @"keys"end fn = NULL// a value as the model keeps it: true / false as numbers, everything else as textlocal fn ALSModelValue( textValue as CFStringRef ) as CFTypeRefif ( fn StringIsEqual( textValue, @"true" ) ) then exit fn = fn NumberWithBool( YES )if ( fn StringIsEqual( textValue, @"false" ) ) then exit fn = fn NumberWithBool( NO )end fn = textValue// one line of the model file (an early exit is "next line")void local fn ALSModelReadLine( model as CFMutableDictionaryRef, rawLine as CFStringRef )CFStringRef            body = fn StringByTrimmingCharactersInSet( rawLine, fn CharacterSetWhitespaceSet )CFStringRef            textPart, key, value, entityNameCFArrayRef             pairCFMutableArrayRef      listlong                   indBOOL                   isItemif ( fn StringLength( body ) == 0 || fn StringHasPrefix( body, @"#" ) ) then exit fnind = fn ALSModelIndent( rawLine )if ( ind == 0 )                                             // entities: / resources: / anything elsegALSModelInside = ( fn StringIsEqual( body, @"entities:" ) || fn StringIsEqual( body, @"resources:" ) )gALSModelEntity = NULLexit fnend ifif ( gALSModelInside == NO ) then exit fnif ( ind == 2 && fn StringHasSuffix( body, @":" ) )         // an entityentityName = fn StringSubstringToIndex( body, fn StringLength( body ) - 1 )gALSModelEntity = (CFMutableDictionaryRef)fn DictionaryObjectForKey( model, entityName )if ( gALSModelEntity == NULL )gALSModelEntity = fn MutableDictionaryWithDictionary( @{ @"attributes":fn MutableArrayNew, @"relationships":fn MutableArrayNew, @"keys":fn MutableArrayNew } )MutableDictionarySetObjectForKey( model, gALSModelEntity, entityName )end ifgALSModelSection = NULLgALSModelItem = NULLexit fnend ifif ( gALSModelEntity == NULL ) then exit fnisItem = fn StringHasPrefix( body, @"- " )textPart = bodyif ( isItem ) then textPart = fn StringSubstringFromIndex( body, 2 )if ( ind == 4 && isItem == NO )                             // a section, or one of the entity's valuespair  = fn ALSModelKeyValue( textPart )key   = fn ArrayObjectAtIndex( pair, 0 )value = fn ArrayObjectAtIndex( pair, 1 )gALSModelSection = NULLif ( fn StringLength( value ) == 0 ) then gALSModelSection = fn ALSModelSectionFor( key )if ( fn StringIsEqual( key, @"user_key" ) || fn StringIsEqual( key, @"favorite" ) ) then MutableDictionarySetObjectForKey( gALSModelEntity, value, @"display" )if ( fn StringIsEqual( key, @"type" ) ) then MutableDictionarySetObjectForKey( gALSModelEntity, value, @"type" )gALSModelItem = NULLgALSModelInFks = NOexit fnend ifif ( gALSModelSection == NULL ) then exit fnif ( fn StringIsEqual( gALSModelSection, @"keys" ) )        // primary_key: one column per lineif ( ind == 4 && isItem ) then MutableArrayAddObject( (CFMutableArrayRef)fn DictionaryObjectForKey( gALSModelEntity, @"keys" ), fn ALSModelUnquote( textPart ) )exit fnend ifif ( ind == 4 && isItem )                                   // a new attribute or relationshipgALSModelItem = fn MutableDictionaryNewMutableArrayAddObject( (CFMutableArrayRef)fn DictionaryObjectForKey( gALSModelEntity, gALSModelSection ), gALSModelItem )gALSModelInFks = NOend ifif ( gALSModelItem == NULL ) then exit fnif ( ind == 6 && isItem && gALSModelInFks )                 // one of a relationship's key columnsMutableArrayAddObject( (CFMutableArrayRef)fn DictionaryObjectForKey( gALSModelItem, @"fks" ), fn ALSModelUnquote( textPart ) )exit fnend ifif ( ( ind == 4 && isItem ) || ( ind == 6 && isItem == NO ) )   // key: value of the itempair  = fn ALSModelKeyValue( textPart )key   = fn ArrayObjectAtIndex( pair, 0 )value = fn ArrayObjectAtIndex( pair, 1 )if ( fn StringIsEqual( key, @"fks" ) && fn StringLength( value ) == 0 )list = fn MutableArrayNewMutableDictionarySetObjectForKey( gALSModelItem, list, @"fks" )gALSModelInFks = YESelsegALSModelInFks = NOMutableDictionarySetObjectForKey( gALSModelItem, fn ALSModelValue( value ), key )end ifend ifend fn// the whole model file -> the model (empty when the text has no entities: or resources:)local fn ALSModelFromYAML( yamlText as CFStringRef ) as CFMutableDictionaryRefCFMutableDictionaryRef model = fn MutableDictionaryNewCFArrayRef             linesCFStringRef            rawLineif ( yamlText == NULL ) then exit fn = modellines = fn StringComponentsSeparatedByString( fn StringByReplacingOccurrencesOfString( yamlText, @"\r", @"" ), @"\n" )gALSModelEntity  = NULLgALSModelSection = NULLgALSModelItem    = NULLgALSModelInFks   = NOgALSModelInside  = NOfor rawLine in linesfn ALSModelReadLine( model, rawLine )nextend fn = model// ---- database/models.py: the model of current ALS projects (17.04 and later) ----------------// Read as text, line by line - never run.  tools/models_py_reference.py is the reference, checked// against SQLAlchemy's own view of the Northwind and CRM projects.  The lines it reads://     class Order(Base):                                     an entity//         __tablename__ = 'Order'                            its table//         _s_collection_name = 'Order'                       its resource (the API name)//         ForeignKeyConstraint(['Country', 'City'], ['Location.country', 'Location.city'])//         Id = Column(Integer, primary_key=True)             an attribute (type, key)//         Freight : DECIMAL = Column(DECIMAL, ...)           an annotated one//         CustomerId = Column(ForeignKey('Customer.Id'))     a foreign key//         Customer : Mapped["Customer"] = relationship(...)  to one//         OrderList : Mapped[List["Order"]] = relationship(back_populates="Customer")   to many// A line back at the left margin ends the class (t_X = Table(...) views are skipped).// every '...' or "..." in a piece of text, in orderlocal fn ALSPyQuotedItems( textPart as CFStringRef ) as CFArrayRefCFMutableArrayRef items = fn MutableArrayNewlong              n = fn StringLength( textPart )long              i = 0, startIndex = 0, quoteChar = 0, cwhile ( i < n )c = fn StringCharacterAtIndex( textPart, i )if ( quoteChar == 0 )if ( c == 39 || c == 34 )quoteChar = cstartIndex = i + 1end ifelseif ( c == quoteChar )MutableArrayAddObject( items, fn StringSubstringWithRange( textPart, fn CFRangeMake( startIndex, i - startIndex ) ) )quoteChar = 0end ifend ifi++wendend fn = items// the first quoted item of a piece of text; NULL when it has nonelocal fn ALSPyFirstQuoted( textPart as CFStringRef ) as CFStringRefCFArrayRef itemsif ( textPart == NULL ) then exit fn = NULLitems = fn ALSPyQuotedItems( textPart )if ( fn ArrayCount( items ) == 0 ) then exit fn = NULLend fn = fn ArrayObjectAtIndex( items, 0 )// the text after the first occurrence of marker; NULL when there is nonelocal fn ALSPyAfter( textPart as CFStringRef, marker as CFStringRef ) as CFStringRefCFRange rif ( textPart == NULL ) then exit fn = NULLr = fn StringRangeOfString( textPart, marker )if ( r.location == NSNotFound ) then exit fn = NULLend fn = fn StringSubstringFromIndex( textPart, r.location + r.length )// the word a piece of text starts with (letters, digits, _)local fn ALSPyIdentifier( textPart as CFStringRef ) as CFStringReflong n = 0, cwhile ( n < fn StringLength( textPart ) )c = fn StringCharacterAtIndex( textPart, n )if ( ( c < 48 || c > 57 ) && ( c < 65 || c > 90 ) && ( c < 97 || c > 122 ) && c != 95 ) then exit whilen++wendend fn = fn StringSubstringToIndex( textPart, n )// 'Customer.Id' -> Customer (a table); 'Employee.WorksForDepartmentId' -> its last part with lastPartlocal fn ALSPyDottedPart( dotted as CFStringRef, lastPart as BOOL ) as CFStringRefCFArrayRef parts = fn StringComponentsSeparatedByString( dotted, @"." )if ( lastPart ) then exit fn = fn ArrayLastObject( parts )end fn = fn ArrayFirstObject( parts )// a SQLAlchemy type -> the type name the model uses (NULL for one it does not know)local fn ALSPyTypeName( pyType as CFStringRef ) as CFStringRefCFDictionaryRef names = @{ @"String":@"VARCHAR", @"Text":@"TEXT", @"Integer":@"INTEGER", @"BigInteger":@"BIGINT", @"SmallInteger":@"SMALLINT", @"Float":@"FLOAT", @"Double":@"DOUBLE", @"DECIMAL":@"DECIMAL", @"Numeric":@"NUMERIC", @"Boolean":@"BOOLEAN", @"Date":@"DATE", @"DateTime":@"DATETIME", @"Time":@"TIME", @"LargeBinary":@"BLOB", @"Unicode":@"VARCHAR", @"UnicodeText":@"TEXT" }end fn = fn DictionaryObjectForKey( names, pyType )// "Name = value" or "Name : Annotation = value" -> @[ name, value ]; NULL when the line is not onelocal fn ALSPyAssignment( body as CFStringRef ) as CFArrayRefCFRange     eq = fn StringRangeOfString( body, @"=" )CFRange     colonCFStringRef nameTextif ( eq.location == NSNotFound ) then exit fn = NULLnameText = fn StringSubstringToIndex( body, eq.location )if ( fn StringContainsString( nameText, @"(" ) ) then exit fn = NULLcolon = fn StringRangeOfString( nameText, @":" )if ( colon.location != NSNotFound ) then nameText = fn StringSubstringToIndex( nameText, colon.location )end fn = @[ fn StringByTrimmingCharactersInSet( nameText, fn CharacterSetWhitespaceSet ), fn StringByTrimmingCharactersInSet( fn StringSubstringFromIndex( body, eq.location + 1 ), fn CharacterSetWhitespaceSet ) ]// Name = Column(Type, ForeignKey('Parent.Id'), primary_key=True, nullable=False)void local fn ALSPyReadColumn( entity as CFMutableDictionaryRef, attributeName as CFStringRef, args as CFStringRef )CFMutableDictionaryRef attribute = fn MutableDictionaryWithDictionary( @{ @"name":attributeName } )CFArrayRef             parts = fn StringComponentsSeparatedByString( args, @"," )CFStringRef            first = fn StringByTrimmingCharactersInSet( fn ArrayObjectAtIndex( parts, 0 ), fn CharacterSetWhitespaceSet )CFStringRef            typeName, parentTableif ( fn StringHasPrefix( first, @"'" ) || fn StringHasPrefix( first, @"\"" ) )   // Column('db_name', Type, ...)first = @""if ( fn ArrayCount( parts ) > 1 ) then first = fn StringByTrimmingCharactersInSet( fn ArrayObjectAtIndex( parts, 1 ), fn CharacterSetWhitespaceSet )end iftypeName = fn ALSPyTypeName( fn ALSPyIdentifier( first ) )if ( typeName != NULL ) then MutableDictionarySetObjectForKey( attribute, typeName, @"type" )if ( fn StringContainsString( args, @"primary_key=True" ) )MutableDictionarySetObjectForKey( attribute, fn NumberWithBool( YES ), @"pk" )MutableArrayAddObject( (CFMutableArrayRef)fn DictionaryObjectForKey( entity, @"keys" ), attributeName )end ifif ( fn StringContainsString( args, @"nullable=False" ) ) then MutableDictionarySetObjectForKey( attribute, fn NumberWithBool( YES ), @"required" )MutableArrayAddObject( (CFMutableArrayRef)fn DictionaryObjectForKey( entity, @"attributes" ), attribute )parentTable = fn ALSPyFirstQuoted( fn ALSPyAfter( args, @"ForeignKey(" ) )if ( parentTable != NULL ) then MutableDictionarySetObjectForKey( (CFMutableDictionaryRef)fn DictionaryObjectForKey( entity, @"_fkTables" ), fn ALSPyDottedPart( parentTable, NO ), attributeName )end fn// Name : Mapped["Parent"] = relationship(...) or Name : Mapped[List["Child"]] = relationship(...)void local fn ALSPyReadRelationship( entity as CFMutableDictionaryRef, relationshipName as CFStringRef, body as CFStringRef, args as CFStringRef )CFMutableDictionaryRef relationship = fn MutableDictionaryWithDictionary( @{ @"name":relationshipName, @"direction":@"toone", @"resource":@"" } )CFStringRef            mapped = fn ALSPyAfter( body, @"Mapped[" )CFStringRef            fkText, resourceName, backName, columnTextCFArrayRef             columnsCFMutableArrayRef      fksCFRange                rif ( mapped != NULL )if ( fn StringHasPrefix( fn StringByTrimmingCharactersInSet( mapped, fn CharacterSetWhitespaceSet ), @"List[" ) ) then MutableDictionarySetObjectForKey( relationship, @"tomany", @"direction" )resourceName = fn ALSPyFirstQuoted( mapped )if ( resourceName != NULL ) then MutableDictionarySetObjectForKey( relationship, resourceName, @"resource" )end iffkText = fn ALSPyAfter( fn ALSPyAfter( args, @"foreign_keys" ), @"[" )   // foreign_keys='[Employee.WorksForDepartmentId]'if ( fkText != NULL )r = fn StringRangeOfString( fkText, @"]" )if ( r.location != NSNotFound ) then fkText = fn StringSubstringToIndex( fkText, r.location )fks = fn MutableArrayNewcolumns = fn StringComponentsSeparatedByString( fkText, @"," )for columnText in columnsif ( fn StringLength( fn ALSModelUnquote( columnText ) ) > 0 ) then MutableArrayAddObject( fks, fn ALSPyDottedPart( fn ALSModelUnquote( columnText ), YES ) )nextMutableDictionarySetObjectForKey( relationship, fks, @"fks" )end ifbackName = fn ALSPyFirstQuoted( fn ALSPyAfter( args, @"back_populates" ) )if ( backName != NULL ) then MutableDictionarySetObjectForKey( relationship, backName, @"_back" )MutableArrayAddObject( (CFMutableArrayRef)fn DictionaryObjectForKey( entity, @"relationships" ), relationship )end fn// ForeignKeyConstraint(['Country', 'City'], ['Location.country', 'Location.city']) - a composite keyvoid local fn ALSPyReadConstraint( entity as CFMutableDictionaryRef, body as CFStringRef )CFStringRef innerText = fn ALSPyAfter( body, @"ForeignKeyConstraint(" )CFRange     r = fn StringRangeOfString( innerText, @"]," )CFStringRef parentColumnif ( r.location == NSNotFound ) then exit fnparentColumn = fn ALSPyFirstQuoted( fn StringSubstringFromIndex( innerText, r.location + 2 ) )if ( parentColumn == NULL ) then exit fnMutableArrayAddObject( (CFMutableArrayRef)fn DictionaryObjectForKey( entity, @"_constraints" ), @{ @"columns":fn ALSPyQuotedItems( fn StringSubstringToIndex( innerText, r.location ) ), @"table":fn ALSPyDottedPart( parentColumn, NO ) } )end fn// one line of models.py (an early exit is "next line"); gALSModelEntity is the class being readvoid local fn ALSPyReadLine( model as CFMutableDictionaryRef, rawLine as CFStringRef )CFStringRef body = fn StringByTrimmingCharactersInSet( rawLine, fn CharacterSetWhitespaceSet )CFStringRef className, attributeName, value, quotedCFArrayRef  pairCFRange     rlong        cif ( fn StringLength( body ) == 0 || fn StringHasPrefix( body, @"#" ) ) then exit fnif ( fn StringHasPrefix( body, @"class " ) )                    // class Order(Base):gALSModelEntity = NULLr = fn StringRangeOfString( body, @"(" )if ( r.location == NSNotFound || fn StringContainsString( body, @"(Base" ) == NO ) then exit fnclassName = fn StringByTrimmingCharactersInSet( fn StringSubstringWithRange( body, fn CFRangeMake( 6, r.location - 6 ) ), fn CharacterSetWhitespaceSet )gALSModelEntity = fn MutableDictionaryWithDictionary( @{ @"attributes":fn MutableArrayNew, @"relationships":fn MutableArrayNew, @"keys":fn MutableArrayNew, @"type":className, @"resource":className, @"table":className, @"_fkTables":fn MutableDictionaryNew, @"_constraints":fn MutableArrayNew } )MutableDictionarySetObjectForKey( model, gALSModelEntity, className )exit fnend ifc = fn StringCharacterAtIndex( rawLine, 0 )if ( c != 32 && c != 9 )                                        // back at the left margin: the class has endedgALSModelEntity = NULLexit fnend ifif ( gALSModelEntity == NULL ) then exit fnif ( fn StringHasPrefix( body, @"ForeignKeyConstraint(" ) )fn ALSPyReadConstraint( gALSModelEntity, body )exit fnend ifpair = fn ALSPyAssignment( body )if ( pair == NULL ) then exit fnattributeName = fn ArrayObjectAtIndex( pair, 0 )value         = fn ArrayObjectAtIndex( pair, 1 )if ( fn StringIsEqual( attributeName, @"__tablename__" ) || fn StringIsEqual( attributeName, @"_s_collection_name" ) )quoted = fn ALSPyFirstQuoted( value )if ( quoted == NULL ) then exit fnif ( fn StringIsEqual( attributeName, @"__tablename__" ) )MutableDictionarySetObjectForKey( gALSModelEntity, quoted, @"table" )elseMutableDictionarySetObjectForKey( gALSModelEntity, quoted, @"resource" )end ifexit fnend ifif ( fn StringHasPrefix( value, @"relationship(" ) )fn ALSPyReadRelationship( gALSModelEntity, attributeName, body, fn StringSubstringFromIndex( value, 13 ) )exit fnend ifif ( fn StringHasPrefix( value, @"Column(" ) ) then fn ALSPyReadColumn( gALSModelEntity, attributeName, fn StringSubstringFromIndex( value, 7 ) )end fn// the key columns of the relationships that do not name them, then the model keyed by resource// (as admin.yaml keys it), each relationship naming its resourcelocal fn ALSPyResolve( model as CFMutableDictionaryRef ) as CFMutableDictionaryRefCFMutableDictionaryRef byResource = fn MutableDictionaryNewCFArrayRef             classNames = fn DictionaryAllKeys( model )CFArrayRef             relationships, childRelationships, constraints, columnsCFDictionaryRef        entity, parentEntity, childEntity, relationship, childRelationship, fkTables, constraintCFStringRef            className, parentTable, fkColumn, backNameCFMutableArrayRef      fkColumnsCFArrayRef             fksfor className in classNames                                     // to one: the foreign keys to the parent's tableentity        = fn DictionaryObjectForKey( model, className )fkTables      = fn DictionaryObjectForKey( entity, @"_fkTables" )constraints   = fn DictionaryObjectForKey( entity, @"_constraints" )relationships = fn DictionaryObjectForKey( entity, @"relationships" )columns       = fn DictionaryAllKeys( fkTables )for relationship in relationshipsif ( fn DictionaryObjectForKey( relationship, @"fks" ) == NULL && fn StringIsEqual( fn DictionaryObjectForKey( relationship, @"direction" ), @"toone" ) )fkColumns = fn MutableArrayNewparentEntity = fn DictionaryObjectForKey( model, fn DictionaryObjectForKey( relationship, @"resource" ) )parentTable = NULLif ( parentEntity != NULL ) then parentTable = fn DictionaryObjectForKey( parentEntity, @"table" )if ( parentTable != NULL )for fkColumn in columnsif ( fn StringIsEqual( fn DictionaryObjectForKey( fkTables, fkColumn ), parentTable ) ) then MutableArrayAddObject( fkColumns, fkColumn )nextif ( fn ArrayCount( fkColumns ) == 0 )                             // a composite key (Order -> Location)for constraint in constraintsif ( fn ArrayCount( fkColumns ) == 0 && fn StringIsEqual( fn DictionaryObjectForKey( constraint, @"table" ), parentTable ) ) then MutableArrayAddObjectsFromArray( fkColumns, fn DictionaryObjectForKey( constraint, @"columns" ) )nextend ifend ifMutableDictionarySetObjectForKey( (CFMutableDictionaryRef)relationship, fkColumns, @"fks" )end ifnextnextfor className in classNames                                     // to many: the child's to-one that points backentity        = fn DictionaryObjectForKey( model, className )relationships = fn DictionaryObjectForKey( entity, @"relationships" )for relationship in relationshipsif ( fn DictionaryObjectForKey( relationship, @"fks" ) == NULL )fks = @[]childEntity = fn DictionaryObjectForKey( model, fn DictionaryObjectForKey( relationship, @"resource" ) )if ( childEntity != NULL )childRelationships = fn DictionaryObjectForKey( childEntity, @"relationships" )for childRelationship in childRelationships// the name alone is not enough: Customer, Employee and Location all have an OrderListbackName = fn DictionaryObjectForKey( childRelationship, @"_back" )if ( backName != NULL )if ( fn StringIsEqual( fn DictionaryObjectForKey( childRelationship, @"direction" ), @"toone" ) && fn StringIsEqual( backName, fn DictionaryObjectForKey( relationship, @"name" ) ) && fn StringIsEqual( fn DictionaryObjectForKey( childRelationship, @"resource" ), className ) ) then fks = fn DictionaryObjectForKey( childRelationship, @"fks" )end ifnextend ifMutableDictionarySetObjectForKey( (CFMutableDictionaryRef)relationship, fks, @"fks" )end ifnextnextfor className in classNames                                     // the working keys off; class names -> resourcesentity = fn DictionaryObjectForKey( model, className )relationships = fn DictionaryObjectForKey( entity, @"relationships" )for relationship in relationshipsparentEntity = fn DictionaryObjectForKey( model, fn DictionaryObjectForKey( relationship, @"resource" ) )if ( parentEntity != NULL ) then MutableDictionarySetObjectForKey( (CFMutableDictionaryRef)relationship, fn DictionaryObjectForKey( parentEntity, @"resource" ), @"resource" )nextnextfor className in classNamesentity = fn DictionaryObjectForKey( model, className )relationships = fn DictionaryObjectForKey( entity, @"relationships" )for relationship in relationshipsMutableDictionaryRemoveObjectForKey( (CFMutableDictionaryRef)relationship, @"_back" )nextMutableDictionaryRemoveObjectForKey( (CFMutableDictionaryRef)entity, @"_fkTables" )MutableDictionaryRemoveObjectForKey( (CFMutableDictionaryRef)entity, @"_constraints" )MutableDictionarySetObjectForKey( byResource, entity, fn DictionaryObjectForKey( entity, @"resource" ) )nextend fn = byResource// the whole of database/models.py -> the model (empty when the text has no class X(Base))local fn ALSModelFromModelsPy( pyText as CFStringRef ) as CFMutableDictionaryRefCFMutableDictionaryRef model = fn MutableDictionaryNewCFArrayRef             linesCFStringRef            rawLineif ( pyText == NULL ) then exit fn = modellines = fn StringComponentsSeparatedByString( fn StringByReplacingOccurrencesOfString( pyText, @"\r", @"" ), @"\n" )gALSModelEntity = NULLfor rawLine in linesfn ALSPyReadLine( model, rawLine )nextgALSModelEntity = NULLend fn = fn ALSPyResolve( model )// the text of a model file -> the model: database/models.py (current ALS) or a YAML model file,// told apart by what is in it, so a dropped or downloaded file works whatever its namelocal fn ALSModelFromText( modelText as CFStringRef ) as CFMutableDictionaryRefif ( modelText == NULL ) then exit fn = fn MutableDictionaryNewif ( fn StringContainsString( modelText, @"(Base)" ) ) then exit fn = fn ALSModelFromModelsPy( modelText )end fn = fn ALSModelFromYAML( modelText )// a model file on disk (database/models.py, app_model.yaml or admin.yaml) -> the model; NULL when it cannot be readlocal fn ALSModelFromURL( url as CFURLRef ) as CFMutableDictionaryRefCFStringRef modelText = NULLif ( url != NULL ) then modelText = fn StringWithContentsOfURL( url, NSUTF8StringEncoding, NULL )if ( modelText == NULL ) then exit fn = NULLend fn = fn ALSModelFromText( modelText )// the to-one relationship from child to parent through the key column fk (NULL when the model// has none): a child can have several to the same parent (Employee: WorksForDepartment,// OnLoanDepartment), so the name always comes from the modellocal fn ALSModelRelationship( model as CFDictionaryRef, child as CFStringRef, parent as CFStringRef, fk as CFStringRef ) as CFStringRefCFDictionaryRef entity, relationshipCFArrayRef      relationships, fksif ( model == NULL ) then exit fn = NULLentity = fn DictionaryObjectForKey( model, child )if ( entity == NULL ) then exit fn = NULLrelationships = fn DictionaryObjectForKey( entity, @"relationships" )if ( relationships == NULL ) then exit fn = NULLfor relationship in relationshipsif ( fn StringIsEqual( fn DictionaryObjectForKey( relationship, @"direction" ), @"toone" ) && fn StringIsEqual( fn DictionaryObjectForKey( relationship, @"resource" ), parent ) )fks = fn DictionaryObjectForKey( relationship, @"fks" )if ( fks != NULL ) then if ( fn ArrayContainsObject( fks, fk ) ) then exit fn = fn DictionaryObjectForKey( relationship, @"name" )end ifnextend fn = NULL