/* *   I M A G E R Y    B U S I N E S S     S Y S T E M S,   L L C * *   ALS Model.incl - Enterprise: the model of an API Logic Server project, from its model file * *   The relationships (names, directions, key columns), every attribute, the primary keys and *   the column that names a record - what the JSON:API side of the SQL Generator needs to turn a *   join into include=<relationship>, and what a lookup shows.  ALS's /metadata endpoint leaves *   the relationships out on purpose, so they come from the project's model file: * *       app_model.yaml (ui/app/, ALS 17.3 and earlier)   admin.yaml (ui/admin/, every project) *       entities:                                        resources:                  indent 0 *         Student:                                         Customer:                 2 *           columns:                                         attributes:             4 -> attributes *           primary_key:                                     (none)                  4 -> keys *           - id                                                                     4 *           tab_groups:                                      tab_groups:             4 -> relationships *           favorite: name                                   user_key: CompanyName   4 -> display *           - name: student_id   (a list item)                                       4 *             type: INTEGER      (its other keys)                                    6 *             fks:               (a relationship's key columns follow ...)           6 *             - student_id       (... one per line)                                  6 * *   Read line by line by indentation - the design of the C++ Studio's Model::fromAppModelYaml - *   not with a general YAML parser.  tools/jsonapi_reference.py (read_model_yaml) is the *   reference, checked against PyYAML on a live server's admin.yaml and on an app_model.yaml. * *   ALSModelFromYAML( text ) -> *       { "Customer": { "attributes":    [ { "name":"CompanyName", "label":..., "required":... } ], *                       "relationships": [ { "name":"OrderList", "direction":"tomany", *                                            "resource":"Order", "fks":[ "CustomerId" ] } ], *                       "keys": [ "Id" ], "display": "CompanyName", "type": "Customer" } } * *   MIT License. Copyright (c) 2026 Imagery Business Systems, LLC. */begin globalsCFMutableDictionaryRef gALSModelEntity      // the entity being readCFStringRef            gALSModelSection     // "attributes", "relationships", "keys" or NULLCFMutableDictionaryRef gALSModelItem        // the attribute or relationship being readBOOL                   gALSModelInFks       // the lines now are a relationship's key columnsBOOL                   gALSModelInside      // under entities: / resources:end globals// 'text', "text" -> text; leading and trailing spaces offlocal fn ALSModelUnquote( textValue as CFStringRef ) as CFStringRefCFStringRef t = fn StringByTrimmingCharactersInSet( textValue, fn CharacterSetWhitespaceSet )CFStringRef first, lastif ( fn StringLength( t ) < 2 ) then exit fn = tfirst = fn StringSubstringToIndex( t, 1 )last  = fn StringSubstringFromIndex( t, fn StringLength( t ) - 1 )if ( fn StringIsEqual( first, last ) && ( fn StringIsEqual( first, @"'" ) || fn StringIsEqual( first, @"\"" ) ) ) then exit fn = fn StringSubstringWithRange( t, fn CFRangeMake( 1, fn StringLength( t ) - 2 ) )end fn = t// how many spaces a line starts withlocal fn ALSModelIndent( textLine as CFStringRef ) as longlong n = 0while ( n < fn StringLength( textLine ) )if ( fn StringCharacterAtIndex( textLine, n ) != 32 ) then exit fn = nn++wendend fn = n// "key: value" -> @[ key, value ] (value "" when there is none)local fn ALSModelKeyValue( textPart as CFStringRef ) as CFArrayRefCFRange colon = fn StringRangeOfString( textPart, @":" )if ( colon.location == NSNotFound ) then exit fn = @[ fn ALSModelUnquote( textPart ), @"" ]end fn = @[ fn ALSModelUnquote( fn StringSubstringToIndex( textPart, colon.location ) ), fn ALSModelUnquote( fn StringSubstringFromIndex( textPart, colon.location + 1 ) ) ]// a section's key -> where its items go in the model ("columns" and "attributes" are the same)local fn ALSModelSectionFor( key as CFStringRef ) as CFStringRefif ( fn StringIsEqual( key, @"columns" ) || fn StringIsEqual( key, @"attributes" ) ) then exit fn = @"attributes"if ( fn StringIsEqual( key, @"tab_groups" ) ) then exit fn = @"relationships"if ( fn StringIsEqual( key, @"primary_key" ) ) then exit fn = @"keys"end fn = NULL// a value as the model keeps it: true / false as numbers, everything else as textlocal fn ALSModelValue( textValue as CFStringRef ) as CFTypeRefif ( fn StringIsEqual( textValue, @"true" ) ) then exit fn = fn NumberWithBool( YES )if ( fn StringIsEqual( textValue, @"false" ) ) then exit fn = fn NumberWithBool( NO )end fn = textValue// one line of the model file (an early exit is "next line")void local fn ALSModelReadLine( model as CFMutableDictionaryRef, rawLine as CFStringRef )CFStringRef            body = fn StringByTrimmingCharactersInSet( rawLine, fn CharacterSetWhitespaceSet )CFStringRef            textPart, key, value, entityNameCFArrayRef             pairCFMutableArrayRef      listlong                   indBOOL                   isItemif ( fn StringLength( body ) == 0 || fn StringHasPrefix( body, @"#" ) ) then exit fnind = fn ALSModelIndent( rawLine )if ( ind == 0 )                                             // entities: / resources: / anything elsegALSModelInside = ( fn StringIsEqual( body, @"entities:" ) || fn StringIsEqual( body, @"resources:" ) )gALSModelEntity = NULLexit fnend ifif ( gALSModelInside == NO ) then exit fnif ( ind == 2 && fn StringHasSuffix( body, @":" ) )         // an entityentityName = fn StringSubstringToIndex( body, fn StringLength( body ) - 1 )gALSModelEntity = (CFMutableDictionaryRef)fn DictionaryObjectForKey( model, entityName )if ( gALSModelEntity == NULL )gALSModelEntity = fn MutableDictionaryWithDictionary( @{ @"attributes":fn MutableArrayNew, @"relationships":fn MutableArrayNew, @"keys":fn MutableArrayNew } )MutableDictionarySetObjectForKey( model, gALSModelEntity, entityName )end ifgALSModelSection = NULLgALSModelItem = NULLexit fnend ifif ( gALSModelEntity == NULL ) then exit fnisItem = fn StringHasPrefix( body, @"- " )textPart = bodyif ( isItem ) then textPart = fn StringSubstringFromIndex( body, 2 )if ( ind == 4 && isItem == NO )                             // a section, or one of the entity's valuespair  = fn ALSModelKeyValue( textPart )key   = fn ArrayObjectAtIndex( pair, 0 )value = fn ArrayObjectAtIndex( pair, 1 )gALSModelSection = NULLif ( fn StringLength( value ) == 0 ) then gALSModelSection = fn ALSModelSectionFor( key )if ( fn StringIsEqual( key, @"user_key" ) || fn StringIsEqual( key, @"favorite" ) ) then MutableDictionarySetObjectForKey( gALSModelEntity, value, @"display" )if ( fn StringIsEqual( key, @"type" ) ) then MutableDictionarySetObjectForKey( gALSModelEntity, value, @"type" )gALSModelItem = NULLgALSModelInFks = NOexit fnend ifif ( gALSModelSection == NULL ) then exit fnif ( fn StringIsEqual( gALSModelSection, @"keys" ) )        // primary_key: one column per lineif ( ind == 4 && isItem ) then MutableArrayAddObject( (CFMutableArrayRef)fn DictionaryObjectForKey( gALSModelEntity, @"keys" ), fn ALSModelUnquote( textPart ) )exit fnend ifif ( ind == 4 && isItem )                                   // a new attribute or relationshipgALSModelItem = fn MutableDictionaryNewMutableArrayAddObject( (CFMutableArrayRef)fn DictionaryObjectForKey( gALSModelEntity, gALSModelSection ), gALSModelItem )gALSModelInFks = NOend ifif ( gALSModelItem == NULL ) then exit fnif ( ind == 6 && isItem && gALSModelInFks )                 // one of a relationship's key columnsMutableArrayAddObject( (CFMutableArrayRef)fn DictionaryObjectForKey( gALSModelItem, @"fks" ), fn ALSModelUnquote( textPart ) )exit fnend ifif ( ( ind == 4 && isItem ) || ( ind == 6 && isItem == NO ) )   // key: value of the itempair  = fn ALSModelKeyValue( textPart )key   = fn ArrayObjectAtIndex( pair, 0 )value = fn ArrayObjectAtIndex( pair, 1 )if ( fn StringIsEqual( key, @"fks" ) && fn StringLength( value ) == 0 )list = fn MutableArrayNewMutableDictionarySetObjectForKey( gALSModelItem, list, @"fks" )gALSModelInFks = YESelsegALSModelInFks = NOMutableDictionarySetObjectForKey( gALSModelItem, fn ALSModelValue( value ), key )end ifend ifend fn// the whole model file -> the model (empty when the text has no entities: or resources:)local fn ALSModelFromYAML( yamlText as CFStringRef ) as CFMutableDictionaryRefCFMutableDictionaryRef model = fn MutableDictionaryNewCFArrayRef             linesCFStringRef            rawLineif ( yamlText == NULL ) then exit fn = modellines = fn StringComponentsSeparatedByString( fn StringByReplacingOccurrencesOfString( yamlText, @"\r", @"" ), @"\n" )gALSModelEntity  = NULLgALSModelSection = NULLgALSModelItem    = NULLgALSModelInFks   = NOgALSModelInside  = NOfor rawLine in linesfn ALSModelReadLine( model, rawLine )nextend fn = model// a model file on disk (app_model.yaml or admin.yaml) -> the model; NULL when it cannot be readlocal fn ALSModelFromURL( url as CFURLRef ) as CFMutableDictionaryRefCFStringRef yamlText = NULLif ( url != NULL ) then yamlText = fn StringWithContentsOfURL( url, NSUTF8StringEncoding, NULL )if ( yamlText == NULL ) then exit fn = NULLend fn = fn ALSModelFromYAML( yamlText )// the to-one relationship from child to parent through the key column fk (NULL when the model// has none): a child can have several to the same parent (Employee: WorksForDepartment,// OnLoanDepartment), so the name always comes from the modellocal fn ALSModelRelationship( model as CFDictionaryRef, child as CFStringRef, parent as CFStringRef, fk as CFStringRef ) as CFStringRefCFDictionaryRef entity, relationshipCFArrayRef      relationships, fksif ( model == NULL ) then exit fn = NULLentity = fn DictionaryObjectForKey( model, child )if ( entity == NULL ) then exit fn = NULLrelationships = fn DictionaryObjectForKey( entity, @"relationships" )if ( relationships == NULL ) then exit fn = NULLfor relationship in relationshipsif ( fn StringIsEqual( fn DictionaryObjectForKey( relationship, @"direction" ), @"toone" ) && fn StringIsEqual( fn DictionaryObjectForKey( relationship, @"resource" ), parent ) )fks = fn DictionaryObjectForKey( relationship, @"fks" )if ( fks != NULL ) then if ( fn ArrayContainsObject( fks, fk ) ) then exit fn = fn DictionaryObjectForKey( relationship, @"name" )end ifnextend fn = NULL