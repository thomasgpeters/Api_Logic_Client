/* *   DataObject_JSONAPI.incl - the SQL Generator's JSON:API side (Enterprise edition) * *   The same statement dictionaries as the SQL side - InitQueryDictionary, AddTableToQuery, *   AddColumnToQuery, AddAssociationToQuery, AddFilterToQuery, AddOrderToQuery, and the INSERT / *   UPDATE / DELETE dictionaries - become a request for API Logic Server instead of SQL: * *       GenerateJSONAPISelect( query )            GET  /api/Customer?filter=[...]&sort=...&include=... *       GenerateJSONAPIInsert( statement )        POST /api/Customer  {"data":{"type","attributes"}} *       GenerateJSONAPIInsertRows( statement )    one POST per row (ALS has no batch call) *       GenerateJSONAPIUpdate( statement )        PATCH  /api/Customer/<id>  (S_CheckSum: a column value) *       GenerateJSONAPIDelete( statement )        DELETE /api/Customer/<id> *   -> a request: { "method", "path", "body" (a dictionary, or none), and for a SELECT "resource", *      "primary" (the main alias) and "joins" (alias -> { "relationship", "resource" }) }. *   Paging is the sender's: JSONAPIPagePath adds page[limit] and page[offset]. * *       JSONAPIRowsFromAnswer( query, request, records, included ) *   turns the answer's records into rows keyed by the column aliases - what a SQL SELECT gives - *   plus "id" and "S_CheckSum" of the main record (for an update).  A row whose joined parent is *   missing is dropped: the SQL side joins inner. * *   What ALS cannot express is refused - NULL, and JSONAPILastError says why: OR between two *   columns (OR between values of one column becomes "in"), a filter or a sort on a joined parent, *   a join the model has no relationship for, an UPDATE or DELETE without one "=" filter on the key. * *   Names are RESOURCE names (the ALS model's), not table names.  The model (ALS Model.incl) gives *   the relationships: JSONAPISetModel( fn ALSModelFromYAML( text ) ).  The contract this follows *   is docs/design/ALS Contract.md; tools/jsonapi_reference.py is the reference, run against a *   live server: the same statements give the same rows as SQL on the server's own database. * *   Needs DataObject.glbl (operators), DataObject_Super.incl (the builders), ALS Model.incl. *   MIT License. Copyright (c) 2026 Imagery Business Systems, LLC. */begin globalsCFDictionaryRef gJSONAPIModel           // entity -> { relationships, ... } (ALS Model.incl)CFStringRef     gJSONAPILastError       // why the last Generate... returned NULLend globalsvoid local fn JSONAPISetModel( model as CFDictionaryRef )gJSONAPIModel = modelend fnlocal fn JSONAPILastError as CFStringRefend fn = gJSONAPILastError// JSON null (CF collections cannot hold NULL)local fn JSONAPINull as CFTypeRefcln return (__bridge CFTypeRef)[NSNull null];end fn = NULL// text for a URL's query or path: only letters, digits and - . _ ~ stay as they arelocal fn JSONAPIEncode( textValue as CFStringRef ) as CFStringRefend fn = fn StringByAddingPercentEncodingWithAllowedCharacters( textValue, fn CharacterSetWithCharactersInString( @"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-._~" ) )// a JSON value as compact textlocal fn JSONAPIText( jsonObject as CFTypeRef ) as CFStringRefCFDataRef jsonData = fn JSONSerializationDataWithJSONObject( jsonObject, 0, NULL )if ( jsonData == NULL ) then exit fn = NULLend fn = fn StringWithData( jsonData, NSUTF8StringEncoding )// "p.surName" -> "surName"local fn JSONAPIColumnName( columnName as CFStringRef ) as CFStringRefCFRange dot = fn StringRangeOfString( columnName, @"." )if ( dot.location == NSNotFound ) then exit fn = columnNameend fn = fn StringSubstringFromIndex( columnName, dot.location + 1 )// "p.surName" -> "p";  "surName" -> defaultAliaslocal fn JSONAPIColumnAlias( columnName as CFStringRef, defaultAlias as CFStringRef ) as CFStringRefCFRange dot = fn StringRangeOfString( columnName, @"." )if ( dot.location == NSNotFound ) then exit fn = defaultAliasend fn = fn StringSubstringToIndex( columnName, dot.location )// an alias that names the main resource (none, empty, or the main one)local fn JSONAPIIsPrimary( tableAlias as CFStringRef, primary as CFStringRef ) as BOOLif ( tableAlias == NULL ) then exit fn = YESif ( fn StringLength( tableAlias ) == 0 ) then exit fn = YESend fn = fn StringIsEqual( tableAlias, primary )// the operator as ALS's filter list names itlocal fn JSONAPIOperator( op as long ) as CFStringRefselect ( op )case _isNotEqual, _isNotNull  : exit fn = @"ne"case _isLessThan              : exit fn = @"lt"case _isGreaterThan           : exit fn = @"gt"case _isLessThanOrEqual       : exit fn = @"le"case _isGreaterThanOrEqual    : exit fn = @"ge"case _isLike                  : exit fn = @"like"case _isNotLike               : exit fn = @"notilike"case _isIn                    : exit fn = @"in"case _isNotIn                 : exit fn = @"notin"end selectend fn = @"eq"                                               // _isEqual, _isNull (eq null is IS NULL)// a refusal: NULL, and the reason for JSONAPILastErrorlocal fn JSONAPIRefuse( reason as CFStringRef ) as CFDictionaryRefgJSONAPILastError = reasonend fn = NULL/* *   The filter list ALS reads: [ {"name", "op", "val"}, ... ], joined with AND.  An OR filter *   joins the one before it only as "in" - both "=" on the same column.  NULL: refused. */local fn JSONAPIFilterList( filters as CFArrayRef, primary as CFStringRef ) as CFMutableArrayRefCFMutableArrayRef      out = fn MutableArrayNewCFMutableDictionaryRef entry, previousCFMutableArrayRef      valuesCFDictionaryRef        fCFTypeRef              valuelong                   opif ( filters == NULL ) then exit fn = outfor f in filtersif ( fn JSONAPIIsPrimary( fn DictionaryObjectForKey( f, @"tablealias" ), primary ) == NO )gJSONAPILastError = fn StringWithFormat( @"ALS filters only the main resource: %@.%@", fn DictionaryObjectForKey( f, @"tablealias" ), fn DictionaryObjectForKey( f, @"columnname" ) )exit fn = NULLend ifop = fn NumberIntegerValue( fn DictionaryObjectForKey( f, @"operator" ) )value = fn DictionaryObjectForKey( f, @"value" )if ( value == NULL || op == _isNull || op == _isNotNull ) then value = fn JSONAPINullif ( fn NumberIntegerValue( fn DictionaryObjectForKey( f, @"logic" ) ) == _or )previous = NULLif ( fn ArrayCount( out ) > 0 ) then previous = (CFMutableDictionaryRef)fn ArrayLastObject( out )if ( previous == NULL || op != _isEqual ) then exit fn = (CFMutableArrayRef)fn JSONAPIRefuse( @"ALS has no OR: only OR between values of one column (it becomes \"in\")" )if ( fn StringIsEqual( fn DictionaryObjectForKey( previous, @"name" ), fn DictionaryObjectForKey( f, @"columnname" ) ) == NO ) then exit fn = (CFMutableArrayRef)fn JSONAPIRefuse( @"ALS has no OR: only OR between values of one column (it becomes \"in\")" )if ( fn StringIsEqual( fn DictionaryObjectForKey( previous, @"op" ), @"eq" ) )values = fn MutableArrayWithObject( fn DictionaryObjectForKey( previous, @"val" ) )MutableDictionarySetObjectForKey( previous, values, @"val" )MutableDictionarySetObjectForKey( previous, @"in", @"op" )end ifif ( fn StringIsEqual( fn DictionaryObjectForKey( previous, @"op" ), @"in" ) == NO ) then exit fn = (CFMutableArrayRef)fn JSONAPIRefuse( @"ALS has no OR: only OR between values of one column (it becomes \"in\")" )MutableArrayAddObject( (CFMutableArrayRef)fn DictionaryObjectForKey( previous, @"val" ), value )elseif ( ( op == _isIn || op == _isNotIn ) && fn ObjectIsKindOfClass( (ObjectRef)value, fn ClassFromString( @"NSArray" ) ) == NO ) then value = @[ value ]entry = fn MutableDictionaryNewMutableDictionarySetObjectForKey( entry, fn DictionaryObjectForKey( f, @"columnname" ), @"name" )MutableDictionarySetObjectForKey( entry, fn JSONAPIOperator( op ), @"op" )MutableDictionarySetObjectForKey( entry, value, @"val" )MutableArrayAddObject( out, entry )end ifnextend fn = out/* *   SELECT -> GET.  The first table is the main resource; every other table must be its *   parent, joined main.fk = parent.key (or the other way round), and becomes include=<the *   model's relationship>. */local fn GenerateJSONAPISelect( query as CFDictionaryRef ) as CFDictionaryRefCFArrayRef             tables = fn DictionaryObjectForKey( query, @"selecttables" )CFArrayRef             associations = fn DictionaryObjectForKey( query, @"associations" )CFArrayRef             orders = fn DictionaryObjectForKey( query, @"orderby" )CFMutableDictionaryRef byAlias = fn MutableDictionaryNewCFMutableDictionaryRef joins = fn MutableDictionaryNewCFMutableArrayRef      params = fn MutableArrayNewCFMutableArrayRef      sorts = fn MutableArrayNewCFMutableArrayRef      includes = fn MutableArrayNewCFMutableArrayRef      filterListCFDictionaryRef        table, association, orderCFStringRef            primary, resource, parentAlias, fk, relationship, pathgJSONAPILastError = NULLif ( tables == NULL ) then exit fn = fn JSONAPIRefuse( @"the query has no table" )if ( fn ArrayCount( tables ) == 0 ) then exit fn = fn JSONAPIRefuse( @"the query has no table" )primary  = fn DictionaryObjectForKey( fn ArrayFirstObject( tables ), @"aliasname" )resource = fn DictionaryObjectForKey( fn ArrayFirstObject( tables ), @"tablename" )for table in tablesMutableDictionarySetObjectForKey( byAlias, fn DictionaryObjectForKey( table, @"tablename" ), fn DictionaryObjectForKey( table, @"aliasname" ) )next// joins -> include=<relationship>if ( associations != NULL )for association in associationsparentAlias = NULLfk = NULLif ( fn StringIsEqual( fn DictionaryObjectForKey( association, @"lefttablealias" ), primary ) && fn StringIsEqual( fn DictionaryObjectForKey( association, @"righttablealias" ), primary ) == NO )parentAlias = fn DictionaryObjectForKey( association, @"righttablealias" )fk = fn DictionaryObjectForKey( association, @"leftcolumnname" )end ifif ( fn StringIsEqual( fn DictionaryObjectForKey( association, @"righttablealias" ), primary ) && fn StringIsEqual( fn DictionaryObjectForKey( association, @"lefttablealias" ), primary ) == NO )parentAlias = fn DictionaryObjectForKey( association, @"lefttablealias" )fk = fn DictionaryObjectForKey( association, @"rightcolumnname" )end ifif ( parentAlias == NULL ) then exit fn = fn JSONAPIRefuse( @"a join must link the main resource to a parent" )relationship = fn ALSModelRelationship( gJSONAPIModel, resource, fn DictionaryObjectForKey( byAlias, parentAlias ), fk )if ( relationship == NULL ) then exit fn = fn JSONAPIRefuse( fn StringWithFormat( @"the model has no relationship from %@ to %@ through %@", resource, fn DictionaryObjectForKey( byAlias, parentAlias ), fk ) )MutableDictionarySetObjectForKey( joins, @{ @"relationship":relationship, @"resource":fn DictionaryObjectForKey( byAlias, parentAlias ) }, parentAlias )if ( fn ArrayContainsObject( includes, relationship ) == NO ) then MutableArrayAddObject( includes, relationship )nextend ifif ( fn DictionaryCount( joins ) != fn ArrayCount( tables ) - 1 ) then exit fn = fn JSONAPIRefuse( @"every other table needs a join to the main resource" )// filters -> filter=[...]filterList = fn JSONAPIFilterList( fn DictionaryObjectForKey( query, @"filter" ), primary )if ( filterList == NULL ) then exit fn = NULL                // refused: the reason is setif ( fn ArrayCount( filterList ) > 0 ) then MutableArrayAddObject( params, fn StringWithFormat( @"filter=%@", fn JSONAPIEncode( fn JSONAPIText( filterList ) ) ) )// ORDER BY -> sort=a,-bif ( orders != NULL )for order in ordersif ( fn JSONAPIIsPrimary( fn DictionaryObjectForKey( order, @"tablealias" ), primary ) == NO ) then exit fn = fn JSONAPIRefuse( @"ALS sorts only by the main resource" )if ( fn NumberIntegerValue( fn DictionaryObjectForKey( order, @"descending" ) ) != 0 ) then MutableArrayAddObject( sorts, fn StringWithFormat( @"-%@", fn DictionaryObjectForKey( order, @"columnname" ) ) ) else MutableArrayAddObject( sorts, fn DictionaryObjectForKey( order, @"columnname" ) )nextend ifif ( fn ArrayCount( sorts ) > 0 ) then MutableArrayAddObject( params, fn StringWithFormat( @"sort=%@", fn ArrayComponentsJoinedByString( sorts, @"," ) ) )if ( fn ArrayCount( includes ) > 0 ) then MutableArrayAddObject( params, fn StringWithFormat( @"include=%@", fn ArrayComponentsJoinedByString( fn ArraySortedArrayUsingSelector( includes, @"compare:" ), @"," ) ) )path = fn StringWithFormat( @"/api/%@", resource )if ( fn ArrayCount( params ) > 0 ) then path = fn StringWithFormat( @"%@?%@", path, fn ArrayComponentsJoinedByString( params, @"&" ) )end fn = @{ @"method":@"GET", @"path":path, @"resource":resource, @"primary":primary, @"joins":joins }// a GET's path with one page: page[limit] and page[offset] (page on until meta.total: ALS's// links.next comes one page short - ALS Contract.md)local fn JSONAPIPagePath( request as CFDictionaryRef, limit as long, offset as long ) as CFStringRefCFStringRef path = fn DictionaryObjectForKey( request, @"path" )CFStringRef separator = @"?"if ( fn StringContainsString( path, @"?" ) ) then separator = @"&"end fn = fn StringWithFormat( @"%@%@page%%5Blimit%%5D=%ld&page%%5Boffset%%5D=%ld", path, separator, limit, offset )// a value as a row holds it: NSNull for nonelocal fn JSONAPIRowValue( attributes as CFDictionaryRef, column as CFStringRef ) as CFTypeRefCFTypeRef value = NULLif ( attributes != NULL ) then value = fn DictionaryObjectForKey( attributes, column )if ( value == NULL ) then value = fn JSONAPINullend fn = value/* *   The answer's records -> rows keyed by the column aliases, plus "id" and "S_CheckSum" of the *   main record.  included: the parents the request's joins asked for (from every page). */local fn JSONAPIRowsFromAnswer( query as CFDictionaryRef, request as CFDictionaryRef, records as CFArrayRef, included as CFArrayRef ) as CFMutableArrayRefCFMutableArrayRef      rows = fn MutableArrayNewCFMutableDictionaryRef index = fn MutableDictionaryNewCFMutableDictionaryRef parents, rowCFDictionaryRef        joins = fn DictionaryObjectForKey( request, @"joins" )CFArrayRef             columns = fn DictionaryObjectForKey( query, @"selectcols" )CFArrayRef             aliasesCFDictionaryRef        jsonRecord, item, relationships, link, attributes, join, columnCFTypeRef              linkDataCFStringRef            primary = fn DictionaryObjectForKey( request, @"primary" )CFStringRef            alias, columnAlias, columnName, recordIDBOOL                   keepif ( records == NULL ) then exit fn = rowsif ( included != NULL )for item in includedMutableDictionarySetObjectForKey( index, fn DictionaryObjectForKey( item, @"attributes" ), fn StringWithFormat( @"%@|%@", fn DictionaryObjectForKey( item, @"type" ), fn DictionaryObjectForKey( item, @"id" ) ) )nextend ifaliases = fn DictionaryAllKeys( joins )for jsonRecord in recordsparents = fn MutableDictionaryNewkeep = YESrelationships = fn DictionaryObjectForKey( jsonRecord, @"relationships" )for alias in aliasesjoin = fn DictionaryObjectForKey( joins, alias )attributes = NULLlink = NULLif ( relationships != NULL ) then link = fn DictionaryObjectForKey( relationships, fn DictionaryObjectForKey( join, @"relationship" ) )if ( link != NULL )linkData = fn DictionaryObjectForKey( link, @"data" )if ( linkData != NULL ) then if ( fn ObjectIsKindOfClass( (ObjectRef)linkData, fn ClassFromString( @"NSDictionary" ) ) ) then attributes = fn DictionaryObjectForKey( index, fn StringWithFormat( @"%@|%@", fn DictionaryObjectForKey( linkData, @"type" ), fn DictionaryObjectForKey( linkData, @"id" ) ) )end ifif ( attributes == NULL ) then keep = NO else MutableDictionarySetObjectForKey( parents, attributes, alias )nextif ( keep )row = fn MutableDictionaryNewattributes = fn DictionaryObjectForKey( jsonRecord, @"attributes" )recordID = fn StringWithFormat( @"%@", fn DictionaryObjectForKey( jsonRecord, @"id" ) )if ( columns == NULL || fn ArrayCount( columns ) == 0 )if ( attributes != NULL ) then MutableDictionaryAddEntriesFromDictionary( row, attributes )elsefor column in columnscolumnAlias = fn JSONAPIColumnAlias( fn DictionaryObjectForKey( column, @"columnname" ), primary )columnName  = fn JSONAPIColumnName( fn DictionaryObjectForKey( column, @"columnname" ) )if ( fn StringIsEqual( columnAlias, primary ) )if ( fn StringIsEqual( columnName, @"id" ) ) then MutableDictionarySetObjectForKey( row, recordID, fn DictionaryObjectForKey( column, @"aliasname" ) ) else MutableDictionarySetObjectForKey( row, fn JSONAPIRowValue( attributes, columnName ), fn DictionaryObjectForKey( column, @"aliasname" ) )elseMutableDictionarySetObjectForKey( row, fn JSONAPIRowValue( fn DictionaryObjectForKey( parents, columnAlias ), columnName ), fn DictionaryObjectForKey( column, @"aliasname" ) )end ifnextend ifif ( fn DictionaryObjectForKey( row, @"id" ) == NULL ) then MutableDictionarySetObjectForKey( row, recordID, @"id" )if ( fn DictionaryObjectForKey( row, @"S_CheckSum" ) == NULL && attributes != NULL ) then if ( fn DictionaryObjectForKey( attributes, @"S_CheckSum" ) != NULL ) then MutableDictionarySetObjectForKey( row, fn DictionaryObjectForKey( attributes, @"S_CheckSum" ), @"S_CheckSum" )MutableArrayAddObject( rows, row )end ifnextend fn = rows// columnvalues -> attributes (a missing value is JSON null)local fn JSONAPIAttributes( entries as CFArrayRef ) as CFMutableDictionaryRefCFMutableDictionaryRef attributes = fn MutableDictionaryNewCFDictionaryRef        entryif ( entries == NULL ) then exit fn = attributesfor entry in entriesMutableDictionarySetObjectForKey( attributes, fn JSONAPIRowValue( entry, @"value" ), fn DictionaryObjectForKey( entry, @"columnname" ) )nextend fn = attributes// INSERT -> POST /api/<resource>local fn GenerateJSONAPIInsert( statement as CFDictionaryRef ) as CFDictionaryRefCFStringRef resource = fn DictionaryObjectForKey( statement, @"insertintotable" )gJSONAPILastError = NULLif ( resource == NULL ) then exit fn = fn JSONAPIRefuse( @"the INSERT has no resource" )if ( fn StringLength( resource ) == 0 ) then exit fn = fn JSONAPIRefuse( @"the INSERT has no resource" )end fn = @{ @"method":@"POST", @"path":fn StringWithFormat( @"/api/%@", resource ), @"body":@{ @"data":@{ @"type":resource, @"attributes":fn JSONAPIAttributes( fn DictionaryObjectForKey( statement, @"columnvalues" ) ) } } }// INSERT of an array of dictionaries -> one POST per row (ALS has no batch call); NULL: refusedlocal fn GenerateJSONAPIInsertRows( statement as CFDictionaryRef ) as CFArrayRefCFMutableArrayRef      requests = fn MutableArrayNewCFMutableDictionaryRef attributesCFStringRef            resource = fn DictionaryObjectForKey( statement, @"insertintotable" )CFArrayRef             rows = fn DictionaryObjectForKey( statement, @"rows" )CFArrayRef             columns = fn DictionaryObjectForKey( statement, @"columnnames" )CFDictionaryRef        rowCFStringRef            columngJSONAPILastError = NULLif ( resource == NULL || rows == NULL || columns == NULL ) then exit fn = (CFArrayRef)fn JSONAPIRefuse( @"the INSERT has no resource, rows or columns" )for row in rowsattributes = fn MutableDictionaryNewfor column in columnsMutableDictionarySetObjectForKey( attributes, fn JSONAPIRowValue( row, column ), column )nextMutableArrayAddObject( requests, @{ @"method":@"POST", @"path":fn StringWithFormat( @"/api/%@", resource ), @"body":@{ @"data":@{ @"type":resource, @"attributes":attributes } } } )nextend fn = requests// UPDATE / DELETE: exactly one "=" filter - its value is the record's id; NULL: refusedlocal fn JSONAPIRecordID( statement as CFDictionaryRef ) as CFStringRefCFArrayRef      filters = fn DictionaryObjectForKey( statement, @"filter" )CFDictionaryRef fif ( filters == NULL ) then exit fn = (CFStringRef)fn JSONAPIRefuse( @"an UPDATE or DELETE needs one \"=\" filter on the record's key" )if ( fn ArrayCount( filters ) != 1 ) then exit fn = (CFStringRef)fn JSONAPIRefuse( @"an UPDATE or DELETE needs one \"=\" filter on the record's key" )f = fn ArrayFirstObject( filters )if ( fn NumberIntegerValue( fn DictionaryObjectForKey( f, @"operator" ) ) != _isEqual || fn DictionaryObjectForKey( f, @"value" ) == NULL ) then exit fn = (CFStringRef)fn JSONAPIRefuse( @"an UPDATE or DELETE needs one \"=\" filter on the record's key" )end fn = fn StringWithFormat( @"%@", fn DictionaryObjectForKey( f, @"value" ) )// UPDATE -> PATCH /api/<resource>/<id>; put the record's S_CheckSum among the column values// (AddColumnToUpdate( statement, @"S_CheckSum", checksum, _textType )) for a safe multi-user savelocal fn GenerateJSONAPIUpdate( statement as CFDictionaryRef ) as CFDictionaryRefCFStringRef resource = fn DictionaryObjectForKey( statement, @"updatetable" )CFStringRef recordIDgJSONAPILastError = NULLif ( resource == NULL ) then exit fn = fn JSONAPIRefuse( @"the UPDATE has no resource" )recordID = fn JSONAPIRecordID( statement )if ( recordID == NULL ) then exit fn = NULLend fn = @{ @"method":@"PATCH", @"path":fn StringWithFormat( @"/api/%@/%@", resource, fn JSONAPIEncode( recordID ) ), @"body":@{ @"data":@{ @"type":resource, @"id":recordID, @"attributes":fn JSONAPIAttributes( fn DictionaryObjectForKey( statement, @"columnvalues" ) ) } } }// DELETE -> DELETE /api/<resource>/<id>local fn GenerateJSONAPIDelete( statement as CFDictionaryRef ) as CFDictionaryRefCFStringRef resource = fn DictionaryObjectForKey( statement, @"deletefromtable" )CFStringRef recordIDgJSONAPILastError = NULLif ( resource == NULL ) then exit fn = fn JSONAPIRefuse( @"the DELETE has no resource" )recordID = fn JSONAPIRecordID( statement )if ( recordID == NULL ) then exit fn = NULLend fn = @{ @"method":@"DELETE", @"path":fn StringWithFormat( @"/api/%@/%@", resource, fn JSONAPIEncode( recordID ) ) }