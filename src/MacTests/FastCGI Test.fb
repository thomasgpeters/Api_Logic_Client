/* *   I M A G E R Y    B U S I N E S S     S Y S T E M S,   L L C * *   FastCGI Test.fb - a FutureBasic app behind nginx: FastCGI requests in, HTML out  (open it in FB, Run) * *   The pattern for the Web Toolkit for FutureBasic (docs/design/Web Toolkit Design.md -> The pattern): *       Browser --HTTP(S)--> nginx --FastCGI--> this app *   nginx speaks HTTP to the browser (and does TLS, limits, static files); this app listens on 127.0.0.1:9010 for *   FastCGI records (an open protocol), and for each request calls one FB function, WebHandle, which answers with a *   CGI response: "Status:" and "Content-Type:" lines, a blank line, then the HTML or JSON. * *   The FastCGI core is portable C, between the "FastCGI core" markers: tools/check_fastcgi_core.py compiles exactly *   that code on Linux and runs it behind a real nginx, so the protocol is tested before this program reaches a Mac. * *   To run it on a Mac: *       1. brew install nginx   (Homebrew; free, BSD licence) *       2. in this folder (src/MacTests):  nginx -c "$PWD/FastCGI Test nginx.conf" -p "$PWD" *          (its own configuration: no default site on 8080; this program on 9010, clear of PHP-FPM's 9000) *       3. run this program; click Open in Browser (http://127.0.0.1:8088/) *   Please report: does the page appear; does Add One count up without reloading; does Greet show <b>Bob</b> as typed; *   two tabs and fast clicks; and anything the window or the NSLog window says. * *   MIT License. Copyright (c) 2026 Imagery Business Systems, LLC. */include "NSLog.incl"_fcgiPort = 9010            // where nginx sends FastCGI (fastcgi_pass 127.0.0.1:9010)_webPort  = 8088            // where nginx listens for the browser (FastCGI Test nginx.conf)_window = 1begin enum 1_statusLabel_countLabel_openButtonend enumbegin globalslong gWebRequestslong gWebClicksend globalsBeginCDeclaration#include <sys/socket.h>#include <netinet/in.h>#include <arpa/inet.h>#include <unistd.h>#include <fcntl.h>#include <errno.h>#include <string.h>#include <stdlib.h>long FastCGIServerStart( long port, void *handler );EndCBeginCFunction/* --- FastCGI core (portable C: tools/check_fastcgi_core.py compiles and tests exactly this) --- */enum { FCGI_BEGIN_REQUEST = 1, FCGI_ABORT_REQUEST = 2, FCGI_END_REQUEST = 3, FCGI_PARAMS = 4, FCGI_STDIN = 5,       FCGI_STDOUT = 6, FCGI_GET_VALUES = 9, FCGI_GET_VALUES_RESULT = 10, FCGI_UNKNOWN_TYPE = 11,       FCGI_RESPONDER = 1, FCGI_KEEP_CONN = 1, FCGI_MAX_PARAMS = 128, FCGI_MAX_BODY = 1048576 };typedef struct {    unsigned requestId;    int keepConn;    int paramCount;    char *names[FCGI_MAX_PARAMS];    char *values[FCGI_MAX_PARAMS];    unsigned char *body;    size_t bodyLength;} fcgi_request;void fcgi_request_free( fcgi_request *r ){    int i;    for ( i = 0; i < r->paramCount; i++ ) { free( r->names[i] ); free( r->values[i] ); }    free( r->body );    memset( r, 0, sizeof *r );}const char *fcgi_param( const fcgi_request *r, const char *name ){    int i;    for ( i = 0; i < r->paramCount; i++ ) if ( strcmp( r->names[i], name ) == 0 ) return r->values[i];    return "";}/* a name-value pair's length: one byte below 128, else four (the top bit set) */static int fcgi_length( const unsigned char *p, size_t left, size_t *length, size_t *used ){    if ( left < 1 ) return 0;    if ( p[0] < 128 ) { *length = p[0]; *used = 1; return 1; }    if ( left < 4 ) return 0;    *length = ( (size_t)( p[0] & 0x7f ) << 24 ) | ( (size_t)p[1] << 16 ) | ( (size_t)p[2] << 8 ) | p[3];    *used = 4;    return 1;}static int fcgi_add_params( fcgi_request *r, const unsigned char *p, size_t n ){    size_t at = 0, nameLength, valueLength, used;    while ( at < n ) {        if ( !fcgi_length( p + at, n - at, &nameLength, &used ) ) return -1;        at += used;        if ( !fcgi_length( p + at, n - at, &valueLength, &used ) ) return -1;        at += used;        if ( nameLength > n - at || valueLength > n - at - nameLength ) return -1;        if ( r->paramCount >= FCGI_MAX_PARAMS ) return -1;        r->names[r->paramCount] = malloc( nameLength + 1 );        r->values[r->paramCount] = malloc( valueLength + 1 );        memcpy( r->names[r->paramCount], p + at, nameLength );        r->names[r->paramCount][nameLength] = 0;        memcpy( r->values[r->paramCount], p + at + nameLength, valueLength );        r->values[r->paramCount][valueLength] = 0;        r->paramCount++;        at += nameLength + valueLength;    }    return 0;}/* the records received so far -> one whole request (1), not yet (0), or a broken stream (-1).   PARAMS (pairs) and STDIN (the body) end with an empty record of their type. */int fcgi_parse( const unsigned char *data, size_t length, fcgi_request *r ){    size_t at = 0;    int paramsDone = 0, began = 0;    unsigned char *body = NULL;    size_t bodyLength = 0;    memset( r, 0, sizeof *r );    while ( length - at >= 8 ) {        const unsigned char *h = data + at;        unsigned type = h[1], id = ( (unsigned)h[2] << 8 ) | h[3];        size_t contentLength = ( (size_t)h[4] << 8 ) | h[5], paddingLength = h[6];        const unsigned char *content = h + 8;        if ( h[0] != 1 ) { free( body ); fcgi_request_free( r ); return -1; }        if ( length - at < 8 + contentLength + paddingLength ) break;        at += 8 + contentLength + paddingLength;        if ( type == FCGI_BEGIN_REQUEST && contentLength >= 8 ) {            began = 1;            r->requestId = id;            r->keepConn = ( content[2] & FCGI_KEEP_CONN ) != 0;        } else if ( type == FCGI_PARAMS && id == r->requestId ) {            if ( contentLength == 0 ) paramsDone = 1;            else if ( fcgi_add_params( r, content, contentLength ) < 0 ) { free( body ); fcgi_request_free( r ); return -1; }        } else if ( type == FCGI_STDIN && id == r->requestId ) {            if ( contentLength == 0 ) {                if ( !began || !paramsDone ) break;                r->body = body ? body : calloc( 1, 1 );                r->bodyLength = bodyLength;                return 1;            }            if ( bodyLength + contentLength > FCGI_MAX_BODY ) { free( body ); fcgi_request_free( r ); return -1; }            body = realloc( body, bodyLength + contentLength + 1 );            memcpy( body + bodyLength, content, contentLength );            bodyLength += contentLength;            body[bodyLength] = 0;        }    }    free( body );    fcgi_request_free( r );    return 0;}static size_t fcgi_record( unsigned char *out, unsigned type, unsigned id, const unsigned char *content, size_t n ){    out[0] = 1; out[1] = (unsigned char)type; out[2] = (unsigned char)( id >> 8 ); out[3] = (unsigned char)id;    out[4] = (unsigned char)( n >> 8 ); out[5] = (unsigned char)n; out[6] = 0; out[7] = 0;    if ( n ) memcpy( out + 8, content, n );    return 8 + n;}/* a CGI response (headers, blank line, body) -> STDOUT records, the empty STDOUT, END_REQUEST; malloc'd, its length in *outLength */unsigned char *fcgi_response( unsigned id, const unsigned char *cgi, size_t length, size_t *outLength ){    size_t chunks = length / 65528 + 1, at = 0, n;    unsigned char *out = malloc( length + chunks * 8 + 8 + 16 ), *p = out;    unsigned char endBody[8] = { 0, 0, 0, 0, 0, 0, 0, 0 };   /* appStatus 0, protocolStatus REQUEST_COMPLETE */    while ( at < length ) {        n = length - at > 65528 ? 65528 : length - at;        p += fcgi_record( p, FCGI_STDOUT, id, cgi + at, n );        at += n;    }    p += fcgi_record( p, FCGI_STDOUT, id, NULL, 0 );    p += fcgi_record( p, FCGI_END_REQUEST, id, endBody, 8 );    *outLength = (size_t)( p - out );    return out;}/* --- end FastCGI core --- *//* the Mac side: listen on 127.0.0.1, read records on the main queue, call the FB handler, answer */typedef CFStringRef (*FastCGIHandlerFn)( CFDictionaryRef params, CFStringRef body );static FastCGIHandlerFn gFastCGIHandler = NULL;static dispatch_source_t gFastCGIListenSource = nil;static void FastCGIWriteAll( int fd, const unsigned char *bytes, size_t left ){    while ( left > 0 ) {        ssize_t n = write( fd, bytes, left );        if ( n < 0 && errno == EAGAIN ) continue;        if ( n <= 0 ) return;        bytes += n;        left -= (size_t)n;    }}static void FastCGIServeConnection( int fd ){    NSMutableData *buffer = [NSMutableData data];    fcntl( fd, F_SETFL, O_NONBLOCK );    __block dispatch_source_t source = dispatch_source_create( DISPATCH_SOURCE_TYPE_READ, fd, 0, dispatch_get_main_queue() );    dispatch_source_set_event_handler( source, ^{        unsigned char chunk[16384];        ssize_t n = read( fd, chunk, sizeof chunk );        if ( n <= 0 ) { dispatch_source_cancel( source ); return; }        [buffer appendBytes:chunk length:(NSUInteger)n];        fcgi_request r;        int state = fcgi_parse( buffer.bytes, buffer.length, &r );        if ( state < 0 ) { dispatch_source_cancel( source ); return; }        if ( state == 0 ) return;        NSMutableDictionary *params = [NSMutableDictionary dictionary];        for ( int i = 0; i < r.paramCount; i++ ) {            NSString *name = [NSString stringWithUTF8String:r.names[i]], *value = [NSString stringWithUTF8String:r.values[i]];            if ( name && value ) params[name] = value;        }        NSString *body = [[NSString alloc] initWithBytes:r.body length:r.bodyLength encoding:NSUTF8StringEncoding];        NSString *cgi = (__bridge NSString *)gFastCGIHandler( (__bridge CFDictionaryRef)params, (__bridge CFStringRef)( body ? body : @"" ) );        if ( cgi == nil ) cgi = @"Status: 404 Not Found\r\nContent-Type: text/plain; charset=utf-8\r\n\r\nNot found";        NSData *cgiData = [cgi dataUsingEncoding:NSUTF8StringEncoding];        size_t outLength = 0;        unsigned char *out = fcgi_response( r.requestId, cgiData.bytes, cgiData.length, &outLength );        FastCGIWriteAll( fd, out, outLength );        free( out );        int keep = r.keepConn;        fcgi_request_free( &r );        if ( keep ) [buffer setLength:0]; else dispatch_source_cancel( source );    });    dispatch_source_set_cancel_handler( source, ^{        close( fd );        source = nil;    });    dispatch_resume( source );}long FastCGIServerStart( long port, void *handler ){    gFastCGIHandler = (FastCGIHandlerFn)handler;    int s = socket( AF_INET, SOCK_STREAM, 0 );    if ( s < 0 ) return errno;    int yes = 1;    setsockopt( s, SOL_SOCKET, SO_REUSEADDR, &yes, sizeof yes );    struct sockaddr_in address;    memset( &address, 0, sizeof address );    address.sin_family = AF_INET;    address.sin_port = htons( (uint16_t)port );    address.sin_addr.s_addr = htonl( INADDR_LOOPBACK );    if ( bind( s, (struct sockaddr *)&address, sizeof address ) < 0 || listen( s, 64 ) < 0 ) { long e = errno; close( s ); return e; }    fcntl( s, F_SETFL, O_NONBLOCK );    gFastCGIListenSource = dispatch_source_create( DISPATCH_SOURCE_TYPE_READ, s, 0, dispatch_get_main_queue() );    dispatch_source_set_event_handler( gFastCGIListenSource, ^{        int c = accept( s, NULL, NULL );        if ( c >= 0 ) FastCGIServeConnection( c );    });    dispatch_resume( gFastCGIListenSource );    return 0;}EndCtoolbox fn FastCGIServerStart( long port, ptr handler ) = long// --- the app, in FB: every request comes to WebHandle ---// a CGI response: the status, the content type, a blank line, the contentlocal fn WebResponse( status as CFStringRef, contentType as CFStringRef, content as CFStringRef ) as CFStringRefend fn = fn StringWithFormat( @"Status: %@\r\nContent-Type: %@; charset=utf-8\r\nCache-Control: no-store\r\nX-Content-Type-Options: nosniff\r\n\r\n%@", status, contentType, content )local fn WebPage as CFStringRefCFMutableStringRef page = fn MutableStringNewMutableStringAppendString( page, @"<!doctype html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><title>FutureBasic behind nginx</title>" )MutableStringAppendString( page, @"<style>:root{--bg:#fff;--fg:#1d1d1f;--soft:#6e6e73;--accent:#0a63c9;--card:#f5f5f7}@media (prefers-color-scheme:dark){:root{--bg:#161618;--fg:#f2f2f4;--soft:#a1a1a6;--accent:#4c9bff;--card:#1f1f22}}" )MutableStringAppendString( page, @"body{background:var(--bg);color:var(--fg);font:16px -apple-system,sans-serif;max-width:640px;margin:40px auto;padding:0 20px}.card{background:var(--card);border-radius:14px;padding:20px;margin:16px 0}" )MutableStringAppendString( page, @"button{background:var(--accent);color:#fff;border:0;border-radius:999px;padding:8px 18px;font-size:15px;cursor:pointer}input{font-size:15px;padding:7px 10px;border-radius:8px;border:1px solid var(--soft)}.big{font-size:40px;font-weight:700}.soft{color:var(--soft)}</style></head><body>" )MutableStringAppendString( page, @"<h1>FutureBasic behind nginx</h1><p class=\"soft\">nginx speaks HTTP to this browser and FastCGI to a FutureBasic program, which builds this page and answers each click.</p>" )MutableStringAppendString( page, fn StringWithFormat( @"<div class=\"card\"><div class=\"big\" id=\"count\">%ld</div><button onclick=\"send('add','clicked','')\">Add One</button></div>", gWebClicks ) )MutableStringAppendString( page, @"<div class=\"card\"><input id=\"name\" placeholder=\"Your name\"> <button onclick=\"send('greet','clicked',document.getElementById('name').value)\">Greet</button><p id=\"greeting\" class=\"soft\">&nbsp;</p></div><p id=\"served\" class=\"soft\"></p>" )MutableStringAppendString( page, @"<script>async function send(widget,event,value){const r=await fetch('event',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({widget,event,value})});const j=await r.json();for(const u of j.updates){document.getElementById(u.id).textContent=u.text;}}</script></body></html>" )end fn = pagelocal fn WebUpdates( updates as CFArrayRef ) as CFStringRefCFDataRef json = fn JSONSerializationDataWithJSONObject( @{ @"updates" : updates }, 0, NULL )end fn = fn WebResponse( @"200 OK", @"application/json", fn StringWithData( json, NSUTF8StringEncoding ) )local fn WebEvent( body as CFStringRef ) as CFStringRefCFDictionaryRef event = fn JSONSerializationJSONObjectWithData( fn StringData( body, NSUTF8StringEncoding ), 0, NULL )CFStringRef     widget, value, greetingCFDictionaryRef servedif ( event == NULL ) then exit fn = fn WebUpdates( @[] )widget = fn DictionaryObjectForKey( event, @"widget" )value  = fn DictionaryObjectForKey( event, @"value" )if ( widget == NULL ) then widget = @""if ( value == NULL ) then value = @""served = @{ @"id" : @"served", @"text" : fn StringWithFormat( @"Requests answered by FutureBasic: %ld", gWebRequests ) }if ( fn StringIsEqual( widget, @"add" ) )gWebClicks++ControlSetStringValue( _countLabel, fn StringWithFormat( @"The page's count: %ld", gWebClicks ) )exit fn = fn WebUpdates( @[ @{ @"id" : @"count", @"text" : fn StringWithFormat( @"%ld", gWebClicks ) }, served ] )end ifif ( fn StringIsEqual( widget, @"greet" ) )if ( fn StringLength( value ) == 0 ) then greeting = @"Type a name first." else greeting = fn StringWithFormat( @"Hello, %@ - from FutureBasic, behind nginx.", value )exit fn = fn WebUpdates( @[ @{ @"id" : @"greeting", @"text" : greeting }, served ] )end ifend fn = fn WebUpdates( @[] )// every request: nginx's parameters (REQUEST_METHOD, DOCUMENT_URI, QUERY_STRING, HTTP_COOKIE ...) and the body;// the answer is a CGI response, or NULL for 404local fn WebHandle( params as CFDictionaryRef, body as CFStringRef ) as CFStringRefCFStringRef method = fn DictionaryObjectForKey( params, @"REQUEST_METHOD" )CFStringRef path   = fn DictionaryObjectForKey( params, @"DOCUMENT_URI" )if ( method == NULL ) then method = @""if ( path == NULL ) then path = @""gWebRequests++ControlSetStringValue( _statusLabel, fn StringWithFormat( @"FastCGI on 127.0.0.1:%d  -  %ld requests (last: %@ %@)", _fcgiPort, gWebRequests, method, path ) )if ( fn StringIsEqual( method, @"GET" ) && fn StringIsEqual( path, @"/" ) ) then exit fn = fn WebResponse( @"200 OK", @"text/html", fn WebPage )if ( fn StringIsEqual( method, @"POST" ) && fn StringIsEqual( path, @"/event" ) ) then exit fn = fn WebEvent( body )end fn = NULLvoid local fn BuildWindowlong problemwindow _window, @"FastCGI Test", ( 0, 0, 560, 170 ), NSWindowStyleMaskTitled + NSWindowStyleMaskClosable + NSWindowStyleMaskMiniaturizabletextlabel _statusLabel, @"Starting…", ( 20, 120, 520, 20 ), _windowtextlabel _countLabel, @"The page's count: 0", ( 20, 90, 520, 20 ), _windowbutton _openButton, YES, , @"Open in Browser", ( 20, 30, 160, 32 ), NSButtonTypeMomentaryPushIn, NSBezelStyleRounded, _windowproblem = fn FastCGIServerStart( _fcgiPort, @fn WebHandle )if ( problem != 0 )ControlSetStringValue( _statusLabel, fn StringWithFormat( @"FastCGI could not listen on port %d (error %ld - is the port in use?)", _fcgiPort, problem ) )NSLog( @"FastCGI Test: could not listen on 127.0.0.1:%d, errno %ld", _fcgiPort, problem )elseControlSetStringValue( _statusLabel, fn StringWithFormat( @"FastCGI on 127.0.0.1:%d - with nginx running, open http://127.0.0.1:%d/", _fcgiPort, _webPort ) )NSLog( @"FastCGI Test: listening for nginx on 127.0.0.1:%d", _fcgiPort )end ifend fnvoid local fn DoDialog( ev as long, tag as long, wnd as long )if ( ev == _btnClick && tag == _openButton ) then fn WorkspaceOpenURL( fn URLWithString( fn StringWithFormat( @"http://127.0.0.1:%d/", _webPort ) ) )end fnvoid local fn DoAppEvent( ev as long )if ( ev == _appShouldTerminateAfterLastWindowClosed ) then AppEventSetBool( YES )end fnfn BuildWindowon dialog fn DoDialogon appevent fn DoAppEventHandleEvents