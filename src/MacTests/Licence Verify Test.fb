/* *   Licence Verify Test.fb - does App Builder's licence check work on this Mac? * *   Written by tools/licence_reference.py --mac-test: do not edit. Its verify part is src/AppBuilder/Licence.incl's, *   unchanged (run_tests.sh checks); its cases are the reference's, signed with the TEST key. Open it in the *   FutureBasic editor and run it: every case should say PASS in the NSLog window. */include "NSLog.incl"// the Security declarations, as src/AppBuilder/Licence Security.incl has them (any FutureBasic, with or without its own// Tlbx Security.incl)include library "Security"BeginCDeclaration#import <Security/Security.h>EndC#define SecKeyRef as ptr#define SecKeyAlgorithm as CFStringRef// keys (SecKey.h, SecItem.h)system CFStringRef kSecAttrKeyTypesystem CFStringRef kSecAttrKeyClasssystem CFStringRef kSecAttrKeySizeInBitssystem CFStringRef kSecAttrKeyTypeECSECPrimeRandomsystem CFStringRef kSecAttrKeyClassPublicsystem SecKeyAlgorithm kSecKeyAlgorithmECDSASignatureMessageX962SHA256toolbox fn SecKeyCreateWithData( CFDataRef keyData, CFDictionaryRef attributes, CFErrorRef *error ) = SecKeyReftoolbox fn SecKeyVerifySignature( SecKeyRef key, SecKeyAlgorithm algorithm, CFDataRef signedData, CFDataRef signature, CFErrorRef *error ) = Boolean// the Keychain (SecItem.h, SecBase.h)system CFStringRef kSecClasssystem CFStringRef kSecClassGenericPasswordsystem CFStringRef kSecAttrServicesystem CFStringRef kSecAttrAccountsystem CFStringRef kSecAttrLabelsystem CFStringRef kSecValueDatasystem CFStringRef kSecReturnDatasystem CFStringRef kSecMatchLimitsystem CFStringRef kSecMatchLimitOnesystem OSStatus errSecSuccesstoolbox fn SecItemCopyMatching( CFDictionaryRef query, CFTypeRef *result ) = OSStatustoolbox fn SecItemAdd( CFDictionaryRef attributes, CFTypeRef *result ) = OSStatustoolbox fn SecItemDelete( CFDictionaryRef query ) = OSStatus// --- verify (shared with the Mac test: src/MacTests/Licence Verify Test.fb) ---#define LICENCE_PRODUCT     @"app_builder_fb"begin globalsCFStringRef gLicenceVerifyProblem   // why LicenceVerify refused the last licence it was givenend globals// THE TEST KEY (tools/licence_test_keys): replaced by the License Server's production public key before release#define LICENCE_PUBLIC_KEY  @"BDuI+tIRfRlumTbUjrwYpvd1KK22UtTexA1UuW+8Pg6cmfLwLCYwm8V+hE5thgQtCLCg9Fbe1KzLDo70enYwsmQ="// base64url (no padding) -> data; NULL when it is not base64urllocal fn LicenceBase64URLDecode( textValue as CFStringRef ) as CFDataRefCFStringRef base64 = fn StringByReplacingOccurrencesOfString( fn StringByReplacingOccurrencesOfString( textValue, @"-", @"+" ), @"_", @"/" )while ( fn StringLength( base64 ) mod 4 != 0 )base64 = fn StringByAppendingString( base64, @"=" )wendend fn = fn DataWithBase64EncodedString( base64, 0 )// today, as the licence writes dates (yyyy-MM-dd)local fn LicenceToday as CFStringRefend fn = fn DateFormatterStringFromDate( fn DateFormatterWithFormat( @"yyyy-MM-dd" ), fn DateNow )// does the signature, made by the License Server's private key, match the text?local fn LicenceSignatureMatches( signedText as CFStringRef, signature as CFDataRef ) as BOOLCFMutableDictionaryRef attributes = fn MutableDictionaryNewCFDataRef              keyData = fn DataWithBase64EncodedString( LICENCE_PUBLIC_KEY, 0 )SecKeyRef              publicKeyif ( keyData == NULL || signature == NULL ) then exit fn = NOMutableDictionarySetObjectForKey( attributes, kSecAttrKeyTypeECSECPrimeRandom, kSecAttrKeyType )MutableDictionarySetObjectForKey( attributes, kSecAttrKeyClassPublic, kSecAttrKeyClass )MutableDictionarySetObjectForKey( attributes, fn NumberWithLong( 256 ), kSecAttrKeySizeInBits )publicKey = fn SecKeyCreateWithData( keyData, attributes, NULL )if ( publicKey == NULL ) then exit fn = NOend fn = fn SecKeyVerifySignature( publicKey, kSecKeyAlgorithmECDSASignatureMessageX962SHA256, fn StringData( signedText, NSUTF8StringEncoding ), signature, NULL )// a licence's text -> its payload when it is genuine, for this product, and not expired (on this day);// else NULL, and why in gLicenceVerifyProblemlocal fn LicenceVerify( licenceText as CFStringRef, onDay as CFStringRef ) as CFDictionaryRefCFArrayRef      partsCFStringRef     body, expiresCFDataRef       signature, payloadDataCFDictionaryRef payloadCFTypeRef       productgLicenceVerifyProblem = @""if ( licenceText == NULL ) then licenceText = @""licenceText = fn StringByTrimmingCharactersInSet( licenceText, fn CharacterSetWhitespaceAndNewlineSet )parts = fn StringComponentsSeparatedByString( licenceText, @"." )if ( fn ArrayCount( parts ) != 2 )gLicenceVerifyProblem = @"This is not a licence: it should be two parts joined by a full stop."exit fn = NULLend ifbody = fn ArrayObjectAtIndex( parts, 0 )signature = fn LicenceBase64URLDecode( fn ArrayObjectAtIndex( parts, 1 ) )payloadData = fn LicenceBase64URLDecode( body )if ( fn StringLength( body ) == 0 || signature == NULL || payloadData == NULL )gLicenceVerifyProblem = @"This is not a licence: it contains characters a licence never has."exit fn = NULLend ifif ( fn LicenceSignatureMatches( body, signature ) == NO )gLicenceVerifyProblem = @"The licence's signature does not match: it was changed, or it was not issued by Imagery."exit fn = NULLend ifpayload = fn JSONSerializationJSONObjectWithData( payloadData, 0, NULL )if ( payload == NULL )gLicenceVerifyProblem = @"The licence could not be read."exit fn = NULLend ifproduct = fn DictionaryObjectForKey( payload, @"product" )if ( product == NULL ) then product = @""if ( fn StringIsEqual( (CFStringRef)product, LICENCE_PRODUCT ) == NO )gLicenceVerifyProblem = @"This licence is for another product."exit fn = NULLend ifexpires = fn DictionaryObjectForKey( payload, @"expires" )if ( expires != NULL )if ( fn ObjectIsKindOfClass( (ObjectRef)expires, fn ClassFromString( @"NSString" ) ) )if ( fn StringCompare( expires, onDay ) == NSOrderedAscending )gLicenceVerifyProblem = fn StringWithFormat( @"This licence expired on %@.", expires )exit fn = NULLend ifend ifend ifend fn = payload// the payload's feature bitslocal fn LicenceFeaturesOf( payload as CFDictionaryRef ) as longCFTypeRef featuresif ( payload == NULL ) then exit fn = 0features = fn DictionaryObjectForKey( payload, @"features" )if ( features == NULL ) then exit fn = 0end fn = fn NumberIntegerValue( features )// --- end verify ---begin globalslong gPassed, gFailedend globalsvoid local fn LicenceCheckCase( caseName as CFStringRef, licenceText as CFStringRef, onDay as CFStringRef, expectValid as BOOL, words as CFStringRef, features as long )CFDictionaryRef payload = fn LicenceVerify( licenceText, onDay )BOOL            goodif ( expectValid )good = ( payload != NULL )if ( good ) then good = ( fn LicenceFeaturesOf( payload ) == features )elsegood = ( payload == NULL )if ( good ) then good = fn StringContainsString( gLicenceVerifyProblem, words )end ifif ( good )gPassed++NSLog( @"PASS  %@", caseName )elsegFailed++NSLog( @"FAIL  %@   (%@)", caseName, gLicenceVerifyProblem )end ifend fnfn LicenceCheckCase( @"a Lite licence: core and the AI assistant, nothing Professional", @"eyJsaWMiOiJMLVRFU1QtMDAwMSIsInByb2R1Y3QiOiJhcHBfYnVpbGRlcl9mYiIsImFjY291bnQiOiJqYW5lQGV4YW1wbGUuY29tIiwibmFtZSI6IkphbmUgT3V0ZXJicmlkZ2UiLCJlZGl0aW9uIjoibGl0ZSIsImZlYXR1cmVzIjozLCJpc3N1ZWQiOiIyMDI2LTExLTI2IiwiZXhwaXJlcyI6bnVsbH0.MEUCIEkBwcJm7THFMh_ZsXgdfp86jWyQvAtubUSHSdVTPQO4AiEAkJwOaKpB33Iwsr2Q8lobN_mwgsuFQHC92dXyUT3Jl2Q", @"2026-11-26", YES, @"", 3 )fn LicenceCheckCase( @"a Professional licence until 2027-11-30", @"eyJsaWMiOiJMLVRFU1QtMDAwMiIsInByb2R1Y3QiOiJhcHBfYnVpbGRlcl9mYiIsImFjY291bnQiOiJqYW5lQGV4YW1wbGUuY29tIiwibmFtZSI6IkphbmUgT3V0ZXJicmlkZ2UiLCJlZGl0aW9uIjoicHJvZmVzc2lvbmFsIiwiZmVhdHVyZXMiOjUxMSwiaXNzdWVkIjoiMjAyNi0xMS0yNiIsImV4cGlyZXMiOiIyMDI3LTExLTMwIn0.MEYCIQCwAMrWeTWhxrE5Jap2NKKnfOwcrxvxo0PALG1LJXrxIQIhAOkIPBlgj0I-kkfmOni9HHjLXgv2PJG2yxutH6zRufTV", @"2026-11-26", YES, @"", 511 )fn LicenceCheckCase( @"the Professional licence the day it ends: still good", @"eyJsaWMiOiJMLVRFU1QtMDAwMiIsInByb2R1Y3QiOiJhcHBfYnVpbGRlcl9mYiIsImFjY291bnQiOiJqYW5lQGV4YW1wbGUuY29tIiwibmFtZSI6IkphbmUgT3V0ZXJicmlkZ2UiLCJlZGl0aW9uIjoicHJvZmVzc2lvbmFsIiwiZmVhdHVyZXMiOjUxMSwiaXNzdWVkIjoiMjAyNi0xMS0yNiIsImV4cGlyZXMiOiIyMDI3LTExLTMwIn0.MEYCIQCwAMrWeTWhxrE5Jap2NKKnfOwcrxvxo0PALG1LJXrxIQIhAOkIPBlgj0I-kkfmOni9HHjLXgv2PJG2yxutH6zRufTV", @"2027-11-30", YES, @"", 511 )fn LicenceCheckCase( @"the Professional licence the day after: expired", @"eyJsaWMiOiJMLVRFU1QtMDAwMiIsInByb2R1Y3QiOiJhcHBfYnVpbGRlcl9mYiIsImFjY291bnQiOiJqYW5lQGV4YW1wbGUuY29tIiwibmFtZSI6IkphbmUgT3V0ZXJicmlkZ2UiLCJlZGl0aW9uIjoicHJvZmVzc2lvbmFsIiwiZmVhdHVyZXMiOjUxMSwiaXNzdWVkIjoiMjAyNi0xMS0yNiIsImV4cGlyZXMiOiIyMDI3LTExLTMwIn0.MEYCIQCwAMrWeTWhxrE5Jap2NKKnfOwcrxvxo0PALG1LJXrxIQIhAOkIPBlgj0I-kkfmOni9HHjLXgv2PJG2yxutH6zRufTV", @"2027-12-01", NO, @"expired", 0 )fn LicenceCheckCase( @"a Lite licence edited to Professional: the signature no longer matches", @"eyJsaWMiOiJMLVRFU1QtMDAwMSIsInByb2R1Y3QiOiJhcHBfYnVpbGRlcl9mYiIsImFjY291bnQiOiJqYW5lQGV4YW1wbGUuY29tIiwibmFtZSI6IkphbmUgT3V0ZXJicmlkZ2UiLCJlZGl0aW9uIjoibGl0ZSIsImZlYXR1cmVzIjo1MTEsImlzc3VlZCI6IjIwMjYtMTEtMjYiLCJleHBpcmVzIjpudWxsfQ.MEUCIEkBwcJm7THFMh_ZsXgdfp86jWyQvAtubUSHSdVTPQO4AiEAkJwOaKpB33Iwsr2Q8lobN_mwgsuFQHC92dXyUT3Jl2Q", @"2026-11-26", NO, @"signature", 0 )fn LicenceCheckCase( @"a licence with another licence's signature", @"eyJsaWMiOiJMLVRFU1QtMDAwMSIsInByb2R1Y3QiOiJhcHBfYnVpbGRlcl9mYiIsImFjY291bnQiOiJqYW5lQGV4YW1wbGUuY29tIiwibmFtZSI6IkphbmUgT3V0ZXJicmlkZ2UiLCJlZGl0aW9uIjoibGl0ZSIsImZlYXR1cmVzIjozLCJpc3N1ZWQiOiIyMDI2LTExLTI2IiwiZXhwaXJlcyI6bnVsbH0.MEYCIQCwAMrWeTWhxrE5Jap2NKKnfOwcrxvxo0PALG1LJXrxIQIhAOkIPBlgj0I-kkfmOni9HHjLXgv2PJG2yxutH6zRufTV", @"2026-11-26", NO, @"signature", 0 )fn LicenceCheckCase( @"a licence signed with another key (not Imagery's)", @"eyJsaWMiOiJMLVgiLCJwcm9kdWN0IjoiYXBwX2J1aWxkZXJfZmIiLCJhY2NvdW50IjoieEBleGFtcGxlLmNvbSIsIm5hbWUiOiJYIiwiZWRpdGlvbiI6InByb2Zlc3Npb25hbCIsImZlYXR1cmVzIjo1MTEsImlzc3VlZCI6IjIwMjYtMTEtMjYiLCJleHBpcmVzIjpudWxsfQ.MEUCIQCvqqFSCG8rKhEiMeOiYW3BEs2ZEnkVSjXNoIZ1S6K0ZQIgZ0mFZa7ngctBu5sc9MqOUk2IQmXY4b83ZLqiS4SD1pU", @"2026-11-26", NO, @"signature", 0 )fn LicenceCheckCase( @"a licence for another product", @"eyJsaWMiOiJMLVRFU1QtMDAwMyIsInByb2R1Y3QiOiJmbGVldF9kaXNwYXRjaGVyIiwiYWNjb3VudCI6ImphbmVAZXhhbXBsZS5jb20iLCJuYW1lIjoiSmFuZSIsImVkaXRpb24iOiJsaXRlIiwiZmVhdHVyZXMiOjMsImlzc3VlZCI6IjIwMjYtMTEtMjYiLCJleHBpcmVzIjpudWxsfQ.MEUCIB8ethOIj3sLyBKJDiM7pTMu2G8N4YOdLqmW6LEULyDeAiEA11AppODL2_RrXo0fXyres1cCkGBbmHGRQkt_pHM6E-Q", @"2026-11-26", NO, @"another product", 0 )fn LicenceCheckCase( @"text that is not a licence", @"hello", @"2026-11-26", NO, @"not a licence", 0 )fn LicenceCheckCase( @"a licence pasted with spaces and a new line around it", @"  eyJsaWMiOiJMLVRFU1QtMDAwMSIsInByb2R1Y3QiOiJhcHBfYnVpbGRlcl9mYiIsImFjY291bnQiOiJqYW5lQGV4YW1wbGUuY29tIiwibmFtZSI6IkphbmUgT3V0ZXJicmlkZ2UiLCJlZGl0aW9uIjoibGl0ZSIsImZlYXR1cmVzIjozLCJpc3N1ZWQiOiIyMDI2LTExLTI2IiwiZXhwaXJlcyI6bnVsbH0.MEUCIEkBwcJm7THFMh_ZsXgdfp86jWyQvAtubUSHSdVTPQO4AiEAkJwOaKpB33Iwsr2Q8lobN_mwgsuFQHC92dXyUT3Jl2Q\n", @"2026-11-26", YES, @"", 3 )NSLog( @"licences: %ld passed, %ld failed", gPassed, gFailed )HandleEvents