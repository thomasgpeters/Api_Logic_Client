/* *   Fn Pointer Test.fb - can FutureBasic call a function through its address and get a value back? * *   The question behind it (author, 2026-11-28: "eliminate any inline C code in the generated apps"): the rules *   engine (Logic Row.incl) and the data interface (App Data Lite.incl, App Shell.incl) call FB functions they were *   handed with @fn. Today one line of C makes each call:  cln return ((CFTypeRef (*)(CFMutableDictionaryRef))fn)( row ); *   FB's own way is def fn ... using (FB's manual: "def fn using"). The manual shows no function that returns a value *   through it, and FB 7.1.4 treats an untyped fn as void - so this program tries exactly what the runtime needs: *     an object back (a formula), a BOOL back (a condition), nothing back with one parameter (an event), and four *     parameters (App Data's answer). * *   Open it in FutureBasic and run it. The NSLog window shows a PASS or FAIL line for each, then the count. *   If it does not build, the Build Log is the answer: paste it (the other way to write the return type, should the *   translator refuse "as CFTypeRef" after the parameters, is "CFTypeRef def fn CallFormula( ... ) using ..."). */include "NSLog.incl"begin globalsptr         gCallTarget             // the address the calls below go to: set it before each calllong        gTestsFailedlong        gDoneOpCFStringRef gDoneMessageend globalsvoid local fn TestReport( passed as BOOL, what as CFStringRef )if ( passed )NSLog( @"PASS  %@", what )elseNSLog( @"FAIL  %@", what )gTestsFailed++end ifend fn// the kinds of function the runtime calls through an addresslocal fn TestFormula( logicRow as CFMutableDictionaryRef ) as CFTypeRefend fn = fn NumberWithDouble( fn NumberDoubleValue( fn DictionaryObjectForKey( logicRow, @"Quantity" ) ) * 2.5 )local fn TestCondition( logicRow as CFMutableDictionaryRef ) as BOOLend fn = ( fn NumberDoubleValue( fn DictionaryObjectForKey( logicRow, @"Quantity" ) ) > 0 )void local fn TestEvent( logicRow as CFMutableDictionaryRef )MutableDictionarySetObjectForKey( logicRow, fn NumberWithBool( YES ), @"seen" )end fnvoid local fn TestDone( op as long, entityName as CFStringRef, result as CFTypeRef, message as CFStringRef )gDoneOp = opgDoneMessage = messageend fn// FB's call through an address: one name for each kind (def fn ... using; the address is a variable)def fn CallFormula( logicRow as CFMutableDictionaryRef ) as CFTypeRef using gCallTargetdef fn CallCondition( logicRow as CFMutableDictionaryRef ) as BOOL using gCallTargetdef fn CallEvent( logicRow as CFMutableDictionaryRef ) using gCallTargetdef fn CallDone( op as long, entityName as CFStringRef, result as CFTypeRef, message as CFStringRef ) using gCallTargetvoid local fn RunTestsCFMutableDictionaryRef aRow = fn MutableDictionaryWithDictionary( @{ @"Quantity":fn NumberWithLong( 4 ) } )CFTypeRef              valueBOOL                   passedgCallTarget = @fn TestFormulavalue = fn CallFormula( aRow )fn TestReport( fn NumberDoubleValue( value ) == 10.0, @"an object back (a formula: 4 x 2.5 = 10)" )gCallTarget = @fn TestConditionpassed = fn CallCondition( aRow )fn TestReport( passed, @"a BOOL back, YES (a condition: 4 > 0)" )MutableDictionarySetObjectForKey( aRow, fn NumberWithLong( -1 ), @"Quantity" )passed = fn CallCondition( aRow )fn TestReport( passed == NO, @"a BOOL back, NO (-1 > 0)" )gCallTarget = @fn TestEventfn CallEvent( aRow )fn TestReport( fn DictionaryObjectForKey( aRow, @"seen" ) != NULL, @"nothing back, one parameter (an event)" )gCallTarget = @fn TestDonefn CallDone( 3, @"Order", NULL, @"Saved." )fn TestReport( gDoneOp == 3 && fn StringIsEqual( gDoneMessage, @"Saved." ), @"nothing back, four parameters (App Data's answer)" )if ( gTestsFailed == 0 ) then NSLog( @"Fn Pointer Test: all passed - def fn ... using can replace the runtime's C calls" ) else NSLog( @"Fn Pointer Test: %ld failed", gTestsFailed )end fnfn RunTestsHandleEvents