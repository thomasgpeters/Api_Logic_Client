/* *   I M A G E R Y    B U S I N E S S     S Y S T E M S,   L L C * *   Web Server Test.fb - can a FutureBasic program serve a web page and take its clicks?  (open it in FB, Run) * *   The proof for the Web Toolkit for FutureBasic (docs/design/Web Toolkit Design.md): a small HTTP server in C *   (BSD sockets, dispatched on the main queue, so FB code runs on the main thread only) calls an FB function for *   every request, through an @fn pointer - as LogicBank for FutureBasic calls its rules. The FB function answers: *       GET /        the page: a counter with a button, a name field with a Greet button *       POST /event  a click, as JSON { widget, event, value }; the answer lists what changes on the page *   The page's few lines of JavaScript send the click and apply the changes, without reloading. * *   Run it, click Open in Browser (or go to http://127.0.0.1:8080/ in Safari and Chrome), then please report: *       - does the page appear?  does Add One count up, without the page reloading? *       - does Greet answer with the name typed (try  <b>Bob</b>  - it must show as typed, not bold)? *       - two tabs at once: do they share the count (one server, one count - sessions come later)? *       - many fast clicks: does it keep up?  the window counts the requests *   and paste anything the window or the NSLog window says. * *   It listens on 127.0.0.1 only - this Mac, not the network - so macOS asks no firewall question. * *   MIT License. Copyright (c) 2026 Imagery Business Systems, LLC. */include "NSLog.incl"_webPort = 8080_window = 1begin enum 1_statusLabel_countLabel_openButtonend enumbegin globalslong gWebRequests           // requests servedlong gWebClicks             // the page's counterend globals// --- the server, in C: listen on 127.0.0.1, read each request, call the FB handler, write its answer ---BeginCDeclaration#include <sys/socket.h>#include <netinet/in.h>#include <arpa/inet.h>#include <unistd.h>#include <fcntl.h>#include <errno.h>#include <string.h>long WebServerStart( long port, void *handler );EndCBeginCFunctiontypedef CFStringRef (*WebHandlerFn)( CFStringRef method, CFStringRef path, CFStringRef body );static WebHandlerFn gWebHandler = NULL;static dispatch_source_t gWebListenSource = nil;static void WebWriteAll( int fd, NSData *data ){    const char *bytes = data.bytes;    size_t left = data.length;    while ( left > 0 ) {        ssize_t n = write( fd, bytes, left );        if ( n <= 0 ) return;        bytes += n;        left -= n;    }}static void WebAnswer( int fd, NSString *method, NSString *path, NSString *body ){    NSString *reply = (__bridge NSString *)gWebHandler( (__bridge CFStringRef)method, (__bridge CFStringRef)path, (__bridge CFStringRef)body );    NSString *status = @"200 OK";    NSString *type = [path isEqualToString:@"/"] ? @"text/html" : @"application/json";    if ( reply == nil ) { status = @"404 Not Found"; type = @"text/plain"; reply = @"Not found"; }    NSData *content = [reply dataUsingEncoding:NSUTF8StringEncoding];    NSString *head = [NSString stringWithFormat:@"HTTP/1.1 %@\r\nContent-Type: %@; charset=utf-8\r\nContent-Length: %lu\r\nCache-Control: no-store\r\nX-Content-Type-Options: nosniff\r\nConnection: close\r\n\r\n", status, type, (unsigned long)content.length];    WebWriteAll( fd, [head dataUsingEncoding:NSUTF8StringEncoding] );    WebWriteAll( fd, content );}static void WebServeClient( int fd ){    NSMutableData *buffer = [NSMutableData data];    fcntl( fd, F_SETFL, O_NONBLOCK );    __block dispatch_source_t source = dispatch_source_create( DISPATCH_SOURCE_TYPE_READ, fd, 0, dispatch_get_main_queue() );    dispatch_source_set_event_handler( source, ^{        char chunk[8192];        ssize_t n = read( fd, chunk, sizeof chunk );        if ( n <= 0 || buffer.length > 1048576 ) { dispatch_source_cancel( source ); return; }        [buffer appendBytes:chunk length:n];        NSRange end = [buffer rangeOfData:[@"\r\n\r\n" dataUsingEncoding:NSUTF8StringEncoding] options:0 range:NSMakeRange( 0, buffer.length )];        if ( end.location == NSNotFound ) return;        NSString *head = [[NSString alloc] initWithData:[buffer subdataWithRange:NSMakeRange( 0, end.location )] encoding:NSUTF8StringEncoding];        NSUInteger bodyStart = end.location + 4, contentLength = 0;        for ( NSString *line in [head componentsSeparatedByString:@"\r\n"] ) {            if ( [[line lowercaseString] hasPrefix:@"content-length:"] ) contentLength = (NSUInteger)[[line substringFromIndex:15] integerValue];        }        if ( contentLength > 65536 ) { dispatch_source_cancel( source ); return; }        if ( buffer.length < bodyStart + contentLength ) return;        NSArray *first = [[[head componentsSeparatedByString:@"\r\n"] firstObject] componentsSeparatedByString:@" "];        NSString *method = first.count > 0 ? first[0] : @"GET";        NSString *path = first.count > 1 ? first[1] : @"/";        NSString *body = [[NSString alloc] initWithData:[buffer subdataWithRange:NSMakeRange( bodyStart, contentLength )] encoding:NSUTF8StringEncoding];        WebAnswer( fd, method, path, body ? body : @"" );        dispatch_source_cancel( source );    });    dispatch_source_set_cancel_handler( source, ^{        close( fd );        source = nil;    });    dispatch_resume( source );}long WebServerStart( long port, void *handler ){    gWebHandler = (WebHandlerFn)handler;    int s = socket( AF_INET, SOCK_STREAM, 0 );    if ( s < 0 ) return errno;    int yes = 1;    setsockopt( s, SOL_SOCKET, SO_REUSEADDR, &yes, sizeof yes );    struct sockaddr_in address;    memset( &address, 0, sizeof address );    address.sin_family = AF_INET;    address.sin_port = htons( (uint16_t)port );    address.sin_addr.s_addr = htonl( INADDR_LOOPBACK );    if ( bind( s, (struct sockaddr *)&address, sizeof address ) < 0 || listen( s, 32 ) < 0 ) { long e = errno; close( s ); return e; }    fcntl( s, F_SETFL, O_NONBLOCK );    gWebListenSource = dispatch_source_create( DISPATCH_SOURCE_TYPE_READ, s, 0, dispatch_get_main_queue() );    dispatch_source_set_event_handler( gWebListenSource, ^{        int c = accept( s, NULL, NULL );        if ( c >= 0 ) WebServeClient( c );    });    dispatch_resume( gWebListenSource );    return 0;}EndCtoolbox fn WebServerStart( long port, ptr handler ) = long// --- the app, in FB ---// text for the page, HTML-escaped: what a user typed is shown as typed, never run as HTMLlocal fn WebEscape( textValue as CFStringRef ) as CFStringRefCFStringRef s = textValues = fn StringByReplacingOccurrencesOfString( s, @"&", @"&amp;" )s = fn StringByReplacingOccurrencesOfString( s, @"<", @"&lt;" )s = fn StringByReplacingOccurrencesOfString( s, @">", @"&gt;" )s = fn StringByReplacingOccurrencesOfString( s, @"\"", @"&quot;" )end fn = s// the page: two "widgets" and the JavaScript that carries their clicks to FB and FB's changes backlocal fn WebPage as CFStringRefCFMutableStringRef page = fn MutableStringNewMutableStringAppendString( page, @"<!doctype html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><title>FutureBasic on the web</title>" )MutableStringAppendString( page, @"<style>:root{--bg:#fff;--fg:#1d1d1f;--soft:#6e6e73;--accent:#0a63c9;--card:#f5f5f7}@media (prefers-color-scheme:dark){:root{--bg:#161618;--fg:#f2f2f4;--soft:#a1a1a6;--accent:#4c9bff;--card:#1f1f22}}" )MutableStringAppendString( page, @"body{background:var(--bg);color:var(--fg);font:16px -apple-system,sans-serif;max-width:640px;margin:40px auto;padding:0 20px}.card{background:var(--card);border-radius:14px;padding:20px;margin:16px 0}" )MutableStringAppendString( page, @"button{background:var(--accent);color:#fff;border:0;border-radius:999px;padding:8px 18px;font-size:15px;cursor:pointer}input{font-size:15px;padding:7px 10px;border-radius:8px;border:1px solid var(--soft)}.big{font-size:40px;font-weight:700}.soft{color:var(--soft)}</style></head><body>" )MutableStringAppendString( page, @"<h1>FutureBasic on the web</h1><p class=\"soft\">This page is served by a FutureBasic program. Each click goes to an FB function; the page changes without reloading.</p>" )MutableStringAppendString( page, fn StringWithFormat( @"<div class=\"card\"><div class=\"big\" id=\"count\">%ld</div><button onclick=\"send('add','clicked','')\">Add One</button></div>", gWebClicks ) )MutableStringAppendString( page, @"<div class=\"card\"><input id=\"name\" placeholder=\"Your name\"> <button onclick=\"send('greet','clicked',document.getElementById('name').value)\">Greet</button><p id=\"greeting\" class=\"soft\">&nbsp;</p></div>" )MutableStringAppendString( page, @"<p id=\"served\" class=\"soft\"></p>" )MutableStringAppendString( page, @"<script>async function send(widget,event,value){const r=await fetch('/event',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({widget,event,value})});const j=await r.json();for(const u of j.updates){document.getElementById(u.id).textContent=u.text;}}</script>" )MutableStringAppendString( page, @"</body></html>" )end fn = page// a JSON answer: the elements to change, by id, and their new textlocal fn WebUpdates( updates as CFArrayRef ) as CFStringRefCFDataRef json = fn JSONSerializationDataWithJSONObject( @{ @"updates" : updates }, 0, NULL )end fn = fn StringWithData( json, NSUTF8StringEncoding )// an event from the page: { widget, event, value } -> the changeslocal fn WebEvent( body as CFStringRef ) as CFStringRefCFDictionaryRef event = fn JSONSerializationJSONObjectWithData( fn StringData( body, NSUTF8StringEncoding ), 0, NULL )CFStringRef     widget, value, greetingCFDictionaryRef servedif ( event == NULL ) then exit fn = fn WebUpdates( @[] )widget = fn DictionaryObjectForKey( event, @"widget" )value  = fn DictionaryObjectForKey( event, @"value" )if ( widget == NULL ) then widget = @""if ( value == NULL ) then value = @""served = @{ @"id" : @"served", @"text" : fn StringWithFormat( @"Requests served by FutureBasic: %ld", gWebRequests ) }if ( fn StringIsEqual( widget, @"add" ) )gWebClicks++ControlSetStringValue( _countLabel, fn StringWithFormat( @"The page's count: %ld", gWebClicks ) )exit fn = fn WebUpdates( @[ @{ @"id" : @"count", @"text" : fn StringWithFormat( @"%ld", gWebClicks ) }, served ] )end ifif ( fn StringIsEqual( widget, @"greet" ) )// the page sets textContent, so the name is shown as typed, never as HTMLif ( fn StringLength( value ) == 0 ) then greeting = @"Type a name first." else greeting = fn StringWithFormat( @"Hello, %@ - from FutureBasic.", value )exit fn = fn WebUpdates( @[ @{ @"id" : @"greeting", @"text" : greeting }, served ] )end ifend fn = fn WebUpdates( @[] )// every request comes here (the C server calls it on the main thread); NULL answers 404local fn WebHandle( method as CFStringRef, path as CFStringRef, body as CFStringRef ) as CFStringRefgWebRequests++ControlSetStringValue( _statusLabel, fn StringWithFormat( @"Serving http://127.0.0.1:%d/  -  %ld requests (last: %@ %@)", _webPort, gWebRequests, method, path ) )if ( fn StringIsEqual( method, @"GET" ) && fn StringIsEqual( path, @"/" ) ) then exit fn = fn WebPageif ( fn StringIsEqual( method, @"POST" ) && fn StringIsEqual( path, @"/event" ) ) then exit fn = fn WebEvent( body )end fn = NULLvoid local fn BuildWindowlong problemwindow _window, @"Web Server Test", ( 0, 0, 520, 170 ), NSWindowStyleMaskTitled + NSWindowStyleMaskClosable + NSWindowStyleMaskMiniaturizabletextlabel _statusLabel, @"Starting…", ( 20, 120, 480, 20 ), _windowtextlabel _countLabel, @"The page's count: 0", ( 20, 90, 480, 20 ), _windowbutton _openButton, YES, , @"Open in Browser", ( 20, 30, 160, 32 ), NSButtonTypeMomentaryPushIn, NSBezelStyleRounded, _windowproblem = fn WebServerStart( _webPort, @fn WebHandle )if ( problem != 0 )ControlSetStringValue( _statusLabel, fn StringWithFormat( @"The server could not start on port %d (error %ld - is the port in use?)", _webPort, problem ) )NSLog( @"Web Server Test: could not listen on 127.0.0.1:%d, errno %ld", _webPort, problem )elseControlSetStringValue( _statusLabel, fn StringWithFormat( @"Serving http://127.0.0.1:%d/  -  open it in Safari or Chrome", _webPort ) )NSLog( @"Web Server Test: serving http://127.0.0.1:%d/", _webPort )end ifend fnvoid local fn DoDialog( ev as long, tag as long, wnd as long )if ( ev == _btnClick && tag == _openButton ) then fn WorkspaceOpenURL( fn URLWithString( fn StringWithFormat( @"http://127.0.0.1:%d/", _webPort ) ) )end fnvoid local fn DoAppEvent( ev as long )if ( ev == _appShouldTerminateAfterLastWindowClosed ) then AppEventSetBool( YES )end fnfn BuildWindowon dialog fn DoDialogon appevent fn DoAppEventHandleEvents