/* *   FB Wrappers Test.fb - can FB's own Cocoa functions do what the runtime's lines of C do? * *   The question behind it (author, 2026-11-28: "FB wraps the Objective-C Cocoa, so can we eliminate any inline C *   code in the generated apps?"). Most of the runtime's lines of C set a property on a view found across windows: *   a control dimmed, the window's subtitle, full screen, a symbol image, a JSON null. They are C because FB's *   functions find a view by its tag in the current output window only, and when an event arrives that is not always *   the app's window ("View does not exist", 2026-11-27). This program makes another window the current one, then *   names the app's window as the output (WindowSetOutput) and uses FB's functions - the FB way the runtime would *   take - and reads each value back. It also tries kCFNull, CoreFoundation's null (the same object as NSNull), in *   place of a line of C, without including Tlbx CFBase.incl. * *   Open it in FutureBasic and run it. The NSLog window shows a PASS or FAIL line for each, then the count; the app's *   window shows the dimmed Probe button with a symbol on it and "Saved." under its title. A build error answers a *   question too: paste the Build Log. */include "NSLog.incl"_appWindow   = 1_otherWindow = 2_probeButton = 10begin globalslong gTestsFailedend globalsvoid local fn TestReport( passed as BOOL, what as CFStringRef )if ( passed )NSLog( @"PASS  %@", what )elseNSLog( @"FAIL  %@", what )gTestsFailed++end ifend fnvoid local fn RunTestsCFTypeRef   nullValue = kCFNullCFDataRef   jsonCFStringRef jsonText = @""ErrorRef    err = NULLwindow _appWindow, @"The app's window", fn CGRectMake( 0, 0, 480, 220 )button _probeButton, YES, , @"Probe", fn CGRectMake( 20, 20, 140, 40 ), NSButtonTypeMomentaryPushIn, NSBezelStyleRounded, _appWindowwindow _otherWindow, @"Another window - the current output", fn CGRectMake( 520, 0, 360, 160 )// the app's window as the output again: FB's functions then find its views by their tagsWindowSetOutput( _appWindow )ViewSetAlphaValue( _probeButton, 0.4 )ControlSetEnabled( _probeButton, NO )WindowSetSubtitle( _appWindow, @"Saved." )WindowSetCollectionBehavior( _appWindow, fn WindowCollectionBehavior( _appWindow ) or NSWindowCollectionBehaviorFullScreenPrimary )ButtonSetImage( _probeButton, fn ImageWithSymbolConfiguration( fn ImageWithSystemSymbolName( @"forward.end.circle.fill", @"Last record" ), fn ImageSymbolConfigurationWithPointSize( 22.0, NSFontWeightSemibold ) ) )fn TestReport( fn ViewAlphaValue( _probeButton ) < 0.5, @"ViewSetAlphaValue: the button faded (a dimmed pill)" )fn TestReport( fn ControlIsEnabled( _probeButton ) == NO, @"ControlSetEnabled: the button disabled" )fn TestReport( fn StringIsEqual( fn WindowSubtitle( _appWindow ), @"Saved." ), @"WindowSetSubtitle: what just happened, under the title" )fn TestReport( ( fn WindowCollectionBehavior( _appWindow ) and NSWindowCollectionBehaviorFullScreenPrimary ) != 0, @"WindowSetCollectionBehavior: full screen allowed" )fn TestReport( fn ButtonImage( _probeButton ) != NULL, @"ButtonSetImage: an SF Symbol at 22 points, semibold" )// kCFNull: a JSON null, as the data runtime needs itfn TestReport( fn ObjectIsKindOfClass( (ObjectRef)nullValue, fn ClassFromString( @"NSNull" ) ), @"kCFNull is NSNull" )json = fn JSONSerializationDataWithJSONObject( @[ nullValue ], 0, @err )if ( json != NULL ) then jsonText = fn StringWithData( json, NSUTF8StringEncoding )fn TestReport( fn StringIsEqual( jsonText, @"[null]" ), @"kCFNull writes as null in JSON" )if ( gTestsFailed == 0 ) then NSLog( @"FB Wrappers Test: all passed - FB's functions can replace the runtime's lines of C" ) else NSLog( @"FB Wrappers Test: %ld failed", gTestsFailed )end fnfn RunTestsHandleEvents