/* *   I M A G E R Y    B U S I N E S S     S Y S T E M S,   L L C * *   MapKit Points Test.fb - a single-file FB program to run on a Mac (open it in FB, Run) * *   The Map view (docs/design/Map View Design.md) is built on Apple's MapKit.  Its points - an *   icon in a layer's colour, a bubble with details and a menu button - come through the map's *   _mapViewViewForAnnotation event, which no FBExample uses.  This program finds out how FB *   passes that event, before the runtime is built on it. * *   Five points: three customers (blue) and two suppliers (orange).  The popup chooses how the *   event is answered; each choice redraws the points.  Please report which choices show: *       - coloured markers with a person / shipping-box icon (not the default red pins) *       - a bubble on click, with two lines of details and a (i) button on its right *   and paste the NSLog lines ("MapTest: ..."). * *   MIT License. Copyright (c) 2026 Imagery Business Systems, LLC. */include "NSLog.incl"include "Tlbx MapKit.incl"_window = 1begin enum 1_mapView_modePopup_statusLabelend enumbegin globalslong gMapTestMode           // 0 default pins, 1 marker via DialogEventSetObject, 2 marker via DialogEventSetView, 3 plain view + image via DialogEventSetObjectend globals// a marker view (MKMarkerAnnotationView) for an annotation - FB's headers have its setters but no// constructor.  Retained on purpose, so it lives until MapKit holds it (a test: one leaks per point)local fn MapTestMarkerView( annotation as CFTypeRef ) as CFTypeRefcln return (__bridge_retained CFTypeRef)[[MKMarkerAnnotationView alloc] initWithAnnotation:(__bridge id<MKAnnotation>)annotation reuseIdentifier:@"marker"];end fn = NULL// the bubble's details: a wrapping label, and its right button: (i)local fn MapTestDetailView( subtitle as CFStringRef ) as CFTypeRefcln return (__bridge_retained CFTypeRef)[NSTextField wrappingLabelWithString:(__bridge NSString *)subtitle];end fn = NULLlocal fn MapTestInfoButton as CFTypeRefcln NSButton *b = [NSButton buttonWithImage:[NSImage imageWithSystemSymbolName:@"info.circle" accessibilityDescription:@"Details"] target:nil action:nil]; b.bordered = NO; return (__bridge_retained CFTypeRef)b;end fn = NULL// a point's subtitle ("Customer - ..." or "Supplier - ...")local fn MapTestSubtitle( annotation as CFTypeRef ) as CFStringRefcln return (__bridge CFStringRef)[(__bridge id<MKAnnotation>)annotation subtitle];end fn = NULL// the view for one point, in the chosen modelocal fn MapTestViewForAnnotation( annotation as MKAnnotationRef ) as MKAnnotationViewRefMKAnnotationViewRef vCFStringRef         symbolName = @"person.fill"ColorRef            colour = fn ColorSystemBlueCFStringRef         subtitle = fn MapTestSubtitle( (CFTypeRef)annotation )if ( subtitle != NULL )if ( fn StringHasPrefix( subtitle, @"Supplier" ) )symbolName = @"shippingbox.fill"colour = fn ColorSystemOrangeend ifend ifif ( gMapTestMode == 3 )v = fn MKAnnotationViewWithAnnotation( annotation, @"plain" )MKAnnotationViewSetImage( v, fn ImageWithSystemSymbolName( symbolName, @"Point" ) )elsev = (MKAnnotationViewRef)fn MapTestMarkerView( (CFTypeRef)annotation )MKMarkerAnnotationViewSetMarkerTintColor( (MKMarkerAnnotationViewRef)v, colour )MKMarkerAnnotationViewSetGlyphImage( (MKMarkerAnnotationViewRef)v, fn ImageWithSystemSymbolName( symbolName, @"Point" ) )end ifMKAnnotationViewSetCanShowCallout( v, YES )if ( subtitle != NULL ) then MKAnnotationViewSetDetailCalloutAccessoryView( v, (ViewRef)fn MapTestDetailView( fn StringByReplacingOccurrencesOfString( subtitle, @" - ", @"\n" ) ) )MKAnnotationViewSetRightCalloutAccessoryView( v, (ViewRef)fn MapTestInfoButton )end fn = vvoid local fn MapTestAddPoint( latitude as double, longitude as double, title as CFStringRef, subtitle as CFStringRef )CLLocationCoordinate2D coordinate = fn CLLocationCoordinate2DMake( latitude, longitude )MKMapViewAddAnnotation( _mapView, fn MKPointAnnotationWithTitle( coordinate, title, subtitle ) )end fn// (re)draw the five points: removing and adding them asks for their views againvoid local fn MapTestShowPointsCFArrayRef points = fn MKMapViewAnnotations( _mapView )if ( points != NULL ) then MKMapViewRemoveAnnotations( _mapView, points )fn MapTestAddPoint( 52.5200, 13.4050, @"Alfreds Futterkiste", @"Customer - Obere Str. 57, Berlin" )fn MapTestAddPoint( 51.5072, -0.1276, @"Around the Horn", @"Customer - 120 Hanover Sq., London" )fn MapTestAddPoint( 40.4168, -3.7038, @"Bólido Comidas preparadas", @"Customer - C/ Araquil, 67, Madrid" )fn MapTestAddPoint( 35.6762, 139.6503, @"Tokyo Traders", @"Supplier - 9-8 Sekimai Musashino-shi, Tokyo" )fn MapTestAddPoint( 59.3293, 18.0686, @"Svensk Sjöföda AB", @"Supplier - Brovallavägen 231, Stockholm" )MKMapViewShowAnnotations( _mapView, fn MKMapViewAnnotations( _mapView ), NO )ControlSetStringValue( _statusLabel, fn StringWithFormat( @"Mode %ld: %@", gMapTestMode, fn PopUpButtonTitleOfSelectedItem( _modePopup ) ) )end fnvoid local fn BuildWindowCGRect r = fn CGRectMake( 0, 0, 1000, 700 )window _window, @"MapKit Points Test", rpopupbutton _modePopup, YES, 0, @[ @"0 - not answered (default pins)", @"1 - marker, DialogEventSetObject", @"2 - marker, DialogEventSetView", @"3 - plain view + image, DialogEventSetObject" ], fn CGRectMake( 16, 660, 330, 28 )ViewSetAutoresizingMask( _modePopup, NSViewMinYMargin )textlabel _statusLabel, @"", fn CGRectMake( 360, 666, 620, 16 )ViewSetAutoresizingMask( _statusLabel, NSViewMinYMargin + NSViewWidthSizable )mkmapview _mapView, fn CGRectMake( 0, 0, 1000, 650 )ViewSetAutoresizingMask( _mapView, NSViewWidthSizable + NSViewHeightSizable )fn MapTestShowPointsend fnvoid local fn DoDialog( ev as long, tag as long, wnd as long )CFTypeRef           objMKAnnotationViewRef vselect ( ev )case _btnClickif ( tag == _modePopup )gMapTestMode = fn PopUpButtonIndexOfSelectedItem( _modePopup )fn MapTestShowPointsend ifcase _mapViewViewForAnnotationobj = fn DialogEventObjectNSLog( @"MapTest: _mapViewViewForAnnotation mode %ld, DialogEventObject is %@ (%@)", gMapTestMode, obj, fn ObjectClassName( (ObjectRef)obj ) )if ( gMapTestMode == 0 || obj == NULL ) then exit fnv = fn MapTestViewForAnnotation( (MKAnnotationRef)obj )if ( gMapTestMode == 2 ) then DialogEventSetView( (ViewRef)v ) else DialogEventSetObject( (CFTypeRef)v )case _mapViewDidSelectAnnotationViewobj = fn DialogEventObjectNSLog( @"MapTest: _mapViewDidSelectAnnotationView, DialogEventObject is %@ (%@), DialogEventView is %@", obj, fn ObjectClassName( (ObjectRef)obj ), fn DialogEventView )ControlSetStringValue( _statusLabel, fn StringWithFormat( @"Selected: %@", obj ) )end selectend fnfn BuildWindowon dialog fn DoDialogHandleEvents