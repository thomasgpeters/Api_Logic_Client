/* *   Web Session.incl - Web Toolkit for FutureBasic: one session per browser * *   A session is a dictionary: its id (the cookie), a token every event must carry (against requests forged by other *   sites), its widgets, the updates waiting for the browser, the app's own data, and when it was last used. The page *   is built once per session, by the app's build function (WebStart); a reload shows the session as it is. *   Sessions idle for WEB_SESSION_IDLE seconds are ended (Web Events.incl: the page lifecycle). * *       WebSessionData( session )     a dictionary for the app's own values (the selected customer ...) * *   MIT License. Copyright (c) 2026 Imagery Business Systems, LLC. See LICENSE. */#define WebSessionRef as CFMutableDictionaryRef#define WEB_COOKIE        @"fbweb"#define WEB_SESSION_IDLE  7200begin globalsCFMutableDictionaryRef gWebSessions      // session id -> sessionCFTypeRef              gWebBuildPage     // the app's page builder (an @fn, kept as a number)CFStringRef            gWebTitle         // the page's titleCFStringRef            gWebBase          // where the app is on the site: "/" (nginx's location)CFTypeRef              gWebSessionEnded  // the app's function for a session that ends (WebOnSessionEnd), or NULLCFTypeRef              gWebFieldEditedHook  // optional modules (Web Binding.incl) plug in here; the core knows no data modelCFTypeRef              gWebSaveDirtyHookCFStringRef            gWebTheme         // the theme a new session starts with: light, dark, colourful, or "" (the visitor's)end globals// a value kept in a global past this event. FB's globals hold plain pointers and do not retain, so a value made for the// moment (a number, a string read from a file) would be freed under the global when the event ends. Retains the new// value, releases the old (the licence's crash in App Builder, 2026-11-27, taught this).local fn WebKept( valueToKeep as CFTypeRef, valueBefore as CFTypeRef ) as CFTypeRefif ( valueToKeep != NULL ) then fn CFRetain( valueToKeep )if ( valueBefore != NULL ) then CFRelease( valueBefore )end fn = valueToKeep// bytes from the system's secure random source, as hex (a session id, a token)local fn WebRandomHex( byteCount as long ) as CFStringRefcln unsigned char bytes[64]; long n = byteCount > 64 ? 64 : byteCount; arc4random_buf( bytes, n ); NSMutableString *hex = [NSMutableString string]; for ( long i = 0; i < n; i++ ) [hex appendFormat:@"%02x", bytes[i]]; return (__bridge CFStringRef)hex;end fn = NULL// an @fn pointer kept in a dictionary, and called back (as LogicBank for FutureBasic calls its rules)local fn WebPointerNumber( handler as ptr ) as CFTypeRefcln return (__bridge CFTypeRef)[NSNumber numberWithLongLong:(long long)(intptr_t)handler];end fn = NULLvoid local fn WebCallWithSession( builderNumber as CFTypeRef, session as WebSessionRef )cln void *f = (void *)(intptr_t)[(__bridge NSNumber *)builderNumber longLongValue]; if ( f ) ((void (*)(CFMutableDictionaryRef))f)( session );end fnvoid local fn WebCallHandler( handlerNumber as CFTypeRef, session as WebSessionRef, widgetId as CFStringRef, eventValue as CFStringRef )cln void *f = (void *)(intptr_t)[(__bridge NSNumber *)handlerNumber longLongValue]; if ( f ) ((void (*)(CFMutableDictionaryRef, CFStringRef, CFStringRef))f)( session, widgetId, eventValue );end fnlocal fn WebNow as doubleend fn = fn DateTimeIntervalSinceReferenceDate( fn DateNow )local fn WebSessionData( session as WebSessionRef ) as CFMutableDictionaryRefend fn = (CFMutableDictionaryRef)fn DictionaryObjectForKey( session, @"data" )// the session named by the request's cookie, or NULLlocal fn WebSessionFromCookie( cookieHeader as CFStringRef ) as WebSessionRefCFArrayRef  partsCFStringRef part, prefix = fn StringWithFormat( @"%@=", WEB_COOKIE )WebSessionRef sessionif ( cookieHeader == NULL || gWebSessions == NULL ) then exit fn = NULLparts = fn StringComponentsSeparatedByString( cookieHeader, @";" )for part in partspart = fn StringByTrimmingCharactersInSet( part, fn CharacterSetWhitespaceSet )if ( fn StringHasPrefix( part, prefix ) )session = (WebSessionRef)fn DictionaryObjectForKey( gWebSessions, fn StringSubstringFromIndex( part, fn StringLength( prefix ) ) )if ( session ) then MutableDictionarySetObjectForKey( session, fn NumberWithDouble( fn WebNow ), @"lastSeen" )exit fn = sessionend ifnextend fn = NULL// a new session: its page built by the applocal fn WebSessionNew as WebSessionRefWebSessionRef session = fn MutableDictionaryNewCFMutableDictionaryRef page = fn MutableDictionaryNewCFStringRef sessionId = fn WebRandomHex( 16 )if ( gWebSessions == NULL ) then gWebSessions = fn WebKept( fn MutableDictionaryNew, gWebSessions )MutableDictionarySetObjectForKey( session, sessionId, @"id" )MutableDictionarySetObjectForKey( session, fn WebRandomHex( 16 ), @"token" )MutableDictionarySetObjectForKey( session, fn MutableDictionaryNew, @"widgets" )MutableDictionarySetObjectForKey( session, fn MutableArrayNew, @"updates" )MutableDictionarySetObjectForKey( session, fn MutableArrayNew, @"pending" )MutableDictionarySetObjectForKey( session, fn MutableDictionaryNew, @"data" )MutableDictionarySetObjectForKey( session, fn NumberWithBool( NO ), @"rendered" )MutableDictionarySetObjectForKey( session, fn NumberWithLong( 0 ), @"counter" )MutableDictionarySetObjectForKey( session, gWebTheme, @"theme" )MutableDictionarySetObjectForKey( session, fn NumberWithDouble( fn WebNow ), @"lastSeen" )// the page itself: the root of the widget treeMutableDictionarySetObjectForKey( page, @"page", @"id" )MutableDictionarySetObjectForKey( page, @"page", @"kind" )MutableDictionarySetObjectForKey( page, fn MutableDictionaryNew, @"props" )MutableDictionarySetObjectForKey( page, fn MutableArrayNew, @"children" )MutableDictionarySetObjectForKey( page, fn MutableDictionaryNew, @"events" )MutableDictionarySetObjectForKey( (CFMutableDictionaryRef)fn DictionaryObjectForKey( session, @"widgets" ), page, @"page" )MutableDictionarySetObjectForKey( gWebSessions, session, sessionId )fn WebCallWithSession( gWebBuildPage, session )end fn = session