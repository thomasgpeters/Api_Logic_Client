/* *   Web Server.incl - Web Toolkit for FutureBasic: the FastCGI server * *   nginx (or Apache) speaks HTTP to the browsers and FastCGI to this program. FastCGIServerStart listens on 127.0.0.1 *   and calls one FB function for every request - here, WebRequestArrived (Web Events.incl) - with nginx's parameters *   (REQUEST_METHOD, DOCUMENT_URI, QUERY_STRING, HTTP_COOKIE ...) and the body; it answers with a CGI response. *   The socket events run on the main queue, so FB code is only ever entered on the main thread. * *   The C between the "FastCGI core" markers is the same as src/MacTests/FastCGI Test.fb's, compiled and tested behind a *   real nginx by tools/check_fastcgi_core.py (which also checks the two copies are identical). * *   MIT License. Copyright (c) 2026 Imagery Business Systems, LLC. See LICENSE. */BeginCDeclaration#include <sys/socket.h>#include <netinet/in.h>#include <arpa/inet.h>#include <unistd.h>#include <fcntl.h>#include <errno.h>#include <string.h>#include <stdlib.h>long FastCGIServerStart( long port, void *handler );EndCBeginCFunction/* --- FastCGI core (portable C: tools/check_fastcgi_core.py compiles and tests exactly this) --- */enum { FCGI_BEGIN_REQUEST = 1, FCGI_ABORT_REQUEST = 2, FCGI_END_REQUEST = 3, FCGI_PARAMS = 4, FCGI_STDIN = 5,       FCGI_STDOUT = 6, FCGI_GET_VALUES = 9, FCGI_GET_VALUES_RESULT = 10, FCGI_UNKNOWN_TYPE = 11,       FCGI_RESPONDER = 1, FCGI_KEEP_CONN = 1, FCGI_MAX_PARAMS = 128, FCGI_MAX_BODY = 1048576 };typedef struct {    unsigned requestId;    int keepConn;    int paramCount;    char *names[FCGI_MAX_PARAMS];    char *values[FCGI_MAX_PARAMS];    unsigned char *body;    size_t bodyLength;} fcgi_request;void fcgi_request_free( fcgi_request *r ){    int i;    for ( i = 0; i < r->paramCount; i++ ) { free( r->names[i] ); free( r->values[i] ); }    free( r->body );    memset( r, 0, sizeof *r );}const char *fcgi_param( const fcgi_request *r, const char *name ){    int i;    for ( i = 0; i < r->paramCount; i++ ) if ( strcmp( r->names[i], name ) == 0 ) return r->values[i];    return "";}/* a name-value pair's length: one byte below 128, else four (the top bit set) */static int fcgi_length( const unsigned char *p, size_t left, size_t *length, size_t *used ){    if ( left < 1 ) return 0;    if ( p[0] < 128 ) { *length = p[0]; *used = 1; return 1; }    if ( left < 4 ) return 0;    *length = ( (size_t)( p[0] & 0x7f ) << 24 ) | ( (size_t)p[1] << 16 ) | ( (size_t)p[2] << 8 ) | p[3];    *used = 4;    return 1;}static int fcgi_add_params( fcgi_request *r, const unsigned char *p, size_t n ){    size_t at = 0, nameLength, valueLength, used;    while ( at < n ) {        if ( !fcgi_length( p + at, n - at, &nameLength, &used ) ) return -1;        at += used;        if ( !fcgi_length( p + at, n - at, &valueLength, &used ) ) return -1;        at += used;        if ( nameLength > n - at || valueLength > n - at - nameLength ) return -1;        if ( r->paramCount >= FCGI_MAX_PARAMS ) return -1;        r->names[r->paramCount] = malloc( nameLength + 1 );        r->values[r->paramCount] = malloc( valueLength + 1 );        memcpy( r->names[r->paramCount], p + at, nameLength );        r->names[r->paramCount][nameLength] = 0;        memcpy( r->values[r->paramCount], p + at + nameLength, valueLength );        r->values[r->paramCount][valueLength] = 0;        r->paramCount++;        at += nameLength + valueLength;    }    return 0;}/* the records received so far -> one whole request (1), not yet (0), or a broken stream (-1).   PARAMS (pairs) and STDIN (the body) end with an empty record of their type. */int fcgi_parse( const unsigned char *data, size_t length, fcgi_request *r ){    size_t at = 0;    int paramsDone = 0, began = 0;    unsigned char *body = NULL;    size_t bodyLength = 0;    memset( r, 0, sizeof *r );    while ( length - at >= 8 ) {        const unsigned char *h = data + at;        unsigned type = h[1], id = ( (unsigned)h[2] << 8 ) | h[3];        size_t contentLength = ( (size_t)h[4] << 8 ) | h[5], paddingLength = h[6];        const unsigned char *content = h + 8;        if ( h[0] != 1 ) { free( body ); fcgi_request_free( r ); return -1; }        if ( length - at < 8 + contentLength + paddingLength ) break;        at += 8 + contentLength + paddingLength;        if ( type == FCGI_BEGIN_REQUEST && contentLength >= 8 ) {            began = 1;            r->requestId = id;            r->keepConn = ( content[2] & FCGI_KEEP_CONN ) != 0;        } else if ( type == FCGI_PARAMS && id == r->requestId ) {            if ( contentLength == 0 ) paramsDone = 1;            else if ( fcgi_add_params( r, content, contentLength ) < 0 ) { free( body ); fcgi_request_free( r ); return -1; }        } else if ( type == FCGI_STDIN && id == r->requestId ) {            if ( contentLength == 0 ) {                if ( !began || !paramsDone ) break;                r->body = body ? body : calloc( 1, 1 );                r->bodyLength = bodyLength;                return 1;            }            if ( bodyLength + contentLength > FCGI_MAX_BODY ) { free( body ); fcgi_request_free( r ); return -1; }            body = realloc( body, bodyLength + contentLength + 1 );            memcpy( body + bodyLength, content, contentLength );            bodyLength += contentLength;            body[bodyLength] = 0;        }    }    free( body );    fcgi_request_free( r );    return 0;}static size_t fcgi_record( unsigned char *out, unsigned type, unsigned id, const unsigned char *content, size_t n ){    out[0] = 1; out[1] = (unsigned char)type; out[2] = (unsigned char)( id >> 8 ); out[3] = (unsigned char)id;    out[4] = (unsigned char)( n >> 8 ); out[5] = (unsigned char)n; out[6] = 0; out[7] = 0;    if ( n ) memcpy( out + 8, content, n );    return 8 + n;}/* a CGI response (headers, blank line, body) -> STDOUT records, the empty STDOUT, END_REQUEST; malloc'd, its length in *outLength */unsigned char *fcgi_response( unsigned id, const unsigned char *cgi, size_t length, size_t *outLength ){    size_t chunks = length / 65528 + 1, at = 0, n;    unsigned char *out = malloc( length + chunks * 8 + 8 + 16 ), *p = out;    unsigned char endBody[8] = { 0, 0, 0, 0, 0, 0, 0, 0 };   /* appStatus 0, protocolStatus REQUEST_COMPLETE */    while ( at < length ) {        n = length - at > 65528 ? 65528 : length - at;        p += fcgi_record( p, FCGI_STDOUT, id, cgi + at, n );        at += n;    }    p += fcgi_record( p, FCGI_STDOUT, id, NULL, 0 );    p += fcgi_record( p, FCGI_END_REQUEST, id, endBody, 8 );    *outLength = (size_t)( p - out );    return out;}/* --- end FastCGI core --- *//* the Mac side: listen on 127.0.0.1, read records on the main queue, call the FB handler, answer */typedef CFStringRef (*FastCGIHandlerFn)( CFDictionaryRef params, CFStringRef body );static FastCGIHandlerFn gFastCGIHandler = NULL;static dispatch_source_t gFastCGIListenSource = nil;static void FastCGIWriteAll( int fd, const unsigned char *bytes, size_t left ){    while ( left > 0 ) {        ssize_t n = write( fd, bytes, left );        if ( n < 0 && errno == EAGAIN ) continue;        if ( n <= 0 ) return;        bytes += n;        left -= (size_t)n;    }}static void FastCGIServeConnection( int fd ){    NSMutableData *buffer = [NSMutableData data];    fcntl( fd, F_SETFL, O_NONBLOCK );    __block dispatch_source_t source = dispatch_source_create( DISPATCH_SOURCE_TYPE_READ, fd, 0, dispatch_get_main_queue() );    dispatch_source_set_event_handler( source, ^{        unsigned char chunk[16384];        ssize_t n = read( fd, chunk, sizeof chunk );        if ( n <= 0 ) { dispatch_source_cancel( source ); return; }        [buffer appendBytes:chunk length:(NSUInteger)n];        fcgi_request r;        int state = fcgi_parse( buffer.bytes, buffer.length, &r );        if ( state < 0 ) { dispatch_source_cancel( source ); return; }        if ( state == 0 ) return;        NSMutableDictionary *params = [NSMutableDictionary dictionary];        for ( int i = 0; i < r.paramCount; i++ ) {            NSString *name = [NSString stringWithUTF8String:r.names[i]], *value = [NSString stringWithUTF8String:r.values[i]];            if ( name && value ) params[name] = value;        }        NSString *body = [[NSString alloc] initWithBytes:r.body length:r.bodyLength encoding:NSUTF8StringEncoding];        NSString *cgi = (__bridge NSString *)gFastCGIHandler( (__bridge CFDictionaryRef)params, (__bridge CFStringRef)( body ? body : @"" ) );        if ( cgi == nil ) cgi = @"Status: 404 Not Found\r\nContent-Type: text/plain; charset=utf-8\r\n\r\nNot found";        NSData *cgiData = [cgi dataUsingEncoding:NSUTF8StringEncoding];        size_t outLength = 0;        unsigned char *out = fcgi_response( r.requestId, cgiData.bytes, cgiData.length, &outLength );        FastCGIWriteAll( fd, out, outLength );        free( out );        int keep = r.keepConn;        fcgi_request_free( &r );        if ( keep ) [buffer setLength:0]; else dispatch_source_cancel( source );    });    dispatch_source_set_cancel_handler( source, ^{        close( fd );        source = nil;    });    dispatch_resume( source );}long FastCGIServerStart( long port, void *handler ){    gFastCGIHandler = (FastCGIHandlerFn)handler;    int s = socket( AF_INET, SOCK_STREAM, 0 );    if ( s < 0 ) return errno;    int yes = 1;    setsockopt( s, SOL_SOCKET, SO_REUSEADDR, &yes, sizeof yes );    struct sockaddr_in address;    memset( &address, 0, sizeof address );    address.sin_family = AF_INET;    address.sin_port = htons( (uint16_t)port );    address.sin_addr.s_addr = htonl( INADDR_LOOPBACK );    if ( bind( s, (struct sockaddr *)&address, sizeof address ) < 0 || listen( s, 64 ) < 0 ) { long e = errno; close( s ); return e; }    fcntl( s, F_SETFL, O_NONBLOCK );    gFastCGIListenSource = dispatch_source_create( DISPATCH_SOURCE_TYPE_READ, s, 0, dispatch_get_main_queue() );    dispatch_source_set_event_handler( gFastCGIListenSource, ^{        int c = accept( s, NULL, NULL );        if ( c >= 0 ) FastCGIServeConnection( c );    });    dispatch_resume( gFastCGIListenSource );    return 0;}EndCtoolbox fn FastCGIServerStart( long port, ptr handler ) = long