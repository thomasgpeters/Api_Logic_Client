/* *   Pages.incl - the Orders example: a web page on LogicBank for FutureBasic (Web Toolkit for FutureBasic) * *   Customers, their Orders and the Orders' Items, kept in memory (Data Memory.incl), with the LogicBank example's *   rules (Rules.incl): an item's amount, an order's total and count, a customer's balance and its credit limit. *   Every save from the page goes through the rules, in FutureBasic, on the server; what a rule refuses is shown in *   the form's message band, and what a rule derives (totals, balances) appears in the tables without a reload. *   Every visitor sees the same data: open the page in two browsers, save in one, switch to the other. * *   The Item form saves itself when the page is hidden or left (the lifecycle); the others ask before the page is *   left with unsaved changes. * *   MIT License. Copyright (c) 2026 Imagery Business Systems, LLC. See LICENSE. */// --- the app ---local fn AppTitle as CFStringRefend fn = @"Orders - Web Toolkit for FutureBasic"local fn Record3( names as CFArrayRef, first as CFTypeRef, second as CFTypeRef, third as CFTypeRef ) as CFMutableDictionaryRefCFMutableDictionaryRef aRecord = fn MutableDictionaryNewMutableDictionarySetObjectForKey( aRecord, first, fn ArrayObjectAtIndex( names, 0 ) )MutableDictionarySetObjectForKey( aRecord, second, fn ArrayObjectAtIndex( names, 1 ) )MutableDictionarySetObjectForKey( aRecord, third, fn ArrayObjectAtIndex( names, 2 ) )end fn = aRecordlocal fn AddItem( orderId as long, product as CFStringRef, quantity as double, unitPrice as double ) as BOOLCFMutableDictionaryRef anItem = fn Record3( @[ @"OrderId", @"Product", @"Quantity" ], fn NumberWithLong( orderId ), product, fn NumberWithDouble( quantity ) )MutableDictionarySetObjectForKey( anItem, fn NumberWithDouble( unitPrice ), @"UnitPrice" )end fn = fn LogicInsert( @"Item", anItem )// the rules, checked against the model; a few customers and orders to start with - all saved through the ruleslocal fn AppStarting as BOOLfn DataMemoryResetfn DeclareRulesif ( fn LogicActivate == NO ) then exit fn = NOfn LogicInsert( @"Customer", fn Record3( @[ @"Name", @"CreditLimit", @"Discount" ], @"Alice Outerbridge", fn NumberWithDouble( 1000 ), fn NumberWithDouble( 10 ) ) )fn LogicInsert( @"Customer", fn Record3( @[ @"Name", @"CreditLimit", @"Discount" ], @"Bermuda Sails Ltd", fn NumberWithDouble( 5000 ), fn NumberWithDouble( 5 ) ) )fn LogicInsert( @"Customer", fn Record3( @[ @"Name", @"CreditLimit", @"Discount" ], @"Carmen Trott", fn NumberWithDouble( 400 ), fn NumberWithDouble( 0 ) ) )fn LogicInsert( @"Order", fn MutableDictionaryWithDictionary( @{ @"CustomerId" : @1 } ) )fn AddItem( 1, @"Widget", 2, 100 )fn AddItem( 1, @"Gadget", 1, 300 )fn LogicInsert( @"Order", fn MutableDictionaryWithDictionary( @{ @"CustomerId" : @2 } ) )fn AddItem( 2, @"Mainsail", 1, 2400 )fn AddItem( 2, @"Shackle", 12, 18.5 )end fn = YES// --- what is chosen (each visitor's own) ---local fn ChosenId( session as WebSessionRef, entityName as CFStringRef ) as longCFTypeRef chosen = fn DictionaryObjectForKey( fn WebSessionData( session ), entityName )if ( chosen == NULL ) then exit fn = 0end fn = fn NumberLongValue( chosen )void local fn Choose( session as WebSessionRef, entityName as CFStringRef, keyValue as long )MutableDictionarySetObjectForKey( fn WebSessionData( session ), fn NumberWithLong( keyValue ), entityName )end fnlocal fn KeyOf( aRecord as CFDictionaryRef ) as longif ( aRecord == NULL ) then exit fn = 0end fn = fn StringIntegerValue( fn WebValueText( fn DictionaryObjectForKey( aRecord, @"Id" ) ) )// the Item form, empty, for a new item of the chosen ordervoid local fn ItemFormEmpty( session as WebSessionRef )fn WebFormNew( session, @"itemForm" )fn WebFormSetRecordValue( session, @"itemForm", @"OrderId", fn NumberWithLong( fn ChosenId( session, @"Order" ) ) )end fn// --- showing ---void local fn ShowItems( session as WebSessionRef )long orderId = fn ChosenId( session, @"Order" )fn WebTableShowEntity( session, @"items", @"Item", @{ @"OrderId" : fn NumberWithLong( orderId ) }, @[ @"Id" ] )if ( orderId == 0 ) then fn WebSetText( session, @"itemsTitle", @"Items" ) else fn WebSetText( session, @"itemsTitle", fn StringWithFormat( @"Items of order %ld", orderId ) )fn WebSetEnabled( session, @"itemNew", ( orderId != 0 ) )end fnvoid local fn ShowOrders( session as WebSessionRef )long customerId = fn ChosenId( session, @"Customer" )CFDictionaryRef customer = fn DataFetchOne( @"Customer", @{ @"Id" : fn NumberWithLong( customerId ) } )fn WebTableShowEntity( session, @"orders", @"Order", @{ @"CustomerId" : fn NumberWithLong( customerId ) }, @[ @"Id" ] )if ( customer ) then fn WebSetText( session, @"ordersTitle", fn StringWithFormat( @"Orders of %@", fn WebValueText( fn DictionaryObjectForKey( customer, @"Name" ) ) ) ) else fn WebSetText( session, @"ordersTitle", @"Orders" )fn WebSetEnabled( session, @"orderNew", ( customerId != 0 ) )end fn// the order form's customer choices follow the customersvoid local fn ShowCustomerChoices( session as WebSessionRef )fn WebSetOptions( session, @"orderCustomer", fn WebChoicesFromEntity( @"Customer", @"Id", @"Name", @"Choose a customer" ) )end fn// everything read again: after a save that the rules carried further, or when the visitor comes backvoid local fn RefreshAll( session as WebSessionRef )fn WebTableRefresh( session, @"customers" )fn WebTableRefresh( session, @"orders" )fn WebTableRefresh( session, @"items" )fn ShowCustomerChoices( session )// a form without unsaved changes shows its record as it is now (a balance, a total)if ( fn WebFormIsDirty( session, @"customerForm" ) == NO && fn WebFormIsNew( session, @"customerForm" ) == NO ) then fn WebFormShowRecord( session, @"customerForm", fn DataFetchOne( @"Customer", @{ @"Id" : fn NumberWithLong( fn ChosenId( session, @"Customer" ) ) } ) )if ( fn WebFormIsDirty( session, @"orderForm" ) == NO && fn WebFormIsNew( session, @"orderForm" ) == NO ) then fn WebFormShowRecord( session, @"orderForm", fn DataFetchOne( @"Order", @{ @"Id" : fn NumberWithLong( fn ChosenId( session, @"Order" ) ) } ) )end fn// --- customers ---void local fn CustomerSelected( session as WebSessionRef, widgetId as CFStringRef, eventValue as CFStringRef )CFDictionaryRef customer = fn WebSelectedRecord( session, @"customers" )fn WebFormShowRecord( session, @"customerForm", customer )fn WebFormSay( session, @"customerForm", @"", @"info" )fn Choose( session, @"Customer", fn KeyOf( customer ) )fn Choose( session, @"Order", 0 )fn WebFormNew( session, @"orderForm" )fn ItemFormEmpty( session )fn ShowOrders( session )fn ShowItems( session )end fnvoid local fn CustomerNew( session as WebSessionRef, widgetId as CFStringRef, eventValue as CFStringRef )fn WebFormNew( session, @"customerForm" )fn WebSetSelectedRow( session, @"customers", -1 )fn WebFocus( session, @"customerName" )end fnvoid local fn CustomerSave( session as WebSessionRef, widgetId as CFStringRef, eventValue as CFStringRef )fn WebFormSave( session, @"customerForm" )end fnvoid local fn CustomerDelete( session as WebSessionRef, widgetId as CFStringRef, eventValue as CFStringRef )fn WebFormDelete( session, @"customerForm" )end fn// the form fired "saved": the customer is the chosen onevoid local fn CustomerSaved( session as WebSessionRef, widgetId as CFStringRef, eventValue as CFStringRef )fn Choose( session, @"Customer", fn KeyOf( fn WebFormShownRecord( session, @"customerForm" ) ) )fn RefreshAll( session )fn ShowOrders( session )end fnvoid local fn CustomerDeleted( session as WebSessionRef, widgetId as CFStringRef, eventValue as CFStringRef )fn Choose( session, @"Customer", 0 )fn RefreshAll( session )fn ShowOrders( session )end fn// --- orders ---void local fn OrderSelected( session as WebSessionRef, widgetId as CFStringRef, eventValue as CFStringRef )CFDictionaryRef anOrder = fn WebSelectedRecord( session, @"orders" )fn WebFormShowRecord( session, @"orderForm", anOrder )fn WebFormSay( session, @"orderForm", @"", @"info" )fn Choose( session, @"Order", fn KeyOf( anOrder ) )fn ItemFormEmpty( session )fn ShowItems( session )end fnvoid local fn OrderNew( session as WebSessionRef, widgetId as CFStringRef, eventValue as CFStringRef )fn WebFormNew( session, @"orderForm" )fn WebSetValue( session, @"orderCustomer", fn NumberWithLong( fn ChosenId( session, @"Customer" ) ) )fn WebSetSelectedRow( session, @"orders", -1 )end fnvoid local fn OrderSave( session as WebSessionRef, widgetId as CFStringRef, eventValue as CFStringRef )fn WebFormSave( session, @"orderForm" )end fnvoid local fn OrderDelete( session as WebSessionRef, widgetId as CFStringRef, eventValue as CFStringRef )fn WebFormDelete( session, @"orderForm" )end fn// shipped today: the order no longer counts against the customer's credit (the rules move the balance)void local fn OrderShip( session as WebSessionRef, widgetId as CFStringRef, eventValue as CFStringRef )CFDateFormatterRef formatter = fn DateFormatterInitDateFormatterSetDateFormat( formatter, @"yyyy-MM-dd" )fn WebSetValue( session, @"orderShipped", fn DateFormatterStringFromDate( formatter, fn DateNow ) )fn WebFormSave( session, @"orderForm" )end fnvoid local fn OrderSaved( session as WebSessionRef, widgetId as CFStringRef, eventValue as CFStringRef )fn Choose( session, @"Order", fn KeyOf( fn WebFormShownRecord( session, @"orderForm" ) ) )fn RefreshAll( session )fn ShowItems( session )end fnvoid local fn OrderDeleted( session as WebSessionRef, widgetId as CFStringRef, eventValue as CFStringRef )fn Choose( session, @"Order", 0 )fn ItemFormEmpty( session )fn RefreshAll( session )fn ShowItems( session )end fn// --- items ---void local fn ItemSelected( session as WebSessionRef, widgetId as CFStringRef, eventValue as CFStringRef )fn WebFormShowRecord( session, @"itemForm", fn WebSelectedRecord( session, @"items" ) )fn WebFormSay( session, @"itemForm", @"", @"info" )end fnvoid local fn ItemNew( session as WebSessionRef, widgetId as CFStringRef, eventValue as CFStringRef )fn ItemFormEmpty( session )fn WebSetSelectedRow( session, @"items", -1 )fn WebFocus( session, @"itemProduct" )end fnvoid local fn ItemSave( session as WebSessionRef, widgetId as CFStringRef, eventValue as CFStringRef )if ( fn ChosenId( session, @"Order" ) == 0 )fn WebFormSay( session, @"itemForm", @"Choose an order first.", @"warning" )exit fnend iffn WebFormSave( session, @"itemForm" )end fnvoid local fn ItemDelete( session as WebSessionRef, widgetId as CFStringRef, eventValue as CFStringRef )fn WebFormDelete( session, @"itemForm" )end fnvoid local fn ItemChanged( session as WebSessionRef, widgetId as CFStringRef, eventValue as CFStringRef )fn RefreshAll( session )end fn// --- the page's lifecycle, and the theme ---// a reload, or the visitor's return: other visitors may have changed the data meanwhilevoid local fn PageShown( session as WebSessionRef, widgetId as CFStringRef, eventValue as CFStringRef )if ( fn StringIsEqual( eventValue, @"again" ) ) then fn RefreshAll( session )end fnvoid local fn PageHidden( session as WebSessionRef, widgetId as CFStringRef, eventValue as CFStringRef )end fnvoid local fn PageVisible( session as WebSessionRef, widgetId as CFStringRef, eventValue as CFStringRef )fn RefreshAll( session )end fnvoid local fn PageLeaving( session as WebSessionRef, widgetId as CFStringRef, eventValue as CFStringRef )end fnvoid local fn SessionEnded( session as WebSessionRef )end fnvoid local fn ThemeChanged( session as WebSessionRef, widgetId as CFStringRef, eventValue as CFStringRef )fn WebSetTheme( session, eventValue )end fn// --- the page ---void local fn BuildCustomers( session as WebSessionRef )fn WebContainer( session, @"top", @"customersBox", @"column" )fn WebHeading( session, @"customersBox", @"customersTitle", @"Customers", 2 )fn WebTable( session, @"customersBox", @"customers", @[ @{ @"key" : @"Name", @"title" : @"Name" }, @{ @"key" : @"CreditLimit", @"title" : @"Credit limit", @"align" : @"end" }, @{ @"key" : @"Discount", @"title" : @"Discount %", @"align" : @"end" }, @{ @"key" : @"Balance", @"title" : @"Balance", @"align" : @"end" }, @{ @"key" : @"UnshippedOrders", @"title" : @"Unshipped", @"align" : @"end" } ] )fn WebOn( session, @"customers", @"selected", @fn CustomerSelected )fn WebTableShowEntity( session, @"customers", @"Customer", NULL, @[ @"Name" ] )fn WebContainer( session, @"top", @"customerForm", @"form" )fn WebHeading( session, @"customerForm", @"customerFormTitle", @"Customer", 3 )fn WebMessage( session, @"customerForm", @"customerMessage", @"", @"info" )fn WebField( session, @"customerForm", @"customerName", @"Name", @"text", @"" )fn WebContainer( session, @"customerForm", @"customerNumbers", @"row" )fn WebField( session, @"customerNumbers", @"customerLimit", @"Credit limit", @"number", @"0" )fn WebField( session, @"customerNumbers", @"customerDiscount", @"Discount %", @"number", @"0" )fn WebField( session, @"customerNumbers", @"customerBalance", @"Balance (the rules)", @"number", @"" )fn WebSetEnabled( session, @"customerBalance", NO )fn WebContainer( session, @"customerForm", @"customerButtons", @"toolbar" )fn WebButton( session, @"customerButtons", @"customerSave", @"Save", @"primary" )fn WebButton( session, @"customerButtons", @"customerNew", @"New Customer", @"secondary" )fn WebButton( session, @"customerButtons", @"customerDelete", @"Delete", @"danger" )fn WebFormBind( session, @"customerForm", @"Customer", @"customerMessage" )fn WebBindField( session, @"customerForm", @"customerName", @"Name" )fn WebBindField( session, @"customerForm", @"customerLimit", @"CreditLimit" )fn WebBindField( session, @"customerForm", @"customerDiscount", @"Discount" )fn WebBindField( session, @"customerForm", @"customerBalance", @"Balance" )fn WebOn( session, @"customerSave", @"clicked", @fn CustomerSave )fn WebOn( session, @"customerForm", @"submitted", @fn CustomerSave )fn WebOn( session, @"customerNew", @"clicked", @fn CustomerNew )fn WebOn( session, @"customerDelete", @"clicked", @fn CustomerDelete )fn WebOn( session, @"customerForm", @"saved", @fn CustomerSaved )fn WebOn( session, @"customerForm", @"deleted", @fn CustomerDeleted )end fnvoid local fn BuildOrders( session as WebSessionRef )fn WebContainer( session, @"middle", @"ordersBox", @"column" )fn WebHeading( session, @"ordersBox", @"ordersTitle", @"Orders", 2 )fn WebTable( session, @"ordersBox", @"orders", @[ @{ @"key" : @"Id", @"title" : @"Order" }, @{ @"key" : @"ShippedDate", @"title" : @"Shipped" }, @{ @"key" : @"ItemCount", @"title" : @"Items", @"align" : @"end" }, @{ @"key" : @"Discount", @"title" : @"Discount %", @"align" : @"end" }, @{ @"key" : @"AmountTotal", @"title" : @"Total", @"align" : @"end" } ] )fn WebOn( session, @"orders", @"selected", @fn OrderSelected )fn WebContainer( session, @"middle", @"orderForm", @"form" )fn WebHeading( session, @"orderForm", @"orderFormTitle", @"Order", 3 )fn WebMessage( session, @"orderForm", @"orderMessage", @"", @"info" )fn WebSelect( session, @"orderForm", @"orderCustomer", @"Customer", @[] )fn WebField( session, @"orderForm", @"orderShipped", @"Shipped on", @"date", @"" )fn WebContainer( session, @"orderForm", @"orderNumbers", @"row" )fn WebField( session, @"orderNumbers", @"orderDiscount", @"Discount % (the customer's)", @"number", @"" )fn WebField( session, @"orderNumbers", @"orderTotal", @"Total (the rules)", @"number", @"" )fn WebSetEnabled( session, @"orderDiscount", NO )fn WebSetEnabled( session, @"orderTotal", NO )fn WebContainer( session, @"orderForm", @"orderButtons", @"toolbar" )fn WebButton( session, @"orderButtons", @"orderSave", @"Save", @"primary" )fn WebButton( session, @"orderButtons", @"orderShip", @"Ship Today", @"success" )fn WebButton( session, @"orderButtons", @"orderNew", @"New Order", @"secondary" )fn WebButton( session, @"orderButtons", @"orderDelete", @"Delete", @"danger" )fn WebFormBind( session, @"orderForm", @"Order", @"orderMessage" )fn WebBindField( session, @"orderForm", @"orderCustomer", @"CustomerId" )fn WebBindField( session, @"orderForm", @"orderShipped", @"ShippedDate" )fn WebBindField( session, @"orderForm", @"orderDiscount", @"Discount" )fn WebBindField( session, @"orderForm", @"orderTotal", @"AmountTotal" )fn WebOn( session, @"orderSave", @"clicked", @fn OrderSave )fn WebOn( session, @"orderForm", @"submitted", @fn OrderSave )fn WebOn( session, @"orderShip", @"clicked", @fn OrderShip )fn WebOn( session, @"orderNew", @"clicked", @fn OrderNew )fn WebOn( session, @"orderDelete", @"clicked", @fn OrderDelete )fn WebOn( session, @"orderForm", @"saved", @fn OrderSaved )fn WebOn( session, @"orderForm", @"deleted", @fn OrderDeleted )end fnvoid local fn BuildItems( session as WebSessionRef )fn WebContainer( session, @"bottom", @"itemsBox", @"column" )fn WebHeading( session, @"itemsBox", @"itemsTitle", @"Items", 2 )fn WebTable( session, @"itemsBox", @"items", @[ @{ @"key" : @"Product", @"title" : @"Product" }, @{ @"key" : @"Quantity", @"title" : @"Quantity", @"align" : @"end" }, @{ @"key" : @"UnitPrice", @"title" : @"Unit price", @"align" : @"end" }, @{ @"key" : @"Amount", @"title" : @"Amount", @"align" : @"end" } ] )fn WebOn( session, @"items", @"selected", @fn ItemSelected )fn WebContainer( session, @"bottom", @"itemForm", @"form" )fn WebHeading( session, @"itemForm", @"itemFormTitle", @"Item", 3 )fn WebText( session, @"itemForm", @"itemNote", @"This form saves itself when you switch to another tab or leave the page.", @"muted" )fn WebMessage( session, @"itemForm", @"itemMessage", @"", @"info" )fn WebField( session, @"itemForm", @"itemProduct", @"Product", @"text", @"" )fn WebContainer( session, @"itemForm", @"itemNumbers", @"row" )fn WebField( session, @"itemNumbers", @"itemQuantity", @"Quantity", @"number", @"1" )fn WebField( session, @"itemNumbers", @"itemPrice", @"Unit price", @"number", @"0.00" )fn WebField( session, @"itemNumbers", @"itemAmount", @"Amount (the rules)", @"number", @"" )fn WebSetEnabled( session, @"itemAmount", NO )fn WebContainer( session, @"itemForm", @"itemButtons", @"toolbar" )fn WebButton( session, @"itemButtons", @"itemSave", @"Save", @"primary" )fn WebButton( session, @"itemButtons", @"itemNew", @"New Item", @"secondary" )fn WebButton( session, @"itemButtons", @"itemDelete", @"Delete", @"danger" )fn WebFormBind( session, @"itemForm", @"Item", @"itemMessage" )fn WebBindField( session, @"itemForm", @"itemProduct", @"Product" )fn WebBindField( session, @"itemForm", @"itemQuantity", @"Quantity" )fn WebBindField( session, @"itemForm", @"itemPrice", @"UnitPrice" )fn WebBindField( session, @"itemForm", @"itemAmount", @"Amount" )fn WebFormAutoSave( session, @"itemForm", YES )fn WebOn( session, @"itemSave", @"clicked", @fn ItemSave )fn WebOn( session, @"itemForm", @"submitted", @fn ItemSave )fn WebOn( session, @"itemNew", @"clicked", @fn ItemNew )fn WebOn( session, @"itemDelete", @"clicked", @fn ItemDelete )fn WebOn( session, @"itemForm", @"saved", @fn ItemChanged )fn WebOn( session, @"itemForm", @"deleted", @fn ItemChanged )end fnvoid local fn BuildPage( session as WebSessionRef )fn WebHeading( session, @"page", @"title", @"Orders", 1 )fn WebText( session, @"page", @"intro", @"Customers, their orders and items. Every save runs LogicBank for FutureBasic's rules, in FutureBasic, on the server - totals and balances follow without a reload.", @"lead" )fn WebContainer( session, @"page", @"bar", @"toolbar" )fn WebSelect( session, @"bar", @"theme", @"", @[ @{ @"code" : @"", @"title" : @"Theme: as the system" }, @{ @"code" : @"light", @"title" : @"Light" }, @{ @"code" : @"dark", @"title" : @"Dark" }, @{ @"code" : @"colourful", @"title" : @"Colourful" }, @{ @"code" : @"base", @"title" : @"Base" } ] )fn WebOn( session, @"theme", @"changed", @fn ThemeChanged )fn WebContainer( session, @"page", @"top", @"row" )fn WebContainer( session, @"page", @"middle", @"row" )fn WebContainer( session, @"page", @"bottom", @"row" )fn BuildCustomers( session )fn BuildOrders( session )fn BuildItems( session )fn ShowCustomerChoices( session )fn ShowOrders( session )fn ShowItems( session )fn WebOn( session, @"page", @"shown", @fn PageShown )fn WebOn( session, @"page", @"hidden", @fn PageHidden )fn WebOn( session, @"page", @"visible", @fn PageVisible )fn WebOn( session, @"page", @"leaving", @fn PageLeaving )end fn