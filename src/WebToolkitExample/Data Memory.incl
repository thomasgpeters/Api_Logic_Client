/* *   Data Memory.incl - LogicBank for FutureBasic's data layer, in memory: no database * *   The rules engine reads and writes records through a small set of Data... calls. This file answers them *   from objects held in memory, so the engine runs with no database at all - for an example, a test, or an *   app that keeps its data some other way. Data Records.incl answers the same calls from SQLite (built on *   the SQL Generator): include one or the other, never both. * *   The model (entities, their fields, keys and relationships) comes from Data Model.incl, as with SQLite: *   the app's Model.json resource. * *   A record is a mutable dictionary: field name -> NSNumber / NSString / NSNull. Everything handed out is *   a copy, as SQLite hands out rows: the stored objects change only through DataInsert / DataUpdate / *   DataDelete. DataBegin / DataEnd nest like a transaction: when any part ends with keep = NO, the outermost *   DataEnd puts every object back as it was at the outermost DataBegin. * *       DataMemoryReset                       empty every entity *       DataMemoryRecords( entity )           every record of the entity (copies), in insert order *       DataFetch( entity, filter, order )    records matching field = value filters *       DataFetchOne( entity, filter )        the first match, or NULL *       DataParent( entity, record, role )    the record's parent along a toone role *       DataChildren( entity, record, list )  the record's children along a tomany list *       DataInsert( entity, record )          YES/NO; a generated key (max + 1) is set in record *       DataUpdate( entity, record, keys )    records changed *       DataDelete( entity, keys )            records deleted * *   Logging: every NSLog is gated on isLoggingOn, which the app declares in its own globals (NO by default). * *   MIT License. Copyright (c) 2026 Imagery Business Systems, LLC. See LICENSE. */begin globalslong gDataTransactionDepth         // DataBegin / DataEnd nestingBOOL gDataRollbackOnly             // a nested part failed: the outermost DataEnd puts everything backCFMutableDictionaryRef gDataMemory          // entity -> [ records ]CFMutableDictionaryRef gDataMemorySnapshot  // the objects at the outermost DataBeginend globals// an empty value (dictionaries cannot hold NULL)local fn DataNull as CFTypeRefcln return (__bridge CFTypeRef)[NSNull null];end fn = NULLlocal fn DataIsNull( value as CFTypeRef ) as BOOLif ( value == NULL ) then exit fn = YESend fn = fn ObjectIsKindOfClass( (ObjectRef)value, fn ClassFromString( @"NSNull" ) )// every entity's records copied, record by record (a snapshot, or a restore)local fn DataMemoryCopyAll( source as CFDictionaryRef ) as CFMutableDictionaryRefCFMutableDictionaryRef copied = fn MutableDictionaryNewCFMutableArrayRef      listCFArrayRef             entities, recordsCFStringRef            entityNameCFDictionaryRef        storedif ( source == NULL ) then exit fn = copiedentities = fn DictionaryAllKeys( source )for entityName in entitieslist = fn MutableArrayNewrecords = fn DictionaryObjectForKey( source, entityName )for stored in recordsMutableArrayAddObject( list, fn MutableDictionaryWithDictionary( stored ) )nextMutableDictionarySetObjectForKey( copied, list, entityName )nextend fn = copiedvoid local fn DataMemoryResetgDataMemory = (CFMutableDictionaryRef)fn DataKept( fn MutableDictionaryNew, gDataMemory )   // kept: a global does not keep its value alivegDataTransactionDepth = 0gDataRollbackOnly = NOend fn// the entity's stored records (the objects themselves: only this file changes them)local fn DataMemoryStore( entityName as CFStringRef ) as CFMutableArrayRefCFMutableArrayRef recordsif ( gDataMemory == NULL ) then fn DataMemoryResetrecords = (CFMutableArrayRef)fn DictionaryObjectForKey( gDataMemory, entityName )if ( records == NULL )records = fn MutableArrayNewMutableDictionarySetObjectForKey( gDataMemory, records, entityName )end ifend fn = records// do the record's fields hold the filter's values?  (an empty filter value matches an empty field)local fn DataMemoryMatches( aRecord as CFDictionaryRef, filter as CFDictionaryRef ) as BOOLCFArrayRef  namesCFStringRef fieldNameCFTypeRef   wanted, valueif ( filter == NULL ) then exit fn = YESnames = fn DictionaryAllKeys( filter )for fieldName in nameswanted = fn DictionaryObjectForKey( filter, fieldName )value  = fn DictionaryObjectForKey( aRecord, fieldName )if ( fn DataIsNull( wanted ) )if ( fn DataIsNull( value ) == NO ) then exit fn = NOelseif ( fn DataIsNull( value ) ) then exit fn = NOif ( fn ObjectIsEqual( (ObjectRef)value, (ObjectRef)wanted ) == NO ) then exit fn = NOend ifnextend fn = YESlocal fn DataMemoryRecords( entityName as CFStringRef ) as CFMutableArrayRefCFMutableArrayRef      rows = fn MutableArrayNewCFArrayRef             records = fn DataMemoryStore( entityName )CFDictionaryRef        storedfor stored in recordsMutableArrayAddObject( rows, fn MutableDictionaryWithDictionary( stored ) )nextend fn = rows// the key fields' values of a recordlocal fn DataKeyValues( entityName as CFStringRef, aRecord as CFDictionaryRef ) as CFMutableDictionaryRefCFMutableDictionaryRef keyValues = fn MutableDictionaryNewCFArrayRef             keys = fn DataKeys( entityName )CFStringRef            keyNameCFTypeRef              valuefor keyName in keysvalue = fn DictionaryObjectForKey( aRecord, keyName )if ( value == NULL ) then value = fn DataNullMutableDictionarySetObjectForKey( keyValues, value, keyName )nextend fn = keyValues// field = value filters, all of them (AND); orderNames: fields to sort by, or NULL for insert orderlocal fn DataFetch( entityName as CFStringRef, filter as CFDictionaryRef, orderNames as CFArrayRef ) as CFMutableArrayRefCFMutableArrayRef rows = fn MutableArrayNewCFArrayRef        records = fn DataMemoryStore( entityName )CFDictionaryRef   storedif ( fn ArrayCount( fn DataColumns( entityName ) ) == 0 )if ( isLoggingOn ) then NSLog( @"Data: %@ is not in the model.", entityName )exit fn = rowsend iffor stored in recordsif ( fn DataMemoryMatches( stored, filter ) ) then MutableArrayAddObject( rows, fn MutableDictionaryWithDictionary( stored ) )nextif ( orderNames != NULL )cln NSMutableArray *sortable = (__bridge NSMutableArray *)rows; NSMutableArray *by = [NSMutableArray array]; for ( NSString *name in (__bridge NSArray *)orderNames ) [by addObject:[NSSortDescriptor sortDescriptorWithKey:name ascending:YES]]; [sortable sortUsingDescriptors:by];end ifend fn = rowslocal fn DataFetchOne( entityName as CFStringRef, filter as CFDictionaryRef ) as CFMutableDictionaryRefCFMutableArrayRef rows = fn DataFetch( entityName, filter, NULL )if ( fn ArrayCount( rows ) == 0 ) then exit fn = NULLend fn = (CFMutableDictionaryRef)fn ArrayObjectAtIndex( rows, 0 )// the record's parent along a toone role (e.g. an Order's "Customer"); NULL when the// foreign key is empty or the parent is missinglocal fn DataParent( entityName as CFStringRef, aRecord as CFDictionaryRef, roleName as CFStringRef ) as CFMutableDictionaryRefCFDictionaryRef        relationship = fn DataRelationship( entityName, roleName )CFMutableDictionaryRef filter = fn MutableDictionaryNewCFArrayRef             fks, parentKeysCFTypeRef              valuelong                   iif ( relationship == NULL ) then exit fn = NULLfks        = fn DictionaryObjectForKey( relationship, @"fks" )parentKeys = fn DictionaryObjectForKey( relationship, @"parentKeys" )for i = 0 to (long)fn ArrayCount( fks ) - 1value = fn DictionaryObjectForKey( aRecord, fn ArrayObjectAtIndex( fks, i ) )if ( fn DataIsNull( value ) ) then exit fn = NULLMutableDictionarySetObjectForKey( filter, value, fn ArrayObjectAtIndex( parentKeys, i ) )nextend fn = fn DataFetchOne( fn DictionaryObjectForKey( relationship, @"resource" ), filter )// the record's children along a tomany list (e.g. a Customer's "OrderList")local fn DataChildren( entityName as CFStringRef, aRecord as CFDictionaryRef, listName as CFStringRef ) as CFMutableArrayRefCFDictionaryRef        relationship = fn DataRelationship( entityName, listName )CFMutableDictionaryRef filter = fn MutableDictionaryNewCFArrayRef             fks, parentKeysCFTypeRef              valuelong                   iif ( relationship == NULL ) then exit fn = fn MutableArrayNewfks        = fn DictionaryObjectForKey( relationship, @"fks" )parentKeys = fn DictionaryObjectForKey( relationship, @"parentKeys" )for i = 0 to (long)fn ArrayCount( fks ) - 1value = fn DictionaryObjectForKey( aRecord, fn ArrayObjectAtIndex( parentKeys, i ) )if ( fn DataIsNull( value ) ) then exit fn = fn MutableArrayNewMutableDictionarySetObjectForKey( filter, value, fn ArrayObjectAtIndex( fks, i ) )nextend fn = fn DataFetch( fn DictionaryObjectForKey( relationship, @"resource" ), filter, NULL )// store a copy of the record's fields; an empty generated key (identity / autoincrement) becomes the// highest key so far + 1, and is set in the record. NO when a record with the same key exists.local fn DataInsert( entityName as CFStringRef, aRecord as CFMutableDictionaryRef ) as BOOLCFMutableArrayRef      records = fn DataMemoryStore( entityName )CFArrayRef             columns = fn DataColumns( entityName )CFArrayRef             keys    = fn DataKeys( entityName )CFMutableDictionaryRef stored  = fn MutableDictionaryNewCFDictionaryRef        existingCFStringRef            columnName, keyNameCFTypeRef              valuelong                   highest = 0if ( fn ArrayCount( columns ) == 0 || fn DataIsView( entityName ) ) then exit fn = NOif ( fn DataKeyIsGenerated( entityName ) && fn ArrayCount( keys ) == 1 )keyName = fn ArrayFirstObject( keys )if ( fn DataIsNull( fn DictionaryObjectForKey( aRecord, keyName ) ) )for existing in recordsif ( fn NumberIntegerValue( fn DictionaryObjectForKey( existing, keyName ) ) > highest ) then highest = fn NumberIntegerValue( fn DictionaryObjectForKey( existing, keyName ) )nextMutableDictionarySetObjectForKey( aRecord, fn NumberWithLong( highest + 1 ), keyName )end ifend ifif ( fn ArrayCount( keys ) > 0 )if ( fn DataFetchOne( entityName, fn DataKeyValues( entityName, aRecord ) ) != NULL ) then exit fn = NOend iffor columnName in columnsvalue = fn DictionaryObjectForKey( aRecord, columnName )if ( value == NULL ) then value = fn DataNullMutableDictionarySetObjectForKey( stored, value, columnName )nextMutableArrayAddObject( records, stored )end fn = YES// write the record's fields to the stored record with these key valueslocal fn DataUpdate( entityName as CFStringRef, aRecord as CFDictionaryRef, keyValues as CFDictionaryRef ) as longCFArrayRef             records = fn DataMemoryStore( entityName )CFArrayRef             columns = fn DataColumns( entityName )CFMutableDictionaryRef storedCFStringRef            columnNameCFTypeRef              valuelong                   changed = 0if ( fn DataIsView( entityName ) || keyValues == NULL ) then exit fn = -1if ( fn DictionaryCount( keyValues ) == 0 ) then exit fn = -1for stored in recordsif ( fn DataMemoryMatches( stored, keyValues ) )for columnName in columnsvalue = fn DictionaryObjectForKey( aRecord, columnName )if ( value != NULL ) then MutableDictionarySetObjectForKey( stored, value, columnName )nextchanged++end ifnextend fn = changedlocal fn DataDelete( entityName as CFStringRef, keyValues as CFDictionaryRef ) as longCFMutableArrayRef records = fn DataMemoryStore( entityName )long              i, deleted = 0if ( fn DataIsView( entityName ) || keyValues == NULL ) then exit fn = -1if ( fn DictionaryCount( keyValues ) == 0 ) then exit fn = -1for i = (long)fn ArrayCount( records ) - 1 to 0 step -1if ( fn DataMemoryMatches( fn ArrayObjectAtIndex( records, i ), keyValues ) )MutableArrayRemoveObjectAtIndex( records, i )deleted++end ifnextend fn = deleted/* *   Transactions. DataBegin / DataEnd nest: only the outermost pair takes and keeps (or restores) the *   snapshot. A part that ends with keep = NO marks the whole transaction, and the outermost DataEnd puts *   everything back - how a failed rule undoes a save and every change it chained to. DataEnd returns YES *   when the work was kept (so far). */local fn DataBegin as BOOLif ( gDataMemory == NULL ) then fn DataMemoryResetif ( gDataTransactionDepth == 0 )gDataMemorySnapshot = (CFMutableDictionaryRef)fn DataKept( fn DataMemoryCopyAll( gDataMemory ), gDataMemorySnapshot )gDataRollbackOnly = NOend ifgDataTransactionDepth++end fn = YESlocal fn DataEnd( keep as BOOL ) as BOOLif ( gDataTransactionDepth == 0 ) then exit fn = NOif ( keep == NO ) then gDataRollbackOnly = YESgDataTransactionDepth--if ( gDataTransactionDepth > 0 ) then exit fn = ( gDataRollbackOnly == NO )if ( gDataRollbackOnly )gDataMemory = (CFMutableDictionaryRef)fn DataKept( fn DataMemoryCopyAll( gDataMemorySnapshot ), gDataMemory )gDataMemorySnapshot = (CFMutableDictionaryRef)fn DataKept( NULL, gDataMemorySnapshot )exit fn = NOend ifgDataMemorySnapshot = (CFMutableDictionaryRef)fn DataKept( NULL, gDataMemorySnapshot )end fn = YES