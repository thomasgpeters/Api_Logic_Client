/* *   Web Binding.incl - Web Toolkit for FutureBasic: pages bound to the database, through the business rules * *   FutureBasic is the middleware. A form is bound to an entity of the model (Model.json) and its fields to attributes; *   a table shows an entity's rows. Saving goes through LogicBank for FutureBasic (LogicInsert / LogicUpdate / *   LogicDelete), so every rule runs - formulas, sums, constraints - before anything is stored; a refused save shows the *   rule's message in the form's message band and keeps what the user typed. * *   Optional: the core (Server, Session, Widgets, Render, Events) knows no data model; an app that binds its own way *   leaves this file out. WebFormBind plugs the forms into the core's lifecycle. * *   The data layer is LogicBank's: Data Records.incl (SQLite) in a generated app, Data Memory.incl in the example. * *       fn WebFormBind( session, @"orderForm", @"Order", @"orderMessage" ) *       fn WebBindField( session, @"orderForm", @"orderDate", @"OrderDate" ) *       fn WebFormShowRecord( session, @"orderForm", aRecord )      // NULL: a new, empty record *       if ( fn WebFormSave( session, @"orderForm" ) ) ...          // the form fires "saved" *       fn WebTableShowEntity( session, @"orders", @"Order", filter, @[ @"OrderDate" ] ) * *   Unsaved changes: a bound form is "dirty" from the user's first change until it is saved or shown again. The page *   asks before it is left with unsaved changes, and an auto-saving form (WebFormAutoSave) is saved when the page is *   hidden, left or ended (the lifecycle: Web Events.incl). * *   MIT License. Copyright (c) 2026 Imagery Business Systems, LLC. See LICENSE. */// a field, text area, check box, drop-down or radio group shows (and edits) one attribute of the form's recordvoid local fn WebBindField( session as WebSessionRef, formId as CFStringRef, fieldId as CFStringRef, attrName as CFStringRef )CFMutableDictionaryRef widget = fn WebWidget( session, fieldId )CFMutableArrayRef      fieldIds = (CFMutableArrayRef)fn WebProperty( session, formId, @"fields" )if ( widget == NULL || fieldIds == NULL ) then exit fnfn WebSetProp( widget, @"attribute", attrName )fn WebSetProp( widget, @"form", formId )MutableArrayAddObject( fieldIds, fieldId )end fn// saved automatically when the page is hidden, left or ended, if it has unsaved changesvoid local fn WebFormAutoSave( session as WebSessionRef, formId as CFStringRef, isOn as BOOL )fn WebSetProp( fn WebWidget( session, formId ), @"autosave", fn NumberWithBool( isOn ) )end fnlocal fn WebFormIsDirty( session as WebSessionRef, formId as CFStringRef ) as BOOLCFTypeRef dirty = fn WebProperty( session, formId, @"dirty" )if ( dirty == NULL ) then exit fn = NOend fn = fn NumberBoolValue( dirty )// the browser is told too: it guards the page while a form is dirtyvoid local fn WebFormSetDirty( session as WebSessionRef, formId as CFStringRef, isDirty as BOOL )if ( fn WebProperty( session, formId, @"entity" ) == NULL ) then exit fnif ( fn WebFormIsDirty( session, formId ) == isDirty ) then exit fnfn WebSetProp( fn WebWidget( session, formId ), @"dirty", fn NumberWithBool( isDirty ) )fn WebQueue( session, @{ @"op" : @"dirty", @"id" : formId, @"value" : fn NumberWithBool( isDirty ) } )end fn// the form's message bandvoid local fn WebFormSay( session as WebSessionRef, formId as CFStringRef, content as CFStringRef, role as CFStringRef )CFStringRef messageId = fn WebValueText( fn WebProperty( session, formId, @"messageId" ) )if ( fn StringLength( messageId ) ) then fn WebSetMessage( session, messageId, content, role )end fn// the record being edited: the one shown, as loaded (keys, attributes without a field)local fn WebFormShownRecord( session as WebSessionRef, formId as CFStringRef ) as CFDictionaryRefCFDictionaryRef shown = fn WebProperty( session, formId, @"record" )if ( shown == NULL ) then shown = @{}end fn = shown// a value of the record being edited that no field shows (a new Item's OrderId); not a user's changevoid local fn WebFormSetRecordValue( session as WebSessionRef, formId as CFStringRef, attrName as CFStringRef, aValue as CFTypeRef )CFMutableDictionaryRef shown = (CFMutableDictionaryRef)fn WebProperty( session, formId, @"record" )if ( shown == NULL ) then exit fnif ( aValue == NULL ) then aValue = fn DataNullMutableDictionarySetObjectForKey( shown, aValue, attrName )end fn// a new record has no key yetlocal fn WebFormIsNew( session as WebSessionRef, formId as CFStringRef ) as BOOLCFStringRef     entityName = fn WebProperty( session, formId, @"entity" )CFDictionaryRef shown = fn WebFormShownRecord( session, formId )CFArrayRef      keysCFStringRef     keyNameif ( entityName == NULL ) then exit fn = YESkeys = fn DataKeys( entityName )if ( fn ArrayCount( keys ) == 0 ) then exit fn = YESfor keyName in keysif ( fn DictionaryObjectForKey( shown, keyName ) == NULL ) then exit fn = YESif ( fn DataIsNull( fn DictionaryObjectForKey( shown, keyName ) ) ) then exit fn = YESnextend fn = NO// an attribute's column type, from the model (INTEGER, REAL, TEXT ...)local fn WebAttributeType( entityName as CFStringRef, attrName as CFStringRef ) as CFStringRefCFArrayRef      fields = fn DictionaryObjectForKey( fn DataEntity( entityName ), @"fields" )CFDictionaryRef aFieldfor aField in fieldsif ( fn StringIsEqual( fn DictionaryObjectForKey( aField, @"name" ), attrName ) ) then exit fn = fn StringUppercaseString( fn WebValueText( fn DictionaryObjectForKey( aField, @"type" ) ) )nextend fn = @"TEXT"local fn WebTypeIsNumber( typeName as CFStringRef ) as BOOLCFArrayRef  numberTypes = @[ @"INT", @"REAL", @"NUM", @"DEC", @"FLOA", @"DOUB", @"MONEY", @"BOOL" ]CFStringRef partfor part in numberTypesif ( fn StringContainsString( typeName, part ) ) then exit fn = YESnextend fn = NO// what the page shows -> the value stored: numbers for numeric columns, null for an empty fieldlocal fn WebStoredValue( entityName as CFStringRef, attrName as CFStringRef, shownText as CFStringRef ) as CFTypeRefCFStringRef trimmed = fn StringByTrimmingCharactersInSet( shownText, fn CharacterSetWhitespaceSet )if ( fn StringLength( trimmed ) == 0 ) then exit fn = fn DataNullif ( fn WebTypeIsNumber( fn WebAttributeType( entityName, attrName ) ) ) then exit fn = fn NumberWithDouble( fn StringDoubleValue( trimmed ) )end fn = shownText// the record as the user has it now: the shown record, with every bound field's value over itlocal fn WebFormRecord( session as WebSessionRef, formId as CFStringRef ) as CFMutableDictionaryRefCFMutableDictionaryRef aRecord = fn MutableDictionaryWithDictionary( fn WebFormShownRecord( session, formId ) )CFStringRef            entityName = fn WebProperty( session, formId, @"entity" )CFArrayRef             fieldIds = fn WebProperty( session, formId, @"fields" )CFStringRef            fieldId, attrNameCFDictionaryRef        widgetfor fieldId in fieldIdswidget = fn WebWidget( session, fieldId )if ( widget == NULL ) then continueattrName = fn DictionaryObjectForKey( fn DictionaryObjectForKey( widget, @"props" ), @"attribute" )if ( fn StringIsEqual( fn DictionaryObjectForKey( widget, @"kind" ), @"checkbox" ) )MutableDictionarySetObjectForKey( aRecord, fn NumberWithLong( fn WebChecked( session, fieldId ) ), attrName )elseMutableDictionarySetObjectForKey( aRecord, fn WebStoredValue( entityName, attrName, fn WebValue( session, fieldId ) ), attrName )end ifnextend fn = aRecord// a record in the form (NULL: a new one, empty); its unsaved changes are droppedvoid local fn WebFormShowRecord( session as WebSessionRef, formId as CFStringRef, aRecord as CFDictionaryRef )CFArrayRef      fieldIds = fn WebProperty( session, formId, @"fields" )CFStringRef     fieldId, attrNameCFDictionaryRef widgetCFTypeRef       aValueif ( fieldIds == NULL ) then exit fnif ( aRecord == NULL ) then aRecord = @{}fn WebSetProp( fn WebWidget( session, formId ), @"record", fn MutableDictionaryWithDictionary( aRecord ) )for fieldId in fieldIdswidget = fn WebWidget( session, fieldId )if ( widget == NULL ) then continueattrName = fn DictionaryObjectForKey( fn DictionaryObjectForKey( widget, @"props" ), @"attribute" )aValue = fn DictionaryObjectForKey( aRecord, attrName )if ( fn StringIsEqual( fn DictionaryObjectForKey( widget, @"kind" ), @"checkbox" ) )fn WebSetChecked( session, fieldId, ( fn StringDoubleValue( fn WebValueText( aValue ) ) != 0 ) )elsefn WebSetValue( session, fieldId, aValue )end ifnextfn WebFormSetDirty( session, formId, NO )end fnvoid local fn WebFormNew( session as WebSessionRef, formId as CFStringRef )fn WebFormShowRecord( session, formId, NULL )fn WebFormSay( session, formId, @"", @"info" )end fn// saves the form's record through the rules; YES when stored. The form shows the record as stored (derived values// included) and fires "saved"; when a rule refuses, its message is shown and what the user typed stays.local fn WebFormSave( session as WebSessionRef, formId as CFStringRef ) as BOOLCFStringRef            entityName = fn WebProperty( session, formId, @"entity" )CFMutableDictionaryRef aRecordCFDictionaryRef        storedBOOL                   ok, isNewif ( entityName == NULL ) then exit fn = NOaRecord = fn WebFormRecord( session, formId )isNew = fn WebFormIsNew( session, formId )if ( isNew )ok = fn LogicInsert( entityName, aRecord )elseok = fn LogicUpdate( entityName, aRecord, fn DataKeyValues( entityName, fn WebFormShownRecord( session, formId ) ) )end ifif ( ok == NO )fn WebFormSay( session, formId, fn LogicMessage, @"danger" )exit fn = NOend if// read back: the rules may have derived values the user did not typestored = fn DataFetchOne( entityName, fn DataKeyValues( entityName, aRecord ) )if ( stored == NULL ) then stored = aRecordfn WebFormShowRecord( session, formId, stored )if ( isNew ) then fn WebFormSay( session, formId, @"Added.", @"success" ) else fn WebFormSay( session, formId, @"Saved.", @"success" )fn WebFire( session, formId, @"saved", @"" )end fn = YES// deletes the form's record through the rules (which may refuse, or delete its children too); YES when deletedlocal fn WebFormDelete( session as WebSessionRef, formId as CFStringRef ) as BOOLCFStringRef entityName = fn WebProperty( session, formId, @"entity" )if ( entityName == NULL ) then exit fn = NOif ( fn WebFormIsNew( session, formId ) )fn WebFormNew( session, formId )exit fn = YESend ifif ( fn LogicDelete( entityName, fn DataKeyValues( entityName, fn WebFormShownRecord( session, formId ) ) ) == NO )fn WebFormSay( session, formId, fn LogicMessage, @"danger" )exit fn = NOend iffn WebFormShowRecord( session, formId, NULL )fn WebFormSay( session, formId, @"Deleted.", @"success" )fn WebFire( session, formId, @"deleted", @"" )end fn = YES// the browser sent a bound field's value: its form now has unsaved changesvoid local fn WebFieldEdited( session as WebSessionRef, fieldId as CFStringRef, unused as CFStringRef )CFStringRef formId = fn WebValueText( fn WebProperty( session, fieldId, @"form" ) )if ( fn StringLength( formId ) ) then fn WebFormSetDirty( session, formId, YES )end fn// the lifecycle (Web Events.incl): every auto-saving form with unsaved changes is savedvoid local fn WebFormsSaveDirty( session as WebSessionRef )CFDictionaryRef widgets = fn DictionaryObjectForKey( session, @"widgets" )CFArrayRef      widgetIds = fn DictionaryAllKeys( widgets )CFStringRef     widgetIdCFTypeRef       autosavefor widgetId in widgetIdsautosave = fn WebProperty( session, widgetId, @"autosave" )if ( autosave == NULL ) then continueif ( fn NumberBoolValue( autosave ) && fn WebFormIsDirty( session, widgetId ) ) then fn WebFormSave( session, widgetId )nextend fn// a form for an entity's records; messageId: a message band (WebMessage) for what the rules say, or ""void local fn WebFormBind( session as WebSessionRef, formId as CFStringRef, entityName as CFStringRef, messageId as CFStringRef )CFMutableDictionaryRef form = fn WebWidget( session, formId )if ( form == NULL ) then exit fnif ( fn DataEntity( entityName ) == NULL )if ( isLoggingOn ) then NSLog( @"Web Toolkit: %@ is not an entity of the model", entityName )exit fnend iffn WebSetProp( form, @"entity", entityName )fn WebSetProp( form, @"messageId", messageId )fn WebSetProp( form, @"fields", fn MutableArrayNew )fn WebSetProp( form, @"record", fn MutableDictionaryNew )fn WebSetProp( form, @"dirty", fn NumberWithBool( NO ) )fn WebSetProp( form, @"autosave", fn NumberWithBool( NO ) )// the core's lifecycle reaches the bound forms through thesegWebFieldEditedHook = fn WebKept( fn WebPointerNumber( @fn WebFieldEdited ), gWebFieldEditedHook )gWebSaveDirtyHook = fn WebKept( fn WebPointerNumber( @fn WebFormsSaveDirty ), gWebSaveDirtyHook )end fn// --- tables and choices from the database ---local fn WebSameValues( first as CFDictionaryRef, second as CFDictionaryRef ) as BOOLcln return [(__bridge NSDictionary *)first isEqualToDictionary:(__bridge NSDictionary *)second];end fn = NO// a table shows an entity's records (filter: { attribute: value } or NULL; orderNames: attributes or NULL)void local fn WebTableShowEntity( session as WebSessionRef, tableId as CFStringRef, entityName as CFStringRef, filter as CFDictionaryRef, orderNames as CFArrayRef )CFMutableDictionaryRef widget = fn WebWidget( session, tableId )if ( widget == NULL ) then exit fnif ( filter == NULL ) then filter = @{}if ( orderNames == NULL ) then orderNames = @[]fn WebSetProp( widget, @"entity", entityName )fn WebSetProp( widget, @"filter", filter )fn WebSetProp( widget, @"order", orderNames )fn WebSetRows( session, tableId, fn DataFetch( entityName, filter, orderNames ) )end fn// the table's rows read again (after a save); the selected record stays selected when it is still therevoid local fn WebTableRefresh( session as WebSessionRef, tableId as CFStringRef )CFStringRef     entityName = fn WebProperty( session, tableId, @"entity" )CFDictionaryRef chosen = fn WebSelectedRecord( session, tableId ), keyValues, aRecordCFArrayRef      rowListlong            rowNumber = 0if ( entityName == NULL ) then exit fnrowList = fn DataFetch( entityName, fn WebProperty( session, tableId, @"filter" ), fn WebProperty( session, tableId, @"order" ) )fn WebSetRows( session, tableId, rowList )if ( chosen == NULL ) then exit fnkeyValues = fn DataKeyValues( entityName, chosen )for aRecord in rowListif ( fn WebSameValues( fn DataKeyValues( entityName, aRecord ), keyValues ) )fn WebSetSelectedRow( session, tableId, rowNumber )exit fnend ifrowNumber++nextend fn// choices for a drop-down or radio group from an entity (a lookup: an Order's Customer); the first, "", is nonelocal fn WebChoicesFromEntity( entityName as CFStringRef, codeAttr as CFStringRef, titleAttr as CFStringRef, noneTitle as CFStringRef ) as CFArrayRefCFMutableArrayRef choices = fn MutableArrayNewCFArrayRef        records = fn DataFetch( entityName, @{}, @[ titleAttr ] )CFDictionaryRef   aRecordif ( noneTitle ) then MutableArrayAddObject( choices, @{ @"code" : @"", @"title" : noneTitle } )for aRecord in recordsMutableArrayAddObject( choices, @{ @"code" : fn WebValueText( fn DictionaryObjectForKey( aRecord, codeAttr ) ), @"title" : fn WebValueText( fn DictionaryObjectForKey( aRecord, titleAttr ) ) } )nextend fn = choices