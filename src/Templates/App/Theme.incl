/* *   Theme.incl - the look of this app * *   Starting template from App Builder for FutureBasic: created once, then *   yours.  Regeneration never overwrites it (delete it to get a fresh copy). * *   The window's frame - the navigation bar on the left, the header with your logo, the *   footer - is built by the runtime's App Shell.incl.  Its colours are the gTheme... *   globals below; ApplyTheme sets them before the window is built (Windows.incl calls *   it first).  Change a colour here and every page follows. * *   Developer notes *   - Colours are ColorRefs.  fn ColorWithSRGB( red, green, blue, alpha ) takes 0.0-1.0; *     system colours such as fn ColorLabel or fn ColorWindowBackground follow light and *     dark mode by themselves - prefer them wherever the colour should change with the mode. *   - fn ShellDynamicColor( lightColour, darkColour ) gives one colour for light mode and another for dark *     mode; macOS switches between them by itself. The navigation bar uses it: the same blue, darker at night. *   - The working area (gThemeContentBackground) is a shade apart from the cards the Forms and Lists sit on *     (gThemeCardBackground), so a page reads as panels on a backdrop in both modes. *   - The theme menu in the header (System / Light / Dark) switches the appearance of *     the whole app (AppSetAppearanceNamed); nothing here needs to handle it. *   - Another look (a "colorful" one, a high-contrast one): copy ApplyTheme as *     ApplyColorfulTheme, change the colours, and call that from Windows.incl instead. *   - Buttons are pill-shaped (gThemePillButtons, Pill Buttons.incl): on macOS 26 the system's *     own capsule; on macOS 15 the same shape drawn in system colours. */void local fn ApplyTheme// start from the runtime's defaults, then change what you wantfn ShellDefaultTheme// the navigation bar: dark blue (darker in dark mode), white bold text and iconsgThemeNavBackground = fn ShellDynamicColor( fn ColorWithSRGB( 0.067, 0.157, 0.329, 1.0 ), fn ColorWithSRGB( 0.027, 0.063, 0.141, 1.0 ) )gThemeNavText       = fn ColorWhitegThemeNavSelection  = fn ColorWithSRGB( 1.0, 1.0, 1.0, 0.16 )     // behind the chosen pagegThemeNavHeadingText = fn ColorWithSRGB( 1.0, 1.0, 1.0, 0.6 )     // the "Business Objects" headinggThemeNavFontSize   = 13.0// the header (logo, app name, tag-line) and the footer (copyright)gThemeHeaderBackground = fn ColorControlBackground                  // follows light / darkgThemeHeaderText       = fn ColorLabelgThemeTaglineText      = fn ColorSecondaryLabelgThemeFooterBackground = fn ColorWindowBackgroundgThemeFooterText       = fn ColorSecondaryLabel// the working area, and the cards the Forms and Lists sit on: light, then darkgThemeContentBackground = fn ShellDynamicColor( fn ColorWithSRGB( 0.918, 0.925, 0.937, 1.0 ), fn ColorWithSRGB( 0.090, 0.094, 0.102, 1.0 ) )gThemeCardBackground    = fn ShellDynamicColor( fn ColorWhite, fn ColorWithSRGB( 0.169, 0.173, 0.184, 1.0 ) )gThemeCardBorder        = fn ShellDynamicColor( fn ColorWithSRGB( 0.0, 0.0, 0.0, 0.10 ), fn ColorWithSRGB( 1.0, 1.0, 1.0, 0.10 ) )gThemeCardTitleText     = fn ColorLabel             // each card's title ("Customer Details"), semiboldgThemeCardTitleFontSize = 15.0                      // the fields use the system font at 13: San Francisco, sans-serif// buttons: Mac-style pills (Save in the accent colour, Delete in red); NO for classic push buttonsgThemePillButtons      = YESend fn