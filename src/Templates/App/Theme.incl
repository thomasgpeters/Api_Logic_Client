/* *   Theme.incl - the look of this app * *   Starting template from Imagery LogicBank Studio for FutureBasic: created once, then *   yours.  Regeneration never overwrites it (delete it to get a fresh copy). * *   The window's frame - the navigation bar on the left, the header with your logo, the *   footer - is built by the runtime's App Shell.incl.  Its colours are the gTheme... *   globals below; ApplyTheme sets them before the window is built (Windows.incl calls *   it first).  Change a colour here and every page follows. * *   Developer notes *   - Colours are ColorRefs.  fn ColorWithSRGB( red, green, blue, alpha ) takes 0.0-1.0; *     system colours such as fn ColorLabel or fn ColorWindowBackground follow light and *     dark mode by themselves - prefer them wherever the colour should change with the mode. *   - The navigation bar keeps its colour in both modes: it is the app's identity. *   - The theme menu in the header (System / Light / Dark) switches the appearance of *     the whole app (AppSetAppearanceNamed); nothing here needs to handle it. *   - Another look (a "colorful" one, a high-contrast one): copy ApplyTheme as *     ApplyColorfulTheme, change the colours, and call that from Windows.incl instead. */void local fn ApplyTheme// start from the runtime's defaults, then change what you wantfn ShellDefaultTheme// the navigation bar: dark blue, white bold text and iconsgThemeNavBackground = fn ColorWithSRGB( 0.067, 0.157, 0.329, 1.0 )gThemeNavText       = fn ColorWhitegThemeNavSelection  = fn ColorWithSRGB( 1.0, 1.0, 1.0, 0.16 )     // behind the chosen pagegThemeNavFontSize   = 13.0// the header (logo, app name, tag-line) and the footer (copyright)gThemeHeaderBackground = fn ColorControlBackground                  // follows light / darkgThemeHeaderText       = fn ColorLabelgThemeTaglineText      = fn ColorSecondaryLabelgThemeFooterBackground = fn ColorWindowBackgroundgThemeFooterText       = fn ColorSecondaryLabelend fn