/* *   Menus.incl - the app's menus * *   Starting template from App Builder for FutureBasic: created once, then yours. *   Regeneration never overwrites it (delete it to get a fresh copy). *   Menu choices are handled in EventHandlers.incl (DoMenu); Records is handled by the pages *   (App Pages.incl), the same as the toolbar's New, Save, Delete and Refresh. * *   Where to change the app: search the project for CUSTOMIZE: - every place meant for your own code is marked. */void local fn BuildMenus// File - CUSTOMIZE: add your own items after Close (Open, Export, Print, ...)menu _shellMenuFile,,, @"File"menu _shellMenuFile, 1,, @"Close", @"w"MenuItemSetAction( _shellMenuFile, 1, @"performClose:" )// Edit (standard Undo, Cut, Copy, Paste, Select All)editmenu _shellMenuEdit// Records - the page you are on (handled by App Pages.incl: keep its items; add yours after Refresh)menu _shellMenuRecords,,, @"Records"menu _shellMenuRecords, _shellItemNew,,     @"New Record", @"n"menu _shellMenuRecords, _shellItemSave,,    @"Save",       @"s"menu _shellMenuRecords, _shellItemDelete,,  @"Delete…"menu _shellMenuRecords, _shellItemSeparatormenu _shellMenuRecords, _shellItemRefresh,, @"Refresh",    @"r"// CUSTOMIZE: your own menus here, with menu numbers from 10 up; handle them in EventHandlers.incl (DoMenu)end fn