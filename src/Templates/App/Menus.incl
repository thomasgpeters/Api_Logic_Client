/* *   Menus.incl - the app's menus * *   Starting template from Imagery LogicBank Studio for FutureBasic: created once, then yours. *   Regeneration never overwrites it (delete it to get a fresh copy). *   Menu choices are handled in EventHandlers.incl (DoMenu); Records is handled by the pages *   (App Pages.incl), the same as the buttons in the window's footer. */void local fn BuildMenus// Filemenu _shellMenuFile,,, @"File"menu _shellMenuFile, 1,, @"Close", @"w"MenuItemSetAction( _shellMenuFile, 1, @"performClose:" )// Edit (standard Undo, Cut, Copy, Paste, Select All)editmenu _shellMenuEdit// Records - the page you are onmenu _shellMenuRecords,,, @"Records"menu _shellMenuRecords, _shellItemNew,,     @"New Record", @"n"menu _shellMenuRecords, _shellItemSave,,    @"Save",       @"s"menu _shellMenuRecords, _shellItemDelete,,  @"Delete…"menu _shellMenuRecords, _shellItemSeparatormenu _shellMenuRecords, _shellItemRefresh,, @"Refresh",    @"r"// your own menus: use menu numbers from 10 upend fn