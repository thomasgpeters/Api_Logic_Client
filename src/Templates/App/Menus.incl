/* *   Menus.incl * *   Starting template from Imagery LogicBank Studio for FutureBasic: created once, then yours. *   Regeneration never overwrites it (delete it to get a fresh copy). *   Menu choices are handled in EventHandlers.incl (DoMenu). */void local fn BuildMenus// Filemenu _alsMenuFile,,, @"File"menu _alsMenuFile, 1,, @"Close", @"w"MenuItemSetAction( _alsMenuFile, 1, @"performClose:" )// Edit (standard Cut, Copy, Paste ...)editmenu _alsMenuEdit// Records - handled by the runtime (ALSDoMenu)menu _alsMenuRecords,,, @"Records"menu _alsMenuRecords, _alsItemNew,,     @"New Record", @"n"menu _alsMenuRecords, _alsItemSave,,    @"Save",       @"s"menu _alsMenuRecords, _alsItemDelete,,  @"Delete…"menu _alsMenuRecords, _alsItemSeparatormenu _alsMenuRecords, _alsItemRefresh,, @"Refresh",    @"r"// your own menus: use menu numbers from 10 upend fn