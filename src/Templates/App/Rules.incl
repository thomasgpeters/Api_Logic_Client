/* *   Rules.incl - this app's business rules (LogicBank for FutureBasic) * *   Starting template from Api Logic Client: created once, then yours. *   Regeneration never overwrites it (delete it to get a fresh copy). * *   Rules are FB functions, declared in DeclareRules and enforced on every save *   made with LogicInsert / LogicUpdate / LogicDelete (Logic Engine.incl). *   <project>.main calls DeclareRules, then LogicActivate. * *   A formula returns the attribute's value, and names the attributes it reads: * *       // OrderDetail.Amount = Quantity * UnitPrice *       local fn OrderDetailAmount( logicRow as LogicRowRef ) as CFTypeRef *       end fn = fn NumberWithDouble( fn LogicDouble( logicRow, @"Quantity" ) * fn LogicDouble( logicRow, @"UnitPrice" ) ) * *   A constraint returns YES when the row is acceptable; {Attr} in the message *   shows the row's value: * *       // Customer.Balance <= CreditLimit *       local fn CustomerCreditCheck( logicRow as LogicRowRef ) as BOOL *       end fn = ( fn LogicDouble( logicRow, @"Balance" ) <= fn LogicDouble( logicRow, @"CreditLimit" ) ) * *   and in DeclareRules: * *       fn LogicFormula( @"OrderDetail", @"Amount", @fn OrderDetailAmount, @[ @"Quantity", @"UnitPrice" ] ) *       fn LogicConstraint( @"Customer", @fn CustomerCreditCheck, @"Balance {Balance} exceeds credit limit {CreditLimit}" ) * *   Sums and counts over a child list (the model's <Child>List names) are kept up to *   date on every child save - and the parent's own rules then run (chaining): * *       // which orders count: a where function on the child row *       local fn OrderIsUnshipped( logicRow as LogicRowRef ) as BOOL *       end fn = fn LogicIsEmpty( logicRow, @"ShippedDate" ) * *       fn LogicSum( @"Order", @"AmountTotal", @"OrderDetailList", @"Amount", NULL ) *       fn LogicSum( @"Customer", @"Balance", @"OrderList", @"AmountTotal", @fn OrderIsUnshipped ) *       fn LogicCount( @"Customer", @"UnpaidOrderCount", @"OrderList", @fn OrderIsUnshipped ) * *   A formula can read its parent: fn LogicParentValue( logicRow, @"Order", @"ShippedDate" ), *   named in its dependsOn as @"Order.ShippedDate". * *   Reading the row: LogicValue, LogicDouble, LogicLong, LogicString, LogicIsEmpty, *   LogicOldValue, LogicChanged, LogicIsInsert / LogicIsUpdate, LogicParentValue, *   LogicParentDouble (Logic Row.incl). */void local fn DeclareRules// your rules hereend fn