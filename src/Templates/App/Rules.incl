/* *   Rules.incl - this app's business rules (LogicBank for FutureBasic) * *   Starting template from App Builder for FutureBasic: created once, then yours. *   Regeneration never overwrites it (delete it to get a fresh copy). * *   Rules are FB functions, declared in DeclareRules and enforced on every save *   made with LogicInsert / LogicUpdate / LogicDelete / LogicUpsert (Logic Engine.incl). *   <project>.main calls DeclareRules, then LogicActivate. * *   A formula returns the attribute's value, and names the attributes it reads: * *       // OrderDetail.Amount = Quantity * UnitPrice *       local fn OrderDetailAmount( logicRow as LogicRowRef ) as CFTypeRef *       end fn = fn NumberWithDouble( fn LogicDouble( logicRow, @"Quantity" ) * fn LogicDouble( logicRow, @"UnitPrice" ) ) * *   A constraint returns YES when the row is acceptable; {Attr} in the message *   shows the row's value: * *       // Customer.Balance <= CreditLimit *       local fn CustomerCreditCheck( logicRow as LogicRowRef ) as BOOL *       end fn = ( fn LogicDouble( logicRow, @"Balance" ) <= fn LogicDouble( logicRow, @"CreditLimit" ) ) * *   and in DeclareRules: * *       fn LogicFormula( @"OrderDetail", @"Amount", @fn OrderDetailAmount, @[ @"Quantity", @"UnitPrice" ] ) *       fn LogicConstraint( @"Customer", @fn CustomerCreditCheck, @"Balance {Balance} exceeds credit limit {CreditLimit}" ) * *   Sums and counts over a child list (the model's <Child>List names) are kept up to *   date on every child save - and the parent's own rules then run (chaining): * *       // which orders count: a where function on the child row *       local fn OrderIsUnshipped( logicRow as LogicRowRef ) as BOOL *       end fn = fn LogicIsEmpty( logicRow, @"ShippedDate" ) * *       fn LogicSum( @"Order", @"AmountTotal", @"OrderDetailList", @"Amount", NULL ) *       fn LogicSum( @"Customer", @"Balance", @"OrderList", @"AmountTotal", @fn OrderIsUnshipped ) *       fn LogicCount( @"Customer", @"UnpaidOrderCount", @"OrderList", @fn OrderIsUnshipped ) * *   A formula can read its parent: fn LogicParentValue( logicRow, @"Order", @"ShippedDate" ), *   named in its dependsOn as @"Order.ShippedDate" - when the parent's value changes, the *   children recompute. * *   Copy a parent's value on insert (and when the row moves to another parent), check that *   a parent exists, say what deleting a parent does to its children, and run code on save: * *       fn LogicCopy( @"OrderDetail", @"UnitPrice", @"Product", @"UnitPrice" ) *       fn LogicParentCheck( @"OrderDetail", @"Product", @"Product {ProductId} does not exist" ) *       fn LogicDeleteAction( @"Order", @"OrderDetailList", @"cascade", NULL )     // prevent / cascade / nullify *       fn LogicDeleteAction( @"Customer", @"OrderList", @"prevent", @"Customer {Id} still has orders" ) *       fn LogicRowEvent( @"Order", @fn OrderAudit )          // during the save; must not change the row *       fn LogicCommitEvent( @"Order", @fn OrderShippedMail ) // after the commit, once per row * *       void local fn OrderShippedMail( logicRow as LogicRowRef ) *       ... *       end fn * *   Reading the row: LogicValue, LogicDouble, LogicLong, LogicString, LogicIsEmpty, *   LogicOldValue, LogicChanged, LogicIsInsert / LogicIsUpdate, LogicParentValue, *   LogicParentDouble (Logic Row.incl). */void local fn DeclareRules// your rules hereend fn