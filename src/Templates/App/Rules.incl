/* *   Rules.incl - this app's business rules (LogicBank for FutureBasic) * *   Starting template from Api Logic Client: created once, then yours. *   Regeneration never overwrites it (delete it to get a fresh copy). * *   Rules are FB functions, declared in DeclareRules and enforced on every save *   made with LogicInsert / LogicUpdate / LogicDelete (Logic Engine.incl). *   <project>.main calls DeclareRules, then LogicActivate. * *   A formula returns the attribute's value, and names the attributes it reads: * *       // OrderDetail.Amount = Quantity * UnitPrice *       local fn OrderDetailAmount( logicRow as LogicRowRef ) as CFTypeRef *       end fn = fn NumberWithDouble( fn LogicDouble( logicRow, @"Quantity" ) * fn LogicDouble( logicRow, @"UnitPrice" ) ) * *   A constraint returns YES when the row is acceptable; {Attr} in the message *   shows the row's value: * *       // Customer.Balance <= CreditLimit *       local fn CustomerCreditCheck( logicRow as LogicRowRef ) as BOOL *       end fn = ( fn LogicDouble( logicRow, @"Balance" ) <= fn LogicDouble( logicRow, @"CreditLimit" ) ) * *   and in DeclareRules: * *       fn LogicFormula( @"OrderDetail", @"Amount", @fn OrderDetailAmount, @[ @"Quantity", @"UnitPrice" ] ) *       fn LogicConstraint( @"Customer", @fn CustomerCreditCheck, @"Balance {Balance} exceeds credit limit {CreditLimit}" ) * *   Reading the row: LogicValue, LogicDouble, LogicLong, LogicString, LogicIsEmpty, *   LogicOldValue, LogicChanged, LogicIsInsert / LogicIsUpdate (Logic Row.incl). */void local fn DeclareRules// your rules hereend fn