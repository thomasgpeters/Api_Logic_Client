/* *   App Globals.glbl - this app's own globals * *   Starting template from App Builder for FutureBasic: created once, then yours. Regeneration never overwrites it *   (delete it to get a fresh copy). It comes first in the build order, after FutureBasic's own headers, so the *   runtime and your code can use what it declares. */begin globals// Logging: every NSLog in the runtime and the generated code is gated on isLoggingOn - nothing reaches the NSLog// window while it is NO. Set it to YES here while you develop (the rules engine then logs every rule it runs).BOOL isLoggingOn = NO// your own globals go hereend globals