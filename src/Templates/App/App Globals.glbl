/* *   App Globals.glbl - this app's own globals * *   Starting template from App Builder for FutureBasic: created once, then yours. Regeneration never overwrites it *   (delete it to get a fresh copy). It comes first in the build order, after FutureBasic's own headers, so the *   runtime and your code can use what it declares. * *   Where to change the app: search the project for CUSTOMIZE: - every place meant for your own code is marked. */include "NSLog.incl"                // FutureBasic's NSLog: every log line (gated on isLoggingOn) needs itbegin globals// CUSTOMIZE: logging. Every NSLog in the runtime and the generated code is gated on isLoggingOn - nothing reaches the NSLog// window while it is NO. Set it to YES here while you develop (the rules engine then logs every rule it runs).BOOL isLoggingOn = NO// CUSTOMIZE: your own globals go here. An object global (a CFString, an array, ...) does not keep its value alive:// keep it with DataKept( newValue, oldValue ), as the runtime does, or it may be gone at the next event.end globals