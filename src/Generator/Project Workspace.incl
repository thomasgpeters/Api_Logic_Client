/* *   Project Workspace.incl * *   Where a project lives, and its settings: * *   ~/Library/Application Support/Api_Logic_Client/ *   └── workspace/ *       └── <project>/             the project: everything the generator keeps about it *           ├── Project.json       settings: name, model source, base URL, user name *           ├── Design.json        the designer's adjustments (Project Actions.incl) *           └── FBapp/             the generated FutureBasic app (App Generator.incl) * *   Passwords and tokens are never written here - they belong in the Keychain. */#define APP_SUPPORT_FOLDER_NAME @"Api_Logic_Client"#define WORKSPACE_FOLDER_NAME   @"workspace"#define PROJECT_APP_FOLDER_NAME @"FBapp"#define PROJECT_SETTINGS_FILE   @"Project.json"// ~/Library/Application Support/Api_Logic_Client/ (created when missing)local fn AppSupportFolderURL as CFURLRefCFURLRef folderURL = fn URLByAppendingPathComponent( fn FileManagerURLForDirectory( NSApplicationSupportDirectory, NSUserDomainMask ), APP_SUPPORT_FOLDER_NAME )if ( fn FileManagerFileExistsAtURL( folderURL ) == NO ) then fn FileManagerCreateDirectoryAtURL( folderURL, YES, NULL )end fn = folderURL// .../Api_Logic_Client/workspace/<project>/ (created when missing);// also sets the apiLogicWorkFolderURL (workspace) and projectFolderURL globalslocal fn ProjectFolderURL as CFURLRefapiLogicWorkFolderURL = fn URLByAppendingPathComponent( fn AppSupportFolderURL, WORKSPACE_FOLDER_NAME )projectFolderURL      = fn URLByAppendingPathComponent( apiLogicWorkFolderURL, projectName )if ( fn FileManagerFileExistsAtURL( projectFolderURL ) == NO ) then fn FileManagerCreateDirectoryAtURL( projectFolderURL, YES, NULL )end fn = projectFolderURL// .../workspace/<project>/FBapp/ (created when missing) - the generated applocal fn ProjectAppFolderURL as CFURLRefCFURLRef folderURL = fn URLByAppendingPathComponent( fn ProjectFolderURL, PROJECT_APP_FOLDER_NAME )if ( fn FileManagerFileExistsAtURL( folderURL ) == NO ) then fn FileManagerCreateDirectoryAtURL( folderURL, YES, NULL )end fn = folderURL// the generated app's name (its .fbeproj, .main and window title): the project name// as typed, without the " Project" the heading addslocal fn ProjectAppName as CFStringRefCFStringRef appName = fn ControlStringValue( _projectNameEdit )if ( fn StringLength( appName ) == 0 ) then appName = projectNameend fn = appName// ~/Library is hidden in Finder: reveal the current project's folder (or the workspace)void local fn ShowWorkspaceInFinderCFURLRef folderURL = fn URLByAppendingPathComponent( fn AppSupportFolderURL, WORKSPACE_FOLDER_NAME )if ( fn FileManagerFileExistsAtURL( folderURL ) == NO ) then fn FileManagerCreateDirectoryAtURL( folderURL, YES, NULL )if ( fn StringLength( projectName ) > 0 && fn DictionaryObjectForKey( gProjectDictionary, @"resources" ) != NULL ) then folderURL = fn ProjectFolderURLWorkspaceActivateFileViewerSelectingURLs( @[ folderURL ] )end fn/* *   Project.json - the project's settings: *   { "name": "Northwind", "source": "/path/db.sqlite", "baseURL": "http://...", "userName": "admin" } */local fn ProjectSettingsFileURL as CFURLRefend fn = fn URLByAppendingPathComponent( fn ProjectFolderURL, PROJECT_SETTINGS_FILE )void local fn ProjectSettingsSaveCFMutableDictionaryRef settings = fn MutableDictionaryNewCFStringRef            source   = fn DictionaryObjectForKey( gProjectDictionary, @"source" )CFDataRef              jsonErrorRef               err = NULLif ( fn StringLength( projectName ) == 0 ) then exit fnMutableDictionarySetObjectForKey( settings, fn ProjectAppName, @"name" )if ( source != NULL ) then MutableDictionarySetObjectForKey( settings, source, @"source" )MutableDictionarySetObjectForKey( settings, fn ControlStringValue( _baseURLEdit ), @"baseURL" )MutableDictionarySetObjectForKey( settings, fn ControlStringValue( _authNameEdit ), @"userName" )json = fn JSONSerializationDataWithJSONObject( settings, NSJSONWritingPrettyPrinted, @err )if ( json == NULL ) then exit fnif ( fn DataWriteToURL( json, fn ProjectSettingsFileURL, NSDataWritingAtomic, @err ) == NO )if (isLoggingOn) then NSLog( @"Could not write %@: %@", fn URLPath( fn ProjectSettingsFileURL ), fn ErrorLocalizedDescription( err ) )end ifend fn// fill the connection fields the user left empty from the saved settingsvoid local fn ProjectSettingsLoadCFDictionaryRef settingsCFDataRef       jsonCFStringRef     valueErrorRef        err = NULLif ( fn StringLength( projectName ) == 0 ) then exit fnjson = fn DataWithContentsOfURL( fn ProjectSettingsFileURL, 0, @err )if ( json == NULL ) then exit fn                                    // new projectsettings = fn JSONSerializationJSONObjectWithData( json, 0, @err )if ( settings == NULL ) then exit fnvalue = fn DictionaryObjectForKey( settings, @"baseURL" )if ( value != NULL && fn StringLength( fn ControlStringValue( _baseURLEdit ) ) == 0 ) then ControlSetStringValue( _baseURLEdit, value )value = fn DictionaryObjectForKey( settings, @"userName" )if ( value != NULL && fn StringLength( fn ControlStringValue( _authNameEdit ) ) == 0 ) then ControlSetStringValue( _authNameEdit, value )if (isLoggingOn) then NSLog( @"Loaded %@", fn URLPath( fn ProjectSettingsFileURL ) )end fn