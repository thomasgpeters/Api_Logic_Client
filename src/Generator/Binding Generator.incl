/* *   I M A G E R Y    B U S I N E S S     S Y S T E M S,   L L C * *   Binding Generator * *   Writes one readable "<Entity> Binding.incl" per entity: the code that moves a *   record (a dictionary keyed by attribute name) to and from the entity's Form *   part and fills its List part. Every control is named by its tag constant from *   Model Tags.incl, so the generated code reads like hand-written FB. The helpers *   it calls (BindingShow..., BindingTake...) are in src/Runtime/Binding Support.incl. */// FB source files use classic-Mac line endingslocal fn BindingWriteSource( source as CFStringRef, folderURL as CFURLRef, fileName as CFStringRef ) as BOOLErrorRef err = NULLCFURLRef url = fn URLByAppendingPathComponent( folderURL, fileName )BOOL     ok  = fn StringWriteToURL( fn StringByReplacingOccurrencesOfString( source, @"\n", @"\r" ), url, YES, NSUTF8StringEncoding, @err )if ( ok == NO && isLoggingOn ) then NSLog( @"Could not write %@: %@", fn URLPath( url ), fn ErrorLocalizedDescription( err ) )end fn = oklocal fn BindingShowCall( kind as long ) as CFStringRefselect ( kind )case _xibKindInteger, _xibKindDecimal : exit fn = @"BindingShowNumber"case _xibKindDate                     : exit fn = @"BindingShowDate"case _xibKindCheckbox                 : exit fn = @"BindingShowCheck"end selectend fn = @"BindingShowText"local fn BindingTakeCall( kind as long ) as CFStringRefselect ( kind )case _xibKindInteger  : exit fn = @"BindingTakeInteger"case _xibKindDecimal  : exit fn = @"BindingTakeDecimal"case _xibKindDate     : exit fn = @"BindingTakeDate"case _xibKindCheckbox : exit fn = @"BindingTakeCheck"end selectend fn = @"BindingTakeText"// the source of <Entity> Binding.incl, from the entity's Model.json entrylocal fn BindingSourceForResource( resourceModel as CFDictionaryRef ) as CFStringRefCFMutableStringRef s = fn MutableStringNewCFStringRef        name = fn DictionaryObjectForKey( resourceModel, @"name" )CFArrayRef         fields = fn DictionaryObjectForKey( resourceModel, @"fields" )CFDictionaryRef    fieldCFStringRef        attrName, constantNamelong               kindMutableStringAppendString( s, fn StringWithFormat( @"/*\n *   %@ Binding.incl\n *\n", name ) )MutableStringAppendString( s, @" *   Generated by Api Logic Client (Generate Binding Code / Generate App).\n" )MutableStringAppendString( s, @" *   Regenerating replaces this file: put hand-written code in a hooks file.\n *\n" )MutableStringAppendString( s, fn StringWithFormat( @" *   A %@ record is a dictionary keyed by attribute name.\n */\n\n", name ) )// record -> formMutableStringAppendString( s, fn StringWithFormat( @"// record -> %@Form\nvoid local fn %@RecordToForm( aRecord as CFDictionaryRef )\n", name, name ) )for field in fieldsattrName     = fn DictionaryObjectForKey( field, @"name" )kind         = fn NumberIntegerValue( fn DictionaryObjectForKey( field, @"kind" ) )constantName = fn XibConstantName( name, attrName )MutableStringAppendString( s, fn StringWithFormat( @"fn %@( %@, aRecord, @\"%@\" )\n", fn BindingShowCall( kind ), constantName, attrName ) )nextMutableStringAppendString( s, @"end fn\n\n\n" )// form -> recordMutableStringAppendString( s, fn StringWithFormat( @"// %@Form -> record; empty controls are left out (stored as NULL)\nlocal fn %@FormToRecord as CFMutableDictionaryRef\nCFMutableDictionaryRef aRecord = fn MutableDictionaryNew\n", name, name ) )for field in fieldsattrName     = fn DictionaryObjectForKey( field, @"name" )kind         = fn NumberIntegerValue( fn DictionaryObjectForKey( field, @"kind" ) )constantName = fn XibConstantName( name, attrName )MutableStringAppendString( s, fn StringWithFormat( @"fn %@( aRecord, @\"%@\", %@ )\n", fn BindingTakeCall( kind ), attrName, constantName ) )nextMutableStringAppendString( s, @"end fn = aRecord\n\n\n" )// records -> listMutableStringAppendString( s, fn StringWithFormat( @"// records -> %@List (column identifier = attribute name)\nvoid local fn %@RecordsToList( records as CFArrayRef )\n", name, name ) )MutableStringAppendString( s, @"CFMutableArrayRef      rows = fn MutableArrayNew\nCFMutableDictionaryRef row\nCFDictionaryRef        aRecord\n\nfor aRecord in records\nrow = fn MutableDictionaryNew\n" )for field in fieldsattrName = fn DictionaryObjectForKey( field, @"name" )MutableStringAppendString( s, fn StringWithFormat( @"MutableDictionarySetObjectForKey( row, fn BindingString( aRecord, @\"%@\" ), @\"%@\" )\n", attrName, attrName ) )nextMutableStringAppendString( s, @"MutableArrayAddObject( rows, row )\nnext\n" )MutableStringAppendString( s, fn StringWithFormat( @"TableViewSetData( _%@ListTable, rows )\nTableViewReloadData( _%@ListTable )\n", fn XibResourcePrefix( name ), fn XibResourcePrefix( name ) ) )// the list is resized when its page is laid out; start at the first row, not where the resize left itMutableStringAppendString( s, fn StringWithFormat( @"if ( fn ArrayCount( rows ) > 0 ) then TableViewScrollRowToVisible( _%@ListTable, 0 )   // start at the first row\nend fn\n", fn XibResourcePrefix( name ) ) )end fn = s// every entity (or just onlyName) -> <Entity> Binding.incl; returns the files writtenlocal fn BindingGenerateProject( modelResources as CFArrayRef, folderURL as CFURLRef, onlyName as CFStringRef ) as longCFDictionaryRef resourceModelCFStringRef     namelong            written = 0for resourceModel in modelResourcesname = fn DictionaryObjectForKey( resourceModel, @"name" )if ( onlyName == NULL || fn StringIsEqual( onlyName, name ) )if ( fn BindingWriteSource( fn BindingSourceForResource( resourceModel ), folderURL, fn StringWithFormat( @"%@ Binding.incl", name ) ) ) then written++end ifnextend fn = written