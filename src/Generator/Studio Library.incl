/* *   I M A G E R Y    B U S I N E S S     S Y S T E M S,   L L C * *   Studio Library.incl - the runtime and the templates every generated app is made from * *   They live in the workspace, not in the Studio's app bundle (author, 2026-11-24): * *   ~/Library/Application Support/Api_Logic_Client/ *   ├── Studio Library.json     { "source": "/path/to/Api_Logic_Client" } - where they were copied from *   └── workspace/ *       ├── Runtime/            our FB runtime, copied into every generated app (src/Runtime) *       ├── Templates/          starting files for generated apps, the ERD page (src/Templates) *       └── <name> Project/     the projects * *   On first launch (and whenever they are missing) the Studio asks for the Api_Logic_Client *   folder (the repository) and copies src/Runtime and src/Templates into the workspace.  After *   pulling a newer version: Model > Update Runtime and Templates.  A release will have an *   installer that puts them there instead (BACKLOG), so users need no repository. */#define APP_SUPPORT_FOLDER_NAME @"Api_Logic_Client"#define WORKSPACE_FOLDER_NAME   @"workspace"#define LIBRARY_RUNTIME_FOLDER  @"Runtime"#define LIBRARY_TEMPLATES_FOLDER @"Templates"#define LIBRARY_SOURCE_FILE     @"Studio Library.json"#define LIBRARY_PANEL_TAG       7001// ~/Library/Application Support/Api_Logic_Client/ (created when missing)local fn AppSupportFolderURL as CFURLRefCFURLRef folderURL = fn URLByAppendingPathComponent( fn FileManagerURLForDirectory( NSApplicationSupportDirectory, NSUserDomainMask ), APP_SUPPORT_FOLDER_NAME )if ( fn FileManagerFileExistsAtURL( folderURL ) == NO ) then fn FileManagerCreateDirectoryAtURL( folderURL, YES, NULL )end fn = folderURL// .../Api_Logic_Client/workspace/ (created when missing)local fn StudioWorkspaceURL as CFURLRefCFURLRef folderURL = fn URLByAppendingPathComponent( fn AppSupportFolderURL, WORKSPACE_FOLDER_NAME )if ( fn FileManagerFileExistsAtURL( folderURL ) == NO ) then fn FileManagerCreateDirectoryAtURL( folderURL, YES, NULL )end fn = folderURLlocal fn StudioRuntimeURL as CFURLRefend fn = fn URLByAppendingPathComponent( fn StudioWorkspaceURL, LIBRARY_RUNTIME_FOLDER )local fn StudioTemplatesURL as CFURLRefend fn = fn URLByAppendingPathComponent( fn StudioWorkspaceURL, LIBRARY_TEMPLATES_FOLDER )// are the runtime and the templates in the workspace?local fn StudioLibraryIsInstalled as BOOLif ( fn FileManagerFileExistsAtURL( fn URLByAppendingPathComponent( fn StudioRuntimeURL, @"Logic Engine.incl" ) ) == NO ) then exit fn = NOend fn = fn FileManagerFileExistsAtURL( fn URLByAppendingPathComponent( fn StudioTemplatesURL, @"App" ) )// the Api_Logic_Client folder they were last copied from (NULL when never)local fn StudioLibrarySource as CFStringRefCFDataRef       jsonCFDictionaryRef settingsjson = fn DataWithContentsOfURL( fn URLByAppendingPathComponent( fn AppSupportFolderURL, LIBRARY_SOURCE_FILE ), 0, NULL )if ( json == NULL ) then exit fn = NULLsettings = fn JSONSerializationJSONObjectWithData( json, 0, NULL )if ( settings == NULL ) then exit fn = NULLend fn = fn DictionaryObjectForKey( settings, @"source" )void local fn StudioLibrarySaveSource( path as CFStringRef )CFDataRef json = fn JSONSerializationDataWithJSONObject( @{ @"source":path }, NSJSONWritingPrettyPrinted, NULL )if ( json != NULL ) then fn DataWriteToURL( json, fn URLByAppendingPathComponent( fn AppSupportFolderURL, LIBRARY_SOURCE_FILE ), NSDataWritingAtomic, NULL )end fn// copy one folder over the workspace's copylocal fn StudioLibraryCopyFolder( srcURL as CFURLRef, dstURL as CFURLRef ) as BOOLif ( fn FileManagerFileExistsAtURL( dstURL ) ) then fn FileManagerRemoveItemAtURL( dstURL )end fn = fn FileManagerCopyItemAtURL( srcURL, dstURL )// copy src/Runtime and src/Templates from an Api_Logic_Client folder into the workspacelocal fn StudioLibraryCopyFrom( repoURL as CFURLRef ) as BOOLCFURLRef runtimeURL   = fn URLByAppendingPathComponent( fn URLByAppendingPathComponent( repoURL, @"src" ), LIBRARY_RUNTIME_FOLDER )CFURLRef templatesURL = fn URLByAppendingPathComponent( fn URLByAppendingPathComponent( repoURL, @"src" ), LIBRARY_TEMPLATES_FOLDER )if ( fn FileManagerFileExistsAtURL( runtimeURL ) == NO || fn FileManagerFileExistsAtURL( templatesURL ) == NO )alert 1, NSAlertStyleWarning, @"That is not the Api_Logic_Client folder.", fn StringWithFormat( @"%@ has no src/Runtime and src/Templates folders.", fn URLPath( repoURL ) ), @[@"OK"], NOexit fn = NOend ifif ( fn StudioLibraryCopyFolder( runtimeURL, fn StudioRuntimeURL ) == NO || fn StudioLibraryCopyFolder( templatesURL, fn StudioTemplatesURL ) == NO )alert 1, NSAlertStyleWarning, @"The runtime and templates could not be copied into the workspace.", fn URLPath( fn StudioWorkspaceURL ), @[@"OK"], NOexit fn = NOend iffn StudioLibrarySaveSource( fn URLPath( repoURL ) )if (isLoggingOn) then NSLog( @"Copied the runtime and templates from %@ into %@", fn URLPath( repoURL ), fn URLPath( fn StudioWorkspaceURL ) )end fn = YES// ask for the Api_Logic_Client folder (folders only); NULL when cancelledlocal fn StudioLibraryChooseSource as CFURLRefCFURLRef repoURLopenpanel -LIBRARY_PANEL_TAG, @"Choose your Api_Logic_Client folder (the repository) - its src/Runtime and src/Templates are copied into the workspace.", , @"Use This Folder"OpenPanelSetCanChooseFiles( LIBRARY_PANEL_TAG, NO )OpenPanelSetCanChooseDirectories( LIBRARY_PANEL_TAG, YES )OpenPanelSetAllowsMultipleSelection( LIBRARY_PANEL_TAG, NO )repoURL = openpanel LIBRARY_PANEL_TAG, @"Choose your Api_Logic_Client folder (the repository) - its src/Runtime and src/Templates are copied into the workspace.", , @"Use This Folder"end fn = repoURL// before generating: YES when the runtime and the templates are in the workspace (installing them if not)local fn StudioLibraryReady as BOOLCFURLRef repoURLif ( fn StudioLibraryIsInstalled ) then exit fn = YESif ( fn StudioLibrarySource != NULL )if ( fn StudioLibraryCopyFrom( fn URLFileURLWithPath( fn StudioLibrarySource ) ) ) then exit fn = YESend ifalert 1, NSAlertStyleInformational, @"The runtime and templates are not in the workspace yet.", @"Choose your Api_Logic_Client folder (the repository): its src/Runtime and src/Templates are copied into the workspace, where every generated app is made from.", @[@"Choose…"], NOrepoURL = fn StudioLibraryChooseSourceif ( repoURL == NULL ) then exit fn = NOend fn = fn StudioLibraryCopyFrom( repoURL )// Model > Update Runtime and Templates: copy them again (after pulling a newer version)void local fn StudioLibraryUpdateCFURLRef repoURL = NULLif ( fn StudioLibrarySource != NULL ) then repoURL = fn URLFileURLWithPath( fn StudioLibrarySource )if ( repoURL == NULL ) then repoURL = fn StudioLibraryChooseSourceif ( repoURL == NULL ) then exit fnif ( fn StudioLibraryCopyFrom( repoURL ) ) then alert 1, NSAlertStyleInformational, @"Runtime and templates updated.", fn StringWithFormat( @"Copied from %@ into the workspace. Generate App to use them.", fn URLPath( repoURL ) ), @[@"OK"], NOend fn