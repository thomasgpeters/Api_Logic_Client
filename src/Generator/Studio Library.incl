/* *   I M A G E R Y    B U S I N E S S     S Y S T E M S,   L L C * *   Studio Library.incl - the runtime and the templates every generated app is made from * *   They live in the workspace, not in the Studio's app bundle (author, 2026-11-24): * *   ~/Library/Application Support/Imagery LogicBank Studio for FutureBasic/ *   ├── Studio Library.json     { "source": "/path/to/Api_Logic_Client" } - where they were copied from *   └── workspace/ *       ├── Runtime/            our FB runtime, copied into every generated app (src/Runtime) *       ├── Templates/          starting files for generated apps, the ERD page (src/Templates) *       └── <name> Project/     the projects * *   On first launch (and whenever they are missing) the Studio copies src/Runtime and src/Templates *   from the repository it was built in (found from the app's own location), or asks for the *   repository folder when it cannot find one.  While the Studio runs from its repository, Generate *   App copies them afresh every time, so apps always get the runtime the Studio was built with; *   Generate > Update Runtime and Templates does the same on demand.  A release will have an *   installer that puts them there instead (BACKLOG), so users need no repository. */#define APP_SUPPORT_FOLDER_NAME @"Imagery LogicBank Studio for FutureBasic"#define OLD_APP_SUPPORT_FOLDER_NAME @"Api_Logic_Client"     // before 2026-11-24: moved over on first launch#define WORKSPACE_FOLDER_NAME   @"workspace"#define LIBRARY_RUNTIME_FOLDER  @"Runtime"#define LIBRARY_TEMPLATES_FOLDER @"Templates"#define LIBRARY_SOURCE_FILE     @"Studio Library.json"#define LIBRARY_PANEL_TAG       7001// a JSON file that stores paths: the old folder's path becomes the new one (as written, and with// the "\/" that NSJSONSerialization writes for "/")void local fn StudioFixStoredPaths( fileURL as CFURLRef, oldPath as CFStringRef, newPath as CFStringRef )CFStringRef fileText = fn StringWithContentsOfURL( fileURL, NSUTF8StringEncoding, NULL )if ( fileText == NULL ) then exit fnfileText = fn StringByReplacingOccurrencesOfString( fileText, oldPath, newPath )fileText = fn StringByReplacingOccurrencesOfString( fileText, fn StringByReplacingOccurrencesOfString( oldPath, @"/", @"\\/" ), fn StringByReplacingOccurrencesOfString( newPath, @"/", @"\\/" ) )fn StringWriteToURL( fileText, fileURL, YES, NSUTF8StringEncoding, NULL )end fn// first launch under the product's name: move ~/Library/Application Support/Imagery LogicBank Studio for FutureBasic// (projects, Recent Projects) over, and fix the paths stored in its JSON filesvoid local fn StudioMoveOldSupportFolder( newURL as CFURLRef )CFURLRef   oldURL = fn URLByAppendingPathComponent( fn FileManagerURLForDirectory( NSApplicationSupportDirectory, NSUserDomainMask ), OLD_APP_SUPPORT_FOLDER_NAME )CFURLRef   workspaceURLCFArrayRef projectFoldersCFURLRef   entryURLif ( fn FileManagerFileExistsAtURL( newURL ) || fn FileManagerFileExistsAtURL( oldURL ) == NO ) then exit fnif ( fn FileManagerMoveItemAtURL( oldURL, newURL ) == NO )NSLog( @"Could not move %@ to %@", fn URLPath( oldURL ), fn URLPath( newURL ) )exit fnend iffn StudioFixStoredPaths( fn URLByAppendingPathComponent( newURL, @"Recent Projects.json" ), fn URLPath( oldURL ), fn URLPath( newURL ) )workspaceURL = fn URLByAppendingPathComponent( newURL, WORKSPACE_FOLDER_NAME )projectFolders = fn FileManagerContentsOfDirectoryAtURL( workspaceURL, NULL, 0 )if ( projectFolders != NULL )for entryURL in projectFoldersfn StudioFixStoredPaths( fn URLByAppendingPathComponent( entryURL, @"Project.json" ), fn URLPath( oldURL ), fn URLPath( newURL ) )nextend ifNSLog( @"Moved %@ to %@", fn URLPath( oldURL ), fn URLPath( newURL ) )end fn// ~/Library/Application Support/Imagery LogicBank Studio for FutureBasic/ (created when missing)local fn AppSupportFolderURL as CFURLRefCFURLRef folderURL = fn URLByAppendingPathComponent( fn FileManagerURLForDirectory( NSApplicationSupportDirectory, NSUserDomainMask ), APP_SUPPORT_FOLDER_NAME )fn StudioMoveOldSupportFolder( folderURL )if ( fn FileManagerFileExistsAtURL( folderURL ) == NO ) then fn FileManagerCreateDirectoryAtURL( folderURL, YES, NULL )end fn = folderURL// .../Api_Logic_Client/workspace/ (created when missing)local fn StudioWorkspaceURL as CFURLRefCFURLRef folderURL = fn URLByAppendingPathComponent( fn AppSupportFolderURL, WORKSPACE_FOLDER_NAME )if ( fn FileManagerFileExistsAtURL( folderURL ) == NO ) then fn FileManagerCreateDirectoryAtURL( folderURL, YES, NULL )end fn = folderURLlocal fn StudioRuntimeURL as CFURLRefend fn = fn URLByAppendingPathComponent( fn StudioWorkspaceURL, LIBRARY_RUNTIME_FOLDER )local fn StudioTemplatesURL as CFURLRefend fn = fn URLByAppendingPathComponent( fn StudioWorkspaceURL, LIBRARY_TEMPLATES_FOLDER )// are the runtime and the templates in the workspace?local fn StudioLibraryIsInstalled as BOOLif ( fn FileManagerFileExistsAtURL( fn URLByAppendingPathComponent( fn StudioRuntimeURL, @"Logic Engine.incl" ) ) == NO ) then exit fn = NOend fn = fn FileManagerFileExistsAtURL( fn URLByAppendingPathComponent( fn StudioTemplatesURL, @"App" ) )// the Api_Logic_Client folder they were last copied from (NULL when never)local fn StudioLibrarySource as CFStringRefCFDataRef       jsonCFDictionaryRef settingsjson = fn DataWithContentsOfURL( fn URLByAppendingPathComponent( fn AppSupportFolderURL, LIBRARY_SOURCE_FILE ), 0, NULL )if ( json == NULL ) then exit fn = NULLsettings = fn JSONSerializationJSONObjectWithData( json, 0, NULL )if ( settings == NULL ) then exit fn = NULLend fn = fn DictionaryObjectForKey( settings, @"source" )void local fn StudioLibrarySaveSource( path as CFStringRef )CFDataRef json = fn JSONSerializationDataWithJSONObject( @{ @"source":path }, NSJSONWritingPrettyPrinted, NULL )if ( json != NULL ) then fn DataWriteToURL( json, fn URLByAppendingPathComponent( fn AppSupportFolderURL, LIBRARY_SOURCE_FILE ), NSDataWritingAtomic, NULL )end fn// copy one folder over the workspace's copylocal fn StudioLibraryCopyFolder( srcURL as CFURLRef, dstURL as CFURLRef ) as BOOLif ( fn FileManagerFileExistsAtURL( dstURL ) ) then fn FileManagerRemoveItemAtURL( dstURL )end fn = fn FileManagerCopyItemAtURL( srcURL, dstURL )// copy src/Runtime and src/Templates from an Api_Logic_Client folder into the workspacelocal fn StudioLibraryCopyFrom( repoURL as CFURLRef ) as BOOLCFURLRef runtimeURL   = fn URLByAppendingPathComponent( fn URLByAppendingPathComponent( repoURL, @"src" ), LIBRARY_RUNTIME_FOLDER )CFURLRef templatesURL = fn URLByAppendingPathComponent( fn URLByAppendingPathComponent( repoURL, @"src" ), LIBRARY_TEMPLATES_FOLDER )if ( fn FileManagerFileExistsAtURL( runtimeURL ) == NO || fn FileManagerFileExistsAtURL( templatesURL ) == NO )alert 1, NSAlertStyleWarning, @"That is not the Api_Logic_Client folder.", fn StringWithFormat( @"%@ has no src/Runtime and src/Templates folders.", fn URLPath( repoURL ) ), @[@"OK"], NOexit fn = NOend ifif ( fn StudioLibraryCopyFolder( runtimeURL, fn StudioRuntimeURL ) == NO || fn StudioLibraryCopyFolder( templatesURL, fn StudioTemplatesURL ) == NO )alert 1, NSAlertStyleWarning, @"The runtime and templates could not be copied into the workspace.", fn URLPath( fn StudioWorkspaceURL ), @[@"OK"], NOexit fn = NOend iffn StudioLibrarySaveSource( fn URLPath( repoURL ) )if (isLoggingOn) then NSLog( @"Copied the runtime and templates from %@ into %@", fn URLPath( repoURL ), fn URLPath( fn StudioWorkspaceURL ) )end fn = YES// ask for the Api_Logic_Client folder (folders only); NULL when cancelledlocal fn StudioLibraryChooseSource as CFURLRefCFURLRef repoURLopenpanel -LIBRARY_PANEL_TAG, @"Choose your Api_Logic_Client folder (the repository) - its src/Runtime and src/Templates are copied into the workspace.", , @"Use This Folder"OpenPanelSetCanChooseFiles( LIBRARY_PANEL_TAG, NO )OpenPanelSetCanChooseDirectories( LIBRARY_PANEL_TAG, YES )OpenPanelSetAllowsMultipleSelection( LIBRARY_PANEL_TAG, NO )repoURL = openpanel LIBRARY_PANEL_TAG, @"Choose your Api_Logic_Client folder (the repository) - its src/Runtime and src/Templates are copied into the workspace.", , @"Use This Folder"end fn = repoURL// the repository this Studio was built from: FB builds the app inside it (src/Generator), so look// up to four folders above the app for one with src/Runtime and src/Templates (NULL when none)local fn StudioLibraryFindRepository as CFURLRefCFURLRef folderURL = fn BundleURL( fn BundleMain )long     levelfor level = 1 to 4folderURL = fn URLByDeletingLastPathComponent( folderURL )if ( fn FileManagerFileExistsAtURL( fn URLByAppendingPathComponent( folderURL, @"src/Runtime/Logic Engine.incl" ) ) )if ( fn FileManagerFileExistsAtURL( fn URLByAppendingPathComponent( folderURL, @"src/Templates" ) ) ) then exit fn = folderURLend ifnextend fn = NULL// YES when the runtime and the templates are in the workspace.  When the Studio runs from the// repository it was built in, they are copied from there on every Generate App, so a generated app// always gets the runtime that matches this Studio (a remembered folder can be an older clone).// Otherwise (a release) the installed copy is used, installed if missing: from the folder they// came from last time, else asking.local fn StudioLibraryReady as BOOLCFURLRef repoURL = fn StudioLibraryFindRepositoryif ( repoURL != NULL ) then exit fn = fn StudioLibraryCopyFrom( repoURL )if ( fn StudioLibraryIsInstalled ) then exit fn = YESif ( fn StudioLibrarySource != NULL )if ( fn StudioLibraryCopyFrom( fn URLFileURLWithPath( fn StudioLibrarySource ) ) ) then exit fn = YESend ifalert 1, NSAlertStyleInformational, @"Where is the Api_Logic_Client repository?", @"Choose the Api_Logic_Client folder you cloned (for example ~/Developer/FutureBasic/Api_Logic_Client), not a folder in Library. The Studio copies its src/Runtime and src/Templates into its own folder in Application Support, creating it as needed.", @[@"Choose..."], NOrepoURL = fn StudioLibraryChooseSourceif ( repoURL == NULL ) then exit fn = NOend fn = fn StudioLibraryCopyFrom( repoURL )// Generate > Update Runtime and Templates: copy them again (after pulling a newer version) - from the// repository this Studio was built in first, then the remembered folder, else askingvoid local fn StudioLibraryUpdateCFURLRef repoURL = fn StudioLibraryFindRepositoryif ( repoURL == NULL && fn StudioLibrarySource != NULL ) then repoURL = fn URLFileURLWithPath( fn StudioLibrarySource )if ( repoURL == NULL ) then repoURL = fn StudioLibraryChooseSourceif ( repoURL == NULL ) then exit fnif ( fn StudioLibraryCopyFrom( repoURL ) ) then alert 1, NSAlertStyleInformational, @"Runtime and templates updated.", fn StringWithFormat( @"Copied from %@ into the workspace. Generate App to use them.", fn URLPath( repoURL ) ), @[@"OK"], NOend fn