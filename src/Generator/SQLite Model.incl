/* *   I M A G E R Y    B U S I N E S S     S Y S T E M S,   L L C * *   SQLite Model * *   Builds the generator's model from a SQLite database's own structure *   (sqlite_master, pragma_table_info, pragma_foreign_key_list). Reference *   implementation, and the expected output: tools/sqlite_model.py. * *   { "source": <path>, "resources": { <table>: { *        kind           "table" | "view" *        attributes     [ { name, type, notnull, default?, pk } ]   column order *        keys           primary-key columns, in key order *        keyKind        identity | autoincrement | assigned | none *        relationships  [ { name, direction, resource, fks, parentKeys } ] *   } } } * *   keyKind      identity       INTEGER PRIMARY KEY - SQLite assigns the rowid *                autoincrement  INTEGER PRIMARY KEY AUTOINCREMENT - ids never reused *                assigned       any other key - the user (or a Cocoa UUID) supplies it *   direction    toone on the child, tomany on the parent, for every foreign key *   names        API Logic Server conventions: toone = parent table (or the key *                column without "Id" when a child has several keys to one parent), *                tomany = <Child>List (prefixed the same way when there are several) */// "OnLoanDepartmentId" -> "OnLoanDepartment",  "customer_id" -> "customer"local fn SQLiteModelRoleName( columnName as CFStringRef ) as CFStringRefCFStringRef lower = fn StringLowercaseString( columnName )long        length = fn StringLength( columnName )if ( length > 3 && fn StringHasSuffix( lower, @"_id" ) ) then exit fn = fn StringSubstringToIndex( columnName, length - 3 )if ( length > 2 && fn StringHasSuffix( lower, @"id" ) ) then exit fn = fn StringSubstringToIndex( columnName, length - 2 )end fn = columnNamelocal fn SQLiteModelKeyKind( kind as CFStringRef, sql as CFStringRef, attributes as CFArrayRef, keys as CFArrayRef ) as CFStringRefCFDictionaryRef attributeCFStringRef     upperSQL = fn StringUppercaseString( sql )BOOL            singleInteger = NOif ( fn ArrayCount( keys ) == 0 ) then exit fn = @"none"if ( fn ArrayCount( keys ) == 1 )for attribute in attributesif ( fn StringIsEqual( fn DictionaryObjectForKey( attribute, @"name" ), fn ArrayFirstObject( keys ) ) )singleInteger = fn StringIsEqual( fn StringUppercaseString( fn DictionaryObjectForKey( attribute, @"type" ) ), @"INTEGER" )end ifnextend ifif ( fn StringIsEqual( kind, @"table" ) && singleInteger && fn StringContainsString( upperSQL, @"WITHOUT ROWID" ) == NO )if ( fn StringContainsString( upperSQL, @"AUTOINCREMENT" ) ) then exit fn = @"autoincrement"exit fn = @"identity"end ifend fn = @"assigned"local fn SQLiteModelRelationship( name as CFStringRef, direction as CFStringRef, resource as CFStringRef, fks as CFArrayRef, parentKeys as CFArrayRef ) as CFDictionaryRefend fn = @{ @"name":name, @"direction":direction, @"resource":resource, @"fks":fks, @"parentKeys":parentKeys }/* *   path -> model dictionary, or NULL when the file cannot be opened */local fn SQLiteReadModel( path as CFStringRef ) as CFMutableDictionaryRefptr                    db = NULLCFMutableDictionaryRef model = fn MutableDictionaryNewCFMutableDictionaryRef resourceDict = fn MutableDictionaryNewCFMutableDictionaryRef resource, attribute, foreignKey, pairCountsCFMutableArrayRef      foreignKeys = fn MutableArrayNewCFMutableArrayRef      attributes, keys, fks, targets, parentKeysCFArrayRef             objects, objectRow, columns, columnRow, keyRows, keyRow, fkRows, fkRow, parentKeyListCFDictionaryRef        parentCFStringRef            name, kind, sql, child, parentName, pairKey, role, prefix, toOneName, toManyNamelong                   pkIndex, i, lastID, fkIDif ( fn SQLiteOpenReadOnly( path, @db ) != _sqliteOK )if (isLoggingOn) then NSLog( @"Cannot open %@: %@", path, fn SQLiteErrorMessage( db ) )fn SQLiteClose( db )exit fn = NULLend if// 1. tables and views, with columns and primary keysobjects = fn SQLiteQueryRows( db, @"SELECT name, type, IFNULL(sql, '') FROM sqlite_master WHERE type IN ('table', 'view') AND name NOT LIKE 'sqlite_%' ORDER BY name", 3 )for objectRow in objectsname = fn ArrayObjectAtIndex( objectRow, 0 )kind = fn ArrayObjectAtIndex( objectRow, 1 )sql  = fn ArrayObjectAtIndex( objectRow, 2 )attributes = fn MutableArrayNewcolumns = fn SQLiteQueryRows( db, fn StringWithFormat( @"SELECT name, type, \"notnull\", dflt_value IS NOT NULL, IFNULL(dflt_value, ''), pk FROM pragma_table_info(%@) ORDER BY cid", fn SQLiteQuoteLiteral( name ) ), 6 )for columnRow in columnsattribute = fn MutableDictionaryNewMutableDictionarySetObjectForKey( attribute, fn ArrayObjectAtIndex( columnRow, 0 ), @"name" )MutableDictionarySetObjectForKey( attribute, fn ArrayObjectAtIndex( columnRow, 1 ), @"type" )MutableDictionarySetObjectForKey( attribute, fn NumberWithBool( fn StringIntegerValue( fn ArrayObjectAtIndex( columnRow, 2 ) ) != 0 ), @"notnull" )if ( fn StringIntegerValue( fn ArrayObjectAtIndex( columnRow, 3 ) ) != 0 ) then MutableDictionarySetObjectForKey( attribute, fn ArrayObjectAtIndex( columnRow, 4 ), @"default" )MutableDictionarySetObjectForKey( attribute, fn NumberWithInteger( fn StringIntegerValue( fn ArrayObjectAtIndex( columnRow, 5 ) ) ), @"pk" )MutableArrayAddObject( attributes, attribute )nextkeys = fn MutableArrayNewkeyRows = fn SQLiteQueryRows( db, fn StringWithFormat( @"SELECT name FROM pragma_table_info(%@) WHERE pk > 0 ORDER BY pk", fn SQLiteQuoteLiteral( name ) ), 1 )for keyRow in keyRowsMutableArrayAddObject( keys, fn ArrayFirstObject( keyRow ) )nextresource = fn MutableDictionaryNewMutableDictionarySetObjectForKey( resource, kind,       @"kind" )MutableDictionarySetObjectForKey( resource, attributes, @"attributes" )MutableDictionarySetObjectForKey( resource, keys,       @"keys" )MutableDictionarySetObjectForKey( resource, fn SQLiteModelKeyKind( kind, sql, attributes, keys ), @"keyKind" )MutableDictionarySetObjectForKey( resource, fn MutableArrayNew, @"relationships" )MutableDictionarySetObjectForKey( resourceDict, resource, name )// foreign keys, grouped by id (a composite key has one row per column)if ( fn StringIsEqual( kind, @"table" ) )lastID = -1fkRows = fn SQLiteQueryRows( db, fn StringWithFormat( @"SELECT id, \"table\", \"from\", IFNULL(\"to\", '') FROM pragma_foreign_key_list(%@) ORDER BY id, seq", fn SQLiteQuoteLiteral( name ) ), 4 )for fkRow in fkRowsfkID = fn StringIntegerValue( fn ArrayObjectAtIndex( fkRow, 0 ) )if ( fkID != lastID )foreignKey = fn MutableDictionaryNewMutableDictionarySetObjectForKey( foreignKey, name, @"child" )MutableDictionarySetObjectForKey( foreignKey, fn ArrayObjectAtIndex( fkRow, 1 ), @"parent" )MutableDictionarySetObjectForKey( foreignKey, fn MutableArrayNew, @"fks" )MutableDictionarySetObjectForKey( foreignKey, fn MutableArrayNew, @"to" )MutableArrayAddObject( foreignKeys, foreignKey )lastID = fkIDend ifMutableArrayAddObject( (CFMutableArrayRef)fn DictionaryObjectForKey( foreignKey, @"fks" ), fn ArrayObjectAtIndex( fkRow, 2 ) )MutableArrayAddObject( (CFMutableArrayRef)fn DictionaryObjectForKey( foreignKey, @"to" ),  fn ArrayObjectAtIndex( fkRow, 3 ) )nextend ifnextfn SQLiteClose( db )// 2. parent columns (an empty "to" means the parent's primary key) and keys per child/parent pairpairCounts = fn MutableDictionaryNewfor foreignKey in foreignKeystargets    = fn DictionaryObjectForKey( foreignKey, @"to" )parent     = fn DictionaryObjectForKey( resourceDict, fn DictionaryObjectForKey( foreignKey, @"parent" ) )parentKeys = fn MutableArrayNewfor i = 0 to fn ArrayCount( targets ) - 1if ( fn StringLength( fn ArrayObjectAtIndex( targets, i ) ) > 0 || parent == NULL )MutableArrayAddObject( parentKeys, fn ArrayObjectAtIndex( targets, i ) )elseparentKeyList = fn DictionaryObjectForKey( parent, @"keys" )if ( i < fn ArrayCount( parentKeyList ) ) then MutableArrayAddObject( parentKeys, fn ArrayObjectAtIndex( parentKeyList, i ) ) else MutableArrayAddObject( parentKeys, @"" )end ifnextMutableDictionarySetObjectForKey( foreignKey, parentKeys, @"parentKeys" )pairKey = fn StringWithFormat( @"%@|%@", fn DictionaryObjectForKey( foreignKey, @"child" ), fn DictionaryObjectForKey( foreignKey, @"parent" ) )MutableDictionarySetObjectForKey( pairCounts, fn NumberWithInteger( fn NumberIntegerValue( fn DictionaryObjectForKey( pairCounts, pairKey ) ) + 1 ), pairKey )next// 3. relationships in both directionsfor foreignKey in foreignKeyschild      = fn DictionaryObjectForKey( foreignKey, @"child" )parentName = fn DictionaryObjectForKey( foreignKey, @"parent" )fks        = fn DictionaryObjectForKey( foreignKey, @"fks" )parentKeys = fn DictionaryObjectForKey( foreignKey, @"parentKeys" )toOneName  = parentNametoManyName = fn StringWithFormat( @"%@List", child )if ( fn NumberIntegerValue( fn DictionaryObjectForKey( pairCounts, fn StringWithFormat( @"%@|%@", child, parentName ) ) ) > 1 )role = fn SQLiteModelRoleName( fn ArrayFirstObject( fks ) )prefix = roleif ( fn StringHasSuffix( role, parentName ) ) then prefix = fn StringSubstringToIndex( role, fn StringLength( role ) - fn StringLength( parentName ) )toOneName  = roletoManyName = fn StringWithFormat( @"%@%@List", prefix, child )end ifMutableArrayAddObject( (CFMutableArrayRef)fn DictionaryObjectForKey( fn DictionaryObjectForKey( resourceDict, child ), @"relationships" ), fn SQLiteModelRelationship( toOneName, @"toone", parentName, fks, parentKeys ) )parent = fn DictionaryObjectForKey( resourceDict, parentName )if ( parent != NULL ) then MutableArrayAddObject( (CFMutableArrayRef)fn DictionaryObjectForKey( parent, @"relationships" ), fn SQLiteModelRelationship( toManyName, @"tomany", child, fks, parentKeys ) )nextMutableDictionarySetObjectForKey( model, path,      @"source" )MutableDictionarySetObjectForKey( model, resourceDict, @"resources" )end fn = model