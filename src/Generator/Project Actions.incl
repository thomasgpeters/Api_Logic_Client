/* * * * * */void local fn GrabProjectDetailsMutableStringSetString( projectName, fn ControlStringValue( _projectNameEdit ) )MutableStringAppendString ( projectName, @" Project" )ControlSetStringValue( _projectHeadingName, (CFStringRef) projectName )if (isLoggingOn) then NSLog( @"Created %@", projectName )ViewSetHidden( _projectCreateView, YES )ViewSetHidden( _projectDetailView, NO )end fn/* * * * * */void local fn ApplyAttributeNameAndType( array as CFArrayRef, obj as CFTypeRef, index as NSUInteger, stp as ^BOOL, userData as ptr )keyEnumerator = fn DictionaryKeyEnumerator( obj )newAttributeDict = fn MutableDictionaryNewanAttributeKey = fn EnumeratorNextObject( keyEnumerator )while ( anAttributeKey )newValue = fn DictionaryObjectForKey( obj, anAttributeKey )MutableDictionarySetValueForKey( newAttributeDict, newValue, anAttributeKey )anAttributeKey = fn EnumeratorNextObject( keyEnumerator )wendMutableArrayAddObject( userData, newAttributeDict )//*stp = YES// stop enumerationend fn/* * * * * */void local fn InitProject ( projectDict as CFMutableDictionaryRef )if ( projectDict != NULL )newResourceDict = fn MutableDictionaryNewresourceList = fn TableViewData( _objectTableView )if ( fn ArrayCount( resourceList ) > 0 ) then  MutableArrayRemoveAllObjects ( resourceList )projectResourcesDict = (CFMutableDictionaryRef) fn DictionaryObjectForKey( projectDict, @"resources" )arrayOfObjectKeys = fn DictionaryAllKeys( projectResourcesDict )for anObjectKey in arrayOfObjectKeysMutableArrayAddObject( resourceList, anObjectKey )if (isLoggingOn) then NSLog( @"Adding '%@' to Table View.", anObjectKey )theObjectDict = (CFMutableDictionaryRef)fn DictionaryObjectForKey( projectResourcesDict, anObjectKey )if ( theObjectDict != NULL )tempColumnArray = (CFMutableArrayRef)fn DictionaryObjectForKey( theObjectDict, @"attributes" )if ( tempColumnArray != NULL )columnArray = fn MutableArrayNewArrayEnumerateObjects( tempColumnArray, @fn ApplyAttributeNameAndType, columnArray )anObjectDict = fn MutableDictionaryNewMutableDictionarySetObjectForKey( anObjectDict, columnArray, @"attributes" )// keep everything else the model knows about the resource (keys, keyKind, relationships, kind)CFStringRef resourceKeyCFArrayRef  resourceKeys = fn DictionaryAllKeys( theObjectDict )for resourceKey in resourceKeysif ( fn StringIsEqual( resourceKey, @"attributes" ) == NO ) then MutableDictionarySetObjectForKey( anObjectDict, fn DictionaryObjectForKey( theObjectDict, resourceKey ), resourceKey )nextMutableDictionarySetValueForKey( newResourceDict, anObjectDict, anObjectKey )elseif (isLoggingOn) then NSLog( @"tempColumnArray is null!")end ifend ifnextfn GrabProjectDetailsMutableDictionarySetValueForKey( gProjectDictionary, newResourceDict, @"resources" )TableViewReloadData( _objectTableView )elseif (isLoggingOn) then NSLog( @"gProjectDictionary is null" )end ifend fn/* *   Entity definition: one row per attribute with the generator's recommendations *   (FB type, size, key role, form control, form and list widths - Type Mapping.incl). *   Row keys equal the table's column identifiers in ProjectDetailView.xib. */void local fn DisplayObjectAttributeList( theAttributeDict as CFMutableDictionaryRef )CFDictionaryRef attributeCFArrayRef      attributesresourceList = fn TableViewData( _attributeTableView )if ( fn ArrayCount( resourceList ) > 0 ) then MutableArrayRemoveAllObjects( resourceList )attributes = fn DictionaryObjectForKey( theAttributeDict, @"attributes" )if ( objectName != NULL && attributes != NULL )for attribute in attributesMutableArrayAddObject( resourceList, fn TypeMapAttributeRow( theAttributeDict, attribute ) )nextend ifTableViewReloadData( _attributeTableView )end fnvoid local fn DisplayObjectDetails ( theProjectDict as CFMutableDictionaryRef, rowIndex as long )if ( rowIndex != -1 )resourceList = fn TableViewData( _objectTableView )if (resourceList != NULL)objectName = (CFStringRef) fn ArrayObjectAtIndex( resourceList, rowIndex )if ( objectName != NULL )ControlSetStringValue( _objectNameLabel, objectName )if ( theProjectDict != NULL )projectResourcesDict = (CFMutableDictionaryRef) fn DictionaryObjectForKey( theProjectDict, @"resources" )if ( projectResourcesDict != NULL )anObject = (CFMutableDictionaryRef) fn DictionaryValueForKey( projectResourcesDict, objectName )if ( anObject != NULL )ControlSetStringValue( _objectNameLabel, fn TypeMapResourceSummary( objectName, anObject ) )fn DisplayObjectAttributeList ( anObject )end ifelseif (isLoggingOn) then NSLog( @"Project Dictionary is null" )end ifelseif (isLoggingOn) then NSLog( @"gProjectDictionary: is null" )end ifelseif (isLoggingOn) then NSLog( @"object Name: is null" )end ifelseif (isLoggingOn) then NSLog( @"Table data is null" )end ifelseif (isLoggingOn) then NSLog( @"Row index is -1" )end ifend fnvoid local fn OpenXibFileAsXMLDocumentXMLDocumentRef xibDocumentXMLElementRef rootElementCFArrayRef elementArray, windowElementArrayNSUInteger elementCountNSXMLNodeOptions xibOptions = NSXMLDocumentTidyXMLErrorRef xibErr// URLQueryItemRef queryxibUrl = openpanel 1, @"Open an xib file", @"xib;xml"if ( xibUrl != NULL )xibDocument = fn XMLDocumentWithContentsOfURL( xibUrl, xibOptions, xibErr )if ( xibDocument != NULL )rootElement = fn XMLDocumentRootElement( xibDocument )if ( rootElement != NULL )elementArray = fn XMLElementElementsForName( rootElement, @"objects" )elementCount = fn ArrayCount( elementArray )if (isLoggingOn) then NSLog(@"Element count: %i", elementCount )if ( elementCount == 1 )windowElementArray = fn XMLElementElementsForName( elementArray[ elementCount - 1 ], @"window" )if (isLoggingOn) then NSLog(@"Window Element: %@", windowElementArray )// query = fn URLQueryItemWithName( @"foo", @"bar" )// if (isLoggingOn) then NSLog( @"Query: %@", query )elseif (isLoggingOn) then NSLog( @"Element count: %i", elementCount )end ifelseif (isLoggingOn) then NSLog( @"Root Element is null." )end ifelseif (isLoggingOn) then NSLog( @"XML Document not opened." )end ifelseif (isLoggingOn) then NSLog( @"Open URL cancelled." )end ifend fn/*local fn GetXMLElementForView ( theObject as CFDictionaryRef ) as XMLElementRef'~'1XMLDocumentRef	xibDocumentXMLElementRef		elementCFStringRef			objectTypeCFURLRef				xibFolderURLxibFolderURL = fn URLByAppendingPathComponent( fn FileManagerHomeDirectoryForCurrentUser, @"ApiLogicClient/XIBs/" )select case objectTypecase @"VARCHAR"	: 'fn DoSomethingForVarcharcase @"INTEGER"	: 'fn DoSomethingForIntegercase @"FLOAT"		: 'fn DoSomethingForFloatcase else 			: 'fn DoSomethingElseend selectend fn = element*//* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *   Generates the XIBs from objects (resources) within gProjectDictionary * *    CFDictionaryRef structure * *       resources ( CFDictionaryRef ) call DictionaryForKey to get one object (resource) by name using parameter *           | *           |__ anObject - e.g., Customer, Order, Shipper, etc… *                  | *                  |__ attributes ( CFArrayRef ) *                           | *                           |__ Index - e.g. 0,1,2,3 : calls ArrayEnumerateObjects to get each attribute within tempColumnArray *                                 | *                                 |__ name ( CFDictionaryRef ) e.g., ID, Name, CreateDate *                                 |__ type ( CFDictionaryRef ) e.g., SMALLINT, TEXT, VARCHAR(32) * *   The work is done in App Generator.incl (AppGenerate), XIB Generator.incl and Binding Generator.incl, *   using the rules and designer adjustments in Type Mapping.incl; output goes to *   ~/Library/Application Support/Api_Logic_Client/workspace/<project>/ * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *//* *   Where things live. The app bundle is never written to; everything the app *   creates lives in ~/Library/Application Support/Api_Logic_Client/: *       workspace/<project>/    one folder per project (generated app, Design.json) *       Settings.plist          settings (planned; secrets go in the Keychain) *//* *   Generate XIBs / Generate XIB / Generate Binding Code / Generate App *   (what = _genXIBs, _genXIB, _genBinding, _genApp - App Generator.incl) */void local fn GenerateProjectParts( what as long )CFStringRef generatedHostif ( fn DictionaryObjectForKey( gProjectDictionary, @"resources" ) == NULL )alert 1, NSAlertStyleInformational, @"Nothing to generate yet.", @"Open a SQLite database or an ALS metadata file first.", @[@"OK"], NOexit fnend ifif ( what == _genXIB && objectName == NULL )alert 1, NSAlertStyleInformational, @"Select an entity first.", @"Generate XIB writes the Form and List parts of the selected entity.", @[@"OK"], NOexit fnend if// connection settings for the generated app come from the Create Project formgeneratedHost = fn ControlStringValue( _baseURLEdit )if ( fn StringLength( generatedHost ) == 0 ) then generatedHost = hostfn ProjectSettingsSaveMutableDictionarySetObjectForKey( gProjectDictionary, fn ProjectAboutText, @"about" )   // deployed as Credits.rtfif ( fn AppGenerate( gProjectDictionary, fn ProjectAppFolderURL, fn ProjectAppName, generatedHost, fn ControlStringValue( _authNameEdit ), what, objectName ) )if (isLoggingOn) then NSLog( @"Generated into %@", fn URLPath( fn ProjectAppFolderURL ) )elseif (isLoggingOn) then NSLog( @"Generation finished with errors - see the log above." )end ifend fn/* *   Design - the designer's adjustments to the recommendations, per attribute: *   { "<Entity>": { "<attribute>": { "title": "...", "formWidth": "120", ... } } } *   kept in <project folder>/Design.json and applied whenever the model is loaded. */local fn DesignFileURL as CFURLRefend fn = fn URLByAppendingPathComponent( fn ProjectFolderURL, @"Design.json" )void local fn DesignSaveCFMutableDictionaryRef design = fn MutableDictionaryNewCFMutableDictionaryRef entityDesignCFDictionaryRef        resourceDict = fn DictionaryObjectForKey( gProjectDictionary, @"resources" )CFDictionaryRef        attribute, attributeDesignCFArrayRef             entityNames, attributesCFStringRef            entityNameCFDataRef              jsonErrorRef               err = NULLentityNames = fn DictionaryAllKeys( resourceDict )for entityName in entityNamesentityDesign = fn MutableDictionaryNewattributes = fn DictionaryObjectForKey( fn DictionaryObjectForKey( resourceDict, entityName ), @"attributes" )for attribute in attributesattributeDesign = fn DictionaryObjectForKey( attribute, @"design" )if ( attributeDesign != NULL )if ( fn DictionaryCount( attributeDesign ) > 0 ) then MutableDictionarySetObjectForKey( entityDesign, attributeDesign, fn DictionaryObjectForKey( attribute, @"name" ) )end ifnextif ( fn DictionaryCount( entityDesign ) > 0 ) then MutableDictionarySetObjectForKey( design, entityDesign, entityName )nextjson = fn JSONSerializationDataWithJSONObject( design, NSJSONWritingPrettyPrinted, @err )if ( json != NULL ) then fn DataWriteToURL( json, fn DesignFileURL, NSDataWritingAtomic, @err )end fnvoid local fn DesignLoadCFDictionaryRef        design, entityDesign, attributeDesignCFDictionaryRef        resourceDict = fn DictionaryObjectForKey( gProjectDictionary, @"resources" )CFMutableDictionaryRef attributeCFDataRef              jsonCFArrayRef             entityNames, attributesCFStringRef            entityNameErrorRef               err = NULLjson = fn DataWithContentsOfURL( fn DesignFileURL, 0, @err )if ( json == NULL ) then exit fn                                    // no adjustments yetdesign = fn JSONSerializationJSONObjectWithData( json, NSJSONReadingMutableContainers, @err )if ( design == NULL ) then exit fnentityNames = fn DictionaryAllKeys( design )for entityName in entityNamesentityDesign = fn DictionaryObjectForKey( design, entityName )attributes = fn DictionaryObjectForKey( fn DictionaryObjectForKey( resourceDict, entityName ), @"attributes" )for attribute in attributesattributeDesign = fn DictionaryObjectForKey( entityDesign, fn DictionaryObjectForKey( attribute, @"name" ) )if ( attributeDesign != NULL ) then MutableDictionarySetObjectForKey( attribute, attributeDesign, @"design" )nextnextif (isLoggingOn) then NSLog( @"Applied design adjustments from %@", fn URLPath( fn DesignFileURL ) )end fn// a cell of the entity-definition table was edited: keep it as an adjustment (empty = back to the recommendation)void local fn DesignCellEdited( row as long, columnIdentifier as CFStringRef, textValue as CFStringRef )CFMutableDictionaryRef attribute, attributeDesignCFDictionaryRef        resourceCFArrayRef             attributesCFStringRef            designKey = fn TypeMapDesignKeyForColumn( columnIdentifier )if ( designKey == NULL || objectName == NULL ) then exit fn         // read-only columnresource   = fn DictionaryObjectForKey( fn DictionaryObjectForKey( gProjectDictionary, @"resources" ), objectName )attributes = fn DictionaryObjectForKey( resource, @"attributes" )if ( row < 0 || row >= fn ArrayCount( attributes ) ) then exit fnattribute = (CFMutableDictionaryRef)fn ArrayObjectAtIndex( attributes, row )attributeDesign = fn MutableDictionaryNewif ( fn DictionaryObjectForKey( attribute, @"design" ) != NULL ) then MutableDictionaryAddEntriesFromDictionary( attributeDesign, fn DictionaryObjectForKey( attribute, @"design" ) )if ( textValue == NULL ) then textValue = @""if ( fn StringLength( textValue ) == 0 ) then MutableDictionaryRemoveObjectForKey( attributeDesign, designKey ) else MutableDictionarySetObjectForKey( attributeDesign, textValue, designKey )MutableDictionarySetObjectForKey( attribute, attributeDesign, @"design" )fn DesignSavefn DisplayObjectAttributeList( (CFMutableDictionaryRef)resource )   // refresh: effective values, Adjusted columnend fn/* *   Opening a model.  Each loader names the project after the file (unless a name is *   typed), remembers the file as the project's source, applies the saved settings and *   design, and puts the project at the top of Recent Projects. */// after a model is loaded: settings, design, recent listvoid local fn ProjectModelLoaded( sourceURL as CFURLRef, model as CFMutableDictionaryRef )if ( len( textfield( _projectNameEdit ) ) == 0 ) then ControlSetStringValue( _projectNameEdit, fn StringByDeletingPathExtension( fn URLLastPathComponent( sourceURL ) ) )MutableDictionarySetObjectForKey( gProjectDictionary, fn URLPath( sourceURL ), @"source" )ViewSetHidden( _welcomeView, YES )fn InitProject( model )fn ProjectSettingsLoad                                              // connection settings, if savedfn DesignLoad                                                       // the designer's adjustments, if anyfn ProjectSettingsSavefn RecentProjectsAddViewSetHidden( _projectSettingsView, YES )end fn// an ALS /metadata?include=attributes response saved to disk (e.g. samples/Northwind/metadata.json),// so the model can be browsed and XIBs generated without a running serverlocal fn LoadMetadataModel( jsonURL as CFURLRef ) as BOOLCFDataRef              jsonDataCFMutableDictionaryRef jsonObjectErrorRef               err = NULLjsonData = fn DataWithContentsOfURL( jsonURL, 0, @err )if ( jsonData == NULL )if (isLoggingOn) then NSLog( @"Could not read %@: %@", fn URLPath( jsonURL ), fn ErrorLocalizedDescription( err ) )exit fn = NOend ifjsonObject = (CFMutableDictionaryRef)fn JSONSerializationJSONObjectWithData( jsonData, NSJSONReadingMutableContainers + NSJSONReadingMutableLeaves, @err )if ( jsonObject == NULL )if (isLoggingOn) then NSLog( @"Not valid JSON: %@", fn ErrorLocalizedDescription( err ) )exit fn = NOend iffn ProjectModelLoaded( jsonURL, jsonObject )end fn = YES// lite edition: tables, columns, primary keys (keyKind) and foreign-key relationships - SQLite Model.incl// The database is copied into the project first (Project Workspace.incl: ProjectLocalDatabase);// the model is read from, and the project's source is, that copy.local fn LoadSQLiteModel( chosenURL as CFURLRef ) as BOOLCFMutableDictionaryRef modelCFURLRef               databaseURLCFStringRef            name = fn ControlStringValue( _projectNameEdit )if ( fn StringLength( name ) == 0 )name = fn StringByDeletingPathExtension( fn URLLastPathComponent( chosenURL ) )ControlSetStringValue( _projectNameEdit, name )end ifdatabaseURL = fn ProjectLocalDatabase( chosenURL, name )if ( databaseURL == NULL ) then exit fn = NOmodel = fn SQLiteReadModel( fn URLPath( databaseURL ) )if ( model == NULL )alert 1, NSAlertStyleWarning, @"Could not read the database.", fn URLPath( databaseURL ), @[@"OK"], NOexit fn = NOend ifif (isLoggingOn) then NSLog( @"Read %ld tables and views from %@", fn DictionaryCount( fn DictionaryObjectForKey( model, @"resources" ) ), fn URLPath( databaseURL ) )fn ProjectModelLoaded( databaseURL, model )end fn = YES// the model file, by its extensionlocal fn LoadModelFile( sourceURL as CFURLRef ) as BOOLif ( fn StringIsEqual( fn StringLowercaseString( fn URLPathExtension( sourceURL ) ), @"json" ) ) then exit fn = fn LoadMetadataModel( sourceURL )end fn = fn LoadSQLiteModel( sourceURL )void local fn OpenMetadataFileCFURLRef jsonURL = openpanel 1, @"Open an ALS metadata JSON file", @"json"if ( jsonURL != NULL ) then fn LoadMetadataModel( jsonURL )end fnvoid local fn OpenSQLiteDatabaseCFURLRef databaseURL = openpanel 1, @"Open a SQLite database", @"sqlite;db;sqlite3"if ( databaseURL != NULL ) then fn LoadSQLiteModel( databaseURL )end fn/* *   Open Project - a project's Project.json: its name, then its model source *   (asks for the file when it has moved), then settings and design as above. */void local fn OpenProjectSettingsFile( settingsURL as CFURLRef )CFDictionaryRef settings = NULLCFDataRef       jsonCFStringRef     name, sourceCFURLRef        sourceURLNSModalResponse responseErrorRef        err = NULLjson = fn DataWithContentsOfURL( settingsURL, 0, @err )if ( json != NULL ) then settings = fn JSONSerializationJSONObjectWithData( json, 0, @err )if ( settings == NULL )alert 1, NSAlertStyleWarning, @"This is not a project file.", fn URLPath( settingsURL ), @[@"OK"], NOexit fnend ifname   = fn DictionaryObjectForKey( settings, @"name" )source = fn DictionaryObjectForKey( settings, @"source" )if ( name == NULL || source == NULL )alert 1, NSAlertStyleWarning, @"This project has no model file.", @"Open its SQLite database or metadata JSON from the Model menu.", @[@"OK"], NOexit fnend if// a fresh start: the project's own name and saved connection fieldsControlSetStringValue( _projectNameEdit, name )ControlSetStringValue( _baseURLEdit, @"" )ControlSetStringValue( _authNameEdit, @"" )ControlSetStringValue( _aboutTextEdit, @"" )sourceURL = fn URLFileURLWithPath( source )if ( fn FileManagerFileExistsAtURL( sourceURL ) == NO )response = alert 1, NSAlertStyleWarning, @"The project's model file has moved.", source, @[@"Locate…", @"Cancel"]if ( response != NSAlertFirstButtonReturn ) then exit fnsourceURL = openpanel 1, @"Locate the model file", fn URLPathExtension( sourceURL )if ( sourceURL == NULL ) then exit fnend iffn LoadModelFile( sourceURL )                                       // saves the new locationend fnvoid local fn OpenProjectCFURLRef settingsURLsettingsURL = openpanel 1, @"Open a project (its Project.json)", @"json", @"Open", fn URLByAppendingPathComponent( fn AppSupportFolderURL, WORKSPACE_FOLDER_NAME )if ( settingsURL != NULL ) then fn OpenProjectSettingsFile( settingsURL )end fnvoid local fn OpenRecentProject( row as long )CFStringRef path = fn RecentProjectPath( row )if ( path == NULL ) then exit fnif ( fn FileManagerFileExistsAtURL( fn URLFileURLWithPath( path ) ) == NO )alert 1, NSAlertStyleWarning, @"The project is no longer in the workspace.", path, @[@"OK"], NOexit fnend iffn OpenProjectSettingsFile( fn URLFileURLWithPath( path ) )end fn// back to the Welcome view (recent projects)void local fn ShowWelcomeViewSetHidden( _projectCreateView, YES )ViewSetHidden( _projectDetailView, YES )ViewSetHidden( _projectSettingsView, YES )ViewSetHidden( _newProjectView, YES )ViewSetHidden( _welcomeView, NO )fn RecentProjectsShowend fn