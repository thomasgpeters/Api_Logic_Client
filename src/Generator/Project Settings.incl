/* *   Project Settings.incl * *   The Project Settings view (ProjectSettingsView.xib, Model > Project Settings...): *   what is deployed with the generated app beyond the model.  Today: the About *   text (at most ABOUT_TEXT_MAX characters), which becomes the app's Credits.rtf - *   the standard About box shows it under the app's name, icon and version. *   Saved in Project.json (Project Workspace.incl). */void local fn ProjectSettingsShowCountControlSetStringValue( _aboutCountLabel, fn StringWithFormat( @"%ld / %d", (long)fn StringLength( fn ControlStringValue( _aboutTextEdit ) ), ABOUT_TEXT_MAX ) )end fn// typing in the About text: keep it within the limit, update the countervoid local fn AboutTextChangedCFStringRef about = fn ControlStringValue( _aboutTextEdit )if ( fn StringLength( about ) > ABOUT_TEXT_MAX )ControlSetStringValue( _aboutTextEdit, fn StringSubstringToIndex( about, ABOUT_TEXT_MAX ) )beepend iffn ProjectSettingsShowCountend fnvoid local fn ShowProjectSettingsif ( fn DictionaryObjectForKey( gProjectDictionary, @"resources" ) == NULL )alert 1, NSAlertStyleInformational, @"No project is open.", @"Open a project or a model first.", @[@"OK"], NOexit fnend ifViewSetHidden( _welcomeView, YES )ViewSetHidden( _projectCreateView, YES )ViewSetHidden( _projectDetailView, YES )ViewSetHidden( _projectSettingsView, NO )fn ProjectSettingsShowCountWindowMakeFirstResponder( _window, _aboutTextEdit )end fn// Done: save and go back to the entity definitionsvoid local fn ProjectSettingsDonefn ProjectSettingsSaveViewSetHidden( _projectSettingsView, YES )ViewSetHidden( _projectDetailView, NO )end fn