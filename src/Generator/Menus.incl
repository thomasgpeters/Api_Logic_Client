/* *   Menus.incl - the Studio's menu bar and toolbar, and which of their commands apply now * *   Menus, grouped by what the developer works on (docs/STUDIO_REVIEW.md): *     Project   new, open, recent, close, settings, Finder, delete *     Edit      FB's standard edit menu *     Model     open a SQLite database or ALS metadata, the model diagram, rules *     Generate  the app, its XIBs and bindings, the runtime *     Window    minimize, zoom, close *     Help      the user guide, the workspace *   Item numbers are display positions: separators count. *   Shortcuts: the usual ones (N, O, W, M, ?), command-1 / command-2 for the two main views *   (Recent Projects, Entity Definitions), option-command for the Finder and the less frequent *   commands; deleting a project has none (it asks first anyway). * *   StudioUpdateCommands enables each command, toolbar item and design control only when what it *   acts on exists: a project, a selected entity, a selected attribute.  Call it whenever one of *   those changes (EventHandlers.incl, Project Actions.incl). */// menus_mApplication = 0begin enum 1_iSeparator                 // required for the application menuend enum_mProject = 1begin enum 1_iNewProject_iOpenProject_iRecentProjects_iEntityDefinitions_iClearRecentProjects_iProjectSeparator1_iCloseProject_iProjectSettings_iShowProjectInFinder_iProjectSeparator2_iDeleteProjectend enum_mEdit = 2                  // Cut, Copy, Paste: the cells, the text fields, the app icon well_mModel = 3begin enum 1_iOpenSQLite_iOpenMetadata_iModelSeparator1_iShowModelDiagram_iModelSeparator2_iImportRules_iExportRulesend enum_mGenerate = 4begin enum 1_iGenerateApp_iGenerateSeparator1_iGenerateXIBs_iGenerateXIB_iGenerateBinding_iGenerateSeparator2_iShowGeneratedApp_iUpdateLibrary_iOpenOneXib                // a developer's tool: only when STUDIO_DEBUG_MENU is YESend enum_mWindow = 5begin enum 1_iMinimize_iZoom_iCloseWindowend enum_mHelp = 6begin enum 1_iStudioHelp_iShowWorkspaceend enum#define STUDIO_DEBUG_MENU NO// toolbar items (Toolbar.xib): a tag range of their own, clear of every view's controls_tbProjects  = 600          // the Welcome view: new, open, recent_tbEntities  = 601          // the entity definitions of the open project_tbDiagram   = 602          // Show Model Diagram_tbGenerate  = 603          // Generate App_tbSettings  = 604          // Project Settings// the crumb trail along the top of the page area (StudioUpdateCrumbs)_studioCrumbTrail = 610begin globalsCFMutableArrayRef gStudioCrumbActions       // beside each crumb: "projects", "entities" or ""end globalsvoid local fn BuildMenu// application menu (FB adds About, Hide, Quit)menu _mApplication, _iSeparator// projectmenu _mProject,,, @"Project"menu _mProject, _iNewProject,,          @"New Project…", @"n"menu _mProject, _iOpenProject,,         @"Open Project…", @"o"menu _mProject, _iRecentProjects,,      @"Recent Projects", @"1"menu _mProject, _iEntityDefinitions,,   @"Entity Definitions", @"2"menu _mProject, _iClearRecentProjects,, @"Clear Recent Projects"menu _mProject, _iProjectSeparator1menu _mProject, _iCloseProject,,        @"Close Project", @"W"          // shift-command-Wmenu _mProject, _iProjectSettings,,     @"Project Settings…", @";"menu _mProject, _iShowProjectInFinder,, @"Show Project in Finder", @"r", NSEventModifierFlagCommand + NSEventModifierFlagOptionmenu _mProject, _iProjectSeparator2menu _mProject, _iDeleteProject,,       @"Delete Project…"MenuSetAutoenablesItems( _mProject, NO )                                // StudioUpdateCommands decides// edit - FB's standard Edit menu (Undo, Cut, Copy, Paste, Select All)editmenu _mEdit// modelmenu _mModel,,, @"Model"menu _mModel, _iOpenSQLite,,        @"Open SQLite Database…", @"d"menu _mModel, _iOpenMetadata,,      @"Open API Logic Server Metadata…", @"j"menu _mModel, _iModelSeparator1menu _mModel, _iShowModelDiagram,,  @"Show Model Diagram", @"D"        // shift-command-D: the ERD in the browsermenu _mModel, _iModelSeparator2menu _mModel, _iImportRules,,       @"Import Rules from declare_logic.py…", @"i", NSEventModifierFlagCommand + NSEventModifierFlagOptionmenu _mModel, _iExportRules,,       @"Export Rules to declare_logic.py…", @"e", NSEventModifierFlagCommand + NSEventModifierFlagOptionMenuSetAutoenablesItems( _mModel, NO )// generatemenu _mGenerate,,, @"Generate"menu _mGenerate, _iGenerateApp,,      @"Generate App", @"g"menu _mGenerate, _iGenerateSeparator1menu _mGenerate, _iGenerateXIBs,,     @"Generate XIBs", @"X"           // shift-command-X: command-X is Cutmenu _mGenerate, _iGenerateXIB,,      @"Generate XIB for Selected Entity", @"e"menu _mGenerate, _iGenerateBinding,,  @"Generate Binding Code", @"b"menu _mGenerate, _iGenerateSeparator2menu _mGenerate, _iShowGeneratedApp,, @"Show Generated App in Finder", @"g", NSEventModifierFlagCommand + NSEventModifierFlagOptionmenu _mGenerate, _iUpdateLibrary,,    @"Update Runtime and Templates…", @"u", NSEventModifierFlagCommand + NSEventModifierFlagOption  // copy them again from the repository (Studio Library.incl)if ( STUDIO_DEBUG_MENU ) then menu _mGenerate, _iOpenOneXib,, @"Open One Xib (debug)"MenuSetAutoenablesItems( _mGenerate, NO )// windowmenu _mWindow,,, @"Window"menu _mWindow, _iMinimize,,    @"Minimize", @"m"MenuItemSetAction( _mWindow, _iMinimize, @"performMiniaturize:" )menu _mWindow, _iZoom,,        @"Zoom"MenuItemSetAction( _mWindow, _iZoom, @"performZoom:" )menu _mWindow, _iCloseWindow,, @"Close", @"w"MenuItemSetAction( _mWindow, _iCloseWindow, @"performClose:" )// helpmenu _mHelp,,, @"Help"menu _mHelp, _iStudioHelp,,    @"Imagery LogicBank Studio Help", @"?"menu _mHelp, _iShowWorkspace,, @"Show Workspace in Finder", @"K"           // shift-command-Kend fn// the crumb trail along the top of the page area: where the developer is, and the way back.// Each item's action is kept beside it: "projects" (the Projects screen), "entities" (the open// project's definitions), "" (where you are).void local fn StudioCrumb( items as CFMutableArrayRef, title as CFStringRef, symbolName as CFStringRef, action as CFStringRef )PathControlItemRef item = fn PathControlItemInitPathControlItemSetTitle( item, title )PathControlItemSetImage( item, fn ImageWithSystemSymbolName( symbolName, title ) )MutableArrayAddObject( items, item )MutableArrayAddObject( gStudioCrumbActions, action )end fnvoid local fn StudioUpdateCrumbs( hasProject as BOOL, hasEntity as BOOL )CFMutableArrayRef items = fn MutableArrayNewgStudioCrumbActions = fn MutableArrayNewfn StudioCrumb( items, @"Projects", @"house", @"projects" )if ( fn ViewIsHidden( _newProjectView ) == NO ) then fn StudioCrumb( items, @"New Project", @"plus.square", @"" )if ( fn ViewIsHidden( _projectCreateView ) == NO ) then fn StudioCrumb( items, @"API Logic Server", @"server.rack", @"" )if ( hasProject && fn ViewIsHidden( _welcomeView ) && fn ViewIsHidden( _newProjectView ) && fn ViewIsHidden( _projectCreateView ) )fn StudioCrumb( items, projectName, @"folder", @"entities" )if ( fn ViewIsHidden( _projectSettingsView ) == NO ) then fn StudioCrumb( items, @"Settings", @"gearshape", @"" )if ( hasEntity && fn ViewIsHidden( _projectDetailView ) == NO ) then fn StudioCrumb( items, objectName, @"tablecells", @"" )end ifPathControlSetPathItems( _studioCrumbTrail, items )end fn// a crumb was clicked: the action kept beside it (StudioCrumb)local fn StudioCrumbAction as CFStringRefCFArrayRef         items = fn PathControlPathItems( _studioCrumbTrail )PathControlItemRef clicked = fn PathControlClickedPathItem( _studioCrumbTrail )long               indexif ( clicked == NULL || items == NULL || gStudioCrumbActions == NULL ) then exit fn = @""if ( fn ArrayContainsObject( items, clicked ) == NO ) then exit fn = @""index = fn ArrayIndexOfObject( items, clicked )if ( index >= fn ArrayCount( gStudioCrumbActions ) ) then exit fn = @""end fn = fn ArrayObjectAtIndex( gStudioCrumbActions, index )/* *   Which commands apply now.  The states, each needing the one before: *     a project is open        a model is loaded under a project name *     an entity is selected    a row of the Objects list *     an attribute is selected a row of the attribute table *   Delete Project also applies to a project selected in Recent Projects (the Welcome view). */void local fn StudioUpdateCommandsBOOL hasProject = NO, hasEntity = NO, hasAttribute = NO, hasRecent = NOif ( fn StringLength( projectName ) > 0 && fn DictionaryObjectForKey( gProjectDictionary, @"resources" ) != NULL ) then hasProject = YESif ( hasProject && objectName != NULL ) then hasEntity = ( fn TableViewSelectedRow( _objectTableView ) >= 0 )if ( hasEntity ) then hasAttribute = ( fn TableViewSelectedRow( _attributeTableView ) >= 0 )hasRecent = ( fn TableViewSelectedRow( _recentProjectsTable ) >= 0 )// Project: new, open and recent always applyMenuItemSetEnabled( _mProject, _iNewProject, YES )MenuItemSetEnabled( _mProject, _iOpenProject, YES )MenuItemSetEnabled( _mProject, _iRecentProjects, YES )MenuItemSetEnabled( _mProject, _iEntityDefinitions, hasProject )MenuItemSetEnabled( _mProject, _iClearRecentProjects, YES )MenuItemSetEnabled( _mProject, _iCloseProject, hasProject )MenuItemSetEnabled( _mProject, _iProjectSettings, hasProject )MenuItemSetEnabled( _mProject, _iShowProjectInFinder, hasProject )MenuItemSetEnabled( _mProject, _iDeleteProject, ( hasProject || hasRecent ) )// Model: opening a model always applies; the rest needs oneMenuItemSetEnabled( _mModel, _iOpenSQLite, YES )MenuItemSetEnabled( _mModel, _iOpenMetadata, YES )MenuItemSetEnabled( _mModel, _iShowModelDiagram, hasProject )MenuItemSetEnabled( _mModel, _iImportRules, hasProject )MenuItemSetEnabled( _mModel, _iExportRules, hasProject )// Generate: a project; one entity's XIB needs that entity, and its name is on the itemMenuItemSetEnabled( _mGenerate, _iGenerateApp, hasProject )MenuItemSetEnabled( _mGenerate, _iGenerateXIBs, hasProject )MenuItemSetEnabled( _mGenerate, _iGenerateBinding, hasProject )MenuItemSetEnabled( _mGenerate, _iShowGeneratedApp, hasProject )MenuItemSetEnabled( _mGenerate, _iUpdateLibrary, YES )MenuItemSetEnabled( _mGenerate, _iGenerateXIB, hasEntity )if ( hasEntity )MenuItemSetTitle( _mGenerate, _iGenerateXIB, fn StringWithFormat( @"Generate XIB for %@", objectName ) )elseMenuItemSetTitle( _mGenerate, _iGenerateXIB, @"Generate XIB for Selected Entity" )end ifif ( STUDIO_DEBUG_MENU ) then MenuItemSetEnabled( _mGenerate, _iOpenOneXib, YES )// toolbar: Projects always; the rest needs a project (autovalidation off, or AppKit re-enables them)ToolbarItemSetAutovalidates( _mainToolbar, _tbProjects, NO )ToolbarItemSetAutovalidates( _mainToolbar, _tbEntities, NO )ToolbarItemSetAutovalidates( _mainToolbar, _tbDiagram, NO )ToolbarItemSetAutovalidates( _mainToolbar, _tbGenerate, NO )ToolbarItemSetAutovalidates( _mainToolbar, _tbSettings, NO )ToolbarItemSetEnabled( _mainToolbar, _tbProjects, YES )ToolbarItemSetEnabled( _mainToolbar, _tbEntities, hasProject )ToolbarItemSetEnabled( _mainToolbar, _tbDiagram, hasProject )ToolbarItemSetEnabled( _mainToolbar, _tbGenerate, hasProject )ToolbarItemSetEnabled( _mainToolbar, _tbSettings, hasProject )// the toolbar's tooltips name the menu shortcutToolbarItemSetToolTip( _mainToolbar, _tbProjects, @"New, open and recent projects (Command-1)" )ToolbarItemSetToolTip( _mainToolbar, _tbEntities, @"The open project's entity definitions (Command-2)" )ToolbarItemSetToolTip( _mainToolbar, _tbDiagram, @"Show Model Diagram (Shift-Command-D)" )ToolbarItemSetToolTip( _mainToolbar, _tbGenerate, @"Generate App (Command-G)" )ToolbarItemSetToolTip( _mainToolbar, _tbSettings, @"Project Settings (Command-;)" )// the crumb trail: where the developer isfn StudioUpdateCrumbs( hasProject, hasEntity )// the entity view's design row: the entity's popups need an entity, Control needs an attributeControlSetEnabled( _formColumnsPopup, hasEntity )ControlSetEnabled( _entityIconPopup, hasEntity )ControlSetEnabled( _controlPopup, hasAttribute )end fn