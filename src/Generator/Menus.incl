/* *   Menus.incl - the Studio's menu bar and toolbar, and which of their commands apply now * *   Menus, grouped by what the developer works on (docs/STUDIO_REVIEW.md): *     Project   new, open, recent, close, settings, Finder, delete *     Edit      FB's standard edit menu *     Model     open a SQLite database or ALS metadata, the model diagram, rules *     Generate  the app, its XIBs and bindings, the runtime *     Window    minimize, zoom, close *     Help      the user guide, the workspace *   Item numbers are display positions: separators count. * *   StudioUpdateCommands enables each command, toolbar item and design control only when what it *   acts on exists: a project, a selected entity, a selected attribute.  Call it whenever one of *   those changes (EventHandlers.incl, Project Actions.incl). */// menus_mApplication = 0begin enum 1_iSeparator                 // required for the application menuend enum_mProject = 1begin enum 1_iNewProject_iOpenProject_iRecentProjects_iClearRecentProjects_iProjectSeparator1_iCloseProject_iProjectSettings_iShowProjectInFinder_iProjectSeparator2_iDeleteProjectend enum_mEdit = 2                  // Cut, Copy, Paste: the cells, the text fields, the app icon well_mModel = 3begin enum 1_iOpenSQLite_iOpenMetadata_iModelSeparator1_iShowModelDiagram_iModelSeparator2_iImportRules_iExportRulesend enum_mGenerate = 4begin enum 1_iGenerateApp_iGenerateSeparator1_iGenerateXIBs_iGenerateXIB_iGenerateBinding_iGenerateSeparator2_iShowGeneratedApp_iUpdateLibrary_iOpenOneXib                // a developer's tool: only when STUDIO_DEBUG_MENU is YESend enum_mWindow = 5begin enum 1_iMinimize_iZoom_iCloseWindowend enum_mHelp = 6begin enum 1_iStudioHelp_iShowWorkspaceend enum#define STUDIO_DEBUG_MENU NO// toolbar items (Toolbar.xib): a tag range of their own, clear of every view's controls_tbProjects  = 600          // the Welcome view: new, open, recent_tbEntities  = 601          // the entity definitions of the open project_tbDiagram   = 602          // Show Model Diagram_tbGenerate  = 603          // Generate App_tbSettings  = 604          // Project Settingsvoid local fn BuildMenu// application menu (FB adds About, Hide, Quit)menu _mApplication, _iSeparator// projectmenu _mProject,,, @"Project"menu _mProject, _iNewProject,,          @"New Project…", @"n"menu _mProject, _iOpenProject,,         @"Open Project…", @"o"menu _mProject, _iRecentProjects,,      @"Recent Projects"menu _mProject, _iClearRecentProjects,, @"Clear Recent Projects"menu _mProject, _iProjectSeparator1menu _mProject, _iCloseProject,,        @"Close Project", @"W"          // shift-command-Wmenu _mProject, _iProjectSettings,,     @"Project Settings…", @";"menu _mProject, _iShowProjectInFinder,, @"Show Project in Finder"menu _mProject, _iProjectSeparator2menu _mProject, _iDeleteProject,,       @"Delete Project…"MenuSetAutoenablesItems( _mProject, NO )                                // StudioUpdateCommands decides// edit - FB's standard Edit menu (Undo, Cut, Copy, Paste, Select All)editmenu _mEdit// modelmenu _mModel,,, @"Model"menu _mModel, _iOpenSQLite,,        @"Open SQLite Database…", @"d"menu _mModel, _iOpenMetadata,,      @"Open API Logic Server Metadata…", @"j"menu _mModel, _iModelSeparator1menu _mModel, _iShowModelDiagram,,  @"Show Model Diagram", @"D"        // shift-command-D: the ERD in the browsermenu _mModel, _iModelSeparator2menu _mModel, _iImportRules,,       @"Import Rules from declare_logic.py…"menu _mModel, _iExportRules,,       @"Export Rules to declare_logic.py…"MenuSetAutoenablesItems( _mModel, NO )// generatemenu _mGenerate,,, @"Generate"menu _mGenerate, _iGenerateApp,,      @"Generate App", @"g"menu _mGenerate, _iGenerateSeparator1menu _mGenerate, _iGenerateXIBs,,     @"Generate XIBs", @"X"           // shift-command-X: command-X is Cutmenu _mGenerate, _iGenerateXIB,,      @"Generate XIB for Selected Entity", @"e"menu _mGenerate, _iGenerateBinding,,  @"Generate Binding Code", @"b"menu _mGenerate, _iGenerateSeparator2menu _mGenerate, _iShowGeneratedApp,, @"Show Generated App in Finder"menu _mGenerate, _iUpdateLibrary,,    @"Update Runtime and Templates…"  // copy them again from the repository (Studio Library.incl)if ( STUDIO_DEBUG_MENU ) then menu _mGenerate, _iOpenOneXib,, @"Open One Xib (debug)"MenuSetAutoenablesItems( _mGenerate, NO )// windowmenu _mWindow,,, @"Window"menu _mWindow, _iMinimize,,    @"Minimize", @"m"MenuItemSetAction( _mWindow, _iMinimize, @"performMiniaturize:" )menu _mWindow, _iZoom,,        @"Zoom"MenuItemSetAction( _mWindow, _iZoom, @"performZoom:" )menu _mWindow, _iCloseWindow,, @"Close", @"w"MenuItemSetAction( _mWindow, _iCloseWindow, @"performClose:" )// helpmenu _mHelp,,, @"Help"menu _mHelp, _iStudioHelp,,    @"Imagery LogicBank Studio Help", @"?"menu _mHelp, _iShowWorkspace,, @"Show Workspace in Finder"end fn/* *   Which commands apply now.  The states, each needing the one before: *     a project is open        a model is loaded under a project name *     an entity is selected    a row of the Objects list *     an attribute is selected a row of the attribute table *   Delete Project also applies to a project selected in Recent Projects (the Welcome view). */void local fn StudioUpdateCommandsBOOL hasProject = NO, hasEntity = NO, hasAttribute = NO, hasRecent = NOif ( fn StringLength( projectName ) > 0 && fn DictionaryObjectForKey( gProjectDictionary, @"resources" ) != NULL ) then hasProject = YESif ( hasProject && objectName != NULL ) then hasEntity = ( fn TableViewSelectedRow( _objectTableView ) >= 0 )if ( hasEntity ) then hasAttribute = ( fn TableViewSelectedRow( _attributeTableView ) >= 0 )hasRecent = ( fn TableViewSelectedRow( _recentProjectsTable ) >= 0 )// Project: new, open and recent always applyMenuItemSetEnabled( _mProject, _iNewProject, YES )MenuItemSetEnabled( _mProject, _iOpenProject, YES )MenuItemSetEnabled( _mProject, _iRecentProjects, YES )MenuItemSetEnabled( _mProject, _iClearRecentProjects, YES )MenuItemSetEnabled( _mProject, _iCloseProject, hasProject )MenuItemSetEnabled( _mProject, _iProjectSettings, hasProject )MenuItemSetEnabled( _mProject, _iShowProjectInFinder, hasProject )MenuItemSetEnabled( _mProject, _iDeleteProject, ( hasProject || hasRecent ) )// Model: opening a model always applies; the rest needs oneMenuItemSetEnabled( _mModel, _iOpenSQLite, YES )MenuItemSetEnabled( _mModel, _iOpenMetadata, YES )MenuItemSetEnabled( _mModel, _iShowModelDiagram, hasProject )MenuItemSetEnabled( _mModel, _iImportRules, hasProject )MenuItemSetEnabled( _mModel, _iExportRules, hasProject )// Generate: a project; one entity's XIB needs that entity, and its name is on the itemMenuItemSetEnabled( _mGenerate, _iGenerateApp, hasProject )MenuItemSetEnabled( _mGenerate, _iGenerateXIBs, hasProject )MenuItemSetEnabled( _mGenerate, _iGenerateBinding, hasProject )MenuItemSetEnabled( _mGenerate, _iShowGeneratedApp, hasProject )MenuItemSetEnabled( _mGenerate, _iUpdateLibrary, YES )MenuItemSetEnabled( _mGenerate, _iGenerateXIB, hasEntity )if ( hasEntity )MenuItemSetTitle( _mGenerate, _iGenerateXIB, fn StringWithFormat( @"Generate XIB for %@", objectName ) )elseMenuItemSetTitle( _mGenerate, _iGenerateXIB, @"Generate XIB for Selected Entity" )end ifif ( STUDIO_DEBUG_MENU ) then MenuItemSetEnabled( _mGenerate, _iOpenOneXib, YES )// toolbar: Projects always; the rest needs a project (autovalidation off, or AppKit re-enables them)ToolbarItemSetAutovalidates( _mainToolbar, _tbProjects, NO )ToolbarItemSetAutovalidates( _mainToolbar, _tbEntities, NO )ToolbarItemSetAutovalidates( _mainToolbar, _tbDiagram, NO )ToolbarItemSetAutovalidates( _mainToolbar, _tbGenerate, NO )ToolbarItemSetAutovalidates( _mainToolbar, _tbSettings, NO )ToolbarItemSetEnabled( _mainToolbar, _tbProjects, YES )ToolbarItemSetEnabled( _mainToolbar, _tbEntities, hasProject )ToolbarItemSetEnabled( _mainToolbar, _tbDiagram, hasProject )ToolbarItemSetEnabled( _mainToolbar, _tbGenerate, hasProject )ToolbarItemSetEnabled( _mainToolbar, _tbSettings, hasProject )// the entity view's design row: the entity's popups need an entity, Control needs an attributeControlSetEnabled( _formColumnsPopup, hasEntity )ControlSetEnabled( _entityIconPopup, hasEntity )ControlSetEnabled( _controlPopup, hasAttribute )end fn