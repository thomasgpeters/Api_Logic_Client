// menus_mApplication = 0begin enum 1_iSeparator// required for Application menu_iPreferencesend enum_mFile = 1begin enum 1_iCloseend enum_mEdit = 2                  // Edit: Cut, Copy, Paste (the logo well in Project Settings needs Paste)_mXibs = 3                  // the Model menu - item numbers are display positionsbegin enum 1_iOpenProject_iShowRecentProjects_iClearRecentProjects_iProjectSettings_iModelSeparator0_iOpenSQLite_iOpenMetadata_iModelSeparator1_iGenerateXIBs_iGenerateXIB_iGenerateBinding_iGenerateApp_iModelSeparator3_iImportRules_iExportRules_iModelSeparator2_iShowWorkspace_iOpenOneXibend enum_mHelp = 4void local fn BuildMenu// preferencesmenu _mApplication, _iSeparator// required for Application menumenu _mApplication, _iPreferences,, @"Preferences…", @","// filemenu _mFile,,, @"File"menu _mFile, _iClose,, @"Close", @"w"MenuItemSetAction( _mFile, _iClose, @"performClose:" )// edit - FB's standard Edit menu (Undo, Cut, Copy, Paste, Select All)editmenu _mEdit// modelmenu _mXibs,,, @"Model"menu _mXibs, _iOpenProject,,         @"Open Project…", @"O"      // shift-command-Omenu _mXibs, _iShowRecentProjects,,  @"Recent Projects"menu _mXibs, _iClearRecentProjects,, @"Clear Recent Projects"menu _mXibs, _iProjectSettings,,     @"Project Settings…", @";"menu _mXibs, _iModelSeparator0menu _mXibs, _iOpenSQLite,,      @"Open SQLite Database…", @"d"menu _mXibs, _iOpenMetadata,,    @"Open Metadata JSON…", @"j"menu _mXibs, _iModelSeparator1menu _mXibs, _iGenerateXIBs,,    @"Generate XIBs", @"X"      // shift-command-X: command-X is Cutmenu _mXibs, _iGenerateXIB,,     @"Generate XIB for Selected Entity", @"e"menu _mXibs, _iGenerateBinding,, @"Generate Binding Code", @"b"menu _mXibs, _iGenerateApp,,     @"Generate App", @"g"menu _mXibs, _iModelSeparator3menu _mXibs, _iImportRules,,     @"Import Rules from declare_logic.py…"menu _mXibs, _iExportRules,,     @"Export Rules to declare_logic.py…"menu _mXibs, _iModelSeparator2menu _mXibs, _iShowWorkspace,,   @"Show Workspace in Finder"menu _mXibs, _iOpenOneXib,,      @"Open One Xib", @"o"// helphelpmenu _mHelpend fn