/* *   I M A G E R Y    B U S I N E S S     S Y S T E M S,   L L C * *   XIB Generator * *   Turns the model held in gProjectDictionary into two embeddable XIB parts per *   resource - <Resource>Form.xib (scalar form) and <Resource>List.xib (table) - *   plus a "Model Tags.incl" that names every tag, so a generated FB app can *   nibview _customerView, @"CustomerForm"  and address the controls by constant. * *   Model shape (from /metadata?include=attributes): *       resources -> { <Resource> -> attributes -> [ { name, type } ] } * *   Tag scheme (stable across runs; resources are sorted by name): *       view tag   = resourceIndex * 100            e.g. _customerView        = 200 *       field tag  = resourceIndex * 100 + n        e.g. _customerCompanyName = 202 * *   Type -> control *       VARCHAR(n) / CHAR(n) .......... text field, width from n *       VARCHAR(n >= 256), TEXT ....... multi-line wrapping text field *       SMALLINT / INTEGER / BIGINT ... right-aligned text field + integer formatter *       FLOAT / DECIMAL / NUMERIC ..... right-aligned text field + 2-place decimal formatter *       DATE / DATETIME / TIMESTAMP ... date picker *       BOOLEAN / BOOL / BIT .......... checkbox *       anything else ................. text field *//* *   naming helpers */local fn XibNewID as CFStringRefgXibNextID++end fn = fn StringWithFormat( @"gen-%04ld", gXibNextID )local fn XibEscape( s as CFStringRef ) as CFStringRefCFStringRef escaped = @""if ( s != NULL )escaped = fn StringByReplacingOccurrencesOfString( s,       @"&",  @"&amp;"  )escaped = fn StringByReplacingOccurrencesOfString( escaped, @"<",  @"&lt;"   )escaped = fn StringByReplacingOccurrencesOfString( escaped, @">",  @"&gt;"   )escaped = fn StringByReplacingOccurrencesOfString( escaped, @"\"", @"&quot;" )end ifend fn = escaped// "Customer" -> "customer",  "OrderDetail" -> "orderDetail"local fn XibResourcePrefix( resourceName as CFStringRef ) as CFStringRefCFStringRef first = fn StringLowercaseString( fn StringSubstringToIndex( resourceName, 1 ) )end fn = fn StringWithFormat( @"%@%@", first, fn StringSubstringFromIndex( resourceName, 1 ) )// ( "Customer", "company_name" ) -> "_customerCompanyName"local fn XibConstantName( resourceName as CFStringRef, attrName as CFStringRef ) as CFStringRefCFStringRef camel = fn TypeMapPascalName( attrName )                  // case kept: CompanyName, OrderIDend fn = fn StringWithFormat( @"_%@%@", fn XibResourcePrefix( resourceName ), camel )/* *   type mapping */local fn XibControlHeight( kind as long ) as longlong h = 22select ( kind )case _xibKindTextArea : h = 56case _xibKindDate     : h = 28case _xibKindCheckbox : h = 18end selectend fn = h// where the label's bottom edge sits below the row's top edgelocal fn XibLabelDrop( kind as long ) as longlong drop = 19                                   // centred on a 22pt fieldselect ( kind )case _xibKindDate     : drop = 22case _xibKindCheckbox : drop = 17end selectend fn = drop/* *   XML fragments */local fn XibLabelElement( textValue as CFStringRef, x as long, y as long ) as CFStringRefCFMutableStringRef s = fn MutableStringNewMutableStringAppendString( s, fn StringWithFormat( @"                <textField horizontalHuggingPriority=\"251\" verticalHuggingPriority=\"750\" id=\"%@\">\n", fn XibNewID ) )MutableStringAppendString( s, fn StringWithFormat( @"                    <rect key=\"frame\" x=\"%ld\" y=\"%ld\" width=\"%ld\" height=\"%ld\"/>\n", x, y, (long)_xibLabelWidth, (long)_xibLabelHeight ) )MutableStringAppendString( s,                      @"                    <autoresizingMask key=\"autoresizingMask\" flexibleMaxX=\"YES\" flexibleMinY=\"YES\"/>\n" )MutableStringAppendString( s, fn StringWithFormat( @"                    <textFieldCell key=\"cell\" lineBreakMode=\"clipping\" alignment=\"right\" title=\"%@:\" id=\"%@\">\n", fn XibEscape( textValue ), fn XibNewID ) )MutableStringAppendString( s,                      @"                        <font key=\"font\" usesAppearanceFont=\"YES\"/>\n" )MutableStringAppendString( s,                      @"                        <color key=\"textColor\" name=\"labelColor\" catalog=\"System\" colorSpace=\"catalog\"/>\n" )MutableStringAppendString( s,                      @"                        <color key=\"backgroundColor\" name=\"textBackgroundColor\" catalog=\"System\" colorSpace=\"catalog\"/>\n" )MutableStringAppendString( s,                      @"                    </textFieldCell>\n" )MutableStringAppendString( s,                      @"                </textField>\n" )end fn = slocal fn XibTextFieldElement( kind as long, tag as long, x as long, y as long, w as long, h as long ) as CFStringRefCFMutableStringRef s         = fn MutableStringNewCFStringRef        wrapAttrs = @"scrollable=\"YES\" lineBreakMode=\"clipping\""CFStringRef        alignment = @"left"if ( kind == _xibKindTextArea ) then wrapAttrs = @"lineBreakMode=\"wordWrapping\""if ( kind == _xibKindInteger || kind == _xibKindDecimal ) then alignment = @"right"MutableStringAppendString( s, fn StringWithFormat( @"                <textField verticalHuggingPriority=\"750\" tag=\"%ld\" id=\"%@\">\n", tag, fn XibNewID ) )MutableStringAppendString( s, fn StringWithFormat( @"                    <rect key=\"frame\" x=\"%ld\" y=\"%ld\" width=\"%ld\" height=\"%ld\"/>\n", x, y, w, h ) )MutableStringAppendString( s,                      @"                    <autoresizingMask key=\"autoresizingMask\" flexibleMaxX=\"YES\" flexibleMinY=\"YES\"/>\n" )MutableStringAppendString( s, fn StringWithFormat( @"                    <textFieldCell key=\"cell\" %@ selectable=\"YES\" editable=\"YES\" sendsActionOnEndEditing=\"YES\" borderStyle=\"bezel\" alignment=\"%@\" drawsBackground=\"YES\" id=\"%@\">\n", wrapAttrs, alignment, fn XibNewID ) )MutableStringAppendString( s,                      @"                        <font key=\"font\" usesAppearanceFont=\"YES\"/>\n" )select ( kind )case _xibKindIntegerMutableStringAppendString( s, fn StringWithFormat( @"                        <numberFormatter key=\"formatter\" formatterBehavior=\"default10_4\" usesGroupingSeparator=\"NO\" formatWidth=\"-1\" groupingSize=\"0\" minimumIntegerDigits=\"1\" maximumIntegerDigits=\"42\" id=\"%@\"/>\n", fn XibNewID ) )case _xibKindDecimalMutableStringAppendString( s, fn StringWithFormat( @"                        <numberFormatter key=\"formatter\" formatterBehavior=\"default10_4\" numberStyle=\"decimal\" formatWidth=\"-1\" minimumIntegerDigits=\"1\" maximumIntegerDigits=\"2000000000\" minimumFractionDigits=\"2\" maximumFractionDigits=\"2\" id=\"%@\"/>\n", fn XibNewID ) )end selectMutableStringAppendString( s,                      @"                        <color key=\"textColor\" name=\"controlTextColor\" catalog=\"System\" colorSpace=\"catalog\"/>\n" )MutableStringAppendString( s,                      @"                        <color key=\"backgroundColor\" name=\"textBackgroundColor\" catalog=\"System\" colorSpace=\"catalog\"/>\n" )MutableStringAppendString( s,                      @"                    </textFieldCell>\n" )MutableStringAppendString( s,                      @"                </textField>\n" )end fn = slocal fn XibDatePickerElement( tag as long, x as long, y as long, w as long, h as long ) as CFStringRefCFMutableStringRef s = fn MutableStringNewMutableStringAppendString( s, fn StringWithFormat( @"                <datePicker verticalHuggingPriority=\"750\" tag=\"%ld\" id=\"%@\">\n", tag, fn XibNewID ) )MutableStringAppendString( s, fn StringWithFormat( @"                    <rect key=\"frame\" x=\"%ld\" y=\"%ld\" width=\"%ld\" height=\"%ld\"/>\n", x, y, w, h ) )MutableStringAppendString( s,                      @"                    <autoresizingMask key=\"autoresizingMask\" flexibleMaxX=\"YES\" flexibleMinY=\"YES\"/>\n" )MutableStringAppendString( s, fn StringWithFormat( @"                    <datePickerCell key=\"cell\" borderStyle=\"bezel\" alignment=\"left\" id=\"%@\">\n", fn XibNewID ) )MutableStringAppendString( s,                      @"                        <font key=\"font\" metaFont=\"system\"/>\n" )MutableStringAppendString( s,                      @"                        <date key=\"date\" timeIntervalSinceReferenceDate=\"0.0\"/>\n" )MutableStringAppendString( s,                      @"                        <color key=\"textColor\" name=\"controlTextColor\" catalog=\"System\" colorSpace=\"catalog\"/>\n" )MutableStringAppendString( s,                      @"                        <color key=\"backgroundColor\" name=\"controlBackgroundColor\" catalog=\"System\" colorSpace=\"catalog\"/>\n" )MutableStringAppendString( s,                      @"                        <datePickerElements key=\"datePickerElements\" year=\"YES\" month=\"YES\" day=\"YES\"/>\n" )MutableStringAppendString( s,                      @"                    </datePickerCell>\n" )MutableStringAppendString( s,                      @"                </datePicker>\n" )end fn = slocal fn XibCheckboxElement( tag as long, x as long, y as long, w as long, h as long ) as CFStringRefCFMutableStringRef s = fn MutableStringNewMutableStringAppendString( s, fn StringWithFormat( @"                <button tag=\"%ld\" id=\"%@\">\n", tag, fn XibNewID ) )MutableStringAppendString( s, fn StringWithFormat( @"                    <rect key=\"frame\" x=\"%ld\" y=\"%ld\" width=\"%ld\" height=\"%ld\"/>\n", x, y, w, h ) )MutableStringAppendString( s,                      @"                    <autoresizingMask key=\"autoresizingMask\" flexibleMaxX=\"YES\" flexibleMinY=\"YES\"/>\n" )MutableStringAppendString( s, fn StringWithFormat( @"                    <buttonCell key=\"cell\" type=\"check\" bezelStyle=\"regularSquare\" imagePosition=\"left\" inset=\"2\" id=\"%@\">\n", fn XibNewID ) )MutableStringAppendString( s,                      @"                        <behavior key=\"behavior\" changeContents=\"YES\" doesNotDimImage=\"YES\" lightByContents=\"YES\"/>\n" )MutableStringAppendString( s,                      @"                        <font key=\"font\" metaFont=\"system\"/>\n" )MutableStringAppendString( s,                      @"                    </buttonCell>\n" )MutableStringAppendString( s,                      @"                </button>\n" )end fn = slocal fn XibFieldElement( kind as long, tag as long, x as long, y as long, w as long, h as long ) as CFStringRefCFStringRef elementselect ( kind )case _xibKindDate     : element = fn XibDatePickerElement( tag, x, y, w, h )case _xibKindCheckbox : element = fn XibCheckboxElement( tag, x, y, w, h )case else             : element = fn XibTextFieldElement( kind, tag, x, y, w, h )end selectend fn = element/* *   one resource -> one XIB document *   appends the resource's tag constants to tagGlobals, and describes the *   resource in resourceModel for Model.json (read by the generated app's ALS App.incl) */local fn XibViewDocument( resourceName as CFStringRef, attributes as CFArrayRef, baseTag as long, tagGlobals as CFMutableStringRef, resourceModel as CFMutableDictionaryRef ) as CFStringRefCFMutableStringRef xml = fn MutableStringNewCFMutableArrayRef  modelFields  = fn MutableArrayNewCFMutableArrayRef  listColumns  = fn MutableArrayNewCFDictionaryRef    attrCFStringRef        attrName, sqlType, prefixlong               count, i, kind, h, w, col, lastCol, rowsPerColumn, columnslong               col0Height = 0, col1Height = 0, viewWidth, viewHeight, yTop, x0, tagcount = fn ArrayCount( attributes )columns = 1rowsPerColumn = countif ( count > _xibMaxRowsPerColumn )columns = 2rowsPerColumn = count - ( count - ( count mod 2 ) ) / 2        // ceil( count / 2 ) without integer divisionend if// pass 1 - measure each columnfor i = 0 to count - 1attr    = fn ArrayObjectAtIndex( attributes, i )kind    = fn TypeMapAttributeKind( attr )h       = fn XibControlHeight( kind ) + _xibRowGapif ( i < rowsPerColumn ) then col0Height += h else col1Height += hnextviewHeight = col0Heightif ( col1Height > viewHeight ) then viewHeight = col1HeightviewHeight = viewHeight - _xibRowGap + ( _xibMargin * 2 )viewWidth  = _xibMargin + ( columns * _xibColumnWidth )// tag constants for the generated appprefix = fn XibResourcePrefix( resourceName )MutableStringAppendString( tagGlobals, fn StringWithFormat( @"\n// %@  ( %@Form.xib, %@List.xib )\n", resourceName, resourceName, resourceName ) )MutableStringAppendString( tagGlobals, fn StringWithFormat( @"_%@View = %ld\n",       prefix, baseTag ) )MutableStringAppendString( tagGlobals, fn StringWithFormat( @"_%@ViewWidth = %ld\n",  prefix, viewWidth ) )MutableStringAppendString( tagGlobals, fn StringWithFormat( @"_%@ViewHeight = %ld\n", prefix, viewHeight ) )// document headerMutableStringAppendString( xml, @"<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n" )MutableStringAppendString( xml, @"<document type=\"com.apple.InterfaceBuilder3.Cocoa.XIB\" version=\"3.0\" toolsVersion=\"22146\" targetRuntime=\"MacOSX.Cocoa\" propertyAccessControl=\"none\" useAutolayout=\"YES\" customObjectInstantitationMethod=\"direct\">\n" )MutableStringAppendString( xml, @"    <dependencies>\n" )MutableStringAppendString( xml, @"        <plugIn identifier=\"com.apple.InterfaceBuilder.CocoaPlugin\" version=\"22146\"/>\n" )MutableStringAppendString( xml, @"        <capability name=\"documents saved in the Xcode 8 format\" minToolsVersion=\"8.0\"/>\n" )MutableStringAppendString( xml, @"    </dependencies>\n" )MutableStringAppendString( xml, @"    <objects>\n" )MutableStringAppendString( xml, @"        <customObject id=\"-2\" userLabel=\"File's Owner\"/>\n" )MutableStringAppendString( xml, @"        <customObject id=\"-1\" userLabel=\"First Responder\" customClass=\"FirstResponder\"/>\n" )MutableStringAppendString( xml, @"        <customObject id=\"-3\" userLabel=\"Application\" customClass=\"NSObject\"/>\n" )MutableStringAppendString( xml, fn StringWithFormat( @"        <customView id=\"%@\" userLabel=\"%@ View\">\n", fn XibNewID, fn XibEscape( resourceName ) ) )MutableStringAppendString( xml, fn StringWithFormat( @"            <rect key=\"frame\" x=\"0.0\" y=\"0.0\" width=\"%ld\" height=\"%ld\"/>\n", viewWidth, viewHeight ) )MutableStringAppendString( xml, @"            <autoresizingMask key=\"autoresizingMask\" flexibleMaxX=\"YES\" flexibleMinY=\"YES\"/>\n" )MutableStringAppendString( xml, @"            <subviews>\n" )// pass 2 - lay out label + control rows, top-down (Cocoa y grows upward)lastCol = -1for i = 0 to count - 1attr     = fn ArrayObjectAtIndex( attributes, i )attrName = fn DictionaryObjectForKey( attr, @"name" )sqlType  = fn DictionaryObjectForKey( attr, @"type" )kind     = fn TypeMapAttributeKind( attr )h        = fn XibControlHeight( kind )w        = fn TypeMapAttributeFormWidth( attr )tag      = baseTag + i + 1col = 0if ( i >= rowsPerColumn ) then col = 1if ( col != lastCol )yTop    = viewHeight - _xibMarginlastCol = colend ifx0 = _xibMargin + ( col * _xibColumnWidth )MutableStringAppendString( xml, fn XibLabelElement( fn TypeMapAttributeTitle( attr ), x0, yTop - fn XibLabelDrop( kind ) ) )MutableStringAppendString( xml, fn XibFieldElement( kind, tag, x0 + _xibLabelWidth + _xibLabelGap, yTop - h, w, h ) )MutableStringAppendString( tagGlobals, fn StringWithFormat( @"%@ = %ld\t\t// %@\n", fn XibConstantName( resourceName, attrName ), tag, sqlType ) )if ( sqlType == NULL ) then sqlType = @""MutableArrayAddObject( modelFields, @{ @"name":attrName, @"title":fn TypeMapAttributeTitle( attr ), @"type":sqlType, @"kind":fn NumberWithInteger( kind ), @"tag":fn NumberWithInteger( tag ), @"pk":fn NumberWithInteger( fn NumberIntegerValue( fn DictionaryObjectForKey( attr, @"pk" ) ) ), @"notnull":fn NumberWithBool( fn NumberIntegerValue( fn DictionaryObjectForKey( attr, @"notnull" ) ) != 0 ) } )// the records table shows the first few short fieldsif ( fn ArrayCount( listColumns ) < _xibListColumns && kind != _xibKindTextArea ) then MutableArrayAddObject( listColumns, attrName )yTop = yTop - h - _xibRowGapnext// document footerMutableStringAppendString( xml, @"            </subviews>\n" )MutableStringAppendString( xml, @"            <point key=\"canvasLocation\" x=\"0.0\" y=\"0.0\"/>\n" )MutableStringAppendString( xml, @"        </customView>\n" )MutableStringAppendString( xml, @"    </objects>\n" )MutableStringAppendString( xml, @"</document>\n" )MutableDictionarySetObjectForKey( resourceModel, resourceName,                                     @"name" )MutableDictionarySetObjectForKey( resourceModel, fn StringWithFormat( @"%@Form", resourceName ),  @"formNib" )MutableDictionarySetObjectForKey( resourceModel, fn StringWithFormat( @"%@Form", resourceName ),  @"nib" )        // until the shell (step 3) replaces ALS App.inclMutableDictionarySetObjectForKey( resourceModel, fn NumberWithInteger( baseTag ),                 @"viewTag" )MutableDictionarySetObjectForKey( resourceModel, fn NumberWithInteger( viewWidth ),               @"viewWidth" )MutableDictionarySetObjectForKey( resourceModel, fn NumberWithInteger( viewHeight ),              @"viewHeight" )MutableDictionarySetObjectForKey( resourceModel, listColumns,                                      @"listColumns" )MutableDictionarySetObjectForKey( resourceModel, modelFields,                                      @"fields" )end fn = xml/* *   List part - one resource -> <Resource>List.xib *   A custom view holding a scroll view and a view-based table with one column per *   attribute. Column identifier = attribute name (FB's table data source keys each *   row dictionary by column identifier); column title = the attribute's label. *   Tags: list view = listTag, scroll view = listTag + 1, table = listTag + 2. */local fn XibListColumnElement( identifier as CFStringRef, title as CFStringRef, width as long, alignment as CFStringRef ) as CFStringRefCFMutableStringRef s = fn MutableStringNewCFStringRef        textFieldID = fn XibNewIDMutableStringAppendString( s, fn StringWithFormat( @"                                <tableColumn identifier=\"%@\" width=\"%ld\" minWidth=\"40\" maxWidth=\"1000\" id=\"%@\">\n", fn XibEscape( identifier ), width, fn XibNewID ) )MutableStringAppendString( s, fn StringWithFormat( @"                                    <tableHeaderCell key=\"headerCell\" lineBreakMode=\"truncatingTail\" borderStyle=\"border\" alignment=\"%@\" title=\"%@\">\n", alignment, fn XibEscape( title ) ) )MutableStringAppendString( s,                      @"                                        <color key=\"textColor\" name=\"headerTextColor\" catalog=\"System\" colorSpace=\"catalog\"/>\n" )MutableStringAppendString( s,                      @"                                        <color key=\"backgroundColor\" name=\"headerColor\" catalog=\"System\" colorSpace=\"catalog\"/>\n" )MutableStringAppendString( s,                      @"                                    </tableHeaderCell>\n" )MutableStringAppendString( s, fn StringWithFormat( @"                                    <textFieldCell key=\"dataCell\" lineBreakMode=\"truncatingTail\" selectable=\"YES\" editable=\"YES\" alignment=\"%@\" title=\"Text Cell\" id=\"%@\">\n", alignment, fn XibNewID ) )MutableStringAppendString( s,                      @"                                        <font key=\"font\" metaFont=\"system\"/>\n" )MutableStringAppendString( s,                      @"                                        <color key=\"textColor\" name=\"controlTextColor\" catalog=\"System\" colorSpace=\"catalog\"/>\n" )MutableStringAppendString( s,                      @"                                        <color key=\"backgroundColor\" name=\"controlBackgroundColor\" catalog=\"System\" colorSpace=\"catalog\"/>\n" )MutableStringAppendString( s,                      @"                                    </textFieldCell>\n" )MutableStringAppendString( s,                      @"                                    <tableColumnResizingMask key=\"resizingMask\" resizeWithTable=\"YES\" userResizable=\"YES\"/>\n" )MutableStringAppendString( s,                      @"                                    <prototypeCellViews>\n" )MutableStringAppendString( s, fn StringWithFormat( @"                                        <tableCellView identifier=\"%@\" id=\"%@\">\n", fn XibEscape( identifier ), fn XibNewID ) )MutableStringAppendString( s, fn StringWithFormat( @"                                            <rect key=\"frame\" x=\"1\" y=\"1\" width=\"%ld\" height=\"24\"/>\n", width ) )MutableStringAppendString( s,                      @"                                            <autoresizingMask key=\"autoresizingMask\" widthSizable=\"YES\" heightSizable=\"YES\"/>\n" )MutableStringAppendString( s,                      @"                                            <subviews>\n" )MutableStringAppendString( s, fn StringWithFormat( @"                                                <textField verticalHuggingPriority=\"750\" horizontalCompressionResistancePriority=\"250\" fixedFrame=\"YES\" translatesAutoresizingMaskIntoConstraints=\"NO\" id=\"%@\">\n", textFieldID ) )MutableStringAppendString( s, fn StringWithFormat( @"                                                    <rect key=\"frame\" x=\"0.0\" y=\"4\" width=\"%ld\" height=\"16\"/>\n", width ) )MutableStringAppendString( s,                      @"                                                    <autoresizingMask key=\"autoresizingMask\" widthSizable=\"YES\" flexibleMinY=\"YES\"/>\n" )MutableStringAppendString( s, fn StringWithFormat( @"                                                    <textFieldCell key=\"cell\" lineBreakMode=\"truncatingTail\" sendsActionOnEndEditing=\"YES\" alignment=\"%@\" title=\"Table View Cell\" id=\"%@\">\n", alignment, fn XibNewID ) )MutableStringAppendString( s,                      @"                                                        <font key=\"font\" usesAppearanceFont=\"YES\"/>\n" )MutableStringAppendString( s,                      @"                                                        <color key=\"textColor\" name=\"controlTextColor\" catalog=\"System\" colorSpace=\"catalog\"/>\n" )MutableStringAppendString( s,                      @"                                                        <color key=\"backgroundColor\" name=\"textBackgroundColor\" catalog=\"System\" colorSpace=\"catalog\"/>\n" )MutableStringAppendString( s,                      @"                                                    </textFieldCell>\n" )MutableStringAppendString( s,                      @"                                                </textField>\n" )MutableStringAppendString( s,                      @"                                            </subviews>\n" )MutableStringAppendString( s,                      @"                                            <connections>\n" )MutableStringAppendString( s, fn StringWithFormat( @"                                                <outlet property=\"textField\" destination=\"%@\" id=\"%@\"/>\n", textFieldID, fn XibNewID ) )MutableStringAppendString( s,                      @"                                            </connections>\n" )MutableStringAppendString( s,                      @"                                        </tableCellView>\n" )MutableStringAppendString( s,                      @"                                    </prototypeCellViews>\n" )MutableStringAppendString( s,                      @"                                </tableColumn>\n" )end fn = slocal fn XibListDocument( resourceName as CFStringRef, attributes as CFArrayRef, listTag as long, tagGlobals as CFMutableStringRef, resourceModel as CFMutableDictionaryRef ) as CFStringRefCFMutableStringRef xml     = fn MutableStringNewCFMutableStringRef columns = fn MutableStringNewCFMutableArrayRef  listAttributes = fn MutableArrayNewCFDictionaryRef    attrCFStringRef        attrName, alignment, headerID, prefixlong               kind, width, tableWidth = 0, viewWidth, ifor i = 0 to fn ArrayCount( attributes ) - 1attr     = fn ArrayObjectAtIndex( attributes, i )attrName = fn DictionaryObjectForKey( attr, @"name" )kind     = fn TypeMapAttributeKind( attr )width    = fn TypeMapAttributeListWidth( attr )alignment = @"left"if ( kind == _xibKindInteger || kind == _xibKindDecimal ) then alignment = @"right"MutableStringAppendString( columns, fn XibListColumnElement( attrName, fn TypeMapAttributeTitle( attr ), width, alignment ) )MutableArrayAddObject( listAttributes, attrName )tableWidth = tableWidth + width + 17nextviewWidth = tableWidth + 2if ( viewWidth < _xibListMinWidth ) then viewWidth = _xibListMinWidthif ( viewWidth > _xibListMaxWidth ) then viewWidth = _xibListMaxWidthheaderID = fn XibNewIDprefix = fn XibResourcePrefix( resourceName )MutableStringAppendString( tagGlobals, fn StringWithFormat( @"_%@List = %ld\t\t\t// %@List.xib\n", prefix, listTag, resourceName ) )MutableStringAppendString( tagGlobals, fn StringWithFormat( @"_%@ListScroll = %ld\n", prefix, listTag + 1 ) )MutableStringAppendString( tagGlobals, fn StringWithFormat( @"_%@ListTable = %ld\n", prefix, listTag + 2 ) )MutableStringAppendString( xml, @"<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n" )MutableStringAppendString( xml, @"<document type=\"com.apple.InterfaceBuilder3.Cocoa.XIB\" version=\"3.0\" toolsVersion=\"22146\" targetRuntime=\"MacOSX.Cocoa\" propertyAccessControl=\"none\" useAutolayout=\"YES\" customObjectInstantitationMethod=\"direct\">\n" )MutableStringAppendString( xml, @"    <dependencies>\n" )MutableStringAppendString( xml, @"        <plugIn identifier=\"com.apple.InterfaceBuilder.CocoaPlugin\" version=\"22146\"/>\n" )MutableStringAppendString( xml, @"        <capability name=\"documents saved in the Xcode 8 format\" minToolsVersion=\"8.0\"/>\n" )MutableStringAppendString( xml, @"    </dependencies>\n" )MutableStringAppendString( xml, @"    <objects>\n" )MutableStringAppendString( xml, @"        <customObject id=\"-2\" userLabel=\"File's Owner\"/>\n" )MutableStringAppendString( xml, @"        <customObject id=\"-1\" userLabel=\"First Responder\" customClass=\"FirstResponder\"/>\n" )MutableStringAppendString( xml, @"        <customObject id=\"-3\" userLabel=\"Application\" customClass=\"NSObject\"/>\n" )MutableStringAppendString( xml, fn StringWithFormat( @"        <customView id=\"%@\" userLabel=\"%@ List\">\n", fn XibNewID, fn XibEscape( resourceName ) ) )MutableStringAppendString( xml, fn StringWithFormat( @"            <rect key=\"frame\" x=\"0.0\" y=\"0.0\" width=\"%ld\" height=\"%ld\"/>\n", viewWidth, (long)_xibListHeight ) )MutableStringAppendString( xml, @"            <autoresizingMask key=\"autoresizingMask\" widthSizable=\"YES\" heightSizable=\"YES\"/>\n" )MutableStringAppendString( xml, @"            <subviews>\n" )MutableStringAppendString( xml, fn StringWithFormat( @"                <scrollView autohidesScrollers=\"YES\" horizontalLineScroll=\"24\" horizontalPageScroll=\"10\" verticalLineScroll=\"24\" verticalPageScroll=\"10\" usesPredominantAxisScrolling=\"NO\" tag=\"%ld\" id=\"%@\">\n", listTag + 1, fn XibNewID ) )MutableStringAppendString( xml, fn StringWithFormat( @"                    <rect key=\"frame\" x=\"0.0\" y=\"0.0\" width=\"%ld\" height=\"%ld\"/>\n", viewWidth, (long)_xibListHeight ) )MutableStringAppendString( xml, @"                    <autoresizingMask key=\"autoresizingMask\" widthSizable=\"YES\" heightSizable=\"YES\"/>\n" )MutableStringAppendString( xml, fn StringWithFormat( @"                    <clipView key=\"contentView\" id=\"%@\">\n", fn XibNewID ) )MutableStringAppendString( xml, fn StringWithFormat( @"                        <rect key=\"frame\" x=\"1\" y=\"1\" width=\"%ld\" height=\"%ld\"/>\n", viewWidth - 2, (long)_xibListHeight - 2 ) )MutableStringAppendString( xml, @"                        <autoresizingMask key=\"autoresizingMask\" widthSizable=\"YES\" heightSizable=\"YES\"/>\n" )MutableStringAppendString( xml, @"                        <subviews>\n" )MutableStringAppendString( xml, fn StringWithFormat( @"                            <tableView verticalHuggingPriority=\"750\" tag=\"%ld\" allowsExpansionToolTips=\"YES\" columnAutoresizingStyle=\"lastColumnOnly\" alternatingRowBackgroundColors=\"YES\" multipleSelection=\"NO\" autosaveColumns=\"NO\" rowHeight=\"24\" rowSizeStyle=\"automatic\" headerView=\"%@\" viewBased=\"YES\" id=\"%@\">\n", listTag + 2, headerID, fn XibNewID ) )MutableStringAppendString( xml, fn StringWithFormat( @"                                <rect key=\"frame\" x=\"0.0\" y=\"0.0\" width=\"%ld\" height=\"%ld\"/>\n", tableWidth, (long)_xibListHeight - 30 ) )MutableStringAppendString( xml, @"                                <autoresizingMask key=\"autoresizingMask\" widthSizable=\"YES\" heightSizable=\"YES\"/>\n" )MutableStringAppendString( xml, @"                                <size key=\"intercellSpacing\" width=\"17\" height=\"0.0\"/>\n" )MutableStringAppendString( xml, @"                                <color key=\"backgroundColor\" name=\"controlBackgroundColor\" catalog=\"System\" colorSpace=\"catalog\"/>\n" )MutableStringAppendString( xml, @"                                <color key=\"gridColor\" name=\"gridColor\" catalog=\"System\" colorSpace=\"catalog\"/>\n" )MutableStringAppendString( xml, @"                                <tableColumns>\n" )MutableStringAppendString( xml, columns )MutableStringAppendString( xml, @"                                </tableColumns>\n" )MutableStringAppendString( xml, @"                            </tableView>\n" )MutableStringAppendString( xml, @"                        </subviews>\n" )MutableStringAppendString( xml, @"                    </clipView>\n" )MutableStringAppendString( xml, fn StringWithFormat( @"                    <scroller key=\"horizontalScroller\" hidden=\"YES\" wantsLayer=\"YES\" verticalHuggingPriority=\"750\" horizontal=\"YES\" id=\"%@\">\n", fn XibNewID ) )MutableStringAppendString( xml, fn StringWithFormat( @"                        <rect key=\"frame\" x=\"1\" y=\"%ld\" width=\"%ld\" height=\"16\"/>\n", (long)_xibListHeight - 17, viewWidth - 2 ) )MutableStringAppendString( xml, @"                        <autoresizingMask key=\"autoresizingMask\"/>\n" )MutableStringAppendString( xml, @"                    </scroller>\n" )MutableStringAppendString( xml, fn StringWithFormat( @"                    <scroller key=\"verticalScroller\" hidden=\"YES\" wantsLayer=\"YES\" verticalHuggingPriority=\"750\" horizontal=\"NO\" id=\"%@\">\n", fn XibNewID ) )MutableStringAppendString( xml, fn StringWithFormat( @"                        <rect key=\"frame\" x=\"%ld\" y=\"17\" width=\"15\" height=\"%ld\"/>\n", viewWidth - 16, (long)_xibListHeight - 18 ) )MutableStringAppendString( xml, @"                        <autoresizingMask key=\"autoresizingMask\"/>\n" )MutableStringAppendString( xml, @"                    </scroller>\n" )MutableStringAppendString( xml, fn StringWithFormat( @"                    <tableHeaderView key=\"headerView\" wantsLayer=\"YES\" id=\"%@\">\n", headerID ) )MutableStringAppendString( xml, fn StringWithFormat( @"                        <rect key=\"frame\" x=\"0.0\" y=\"0.0\" width=\"%ld\" height=\"28\"/>\n", tableWidth ) )MutableStringAppendString( xml, @"                        <autoresizingMask key=\"autoresizingMask\"/>\n" )MutableStringAppendString( xml, @"                    </tableHeaderView>\n" )MutableStringAppendString( xml, @"                </scrollView>\n" )MutableStringAppendString( xml, @"            </subviews>\n" )MutableStringAppendString( xml, @"            <point key=\"canvasLocation\" x=\"0.0\" y=\"0.0\"/>\n" )MutableStringAppendString( xml, @"        </customView>\n" )MutableStringAppendString( xml, @"    </objects>\n" )MutableStringAppendString( xml, @"</docum