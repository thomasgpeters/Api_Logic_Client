String( tagGlobals, fn StringWithFormat( @"/*\n *   %@\n *   Generated by Api Logic Client - view and control tags, for your own code in the generated app.\n *   Regenerating overwrites this file.\n */\n", projectLabel ) )// sorted so tags stay stable when the model is regeneratednames = fn ArraySortedArrayUsingSelector( fn DictionaryAllKeys( resourceDict ), @"compare:" )for name in namesresourceIndex++resource   = fn DictionaryObjectForKey( resourceDict, name )attributes = fn DictionaryObjectForKey( resource, @"attributes" )if ( attributes != NULL )if ( fn ArrayCount( attributes ) >= _xibTagsPerResource )if (isLoggingOn) then NSLog( @"Skipping %@: %ld attributes exceeds the %ld tags reserved per resource.", name, fn ArrayCount( attributes ), (long)_xibTagsPerResource )elsegXibNextID = 0resourceModel = fn MutableDictionaryNew// carry the model's keys and relationships through to Model.json (SQLite source)for modelKey in modelKeysif ( fn DictionaryObjectForKey( resource, modelKey ) != NULL ) then MutableDictionarySetObjectForKey( resourceModel, fn DictionaryObjectForKey( resource, modelKey ), modelKey )next// scalar (form) part, then the list part - each entity's tags stay together in Model Tags.incl.// Both are always built (their tags and sizes go into the model); files are written on request.formXML = fn XibViewDocument( name, attributes, resourceIndex * _xibTagsPerResource, tagGlobals, resourceModel )xml     = fn XibListDocument( name, attributes, _xibListTagBase + resourceIndex * _xibListTagsPer, tagGlobals, resourceModel )MutableArrayAddObject( modelResources, resourceModel )if ( writeXibs && ( onlyName == NULL || fn StringIsEqual( onlyName, name ) ) )fileURL = fn URLByAppendingPathComponent( folderURL, fn StringWithFormat( @"%@Form.xib", name ) )if ( fn StringWriteToURL( formXML, fileURL, YES, NSUTF8StringEncoding, @err ) )written++if (isLoggingOn) then NSLog( @"Wrote %@", fn URLPath( fileURL ) )elseif (isLoggingOn) then NSLog( @"Could not write %@: %@", fn URLPath( fileURL ), fn ErrorLocalizedDescription( err ) )end iffileURL = fn URLByAppendingPathComponent( folderURL, fn StringWithFormat( @"%@List.xib", name ) )if ( fn StringWriteToURL( xml, fileURL, YES, NSUTF8StringEncoding, @err ) == NO )if (isLoggingOn) then NSLog( @"Could not write %@: %@", fn URLPath( fileURL ), fn ErrorLocalizedDescription( err ) )end ifend ifend ifend ifend ifnextfileURL = fn URLByAppendingPathComponent( folderURL, @"Model Tags.incl" )if ( fn StringWriteToURL( fn StringByReplacingOccurrencesOfString( tagGlobals, @"\n", @"\r" ), fileURL, YES, NSUTF8StringEncoding, @err ) == NO )if (isLoggingOn) then NSLog( @"Could not write %@: %@", fn URLPath( fileURL ), fn ErrorLocalizedDescription( err ) )end ifend fn = written