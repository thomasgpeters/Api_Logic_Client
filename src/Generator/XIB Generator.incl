/* *   I M A G E R Y    B U S I N E S S     S Y S T E M S,   L L C * *   XIB Generator * *   Turns the model held in gProjectDictionary into two embeddable XIB parts per *   resource - <Resource>Form.xib (scalar form) and <Resource>List.xib (table) - *   plus a "Model Tags.incl" that names every tag, so a generated FB app can *   nibview _customerView, @"CustomerForm"  and address the controls by constant. * *   Model shape (from /metadata?include=attributes): *       resources -> { <Resource> -> attributes -> [ { name, type } ] } * *   Tag scheme (stable across runs; resources are sorted by name): *       view tag   = resourceIndex * 100            e.g. _customerView        = 200 *       field tag  = resourceIndex * 100 + n        e.g. _customerCompanyName = 202 * *   Form layout: 1, 2 or 3 columns (TypeMapFormColumns: the designer's choice, else by field count); *   Hidden attributes are left out (they keep their tag numbers' place), read-only ones have no bezel. * *   Type -> control (Type Mapping.incl; the designer can choose another) *       VARCHAR(n) / CHAR(n), TEXT .... text field, width from n *       CLOB / LONGTEXT ............... multi-line wrapping text field *       generated key ................. read-only text *       SMALLINT / INTEGER / BIGINT ... right-aligned text field + integer formatter *       FLOAT / DECIMAL / NUMERIC ..... right-aligned text field + 2-place decimal formatter *       DATE .......................... date picker *       DATETIME / TIMESTAMP .......... date and time picker *       TIME .......................... time picker *       BOOLEAN / BOOL / BIT .......... checkbox *       anything else ................. text field *//* *   naming helpers */local fn XibNewID as CFStringRefgXibNextID++end fn = fn StringWithFormat( @"gen-%04ld", gXibNextID )local fn XibEscape( s as CFStringRef ) as CFStringRefCFStringRef escaped = @""if ( s != NULL )escaped = fn StringByReplacingOccurrencesOfString( s,       @"&",  @"&amp;"  )escaped = fn StringByReplacingOccurrencesOfString( escaped, @"<",  @"&lt;"   )escaped = fn StringByReplacingOccurrencesOfString( escaped, @">",  @"&gt;"   )escaped = fn StringByReplacingOccurrencesOfString( escaped, @"\"", @"&quot;" )end ifend fn = escaped// "Customer" -> "customer",  "OrderDetail" -> "orderDetail"local fn XibResourcePrefix( resourceName as CFStringRef ) as CFStringRefCFStringRef first = fn StringLowercaseString( fn StringSubstringToIndex( resourceName, 1 ) )end fn = fn StringWithFormat( @"%@%@", first, fn StringSubstringFromIndex( resourceName, 1 ) )// ( "Customer", "company_name" ) -> "_customerCompanyName"local fn XibConstantName( resourceName as CFStringRef, attrName as CFStringRef ) as CFStringRefCFStringRef camel = fn TypeMapPascalName( attrName )                  // case kept: CompanyName, OrderIDend fn = fn StringWithFormat( @"_%@%@", fn XibResourcePrefix( resourceName ), camel )/* *   type mapping */local fn XibControlHeight( kind as long ) as longlong h = 22select ( kind )case _xibKindTextArea : h = 56case _xibKindDate, _xibKindTime, _xibKindDateTime : h = 28case _xibKindCheckbox : h = 18end selectend fn = h// a field's width on the Form: the designer's or the recommended width, within the column's limitlocal fn XibFormFieldWidth( attribute as CFDictionaryRef, maxWidth as long ) as longlong w = fn TypeMapAttributeFormWidth( attribute )if ( w > maxWidth && fn TypeMapAttributeKind( attribute ) != _xibKindCheckbox ) then w = maxWidthend fn = w// where the label's bottom edge sits below the row's top edgelocal fn XibLabelDrop( kind as long ) as longlong drop = 19                                   // centred on a 22pt fieldselect ( kind )case _xibKindDate, _xibKindTime, _xibKindDateTime : drop = 22case _xibKindCheckbox : drop = 17end selectend fn = drop/* *   XML fragments */local fn XibLabelElement( textValue as CFStringRef, x as long, y as long, labelWidth as long ) as CFStringRefCFMutableStringRef s = fn MutableStringNewMutableStringAppendString( s, fn StringWithFormat( @"                <textField horizontalHuggingPriority=\"251\" verticalHuggingPriority=\"750\" id=\"%@\">\n", fn XibNewID ) )MutableStringAppendString( s, fn StringWithFormat( @"                    <rect key=\"frame\" x=\"%ld\" y=\"%ld\" width=\"%ld\" height=\"%ld\"/>\n", x, y, labelWidth, (long)_xibLabelHeight ) )MutableStringAppendString( s,                      @"                    <autoresizingMask key=\"autoresizingMask\" flexibleMaxX=\"YES\" flexibleMinY=\"YES\"/>\n" )MutableStringAppendString( s, fn StringWithFormat( @"                    <textFieldCell key=\"cell\" lineBreakMode=\"clipping\" alignment=\"right\" title=\"%@:\" id=\"%@\">\n", fn XibEscape( textValue ), fn XibNewID ) )MutableStringAppendString( s,                      @"                        <font key=\"font\" usesAppearanceFont=\"YES\"/>\n" )MutableStringAppendString( s,                      @"                        <color key=\"textColor\" name=\"labelColor\" catalog=\"System\" colorSpace=\"catalog\"/>\n" )MutableStringAppendString( s,                      @"                        <color key=\"backgroundColor\" name=\"textBackgroundColor\" catalog=\"System\" colorSpace=\"catalog\"/>\n" )MutableStringAppendString( s,                      @"                    </textFieldCell>\n" )MutableStringAppendString( s,                      @"                </textField>\n" )end fn = slocal fn XibTextFieldElement( kind as long, tag as long, x as long, y as long, w as long, h as long ) as CFStringRefCFMutableStringRef s         = fn MutableStringNewCFStringRef        wrapAttrs = @"scrollable=\"YES\" lineBreakMode=\"clipping\""CFStringRef        alignment = @"left"CFStringRef        editAttrs = @"selectable=\"YES\" editable=\"YES\" sendsActionOnEndEditing=\"YES\" borderStyle=\"bezel\" drawsBackground=\"YES\""if ( kind == _xibKindTextArea ) then wrapAttrs = @"lineBreakMode=\"wordWrapping\""// read-only text: selectable (it can be copied), not editable, no bezel - it reads as a value, not an inputif ( kind == _xibKindReadOnly ) then editAttrs = @"selectable=\"YES\" sendsActionOnEndEditing=\"YES\""if ( kind == _xibKindInteger || kind == _xibKindDecimal ) then alignment = @"right"MutableStringAppendString( s, fn StringWithFormat( @"                <textField verticalHuggingPriority=\"750\" tag=\"%ld\" id=\"%@\">\n", tag, fn XibNewID ) )MutableStringAppendString( s, fn StringWithFormat( @"                    <rect key=\"frame\" x=\"%ld\" y=\"%ld\" width=\"%ld\" height=\"%ld\"/>\n", x, y, w, h ) )MutableStringAppendString( s,                      @"                    <autoresizingMask key=\"autoresizingMask\" flexibleMaxX=\"YES\" flexibleMinY=\"YES\"/>\n" )MutableStringAppendString( s, fn StringWithFormat( @"                    <textFieldCell key=\"cell\" %@ %@ alignment=\"%@\" id=\"%@\">\n", wrapAttrs, editAttrs, alignment, fn XibNewID ) )MutableStringAppendString( s,                      @"                        <font key=\"font\" usesAppearanceFont=\"YES\"/>\n" )select ( kind )case _xibKindIntegerMutableStringAppendString( s, fn StringWithFormat( @"                        <numberFormatter key=\"formatter\" formatterBehavior=\"default10_4\" usesGroupingSeparator=\"NO\" formatWidth=\"-1\" groupingSize=\"0\" minimumIntegerDigits=\"1\" maximumIntegerDigits=\"42\" id=\"%@\"/>\n", fn XibNewID ) )case _xibKindDecimalMutableStringAppendString( s, fn StringWithFormat( @"                        <numberFormatter key=\"formatter\" formatterBehavior=\"default10_4\" numberStyle=\"decimal\" formatWidth=\"-1\" minimumIntegerDigits=\"1\" maximumIntegerDigits=\"2000000000\" minimumFractionDigits=\"2\" maximumFractionDigits=\"2\" id=\"%@\"/>\n", fn XibNewID ) )end selectMutableStringAppendString( s,                      @"                        <color key=\"textColor\" name=\"controlTextColor\" catalog=\"System\" colorSpace=\"catalog\"/>\n" )MutableStringAppendString( s,                      @"                        <color key=\"backgroundColor\" name=\"textBackgroundColor\" catalog=\"System\" colorSpace=\"catalog\"/>\n" )MutableStringAppendString( s,                      @"                    </textFieldCell>\n" )MutableStringAppendString( s,                      @"                </textField>\n" )end fn = s// a date picker showing the date (year, month, day), the time (hours, minutes, seconds) or bothlocal fn XibDatePickerElement( kind as long, tag as long, x as long, y as long, w as long, h as long ) as CFStringRefCFMutableStringRef s = fn MutableStringNewCFStringRef        elements = @"year=\"YES\" month=\"YES\" day=\"YES\""if ( kind == _xibKindTime ) then elements = @"hour=\"YES\" minute=\"YES\" second=\"YES\""if ( kind == _xibKindDateTime ) then elements = @"year=\"YES\" month=\"YES\" day=\"YES\" hour=\"YES\" minute=\"YES\""MutableStringAppendString( s, fn StringWithFormat( @"                <datePicker verticalHuggingPriority=\"750\" tag=\"%ld\" id=\"%@\">\n", tag, fn XibNewID ) )MutableStringAppendString( s, fn StringWithFormat( @"                    <rect key=\"frame\" x=\"%ld\" y=\"%ld\" width=\"%ld\" height=\"%ld\"/>\n", x, y, w, h ) )MutableStringAppendString( s,                      @"                    <autoresizingMask key=\"autoresizingMask\" flexibleMaxX=\"YES\" flexibleMinY=\"YES\"/>\n" )MutableStringAppendString( s, fn StringWithFormat( @"                    <datePickerCell key=\"cell\" borderStyle=\"bezel\" alignment=\"left\" id=\"%@\">\n", fn XibNewID ) )MutableStringAppendString( s,                      @"                        <font key=\"font\" metaFont=\"system\"/>\n" )MutableStringAppendString( s,                      @"                        <date key=\"date\" timeIntervalSinceReferenceDate=\"0.0\"/>\n" )MutableStringAppendString( s,                      @"                        <color key=\"textColor\" name=\"controlTextColor\" catalog=\"System\" colorSpace=\"catalog\"/>\n" )MutableStringAppendString( s,                      @"                        <color key=\"backgroundColor\" name=\"controlBackgroundColor\" catalog=\"System\" colorSpace=\"catalog\"/>\n" )MutableStringAppendString( s, fn StringWithFormat( @"                        <datePickerElements key=\"datePickerElements\" %@/>\n", elements ) )MutableStringAppendString( s,                      @"                    </datePickerCell>\n" )MutableStringAppendString( s,                      @"                </datePicker>\n" )end fn = slocal fn XibCheckboxElement( tag as long, x as long, y as long, w as long, h as long ) as CFStringRefCFMutableStringRef s = fn MutableStringNewMutableStringAppendString( s, fn StringWithFormat( @"                <button tag=\"%ld\" id=\"%@\">\n", tag, fn XibNewID ) )MutableStringAppendString( s, fn StringWithFormat( @"                    <rect key=\"frame\" x=\"%ld\" y=\"%ld\" width=\"%ld\" height=\"%ld\"/>\n", x, y, w, h ) )MutableStringAppendString( s,                      @"                    <autoresizingMask key=\"autoresizingMask\" flexibleMaxX=\"YES\" flexibleMinY=\"YES\"/>\n" )MutableStringAppendString( s, fn StringWithFormat( @"                    <buttonCell key=\"cell\" type=\"check\" bezelStyle=\"regularSquare\" imagePosition=\"left\" inset=\"2\" id=\"%@\">\n", fn XibNewID ) )MutableStringAppendString( s,                      @"                        <behavior key=\"behavior\" changeContents=\"YES\" doesNotDimImage=\"YES\" lightByContents=\"YES\"/>\n" )MutableStringAppendString( s,                      @"                        <font key=\"font\" metaFont=\"system\"/>\n" )MutableStringAppendString( s,                      @"                    </buttonCell>\n" )MutableStringAppendString( s,                      @"                </button>\n" )end fn = slocal fn XibFieldElement( kind as long, tag as long, x as long, y as long, w as long, h as long ) as CFStringRefCFStringRef elementselect ( kind )case _xibKindDate, _xibKindTime, _xibKindDateTime : element = fn XibDatePickerElement( kind, tag, x, y, w, h )case _xibKindCheckbox : element = fn XibCheckboxElement( tag, x, y, w, h )case else             : element = fn XibTextFieldElement( kind, tag, x, y, w, h )end selectend fn = element/* *   one resource -> one XIB document *   appends the resource's tag constants to tagGlobals, and describes the *   resource in resourceModel for Model.json (read by the generated app's ALS App.incl) */local fn XibViewDocument( resourceName as CFStringRef, attributes as CFArrayRef, columns as long, baseTag as long, tagGlobals as CFMutableStringRef, resourceModel as CFMutableDictionaryRef ) as CFStringRefCFMutableStringRef xml          = fn MutableStringNewCFMutableArrayRef  modelFields  = fn MutableArrayNewCFMutableArrayRef  listColumns  = fn MutableArrayNewCFArrayRef         shown        = fn TypeMapShownAttributes( attributes )    // without the Hidden onesCFDictionaryRef    attrCFStringRef        attrName, sqlType, prefixlong               count, shownCount, i, n, kind, h, w, col, rowsPerColumn, maxWidthlong               colHeight = 0, viewWidth, viewHeight = 0, yTop = 0, x0 = 0, taglong               labelWidth = 60, fieldMax = _xibMinFieldWidth, columnWidthBOOL               isHiddencount      = fn ArrayCount( attributes )shownCount = fn ArrayCount( shown )// columns: the designer's choice (Type Mapping.incl), never more than there are fieldsif ( columns < 1 ) then columns = 1if ( columns > _xibMaxFormColumns ) then columns = _xibMaxFormColumnsif ( columns > shownCount && shownCount > 0 ) then columns = shownCountrowsPerColumn = 1while ( rowsPerColumn * columns < shownCount )          // ceil( shownCount / columns ), no integer divisionrowsPerColumn++wendmaxWidth = _xibMaxFieldWidthif ( columns == 3 ) then maxWidth = _xibMaxFieldWidth3// pass 1 - measure: the longest label, the widest field, the tallest columnfor n = 0 to shownCount - 1attr = fn ArrayObjectAtIndex( shown, n )kind = fn TypeMapAttributeKind( attr )w = fn StringLength( fn TypeMapAttributeTitle( attr ) ) * _xibCharWidth + 12if ( w > labelWidth ) then labelWidth = ww = fn XibFormFieldWidth( attr, maxWidth )if ( w > fieldMax ) then fieldMax = wif ( n mod rowsPerColumn == 0 ) then colHeight = 0colHeight = colHeight + fn XibControlHeight( kind ) + _xibRowGapif ( colHeight > viewHeight ) then viewHeight = colHeightnextif ( labelWidth > _xibLabelWidth ) then labelWidth = _xibLabelWidthcolumnWidth = labelWidth + _xibLabelGap + fieldMax + _xibMarginviewHeight  = viewHeight - _xibRowGap + ( _xibMargin * 2 )if ( shownCount == 0 ) then viewHeight = _xibMargin * 2viewWidth   = _xibMargin + ( columns * columnWidth )// tag constants for the generated appprefix = fn XibResourcePrefix( resourceName )MutableStringAppendString( tagGlobals, fn StringWithFormat( @"\n// %@  ( %@Form.xib, %@List.xib )\n", resourceName, resourceName, resourceName ) )MutableStringAppendString( tagGlobals, fn StringWithFormat( @"_%@View = %ld\n",       prefix, baseTag ) )MutableStringAppendString( tagGlobals, fn StringWithFormat( @"_%@ViewWidth = %ld\n",  prefix, viewWidth ) )MutableStringAppendString( tagGlobals, fn StringWithFormat( @"_%@ViewHeight = %ld\n", prefix, viewHeight ) )// document headerMutableStringAppendString( xml, @"<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n" )MutableStringAppendString( xml, @"<document type=\"com.apple.InterfaceBuilder3.Cocoa.XIB\" version=\"3.0\" toolsVersion=\"22146\" targetRuntime=\"MacOSX.Cocoa\" propertyAccessControl=\"none\" useAutolayout=\"YES\" customObjectInstantitationMethod=\"direct\">\n" )MutableStringAppendString( xml, @"    <dependencies>\n" )MutableStringAppendString( xml, @"        <plugIn identifier=\"com.apple.InterfaceBuilder.CocoaPlugin\" version=\"22146\"/>\n" )MutableStringAppendString( xml, @"        <capability name=\"documents saved in the Xcode 8 format\" minToolsVersion=\"8.0\"/>\n" )MutableStringAppendString( xml, @"    </dependencies>\n" )MutableStringAppendString( xml, @"    <objects>\n" )MutableStringAppendString( xml, @"        <customObject id=\"-2\" userLabel=\"File's Owner\"/>\n" )MutableStringAppendString( xml, @"        <customObject id=\"-1\" userLabel=\"First Responder\" customClass=\"FirstResponder\"/>\n" )MutableStringAppendString( xml, @"        <customObject id=\"-3\" userLabel=\"Application\" customClass=\"NSObject\"/>\n" )MutableStringAppendString( xml, fn StringWithFormat( @"        <customView id=\"%@\" userLabel=\"%@ View\">\n", fn XibNewID, fn XibEscape( resourceName ) ) )MutableStringAppendString( xml, fn StringWithFormat( @"            <rect key=\"frame\" x=\"0.0\" y=\"0.0\" width=\"%ld\" height=\"%ld\"/>\n", viewWidth, viewHeight ) )MutableStringAppendString( xml, @"            <autoresizingMask key=\"autoresizingMask\" flexibleMaxX=\"YES\" flexibleMinY=\"YES\"/>\n" )MutableStringAppendString( xml, @"            <subviews>\n" )// pass 2 - lay out label + control rows, column by column, top-down (Cocoa y grows upward).// Tags follow the model's attribute order, so hiding a field does not renumber the others.n   = 0col = -1for i = 0 to count - 1attr     = fn ArrayObjectAtIndex( attributes, i )attrName = fn DictionaryObjectForKey( attr, @"name" )sqlType  = fn DictionaryObjectForKey( attr, @"type" )if ( sqlType == NULL ) then sqlType = @""kind     = fn TypeMapAttributeKind( attr )isHidden = ( kind == _xibKindHidden )tag      = 0if ( isHidden == NO )h   = fn XibControlHeight( kind )w   = fn XibFormFieldWidth( attr, maxWidth )tag = baseTag + i + 1if ( n mod rowsPerColumn == 0 )                        // the first field of a columncol++yTop = viewHeight - _xibMarginx0   = _xibMargin + ( col * columnWidth )end ifMutableStringAppendString( xml, fn XibLabelElement( fn TypeMapAttributeTitle( attr ), x0, yTop - fn XibLabelDrop( kind ), labelWidth ) )MutableStringAppendString( xml, fn XibFieldElement( kind, tag, x0 + labelWidth + _xibLabelGap, yTop - h, w, h ) )MutableStringAppendString( tagGlobals, fn StringWithFormat( @"%@ = %ld\t\t// %@\n", fn XibConstantName( resourceName, attrName ), tag, sqlType ) )// the records table shows the first few short fieldsif ( fn ArrayCount( listColumns ) < _xibListColumns && kind != _xibKindTextArea ) then MutableArrayAddObject( listColumns, attrName )yTop = yTop - h - _xibRowGapn++end if// every attribute stays in the model (the data runtime reads all columns); hidden ones have no tagMutableArrayAddObject( modelFields, @{ @"name":attrName, @"title":fn TypeMapAttributeTitle( attr ), @"type":sqlType, @"kind":fn NumberWithInteger( kind ), @"tag":fn NumberWithInteger( tag ), @"hidden":fn NumberWithBool( isHidden ), @"pk":fn NumberWithInteger( fn NumberIntegerValue( fn DictionaryObjectForKey( attr, @"pk" ) ) ), @"notnull":fn NumberWithBool( fn NumberIntegerValue( fn DictionaryObjectForKey( attr, @"notnull" ) ) != 0 ) } )next// document footerMutableStringAppendString( xml, @"            </subviews>\n" )MutableStringAppendString( xml, @"            <point key=\"canvasLocation\" x=\"0.0\" y=\"0.0\"/>\n" )MutableStringAppendString( xml, @"        </customView>\n" )MutableStringAppendString( xml, @"    </objects>\n" )MutableStringAppendString( xml, @"</document>\n" )MutableDictionarySetObjectForKey( resourceModel, resourceName,                                     @"name" )MutableDictionarySetObjectForKey( resourceModel, fn StringWithFormat( @"%@Form", resourceName ),  @"formNib" )MutableDictionarySetObjectForKey( resourceModel, fn StringWithFormat( @"%@Form", resourceName ),  @"nib" )        // until the shell (step 3) replaces ALS App.inclMutableDictionarySetObjectForKey( resourceModel, fn NumberWithInteger( baseTag ),                 @"viewTag" )MutableDictionarySetObjectForKey( resourceModel, fn NumberWithInteger( viewWidth ),               @"viewWidth" )MutableDictionarySetObjectForKey( resourceModel, fn NumberWithInteger( viewHeight ),              @"viewHeight" )MutableDictionarySetObjectForKey( resourceModel, listColumns,                                      @"listColumns" )MutableDictionarySetObjectForKey( resourceModel, modelFields,                                      @"fields" )end fn = xml/* *   List part - one resource -> <Resource>List.xib *   A custom view holding a scroll view and a view-based table with one column per *   attribute. Column identifier = attribute name (FB's table data source keys each *   row dictionary by column identifier); column title = the attribute's label. *   Tags: list view = listTag, scroll view = listTag + 1, table = listTag + 2. */local fn XibListColumnElement( identifier as CFStringRef, title as CFStringRef, colWidth as long, alignment as CFStringRef ) as CFStringRefCFMutableStringRef s = fn MutableStringNewCFStringRef        textFieldID = fn XibNewIDMutableStringAppendString( s, fn StringWithFormat( @"                                <tableColumn identifier=\"%@\" width=\"%ld\" minWidth=\"40\" maxWidth=\"1000\" id=\"%@\">\n", fn XibEscape( identifier ), colWidth, fn XibNewID ) )MutableStringAppendString( s, fn StringWithFormat( @"                                    <tableHeaderCell key=\"headerCell\" lineBreakMode=\"truncatingTail\" borderStyle=\"border\" alignment=\"%@\" title=\"%@\">\n", alignment, fn XibEscape( title ) ) )MutableStringAppendString( s,                      @"                                        <color key=\"textColor\" name=\"headerTextColor\" catalog=\"System\" colorSpace=\"catalog\"/>\n" )MutableStringAppendString( s,                      @"                                        <color key=\"backgroundColor\" name=\"headerColor\" catalog=\"System\" colorSpace=\"catalog\"/>\n" )MutableStringAppendString( s,                      @"                                    </tableHeaderCell>\n" )MutableStringAppendString( s, fn StringWithFormat( @"                                    <textFieldCell key=\"dataCell\" lineBreakMode=\"truncatingTail\" selectable=\"YES\" editable=\"YES\" alignment=\"%@\" title=\"Text Cell\" id=\"%@\">\n", alignment, fn XibNewID ) )MutableStringAppendString( s,                      @"                                        <font key=\"font\" metaFont=\"system\"/>\n" )MutableStringAppendString( s,                      @"                                        <color key=\"textColor\" name=\"controlTextColor\" catalog=\"System\" colorSpace=\"catalog\"/>\n" )MutableStringAppendString( s,                      @"                                        <color key=\"backgroundColor\" name=\"controlBackgroundColor\" catalog=\"System\" colorSpace=\"catalog\"/>\n" )MutableStringAppendString( s,                      @"                                    </textFieldCell>\n" )MutableStringAppendString( s,                      @"                                    <tableColumnResizingMask key=\"resizingMask\" resizeWithTable=\"YES\" userResizable=\"YES\"/>\n" )MutableStringAppendString( s,                      @"                                    <prototypeCellViews>\n" )MutableStringAppendString( s, fn StringWithFormat( @"                                        <tableCellView identifier=\"%@\" id=\"%@\">\n", fn XibEscape( identifier ), fn XibNewID ) )MutableStringAppendString( s, fn StringWithFormat( @"                                            <rect key=\"frame\" x=\"1\" y=\"1\" width=\"%ld\" height=\"24\"/>\n", colWidth ) )MutableStringAppendString( s,                      @"                                            <autoresizingMask key=\"autoresizingMask\" widthSizable=\"YES\" heightSizable=\"YES\"/>\n" )MutableStringAppendString( s,                      @"                                            <subviews>\n" )MutableStringAppendString( s, fn StringWithFormat( @"                                                <textField verticalHuggingPriority=\"750\" horizontalCompressionResistancePriority=\"250\" fixedFrame=\"YES\" translatesAutoresizingMaskIntoConstraints=\"NO\" id=\"%@\">\n", textFieldID ) )MutableStringAppendString( s, fn StringWithFormat( @"                                                    <rect key=\"frame\" x=\"0.0\" y=\"4\" width=\"%ld\" height=\"16\"/>\n", colWidth ) )MutableStringAppendString( s,                      @"                                                    <autoresizingMask key=\"autoresizingMask\" widthSizable=\"YES\" flexibleMinY=\"YES\"/>\n" )MutableStringAppendString( s, fn StringWithFormat( @"                                                    <textFieldCell key=\"cell\" lineBreakMode=\"truncatingTail\" sendsActionOnEndEditing=\"YES\" alignment=\"%@\" title=\"Table View Cell\" id=\"%@\">\n", alignment, fn XibNewID ) )MutableStringAppendString( s,                      @"                                                        <font key=\"font\" usesAppearanceFont=\"YES\"/>\n" )MutableStringAppendString( s,                      @"                                                        <color key=\"textColor\" name=\"controlTextColor\" catalog=\"System\" colorSpace=\"catalog\"/>\n" )MutableStringAppendString( s,                      @"                                                        <color key=\"backgroundColor\" name=\"textBackgroundColor\" catalog=\"System\" colorSpace=\"catalog\"/>\n" )MutableStringAppendString( s,                      @"                                                    </textFieldCell>\n" )MutableStringAppendString( s,                      @"                                                </textField>\n" )MutableStringAppendString( s,                      @"                                            </subviews>\n" )MutableStringAppendString( s,                      @"                                            <connections>\n" )MutableStringAppendString( s, fn StringWithFormat( @"                                                <outlet property=\"textField\" destination=\"%@\" id=\"%@\"/>\n", textFieldID, fn XibNewID ) )MutableStringAppendString( s,                      @"                                            </connections>\n" )MutableStringAppendString( s,                      @"                                        </tableCellView>\n" )MutableStringAppendString( s,                      @"                                    </prototypeCellViews>\n" )MutableStringAppendString( s,                      @"                                </tableColumn>\n" )end fn = slocal fn XibListDocument( resourceName as CFStringRef, attributes as CFArrayRef, listTag as long, tagGlobals as CFMutableStringRef, resourceModel as CFMutableDictionaryRef ) as CFStringRefCFMutableStringRef xml     = fn MutableStringNewCFMutableStringRef columns = fn MutableStringNewCFMutableArrayRef  listAttributes = fn MutableArrayNewCFDictionaryRef    attrCFStringRef        attrName, alignment, headerID, prefixlong               kind, colWidth, tableWidth = 0, viewWidth, ifor i = 0 to (long)fn ArrayCount( attributes ) - 1attr     = fn ArrayObjectAtIndex( attributes, i )attrName = fn DictionaryObjectForKey( attr, @"name" )kind     = fn TypeMapAttributeKind( attr )if ( kind != _xibKindHidden )                                     // a Hidden attribute has no columncolWidth    = fn TypeMapAttributeListWidth( attr )alignment = @"left"if ( kind == _xibKindInteger || kind == _xibKindDecimal ) then alignment = @"right"MutableStringAppendString( columns, fn XibListColumnElement( attrName, fn TypeMapAttributeTitle( attr ), colWidth, alignment ) )MutableArrayAddObject( listAttributes, attrName )tableWidth = tableWidth + colWidth + 17end ifnextviewWidth = tableWidth + 2if ( viewWidth < _xibListMinWidth ) then viewWidth = _xibListMinWidthif ( viewWidth > _xibListMaxWidth ) then viewWidth = _xibListMaxWidthheaderID = fn XibNewIDprefix = fn XibResourcePrefix( resourceName )MutableStringAppendString( tagGlobals, fn StringWithFormat( @"_%@List = %ld\t\t\t// %@List.xib\n", prefix, listTag, resourceName ) )MutableStringAppendString( tagGlobals, fn StringWithFormat( @"_%@ListScroll = %ld\n", prefix, listTag + 1 ) )MutableStringAppendString( tagGlobals, fn StringWithFormat( @"_%@ListTable = %ld\n", prefix, listTag + 2 ) )MutableStringAppendString( xml, @"<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n" )MutableStringAppendString( xml, @"<document type=\"com.apple.InterfaceBuilder3.Cocoa.XIB\" version=\"3.0\" toolsVersion=\"22146\" targetRuntime=\"MacOSX.Cocoa\" propertyAccessControl=\"none\" useAutolayout=\"YES\" customObjectInstantitationMethod=\"direct\">\n" )MutableStringAppendString( xml, @"    <dependencies>\n" )MutableStringAppendString( xml, @"        <plugIn identifier=\"com.apple.InterfaceBuilder.CocoaPlugin\" version=\"22146\"/>\n" )MutableStringAppendString( xml, @"        <capability name=\"documents saved in the Xcode 8 format\" minToolsVersion=\"8.0\"/>\n" )MutableStringAppendString( xml, @"    </dependencies>\n" )MutableStringAppendString( xml, @"    <objects>\n" )MutableStringAppendString( xml, @"        <customObject id=\"-2\" userLabel=\"File's Owner\"/>\n" )MutableStringAppendString( xml, @"        <customObject id=\"-1\" userLabel=\"First Responder\" customClass=\"FirstResponder\"/>\n" )MutableStringAppendString( xml, @"        <customObject id=\"-3\" userLabel=\"Application\" customClass=\"NSObject\"/>\n" )MutableStringAppendString( xml, fn StringWithFormat( @"        <customView id=\"%@\" userLabel=\"%@ List\">\n", fn XibNewID, fn XibEscape( resourceName ) ) )MutableStringAppendString( xml, fn StringWithFormat( @"            <rect key=\"frame\" x=\"0.0\" y=\"0.0\" width=\"%ld\" height=\"%ld\"/>\n", viewWidth, (long)_xibListHeight ) )MutableStringAppendString( xml, @"            <autoresizingMask key=\"autoresizingMask\" widthSizable=\"YES\" heightSizable=\"YES\"/>\n" )MutableStringAppendString( xml, @"            <subviews>\n" )MutableStringAppendString( xml, fn StringWithFormat( @"                <scrollView autohidesScrollers=\"YES\" horizontalLineScroll=\"24\" horizontalPageScroll=\"10\" verticalLineScroll=\"24\" verticalPageScroll=\"10\" usesPredominantAxisScrolling=\"NO\" tag=\"%ld\" id=\"%@\">\n", listTag + 1, fn XibNewID ) )MutableStringAppendString( xml, fn StringWithFormat( @"                    <rect key=\"frame\" x=\"0.0\" y=\"0.0\" width=\"%ld\" height=\"%ld\"/>\n", viewWidth, (long)_xibListHeight ) )MutableStringAppendString( xml, @"                    <autoresizingMask key=\"autoresizingMask\" widthSizable=\"YES\" heightSizable=\"YES\"/>\n" )MutableStringAppendString( xml, fn StringWithFormat( @"                    <clipView key=\"contentView\" id=\"%@\">\n", fn XibNewID ) )MutableStringAppendString( xml, fn StringWithFormat( @"                        <rect key=\"frame\" x=\"1\" y=\"1\" width=\"%ld\" height=\"%ld\"/>\n", viewWidth - 2, (long)_xibListHeight - 2 ) )MutableStringAppendString( xml, @"                        <autoresizingMask key=\"autoresizingMask\" widthSizable=\"YES\" heightSizable=\"YES\"/>\n" )MutableStringAppendString( xml, @"                        <subviews>\n" )MutableStringAppendString( xml, fn StringWithFormat( @"                            <tableView verticalHuggingPriority=\"750\" tag=\"%ld\" allowsExpansionToolTips=\"YES\" columnAutoresizingStyle=\"lastColumnOnly\" alternatingRowBackgroundColors=\"YES\" multipleSelection=\"NO\" autosaveColumns=\"NO\" rowHeight=\"24\" rowSizeStyle=\"automatic\" headerView=\"%@\" viewBased=\"YES\" id=\"%@\">\n", listTag + 2, headerID, fn XibNewID ) )MutableStringAppendString( xml, fn StringWithFormat( @"                                <rect key=\"frame\" x=\"0.0\" y=\"0.0\" width=\"%ld\" height=\"%ld\"/>\n", tableWidth, (long)_xibListHeight - 30 ) )MutableStringAppendString( xml, @"                                <autoresizingMask key=\"autoresizingMask\" widthSizable=\"YES\" heightSizable=\"YES\"/>\n" )MutableStringAppendString( xml, @"                                <size key=\"intercellSpacing\" width=\"17\" height=\"0.0\"/>\n" )MutableStringAppendString( xml, @"                                <color key=\"backgroundColor\" name=\"controlBackgroundColor\" catalog=\"System\" colorSpace=\"catalog\"/>\n" )MutableStringAppendString( xml, @"                                <color key=\"gridColor\" name=\"gridColor\" catalog=\"System\" colorSpace=\"catalog\"/>\n" )MutableStringAppendString( xml, @"                                <tableColumns>\n" )MutableStringAppendString( xml, columns )MutableStringAppendString( xml, @"                                </tableColumns>\n" )MutableStringAppendString( xml, @"                            </tableView>\n" )MutableStringAppendString( xml, @"                        </subviews>\n" )MutableStringAppendString( xml, @"                    </clipView>\n" )MutableStringAppendString( xml, fn StringWithFormat( @"                    <scroller key=\"horizontalScroller\" hidden=\"YES\" wantsLayer=\"YES\" verticalHuggingPriority=\"750\" horizontal=\"YES\" id=\"%@\">\n", fn XibNewID ) )MutableStringAppendString( xml, fn StringWithFormat( @"                        <rect key=\"frame\" x=\"1\" y=\"%ld\" width=\"%ld\" height=\"16\"/>\n", (long)_xibListHeight - 17, viewWidth - 2 ) )MutableStringAppendString( xml, @"                        <autoresizingMask key=\"autoresizingMask\"/>\n" )MutableStringAppendString( xml, @"                    </scroller>\n" )MutableStringAppendString( xml, fn StringWithFormat( @"                    <scroller key=\"verticalScroller\" hidden=\"YES\" wantsLayer=\"YES\" verticalHuggingPriority=\"750\" horizontal=\"NO\" id=\"%@\">\n", fn XibNewID ) )MutableStringAppendString( xml, fn StringWithFormat( @"                        <rect key=\"frame\" x=\"%ld\" y=\"17\" width=\"15\" height=\"%ld\"/>\n", viewWidth - 16, (long)_xibListHeight - 18 ) )MutableStringAppendString( xml, @"                        <autoresizingMask key=\"autoresizingMask\"/>\n" )MutableStringAppendString( xml, @"                    </scroller>\n" )MutableStringAppendString( xml, fn StringWithFormat( @"                    <tableHeaderView key=\"headerView\" wantsLayer=\"YES\" id=\"%@\">\n", headerID ) )MutableStringAppendString( xml, fn StringWithFormat( @"                        <rect key=\"frame\" x=\"0.0\" y=\"0.0\" width=\"%ld\" height=\"28\"/>\n", tableWidth ) )MutableStringAppendString( xml, @"                        <autoresizingMask key=\"autoresizingMask\"/>\n" )MutableStringAppendString( xml, @"                    </tableHeaderView>\n" )MutableStringAppendString( xml, @"                </scrollView>\n" )MutableStringAppendString( xml, @"            </subviews>\n" )MutableStringAppendString( xml, @"            <point key=\"canvasLocation\" x=\"0.0\" y=\"0.0\"/>\n" )MutableStringAppendString( xml, @"        </customView>\n" )MutableStringAppendString( xml, @"    </objects>\n" )MutableStringAppendString( xml, @"</document>\n" )MutableDictionarySetObjectForKey( resourceModel, fn StringWithFormat( @"%@List", resourceName ), @"listNib" )MutableDictionarySetObjectForKey( resourceModel, fn NumberWithInteger( listTag ),     @"listViewTag" )MutableDictionarySetObjectForKey( resourceModel, fn NumberWithInteger( listTag + 1 ), @"listScrollTag" )MutableDictionarySetObjectForKey( resourceModel, fn NumberWithInteger( listTag + 2 ), @"listTableTag" )MutableDictionarySetObjectForKey( resourceModel, fn NumberWithInteger( viewWidth ),   @"listWidth" )MutableDictionarySetObjectForKey( resourceModel, fn NumberWithInteger( _xibListHeight ), @"listHeight" )MutableDictionarySetObjectForKey( resourceModel, listAttributes,                     @"listAttributes" )end fn = xml/* *   whole project -> <folder>/<Resource>Form.xib + <Resource>List.xib  +  <folder>/Model Tags.incl *   adds every resource's model entry to modelResources; writes the XIB files only when *   writeXibs is YES - for every resource, or only onlyName. Returns the entities written. */local fn XibGenerateProject( projectDict as CFDictionaryRef, folderURL as CFURLRef, projectLabel as CFStringRef, modelResources as CFMutableArrayRef, writeXibs as BOOL, onlyName as CFStringRef ) as longCFDictionaryRef        resourceDict, resourceCFArrayRef             names, attributesCFStringRef            name, xml, formXML, modelKeyCFArrayRef             modelKeys = @[ @"kind", @"keys", @"keyKind", @"relationships" ]CFMutableStringRef     tagGlobalsCFMutableDictionaryRef resourceModelCFURLRef           fileURLErrorRef           err = NULLlong               resourceIndex = 0, written = 0if ( projectDict == NULL || folderURL == NULL ) then exit fn = 0resourceDict = fn DictionaryObjectForKey( projectDict, @"resources" )if ( resourceDict == NULL )if (isLoggingOn) then NSLog( @"XibGenerateProject: no resources loaded - fetch or open the metadata first." )exit fn = 0end iftagGlobals = fn MutableStringNewMutableStringAppendString( tagGlobals, fn StringWithFormat( @"/*\n *   %@\n *   Generated by Api Logic Client - view and control tags, for your own code in the generated app.\n *   Regenerating overwrites this file.\n */\n", projectLabel ) )// sorted so tags stay stable when the model is regeneratednames = fn ArraySortedArrayUsingSelector( fn DictionaryAllKeys( resourceDict ), @"compare:" )for name in namesresourceIndex++resource   = fn DictionaryObjectForKey( resourceDict, name )attributes = fn DictionaryObjectForKey( resource, @"attributes" )if ( attributes != NULL )if ( fn ArrayCount( attributes ) >= _xibTagsPerResource )if (isLoggingOn) then NSLog( @"Skipping %@: %ld attributes exceeds the %ld tags reserved per resource.", name, fn ArrayCount( attributes ), (long)_xibTagsPerResource )elsegXibNextID = 0resourceModel = fn MutableDictionaryNew// carry the model's keys and relationships through to Model.json (SQLite source)for modelKey in modelKeysif ( fn DictionaryObjectForKey( resource, modelKey ) != NULL ) then MutableDictionarySetObjectForKey( resourceModel, fn DictionaryObjectForKey( resource, modelKey ), modelKey )next// scalar (form) part, then the list part - each entity's tags stay together in Model Tags.incl.// Both are always built (their tags and sizes go into the model); files are written on request.formXML = fn XibViewDocument( name, attributes, fn TypeMapFormColumns( resource ), resourceIndex * _xibTagsPerResource, tagGlobals, resourceModel )xml     = fn XibListDocument( name, attributes, _xibListTagBase + resourceIndex * _xibListTagsPer, tagGlobals, resourceModel )MutableDictionarySetObjectForKey( resourceModel, fn TypeMapEntityIcon( name, resource ), @"icon" )   // its navigation buttonMutableArrayAddObject( modelResources, resourceModel )if ( writeXibs && ( onlyName == NULL || fn StringIsEqual( onlyName, name ) ) )fileURL = fn URLByAppendingPathComponent( folderURL, fn StringWithFormat( @"%@Form.xib", name ) )if ( fn StringWriteToURL( formXML, fileURL, YES, NSUTF8StringEncoding, @err ) )written++if (isLoggingOn) then NSLog( @"Wrote %@", fn URLPath( fileURL ) )elseif (isLoggingOn) then NSLog( @"Could not write %@: %@", fn URLPath( fileURL ), fn ErrorLocalizedDescription( err ) )end iffileURL = fn URLByAppendingPathComponent( folderURL, fn StringWithFormat( @"%@List.xib", name ) )if ( fn StringWriteToURL( xml, fileURL, YES, NSUTF8StringEncoding, @err ) == NO )if (isLoggingOn) then NSLog( @"Could not write %@: %@", fn URLPath( fileURL ), fn ErrorLocalizedDescription( err ) )end ifend ifend ifend ifnextfileURL = fn URLByAppendingPathComponent( folderURL, @"Model Tags.incl" )if ( fn StringWriteToURL( fn StringByReplacingOccurrencesOfString( tagGlobals, @"\n", @"\r" ), fileURL, YES, NSUTF8StringEncoding, @err ) == NO )if (isLoggingOn) then NSLog( @"Could not write %@: %@", fn URLPath( fileURL ), fn ErrorLocalizedDescription( err ) )end ifend fn = written