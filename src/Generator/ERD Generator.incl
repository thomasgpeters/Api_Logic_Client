/* *   I M A G E R Y    B U S I N E S S     S Y S T E M S,   L L C * *   ERD Generator.incl - the model diagram (Model > Show Model Diagram) * *   Writes <project>/Model ERD.html - the project's entity-relationship diagram - and opens it *   in the browser.  The page is a template (Templates/ERD/Model ERD.html, in the workspace: *   Studio Library.incl); this file gives it the model and the rules: *       resources  the entities as the generator holds them (gProjectDictionary): attributes, *                  keys and relationships - the same model the app is generated from *       rules      the project's Rules.json, drawn as symbols on the attributes they derive *   The page does the rest: layout, drag and drop, open / close an entity, themes, Export SVG. */#define ERD_FILE_NAME     @"Model ERD.html"#define ERD_DATA_MARKER   @"/*__ERD_DATA__*/null"local fn ErdFileURL as CFURLRefend fn = fn URLByAppendingPathComponent( fn ProjectFolderURL, ERD_FILE_NAME )// the project's rules (Rules.json), or an empty list when it has none yetlocal fn ErdRules as CFArrayRefCFDataRef       rulesDataCFDictionaryRef rulesDocumentCFArrayRef      rules = @[]ErrorRef      err = NULLif ( fn FileManagerFileExistsAtURL( fn RulesFileURL ) == NO ) then exit fn = rulesrulesData = fn DataWithContentsOfURL( fn RulesFileURL, 0, @err )if ( rulesData == NULL ) then exit fn = rulesrulesDocument = fn JSONSerializationJSONObjectWithData( rulesData, 0, @err )if ( rulesDocument == NULL ) then exit fn = rulesif ( fn DictionaryObjectForKey( rulesDocument, @"rules" ) != NULL ) then rules = fn DictionaryObjectForKey( rulesDocument, @"rules" )end fn = rules// the page's data as JSON text: { title, resources, rules }; NULL when the model cannot be writtenlocal fn ErdDataJSON as CFStringRefCFDictionaryRef erdDataCFDataRef       jsonDataErrorRef      err = NULLerdData = fn MutableDictionaryNewMutableDictionarySetObjectForKey( (CFMutableDictionaryRef)erdData, fn ProjectAppName, @"title" )MutableDictionarySetObjectForKey( (CFMutableDictionaryRef)erdData, fn DictionaryObjectForKey( gProjectDictionary, @"resources" ), @"resources" )MutableDictionarySetObjectForKey( (CFMutableDictionaryRef)erdData, fn ErdRules, @"rules" )if ( fn JSONSerializationIsValidJSONObject( (CFTypeRef)erdData ) == NO )if (isLoggingOn) then NSLog( @"ERD: the model holds values JSON cannot carry" )exit fn = NULLend ifjsonData = fn JSONSerializationDataWithJSONObject( erdData, 0, @err )if ( jsonData == NULL ) then exit fn = NULL// "</" inside the page's <script> would end it early: write it as "<\/" (the same to JSON)end fn = fn StringByReplacingOccurrencesOfString( fn StringWithData( jsonData, NSUTF8StringEncoding ), @"</", @"<\\/" )// write <project>/Model ERD.html; YES when it was writtenlocal fn ErdWritePage as BOOLCFURLRef    templateURLCFStringRef page, dataJSONErrorRef  err = NULLif ( fn StudioLibraryReady == NO ) then exit fn = NOtemplateURL = fn URLByAppendingPathComponent( fn URLByAppendingPathComponent( fn StudioTemplatesURL, @"ERD" ), @"Model ERD.html" )if ( fn FileManagerFileExistsAtURL( templateURL ) == NO )NSLog( @"Templates/ERD/Model ERD.html is not in the workspace - Generate > Update Runtime and Templates." )exit fn = NOend ifpage = fn StringWithContentsOfURL( templateURL, NSUTF8StringEncoding, @err )dataJSON = fn ErdDataJSONif ( page == NULL || dataJSON == NULL ) then exit fn = NOpage = fn StringByReplacingOccurrencesOfString( page, ERD_DATA_MARKER, dataJSON )end fn = fn StringWriteToURL( page, fn ErdFileURL, YES, NSUTF8StringEncoding, @err )// Model > Show Model Diagram: write the diagram and open it in the browservoid local fn ErdShowif ( fn DictionaryObjectForKey( gProjectDictionary, @"resources" ) == NULL )alert 1, NSAlertStyleInformational, @"No project is open.", @"Open a project or a model first.", @[@"OK"], NOexit fnend ifif ( fn ErdWritePage == NO )alert 1, NSAlertStyleWarning, @"The model diagram could not be written.", fn URLPath( fn ErdFileURL ), @[@"OK"], NOexit fnend ifif (isLoggingOn) then NSLog( @"ERD: wrote %@", fn URLPath( fn ErdFileURL ) )fn WorkspaceOpenURL( fn ErdFileURL )end fn