/* *   I M A G E R Y    B U S I N E S S     S Y S T E M S,   L L C * *   Type Mapping * *   The rules that turn the model into design decisions, in one place: *     - recommendations from each attribute's SQL type: control kind, FB data type, *       size, form width, list column width, and the Title (field label and column *       heading) from the attribute name; *     - the designer's adjustments: an attribute's "design" dictionary overrides any *       recommendation (title, fbType, formControl, formWidth, listWidth); an entity's *       "design" dictionary holds its form layout (formColumns: 1, 2 or 3). *     - a key the database generates (keyKind identity / autoincrement) is read-only text; *       a Hidden attribute is on neither the Form nor the List (it stays in the model). *   The entity-definition display, the XIB generator and the binding generator all *   read attributes through the TypeMapAttribute... functions, so what the designer *   sees is exactly what gets generated. */// control kindsbegin enum 1_xibKindText_xibKindTextArea_xibKindInteger_xibKindDecimal_xibKindDate_xibKindCheckbox_xibKindReadOnly         // shown, not edited: a key the database generates, or the designer's choice_xibKindHidden           // on neither the Form nor the List_xibKindTime             // a time picker: hours, minutes, seconds_xibKindDateTime         // a date and time picker_xibKindRadio            // radio buttons, one per value of the value list_xibKindDropdown         // a popup: the value list, or the rows of the lookup table (a foreign key)end enum_xibMaxRadioValues   = 8          // more values than this: a Dropdown instead_xibRadioTagBase     = 30000      // radio button n of field tag t: 30000 + t * 10 + n (BindingRadioTag)_xibLookupInfoTagBase = 40000     // a lookup Dropdown's info button: 40000 + the field's tag (Record Popover.incl)_xibLookupInfoWidth  = 24        // ... its width, beside the Dropdown// layout metrics, in points_xibMargin           = 20_xibLabelWidth       = 150_xibLabelHeight      = 16_xibLabelGap         = 8_xibColumnWidth      = 470_xibRowGap           = 10_xibMaxRowsPerColumn = 10_xibMinFieldWidth    = 60_xibMaxFieldWidth    = 290_xibMaxFieldWidth3   = 200        // in a three-column form_xibMaxFormColumns   = 3_xibCharWidth        = 7_xibTagsPerResource  = 100_xibListColumns      = 4_xibListTagBase      = 20000      // list part tags: base + resourceIndex * 10 (+1 scroll, +2 table)_xibListTagsPer      = 10_xibListHeight       = 240_xibListMinWidth     = 480_xibListMaxWidth     = 960_xibListMinColumn    = 60_xibListMaxColumn    = 220// "VARCHAR(40)" -> 40,  "DECIMAL(10,2)" -> 10,  "TEXT" -> 0local fn XibLengthForType( sqlType as CFStringRef ) as longlong       length = 0CFArrayRef partsif ( sqlType != NULL )parts = fn StringComponentsSeparatedByString( sqlType, @"(" )if ( fn ArrayCount( parts ) > 1 ) then length = fn StringIntegerValue( fn ArrayObjectAtIndex( parts, 1 ) )end ifend fn = lengthlocal fn XibControlKindForType( sqlType as CFStringRef ) as longlong        kind = _xibKindTextCFStringRef t    = @"TEXT"if ( sqlType != NULL ) then t = fn StringUppercaseString( sqlType )// SQLite declares every string TEXT, so TEXT is a one-line field (the designer can choose Text// area); only the long-text types of other databases are text areasif ( fn StringHasPrefix( t, @"CLOB" ) || fn StringHasPrefix( t, @"MEDIUMTEXT" ) || fn StringHasPrefix( t, @"LONGTEXT" ) ) then kind = _xibKindTextAreaif ( fn StringHasPrefix( t, @"SMALLINT" ) || fn StringHasPrefix( t, @"INT" ) || fn StringHasPrefix( t, @"BIGINT" ) || fn StringHasPrefix( t, @"TINYINT" ) ) then kind = _xibKindIntegerif ( fn StringHasPrefix( t, @"FLOAT" ) || fn StringHasPrefix( t, @"DOUBLE" ) || fn StringHasPrefix( t, @"REAL" ) || fn StringHasPrefix( t, @"DECIMAL" ) || fn StringHasPrefix( t, @"NUMERIC" ) || fn StringHasPrefix( t, @"MONEY" ) ) then kind = _xibKindDecimalif ( fn StringHasPrefix( t, @"DATE" ) ) then kind = _xibKindDateif ( fn StringHasPrefix( t, @"DATETIME" ) || fn StringHasPrefix( t, @"TIMESTAMP" ) ) then kind = _xibKindDateTimeif ( fn StringHasPrefix( t, @"TIME" ) && fn StringHasPrefix( t, @"TIMESTAMP" ) == NO ) then kind = _xibKindTimeif ( fn StringHasPrefix( t, @"BOOL" ) || fn StringIsEqual( t, @"BIT" ) ) then kind = _xibKindCheckboxend fn = kindlocal fn XibFieldWidth( kind as long, length as long ) as longlong w = 200select ( kind )case _xibKindTextw = 280                                   // TEXT, VARCHAR without a lengthif ( length > 0 ) then w = length * _xibCharWidth + 16case _xibKindTextArea : w = _xibMaxFieldWidthcase _xibKindInteger  : w = 80case _xibKindDecimal  : w = 100case _xibKindDate     : w = 110case _xibKindCheckbox : w = 22case _xibKindReadOnly : w = 120case _xibKindTime     : w = 100case _xibKindDateTime : w = 190case _xibKindDropdown : w = 220case _xibKindRadio    : w = 220case _xibKindHidden   : exit fn = 0end selectif ( kind != _xibKindCheckbox && w < _xibMinFieldWidth ) then w = _xibMinFieldWidthif ( w > _xibMaxFieldWidth ) then w = _xibMaxFieldWidthend fn = wlocal fn XibListColumnWidth( kind as long, length as long ) as longlong w = 140select ( kind )case _xibKindTextif ( length > 0 ) then w = length * _xibCharWidth + 24case _xibKindTextArea : w = _xibListMaxColumncase _xibKindInteger  : w = 70case _xibKindDecimal  : w = 90case _xibKindDate     : w = 100case _xibKindCheckbox : w = 50case _xibKindReadOnly : w = 80case _xibKindTime     : w = 80case _xibKindDateTime : w = 150case _xibKindDropdown : w = 120case _xibKindRadio    : w = 100end selectif ( w < _xibListMinColumn ) then w = _xibListMinColumnif ( w > _xibListMaxColumn ) then w = _xibListMaxColumnend fn = w/* *   names */// first character upper case, the rest unchanged:  "companyName" -> "CompanyName"local fn TypeMapUpperFirst( word as CFStringRef ) as CFStringRefif ( fn StringLength( word ) == 0 ) then exit fn = wordend fn = fn StringWithFormat( @"%@%@", fn StringUppercaseString( fn StringSubstringToIndex( word, 1 ) ), fn StringSubstringFromIndex( word, 1 ) )// "CompanyName" -> "Company Name",  "customer_id" -> "Customer ID",  "CategoryName_ColumnName" -> "Category Name Column Name"local fn TypeMapDefaultTitle( attrName as CFStringRef ) as CFStringRefCFMutableArrayRef words = fn MutableArrayNewCFArrayRef        wordListCFStringRef       spaced, word, titleCFRange           wholewhole  = fn CFRangeMake( 0, fn StringLength( attrName ) )spaced = fn StringByReplacingOccurrencesOfStringWithOptions( attrName, @"([a-z0-9])([A-Z])", @"$1 $2", NSRegularExpressionSearch, whole )whole  = fn CFRangeMake( 0, fn StringLength( spaced ) )spaced = fn StringByReplacingOccurrencesOfStringWithOptions( spaced, @"([A-Z]+)([A-Z][a-z])", @"$1 $2", NSRegularExpressionSearch, whole )spaced = fn StringByReplacingOccurrencesOfString( spaced, @"_", @" " )wordList = fn StringComponentsSeparatedByString( spaced, @" " )for word in wordListif ( fn StringLength( word ) > 0 )if ( fn StringIsEqual( fn StringLowercaseString( word ), @"id" ) ) then word = @"ID"MutableArrayAddObject( words, fn TypeMapUpperFirst( word ) )end ifnexttitle = fn ArrayComponentsJoinedByString( words, @" " )if ( fn StringLength( title ) == 0 ) then title = attrNameend fn = title// "CompanyName" -> "CompanyName",  "customer_id" -> "CustomerId"  (constant-name part; case kept)local fn TypeMapPascalName( attrName as CFStringRef ) as CFStringRefCFMutableArrayRef words = fn MutableArrayNewCFArrayRef        wordList = fn StringComponentsSeparatedByString( fn StringByReplacingOccurrencesOfString( attrName, @" ", @"_" ), @"_" )CFStringRef       wordfor word in wordListif ( fn StringLength( word ) > 0 ) then MutableArrayAddObject( words, fn TypeMapUpperFirst( word ) )nextend fn = fn ArrayComponentsJoinedByString( words, @"" )/* *   recommendations from the SQL type */local fn TypeMapFBType( sqlType as CFStringRef ) as CFStringRefCFStringRef t = @""if ( sqlType != NULL ) then t = fn StringUppercaseString( sqlType )if ( fn StringHasPrefix( t, @"BLOB" ) ) then exit fn = @"CFDataRef"select ( fn XibControlKindForType( sqlType ) )case _xibKindInteger  : exit fn = @"NSInteger"case _xibKindDecimal  : exit fn = @"double"case _xibKindDate, _xibKindTime, _xibKindDateTime : exit fn = @"CFDateRef"case _xibKindCheckbox : exit fn = @"BOOL"end selectend fn = @"CFStringRef"// declared size: "40 chars", "10,2", or the FB type's sizelocal fn TypeMapSize( sqlType as CFStringRef ) as CFStringRefCFArrayRef  partsCFStringRef inside = @""if ( sqlType != NULL )parts = fn StringComponentsSeparatedByString( sqlType, @"(" )if ( fn ArrayCount( parts ) > 1 ) then inside = fn StringByReplacingOccurrencesOfString( fn ArrayObjectAtIndex( parts, 1 ), @")", @"" )end ifselect ( fn XibControlKindForType( sqlType ) )case _xibKindText, _xibKindTextAreaif ( fn StringLength( inside ) > 0 ) then exit fn = fn StringWithFormat( @"%@ chars", inside )exit fn = @"variable"case _xibKindInteger  : exit fn = @"64-bit"case _xibKindDecimalif ( fn StringLength( inside ) > 0 ) then exit fn = insideexit fn = @"64-bit"end selectend fn = @"—"local fn TypeMapControlName( kind as long ) as CFStringRefselect ( kind )case _xibKindTextArea : exit fn = @"Text area"case _xibKindInteger  : exit fn = @"Integer field"case _xibKindDecimal  : exit fn = @"Decimal field"case _xibKindDate     : exit fn = @"Date picker"case _xibKindCheckbox : exit fn = @"Checkbox"case _xibKindRadio    : exit fn = @"Radio buttons"case _xibKindDropdown : exit fn = @"Dropdown"case _xibKindTime     : exit fn = @"Time picker"case _xibKindDateTime : exit fn = @"Date and time picker"case _xibKindReadOnly : exit fn = @"Read-only text"case _xibKindHidden   : exit fn = @"Hidden"end selectend fn = @"Text field"// the controls the designer can choose, in the order the Studio's Control popup lists themlocal fn TypeMapControlKinds as CFArrayRefend fn = @[ fn NumberWithInteger( _xibKindText ), fn NumberWithInteger( _xibKindTextArea ), fn NumberWithInteger( _xibKindInteger ), fn NumberWithInteger( _xibKindDecimal ), fn NumberWithInteger( _xibKindDate ), fn NumberWithInteger( _xibKindTime ), fn NumberWithInteger( _xibKindDateTime ), fn NumberWithInteger( _xibKindCheckbox ), fn NumberWithInteger( _xibKindRadio ), fn NumberWithInteger( _xibKindDropdown ), fn NumberWithInteger( _xibKindReadOnly ), fn NumberWithInteger( _xibKindHidden ) ]// a designer's control name back to a kind; 0 when the name is not recognisedlocal fn TypeMapKindForControlName( controlName as CFStringRef ) as longCFStringRef n = fn StringLowercaseString( controlName )if ( fn StringHasPrefix( n, @"read" ) )      then exit fn = _xibKindReadOnlyif ( fn StringHasPrefix( n, @"radio" ) )     then exit fn = _xibKindRadioif ( fn StringHasPrefix( n, @"drop" ) || fn StringHasPrefix( n, @"popup" ) ) then exit fn = _xibKindDropdownif ( fn StringHasPrefix( n, @"hid" ) )       then exit fn = _xibKindHiddenif ( fn StringHasPrefix( n, @"text area" ) ) then exit fn = _xibKindTextAreaif ( fn StringHasPrefix( n, @"text" ) )      then exit fn = _xibKindTextif ( fn StringHasPrefix( n, @"integer" ) )   then exit fn = _xibKindIntegerif ( fn StringHasPrefix( n, @"decimal" ) )   then exit fn = _xibKindDecimalif ( fn StringHasPrefix( n, @"date and time" ) ) then exit fn = _xibKindDateTimeif ( fn StringHasPrefix( n, @"date" ) )      then exit fn = _xibKindDateif ( fn StringHasPrefix( n, @"time" ) )      then exit fn = _xibKindTimeif ( fn StringHasPrefix( n, @"check" ) )     then exit fn = _xibKindCheckboxend fn = 0/* *   effective values: the designer's adjustment when there is one, else the recommendation */local fn TypeMapOverride( attribute as CFDictionaryRef, key as CFStringRef ) as CFStringRefCFDictionaryRef design = fn DictionaryObjectForKey( attribute, @"design" )CFStringRef     valueif ( design == NULL ) then exit fn = NULLvalue = fn DictionaryObjectForKey( design, key )if ( value == NULL ) then exit fn = NULLif ( fn StringLength( value ) == 0 ) then exit fn = NULLend fn = valuelocal fn TypeMapAttributeSQLType( attribute as CFDictionaryRef ) as CFStringRefCFStringRef sqlType = fn DictionaryObjectForKey( attribute, @"type" )if ( sqlType == NULL ) then sqlType = @""end fn = sqlTypelocal fn TypeMapAttributeTitle( attribute as CFDictionaryRef ) as CFStringRefCFStringRef title = fn TypeMapOverride( attribute, @"title" )if ( title == NULL ) then title = fn TypeMapDefaultTitle( fn DictionaryObjectForKey( attribute, @"name" ) )end fn = title// the control the generator recommends, before the designer's choicelocal fn TypeMapRecommendedKind( attribute as CFDictionaryRef ) as long// a key the database generates is shown, never typed (SQLite Model.incl marks it "generated")if ( fn NumberIntegerValue( fn DictionaryObjectForKey( attribute, @"generated" ) ) != 0 ) then exit fn = _xibKindReadOnly// a foreign key offers its parent's rows (SQLite Model.incl marks it with "lookup")if ( fn DictionaryObjectForKey( attribute, @"lookup" ) != NULL ) then exit fn = _xibKindDropdownend fn = fn XibControlKindForType( fn TypeMapAttributeSQLType( attribute ) )// the designer's value list ("Retail, Wholesale, Online"), trimmed, without empty entrieslocal fn TypeMapAttributeValues( attribute as CFDictionaryRef ) as CFArrayRefCFMutableArrayRef values = fn MutableArrayNewCFStringRef       valueText = fn TypeMapOverride( attribute, @"values" )CFArrayRef        partsCFStringRef       part, valueif ( valueText == NULL ) then exit fn = valuesparts = fn StringComponentsSeparatedByString( valueText, @"," )for part in partsvalue = fn StringByTrimmingCharactersInSet( part, fn CharacterSetWhitespaceAndNewlineSet )if ( fn StringLength( value ) > 0 ) then MutableArrayAddObject( values, value )nextend fn = values// the control on the Form: the designer's choice, else the recommendationlocal fn TypeMapAttributeKind( attribute as CFDictionaryRef ) as longCFStringRef controlName = fn TypeMapOverride( attribute, @"formControl" )long        kind = 0if ( controlName != NULL ) then kind = fn TypeMapKindForControlName( controlName )if ( kind == 0 ) then kind = fn TypeMapRecommendedKind( attribute )// choices need something to choose from: radio buttons a short value list, a dropdown a value// list or a lookup table - otherwise the nearest control that worksif ( kind == _xibKindRadio )if ( fn ArrayCount( fn TypeMapAttributeValues( attribute ) ) == 0 || fn ArrayCount( fn TypeMapAttributeValues( attribute ) ) > _xibMaxRadioValues ) then kind = _xibKindDropdownend ifif ( kind == _xibKindDropdown )if ( fn ArrayCount( fn TypeMapAttributeValues( attribute ) ) == 0 && fn DictionaryObjectForKey( attribute, @"lookup" ) == NULL ) then kind = fn XibControlKindForType( fn TypeMapAttributeSQLType( attribute ) )end ifend fn = kind// on the Form and the List?  (a Hidden attribute is on neither; it stays in the model and the database)local fn TypeMapAttributeIsShown( attribute as CFDictionaryRef ) as BOOLend fn = ( fn TypeMapAttributeKind( attribute ) != _xibKindHidden )// the attributes on the Form and the List, in model orderlocal fn TypeMapShownAttributes( attributes as CFArrayRef ) as CFArrayRefCFMutableArrayRef shown = fn MutableArrayNewCFDictionaryRef   attributefor attribute in attributesif ( fn TypeMapAttributeIsShown( attribute ) ) then MutableArrayAddObject( shown, attribute )nextend fn = shown// the Form's columns: the designer's choice (1, 2 or 3), else 1 up to 10 fields, 2 up to 24, then 3local fn TypeMapFormColumns( resource as CFDictionaryRef ) as longCFDictionaryRef design = fn DictionaryObjectForKey( resource, @"design" )CFStringRef     choice = NULLlong            columns, shownCountif ( design != NULL ) then choice = fn DictionaryObjectForKey( design, @"formColumns" )if ( choice != NULL )columns = fn StringIntegerValue( choice )if ( columns >= 1 && columns <= _xibMaxFormColumns ) then exit fn = columnsend ifshownCount = fn ArrayCount( fn TypeMapShownAttributes( fn DictionaryObjectForKey( resource, @"attributes" ) ) )if ( shownCount <= 10 ) then exit fn = 1if ( shownCount <= 24 ) then exit fn = 2end fn = 3// YES when the designer chose the Form's columns (NO: the automatic choice)local fn TypeMapFormColumnsIsChosen( resource as CFDictionaryRef ) as BOOLCFDictionaryRef design = fn DictionaryObjectForKey( resource, @"design" )if ( design == NULL ) then exit fn = NOend fn = ( fn DictionaryObjectForKey( design, @"formColumns" ) != NULL )local fn TypeMapAttributeFBType( attribute as CFDictionaryRef ) as CFStringRefCFStringRef fbType = fn TypeMapOverride( attribute, @"fbType" )if ( fbType == NULL ) then fbType = fn TypeMapFBType( fn TypeMapAttributeSQLType( attribute ) )end fn = fbTypelocal fn TypeMapAttributeFormWidth( attribute as CFDictionaryRef ) as longCFStringRef widthText = fn TypeMapOverride( attribute, @"formWidth" )if ( widthText != NULL ) then if ( fn StringIntegerValue( widthText ) > 0 ) then exit fn = fn StringIntegerValue( widthText )end fn = fn XibFieldWidth( fn TypeMapAttributeKind( attribute ), fn XibLengthForType( fn TypeMapAttributeSQLType( attribute ) ) )local fn TypeMapAttributeListWidth( attribute as CFDictionaryRef ) as longCFStringRef widthText = fn TypeMapOverride( attribute, @"listWidth" )if ( widthText != NULL ) then if ( fn StringIntegerValue( widthText ) > 0 ) then exit fn = fn StringIntegerValue( widthText )end fn = fn XibListColumnWidth( fn TypeMapAttributeKind( attribute ), fn XibLengthForType( fn TypeMapAttributeSQLType( attribute ) ) )// "Title, Form Width" - which recommendations the designer has adjustedlocal fn TypeMapAdjusted( attribute as CFDictionaryRef ) as CFStringRefCFMutableArrayRef adjusted = fn MutableArrayNewif ( fn TypeMapOverride( attribute, @"title" )       != NULL ) then MutableArrayAddObject( adjusted, @"Title" )if ( fn TypeMapOverride( attribute, @"fbType" )      != NULL ) then MutableArrayAddObject( adjusted, @"FB Type" )if ( fn TypeMapOverride( attribute, @"formControl" ) != NULL ) then MutableArrayAddObject( adjusted, @"Form Control" )if ( fn TypeMapOverride( attribute, @"formWidth" )   != NULL ) then MutableArrayAddObject( adjusted, @"Form Width" )if ( fn TypeMapOverride( attribute, @"listWidth" )   != NULL ) then MutableArrayAddObject( adjusted, @"List Width" )if ( fn TypeMapOverride( attribute, @"values" )      != NULL ) then MutableArrayAddObject( adjusted, @"Values" )end fn = fn ArrayComponentsJoinedByString( adjusted, @", " )// the design key edited through an entity-definition column; NULL for read-only columnslocal fn TypeMapDesignKeyForColumn( columnIdentifier as CFStringRef ) as CFStringRefif ( fn StringIsEqual( columnIdentifier, @"Title" ) )        then exit fn = @"title"if ( fn StringIsEqual( columnIdentifier, @"FB Type" ) )      then exit fn = @"fbType"if ( fn StringIsEqual( columnIdentifier, @"Form Control" ) ) then exit fn = @"formControl"if ( fn StringIsEqual( columnIdentifier, @"Form Width" ) )   then exit fn = @"formWidth"if ( fn StringIsEqual( columnIdentifier, @"List Width" ) )   then exit fn = @"listWidth"if ( fn StringIsEqual( columnIdentifier, @"Values" ) )       then exit fn = @"values"end fn = NULL// "PK", "FK → Customer", "PK, FK → Order" for one attribute of a resourcelocal fn TypeMapKeyRole( resource as CFDictionaryRef, attribute as CFDictionaryRef ) as CFStringRefCFMutableArrayRef roles = fn MutableArrayNewCFDictionaryRef   relationshipCFArrayRef        relationships = fn DictionaryObjectForKey( resource, @"relationships" )CFStringRef       attrName = fn DictionaryObjectForKey( attribute, @"name" )if ( fn NumberIntegerValue( fn DictionaryObjectForKey( attribute, @"pk" ) ) > 0 ) then MutableArrayAddObject( roles, @"PK" )for relationship in relationshipsif ( fn StringIsEqual( fn DictionaryObjectForKey( relationship, @"direction" ), @"toone" ) )if ( fn ArrayContainsObject( fn DictionaryObjectForKey( relationship, @"fks" ), attrName ) ) then MutableArrayAddObject( roles, fn StringWithFormat( @"FK → %@", fn DictionaryObjectForKey( relationship, @"resource" ) ) )end ifnextend fn = fn ArrayComponentsJoinedByString( roles, @", " )// the Values cell: the value list as typed, or for a lookup "→ person.givenName" (what a Dropdown shows)local fn TypeMapValuesText( attribute as CFDictionaryRef ) as CFStringRefCFStringRef     valueText = fn TypeMapOverride( attribute, @"values" )CFDictionaryRef lookup = fn DictionaryObjectForKey( attribute, @"lookup" )if ( valueText != NULL ) then exit fn = valueTextif ( lookup != NULL ) then exit fn = fn StringWithFormat( @"→ %@.%@", fn DictionaryObjectForKey( lookup, @"entity" ), fn DictionaryObjectForKey( lookup, @"display" ) )end fn = @""/* *   one row of the entity-definition table; keys are the table's column identifiers */local fn TypeMapAttributeRow( resource as CFDictionaryRef, attribute as CFDictionaryRef ) as CFDictionaryRefCFStringRef sqlType      = fn TypeMapAttributeSQLType( attribute )CFStringRef required     = @""CFStringRef defaultValue = fn DictionaryObjectForKey( attribute, @"default" )if ( fn NumberIntegerValue( fn DictionaryObjectForKey( attribute, @"notnull" ) ) != 0 ) then required = @"yes"if ( defaultValue == NULL ) then defaultValue = @""end fn = @{ @"Name":fn DictionaryObjectForKey( attribute, @"name" ), @"Title":fn TypeMapAttributeTitle( attribute ), @"Data Type":sqlType, @"FB Type":fn TypeMapAttributeFBType( attribute ), @"Size":fn TypeMapSize( sqlType ), @"Key":fn TypeMapKeyRole( resource, attribute ), @"Required":required, @"Default":defaultValue, @"Form Control":fn TypeMapControlName( fn TypeMapAttributeKind( attribute ) ), @"Values":fn TypeMapValuesText( attribute ), @"Form Width":fn StringWithFormat( @"%ld", fn TypeMapAttributeFormWidth( attribute ) ), @"List Width":fn StringWithFormat( @"%ld", fn TypeMapAttributeListWidth( attribute ) ), @"Adjusted":fn TypeMapAdjusted( attribute ) }// "Customer — key Id (assigned) — OrderList ↓"local fn TypeMapResourceSummary( name as CFStringRef, resource as CFDictionaryRef ) as CFStringRefCFMutableArrayRef relationNames = fn MutableArrayNewCFDictionaryRef   relationshipCFArrayRef        keys = fn DictionaryObjectForKey( resource, @"keys" )CFArrayRef        relationships = fn DictionaryObjectForKey( resource, @"relationships" )CFStringRef       keyText = @"no key"if ( keys != NULL )if ( fn ArrayCount( keys ) > 0 ) then keyText = fn StringWithFormat( @"key %@ (%@)", fn ArrayComponentsJoinedByString( keys, @", " ), fn DictionaryObjectForKey( resource, @"keyKind" ) )end iffor relationship in relationshipsif ( fn StringIsEqual( fn DictionaryObjectForKey( relationship, @"direction" ), @"tomany" ) )MutableArrayAddObject( relationNames, fn StringWithFormat( @"%@ ↓", fn DictionaryObjectForKey( relationship, @"name" ) ) )elseMutableArrayAddObject( relationNames, fn StringWithFormat( @"%@ ↑", fn DictionaryObjectForKey( relationship, @"name" ) ) )end ifnextif ( fn ArrayCount( relationNames ) == 0 ) then exit fn = fn StringWithFormat( @"%@ — %@", name, keyText )end fn = fn StringWithFormat( @"%@ — %@ — %@", name, keyText, fn ArrayComponentsJoinedByString( relationNames, @"  " ) )/* *   icons: SF Symbols for the app and for each entity's navigation button */// the symbols the Studio offers (any SF Symbol name works in Design.json and Project.json)local fn TypeMapIconChoices as CFArrayRefend fn = @[ @"building.2", @"house", @"briefcase", @"person", @"person.2", @"person.3", @"person.crop.circle", @"cart", @"bag", @"creditcard", @"banknote", @"dollarsign.circle", @"shippingbox", @"truck.box", @"folder", @"doc.text", @"list.bullet.rectangle", @"tablecells", @"tag", @"calendar", @"clock", @"map", @"mappin.and.ellipse", @"globe", @"phone", @"envelope", @"chart.bar", @"star", @"book", @"wrench.and.screwdriver", @"gearshape", @"leaf", @"car" ]// the icon the generator recommends from the entity's namelocal fn TypeMapRecommendedIcon( entityName as CFStringRef ) as CFStringRefCFStringRef lower = fn StringLowercaseString( entityName )if ( fn StringContainsString( lower, @"detail" ) || fn StringContainsString( lower, @"line" ) || fn StringContainsString( lower, @"item" ) ) then exit fn = @"list.bullet.rectangle"if ( fn StringContainsString( lower, @"customer" ) || fn StringContainsString( lower, @"client" ) || fn StringContainsString( lower, @"person" ) || fn StringContainsString( lower, @"contact" ) ) then exit fn = @"person.2"if ( fn StringContainsString( lower, @"employee" ) || fn StringContainsString( lower, @"user" ) || fn StringContainsString( lower, @"staff" ) ) then exit fn = @"person.crop.circle"if ( fn StringContainsString( lower, @"order" ) || fn StringContainsString( lower, @"invoice" ) || fn StringContainsString( lower, @"sale" ) ) then exit fn = @"cart"if ( fn StringContainsString( lower, @"product" ) || fn StringContainsString( lower, @"stock" ) || fn StringContainsString( lower, @"inventory" ) ) then exit fn = @"shippingbox"if ( fn StringContainsString( lower, @"categor" ) || fn StringContainsString( lower, @"type" ) || fn StringContainsString( lower, @"group" ) ) then exit fn = @"folder"if ( fn StringContainsString( lower, @"supplier" ) || fn StringContainsString( lower, @"vendor" ) || fn StringContainsString( lower, @"shipper" ) ) then exit fn = @"truck.box"if ( fn StringContainsString( lower, @"region" ) || fn StringContainsString( lower, @"territor" ) || fn StringContainsString( lower, @"location" ) || fn StringContainsString( lower, @"address" ) ) then exit fn = @"map"if ( fn StringContainsString( lower, @"payment" ) || fn StringContainsString( lower, @"account" ) ) then exit fn = @"creditcard"end fn = @"tablecells"// the entity's icon: the designer's choice (its "design" icon), else the recommendationlocal fn TypeMapEntityIcon( entityName as CFStringRef, resource as CFDictionaryRef ) as CFStringRefCFDictionaryRef design = fn DictionaryObjectForKey( resource, @"design" )CFStringRef     icon = NULLif ( design != NULL ) then icon = fn DictionaryObjectForKey( design, @"icon" )if ( icon != NULL ) then if ( fn StringLength( icon ) > 0 ) then exit fn = iconend fn = fn TypeMapRecommendedIcon( entityName )