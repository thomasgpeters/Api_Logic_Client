/* *   I M A G E R Y    B U S I N E S S     S Y S T E M S,   L L C * *   Branding.incl - the product's name and the Imagery logo * *   The logos are the canonical Imagery files (imagery_logo.png: colour text for light *   backgrounds, imagery_logo_white.png: white text for dark ones), bundled as resources. *   ImageryLogo is one image that draws whichever suits the current appearance, so it *   follows the Mac between light and dark mode by itself. */#define APP_DISPLAY_NAME @"Imagery LogicBank Studio for FutureBasic"_welcomeLogoImage = 103                // WelcomeView.xib_createLogoImage  = 104                // ProjectCreateView.xiblocal fn ImageryLogo as ImageRefcln NSImage *light = [NSImage imageNamed:@"imagery_logo"]; NSImage *dark = [NSImage imageNamed:@"imagery_logo_white"]; if ( light == nil ) return NULL; NSImage *logo = [NSImage imageWithSize:light.size flipped:NO drawingHandler:^BOOL( NSRect r ) { NSAppearance *a = NSAppearance.currentAppearance; if ( @available( macOS 11.0, * ) ) a = NSAppearance.currentDrawingAppearance; BOOL isDark = [[a bestMatchFromAppearancesWithNames:@[ NSAppearanceNameAqua, NSAppearanceNameDarkAqua ]] isEqualToString:NSAppearanceNameDarkAqua]; [( isDark && dark != nil ? dark : light ) drawInRect:r]; return YES; }]; return (__bridge void *)logo;end fn = NULL// the logo on the Welcome view and the server formvoid local fn ApplyBrandingImageRef logo = fn ImageryLogoif ( logo == NULL )if (isLoggingOn) then NSLog( @"imagery_logo.png is not in the app bundle - check resources in the FB project." )exit fnend ifImageViewSetImage( _welcomeLogoImage, logo )ImageViewSetImage( _createLogoImage, logo )end fn