// the page area beside the entity list, below the heading: every page view fills it// and stretches with the window (its XIB's autoresizing masks place its controls)local fn PageFrame as CGRectCGRect content = fn ViewBounds( _windowContentViewTag )CGFloat x = _tableViewWidth + ( _controlSpacer * 2 )end fn = fn CGRectMake( x, _controlSpacer, content.size.width - x - _controlSpacer, content.size.height - _controlSpacer - _pageHeadingHeight )void local fn FitPageView( viewTag as long )ViewSetFrame( viewTag, fn PageFrame )ViewSetAutoresizingMask( viewTag, NSViewWidthSizable + NSViewHeightSizable )end fnvoid local fn BuildSubViewsCGRect rnibview _welcomeView, 		   @"WelcomeView",,  				( _tableViewWidth + (_controlSpacer * 2), _mainWindowHeight - _welcomeViewHeight - ( _controlSpacer * 2) )nibview _projectCreateView,	 @"ProjectCreateView",,		( _tableViewWidth + (_controlSpacer * 2), _mainWindowHeight - _projectCreateViewHeight - ( _controlSpacer * 2) )nibview _projectDetailView,	 @"ProjectDetailView",,		( _tableViewWidth + (_controlSpacer * 2), _mainWindowHeight - _projectDetailViewHeight - ( _controlSpacer * 2) )nibview _newProjectView, 	 @"NewProjectView",,			( _tableViewWidth + (_controlSpacer * 2), _mainWindowHeight - _welcomeViewHeight - ( _controlSpacer * 2) )nibview _projectSettingsView, @"ProjectSettingsView",,	( _tableViewWidth + (_controlSpacer * 2), _mainWindowHeight - _welcomeViewHeight - ( _controlSpacer * 2) )// Init Toolbar and Viewsnibtoolbar _mainToolbar, @"Toolbar"WindowSetToolbar( _window, _mainToolbar )// every page fills the area beside the entity list and resizes with the windowfn FitPageView( _welcomeView )fn FitPageView( _projectCreateView )fn FitPageView( _projectDetailView )fn FitPageView( _newProjectView )fn FitPageView( _projectSettingsView )   // after the toolbar: it changes the content area// the design row of the entity view, under its summary (Project Actions.incl): the selected// attribute's control, the entity's Form layout, the entity's icon and its previewr = fn ViewBounds( _projectDetailView )// the Control popup's items are rebuilt for each attribute, so the first one names the recommendationpopupbutton _controlPopup, NO, 0, @[ @"Control: choose an attribute" ], fn CGRectMake( 12, r.size.height - 78, 230, 28 ), NO, _windowViewAddSubview( _projectDetailView, _controlPopup )ViewSetAutoresizingMask( _controlPopup, NSViewMaxXMargin + NSViewMinYMargin )ViewSetToolTip( _controlPopup, @"The control the selected attribute has on the generated Form." )popupbutton _formColumnsPopup, YES, 0, @[ @"Form: automatic", @"Form: 1 column", @"Form: 2 columns", @"Form: 3 columns" ], fn CGRectMake( 252, r.size.height - 78, 170, 28 ), NO, _windowViewAddSubview( _projectDetailView, _formColumnsPopup )ViewSetAutoresizingMask( _formColumnsPopup, NSViewMaxXMargin + NSViewMinYMargin )ViewSetToolTip( _formColumnsPopup, @"How many columns of fields the generated Form has. Automatic: 1 up to 10 fields, 2 up to 24, then 3." )imageview _entityIconPreview, YES, NULL, fn CGRectMake( 436, r.size.height - 74, 22, 22 ), NSImageScaleProportionallyUpOrDown, , , _windowViewAddSubview( _projectDetailView, _entityIconPreview )ViewSetAutoresizingMask( _entityIconPreview, NSViewMaxXMargin + NSViewMinYMargin )popupbutton _entityIconPopup, YES, 0, @[ @"Icon" ], fn CGRectMake( 464, r.size.height - 78, 230, 28 ), NO, _windowViewAddSubview( _projectDetailView, _entityIconPopup )ViewSetAutoresizingMask( _entityIconPopup, NSViewMaxXMargin + NSViewMinYMargin )ViewSetToolTip( _entityIconPopup, @"The entity's icon on its button in the generated app's navigation bar (an SF Symbol)." )// set hiddenViewSetHidden( _welcomeView, NO )ViewSetHidden( _projectCreateView, YES )ViewSetHidden( _projectDetailView, YES )ViewSetHidden( _projectSettingsView, YES )ViewSetHidden( _newProjectView, YES )fn ApplyBranding                                            // the Imagery logo (Branding.incl)fn ProjectSettingsSetUp                                     // the logo well takes paste and dropfn RecentProjectsShow                                       // Welcome view: Recent ProjectsWindowMakeFirstResponder( _window, _createProjectCreateBtn )end fnvoid local fn BuildWindownibwindow _window, @"MainWindow"WindowSetContentMinSize( _window, fn CGSizeMake( _minWindowWidth, _minWindowHeight ) )WindowCenter( _window )fn TableViewSetCustomCellCallback( _objectTableView, @[ID_KEY,OBJECT_KEY], @fn MyCustomCellCallback, NULL )fn TableViewSizeLastColumnToFit( _objectTableView )ViewSetAutoresizesSubviews( _windowContentViewTag, YES )   // View* functions take a view tag, not the window tagend fn