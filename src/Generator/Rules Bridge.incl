/* *   I M A G E R Y    B U S I N E S S     S Y S T E M S,   L L C * *   Rules Bridge.incl - runs tools/rules_bridge.py (bundled with the generator) * *   The project's business rules are kept in <project>/Rules.json.  The bridge *   (Python - it parses ApiLogicServer's declare_logic.py with Python's own parser) *       imports  declare_logic.py -> Rules.json   (Model > Import Rules...) *       exports  Rules.json -> declare_logic.py   (Model > Export Rules...) *       generates FBapp/Studio Rules.incl         (Generate App) *   It runs with /usr/bin/python3, which Xcode's command-line tools install - FutureBasic *   needs them to compile, so every Mac that builds FB has it. */#define RULES_FILE_NAME        @"Rules.json"#define STUDIO_RULES_FILE_NAME @"Studio Rules.incl"#define RULES_PYTHON_PATH      @"/usr/bin/python3"begin globalsStringRef gRulesBridgeOutput           // what the last run printed (JSON on success, the error otherwise)end globalslocal fn RulesFileURL as URLRefend fn = fn URLByAppendingPathComponent( fn ProjectFolderURL, RULES_FILE_NAME )// the project's model for the bridge: its own copy of the SQLite databaselocal fn RulesModelPath as StringRefStringRef source = fn DictionaryObjectForKey( gProjectDictionary, @"source" )if ( source == NULL ) then exit fn = @""end fn = source/* *   Run rules_bridge.py with arguments; YES when it exited with status 0.  Its output *   (stdout and stderr) is kept in gRulesBridgeOutput for the message to the user. */local fn RulesBridgeRun( arguments as ArrayRef ) as BOOLURLRef            scriptURLTaskRef           bridgeTaskPipeRef           outputPipeMutableArrayRef   taskArgumentsDataRef           outputDatagRulesBridgeOutput = @""scriptURL = fn BundleURLForResource( fn BundleMain, @"rules_bridge", @"py", @"tools" )if ( scriptURL == NULL )gRulesBridgeOutput = @"tools/rules_bridge.py is not in the app bundle - check resources \"../../tools\" in the FB project."NSLog( @"%@", gRulesBridgeOutput )exit fn = NOend ifif ( fn FileManagerFileExistsAtURL( fn URLFileURLWithPath( RULES_PYTHON_PATH ) ) == NO )gRulesBridgeOutput = @"python3 is missing - install Xcode's command-line tools (xcode-select --install)."exit fn = NOend iftaskArguments = fn MutableArrayWithObject( fn URLPath( scriptURL ) )MutableArrayAddObjectsFromArray( taskArguments, arguments )bridgeTask = fn TaskInitTaskSetExecutableURL( bridgeTask, fn URLFileURLWithPath( RULES_PYTHON_PATH ) )TaskSetArguments( bridgeTask, taskArguments )outputPipe = fn PipeInitTaskSetStandardOutput( bridgeTask, outputPipe )TaskSetStandardError( bridgeTask, outputPipe )if ( fn TaskLaunch( bridgeTask, NULL ) == NO )gRulesBridgeOutput = @"Could not start python3."exit fn = NOend ifoutputData = fn FileHandleReadDataToEndOfFile( fn PipeFileHandleForReading( outputPipe ), NULL )TaskWaitUntilExit( bridgeTask )if ( outputData != NULL ) then gRulesBridgeOutput = fn StringWithData( outputData, NSUTF8StringEncoding )if (isLoggingOn) then NSLog( @"rules_bridge %@ -> %ld\n%@", arguments, fn TaskTerminationStatus( bridgeTask ), gRulesBridgeOutput )end fn = ( fn TaskTerminationStatus( bridgeTask ) == 0 )// a field of the bridge's JSON report (NULL when the output is not JSON)local fn RulesBridgeReport( key as StringRef ) as CFTypeRefCFTypeRef report = NULLDataRef   reportDataif ( gRulesBridgeOutput == NULL ) then exit fn = NULLreportData = fn StringData( gRulesBridgeOutput, NSUTF8StringEncoding )if ( reportData != NULL ) then report = fn JSONSerializationJSONObjectWithData( reportData, 0, NULL )if ( report == NULL ) then exit fn = NULLend fn = fn DictionaryObjectForKey( report, key )/* *   FBapp/Studio Rules.incl: generated from Rules.json when the project has one; otherwise *   an empty DeclareStudioRules, so the generated project always builds. */local fn RulesGenerateStudioRules( appFolderURL as URLRef ) as BOOLURLRef outURL = fn URLByAppendingPathComponent( appFolderURL, STUDIO_RULES_FILE_NAME )if ( fn FileManagerFileExistsAtURL( fn RulesFileURL ) == NO )fn StringWriteToURL( @"// Studio Rules.incl - the project has no Rules.json yet.\r\rvoid local fn DeclareStudioRules\rend fn\r", outURL, YES, NSUTF8StringEncoding, NULL )exit fn = YESend ifif ( fn RulesBridgeRun( @[ @"generate", @"--rules", fn URLPath( fn RulesFileURL ), @"--model", fn RulesModelPath, @"--out", fn URLPath( outURL ) ] ) ) then exit fn = YESalert 1, NSAlertStyleWarning, @"The business rules were not generated.", gRulesBridgeOutput, @[@"OK"], NOend fn = NO// Model > Import Rules from declare_logic.py...void local fn RulesImportURLRef    logicURLArrayRef  notesStringRef summaryif ( fn DictionaryObjectForKey( gProjectDictionary, @"resources" ) == NULL )alert 1, NSAlertStyleInformational, @"No project is open.", @"Open a project or a model first.", @[@"OK"], NOexit fnend iflogicURL = openpanel 1, @"Choose an ApiLogicServer project's logic/declare_logic.py", @"py"if ( logicURL == NULL ) then exit fnif ( fn RulesBridgeRun( @[ @"import", fn URLPath( logicURL ), @"--model", fn RulesModelPath, @"--rules", fn URLPath( fn RulesFileURL ) ] ) == NO )alert 1, NSAlertStyleWarning, @"The rules could not be imported.", gRulesBridgeOutput, @[@"OK"], NOexit fnend ifnotes = fn RulesBridgeReport( @"notes" )summary = fn StringWithFormat( @"%@ rules imported into Rules.json; %@ switched off because they need rewriting in FB (their Python is kept beside them).", fn RulesBridgeReport( @"imported" ), fn RulesBridgeReport( @"switchedOff" ) )if ( notes != NULL && isLoggingOn ) then NSLog( @"Rules switched off: %@", notes )alert 1, NSAlertStyleInformational, @"Rules imported.", summary, @[@"OK"], NOend fn// Model > Export Rules to declare_logic.py...void local fn RulesExportURLRef outURLif ( fn FileManagerFileExistsAtURL( fn RulesFileURL ) == NO )alert 1, NSAlertStyleInformational, @"The project has no rules yet.", @"Import rules, or add them on the Rules page.", @[@"OK"], NOexit fnend ifoutURL = savepanel 1, @"Export the project's rules as LogicBank rules", @"py", @"declare_logic.py", @"Export"if ( outURL == NULL ) then exit fnif ( fn RulesBridgeRun( @[ @"export", @"--rules", fn URLPath( fn RulesFileURL ), @"--model", fn RulesModelPath, @"--out", fn URLPath( outURL ) ] ) == NO )alert 1, NSAlertStyleWarning, @"The rules could not be exported.", gRulesBridgeOutput, @[@"OK"], NOexit fnend ifalert 1, NSAlertStyleInformational, @"Rules exported.", fn URLPath( outURL ), @[@"OK"], NOend fn