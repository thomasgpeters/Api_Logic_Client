/* *   I M A G E R Y    B U S I N E S S     S Y S T E M S,   L L C * *   Rules Bridge.incl - the project's business rules between the Studio and the app * *   The project's rules are kept in <project>/Rules.json.  The bridge *       imports  declare_logic.py -> Rules.json   (Model > Import Rules...) *       exports  Rules.json -> declare_logic.py   (Model > Export Rules...) *       generates FBapp/Studio Rules.incl         (Generate App) * *   No Python goes into the Studio or the apps it makes (author, 2026-11-24): the bridge is *   being rewritten in FutureBasic (BACKLOG: "Port tools/rules_bridge.py").  Until then this *   file keeps the commands and says so, and Generate App writes an empty DeclareStudioRules *   so the app always builds; the app's own rules go in Rules.incl (DeclareRules). *   tools/rules_bridge.py in the repository is the reference for the port, and a test. */#define RULES_FILE_NAME        @"Rules.json"#define STUDIO_RULES_FILE_NAME @"Studio Rules.incl"local fn RulesFileURL as CFURLRefend fn = fn URLByAppendingPathComponent( fn ProjectFolderURL, RULES_FILE_NAME )/* *   FBapp/Studio Rules.incl: an empty DeclareStudioRules, so the generated project always *   builds.  A project with a Rules.json is told that those rules are not in the app yet. */local fn RulesGenerateStudioRules( appFolderURL as CFURLRef ) as BOOLCFURLRef outURL = fn URLByAppendingPathComponent( appFolderURL, STUDIO_RULES_FILE_NAME )fn StringWriteToURL( @"// Studio Rules.incl - the rules kept in the Studio (Rules.json) are written here once\r// the rules bridge is in FutureBasic.  Your own rules go in Rules.incl (DeclareRules).\r\rvoid local fn DeclareStudioRules\rend fn\r", outURL, YES, NSUTF8StringEncoding, NULL )if ( fn FileManagerFileExistsAtURL( fn RulesFileURL ) )alert 1, NSAlertStyleInformational, @"The project's Rules.json is not in the app yet.", @"Generating the app's rules from Rules.json is being rewritten in FutureBasic. Meanwhile, write the app's rules in Rules.incl (DeclareRules).", @[@"OK"], NOend ifend fn = YES// Model > Import Rules from declare_logic.py...void local fn RulesImportalert 1, NSAlertStyleInformational, @"Import Rules is coming.", @"Reading an API Logic Server's declare_logic.py is being rewritten in FutureBasic.", @[@"OK"], NOend fn// Model > Export Rules to declare_logic.py...void local fn RulesExportalert 1, NSAlertStyleInformational, @"Export Rules is coming.", @"Writing declare_logic.py for an API Logic Server is being rewritten in FutureBasic.", @[@"OK"], NOend fn