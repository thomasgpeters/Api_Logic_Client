/* *   I M A G E R Y    B U S I N E S S     S Y S T E M S,   L L C * *   SQLite Access * *   Minimal SQLite 3 access for Api Logic Client, declared here against the *   public SQLite C API (SQLite itself is in the public domain). Only what the *   generator needs: open read-only, prepare, step, read columns, finalize, close. * *   Link with -lsqlite3 (Build Settings > Compiler options). */BeginCDeclaration#include <sqlite3.h>EndC_sqliteOK   = 0_sqliteROW  = 100_sqliteDONE = 101// db receives the connection handle: pass @myDb (a ptr variable)local fn SQLiteOpenReadOnly( path as CFStringRef, db as ptr ) as longcln return sqlite3_open_v2( [(__bridge NSString *)path UTF8String], (sqlite3 **)db, SQLITE_OPEN_READONLY, NULL );end fn = 0local fn SQLiteClose( db as ptr ) as longcln return sqlite3_close( (sqlite3 *)db );end fn = 0local fn SQLiteErrorMessage( db as ptr ) as CFStringRefcln return (__bridge CFStringRef)[NSString stringWithUTF8String:sqlite3_errmsg( (sqlite3 *)db )];end fn = NULL// stmt receives the statement handle: pass @myStatement (a ptr variable)local fn SQLitePrepare( db as ptr, sql as CFStringRef, stmt as ptr ) as longcln return sqlite3_prepare_v2( (sqlite3 *)db, [(__bridge NSString *)sql UTF8String], -1, (sqlite3_stmt **)stmt, NULL );end fn = 0local fn SQLiteStep( stmt as ptr ) as longcln return sqlite3_step( (sqlite3_stmt *)stmt );end fn = 0local fn SQLiteFinalize( stmt as ptr ) as longcln return sqlite3_finalize( (sqlite3_stmt *)stmt );end fn = 0// column text of the current row; SQL NULL reads as an empty stringlocal fn SQLiteColumnText( stmt as ptr, col as long ) as CFStringRefcln const unsigned char *textValue = sqlite3_column_text( (sqlite3_stmt *)stmt, (int)col ); return textValue ? (__bridge CFStringRef)[NSString stringWithUTF8String:(const char *)textValue] : CFSTR("");end fn = NULL// a string literal for SQL: 'O''Brien'local fn SQLiteQuoteLiteral( value as CFStringRef ) as CFStringRefend fn = fn StringWithFormat( @"'%@'", fn StringByReplacingOccurrencesOfString( value, @"'", @"''" ) )// every row of a query as an array of column strings (columnCount columns per row)local fn SQLiteQueryRows( db as ptr, sql as CFStringRef, columnCount as long ) as CFMutableArrayRefCFMutableArrayRef rows = fn MutableArrayNewCFMutableArrayRef rowptr               statement = NULLlong              colif ( fn SQLitePrepare( db, sql, @statement ) != _sqliteOK )if (isLoggingOn) then NSLog( @"SQLite prepare failed: %@\nSQL: %@", fn SQLiteErrorMessage( db ), sql )exit fn = rowsend ifwhile ( fn SQLiteStep( statement ) == _sqliteROW )row = fn MutableArrayNewfor col = 0 to columnCount - 1MutableArrayAddObject( row, fn SQLiteColumnText( statement, col ) )nextMutableArrayAddObject( rows, row )wendfn SQLiteFinalize( statement )end fn = rows