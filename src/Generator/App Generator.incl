/* *   I M A G E R Y    B U S I N E S S     S Y S T E M S,   L L C * *   App Generator * *   model -> a complete FutureBasic project in *   ~/Library/Application Support/Api_Logic_Client/workspace/<project>/ * *       <project>.fbeproj   the FB project: Settings2.plist (template) + data.fbproj (groups *                           Runtime, Model, Bindings, Resources, Controller, View, Main) *       <project>.main      main program: connection settings, handler registration, start *       EventHandlers.incl  starting templates - written only when missing, then the *       Menus.incl          developer's: event handlers, menus, and the window with *       Windows.incl        the nibview call for each entity's Form part *       Model.json          resources, fields, kinds and tags - read at run time by ALS App.incl *       Credits.rtf         the designer's About text - the standard About box shows it *       Model Tags.incl     tag constants for your own code *       <Entity> Binding.incl  record <-> Form / List code per entity (Binding Generator.incl) *       <Resource>List.xib  list part per resource: table, one column per attribute *       <Resource>Form.xib  scalar part per resource: the record's fields (XIB Generator.incl) *       Data SQLite / DataObject / Data Model / Data Records   the data runtime: SQLite, *                           the query builder, Model.json entities, records (copied from ../Runtime) *       Logic Rules / Logic Row / Logic Engine   LogicBank for FutureBasic (copied from ../Runtime) *       Rules.incl          the app's business rules - starting template, written only when missing *       ALS Client.incl     ALS JSON:API client         \ *       ALS Binding.incl    record <-> control binding   >  runtime, copied from ../Runtime via this app's bundle *       ALS App.incl        master-detail window/events / * *   The generated project contains only our own code; it relies on the user's *   FutureBasic install for the Cocoa toolboxes, which are never copied. */#define APP_DEFAULT_LOGIN_PATH  @"/api/auth/login"#define APP_FALLBACK_LOGIN_PATH @"/api/authentication-User/login"#define APP_DEFAULT_PAGE_LIMIT  100// FB source files use classic-Mac line endingslocal fn AppWriteSource( source as CFStringRef, folderURL as CFURLRef, fileName as CFStringRef ) as BOOLErrorRef err = NULLCFURLRef url = fn URLByAppendingPathComponent( folderURL, fileName )BOOL     ok  = fn StringWriteToURL( fn StringByReplacingOccurrencesOfString( source, @"\n", @"\r" ), url, YES, NSUTF8StringEncoding, @err )if ( ok == NO && isLoggingOn ) then NSLog( @"Could not write %@: %@", fn URLPath( url ), fn ErrorLocalizedDescription( err ) )end fn = ok// text safe to place inside an FB @"..." literallocal fn AppQuote( s as CFStringRef ) as CFStringRefif ( s == NULL ) then exit fn = @""s = fn StringByReplacingOccurrencesOfString( s, @"\\", @"\\\\" )end fn = fn StringByReplacingOccurrencesOfString( s, @"\"", @"\\\"" )// the runtime copied into every generated app, in build order (data runtime first)local fn AppRuntimeFiles as CFArrayRefend fn = @[ @"Data SQLite.incl", @"DataObject.glbl", @"DataObject_Super.incl", @"DataObject.incl", @"Data Model.incl", @"Data Records.incl", @"Logic Rules.incl", @"Logic Row.incl", @"Logic Engine.incl", @"App Shell.incl", @"Binding Support.incl", @"ALS Client.incl", @"ALS Binding.incl", @"ALS App.incl" ]local fn AppCopyRuntimeFile( fileName as CFStringRef, folderURL as CFURLRef ) as BOOLCFURLRef srcURL, dstURLsrcURL = fn BundleURLForResource( fn BundleMain, fn StringByDeletingPathExtension( fileName ), fn StringPathExtension( fileName ), @"Runtime" )   // the bundled Runtime folderif ( srcURL == NULL )if (isLoggingOn) then NSLog( @"Runtime/%@ is not in the app bundle - check resources \"../Runtime\" in the FB project.", fileName )exit fn = NOend ifdstURL = fn URLByAppendingPathComponent( folderURL, fileName )if ( fn FileManagerFileExistsAtURL( dstURL ) ) then fn FileManagerRemoveItemAtURL( dstURL )if ( fn FileManagerCopyItemAtURL( srcURL, dstURL ) == NO )if (isLoggingOn) then NSLog( @"Could not copy %@ to %@", fileName, fn URLPath( dstURL ) )exit fn = NOend ifend fn = YES// starting template from the bundled Templates folder - copied only when missing,// so the developer's edits survive regenerationlocal fn AppCopyTemplateFile( subfolder as CFStringRef, fileName as CFStringRef, dstFolderURL as CFURLRef ) as BOOLCFURLRef srcURL, dstURLdstURL = fn URLByAppendingPathComponent( dstFolderURL, fileName )if ( fn FileManagerFileExistsAtURL( dstURL ) ) then exit fn = YESsrcURL = fn BundleURLForResource( fn BundleMain, fn StringByDeletingPathExtension( fileName ), fn StringPathExtension( fileName ), fn StringWithFormat( @"Templates/%@", subfolder ) )if ( srcURL == NULL )if (isLoggingOn) then NSLog( @"Templates/%@/%@ is not in the app bundle - check resources \"../Templates\" in the FB project.", subfolder, fileName )exit fn = NOend ifif ( fn FileManagerCopyItemAtURL( srcURL, dstURL ) == NO )if (isLoggingOn) then NSLog( @"Could not copy %@ to %@", fileName, fn URLPath( dstURL ) )exit fn = NOend ifend fn = YES// starting Windows.incl: the shell window plus a nibview per entity Form part -// written only when missing (the runtime loads any part this file leaves out)local fn AppWindowsSource( modelResources as CFArrayRef, hasDatabase as BOOL ) as CFStringRefCFMutableStringRef s = fn MutableStringNewCFDictionaryRef    resourceCFStringRef        prefixif ( hasDatabase )MutableStringAppendString( s, @"/*\n *   Windows.incl - the app's window\n *\n" )MutableStringAppendString( s, @" *   Starting template from Imagery LogicBank Studio for FutureBasic: created once, then\n" )MutableStringAppendString( s, @" *   yours.  Regeneration never overwrites it (delete it to get a fresh copy).\n *\n" )MutableStringAppendString( s, @" *   Developer notes\n" )MutableStringAppendString( s, @" *   - The window has the common look of every generated app (App Shell.incl): the\n" )MutableStringAppendString( s, @" *     navigation bar, the header with the logo, the app name, the theme menu and Log In,\n" )MutableStringAppendString( s, @" *     and the footer.  Its colours come from Theme.incl.\n" )MutableStringAppendString( s, @" *   - App Pages.incl (regenerated) adds a page per entity.  Add pages of your own here,\n" )MutableStringAppendString( s, @" *     after AppPagesBuild: load a XIB into the content view, then add its button:\n" )MutableStringAppendString( s, @" *         nibview _myView, @\"MyView\", , ( 0, 0 ), _shellContent\n" )MutableStringAppendString( s, @" *         fn ShellAddNavItem( @\"Reports\", @\"chart.bar\", @[ fn NumberWithInteger( _myView ) ] )\n */\n\n" )MutableStringAppendString( s, @"void local fn BuildWindows( title as CFStringRef )\n" )MutableStringAppendString( s, @"fn ApplyTheme                                           // Theme.incl: the colours\n" )MutableStringAppendString( s, @"fn ShellBuildWindow( title, APP_TAGLINE, APP_COPYRIGHT ) // App Shell.incl: navigation, header, footer\n" )MutableStringAppendString( s, @"fn AppPagesBuild                                        // App Pages.incl: a page per entity\n" )MutableStringAppendString( s, @"fn ShellShowPage( 0 )                                   // start on the first page\n" )MutableStringAppendString( s, @"end fn\n" )exit fn = send ifMutableStringAppendString( s, @"/*\n *   Windows.incl\n *\n" )MutableStringAppendString( s, @" *   Starting template from Imagery LogicBank Studio for FutureBasic: created once, then yours.\n" )MutableStringAppendString( s, @" *   Regeneration never overwrites it (delete it to get a fresh copy).\n" )MutableStringAppendString( s, @" *   Entity parts added to the model later are loaded by the runtime.\n */\n\n" )MutableStringAppendString( s, @"void local fn BuildWindows( title as CFStringRef )\n" )MutableStringAppendString( s, @"long x = fn ALSPartX\n\n" )MutableStringAppendString( s, @"// the shell: login bar, entity list, buttons, status\n" )MutableStringAppendString( s, @"fn ALSBuildWindow( title )\n\n" )MutableStringAppendString( s, @"// each entity's Form part, from its generated XIB - hidden until the entity is selected\n" )for resource in modelResourcesprefix = fn XibResourcePrefix( fn DictionaryObjectForKey( resource, @"name" ) )MutableStringAppendString( s, fn StringWithFormat( @"nibview _%@View, @\"%@\", , ( x, _alsButtonBarH )\n", prefix, fn DictionaryObjectForKey( resource, @"formNib" ) ) )MutableStringAppendString( s, fn StringWithFormat( @"ViewSetHidden( _%@View, YES )\n", prefix ) )nextMutableStringAppendString( s, @"end fn\n" )end fn = s// a generated source file only when missing - for starting templateslocal fn AppWriteSourceIfMissing( source as CFStringRef, folderURL as CFURLRef, fileName as CFStringRef ) as BOOLif ( fn FileManagerFileExistsAtURL( fn URLByAppendingPathComponent( folderURL, fileName ) ) ) then exit fn = YESend fn = fn AppWriteSource( source, folderURL, fileName )local fn AppWriteModel( modelResources as CFArrayRef, folderURL as CFURLRef, projectLabel as CFStringRef, about as CFStringRef, databasePath as CFStringRef ) as BOOLCFDataRef jsonErrorRef  err = NULLCFURLRef  url = fn URLByAppendingPathComponent( folderURL, @"Model.json" )// "database": the project's SQLite copy, opened by the data runtime (Data Records.incl: DataOpen)json = fn JSONSerializationDataWithJSONObject( @{ @"project":projectLabel, @"about":about, @"database":databasePath, @"resources":modelResources }, NSJSONWritingPrettyPrinted, @err )if ( json == NULL ) then exit fn = NOif ( fn DataWriteToURL( json, url, NSDataWritingAtomic, @err ) == NO )if (isLoggingOn) then NSLog( @"Could not write %@: %@", fn URLPath( url ), fn ErrorLocalizedDescription( err ) )exit fn = NOend ifend fn = YES// Credits.rtf - FB's About menu item opens the standard About box, which shows the// bundle's Credits.rtf under the app's name, icon and version.  No colour is set, so// the text follows light and dark mode.  No About text: no file.local fn AppWriteCredits( about as CFStringRef, folderURL as CFURLRef ) as BOOLCFURLRef  url = fn URLByAppendingPathComponent( folderURL, @"Credits.rtf" )CFDataRef rtfErrorRef  err = NULLif ( fn FileManagerFileExistsAtURL( url ) ) then fn FileManagerRemoveItemAtURL( url )if ( fn StringLength( about ) == 0 ) then exit fn = YESrtf = fn AttributedStringRTFFromRange( fn AttributedStringWithString( about ), fn CFRangeMake( 0, fn StringLength( about ) ), NULL )if ( rtf == NULL ) then exit fn = NOif ( fn DataWriteToURL( rtf, url, NSDataWritingAtomic, @err ) == NO )if (isLoggingOn) then NSLog( @"Could not write %@: %@", fn URLPath( url ), fn ErrorLocalizedDescription( err ) )exit fn = NOend ifend fn = YES// an SF Symbol for an entity's navigation button, from words in its namelocal fn AppNavSymbol( entityName as CFStringRef ) as CFStringRefCFStringRef lower = fn StringLowercaseString( entityName )if ( fn StringContainsString( lower, @"detail" ) || fn StringContainsString( lower, @"line" ) || fn StringContainsString( lower, @"item" ) ) then exit fn = @"list.bullet.rectangle"if ( fn StringContainsString( lower, @"customer" ) || fn StringContainsString( lower, @"client" ) || fn StringContainsString( lower, @"person" ) || fn StringContainsString( lower, @"contact" ) ) then exit fn = @"person.2"if ( fn StringContainsString( lower, @"employee" ) || fn StringContainsString( lower, @"user" ) || fn StringContainsString( lower, @"staff" ) ) then exit fn = @"person.crop.circle"if ( fn StringContainsString( lower, @"order" ) || fn StringContainsString( lower, @"invoice" ) || fn StringContainsString( lower, @"sale" ) ) then exit fn = @"cart"if ( fn StringContainsString( lower, @"product" ) || fn StringContainsString( lower, @"stock" ) || fn StringContainsString( lower, @"inventory" ) ) then exit fn = @"shippingbox"if ( fn StringContainsString( lower, @"categor" ) || fn StringContainsString( lower, @"type" ) || fn StringContainsString( lower, @"group" ) ) then exit fn = @"folder"if ( fn StringContainsString( lower, @"supplier" ) || fn StringContainsString( lower, @"vendor" ) || fn StringContainsString( lower, @"shipper" ) ) then exit fn = @"truck.box"if ( fn StringContainsString( lower, @"region" ) || fn StringContainsString( lower, @"territor" ) || fn StringContainsString( lower, @"location" ) || fn StringContainsString( lower, @"address" ) ) then exit fn = @"map"if ( fn StringContainsString( lower, @"payment" ) || fn StringContainsString( lower, @"account" ) ) then exit fn = @"creditcard"end fn = @"tablecells"/* *   App Pages.incl (regenerated): a page per entity in the app shell - its List part above *   its Form part - the navigation buttons, filling a List from the database when its page *   is shown, and showing the chosen row in the Form.  Written to be read: FB developers *   who open the generated project should understand it without this generator. */local fn AppPagesSource( modelResources as CFArrayRef, tagline as CFStringRef, copyright as CFStringRef ) as CFStringRefCFMutableStringRef s = fn MutableStringNewCFDictionaryRef    resourceCFStringRef        name, prefixlong               indexMutableStringAppendString( s, @"/*\n *   App Pages.incl - the app's pages: one per entity\n *\n" )MutableStringAppendString( s, @" *   Generated by Imagery LogicBank Studio for FutureBasic from the data model.\n" )MutableStringAppendString( s, @" *   Regenerating overwrites this file - put your own code in EventHandlers.incl,\n" )MutableStringAppendString( s, @" *   Windows.incl or files of your own.\n *\n" )MutableStringAppendString( s, @" *   Developer notes\n" )MutableStringAppendString( s, @" *   - Each page is two XIB parts loaded into the shell's content view with nibview\n" )MutableStringAppendString( s, @" *     (its last parameter, _shellContent, is the superview): the entity's List part on\n" )MutableStringAppendString( s, @" *     top, filling the space, and its Form part below.  The tags (_customerList,\n" )MutableStringAppendString( s, @" *     _customerView, ...) are named in Model Tags.incl.\n" )MutableStringAppendString( s, @" *   - ShellAddNavItem (App Shell.incl) adds the page's button to the navigation bar.\n" )MutableStringAppendString( s, @" *   - When a page is shown, AppPageShown reads the entity's records from the project's\n" )MutableStringAppendString( s, @" *     SQLite database (DataFetch, Data Records.incl) and puts them in the List\n" )MutableStringAppendString( s, @" *     (<Entity>RecordsToList, <Entity> Binding.incl).\n" )MutableStringAppendString( s, @" *   - Choosing a row shows that record in the Form (<Entity>RecordToForm).\n" )MutableStringAppendString( s, @" *   - Saving goes through the rules: fn LogicUpdate( @\"Customer\", fn CustomerFormToRecord, NULL ).\n */\n\n" )MutableStringAppendString( s, @"// the header's tag-line and the footer's copyright (Project Settings in the Studio)\n" )MutableStringAppendString( s, fn StringWithFormat( @"#define APP_TAGLINE   @\"%@\"\n", fn AppQuote( tagline ) ) )MutableStringAppendString( s, fn StringWithFormat( @"#define APP_COPYRIGHT @\"%@\"\n\n", fn AppQuote( copyright ) ) )MutableStringAppendString( s, @"begin globals\nMutableDictionaryRef gAppPageRecords     // entity name -> the records its List shows\nend globals\n\n\n" )// AppPageShownMutableStringAppendString( s, @"// a page was shown (App Shell.incl calls this): fill its List from the database\n" )MutableStringAppendString( s, @"void local fn AppPageShown( pageIndex as long )\nArrayRef records\n\n" )MutableStringAppendString( s, @"if ( gAppPageRecords == NULL ) then gAppPageRecords = fn MutableDictionaryNew\nselect ( pageIndex )\n" )index = 0for resource in modelResourcesname = fn DictionaryObjectForKey( resource, @"name" )MutableStringAppendString( s, fn StringWithFormat( @"case %ld   // %@\nrecords = fn DataFetch( @\"%@\", NULL, NULL )\n", index, name, name ) )MutableStringAppendString( s, fn StringWithFormat( @"MutableDictionarySetObjectForKey( gAppPageRecords, records, @\"%@\" )\nfn %@RecordsToList( records )\n", name, name ) )index++nextMutableStringAppendString( s, @"end select\nend fn\n\n\n" )// AppPagesBuildMutableStringAppendString( s, @"// the pages: each entity's List and Form parts in the content view, and its button\n" )MutableStringAppendString( s, @"void local fn AppPagesBuild\nCGRect  content = fn ShellContentBounds      // the content view, origin at its bottom left\nCGFloat listY\n\n" )for resource in modelResourcesname   = fn DictionaryObjectForKey( resource, @"name" )prefix = fn XibResourcePrefix( name )MutableStringAppendString( s, fn StringWithFormat( @"// %@: the Form at the bottom, the List above it, filling the rest\n", name ) )MutableStringAppendString( s, fn StringWithFormat( @"listY = _%@ViewHeight + 12\n", prefix ) )MutableStringAppendString( s, fn StringWithFormat( @"nibview _%@View, @\"%@\", , ( 0, 0 ), _shellContent\n", prefix, fn DictionaryObjectForKey( resource, @"formNib" ) ) )MutableStringAppendString( s, fn StringWithFormat( @"nibview _%@List, @\"%@\", , ( 0, listY ), _shellContent\n", prefix, fn DictionaryObjectForKey( resource, @"listNib" ) ) )MutableStringAppendString( s, fn StringWithFormat( @"ViewSetFrame( _%@List, fn CGRectMake( 0, listY, content.size.width, content.size.height - listY ) )\n", prefix ) )MutableStringAppendString( s, fn StringWithFormat( @"ViewSetAutoresizingMask( _%@List, NSViewWidthSizable + NSViewHeightSizable )\n", prefix ) )MutableStringAppendString( s, fn StringWithFormat( @"fn ShellAddNavItem( @\"%@\", @\"%@\", @[ fn NumberWithInteger( _%@List ), fn NumberWithInteger( _%@View ) ] )\n\n", fn AppQuote( fn TypeMapDefaultTitle( name ) ), fn AppNavSymbol( name ), prefix, prefix ) )nextMutableStringAppendString( s, @"fn ShellSetPageShownHandler( @fn AppPageShown )\nend fn\n\n\n" )// AppPagesDoDialogMutableStringAppendString( s, @"// a row chosen in a List: show that record in its Form.  YES when the event was a page's.\n" )MutableStringAppendString( s, @"local fn AppPagesDoDialog( ev as long, tag as long, wnd as long ) as BOOL\nlong row\n\n" )MutableStringAppendString( s, @"if ( ev != _tableViewSelectionDidChange || gAppPageRecords == NULL ) then exit fn = NO\nrow = fn TableViewSelectedRow( tag )\nselect ( tag )\n" )for resource in modelResourcesname   = fn DictionaryObjectForKey( resource, @"name" )prefix = fn XibResourcePrefix( name )MutableStringAppendString( s, fn StringWithFormat( @"case _%@ListTable\n", prefix ) )MutableStringAppendString( s, fn StringWithFormat( @"if ( row >= 0 ) then fn %@RecordToForm( fn ArrayObjectAtIndex( fn DictionaryObjectForKey( gAppPageRecords, @\"%@\" ), row ) )\nexit fn = YES\n", name, name ) )nextMutableStringAppendString( s, @"end select\nend fn = NO\n" )end fn = s/* *   README.md in the generated project (regenerated): a developer's tour - which file does *   what, which are regenerated and which are yours, how a save and the rules work. */local fn AppDeveloperReadme( projectLabel as CFStringRef, hasDatabase as BOOL ) as CFStringRefCFMutableStringRef s = fn MutableStringNewMutableStringAppendString( s, fn StringWithFormat( @"# %@ - developer notes\n\n", projectLabel ) )MutableStringAppendString( s, @"A native Mac app in FutureBasic, generated by Imagery LogicBank Studio for FutureBasic\n" )MutableStringAppendString( s, @"from a data model. Open `" )MutableStringAppendString( s, fn StringWithFormat( @"%@.fbeproj` in FutureBasic and build it.\n\n", projectLabel ) )MutableStringAppendString( s, @"## How it starts\n\n`" )MutableStringAppendString( s, fn StringWithFormat( @"%@.main` registers the event handlers, opens the project's SQLite database\n", projectLabel ) )MutableStringAppendString( s, @"(`DataOpen`), declares the business rules (`DeclareStudioRules`, `DeclareRules`), activates them\n" )MutableStringAppendString( s, @"(`LogicActivate`), builds the menus and the window, and runs FutureBasic's event loop.\n\n" )MutableStringAppendString( s, @"## The files, by group\n\n| Group | File | Regenerated? | What it does |\n|---|---|---|---|\n" )MutableStringAppendString( s, @"| Runtime | `Data SQLite.incl` | yes | SQLite: open, statements, values, transactions (`DataBegin` / `DataEnd`) |\n" )MutableStringAppendString( s, @"| | `DataObject*.incl/.glbl` | yes | the query builder: SQL from a description of the statement |\n" )MutableStringAppendString( s, @"| | `Data Model.incl`, `Data Records.incl` | yes | the entities (`Model.json`); records: `DataFetch`, `DataParent`, `DataChildren`, `DataInsert`, ... |\n" )MutableStringAppendString( s, @"| | `Logic Rules.incl`, `Logic Row.incl`, `Logic Engine.incl` | yes | LogicBank for FutureBasic: rules declared once, enforced on every save |\n" )MutableStringAppendString( s, @"| | `App Shell.incl` | yes | the window's frame: navigation bar, header, footer, pages, theme menu |\n" )MutableStringAppendString( s, @"| | `ALS *.incl`, `Binding Support.incl` | yes | the API Logic Server client and binding helpers |\n" )MutableStringAppendString( s, @"| Model | `Model Tags.incl` | yes | a named constant for every view and control tag |\n" )MutableStringAppendString( s, @"| Bindings | `<Entity> Binding.incl` | yes | record -> Form, Form -> record, records -> List |\n" )MutableStringAppendString( s, @"| Pages | `App Pages.incl` | yes | a page per entity: its List and Form parts, its navigation button |\n" )MutableStringAppendString( s, @"| Resources | `<Entity>Form.xib`, `<Entity>List.xib`, `Model.json`, `Credits.rtf`, `AppLogo.png` | yes | the screens (open them in Xcode), the model, the About text, the logo |\n" )MutableStringAppendString( s, @"| Rules | `Studio Rules.incl` | yes | the rules kept in the Studio (Rules.json) |\n" )MutableStringAppendString( s, @"| | `Rules.incl` | **yours** | your own rules, in `DeclareRules` |\n" )MutableStringAppendString( s, @"| Controller | `EventHandlers.incl` | **yours** | what happens on clicks, menus and app events |\n" )MutableStringAppendString( s, @"| View | `Theme.incl` | **yours** | the colours (`ApplyTheme`) |\n" )MutableStringAppendString( s, @"| | `Menus.incl`, `Windows.incl` | **yours** | the menus; the window and its pages |\n" )MutableStringAppendString( s, @"| Main | `" )MutableStringAppendString( s, fn StringWithFormat( @"%@.main` | yes | start-up |\n\n", projectLabel ) )MutableStringAppendString( s, @"Files marked **yours** are written once and never overwritten; delete one to get a fresh copy\n" )MutableStringAppendString( s, @"the next time the app is generated. Change everything else in the Studio, which regenerates it.\n\n" )MutableStringAppendString( s, @"## Screens\n\nEach screen part is a XIB, loaded with FutureBasic's `nibview` (see FutureBasic's reference:\n" )MutableStringAppendString( s, @"`nibwindow`, `nibview`, `nibtoolbar`, `nibmenu`, `nibpopover`). `App Pages.incl` loads each entity's\n" )MutableStringAppendString( s, @"List and Form into the shell's content view (`nibview tag, name, , ( x, y ), _shellContent`).\n\n" )MutableStringAppendString( s, @"## Saving data\n\nSave through the rules, never with SQL of your own:\n\n```\n" )MutableStringAppendString( s, @"if ( fn LogicUpdate( @\"Customer\", fn CustomerFormToRecord, NULL ) == NO ) then alert 1, NSAlertStyleWarning, fn LogicMessage, @\"\", @[@\"OK\"], NO\n```\n\n" )MutableStringAppendString( s, @"Each save is one transaction: formulas, sums and counts, constraints and events run in order,\n" )MutableStringAppendString( s, @"and a refused save changes nothing. `LogicMessage` says why. With `isLoggingOn` the NSLog window\n" )MutableStringAppendString( s, @"shows every rule as it runs.\n\n" )MutableStringAppendString( s, @"## Coding rules\n\nTyped return values (`local fn X as Type`), `//` comments, CR line endings, view tags (not window\n" )MutableStringAppendString( s, @"tags) for `View...` functions. The generated code follows them; please keep to them in yours.\n" )if ( hasDatabase == NO ) then MutableStringAppendString( s, @"\nThis project talks to an API Logic Server: the window is built by `ALS App.incl`.\n" )end fn = slocal fn AppMainProgram( projectLabel as CFStringRef, modelResources as CFArrayRef, hostURL as CFStringRef, userName as CFStringRef, databasePath as CFStringRef ) as CFStringRefCFMutableStringRef s = fn MutableStringNewCFStringRef        securityOn = @"NO"if ( fn StringLength( userName ) > 0 ) then securityOn = @"YES"MutableStringAppendString( s, fn StringWithFormat( @"/*\n *   %@\n *\n", projectLabel ) )MutableStringAppendString( s, @" *   The start of the app.  Generated by Imagery LogicBank Studio for FutureBasic;\n" )MutableStringAppendString( s, @" *   regenerating overwrites it.  Your code goes in EventHandlers.incl, Menus.incl,\n" )MutableStringAppendString( s, @" *   Windows.incl, Theme.incl and Rules.incl, which are never overwritten.\n *\n" )MutableStringAppendString( s, @" *   Developer notes: README.md in this folder is a tour of the project.\n */\n\n" )MutableStringAppendString( s, @"\n// connection\n" )MutableStringAppendString( s, fn StringWithFormat( @"gALSHost              = @\"%@\"\n", fn AppQuote( hostURL ) ) )MutableStringAppendString( s, fn StringWithFormat( @"gALSLoginPath         = @\"%@\"   // stock ALS\n", APP_DEFAULT_LOGIN_PATH ) )MutableStringAppendString( s, fn StringWithFormat( @"gALSFallbackLoginPath = @\"%@\"   // tried when the first is not found\n", APP_FALLBACK_LOGIN_PATH ) )MutableStringAppendString( s, fn StringWithFormat( @"gALSUser              = @\"%@\"\n", fn AppQuote( userName ) ) )MutableStringAppendString( s, fn StringWithFormat( @"gALSSecurityOn        = %@\n", securityOn ) )MutableStringAppendString( s, fn StringWithFormat( @"gALSPageLimit         = %ld\n\n", (long)APP_DEFAULT_PAGE_LIMIT ) )MutableStringAppendString( s, @"isLoggingOn = YES                     // runtime trace in the NSLog window\n\n" )MutableStringAppendString( s, @"// handlers are in EventHandlers.incl\n" )MutableStringAppendString( s, @"on appevent fn DoAppEvent\n" )MutableStringAppendString( s, @"on menu fn DoMenu\n" )MutableStringAppendString( s, @"on dialog fn DoDialog\n\n" )if ( fn StringLength( databasePath ) > 0 )MutableStringAppendString( s, @"fn DataOpen( NULL )                    // the project's SQLite database (Model.json)\n" )MutableStringAppendString( s, @"fn DeclareStudioRules                  // Studio Rules.incl (generated from Rules.json)\n" )MutableStringAppendString( s, @"fn DeclareRules                        // Rules.incl (yours)\n" )MutableStringAppendString( s, @"fn LogicActivate                       // saves go through LogicInsert / LogicUpdate / LogicDelete\n" )end ifif ( fn StringLength( databasePath ) > 0 )MutableStringAppendString( s, @"\n// the window: the app shell with a page per entity\n" )MutableStringAppendString( s, @"fn BuildMenus                          // Menus.incl\n" )MutableStringAppendString( s, fn StringWithFormat( @"fn BuildWindows( @\"%@\" )   // Windows.incl\n\n", fn AppQuote( projectLabel ) ) )elseMutableStringAppendString( s, @"// the window: the ALS runtime's master-detail window\n" )MutableStringAppendString( s, @"if ( fn ALSAppStart )\n" )MutableStringAppendString( s, @"fn BuildMenus                          // Menus.incl\n" )MutableStringAppendString( s, fn StringWithFormat( @"fn BuildWindows( @\"%@\" )   // Windows.incl\n", fn AppQuote( projectLabel ) ) )MutableStringAppendString( s, @"fn ALSAppReady\n" )MutableStringAppendString( s, @"end if\n\n" )end ifMutableStringAppendString( s, @"HandleEvents\n" )end fn = s// the project file: one FB editor group per concern, in build orderlocal fn AppProjectFile( projectLabel as CFStringRef, modelResources as CFArrayRef, hasCredits as BOOL, hasLogo as BOOL ) as CFStringRefCFMutableStringRef s = fn MutableStringNewCFDictionaryRef    resourceCFArrayRef         runtimeFiles = fn AppRuntimeFilesCFStringRef        runtimeFileMutableStringAppendString( s, @"include \"NSLog.incl\"\n" )                        // FB's own header, from the user's FB installMutableStringAppendString( s, @"// \"Runtime\" 1\n" )for runtimeFile in runtimeFilesMutableStringAppendString( s, fn StringWithFormat( @"include \"%@\"\n", runtimeFile ) )nextMutableStringAppendString( s, @"// \"Model\" 1\ninclude \"Model Tags.incl\"\n" )MutableStringAppendString( s, @"// \"Bindings\" 1\n" )for resource in modelResourcesMutableStringAppendString( s, fn StringWithFormat( @"include \"%@ Binding.incl\"\n", fn DictionaryObjectForKey( resource, @"name" ) ) )nextMutableStringAppendString( s, @"// \"Pages\" 1\ninclude \"App Pages.incl\"\n" )MutableStringAppendString( s, @"// \"Resources\" 1\nresources \"Model.json\"\n" )if ( hasCredits ) then MutableStringAppendString( s, @"resources \"Credits.rtf\"\n" )if ( hasLogo ) then MutableStringAppendString( s, @"resources \"AppLogo.png\"\n" )for resource in modelResourcesMutableStringAppendString( s, fn StringWithFormat( @"resources \"%@.xib\"\n", fn DictionaryObjectForKey( resource, @"formNib" ) ) )MutableStringAppendString( s, fn StringWithFormat( @"resources \"%@.xib\"\n", fn DictionaryObjectForKey( resource, @"listNib" ) ) )nextMutableStringAppendString( s, @"// \"Rules\" 1\ninclude \"Studio Rules.incl\"\ninclude \"Rules.incl\"\n" )MutableStringAppendString( s, @"// \"Controller\" 1\ninclude \"EventHandlers.incl\"\n" )MutableStringAppendString( s, @"// \"View\" 1\ninclude \"Theme.incl\"\ninclude \"Menus.incl\"\ninclude \"Windows.incl\"\n" )MutableStringAppendString( s, fn StringWithFormat( @"// \"Main\" 1\ninclude \"%@.main\"\n", projectLabel ) )end fn = s// <project>.fbeproj: Settings2.plist from the template (only when missing - the// developer's build settings survive regeneration) and a generated data.fbprojlocal fn AppWriteProject( projectLabel as CFStringRef, modelResources as CFArrayRef, folderURL as CFURLRef, hasCredits as BOOL, hasLogo as BOOL ) as BOOLCFURLRef projectURL  = fn URLByAppendingPathComponent( folderURL, fn StringWithFormat( @"%@.fbeproj", projectLabel ) )if ( fn FileManagerFileExistsAtURL( projectURL ) == NO ) then fn FileManagerCreateDirectoryAtURL( projectURL, YES, NULL )if ( fn AppCopyTemplateFile( @"Project", @"Settings2.plist", projectURL ) == NO ) then exit fn = NOend fn = fn AppWriteSource( fn AppProjectFile( projectLabel, modelResources, hasCredits, hasLogo ), projectURL, @"data.fbproj" )/* *   the whole pipeline - returns YES when every file was written */// the four generation commandsbegin enum 1_genXIBs          // every entity's Form and List parts_genXIB           // one entity's parts_genBinding       // <Entity> Binding.incl for every entity_genApp           // all of it: parts, binding code, Model.json, main program, runtimeend enumlocal fn AppGenerate( projectDict as CFDictionaryRef, folderURL as CFURLRef, projectLabel as CFStringRef, hostURL as CFStringRef, userName as CFStringRef, what as long, onlyName as CFStringRef ) as BOOLCFMutableArrayRef modelResources = fn MutableArrayNewCFStringRef       only = NULLCFStringRef       about = fn DictionaryObjectForKey( projectDict, @"about" )CFStringRef       tagline = fn DictionaryObjectForKey( projectDict, @"tagline" )CFStringRef       copyright = fn DictionaryObjectForKey( projectDict, @"copyright" )CFStringRef       logoPath = fn DictionaryObjectForKey( projectDict, @"logoPath" )CFURLRef          logoURLBOOL              hasLogo = NOCFStringRef       databasePath = fn DictionaryObjectForKey( projectDict, @"source" )CFArrayRef        runtimeFiles = fn AppRuntimeFilesCFStringRef       runtimeFilelong              xibCountBOOL              ok = YESif ( fn StringHasSuffix( hostURL, @"/" ) ) then hostURL = fn StringSubstringToIndex( hostURL, fn StringLength( hostURL ) - 1 )if ( what == _genXIB ) then only = onlyNamexibCount = fn XibGenerateProject( projectDict, folderURL, projectLabel, modelResources, ( what != _genBinding ), only )if ( fn ArrayCount( modelResources ) == 0 ) then exit fn = NOif ( what == _genXIBs || what == _genXIB ) then exit fn = ( xibCount > 0 )if ( fn BindingGenerateProject( modelResources, folderURL, NULL ) == 0 ) then ok = NOif ( what == _genBinding ) then exit fn = okif ( about == NULL ) then about = @""if ( tagline == NULL ) then tagline = @""if ( copyright == NULL || fn StringLength( copyright ) == 0 ) then copyright = fn StringWithFormat( @"© %@", projectLabel )// the app's logo (Project Settings): AppLogo.png beside the project, listed as a resourcelogoURL = fn URLByAppendingPathComponent( folderURL, @"AppLogo.png" )if ( fn FileManagerFileExistsAtURL( logoURL ) ) then fn FileManagerRemoveItemAtURL( logoURL )if ( logoPath != NULL )if ( fn FileManagerFileExistsAtURL( fn URLFileURLWithPath( logoPath ) ) ) then hasLogo = fn FileManagerCopyItemAtURL( fn URLFileURLWithPath( logoPath ), logoURL )end if// the data runtime works on the project's SQLite copy; an ALS metadata file is no databaseif ( databasePath == NULL ) then databasePath = @""if ( fn StringIsEqual( fn StringLowercaseString( fn StringPathExtension( databasePath ) ), @"json" ) ) then databasePath = @""ok = fn AppWriteModel( modelResources, folderURL, projectLabel, about, databasePath ) && okif ( fn AppWriteCredits( about, folderURL ) == NO ) then ok = NOif ( fn AppWriteSource( fn AppMainProgram( projectLabel, modelResources, hostURL, userName, databasePath ), folderURL, fn StringWithFormat( @"%@.main", projectLabel ) ) == NO ) then ok = NOif ( fn AppWriteProject( projectLabel, modelResources, folderURL, ( fn StringLength( about ) > 0 ), hasLogo ) == NO ) then ok = NOif ( fn AppCopyTemplateFile( @"App", @"EventHandlers.incl", folderURL ) == NO ) then ok = NOif ( fn AppCopyTemplateFile( @"App", @"Menus.incl", folderURL ) == NO ) then ok = NOif ( fn AppCopyTemplateFile( @"App", @"Rules.incl", folderURL ) == NO ) then ok = NOif ( fn AppWriteSourceIfMissing( @"// Studio Rules.incl - generated from the project's Rules.json\n\nvoid local fn DeclareStudioRules\nend fn\n", folderURL, @"Studio Rules.incl" ) == NO ) then ok = NOif ( fn AppWriteSourceIfMissing( fn AppWindowsSource( modelResources, ( fn StringLength( databasePath ) > 0 ) ), folderURL, @"Windows.incl" ) == NO ) then ok = NOif ( fn AppCopyTemplateFile( @"App", @"Theme.incl", folderURL ) == NO ) then ok = NOif ( fn AppWriteSource( fn AppPagesSource( modelResources, tagline, copyright ), folderURL, @"App Pages.incl" ) == NO ) then ok = NO// README.md: a developer's tour of the project (LF line endings: it is Markdown)fn StringWriteToURL( fn AppDeveloperReadme( projectLabel, ( fn StringLength( databasePath ) > 0 ) ), fn URLByAppendingPathComponent( folderURL, @"README.md" ), YES, NSUTF8StringEncoding, NULL )for runtimeFile in runtimeFilesif ( fn AppCopyRuntimeFile( runtimeFile, folderURL ) == NO ) then ok = NOnextif (isLoggingOn) then NSLog( @"Generated %@: %ld views, %@", projectLabel, xibCount, fn URLPath( folderURL ) )end fn = ok