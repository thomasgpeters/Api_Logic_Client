/* *   I M A G E R Y    B U S I N E S S     S Y S T E M S,   L L C * *   App Generator * *   model -> a complete FutureBasic project in *   ~/Library/Application Support/Imagery LogicBank Studio for FutureBasic/workspace/<project>/ * *       <project>.fbeproj   the FB project: Settings2.plist (template) + data.fbproj (groups *                           Runtime, Model, Bindings, Resources, Controller, View, Main) *       <project>.main      main program: connection settings, handler registration, start *       EventHandlers.incl  starting templates - written only when missing, then the *       Menus.incl          developer's: event handlers, menus, and the window with *       Windows.incl        the nibview call for each entity's Form part *       Model.json          resources, fields, kinds and tags - read at run time by Data Model.incl *       Credits.rtf         the designer's About text - the standard About box shows it *       Model Tags.incl     tag constants for your own code *       <Entity> Binding.incl  record <-> Form / List code per entity (Binding Generator.incl) *       <Resource>List.xib  list part per resource: table, one column per attribute *       <Resource>Form.xib  scalar part per resource: the record's fields (XIB Generator.incl) *       Data SQLite / DataObject / Data Model / Data Records   the data runtime: SQLite, *                           the query builder, Model.json entities, records (copied from ../Runtime) *       Logic Rules / Logic Row / Logic Engine   LogicBank for FutureBasic (copied from ../Runtime) *       Rules.incl          the app's business rules - starting template, written only when missing *       App Data Lite.incl  the app's data interface, Lite edition (Edition.incl picks the edition) *       App Shell.incl      the window's frame: navigation, header, footer, page actions * *   The generated project contains only our own code; it relies on the user's *   FutureBasic install for the Cocoa toolboxes, which are never copied. */#define APP_DEFAULT_LOGIN_PATH  @"/api/auth/login"#define APP_FALLBACK_LOGIN_PATH @"/api/authentication-User/login"#define APP_DEFAULT_PAGE_LIMIT  100// FB source files use classic-Mac line endingslocal fn AppWriteSource( source as CFStringRef, folderURL as CFURLRef, fileName as CFStringRef ) as BOOLErrorRef err = NULLCFURLRef url = fn URLByAppendingPathComponent( folderURL, fileName )BOOL     ok  = fn StringWriteToURL( fn StringByReplacingOccurrencesOfString( source, @"\n", @"\r" ), url, YES, NSUTF8StringEncoding, @err )if ( ok == NO && isLoggingOn ) then NSLog( @"Could not write %@: %@", fn URLPath( url ), fn ErrorLocalizedDescription( err ) )end fn = ok// text safe to place inside an FB @"..." literallocal fn AppQuote( s as CFStringRef ) as CFStringRefif ( s == NULL ) then exit fn = @""s = fn StringByReplacingOccurrencesOfString( s, @"\\", @"\\\\" )end fn = fn StringByReplacingOccurrencesOfString( s, @"\"", @"\\\"" )// the runtime copied into every generated app, in build order (data runtime first)// the runtime copied into the project, in build order: the edition's data files (Edition.incl),// then the shell and the binding helpers, which are the same in every editionlocal fn AppRuntimeFiles( edition as CFStringRef ) as CFArrayRefCFMutableArrayRef files = fn MutableArrayWithArray( fn EditionDataRuntimeFiles( edition ) )MutableArrayAddObjectsFromArray( files, @[ @"App Shell.incl", @"Binding Support.incl" ] )end fn = fileslocal fn AppCopyRuntimeFile( fileName as CFStringRef, folderURL as CFURLRef ) as BOOLCFURLRef srcURL, dstURLsrcURL = fn URLByAppendingPathComponent( fn StudioRuntimeURL, fileName )   // workspace/Runtime (Studio Library.incl)if ( fn FileManagerFileExistsAtURL( srcURL ) == NO )NSLog( @"Runtime/%@ is not in the workspace - Generate > Update Runtime and Templates.", fileName )exit fn = NOend ifdstURL = fn URLByAppendingPathComponent( folderURL, fileName )if ( fn FileManagerFileExistsAtURL( dstURL ) ) then fn FileManagerRemoveItemAtURL( dstURL )if ( fn FileManagerCopyItemAtURL( srcURL, dstURL ) == NO )if (isLoggingOn) then NSLog( @"Could not copy %@ to %@", fileName, fn URLPath( dstURL ) )exit fn = NOend ifend fn = YES// starting template from the bundled Templates folder - copied only when missing,// so the developer's edits survive regenerationlocal fn AppCopyTemplateFile( subfolder as CFStringRef, fileName as CFStringRef, dstFolderURL as CFURLRef ) as BOOLCFURLRef srcURL, dstURLdstURL = fn URLByAppendingPathComponent( dstFolderURL, fileName )if ( fn FileManagerFileExistsAtURL( dstURL ) ) then exit fn = YESsrcURL = fn URLByAppendingPathComponent( fn URLByAppendingPathComponent( fn StudioTemplatesURL, subfolder ), fileName )   // workspace/Templatesif ( fn FileManagerFileExistsAtURL( srcURL ) == NO )NSLog( @"Templates/%@/%@ is not in the workspace - Generate > Update Runtime and Templates.", subfolder, fileName )exit fn = NOend ifif ( fn FileManagerCopyItemAtURL( srcURL, dstURL ) == NO )if (isLoggingOn) then NSLog( @"Could not copy %@ to %@", fileName, fn URLPath( dstURL ) )exit fn = NOend ifend fn = YES// starting Windows.incl: the shell window and its pages - written only when missinglocal fn AppWindowsSource as CFStringRefCFMutableStringRef s = fn MutableStringNewMutableStringAppendString( s, @"/*\n *   Windows.incl - the app's window\n *\n" )MutableStringAppendString( s, @" *   Starting template from Imagery LogicBank Studio for FutureBasic: created once, then\n" )MutableStringAppendString( s, @" *   yours.  Regeneration never overwrites it (delete it to get a fresh copy).\n *\n" )MutableStringAppendString( s, @" *   Developer notes\n" )MutableStringAppendString( s, @" *   - The window has the common look of every generated app (App Shell.incl): the\n" )MutableStringAppendString( s, @" *     navigation bar, the header with the logo, the app name, the theme menu and Log In,\n" )MutableStringAppendString( s, @" *     and the footer.  Its colours come from Theme.incl.\n" )MutableStringAppendString( s, @" *   - App Pages.incl (regenerated) adds a page per entity.  Add pages of your own here,\n" )MutableStringAppendString( s, @" *     after AppPagesBuild: load a XIB into the content view, then add its button:\n" )MutableStringAppendString( s, @" *         nibview _myView, @\"MyView\", , ( 0, 0 ), _shellContent\n" )MutableStringAppendString( s, @" *         fn ShellAddNavItem( @\"Reports\", @\"chart.bar\", @[ fn NumberWithInteger( _myView ) ] )\n */\n\n" )MutableStringAppendString( s, @"void local fn BuildWindows( title as CFStringRef )\n" )MutableStringAppendString( s, @"fn ApplyTheme                                           // Theme.incl: the colours\n" )MutableStringAppendString( s, @"fn ShellBuildWindow( title, APP_TAGLINE, APP_COPYRIGHT ) // App Shell.incl: navigation, header, footer\n" )MutableStringAppendString( s, @"fn AppPagesBuild                                        // App Pages.incl: a page per entity\n" )MutableStringAppendString( s, @"fn ShellShowPage( 0 )                                   // start on the first page\n" )MutableStringAppendString( s, @"end fn\n" )end fn = s// a generated source file only when missing - for starting templateslocal fn AppWriteSourceIfMissing( source as CFStringRef, folderURL as CFURLRef, fileName as CFStringRef ) as BOOLif ( fn FileManagerFileExistsAtURL( fn URLByAppendingPathComponent( folderURL, fileName ) ) ) then exit fn = YESend fn = fn AppWriteSource( source, folderURL, fileName )local fn AppWriteModel( modelResources as CFArrayRef, folderURL as CFURLRef, projectLabel as CFStringRef, about as CFStringRef, databasePath as CFStringRef ) as BOOLCFDataRef jsonErrorRef  err = NULLCFURLRef  url = fn URLByAppendingPathComponent( folderURL, @"Model.json" )// "database": the project's SQLite copy, opened by the data runtime (Data Records.incl: DataOpen)json = fn JSONSerializationDataWithJSONObject( @{ @"project":projectLabel, @"about":about, @"database":databasePath, @"resources":modelResources }, NSJSONWritingPrettyPrinted, @err )if ( json == NULL ) then exit fn = NOif ( fn DataWriteToURL( json, url, NSDataWritingAtomic, @err ) == NO )if (isLoggingOn) then NSLog( @"Could not write %@: %@", fn URLPath( url ), fn ErrorLocalizedDescription( err ) )exit fn = NOend ifend fn = YES// Credits.rtf - FB's About menu item opens the standard About box, which shows the// bundle's Credits.rtf under the app's name, icon and version.  No colour is set, so// the text follows light and dark mode.  No About text: no file.local fn AppWriteCredits( about as CFStringRef, folderURL as CFURLRef ) as BOOLCFURLRef  url = fn URLByAppendingPathComponent( folderURL, @"Credits.rtf" )CFDataRef rtfErrorRef  err = NULLif ( fn FileManagerFileExistsAtURL( url ) ) then fn FileManagerRemoveItemAtURL( url )if ( fn StringLength( about ) == 0 ) then exit fn = YESrtf = fn AttributedStringRTFFromRange( fn AttributedStringWithString( about ), fn CFRangeMake( 0, fn StringLength( about ) ), NULL )if ( rtf == NULL ) then exit fn = NOif ( fn DataWriteToURL( rtf, url, NSDataWritingAtomic, @err ) == NO )if (isLoggingOn) then NSLog( @"Could not write %@: %@", fn URLPath( url ), fn ErrorLocalizedDescription( err ) )exit fn = NOend ifend fn = YES/* *   App Pages.incl (regenerated): a page per entity in the app shell - its List part above *   its Form part - the navigation buttons, and the page actions (New, Save, Delete, *   Refresh) through the app's data interface (App Data: Lite or Enterprise).  Written to *   be read: FB developers who open the generated project should understand it without *   this generator. */local fn AppPagesSource( modelResources as CFArrayRef, tagline as CFStringRef, copyright as CFStringRef, appSymbol as CFStringRef ) as CFStringRefCFMutableStringRef s = fn MutableStringNewCFDictionaryRef    resourceCFStringRef        name, prefixlong               indexMutableStringAppendString( s, @"/*\n *   App Pages.incl - the app's pages: one per entity\n *\n" )MutableStringAppendString( s, @" *   Generated by Imagery LogicBank Studio for FutureBasic from the data model.\n" )MutableStringAppendString( s, @" *   Regenerating overwrites this file - put your own code in EventHandlers.incl,\n" )MutableStringAppendString( s, @" *   Windows.incl or files of your own.\n *\n" )MutableStringAppendString( s, @" *   Developer notes\n" )MutableStringAppendString( s, @" *   - Each page is two XIB parts loaded into the shell's content view with nibview\n" )MutableStringAppendString( s, @" *     (its last parameter, _shellContent, is the superview): the entity's List part on\n" )MutableStringAppendString( s, @" *     top, filling the space, and its Form part below.  The tags (_customerList,\n" )MutableStringAppendString( s, @" *     _customerView, ...) are named in Model Tags.incl.\n" )MutableStringAppendString( s, @" *   - ShellAddNavItem (App Shell.incl) adds the page's button to the navigation bar.\n" )MutableStringAppendString( s, @" *   - The pages never read or write data themselves: they ask App Data (AppDataList,\n" )MutableStringAppendString( s, @" *     AppDataSave, AppDataRemove) and get the answer in AppDataDone.  In the Lite edition\n" )MutableStringAppendString( s, @" *     App Data is the SQLite database and the rules engine in this app; in the Enterprise\n" )MutableStringAppendString( s, @" *     edition it is an API Logic Server.  This file is the same in both.\n" )MutableStringAppendString( s, @" *   - Records move between the screens and App Data through <Entity> Binding.incl:\n" )MutableStringAppendString( s, @" *     <Entity>RecordsToList, <Entity>RecordToForm, <Entity>FormToRecord.\n" )MutableStringAppendString( s, @" *   - Page numbers follow the navigation bar: 0 is the first entity.\n */\n\n" )MutableStringAppendString( s, @"// the header's tag-line and the footer's copyright (Project Settings in the Studio)\n" )MutableStringAppendString( s, fn StringWithFormat( @"#define APP_TAGLINE   @\"%@\"\n", fn AppQuote( tagline ) ) )MutableStringAppendString( s, fn StringWithFormat( @"#define APP_COPYRIGHT @\"%@\"\n", fn AppQuote( copyright ) ) )MutableStringAppendString( s, @"// the app icon's SF Symbol, shown when the project has no app icon picture (AppLogo.png)\n" )MutableStringAppendString( s, fn StringWithFormat( @"#define APP_SYMBOL    @\"%@\"\n\n", fn AppQuote( appSymbol ) ) )MutableStringAppendString( s, @"begin globals\n" )MutableStringAppendString( s, @"CFMutableArrayRef      gAppPageEntities     // page number -> entity name\n" )MutableStringAppendString( s, @"CFMutableDictionaryRef gAppPageRecords      // entity name -> the records its List shows\n" )MutableStringAppendString( s, @"CFDictionaryRef        gAppPageKeys         // the key of the record in the Form; NULL for a new one\n" )MutableStringAppendString( s, @"end globals\n\n\n" )// the entity on screenMutableStringAppendString( s, @"// the entity of the page on screen (NULL before the first page is shown)\n" )MutableStringAppendString( s, @"local fn AppPageEntity as CFStringRef\n" )MutableStringAppendString( s, @"if ( gShellCurrentPage < 0 || gShellCurrentPage >= fn ArrayCount( gAppPageEntities ) ) then exit fn = NULL\n" )MutableStringAppendString( s, @"end fn = fn ArrayObjectAtIndex( gAppPageEntities, gShellCurrentPage )\n\n\n" )// per-page bindingsMutableStringAppendString( s, @"// each page's List table, and its bindings (<Entity> Binding.incl), by page number\n" )MutableStringAppendString( s, @"local fn AppPageTable( pageIndex as long ) as long\nlong tag = 0\nselect ( pageIndex )\n" )index = 0for resource in modelResourcesMutableStringAppendString( s, fn StringWithFormat( @"case %ld : tag = _%@ListTable\n", index, fn XibResourcePrefix( fn DictionaryObjectForKey( resource, @"name" ) ) ) )index++nextMutableStringAppendString( s, @"end select\nend fn = tag\n\n" )MutableStringAppendString( s, @"void local fn AppPageShowRecords( pageIndex as long, records as CFArrayRef )\nselect ( pageIndex )\n" )index = 0for resource in modelResourcesMutableStringAppendString( s, fn StringWithFormat( @"case %ld : fn %@RecordsToList( records )\n", index, fn DictionaryObjectForKey( resource, @"name" ) ) )index++nextMutableStringAppendString( s, @"end select\nend fn\n\n" )MutableStringAppendString( s, @"void local fn AppPageShowRecord( pageIndex as long, aRecord as CFDictionaryRef )\nselect ( pageIndex )\n" )index = 0for resource in modelResourcesMutableStringAppendString( s, fn StringWithFormat( @"case %ld : fn %@RecordToForm( aRecord )\n", index, fn DictionaryObjectForKey( resource, @"name" ) ) )index++nextMutableStringAppendString( s, @"end select\nend fn\n\n" )MutableStringAppendString( s, @"local fn AppPageFormRecord( pageIndex as long ) as CFMutableDictionaryRef\nCFMutableDictionaryRef aRecord = NULL\nselect ( pageIndex )\n" )index = 0for resource in modelResourcesMutableStringAppendString( s, fn StringWithFormat( @"case %ld : aRecord = fn %@FormToRecord\n", index, fn DictionaryObjectForKey( resource, @"name" ) ) )index++nextMutableStringAppendString( s, @"end select\nend fn = aRecord\n\n" )MutableStringAppendString( s, @"// the lookup tables a page's Dropdowns offer: ask App Data for their rows\n" )MutableStringAppendString( s, @"void local fn AppPageRequestLookups( pageIndex as long )\nCFArrayRef  lookups = NULL\nCFStringRef lookupEntity\n\nselect ( pageIndex )\n" )index = 0for resource in modelResourcesMutableStringAppendString( s, fn StringWithFormat( @"case %ld : lookups = fn %@Lookups\n", index, fn DictionaryObjectForKey( resource, @"name" ) ) )index++nextMutableStringAppendString( s, @"end select\nif ( lookups == NULL ) then exit fn\nfor lookupEntity in lookups\nfn AppDataLookup( lookupEntity )\nnext\nend fn\n\n" )MutableStringAppendString( s, @"void local fn AppPageFillLookup( pageIndex as long, lookupEntity as CFStringRef, records as CFArrayRef )\nselect ( pageIndex )\n" )index = 0for resource in modelResourcesMutableStringAppendString( s, fn StringWithFormat( @"case %ld : fn %@FillLookup( lookupEntity, records )\n", index, fn DictionaryObjectForKey( resource, @"name" ) ) )index++nextMutableStringAppendString( s, @"end select\nend fn\n\n\n" )// AppDataDoneMutableStringAppendString( s, @"// App Data's answer: records to show, or what became of a save, a delete, a sign-in.\n" )MutableStringAppendString( s, @"// message is NULL when it worked, otherwise the reason (a rule's message, the server's error).\n" )MutableStringAppendString( s, @"void local fn AppDataDone( op as long, entity as CFStringRef, result as CFTypeRef, message as CFStringRef )\n" )MutableStringAppendString( s, @"long pageIndex = -1\n\n" )MutableStringAppendString( s, @"if ( entity != NULL )\nif ( fn ArrayContainsObject( gAppPageEntities, entity ) ) then pageIndex = fn ArrayIndexOfObject( gAppPageEntities, entity )\nend if\n" )MutableStringAppendString( s, @"select ( op )\n" )MutableStringAppendString( s, @"case _appDataList\n" )MutableStringAppendString( s, @"if ( result == NULL ) then result = @[]\n" )MutableStringAppendString( s, @"MutableDictionarySetObjectForKey( gAppPageRecords, result, entity )\n" )MutableStringAppendString( s, @"if ( pageIndex == gShellCurrentPage ) then fn AppPageShowRecords( pageIndex, result )\n" )MutableStringAppendString( s, @"if ( message != NULL ) then fn ShellSetStatus( message ) else fn ShellSetStatus( fn StringWithFormat( @\"%ld records\", (long)fn ArrayCount( result ) ) )\n\n" )MutableStringAppendString( s, @"case _appDataSave, _appDataRemove\n" )MutableStringAppendString( s, @"if ( message != NULL )\n" )MutableStringAppendString( s, @"fn ShellSetStatus( message )\n" )MutableStringAppendString( s, @"if ( op == _appDataSave )\nalert 1, NSAlertStyleWarning, @\"The record was not saved.\", message, @[@\"OK\"], NO\nelse\nalert 1, NSAlertStyleWarning, @\"The record was not deleted.\", message, @[@\"OK\"], NO\nend if\n" )MutableStringAppendString( s, @"exit fn\nend if\n" )MutableStringAppendString( s, @"if ( op == _appDataSave ) then fn ShellSetStatus( @\"Saved.\" ) else fn ShellSetStatus( @\"Deleted.\" )\n" )MutableStringAppendString( s, @"// after a delete, or after adding a new record, the Form starts over (Save twice adds nothing twice)\n" )MutableStringAppendString( s, @"if ( op == _appDataRemove || gAppPageKeys == NULL )\ngAppPageKeys = NULL\nfn AppPageShowRecord( pageIndex, @{} )\nend if\n" )MutableStringAppendString( s, @"fn AppDataList( entity )               // show the list as it is now (the rules may have changed other rows)\n\n" )MutableStringAppendString( s, @"case _appDataLookup\n" )MutableStringAppendString( s, @"if ( message != NULL ) then fn ShellSetStatus( message ) else fn AppPageFillLookup( gShellCurrentPage, entity, result )\n\n" )MutableStringAppendString( s, @"case _appDataLogin\n" )MutableStringAppendString( s, @"if ( message != NULL )\nfn ShellSetStatus( message )\nalert 1, NSAlertStyleWarning, @\"Sign-in failed.\", message, @[@\"OK\"], NO\nexit fn\nend if\n" )MutableStringAppendString( s, @"fn ShellSetStatus( @\"Signed in.\" )\n" )MutableStringAppendString( s, @"if ( fn AppPageEntity != NULL ) then fn AppDataList( fn AppPageEntity )\n" )MutableStringAppendString( s, @"end select\nend fn\n\n\n" )// AppPageShown and the actionsMutableStringAppendString( s, @"// a page was shown (App Shell.incl calls this): ask for its records\n" )MutableStringAppendString( s, @"void local fn AppPageShown( pageIndex as long )\ngAppPageKeys = NULL\n" )MutableStringAppendString( s, @"fn AppPageRequestLookups( pageIndex )      // the Dropdowns' lookup tables first\n" )MutableStringAppendString( s, @"fn AppDataList( fn ArrayObjectAtIndex( gAppPageEntities, pageIndex ) )\nend fn\n\n\n" )MutableStringAppendString( s, @"// New: an empty Form; Save will add the record\n" )MutableStringAppendString( s, @"void local fn AppPageNew\nif ( fn AppPageEntity == NULL ) then exit fn\ngAppPageKeys = NULL\n" )MutableStringAppendString( s, @"TableViewDeselectAll( fn AppPageTable( gShellCurrentPage ) )\n" )MutableStringAppendString( s, @"fn AppPageShowRecord( gShellCurrentPage, @{} )\n" )MutableStringAppendString( s, @"fn ShellSetStatus( @\"New record: fill in the form, then Save.\" )\nend fn\n\n\n" )MutableStringAppendString( s, @"// Save: the Form's record - new, or a change to the chosen one - through App Data (and the rules)\n" )MutableStringAppendString( s, @"void local fn AppPageSave\nif ( fn AppPageEntity == NULL ) then exit fn\n" )MutableStringAppendString( s, @"fn AppDataSave( fn AppPageEntity, fn AppPageFormRecord( gShellCurrentPage ), gAppPageKeys )\nend fn\n\n\n" )MutableStringAppendString( s, @"// Delete: the chosen record, after asking\n" )MutableStringAppendString( s, @"void local fn AppPageDelete\nNSModalResponse response\n\n" )MutableStringAppendString( s, @"if ( fn AppPageEntity == NULL ) then exit fn\n" )MutableStringAppendString( s, @"if ( gAppPageKeys == NULL )\nfn ShellSetStatus( @\"Choose a record in the list first.\" )\nexit fn\nend if\n" )MutableStringAppendString( s, @"response = alert 1, NSAlertStyleWarning, @\"Delete this record?\", @\"The business rules decide what happens to its related records.\", @[@\"Delete\", @\"Cancel\"]\n" )MutableStringAppendString( s, @"if ( response != NSAlertFirstButtonReturn ) then exit fn\n" )MutableStringAppendString( s, @"fn AppDataRemove( fn AppPageEntity, gAppPageKeys )\nend fn\n\n\n" )MutableStringAppendString( s, @"void local fn AppPageRefresh\nif ( fn AppPageEntity != NULL ) then fn AppDataList( fn AppPageEntity )\nend fn\n\n\n" )MutableStringAppendString( s, @"// Log In (EventHandlers.incl, DoLogin): App Data asks for the name and password it needs\n" )MutableStringAppendString( s, @"void local fn AppPagesLogin\nfn AppDataLogin( NULL, NULL )\nend fn\n\n\n" )// AppPagesBuildMutableStringAppendString( s, @"// the pages: each entity's List and Form parts in the content view, and its button\n" )MutableStringAppendString( s, @"void local fn AppPagesBuild\nCGRect  content = fn ShellContentBounds      // the content view, origin at its bottom left\nCGFloat listY\n\n" )MutableStringAppendString( s, @"gAppPageEntities = fn MutableArrayNew\ngAppPageRecords  = fn MutableDictionaryNew\n" )MutableStringAppendString( s, @"fn ShellSetAppSymbol( APP_SYMBOL )                  // the header's icon when there is no picture\n\n" )for resource in modelResourcesname   = fn DictionaryObjectForKey( resource, @"name" )prefix = fn XibResourcePrefix( name )MutableStringAppendString( s, fn StringWithFormat( @"// %@: the Form at the bottom, the List above it, filling the rest\n", name ) )MutableStringAppendString( s, fn StringWithFormat( @"listY = _%@ViewHeight + 12\n", prefix ) )MutableStringAppendString( s, fn StringWithFormat( @"nibview _%@View, @\"%@\", , ( 0, 0 ), _shellContent\n", prefix, fn DictionaryObjectForKey( resource, @"formNib" ) ) )MutableStringAppendString( s, fn StringWithFormat( @"nibview _%@List, @\"%@\", , ( 0, listY ), _shellContent\n", prefix, fn DictionaryObjectForKey( resource, @"listNib" ) ) )MutableStringAppendString( s, fn StringWithFormat( @"ViewSetFrame( _%@List, fn CGRectMake( 0, listY, content.size.width, content.size.height - listY ) )\n", prefix ) )MutableStringAppendString( s, fn StringWithFormat( @"ViewSetAutoresizingMask( _%@List, NSViewWidthSizable + NSViewHeightSizable )\n", prefix ) )MutableStringAppendString( s, fn StringWithFormat( @"fn %@FormSetUp                                 // its value-list Dropdowns\n", name ) )MutableStringAppendString( s, fn StringWithFormat( @"fn ShellAddNavItem( @\"%@\", @\"%@\", @[ fn NumberWithInteger( _%@List ), fn NumberWithInteger( _%@View ) ] )\n", fn AppQuote( fn TypeMapDefaultTitle( name ) ), fn AppQuote( fn DictionaryObjectForKey( resource, @"icon" ) ), prefix, prefix ) )MutableStringAppendString( s, fn StringWithFormat( @"MutableArrayAddObject( gAppPageEntities, @\"%@\" )\n\n", name ) )nextMutableStringAppendString( s, @"fn ShellSetPageShownHandler( @fn AppPageShown )     // App Shell.incl tells us when a page is shown\n" )MutableStringAppendString( s, @"fn AppDataSetHandler( @fn AppDataDone )             // App Data answers here\n" )MutableStringAppendString( s, @"fn ShellShowLogin( fn AppDataNeedsLogin )           // Log In only where there is a server to sign in to\n" )MutableStringAppendString( s, @"end fn\n\n\n" )// AppPagesDoDialogMutableStringAppendString( s, @"// the page actions and a row chosen in a List.  YES when the event was a page's.\n" )MutableStringAppendString( s, @"local fn AppPagesDoDialog( ev as long, tag as long, wnd as long ) as BOOL\n" )MutableStringAppendString( s, @"long          row\nlong          pageIndex = gShellCurrentPage\nCFArrayRef      records\nCFDictionaryRef aRecord\n\n" )MutableStringAppendString( s, @"// a radio button: the others of its field go off (Binding Support.incl)\n" )MutableStringAppendString( s, @"if ( ev == _btnClick ) then if ( fn BindingRadioClicked( tag ) ) then exit fn = YES\n" )MutableStringAppendString( s, @"if ( ev == _btnClick )\nselect ( tag )\n" )MutableStringAppendString( s, @"case _shellNewButton\nfn AppPageNew\nexit fn = YES\n" )MutableStringAppendString( s, @"case _shellSaveButton\nfn AppPageSave\nexit fn = YES\n" )MutableStringAppendString( s, @"case _shellDeleteButton\nfn AppPageDelete\nexit fn = YES\n" )MutableStringAppendString( s, @"case _shellRefreshButton\nfn AppPageRefresh\nexit fn = YES\n" )MutableStringAppendString( s, @"end select\nexit fn = NO\nend if\n\n" )MutableStringAppendString( s, @"if ( ev != _tableViewSelectionDidChange ) then exit fn = NO\n" )MutableStringAppendString( s, @"if ( pageIndex < 0 || tag != fn AppPageTable( pageIndex ) ) then exit fn = NO\n" )MutableStringAppendString( s, @"row = fn TableViewSelectedRow( tag )\n" )MutableStringAppendString( s, @"records = fn DictionaryObjectForKey( gAppPageRecords, fn AppPageEntity )\n" )MutableStringAppendString( s, @"if ( row < 0 || records == NULL ) then exit fn = YES\n" )MutableStringAppendString( s, @"if ( row >= fn ArrayCount( records ) ) then exit fn = YES\n" )MutableStringAppendString( s, @"aRecord = fn ArrayObjectAtIndex( records, row )\n" )MutableStringAppendString( s, @"gAppPageKeys = fn AppDataKeyValues( fn AppPageEntity, aRecord )   // Save and Delete act on this record\n" )MutableStringAppendString( s, @"fn AppPageShowRecord( pageIndex, aRecord )\n" )MutableStringAppendString( s, @"end fn = YES\n\n\n" )// AppPagesDoMenuMutableStringAppendString( s, @"// the Records menu: the same actions as the footer's buttons\n" )MutableStringAppendString( s, @"local fn AppPagesDoMenu( menuID as long, itemID as long ) as BOOL\n" )MutableStringAppendString( s, @"if ( menuID != _shellMenuRecords ) then exit fn = NO\nselect ( itemID )\n" )MutableStringAppendString( s, @"case _shellItemNew     : fn AppPageNew\ncase _shellItemSave    : fn AppPageSave\n" )MutableStringAppendString( s, @"case _shellItemDelete  : fn AppPageDelete\ncase _shellItemRefresh : fn AppPageRefresh\n" )MutableStringAppendString( s, @"end select\nend fn = YES\n" )end fn = s/* *   README.md in the generated project (regenerated): a developer's tour - which file does *   what, which are regenerated and which are yours, how a save and the rules work. */local fn AppDeveloperReadme( projectLabel as CFStringRef, edition as CFStringRef ) as CFStringRefCFMutableStringRef s = fn MutableStringNewMutableStringAppendString( s, fn StringWithFormat( @"# %@ - developer notes\n\n", projectLabel ) )MutableStringAppendString( s, @"A native Mac app in FutureBasic, generated by Imagery LogicBank Studio for FutureBasic\n" )MutableStringAppendString( s, @"from a data model. Open `" )MutableStringAppendString( s, fn StringWithFormat( @"%@.fbeproj` in FutureBasic and build it.\n\n", projectLabel ) )MutableStringAppendString( s, fn StringWithFormat( @"**Edition:** %@.\n\n", fn EditionDescription( edition ) ) )MutableStringAppendString( s, @"## How it starts\n\n`" )MutableStringAppendString( s, fn StringWithFormat( @"%@.main` registers the event handlers, opens the project's SQLite database\n", projectLabel ) )MutableStringAppendString( s, @"(`DataOpen`), declares the business rules (`DeclareStudioRules`, `DeclareRules`), activates them\n" )MutableStringAppendString( s, @"(`LogicActivate`), builds the menus and the window, and runs FutureBasic's event loop.\n\n" )MutableStringAppendString( s, @"## The files, by group\n\n| Group | File | Regenerated? | What it does |\n|---|---|---|---|\n" )MutableStringAppendString( s, @"| Runtime | `Data SQLite.incl` | yes | SQLite: open, statements, values, transactions (`DataBegin` / `DataEnd`) |\n" )MutableStringAppendString( s, @"| | `DataObject*.incl/.glbl` | yes | the query builder: SQL from a description of the statement |\n" )MutableStringAppendString( s, @"| | `Data Model.incl`, `Data Records.incl` | yes | the entities (`Model.json`); records: `DataFetch`, `DataParent`, `DataChildren`, `DataInsert`, ... |\n" )MutableStringAppendString( s, @"| | `Logic Rules.incl`, `Logic Row.incl`, `Logic Engine.incl` | yes | LogicBank for FutureBasic: rules declared once, enforced on every save |\n" )MutableStringAppendString( s, @"| | `App Data Lite.incl` | yes | the app's data interface: list, save, delete - over the database and the rules |\n" )MutableStringAppendString( s, @"| | `App Shell.incl` | yes | the window's frame: navigation bar, header, footer, pages, page actions, theme menu |\n" )MutableStringAppendString( s, @"| | `Binding Support.incl` | yes | helpers the bindings use: a value as text, a number, a date, a check box |\n" )MutableStringAppendString( s, @"| Model | `Model Tags.incl` | yes | a named constant for every view and control tag |\n" )MutableStringAppendString( s, @"| Bindings | `<Entity> Binding.incl` | yes | record -> Form, Form -> record, records -> List |\n" )MutableStringAppendString( s, @"| Pages | `App Pages.incl` | yes | a page per entity: its List and Form parts, its navigation button, New / Save / Delete / Refresh |\n" )MutableStringAppendString( s, @"| Resources | `<Entity>Form.xib`, `<Entity>List.xib`, `Model.json`, `Credits.rtf`, `AppLogo.png` | yes | the screens (open them in Xcode), the model, the About text, the logo |\n" )MutableStringAppendString( s, @"| Rules | `Studio Rules.incl` | yes | the rules kept in the Studio (Rules.json) |\n" )MutableStringAppendString( s, @"| | `Rules.incl` | **yours** | your own rules, in `DeclareRules` |\n" )MutableStringAppendString( s, @"| Controller | `EventHandlers.incl` | **yours** | what happens on clicks, menus and app events |\n" )MutableStringAppendString( s, @"| View | `Theme.incl` | **yours** | the colours (`ApplyTheme`) |\n" )MutableStringAppendString( s, @"| | `Menus.incl`, `Windows.incl` | **yours** | the menus; the window and its pages |\n" )MutableStringAppendString( s, @"| Main | `" )MutableStringAppendString( s, fn StringWithFormat( @"%@.main` | yes | start-up |\n\n", projectLabel ) )MutableStringAppendString( s, @"Files marked **yours** are written once and never overwritten; delete one to get a fresh copy\n" )MutableStringAppendString( s, @"the next time the app is generated. Change everything else in the Studio, which regenerates it.\n\n" )MutableStringAppendString( s, @"## Screens\n\nEach screen part is a XIB, loaded with FutureBasic's `nibview` (see FutureBasic's reference:\n" )MutableStringAppendString( s, @"`nibwindow`, `nibview`, `nibtoolbar`, `nibmenu`, `nibpopover`). `App Pages.incl` loads each entity's\n" )MutableStringAppendString( s, @"List and Form into the shell's content view (`nibview tag, name, , ( x, y ), _shellContent`).\n\n" )MutableStringAppendString( s, @"## Saving data\n\nThe pages ask App Data, never the database: `AppDataList`, `AppDataSave`, `AppDataRemove`,\n" )MutableStringAppendString( s, @"and the answer comes back in `AppDataDone` (App Pages.incl). Your own code can save the same way,\n" )MutableStringAppendString( s, @"or call the rules engine directly - never with SQL of your own:\n\n```\n" )MutableStringAppendString( s, @"if ( fn LogicInsert( @\"Customer\", fn CustomerFormToRecord ) == NO ) then alert 1, NSAlertStyleWarning, fn LogicMessage, @\"\", @[@\"OK\"], NO\n```\n\n" )MutableStringAppendString( s, @"Each save is one transaction: formulas, sums and counts, constraints and events run in order,\n" )MutableStringAppendString( s, @"and a refused save changes nothing. `LogicMessage` says why. With `isLoggingOn` the NSLog window\n" )MutableStringAppendString( s, @"shows every rule as it runs.\n\n" )MutableStringAppendString( s, @"## Coding rules\n\nTyped return values (`local fn X as Type`), `//` comments, CR line endings, view tags (not window\n" )MutableStringAppendString( s, @"tags) for `View...` functions. The generated code follows them; please keep to them in yours.\n" )end fn = slocal fn AppMainProgram( projectLabel as CFStringRef, edition as CFStringRef, hostURL as CFStringRef, userName as CFStringRef ) as CFStringRefCFMutableStringRef s = fn MutableStringNewMutableStringAppendString( s, fn StringWithFormat( @"/*\n *   %@\n *\n", projectLabel ) )MutableStringAppendString( s, @" *   The start of the app.  Generated by Imagery LogicBank Studio for FutureBasic;\n" )MutableStringAppendString( s, @" *   regenerating overwrites it.  Your code goes in EventHandlers.incl, Menus.incl,\n" )MutableStringAppendString( s, @" *   Windows.incl, Theme.incl and Rules.incl, which are never overwritten.\n *\n" )MutableStringAppendString( s, fn StringWithFormat( @" *   Edition: %@\n", fn EditionDescription( edition ) ) )MutableStringAppendString( s, @" *   Developer notes: README.md in this folder is a tour of the project.\n */\n\n" )MutableStringAppendString( s, @"isLoggingOn = YES                     // runtime trace in the NSLog window\n\n" )MutableStringAppendString( s, @"// handlers are in EventHandlers.incl\n" )MutableStringAppendString( s, @"on appevent fn DoAppEvent\n" )MutableStringAppendString( s, @"on menu fn DoMenu\n" )MutableStringAppendString( s, @"on dialog fn DoDialog\n\n" )MutableStringAppendString( s, fn EditionMainStart( edition, hostURL, userName ) )MutableStringAppendString( s, @"\n// the window: the app shell with a page per entity\n" )MutableStringAppendString( s, @"fn BuildMenus                          // Menus.incl\n" )MutableStringAppendString( s, fn StringWithFormat( @"fn BuildWindows( @\"%@\" )   // Windows.incl\n\n", fn AppQuote( projectLabel ) ) )MutableStringAppendString( s, @"HandleEvents\n" )end fn = s// the project file: one FB editor group per concern, in build orderlocal fn AppProjectFile( projectLabel as CFStringRef, edition as CFStringRef, modelResources as CFArrayRef, hasCredits as BOOL, hasLogo as BOOL ) as CFStringRefCFMutableStringRef s = fn MutableStringNewCFDictionaryRef    resourceCFArrayRef         runtimeFiles = fn AppRuntimeFiles( edition )CFStringRef        runtimeFileMutableStringAppendString( s, @"// \"Headers\" 1\ninclude \"App Headers.incl\"\n" )   // FB's own headers, included from source (App Headers.incl)MutableStringAppendString( s, @"// \"Runtime\" 1\n" )for runtimeFile in runtimeFilesMutableStringAppendString( s, fn StringWithFormat( @"include \"%@\"\n", runtimeFile ) )nextMutableStringAppendString( s, @"// \"Model\" 1\ninclude \"Model Tags.incl\"\n" )MutableStringAppendString( s, @"// \"Bindings\" 1\n" )for resource in modelResourcesMutableStringAppendString( s, fn StringWithFormat( @"include \"%@ Binding.incl\"\n", fn DictionaryObjectForKey( resource, @"name" ) ) )nextMutableStringAppendString( s, @"// \"Pages\" 1\ninclude \"App Pages.incl\"\n" )MutableStringAppendString( s, @"// \"Resources\" 1\nresources \"Model.json\"\n" )if ( hasCredits ) then MutableStringAppendString( s, @"resources \"Credits.rtf\"\n" )if ( hasLogo ) then MutableStringAppendString( s, @"resources \"AppLogo.png\"\n" )for resource in modelResourcesMutableStringAppendString( s, fn StringWithFormat( @"resources \"%@.xib\"\n", fn DictionaryObjectForKey( resource, @"formNib" ) ) )MutableStringAppendString( s, fn StringWithFormat( @"resources \"%@.xib\"\n", fn DictionaryObjectForKey( resource, @"listNib" ) ) )next// the business rules run in the app only where the edition says so (Lite); Enterprise runs them on the serverif ( fn EditionRulesInApp( edition ) ) then MutableStringAppendString( s, @"// \"Rules\" 1\ninclude \"Studio Rules.incl\"\ninclude \"Rules.incl\"\n" )MutableStringAppendString( s, @"// \"Controller\" 1\ninclude \"EventHandlers.incl\"\n" )MutableStringAppendString( s, @"// \"View\" 1\ninclude \"Theme.incl\"\ninclude \"Menus.incl\"\ninclude \"Windows.incl\"\n" )MutableStringAppendString( s, fn StringWithFormat( @"// \"Main\" 1\ninclude \"%@.main\"\n", projectLabel ) )end fn = s// <project>.fbeproj: Settings2.plist from the template (only when missing - the// developer's build settings survive regeneration) and a generated data.fbprojlocal fn AppWriteProject( projectLabel as CFStringRef, edition as CFStringRef, modelResources as CFArrayRef, folderURL as CFURLRef, hasCredits as BOOL, hasLogo as BOOL ) as BOOLCFURLRef projectURL  = fn URLByAppendingPathComponent( folderURL, fn StringWithFormat( @"%@.fbeproj", projectLabel ) )if ( fn FileManagerFileExistsAtURL( projectURL ) == NO ) then fn FileManagerCreateDirectoryAtURL( projectURL, YES, NULL )if ( fn AppCopyTemplateFile( @"Project", @"Settings2.plist", projectURL ) == NO ) then exit fn = NOend fn = fn AppWriteSource( fn AppProjectFile( projectLabel, edition, modelResources, hasCredits, hasLogo ), projectURL, @"data.fbproj" )/* *   the whole pipeline - returns YES when every file was written */// the four generation commandsbegin enum 1_genXIBs          // every entity's Form and List parts_genXIB           // one entity's parts_genBinding       // <Entity> Binding.incl for every entity_genApp           // all of it: parts, binding code, Model.json, main program, runtimeend enumlocal fn AppGenerate( projectDict as CFDictionaryRef, folderURL as CFURLRef, projectLabel as CFStringRef, hostURL as CFStringRef, userName as CFStringRef, what as long, onlyName as CFStringRef ) as BOOLCFMutableArrayRef modelResources = fn MutableArrayNewCFStringRef       only = NULLCFStringRef       about = fn DictionaryObjectForKey( projectDict, @"about" )CFStringRef       tagline = fn DictionaryObjectForKey( projectDict, @"tagline" )CFStringRef       copyright = fn DictionaryObjectForKey( projectDict, @"copyright" )CFStringRef       logoPath = fn DictionaryObjectForKey( projectDict, @"logoPath" )CFStringRef       appSymbol = fn DictionaryObjectForKey( projectDict, @"appSymbol" )CFURLRef          logoURLBOOL              hasLogo = NOCFStringRef       databasePath = fn DictionaryObjectForKey( projectDict, @"source" )CFStringRef       edition = fn EditionOfProject( projectDict )CFStringRef       refusalCFArrayRef        runtimeFiles = fn AppRuntimeFiles( edition )CFStringRef       runtimeFilelong              xibCountBOOL              ok = YESif ( fn StringHasSuffix( hostURL, @"/" ) ) then hostURL = fn StringSubstringToIndex( hostURL, fn StringLength( hostURL ) - 1 )if ( what == _genXIB ) then only = onlyNamexibCount = fn XibGenerateProject( projectDict, folderURL, projectLabel, modelResources, ( what != _genBinding ), only )if ( fn ArrayCount( modelResources ) == 0 ) then exit fn = NOif ( what == _genXIBs || what == _genXIB ) then exit fn = ( xibCount > 0 )if ( fn BindingGenerateProject( modelResources, folderURL, NULL ) == 0 ) then ok = NOif ( what == _genBinding ) then exit fn = ok// the runtime and the templates come from the workspace (installed from the repository once)if ( fn StudioLibraryReady == NO ) then exit fn = NOif ( about == NULL ) then about = @""if ( tagline == NULL ) then tagline = @""if ( appSymbol == NULL ) then appSymbol = @"building.2"if ( copyright == NULL || fn StringLength( copyright ) == 0 ) then copyright = fn StringWithFormat( @"© %@", projectLabel )// the app's logo (Project Settings): AppLogo.png beside the project, listed as a resourcelogoURL = fn URLByAppendingPathComponent( folderURL, @"AppLogo.png" )if ( fn FileManagerFileExistsAtURL( logoURL ) ) then fn FileManagerRemoveItemAtURL( logoURL )if ( logoPath != NULL )if ( fn FileManagerFileExistsAtURL( fn URLFileURLWithPath( logoPath ) ) ) then hasLogo = fn FileManagerCopyItemAtURL( fn URLFileURLWithPath( logoPath ), logoURL )end if// the data runtime works on the project's SQLite copy; an ALS model (metadata JSON, models.py,// app_model.yaml, admin.yaml) is no databaseif ( databasePath == NULL ) then databasePath = @""if ( fn StringIsEqual( fn StringLowercaseString( fn StringPathExtension( databasePath ) ), @"json" ) ) then databasePath = @""if ( fn StringIsEqual( fn StringLowercaseString( fn StringPathExtension( databasePath ) ), @"py" ) ) then databasePath = @""if ( fn StringIsEqual( fn StringLowercaseString( fn StringPathExtension( databasePath ) ), @"yaml" ) ) then databasePath = @""if ( fn StringIsEqual( fn StringLowercaseString( fn StringPathExtension( databasePath ) ), @"yml" ) ) then databasePath = @""// can this edition make an app of this project?  (Lite: it needs the SQLite database)refusal = fn EditionRefusal( edition, ( fn StringLength( databasePath ) > 0 ) )if ( refusal != NULL )alert 1, NSAlertStyleInformational, @"The app was not generated.", refusal, @[@"OK"], NOexit fn = NOend ifok = fn AppWriteModel( modelResources, folderURL, projectLabel, about, databasePath ) && okif ( fn AppWriteCredits( about, folderURL ) == NO ) then ok = NOif ( fn AppWriteSource( fn AppMainProgram( projectLabel, edition, hostURL, userName ), folderURL, fn StringWithFormat( @"%@.main", projectLabel ) ) == NO ) then ok = NOif ( fn AppWriteProject( projectLabel, edition, modelResources, folderURL, ( fn StringLength( about ) > 0 ), hasLogo ) == NO ) then ok = NOif ( fn AppCopyTemplateFile( @"App", @"EventHandlers.incl", folderURL ) == NO ) then ok = NOif ( fn AppCopyTemplateFile( @"App", @"Menus.incl", folderURL ) == NO ) then ok = NOif ( fn AppCopyTemplateFile( @"App", @"Rules.incl", folderURL ) == NO ) then ok = NOif ( fn AppWriteSourceIfMissing( @"// Studio Rules.incl - generated from the project's Rules.json\n\nvoid local fn DeclareStudioRules\nend fn\n", folderURL, @"Studio Rules.incl" ) == NO ) then ok = NOif ( fn AppWriteSourceIfMissing( fn AppWindowsSource, folderURL, @"Windows.incl" ) == NO ) then ok = NOif ( fn AppCopyTemplateFile( @"App", @"Theme.incl", folderURL ) == NO ) then ok = NOif ( fn AppWriteSource( fn AppPagesSource( modelResources, tagline, copyright, appSymbol ), folderURL, @"App Pages.incl" ) == NO ) then ok = NO// App Headers.incl: FutureBasic's own headers, included from source so FB finds them in its// Headers folder (listed as project items, FB looks beside the project and crashes)if ( fn AppWriteSource( @"// App Headers.incl - FutureBasic's own headers, from your FB install (never copied)\n\ninclude \"NSLog.incl\"\n", folderURL, @"App Headers.incl" ) == NO ) then ok = NO// README.md: a developer's tour of the project (LF line endings: it is Markdown)fn StringWriteToURL( fn AppDeveloperReadme( projectLabel, edition ), fn URLByAppendingPathComponent( folderURL, @"README.md" ), YES, NSUTF8StringEncoding, NULL )for runtimeFile in runtimeFilesif ( fn AppCopyRuntimeFile( runtimeFile, folderURL ) == NO ) then ok = NOnextif (isLoggingOn) then NSLog( @"Generated %@: %ld views, %@", projectLabel, xibCount, fn URLPath( folderURL ) )end fn = ok