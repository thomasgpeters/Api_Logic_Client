/* *   I M A G E R Y    B U S I N E S S     S Y S T E M S,   L L C * *   App Generator * *   model -> a complete FutureBasic project in *   ~/Library/Application Support/Api_Logic_Client/workspace/<project>/ * *       <project>.fbeproj   the FB project: Settings2.plist (template) + data.fbproj (groups *                           Runtime, Model, Bindings, Resources, Controller, View, Main) *       <project>.main      main program: connection settings, handler registration, start *       EventHandlers.incl  starting templates - written only when missing, then the *       Menus.incl          developer's: event handlers, menus, and the window with *       Windows.incl        the nibview call for each entity's Form part *       Model.json          resources, fields, kinds and tags - read at run time by ALS App.incl *       Credits.rtf         the designer's About text - the standard About box shows it *       Model Tags.incl     tag constants for your own code *       <Entity> Binding.incl  record <-> Form / List code per entity (Binding Generator.incl) *       <Resource>List.xib  list part per resource: table, one column per attribute *       <Resource>Form.xib  scalar part per resource: the record's fields (XIB Generator.incl) *       Data SQLite / DataObject / Data Model / Data Records   the data runtime: SQLite, *                           the query builder, Model.json entities, records (copied from ../Runtime) *       ALS Client.incl     ALS JSON:API client         \ *       ALS Binding.incl    record <-> control binding   >  runtime, copied from ../Runtime via this app's bundle *       ALS App.incl        master-detail window/events / * *   The generated project contains only our own code; it relies on the user's *   FutureBasic install for the Cocoa toolboxes, which are never copied. */#define APP_DEFAULT_LOGIN_PATH  @"/api/auth/login"#define APP_FALLBACK_LOGIN_PATH @"/api/authentication-User/login"#define APP_DEFAULT_PAGE_LIMIT  100// FB source files use classic-Mac line endingslocal fn AppWriteSource( source as CFStringRef, folderURL as CFURLRef, fileName as CFStringRef ) as BOOLErrorRef err = NULLCFURLRef url = fn URLByAppendingPathComponent( folderURL, fileName )BOOL     ok  = fn StringWriteToURL( fn StringByReplacingOccurrencesOfString( source, @"\n", @"\r" ), url, YES, NSUTF8StringEncoding, @err )if ( ok == NO && isLoggingOn ) then NSLog( @"Could not write %@: %@", fn URLPath( url ), fn ErrorLocalizedDescription( err ) )end fn = ok// text safe to place inside an FB @"..." literallocal fn AppQuote( s as CFStringRef ) as CFStringRefif ( s == NULL ) then exit fn = @""s = fn StringByReplacingOccurrencesOfString( s, @"\\", @"\\\\" )end fn = fn StringByReplacingOccurrencesOfString( s, @"\"", @"\\\"" )// the runtime copied into every generated app, in build order (data runtime first)local fn AppRuntimeFiles as CFArrayRefend fn = @[ @"Data SQLite.incl", @"DataObject.glbl", @"DataObject_Super.incl", @"DataObject.incl", @"Data Model.incl", @"Data Records.incl", @"Binding Support.incl", @"ALS Client.incl", @"ALS Binding.incl", @"ALS App.incl" ]local fn AppCopyRuntimeFile( fileName as CFStringRef, folderURL as CFURLRef ) as BOOLCFURLRef srcURL, dstURLsrcURL = fn BundleURLForResource( fn BundleMain, fn StringByDeletingPathExtension( fileName ), fn StringPathExtension( fileName ), @"Runtime" )   // the bundled Runtime folderif ( srcURL == NULL )if (isLoggingOn) then NSLog( @"Runtime/%@ is not in the app bundle - check resources \"../Runtime\" in the FB project.", fileName )exit fn = NOend ifdstURL = fn URLByAppendingPathComponent( folderURL, fileName )if ( fn FileManagerFileExistsAtURL( dstURL ) ) then fn FileManagerRemoveItemAtURL( dstURL )if ( fn FileManagerCopyItemAtURL( srcURL, dstURL ) == NO )if (isLoggingOn) then NSLog( @"Could not copy %@ to %@", fileName, fn URLPath( dstURL ) )exit fn = NOend ifend fn = YES// starting template from the bundled Templates folder - copied only when missing,// so the developer's edits survive regenerationlocal fn AppCopyTemplateFile( subfolder as CFStringRef, fileName as CFStringRef, dstFolderURL as CFURLRef ) as BOOLCFURLRef srcURL, dstURLdstURL = fn URLByAppendingPathComponent( dstFolderURL, fileName )if ( fn FileManagerFileExistsAtURL( dstURL ) ) then exit fn = YESsrcURL = fn BundleURLForResource( fn BundleMain, fn StringByDeletingPathExtension( fileName ), fn StringPathExtension( fileName ), fn StringWithFormat( @"Templates/%@", subfolder ) )if ( srcURL == NULL )if (isLoggingOn) then NSLog( @"Templates/%@/%@ is not in the app bundle - check resources \"../Templates\" in the FB project.", subfolder, fileName )exit fn = NOend ifif ( fn FileManagerCopyItemAtURL( srcURL, dstURL ) == NO )if (isLoggingOn) then NSLog( @"Could not copy %@ to %@", fileName, fn URLPath( dstURL ) )exit fn = NOend ifend fn = YES// starting Windows.incl: the shell window plus a nibview per entity Form part -// written only when missing (the runtime loads any part this file leaves out)local fn AppWindowsSource( modelResources as CFArrayRef ) as CFStringRefCFMutableStringRef s = fn MutableStringNewCFDictionaryRef    resourceCFStringRef        prefixMutableStringAppendString( s, @"/*\n *   Windows.incl\n *\n" )MutableStringAppendString( s, @" *   Starting template from Api Logic Client: created once, then yours.\n" )MutableStringAppendString( s, @" *   Regeneration never overwrites it (delete it to get a fresh copy).\n" )MutableStringAppendString( s, @" *   Entity parts added to the model later are loaded by the runtime.\n */\n\n" )MutableStringAppendString( s, @"void local fn BuildWindows( title as CFStringRef )\n" )MutableStringAppendString( s, @"long x = fn ALSPartX\n\n" )MutableStringAppendString( s, @"// the shell: login bar, entity list, buttons, status\n" )MutableStringAppendString( s, @"fn ALSBuildWindow( title )\n\n" )MutableStringAppendString( s, @"// each entity's Form part, from its generated XIB - hidden until the entity is selected\n" )for resource in modelResourcesprefix = fn XibResourcePrefix( fn DictionaryObjectForKey( resource, @"name" ) )MutableStringAppendString( s, fn StringWithFormat( @"nibview _%@View, @\"%@\", , ( x, _alsButtonBarH )\n", prefix, fn DictionaryObjectForKey( resource, @"formNib" ) ) )MutableStringAppendString( s, fn StringWithFormat( @"ViewSetHidden( _%@View, YES )\n", prefix ) )nextMutableStringAppendString( s, @"end fn\n" )end fn = s// a generated source file only when missing - for starting templateslocal fn AppWriteSourceIfMissing( source as CFStringRef, folderURL as CFURLRef, fileName as CFStringRef ) as BOOLif ( fn FileManagerFileExistsAtURL( fn URLByAppendingPathComponent( folderURL, fileName ) ) ) then exit fn = YESend fn = fn AppWriteSource( source, folderURL, fileName )local fn AppWriteModel( modelResources as CFArrayRef, folderURL as CFURLRef, projectLabel as CFStringRef, about as CFStringRef, databasePath as CFStringRef ) as BOOLCFDataRef jsonErrorRef  err = NULLCFURLRef  url = fn URLByAppendingPathComponent( folderURL, @"Model.json" )// "database": the project's SQLite copy, opened by the data runtime (Data Records.incl: DataOpen)json = fn JSONSerializationDataWithJSONObject( @{ @"project":projectLabel, @"about":about, @"database":databasePath, @"resources":modelResources }, NSJSONWritingPrettyPrinted, @err )if ( json == NULL ) then exit fn = NOif ( fn DataWriteToURL( json, url, NSDataWritingAtomic, @err ) == NO )if (isLoggingOn) then NSLog( @"Could not write %@: %@", fn URLPath( url ), fn ErrorLocalizedDescription( err ) )exit fn = NOend ifend fn = YES// Credits.rtf - FB's About menu item opens the standard About box, which shows the// bundle's Credits.rtf under the app's name, icon and version.  No colour is set, so// the text follows light and dark mode.  No About text: no file.local fn AppWriteCredits( about as CFStringRef, folderURL as CFURLRef ) as BOOLCFURLRef  url = fn URLByAppendingPathComponent( folderURL, @"Credits.rtf" )CFDataRef rtfErrorRef  err = NULLif ( fn FileManagerFileExistsAtURL( url ) ) then fn FileManagerRemoveItemAtURL( url )if ( fn StringLength( about ) == 0 ) then exit fn = YESrtf = fn AttributedStringRTFFromRange( fn AttributedStringWithString( about ), fn CFRangeMake( 0, fn StringLength( about ) ), NULL )if ( rtf == NULL ) then exit fn = NOif ( fn DataWriteToURL( rtf, url, NSDataWritingAtomic, @err ) == NO )if (isLoggingOn) then NSLog( @"Could not write %@: %@", fn URLPath( url ), fn ErrorLocalizedDescription( err ) )exit fn = NOend ifend fn = YESlocal fn AppMainProgram( projectLabel as CFStringRef, modelResources as CFArrayRef, hostURL as CFStringRef, userName as CFStringRef, databasePath as CFStringRef ) as CFStringRefCFMutableStringRef s = fn MutableStringNewCFStringRef        securityOn = @"NO"if ( fn StringLength( userName ) > 0 ) then securityOn = @"YES"MutableStringAppendString( s, fn StringWithFormat( @"/*\n *   %@\n *\n", projectLabel ) )MutableStringAppendString( s, fn StringWithFormat( @" *   Generated by Api Logic Client from %@/metadata\n", hostURL ) )MutableStringAppendString( s, @" *   Regenerating overwrites every generated file, including this one.\n" )MutableStringAppendString( s, @" *   Your code goes in EventHandlers.incl, Menus.incl and Windows.incl (never overwritten).\n */\n\n" )MutableStringAppendString( s, @"\n// connection\n" )MutableStringAppendString( s, fn StringWithFormat( @"gALSHost              = @\"%@\"\n", fn AppQuote( hostURL ) ) )MutableStringAppendString( s, fn StringWithFormat( @"gALSLoginPath         = @\"%@\"   // stock ALS\n", APP_DEFAULT_LOGIN_PATH ) )MutableStringAppendString( s, fn StringWithFormat( @"gALSFallbackLoginPath = @\"%@\"   // tried when the first is not found\n", APP_FALLBACK_LOGIN_PATH ) )MutableStringAppendString( s, fn StringWithFormat( @"gALSUser              = @\"%@\"\n", fn AppQuote( userName ) ) )MutableStringAppendString( s, fn StringWithFormat( @"gALSSecurityOn        = %@\n", securityOn ) )MutableStringAppendString( s, fn StringWithFormat( @"gALSPageLimit         = %ld\n\n", (long)APP_DEFAULT_PAGE_LIMIT ) )MutableStringAppendString( s, @"isLoggingOn = YES                     // runtime trace in the NSLog window\n\n" )MutableStringAppendString( s, @"// handlers are in EventHandlers.incl\n" )MutableStringAppendString( s, @"on appevent fn DoAppEvent\n" )MutableStringAppendString( s, @"on menu fn DoMenu\n" )MutableStringAppendString( s, @"on dialog fn DoDialog\n\n" )if ( fn StringLength( databasePath ) > 0 ) then MutableStringAppendString( s, @"fn DataOpen( NULL )                    // the project's SQLite database (Model.json)\n" )MutableStringAppendString( s, @"if ( fn ALSAppStart )\n" )MutableStringAppendString( s, @"fn BuildMenus                          // Menus.incl\n" )MutableStringAppendString( s, fn StringWithFormat( @"fn BuildWindows( @\"%@\" )   // Windows.incl\n", fn AppQuote( projectLabel ) ) )MutableStringAppendString( s, @"fn ALSAppReady\n" )MutableStringAppendString( s, @"end if\n\n" )MutableStringAppendString( s, @"HandleEvents\n" )end fn = s// the project file: one FB editor group per concern, in build orderlocal fn AppProjectFile( projectLabel as CFStringRef, modelResources as CFArrayRef, hasCredits as BOOL ) as CFStringRefCFMutableStringRef s = fn MutableStringNewCFDictionaryRef    resourceCFArrayRef         runtimeFiles = fn AppRuntimeFilesCFStringRef        runtimeFileMutableStringAppendString( s, @"include \"NSLog.incl\"\n" )                        // FB's own header, from the user's FB installMutableStringAppendString( s, @"// \"Runtime\" 1\n" )for runtimeFile in runtimeFilesMutableStringAppendString( s, fn StringWithFormat( @"include \"%@\"\n", runtimeFile ) )nextMutableStringAppendString( s, @"// \"Model\" 1\ninclude \"Model Tags.incl\"\n" )MutableStringAppendString( s, @"// \"Bindings\" 1\n" )for resource in modelResourcesMutableStringAppendString( s, fn StringWithFormat( @"include \"%@ Binding.incl\"\n", fn DictionaryObjectForKey( resource, @"name" ) ) )nextMutableStringAppendString( s, @"// \"Resources\" 1\nresources \"Model.json\"\n" )if ( hasCredits ) then MutableStringAppendString( s, @"resources \"Credits.rtf\"\n" )for resource in modelResourcesMutableStringAppendString( s, fn StringWithFormat( @"resources \"%@.xib\"\n", fn DictionaryObjectForKey( resource, @"formNib" ) ) )MutableStringAppendString( s, fn StringWithFormat( @"resources \"%@.xib\"\n", fn DictionaryObjectForKey( resource, @"listNib" ) ) )nextMutableStringAppendString( s, @"// \"Controller\" 1\ninclude \"EventHandlers.incl\"\n" )MutableStringAppendString( s, @"// \"View\" 1\ninclude \"Menus.incl\"\ninclude \"Windows.incl\"\n" )MutableStringAppendString( s, fn StringWithFormat( @"// \"Main\" 1\ninclude \"%@.main\"\n", projectLabel ) )end fn = s// <project>.fbeproj: Settings2.plist from the template (only when missing - the// developer's build settings survive regeneration) and a generated data.fbprojlocal fn AppWriteProject( projectLabel as CFStringRef, modelResources as CFArrayRef, folderURL as CFURLRef, hasCredits as BOOL ) as BOOLCFURLRef projectURL  = fn URLByAppendingPathComponent( folderURL, fn StringWithFormat( @"%@.fbeproj", projectLabel ) )if ( fn FileManagerFileExistsAtURL( projectURL ) == NO ) then fn FileManagerCreateDirectoryAtURL( projectURL, YES, NULL )if ( fn AppCopyTemplateFile( @"Project", @"Settings2.plist", projectURL ) == NO ) then exit fn = NOend fn = fn AppWriteSource( fn AppProjectFile( projectLabel, modelResources, hasCredits ), projectURL, @"data.fbproj" )/* *   the whole pipeline - returns YES when every file was written */// the four generation commandsbegin enum 1_genXIBs          // every entity's Form and List parts_genXIB           // one entity's parts_genBinding       // <Entity> Binding.incl for every entity_genApp           // all of it: parts, binding code, Model.json, main program, runtimeend enumlocal fn AppGenerate( projectDict as CFDictionaryRef, folderURL as CFURLRef, projectLabel as CFStringRef, hostURL as CFStringRef, userName as CFStringRef, what as long, onlyName as CFStringRef ) as BOOLCFMutableArrayRef modelResources = fn MutableArrayNewCFStringRef       only = NULLCFStringRef       about = fn DictionaryObjectForKey( projectDict, @"about" )CFStringRef       databasePath = fn DictionaryObjectForKey( projectDict, @"source" )CFArrayRef        runtimeFiles = fn AppRuntimeFilesCFStringRef       runtimeFilelong              xibCountBOOL              ok = YESif ( fn StringHasSuffix( hostURL, @"/" ) ) then hostURL = fn StringSubstringToIndex( hostURL, fn StringLength( hostURL ) - 1 )if ( what == _genXIB ) then only = onlyNamexibCount = fn XibGenerateProject( projectDict, folderURL, projectLabel, modelResources, ( what != _genBinding ), only )if ( fn ArrayCount( modelResources ) == 0 ) then exit fn = NOif ( what == _genXIBs || what == _genXIB ) then exit fn = ( xibCount > 0 )if ( fn BindingGenerateProject( modelResources, folderURL, NULL ) == 0 ) then ok = NOif ( what == _genBinding ) then exit fn = okif ( about == NULL ) then about = @""// the data runtime works on the project's SQLite copy; an ALS metadata file is no databaseif ( databasePath == NULL ) then databasePath = @""if ( fn StringIsEqual( fn StringLowercaseString( fn StringPathExtension( databasePath ) ), @"json" ) ) then databasePath = @""ok = fn AppWriteModel( modelResources, folderURL, projectLabel, about, databasePath ) && okif ( fn AppWriteCredits( about, folderURL ) == NO ) then ok = NOif ( fn AppWriteSource( fn AppMainProgram( projectLabel, modelResources, hostURL, userName, databasePath ), folderURL, fn StringWithFormat( @"%@.main", projectLabel ) ) == NO ) then ok = NOif ( fn AppWriteProject( projectLabel, modelResources, folderURL, ( fn StringLength( about ) > 0 ) ) == NO ) then ok = NOif ( fn AppCopyTemplateFile( @"App", @"EventHandlers.incl", folderURL ) == NO ) then ok = NOif ( fn AppCopyTemplateFile( @"App", @"Menus.incl", folderURL ) == NO ) then ok = NOif ( fn AppWriteSourceIfMissing( fn AppWindowsSource( modelResources ), folderURL, @"Windows.incl" ) == NO ) then ok = NOfor runtimeFile in runtimeFilesif ( fn AppCopyRuntimeFile( runtimeFile, folderURL ) == NO ) then ok = NOnextif (isLoggingOn) then NSLog( @"Generated %@: %ld views, %@", projectLabel, xibCount, fn URLPath( folderURL ) )end fn = ok