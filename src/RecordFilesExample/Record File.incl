/* *   Record File.incl - Record Files for FutureBasic: records of a fixed size in a random-access file * *   The way FutureBasic always could: a begin record ... end record type, written with open "R", record, *   write file and read file. Every record has the same size, so record n lives at n x the slot length: reading *   one record is one seek and one read, whatever the size of the file - nothing is loaded into memory. * *       fn RecordFileOpen( _customerFile, url, sizeof( CustomerRecord ) ) *       recordNumber = fn RecordFileAppend( _customerFile, @gCustomer, sizeof( CustomerRecord ) ) *       fn RecordFileRead( _customerFile, recordNumber, @gCustomer, sizeof( CustomerRecord ) ) *       fn RecordFileDelete( _customerFile, recordNumber )      // its slot is reused by the next append *       fn RecordFileClose( _customerFile ) * *   Slot 0 holds the file's header; slots 1, 2, 3 ... hold records, each behind 8 bytes: its status (live, free) *   and, when free, the next free slot. Records are found by number here, and by key with an index *   (Record Index.incl). The file format: docs/design/Record Files Design.md. * *   A file not closed cleanly (the program stopped) is checked when it is opened again: its live count and free *   list are rebuilt from the slots (RecordFileWasRecovered says so; its indexes should then be rebuilt). * *   MIT License. Copyright (c) 2026 Imagery Business Systems, LLC. See LICENSE. */_recordFileMagic   = 1178751556   // "FBRD"_recordFileVersion = 1_recordSlotLive    = 1_recordSlotFree    = 2begin record RecordFileHeader      // slot 0: 32 bytesUInt32 magicUInt32 versionUInt32 recordSizeUInt32 slotLengthUInt32 freeHead                    // the first free slot (0: none)UInt32 liveCountUInt32 closedCleanly               // 1 once closed; 0 while openUInt32 reservedend recordbegin record RecordSlotHeader      // in front of every record: 8 bytesUInt32 status                      // _recordSlotLive or _recordSlotFreeUInt32 nextFree                    // a free slot: the next free one (0: the last)end recordbegin globalslong gRecordFileSize(255)          // per file ID: the record's size (0: not open)long gRecordFileSlot(255)          // the slot's length: 8 + the record's sizelong gRecordFileFree(255)          // the first free slotlong gRecordFileLive(255)          // records in useBOOL gRecordFileRecovered(255)     // YES: it was not closed cleanly, and its counts were rebuilt when openedend globals// the file's header, as it is nowvoid local fn RecordFileWriteHeader( fileID as long, closedCleanly as long )RecordFileHeader headerheader.magic         = _recordFileMagicheader.version       = _recordFileVersionheader.recordSize    = gRecordFileSize(fileID)header.slotLength    = gRecordFileSlot(fileID)header.freeHead      = gRecordFileFree(fileID)header.liveCount     = gRecordFileLive(fileID)header.closedCleanly = closedCleanlyheader.reserved      = 0record #fileID, 0write file #fileID, @header, sizeof( RecordFileHeader )end fn// the slots in the file, slot 0 (the header) included: the next new record's numberlocal fn RecordFileSlotCount( fileID as long ) as longlong bytes = lof( fileID, 1 )end fn = ( bytes + gRecordFileSlot(fileID) - 1 ) / gRecordFileSlot(fileID)// a file not closed cleanly: count the live slots and chain the free ones againvoid local fn RecordFileRecover( fileID as long )RecordSlotHeader slotlong n, count = fn RecordFileSlotCount( fileID )gRecordFileFree(fileID) = 0gRecordFileLive(fileID) = 0for n = count - 1 to 1 step -1          // from the end, so the free list runs from the lowest slotrecord #fileID, nread file #fileID, @slot, sizeof( RecordSlotHeader )if ( slot.status == _recordSlotLive )gRecordFileLive(fileID) = gRecordFileLive(fileID) + 1elseslot.status   = _recordSlotFreeslot.nextFree = gRecordFileFree(fileID)record #fileID, nwrite file #fileID, @slot, sizeof( RecordSlotHeader )gRecordFileFree(fileID) = nend ifnextgRecordFileRecovered(fileID) = YESend fn// open (or create) a record file; records of recordSize bytes (at least 24). NO when it is not a record file of// that size. fileID: 1 to 255, not used by another open file.local fn RecordFileOpen( fileID as long, url as CFURLRef, recordSize as long ) as BOOLRecordFileHeader headerif ( fileID < 1 || fileID > 255 || recordSize < 24 || gRecordFileSize(fileID) != 0 ) then exit fn = NOgRecordFileSize(fileID) = recordSizegRecordFileSlot(fileID) = recordSize + sizeof( RecordSlotHeader )gRecordFileFree(fileID) = 0gRecordFileLive(fileID) = 0gRecordFileRecovered(fileID) = NOopen "R", fileID, url, gRecordFileSlot(fileID)if ( lof( fileID, 1 ) == 0 )             // newfn RecordFileWriteHeader( fileID, 0 )exit fn = YESend ifrecord #fileID, 0read file #fileID, @header, sizeof( RecordFileHeader )if ( header.magic != _recordFileMagic || header.version != _recordFileVersion || header.recordSize != recordSize )close #fileIDgRecordFileSize(fileID) = 0exit fn = NOend ifgRecordFileFree(fileID) = header.freeHeadgRecordFileLive(fileID) = header.liveCountif ( header.closedCleanly != 1 ) then fn RecordFileRecover( fileID )fn RecordFileWriteHeader( fileID, 0 )   // open: marked "not closed" until RecordFileCloseend fn = YESvoid local fn RecordFileClose( fileID as long )if ( fileID < 1 || fileID > 255 ) then exit fnif ( gRecordFileSize(fileID) == 0 ) then exit fnfn RecordFileWriteHeader( fileID, 1 )close #fileIDgRecordFileSize(fileID) = 0end fnlocal fn RecordFileWasRecovered( fileID as long ) as BOOLend fn = gRecordFileRecovered(fileID)local fn RecordFileCount( fileID as long ) as longend fn = gRecordFileLive(fileID)// is slot n a live record?local fn RecordFileIsLive( fileID as long, recordNumber as long ) as BOOLRecordSlotHeader slotif ( gRecordFileSize(fileID) == 0 || recordNumber < 1 ) then exit fn = NOif ( recordNumber >= fn RecordFileSlotCount( fileID ) ) then exit fn = NOrecord #fileID, recordNumberread file #fileID, @slot, sizeof( RecordSlotHeader )end fn = ( slot.status == _recordSlotLive )// a new record: in the first free slot, else at the end. Returns its record number (0: the file is not open).local fn RecordFileAppend( fileID as long, recordAddress as ptr, recordSize as long ) as longRecordSlotHeader slotlong recordNumberif ( gRecordFileSize(fileID) == 0 || recordSize != gRecordFileSize(fileID) ) then exit fn = 0recordNumber = gRecordFileFree(fileID)if ( recordNumber != 0 )record #fileID, recordNumberread file #fileID, @slot, sizeof( RecordSlotHeader )gRecordFileFree(fileID) = slot.nextFreeelserecordNumber = fn RecordFileSlotCount( fileID )end ifslot.status   = _recordSlotLiveslot.nextFree = 0record #fileID, recordNumberwrite file #fileID, @slot, sizeof( RecordSlotHeader )write file #fileID, recordAddress, recordSizegRecordFileLive(fileID) = gRecordFileLive(fileID) + 1end fn = recordNumber// record n into the memory at recordAddress; NO when there is no such live recordlocal fn RecordFileRead( fileID as long, recordNumber as long, recordAddress as ptr, recordSize as long ) as BOOLif ( recordSize != gRecordFileSize(fileID) ) then exit fn = NOif ( fn RecordFileIsLive( fileID, recordNumber ) == NO ) then exit fn = NOread file #fileID, recordAddress, recordSize        // the mark is just past the slot's 8 bytesend fn = YES// record n changed in placelocal fn RecordFileWrite( fileID as long, recordNumber as long, recordAddress as ptr, recordSize as long ) as BOOLif ( recordSize != gRecordFileSize(fileID) ) then exit fn = NOif ( fn RecordFileIsLive( fileID, recordNumber ) == NO ) then exit fn = NOwrite file #fileID, recordAddress, recordSizeend fn = YES// record n is removed: its slot goes on the free list (its bytes stay until the slot is reused)local fn RecordFileDelete( fileID as long, recordNumber as long ) as BOOLRecordSlotHeader slotif ( fn RecordFileIsLive( fileID, recordNumber ) == NO ) then exit fn = NOslot.status   = _recordSlotFreeslot.nextFree = gRecordFileFree(fileID)record #fileID, recordNumberwrite file #fileID, @slot, sizeof( RecordSlotHeader )gRecordFileFree(fileID) = recordNumbergRecordFileLive(fileID) = gRecordFileLive(fileID) - 1end fn = YES// the next live record after recordNumber, in the file's order (0 starts at the beginning); 0 at the endlocal fn RecordFileNext( fileID as long, recordNumber as long ) as longRecordSlotHeader slotlong n, count = fn RecordFileSlotCount( fileID )for n = recordNumber + 1 to count - 1record #fileID, nread file #fileID, @slot, sizeof( RecordSlotHeader )if ( slot.status == _recordSlotLive ) then exit fn = nnextend fn = 0// the file's size in byteslocal fn RecordFileBytes( fileID as long ) as longend fn = lof( fileID, 1 )/* *   Text in a record: FutureBasic's Str15 / Str63 / Str255 fields hold Pascal strings (a length byte, then the *   text). These two move a CFString in and out of such a field: UTF-8, cut on a character's edge to fit. */BeginCFunctionvoid RecordSetText( void *field, long maxLength, CFStringRef text ) {    UInt8 *p = (UInt8 *)field;    CFIndex used = 0;    if ( maxLength > 255 ) maxLength = 255;    if ( text != NULL ) CFStringGetBytes( text, CFRangeMake( 0, CFStringGetLength( text ) ), kCFStringEncodingUTF8, 0, false, p + 1, maxLength, &used );    p[0] = (UInt8)used;}CFStringRef RecordText( void *field ) {    UInt8 *p = (UInt8 *)field;    CFStringRef s = CFStringCreateWithBytes( NULL, p + 1, p[0], kCFStringEncodingUTF8, false );    if ( s == NULL ) return CFSTR( "" );    CFAutorelease( s );    return s;}EndCtoolbox RecordSetText( ptr field, long maxLength, CFStringRef text )toolbox fn RecordText( ptr field ) = CFStringRef