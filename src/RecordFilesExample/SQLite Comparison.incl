/* *   SQLite Comparison.incl - the same work in SQLite, timed the same way * *   Three tables with the same columns as the records, an index on each key the record files index, every row *   inserted in one transaction; then the same lookups (the same random customers, Sample Data.incl), the same *   orders per customer, the same scan by name. Needs -lsqlite3 (Build Settings, as in the project). * *   MIT License. Copyright (c) 2026 Imagery Business Systems, LLC. See LICENSE. */BeginCDeclaration#include <sqlite3.h>EndCBeginCFunction/* --- sqlite comparison core (portable C: tools/check_record_files_example.py compiles and runs exactly this) --- */#include <time.h>#include <sys/time.h>static sqlite3 *sqDb = NULL;static long sqLastRows = 0;static double sqNow( void ) { struct timeval tv; gettimeofday( &tv, NULL ); return tv.tv_sec + tv.tv_usec / 1e6; }static int sqExec( const char *sql ) { return sqlite3_exec( sqDb, sql, NULL, NULL, NULL ) == SQLITE_OK; }void SQLiteCloseDatabase( void ) { if ( sqDb ) sqlite3_close( sqDb ); sqDb = NULL; }long SQLiteLastRows( void ) { return sqLastRows; }/* a new database with every row: seconds, -1 on failure */double SQLiteBuildPath( const char *path, long customers, long ordersPer, long itemsPer ) {    sqlite3_stmt *c = NULL, *o = NULL, *it = NULL;    long i, j, k, orderId = 0, itemId = 0;    double t0;    SQLiteCloseDatabase();    remove( path );    if ( sqlite3_open( path, &sqDb ) != SQLITE_OK ) return -1;    t0 = sqNow();    if ( !sqExec( "CREATE TABLE Customer( CustomerId INTEGER PRIMARY KEY, Name TEXT, CreditLimit REAL, Discount REAL, Balance REAL, UnshippedOrders INTEGER )" )      || !sqExec( "CREATE TABLE \"Order\"( OrderId INTEGER PRIMARY KEY, CustomerId INTEGER, OrderDate INTEGER, ShippedDate INTEGER, Discount REAL, AmountTotal REAL, ItemCount INTEGER )" )      || !sqExec( "CREATE TABLE Item( ItemId INTEGER PRIMARY KEY, OrderId INTEGER, Product TEXT, Quantity REAL, UnitPrice REAL, Amount REAL )" )      || !sqExec( "CREATE INDEX CustomerName ON Customer( Name COLLATE NOCASE )" )      || !sqExec( "CREATE INDEX OrderCustomer ON \"Order\"( CustomerId )" )      || !sqExec( "CREATE INDEX ItemOrder ON Item( OrderId )" )      || !sqExec( "BEGIN" ) ) return -1;    sqlite3_prepare_v2( sqDb, "INSERT INTO Customer VALUES( ?, ?, ?, ?, ?, ? )", -1, &c, NULL );    sqlite3_prepare_v2( sqDb, "INSERT INTO \"Order\" VALUES( ?, ?, ?, ?, ?, ?, ? )", -1, &o, NULL );    sqlite3_prepare_v2( sqDb, "INSERT INTO Item VALUES( ?, ?, ?, ?, ?, ? )", -1, &it, NULL );    if ( c == NULL || o == NULL || it == NULL ) return -1;    for ( i = 1; i <= customers; i++ ) {        double discount = RBDiscount( i ), balance = 0;        long unshipped = 0;        char name[64];        for ( j = 1; j <= ordersPer; j++ ) {            double total = 0;            orderId++;            for ( k = 1; k <= itemsPer; k++ ) {                double q = RBQuantity( i, j, k ), p = RBUnitPrice( i, j, k ), amount = RBAmount( q, p, discount );                total += amount;                sqlite3_bind_int64( it, 1, ++itemId ); sqlite3_bind_int64( it, 2, orderId );                sqlite3_bind_text( it, 3, RBProductC( i, j, k ), -1, SQLITE_STATIC );                sqlite3_bind_double( it, 4, q ); sqlite3_bind_double( it, 5, p ); sqlite3_bind_double( it, 6, amount );                sqlite3_step( it ); sqlite3_reset( it );            }            sqlite3_bind_int64( o, 1, orderId ); sqlite3_bind_int64( o, 2, i );            sqlite3_bind_int64( o, 3, RBOrderDate( i, j ) ); sqlite3_bind_int64( o, 4, RBShippedDate( i, j ) );            sqlite3_bind_double( o, 5, discount ); sqlite3_bind_double( o, 6, total ); sqlite3_bind_int64( o, 7, itemsPer );            sqlite3_step( o ); sqlite3_reset( o );            if ( RBShippedDate( i, j ) == 0 ) { balance += total; unshipped++; }        }        RBCustomerNameC( i, name, sizeof name );        sqlite3_bind_int64( c, 1, i ); sqlite3_bind_text( c, 2, name, -1, SQLITE_TRANSIENT );        sqlite3_bind_double( c, 3, RBCreditLimit( i ) ); sqlite3_bind_double( c, 4, discount );        sqlite3_bind_double( c, 5, balance ); sqlite3_bind_int64( c, 6, unshipped );        sqlite3_step( c ); sqlite3_reset( c );    }    sqlite3_finalize( c ); sqlite3_finalize( o ); sqlite3_finalize( it );    if ( !sqExec( "COMMIT" ) ) return -1;    return sqNow() - t0;}/* closed and opened again: seconds */double SQLiteReopenPath( const char *path ) {    double t0 = sqNow();    SQLiteCloseDatabase();    if ( sqlite3_open( path, &sqDb ) != SQLITE_OK ) return -1;    sqExec( "SELECT count(*) FROM Customer" );        /* the schema read, as a first query does */    return sqNow() - t0;}/* customers by number, chosen at random: seconds; SQLiteLastRows says how many were found */double SQLiteFindCustomers( long lookups, long customers, long seed ) {    sqlite3_stmt *s = NULL;    long n;    double t0 = sqNow();    sqLastRows = 0;    if ( sqDb == NULL || sqlite3_prepare_v2( sqDb, "SELECT * FROM Customer WHERE CustomerId = ?", -1, &s, NULL ) != SQLITE_OK ) return -1;    RBSeed( seed );    for ( n = 0; n < lookups; n++ ) {        sqlite3_bind_int64( s, 1, RBRandom( customers ) );        if ( sqlite3_step( s ) == SQLITE_ROW ) { sqLastRows++; (void)sqlite3_column_text( s, 1 ); }        sqlite3_reset( s );    }    sqlite3_finalize( s );    return sqNow() - t0;}/* every order of customers chosen at random */double SQLiteOrdersOfCustomers( long lookups, long customers, long seed ) {    sqlite3_stmt *s = NULL;    long n;    double t0 = sqNow();    sqLastRows = 0;    if ( sqDb == NULL || sqlite3_prepare_v2( sqDb, "SELECT * FROM \"Order\" WHERE CustomerId = ? ORDER BY OrderId", -1, &s, NULL ) != SQLITE_OK ) return -1;    RBSeed( seed );    for ( n = 0; n < lookups; n++ ) {        sqlite3_bind_int64( s, 1, RBRandom( customers ) );        while ( sqlite3_step( s ) == SQLITE_ROW ) { sqLastRows++; (void)sqlite3_column_double( s, 5 ); }        sqlite3_reset( s );    }    sqlite3_finalize( s );    return sqNow() - t0;}/* every customer in name order */double SQLiteScanByName( void ) {    sqlite3_stmt *s = NULL;    double t0 = sqNow();    sqLastRows = 0;    if ( sqDb == NULL || sqlite3_prepare_v2( sqDb, "SELECT * FROM Customer ORDER BY Name COLLATE NOCASE", -1, &s, NULL ) != SQLITE_OK ) return -1;    while ( sqlite3_step( s ) == SQLITE_ROW ) { sqLastRows++; (void)sqlite3_column_text( s, 1 ); }    sqlite3_finalize( s );    return sqNow() - t0;}/* items removed at random, then as many added: seconds */double SQLiteDeleteAndAdd( long count, long items, long seed ) {    sqlite3_stmt *d = NULL, *a = NULL;    long n;    double t0 = sqNow();    sqLastRows = 0;    if ( sqDb == NULL || !sqExec( "BEGIN" ) ) return -1;    sqlite3_prepare_v2( sqDb, "DELETE FROM Item WHERE ItemId = ?", -1, &d, NULL );    sqlite3_prepare_v2( sqDb, "INSERT INTO Item VALUES( NULL, ?, 'Spare', 1, 10, 10 )", -1, &a, NULL );    if ( d == NULL || a == NULL ) return -1;    RBSeed( seed );    for ( n = 0; n < count; n++ ) {        sqlite3_bind_int64( d, 1, RBRandom( items ) );        sqlite3_step( d ); sqLastRows += sqlite3_changes( sqDb ); sqlite3_reset( d );    }    for ( n = 0; n < sqLastRows; n++ ) { sqlite3_bind_int64( a, 1, 1 + n % 100 ); sqlite3_step( a ); sqlite3_reset( a ); }    sqlite3_finalize( d ); sqlite3_finalize( a );    if ( !sqExec( "COMMIT" ) ) return -1;    return sqNow() - t0;}/* --- end sqlite comparison core --- */static int sqPath( CFURLRef url, char *path, long length ) {    return url != NULL && CFURLGetFileSystemRepresentation( url, true, (UInt8 *)path, length );}double SQLiteBuild( CFURLRef url, long customers, long ordersPer, long itemsPer ) {    char path[1024];    return sqPath( url, path, sizeof path ) ? SQLiteBuildPath( path, customers, ordersPer, itemsPer ) : -1;}double SQLiteReopen( CFURLRef url ) {    char path[1024];    return sqPath( url, path, sizeof path ) ? SQLiteReopenPath( path ) : -1;}EndCtoolbox fn SQLiteBuild( CFURLRef url, long customers, long ordersPer, long itemsPer ) = doubletoolbox fn SQLiteReopen( CFURLRef url ) = doubletoolbox fn SQLiteFindCustomers( long lookups, long customers, long seed ) = doubletoolbox fn SQLiteOrdersOfCustomers( long lookups, long customers, long seed ) = doubletoolbox fn SQLiteScanByName() = doubletoolbox fn SQLiteDeleteAndAdd( long count, long items, long seed ) = doubletoolbox fn SQLiteLastRows() = longtoolbox SQLiteCloseDatabase()