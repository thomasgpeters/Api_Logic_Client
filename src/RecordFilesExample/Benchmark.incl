/* *   Benchmark.incl - the example's run: the same data and the same questions, in record files and in SQLite * *   1. Build: every customer, order and item added (record files: each record and its index entries; *      SQLite: one transaction with its indexes), the files closed. *   2. Open again: how long until the first question can be asked (nothing is loaded into memory). *   3. Customers by number, chosen at random; 4. every order of customers chosen at random (an index on the *   customer's number, equal keys); 5. every customer in name order (a caseless text index); *   6. items removed at random and as many added (record files: the freed slots are reused); *   7. the indexes checked, and the files' sizes. * *   MIT License. Copyright (c) 2026 Imagery Business Systems, LLC. See LICENSE. */_benchOrdersPer = 5_benchItemsPer  = 4_benchLookups   = 10000_benchRemovals  = 1000_benchSeed      = 2026void local fn OutLine( textValue as CFStringRef, style as long )fn RichAppend( _outputView, textValue, style )if ( isLoggingOn ) then NSLog( @"%@", textValue )end fnvoid local fn OutClearTextSetString( _outputView, @"" )end fnlocal fn BenchNow as doubleend fn = fn CFAbsoluteTimeGetCurrent// text padded with spaces to a width (the table's first column)local fn BenchPad( textValue as CFStringRef, padWidth as long ) as CFStringRefCFMutableStringRef padded = fn MutableStringWithString( textValue )while ( fn StringLength( padded ) < padWidth )MutableStringAppendString( padded, @" " )wendend fn = padded// one row: what was done, the record files' time, SQLite's time, what came backvoid local fn BenchRow( what as CFStringRef, recordSeconds as double, sqliteSeconds as double, detail as CFStringRef )CFStringRef sqliteText = @"      -   "if ( sqliteSeconds >= 0 ) then sqliteText = fn StringWithFormat( @"%8.3f s ", sqliteSeconds )fn OutLine( fn StringWithFormat( @"%@ %8.3f s   %@   %@", fn BenchPad( what, 34 ), recordSeconds, sqliteText, detail ), _richTable )end fnlocal fn BenchMegabytes( bytes as long ) as CFStringRefend fn = fn StringWithFormat( @"%.1f MB", bytes / 1048576.0 )// the record files' bytes on disk: three record files and six indexeslocal fn BenchRecordFilesBytes as longCFArrayRef  names = @[ @"Customers.records", @"Orders.records", @"Items.records", @"Customers by Id.index", @"Customers by Name.index", @"Orders by Id.index", @"Orders by Customer.index", @"Items by Id.index", @"Items by Order.index" ]CFStringRef fileNamelong        bytes = 0for fileName in namesbytes = bytes + fn RBFileBytes( fn OrdersFileURL( fileName ) )nextend fn = bytes// every customer, its orders and their items (the same values SQLiteBuild writes)local fn BenchBuild( customers as long ) as BOOLlong   i, j, k, orderId = 0, itemId = 0, unshippeddouble discount, total, balanceif ( fn OrdersOpen( YES ) == NO ) then exit fn = NOfor i = 1 to customersdiscount  = fn RBDiscount( i )balance   = 0unshipped = 0for j = 1 to _benchOrdersPerorderId++total = 0for k = 1 to _benchItemsPeritemId++gItem.itemId    = itemIdgItem.orderId   = orderIdRecordSetText( @gItem.product, 63, fn RBProduct( i, j, k ) )gItem.quantity  = fn RBQuantity( i, j, k )gItem.unitPrice = fn RBUnitPrice( i, j, k )gItem.amount    = fn RBAmount( gItem.quantity, gItem.unitPrice, discount )total = total + gItem.amountfn OrdersAddItemnextgOrder.orderId     = orderIdgOrder.customerId  = igOrder.orderDate   = fn RBOrderDate( i, j )gOrder.shippedDate = fn RBShippedDate( i, j )gOrder.discount    = discountgOrder.amountTotal = totalgOrder.itemCount   = _benchItemsPerfn OrdersAddOrderif ( gOrder.shippedDate == 0 )balance = balance + totalunshipped++end ifnextgCustomer.customerId      = iRecordSetText( @gCustomer.name, 63, fn RBCustomerName( i ) )gCustomer.creditLimit     = fn RBCreditLimit( i )gCustomer.discount        = discountgCustomer.balance         = balancegCustomer.unshippedOrders = unshippedfn OrdersAddCustomernextfn OrdersCloseend fn = YESvoid local fn BenchRun( customers as long )CFURLRef    sqliteURL = fn OrdersFileURL( @"Comparison.sqlite" )long        orders = customers * _benchOrdersPer, items = orders * _benchItemsPerlong        n, found, rows, removed, itemsBefore, itemsAfterdouble      t0, secondsCFStringRef firstName = @"", lastName = @"", problemsfn OutClearfn OutLine( @"Record Files for FutureBasic", _richHeading )fn OutLine( @"Records of a fixed size in random-access files, found by B-tree indexes.", _richTagline )fn OutLine( fn StringWithFormat( @"%ld customers, %d orders each, %d items on each order: %ld records in three record files, with six indexes. Then the same in SQLite, with the same indexes.", customers, _benchOrdersPer, _benchItemsPer, customers + orders + items ), _richBody )fn OutLine( fn StringWithFormat( @"The files: %@", fn URLPath( fn OrdersFolderURL ) ), _richNote )fn OutLine( @"", _richBody )fn OutLine( fn StringWithFormat( @"%@   Record files      SQLite     ", fn BenchPad( @"", 34 ) ), _richTable )// 1. buildt0 = fn BenchNowif ( fn BenchBuild( customers ) == NO )fn OutLine( fn StringWithFormat( @"Stopped: %@", gOrdersProblem ), _richWarning )exit fnend ifseconds = fn BenchNow - t0fn BenchRow( @"1. Build", seconds, fn SQLiteBuild( sqliteURL, customers, _benchOrdersPer, _benchItemsPer ), fn StringWithFormat( @"%ld records", customers + orders + items ) )// 2. open againt0 = fn BenchNowif ( fn OrdersOpen( NO ) == NO )fn OutLine( fn StringWithFormat( @"Stopped: %@", gOrdersProblem ), _richWarning )exit fnend ifseconds = fn BenchNow - t0fn BenchRow( @"2. Open again", seconds, fn SQLiteReopen( sqliteURL ), fn StringWithFormat( @"%ld indexes rebuilt", gOrdersRebuilt ) )// 3. customers by numberRBSeed( _benchSeed )found = 0t0 = fn BenchNowfor n = 1 to _benchLookupsif ( fn OrdersFindCustomer( fn RBRandom( customers ) ) ) then found = found + 1nextseconds = fn BenchNow - t0fn BenchRow( fn StringWithFormat( @"3. %d customers by number", _benchLookups ), seconds, fn SQLiteFindCustomers( _benchLookups, customers, _benchSeed ), fn StringWithFormat( @"%ld found (SQLite %ld)", found, fn SQLiteLastRows ) )// 4. every order of a customerRBSeed( _benchSeed + 1 )rows = 0t0 = fn BenchNowfor n = 1 to _benchLookupsif ( fn OrdersFirstOrderOf( fn RBRandom( customers ) ) )rows++while ( fn OrdersNextOrder )rows++wendend ifnextseconds = fn BenchNow - t0fn BenchRow( fn StringWithFormat( @"4. The orders of %d customers", _benchLookups ), seconds, fn SQLiteOrdersOfCustomers( _benchLookups, customers, _benchSeed + 1 ), fn StringWithFormat( @"%ld orders (SQLite %ld)", rows, fn SQLiteLastRows ) )// 5. every customer by namerows = 0t0 = fn BenchNowif ( fn OrdersFirstCustomerByName )firstName = fn RecordText( @gCustomer.name )rows = 1while ( fn OrdersNextCustomerByName )rows++wendlastName = fn RecordText( @gCustomer.name )end ifseconds = fn BenchNow - t0fn BenchRow( @"5. Every customer by name", seconds, fn SQLiteScanByName, fn StringWithFormat( @"%ld customers (SQLite %ld)", rows, fn SQLiteLastRows ) )// 6. remove items at random, add as manyitemsBefore = fn RBFileBytes( fn OrdersFileURL( @"Items.records" ) )RBSeed( _benchSeed + 2 )removed = 0t0 = fn BenchNowfor n = 1 to _benchRemovalsif ( fn OrdersRemoveItem( fn RBRandom( items ) ) ) then removed = removed + 1nextfor n = 1 to removedgItem.itemId    = items + ngItem.orderId   = 1 + n mod 100RecordSetText( @gItem.product, 63, @"Spare" )gItem.quantity  = 1gItem.unitPrice = 10gItem.amount    = 10fn OrdersAddItemnextseconds = fn BenchNow - t0itemsAfter = fn RBFileBytes( fn OrdersFileURL( @"Items.records" ) )fn BenchRow( fn StringWithFormat( @"6. %d items removed, as many added", _benchRemovals ), seconds, fn SQLiteDeleteAndAdd( _benchRemovals, items, _benchSeed + 2 ), fn StringWithFormat( @"%ld removed; Items.records grew %ld bytes", removed, itemsAfter - itemsBefore ) )// 7. checkt0 = fn BenchNowproblems = fn OrdersCheckseconds = fn BenchNow - t0if ( fn StringLength( problems ) == 0 ) then problems = @"every index sound, one entry per record"fn BenchRow( @"7. Check the six indexes", seconds, -1, problems )fn OrdersCloseSQLiteCloseDatabase()fn OutLine( @"", _richBody )fn OutLine( fn StringWithFormat( @"On disk: the record files and indexes %@, SQLite %@.", fn BenchMegabytes( fn BenchRecordFilesBytes ), fn BenchMegabytes( fn RBFileBytes( sqliteURL ) ) ), _richBody )fn OutLine( fn StringWithFormat( @"By name, the first customer is %@ and the last %@.", firstName, lastName ), _richBody )fn OutLine( @"Times are wall-clock seconds on this Mac; run it twice and the second run reads warm files. The record files make no copy before writing (SQLite's journal does): a stop in the middle is caught when the files are opened again - the record file's counts are rebuilt from its slots and the indexes from the record file.", _richNote )end fn