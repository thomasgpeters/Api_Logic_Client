/* *   Sample Data.incl - the example's data: customers, their orders, the items on each order * *   The same data for the record files and for SQLite, made by formula from each record's number (no random *   numbers, so every run is alike); the lookups use one random sequence for both, from a seed. * *   MIT License. Copyright (c) 2026 Imagery Business Systems, LLC. See LICENSE. */BeginCFunction/* --- sample data core (portable C: tools/check_record_files_example.py compiles and runs exactly this) --- */#include <stdio.h>#include <string.h>#include <math.h>#include <sys/stat.h>static const char *rbLastNames[] = { "Adams", "Baker", "Clark", "Davis", "Evans", "Foster", "Garcia", "Hughes", "Irwin",    "Jensen", "Keller", "Lopez", "Morgan", "Nolan", "Ortiz", "Parker", "Quinn", "Reyes", "Stone", "Turner", "Underwood",    "Vargas", "Walsh", "Young", "Zimmer", "Brooks", "Castillo", "Doyle", "Ellis", "Fleming" };static const char *rbFirstNames[] = { "Alice", "Ben", "Carla", "David", "Elena", "Frank", "Grace", "Henry", "Iris",    "Jack", "Kate", "Leo", "Maria", "Nick", "Olivia", "Paul", "Rosa", "Sam", "Tina", "Victor" };static const char *rbProducts[] = { "Widget", "Gadget", "Sprocket", "Gizmo", "Bracket", "Flange", "Hinge", "Lever",    "Pulley", "Spring", "Valve", "Washer", "Bearing", "Coupling", "Gasket", "Nozzle" };#define RB_COUNT( a ) ( (long)( sizeof( a ) / sizeof( a[0] ) ) )static unsigned int rbSeedValue = 1;void RBSeed( long seed ) { rbSeedValue = (unsigned int)seed; }/* 1 ... n */long RBRandom( long n ) {    rbSeedValue = rbSeedValue * 1103515245u + 12345u;    return n > 0 ? (long)( ( rbSeedValue >> 8 ) % (unsigned int)n ) + 1 : 0;}void RBCustomerNameC( long i, char *out, long outLength ) {    snprintf( out, (size_t)outLength, "%s, %s %ld", rbLastNames[( i * 37 ) % RB_COUNT( rbLastNames )],        rbFirstNames[( i * 11 + i / RB_COUNT( rbLastNames ) ) % RB_COUNT( rbFirstNames )], i );}double RBCreditLimit( long i ) { return 5000.0 + ( i % 20 ) * 500.0; }double RBDiscount( long i ) { return ( i % 4 ) * 5.0; }long   RBOrderDate( long i, long j ) { return 20260101 + ( ( i + j ) % 12 ) * 100 + ( i * j ) % 28; }long   RBShippedDate( long i, long j ) { return ( j % 2 == 0 ) ? RBOrderDate( i, j ) + 3 : 0; }const char *RBProductC( long i, long j, long k ) { return rbProducts[( i + j * 3 + k * 7 ) % RB_COUNT( rbProducts )]; }double RBQuantity( long i, long j, long k ) { return (double)( 1 + ( i + j + k ) % 5 ); }double RBUnitPrice( long i, long j, long k ) { return 5.0 + ( ( i * 7 + j * 5 + k * 3 ) % 40 ) * 2.5; }/* quantity x price less the discount, to the cent */double RBAmount( double quantity, double unitPrice, double discount ) {    return floor( quantity * unitPrice * ( 100.0 - discount ) + 0.5 ) / 100.0;}long RBFileBytesPath( const char *path ) {    struct stat st;    return stat( path, &st ) == 0 ? (long)st.st_size : 0;}/* --- end sample data core --- */CFStringRef RBCustomerName( long i ) {    char name[64];    CFStringRef s;    RBCustomerNameC( i, name, sizeof name );    s = CFStringCreateWithCString( NULL, name, kCFStringEncodingUTF8 );    CFAutorelease( s );    return s;}CFStringRef RBProduct( long i, long j, long k ) {    CFStringRef s = CFStringCreateWithCString( NULL, RBProductC( i, j, k ), kCFStringEncodingUTF8 );    CFAutorelease( s );    return s;}long RBFileBytes( CFURLRef url ) {    char path[1024];    if ( url == NULL || !CFURLGetFileSystemRepresentation( url, true, (UInt8 *)path, sizeof path ) ) return 0;    return RBFileBytesPath( path );}EndCtoolbox RBSeed( long seed )toolbox fn RBRandom( long n ) = longtoolbox fn RBCustomerName( long i ) = CFStringReftoolbox fn RBCreditLimit( long i ) = doubletoolbox fn RBDiscount( long i ) = doubletoolbox fn RBOrderDate( long i, long j ) = longtoolbox fn RBShippedDate( long i, long j ) = longtoolbox fn RBProduct( long i, long j, long k ) = CFStringReftoolbox fn RBQuantity( long i, long j, long k ) = doubletoolbox fn RBUnitPrice( long i, long j, long k ) = doubletoolbox fn RBAmount( double quantity, double unitPrice, double discount ) = doubletoolbox fn RBFileBytes( CFURLRef url ) = long