/* *   Record Index.incl - Record Files for FutureBasic: B-tree indexes, one file each, in the manner of Btrieve * *   An index finds records in a record file (Record File.incl) by a key: a customer by its number, every order *   of a customer, every customer in name order. The key is made of segments - whole numbers and text - added *   one by one; equal keys are allowed (each entry also carries its record number, which keeps them apart). * *       h = fn RIOpen( url, 8, YES )                    // a new index whose keys are 8 bytes (one whole number) *       RIKeyClear( h ) : RIKeyAddLong( h, 42 )         // the key: 42 *       fn RIInsert( h, recordNumber )                  // record 42's entry *       recordNumber = fn RISeek( h, _riSeekEqual )     // the first record whose key is 42 (0: none) *       recordNumber = fn RINext( h )                   // then the next, in key order (0: the end) * *   The B-tree is C (between the markers below; tools/check_record_index.py compiles exactly that text and tests *   it against tools/record_files_reference.py). Its pages are 4 KB; recently read pages are kept in memory, so a *   lookup in a million entries reads three or four pages, most of them from memory. The file format: *   docs/design/Record Files Design.md. * *   MIT License. Copyright (c) 2026 Imagery Business Systems, LLC. See LICENSE. */// how RISeek positions: by the key being built, except First and Lastbegin enum 1_riSeekFirst_riSeekLast_riSeekEqual                // the first entry with exactly the key_riSeekGreaterOrEqual_riSeekGreater_riSeekLessOrEqual          // the last entry with the key, or the one before it_riSeekLessend enumBeginCDeclaration#include <fcntl.h>#include <unistd.h>EndCBeginCFunction/* --- record index core (portable C: tools/check_record_index.py compiles and tests exactly this) --- *//* *   A B-tree index in its own file, made of fixed-size pages, in the manner of Btrieve: a key is made of *   segments (a number, a text), and every entry is the key followed by the record number it points at, *   so equal keys are allowed and kept in record order. The file format is in docs/design/Record Files Design.md; *   tools/record_files_reference.py reads it independently and checks the tree. * *   Page 0 is the header. Pages 1... are nodes. A node starts with 16 bytes: leaf flag, entry count, the next *   and previous leaf (leaves are chained, so a scan never climbs the tree). Leaf entries are composites: *   key + record number (4 bytes, big-endian, so the bytes sort in order). Internal nodes: child 0, then *   count x (composite, child): child i + 1 holds the entries >= composite i. * *   Writes go straight to the file (pwrite); a cache keeps recently read pages. The header is written when the *   index is opened (marked "open") and when it is closed (marked "closed cleanly"): an index found "open" was *   not closed - the program stopped - and is rebuilt from its data file, which is the truth. */#include <stdint.h>#include <string.h>#include <stdlib.h>#include <stdio.h>#include <fcntl.h>#include <unistd.h>#define RI_PAGE_SIZE      4096#define RI_NODE_HEADER    16#define RI_MAX_KEY        240#define RI_MAX_OPEN       64#define RI_CACHE_PAGES    512#define RI_MAX_HEIGHT     32#define RI_MAGIC          0x46425249u     /* "FBRI" */#define RI_VERSION        1uenum { RI_SEEK_FIRST = 1, RI_SEEK_LAST, RI_SEEK_EQUAL, RI_SEEK_GREATER_OR_EQUAL, RI_SEEK_GREATER, RI_SEEK_LESS_OR_EQUAL, RI_SEEK_LESS };typedef struct {    int       fd;    uint32_t  keyLength, compositeLength, rootPage, pageCount, entryCount, height;    uint32_t  leafMax, internalMax;    int       wasClean;    uint8_t   key[RI_MAX_KEY + 4];         /* the key being built, segment by segment */    uint32_t  keyFill;    uint32_t  cursorPage, cursorIndex;     /* 0 page: no cursor */    uint8_t   cursorEntry[RI_MAX_KEY + 4];    uint32_t  cachePage[RI_CACHE_PAGES];   /* 0: empty (page 0 is never cached) */    uint8_t  *cacheData;    uint64_t  reads, writes;} RIIndex;static RIIndex *riOpen[RI_MAX_OPEN];static void riPut32( uint8_t *p, uint32_t v ) { p[0] = v & 255; p[1] = ( v >> 8 ) & 255; p[2] = ( v >> 16 ) & 255; p[3] = v >> 24; }static uint32_t riGet32( const uint8_t *p ) { return (uint32_t)p[0] | ( (uint32_t)p[1] << 8 ) | ( (uint32_t)p[2] << 16 ) | ( (uint32_t)p[3] << 24 ); }static void riPutBE32( uint8_t *p, uint32_t v ) { p[0] = v >> 24; p[1] = ( v >> 16 ) & 255; p[2] = ( v >> 8 ) & 255; p[3] = v & 255; }static uint32_t riGetBE32( const uint8_t *p ) { return ( (uint32_t)p[0] << 24 ) | ( (uint32_t)p[1] << 16 ) | ( (uint32_t)p[2] << 8 ) | p[3]; }static RIIndex *riIndex( long handle ) {    if ( handle < 1 || handle > RI_MAX_OPEN ) return NULL;    return riOpen[handle - 1];}/* --- pages --- */static int riReadPage( RIIndex *ix, uint32_t pageNo, uint8_t *out ) {    uint32_t slot = pageNo % RI_CACHE_PAGES;    if ( pageNo != 0 && ix->cachePage[slot] == pageNo ) { memcpy( out, ix->cacheData + (size_t)slot * RI_PAGE_SIZE, RI_PAGE_SIZE ); return 1; }    if ( pread( ix->fd, out, RI_PAGE_SIZE, (off_t)pageNo * RI_PAGE_SIZE ) != RI_PAGE_SIZE ) return 0;    ix->reads++;    if ( pageNo != 0 ) { ix->cachePage[slot] = pageNo; memcpy( ix->cacheData + (size_t)slot * RI_PAGE_SIZE, out, RI_PAGE_SIZE ); }    return 1;}static int riWritePage( RIIndex *ix, uint32_t pageNo, const uint8_t *page ) {    uint32_t slot = pageNo % RI_CACHE_PAGES;    if ( pwrite( ix->fd, page, RI_PAGE_SIZE, (off_t)pageNo * RI_PAGE_SIZE ) != RI_PAGE_SIZE ) return 0;    ix->writes++;    if ( pageNo != 0 ) { ix->cachePage[slot] = pageNo; memcpy( ix->cacheData + (size_t)slot * RI_PAGE_SIZE, page, RI_PAGE_SIZE ); }    return 1;}static int riWriteHeader( RIIndex *ix, uint32_t clean ) {    uint8_t page[RI_PAGE_SIZE];    memset( page, 0, sizeof page );    riPut32( page, RI_MAGIC ); riPut32( page + 4, RI_VERSION ); riPut32( page + 8, RI_PAGE_SIZE ); riPut32( page + 12, ix->keyLength );    riPut32( page + 16, ix->rootPage ); riPut32( page + 20, ix->pageCount ); riPut32( page + 24, ix->entryCount );    riPut32( page + 28, ix->height ); riPut32( page + 32, clean );    return riWritePage( ix, 0, page );}/* node fields */#define RI_IS_LEAF( p )      ( (p)[0] )#define RI_COUNT( p )        riGet32( (p) + 4 )#define RI_NEXT( p )         riGet32( (p) + 8 )#define RI_PREV( p )         riGet32( (p) + 12 )#define RI_LEAF_ENTRY( ix, p, i )   ( (p) + RI_NODE_HEADER + (size_t)(i) * (ix)->compositeLength )#define RI_CHILD0( p )              riGet32( (p) + RI_NODE_HEADER )#define RI_INNER_KEY( ix, p, i )    ( (p) + RI_NODE_HEADER + 4 + (size_t)(i) * ( (ix)->compositeLength + 4 ) )#define RI_INNER_CHILD( ix, p, i )  ( (i) == 0 ? RI_CHILD0( p ) : riGet32( RI_INNER_KEY( ix, p, (i) - 1 ) + (ix)->compositeLength ) )static void riNewNode( uint8_t *p, int leaf ) { memset( p, 0, RI_PAGE_SIZE ); p[0] = (uint8_t)leaf; }static uint32_t riAllocPage( RIIndex *ix ) { return ix->pageCount++; }/* first leaf entry >= composite (count when none) */static uint32_t riLeafLowerBound( RIIndex *ix, const uint8_t *page, const uint8_t *composite ) {    uint32_t lo = 0, hi = RI_COUNT( page );    while ( lo < hi ) {        uint32_t mid = ( lo + hi ) / 2;        if ( memcmp( RI_LEAF_ENTRY( ix, page, mid ), composite, ix->compositeLength ) < 0 ) lo = mid + 1; else hi = mid;    }    return lo;}/* the child to follow: the number of separators <= composite */static uint32_t riInnerChildIndex( RIIndex *ix, const uint8_t *page, const uint8_t *composite ) {    uint32_t lo = 0, hi = RI_COUNT( page );    while ( lo < hi ) {        uint32_t mid = ( lo + hi ) / 2;        if ( memcmp( RI_INNER_KEY( ix, page, mid ), composite, ix->compositeLength ) <= 0 ) lo = mid + 1; else hi = mid;    }    return lo;}/* --- open, create, close --- */long RIOpenPath( const char *path, long keyLength, long create ) {    int slot, fd;    RIIndex *ix;    uint8_t page[RI_PAGE_SIZE];    for ( slot = 0; slot < RI_MAX_OPEN && riOpen[slot] != NULL; slot++ ) ;    if ( slot == RI_MAX_OPEN || keyLength < 1 || keyLength > RI_MAX_KEY ) return 0;    fd = open( path, create ? ( O_RDWR | O_CREAT | O_TRUNC ) : O_RDWR, 0644 );    if ( fd < 0 ) return 0;    ix = calloc( 1, sizeof( RIIndex ) );    ix->cacheData = malloc( (size_t)RI_CACHE_PAGES * RI_PAGE_SIZE );    if ( ix == NULL || ix->cacheData == NULL ) { close( fd ); if ( ix ) free( ix ); return 0; }    ix->fd = fd;    if ( create ) {        ix->keyLength = (uint32_t)keyLength; ix->rootPage = 1; ix->pageCount = 2; ix->entryCount = 0; ix->height = 1; ix->wasClean = 1;        riNewNode( page, 1 );        if ( !riWritePage( ix, 1, page ) ) goto fail;    } else {        if ( pread( fd, page, RI_PAGE_SIZE, 0 ) != RI_PAGE_SIZE ) goto fail;        if ( riGet32( page ) != RI_MAGIC || riGet32( page + 4 ) != RI_VERSION || riGet32( page + 8 ) != RI_PAGE_SIZE ) goto fail;        ix->keyLength = riGet32( page + 12 );        if ( (long)ix->keyLength != keyLength ) goto fail;        ix->rootPage = riGet32( page + 16 ); ix->pageCount = riGet32( page + 20 ); ix->entryCount = riGet32( page + 24 );        ix->height = riGet32( page + 28 ); ix->wasClean = riGet32( page + 32 ) == 1;    }    ix->compositeLength = ix->keyLength + 4;    ix->leafMax = ( RI_PAGE_SIZE - RI_NODE_HEADER ) / ix->compositeLength;    ix->internalMax = ( RI_PAGE_SIZE - RI_NODE_HEADER - 4 ) / ( ix->compositeLength + 4 );    if ( !riWriteHeader( ix, 0 ) ) goto fail;           /* "open": not closed cleanly until RIClose */    riOpen[slot] = ix;    return slot + 1;fail:    close( fd ); free( ix->cacheData ); free( ix );    return 0;}void RIClose( long handle ) {    RIIndex *ix = riIndex( handle );    if ( ix == NULL ) return;    riWriteHeader( ix, 1 );    fsync( ix->fd );    close( ix->fd );    free( ix->cacheData ); free( ix );    riOpen[handle - 1] = NULL;}/* the header and the pages on disk now (the index stays open, still marked "open") */long RIFlush( long handle ) {    RIIndex *ix = riIndex( handle );    if ( ix == NULL ) return 0;    if ( !riWriteHeader( ix, 0 ) ) return 0;    return fsync( ix->fd ) == 0;}long RIWasClosedCleanly( long handle ) { RIIndex *ix = riIndex( handle ); return ix ? ix->wasClean : 0; }long RIEntryCount( long handle ) { RIIndex *ix = riIndex( handle ); return ix ? (long)ix->entryCount : 0; }long RIHeight( long handle ) { RIIndex *ix = riIndex( handle ); return ix ? (long)ix->height : 0; }long RIPageCount( long handle ) { RIIndex *ix = riIndex( handle ); return ix ? (long)ix->pageCount : 0; }long RIKeyLength( long handle ) { RIIndex *ix = riIndex( handle ); return ix ? (long)ix->keyLength : 0; }/* --- keys, segment by segment --- */void RIKeyClear( long handle ) { RIIndex *ix = riIndex( handle ); if ( ix ) ix->keyFill = 0; }/* a whole number: 8 bytes, the sign flipped and big-endian, so the bytes sort as the numbers do */void RIKeyAddLong( long handle, long value ) {    RIIndex *ix = riIndex( handle );    uint64_t u = (uint64_t)value ^ 0x8000000000000000ull;    int i;    if ( ix == NULL || ix->keyFill + 8 > ix->keyLength ) return;    for ( i = 0; i < 8; i++ ) ix->key[ix->keyFill + i] = (uint8_t)( u >> ( 56 - 8 * i ) );    ix->keyFill += 8;}/* text: width bytes, padded with zeros; caseless folds a-z to A-Z (other bytes sort as they are) */void RIKeyAddBytes( long handle, const void *textBytes, long length, long width, long caseless ) {    RIIndex *ix = riIndex( handle );    const uint8_t *text = (const uint8_t *)textBytes;    long i;    if ( ix == NULL || width < 0 || ix->keyFill + (uint32_t)width > ix->keyLength ) return;    if ( length > width ) length = width;    for ( i = 0; i < width; i++ ) {        uint8_t c = i < length ? text[i] : 0;        if ( caseless && c >= 'a' && c <= 'z' ) c -= 32;        ix->key[ix->keyFill + i] = c;    }    ix->keyFill += (uint32_t)width;}/* a Pascal string (a length byte, then the text): FB's Str15 / Str31 / Str63 / Str255 */void RIKeyAddPascal( long handle, void *pascalBytes, long width, long caseless ) {    const uint8_t *pascalText = (const uint8_t *)pascalBytes;    if ( pascalText == NULL ) { RIKeyAddBytes( handle, "", 0, width, caseless ); return; }    RIKeyAddBytes( handle, pascalText + 1, pascalText[0], width, caseless );}static int riKeyReady( RIIndex *ix ) { return ix != NULL && ix->keyFill == ix->keyLength; }static void riComposite( RIIndex *ix, uint32_t recordNumber, uint8_t *out ) {    memcpy( out, ix->key, ix->keyLength );    riPutBE32( out + ix->keyLength, recordNumber );}/* --- insert --- */long RIInsert( long handle, long recordNumber ) {    RIIndex *ix = riIndex( handle );    uint8_t composite[RI_MAX_KEY + 4], page[RI_PAGE_SIZE], right[RI_PAGE_SIZE];    uint32_t path[RI_MAX_HEIGHT], pathChild[RI_MAX_HEIGHT];    uint32_t pageNo, depth = 0, pos, count, i;    uint8_t carryKey[RI_MAX_KEY + 4];    uint32_t carryChild = 0;    if ( !riKeyReady( ix ) || recordNumber < 1 || recordNumber > 0x7FFFFFFF ) return 0;    ix->cursorPage = 0;    riComposite( ix, (uint32_t)recordNumber, composite );    pageNo = ix->rootPage;    for ( ;; ) {        if ( depth >= RI_MAX_HEIGHT || !riReadPage( ix, pageNo, page ) ) return 0;        path[depth] = pageNo;        if ( RI_IS_LEAF( page ) ) break;        pathChild[depth] = riInnerChildIndex( ix, page, composite );        pageNo = RI_INNER_CHILD( ix, page, pathChild[depth] );        depth++;    }    /* the leaf */    count = RI_COUNT( page );    pos = riLeafLowerBound( ix, page, composite );    if ( pos < count && memcmp( RI_LEAF_ENTRY( ix, page, pos ), composite, ix->compositeLength ) == 0 ) return 0;   /* already there */    if ( count < ix->leafMax ) {        memmove( RI_LEAF_ENTRY( ix, page, pos + 1 ), RI_LEAF_ENTRY( ix, page, pos ), (size_t)( count - pos ) * ix->compositeLength );        memcpy( RI_LEAF_ENTRY( ix, page, pos ), composite, ix->compositeLength );        riPut32( page + 4, count + 1 );        if ( !riWritePage( ix, pageNo, page ) ) return 0;        ix->entryCount++;        return 1;    }    {   /* split the leaf: count + 1 entries, the left keeps half */        uint8_t *all = malloc( (size_t)( count + 1 ) * ix->compositeLength );        uint32_t leftCount = ( count + 1 ) / 2, rightCount = count + 1 - leftCount, rightNo = riAllocPage( ix ), oldNext = RI_NEXT( page );        if ( all == NULL ) return 0;        memcpy( all, RI_LEAF_ENTRY( ix, page, 0 ), (size_t)pos * ix->compositeLength );        memcpy( all + (size_t)pos * ix->compositeLength, composite, ix->compositeLength );        memcpy( all + (size_t)( pos + 1 ) * ix->compositeLength, RI_LEAF_ENTRY( ix, page, pos ), (size_t)( count - pos ) * ix->compositeLength );        riNewNode( right, 1 );        memcpy( RI_LEAF_ENTRY( ix, right, 0 ), all + (size_t)leftCount * ix->compositeLength, (size_t)rightCount * ix->compositeLength );        riPut32( right + 4, rightCount ); riPut32( right + 8, oldNext ); riPut32( right + 12, pageNo );        memset( RI_LEAF_ENTRY( ix, page, 0 ), 0, RI_PAGE_SIZE - RI_NODE_HEADER );        memcpy( RI_LEAF_ENTRY( ix, page, 0 ), all, (size_t)leftCount * ix->compositeLength );        riPut32( page + 4, leftCount ); riPut32( page + 8, rightNo );        memcpy( carryKey, all + (size_t)leftCount * ix->compositeLength, ix->compositeLength );        free( all );        /* the new page first, then the old one that points at it */        if ( !riWritePage( ix, rightNo, right ) || !riWritePage( ix, pageNo, page ) ) return 0;        if ( oldNext != 0 ) {            uint8_t nextPage[RI_PAGE_SIZE];            if ( !riReadPage( ix, oldNext, nextPage ) ) return 0;            riPut32( nextPage + 12, rightNo );            if ( !riWritePage( ix, oldNext, nextPage ) ) return 0;        }        carryChild = rightNo;    }    ix->entryCount++;    /* the separator goes up, splitting internal nodes as needed */    while ( depth > 0 ) {        uint32_t at, parentNo;        depth--;        parentNo = path[depth];        if ( !riReadPage( ix, parentNo, page ) ) return 0;        count = RI_COUNT( page );        at = pathChild[depth];            /* the new key goes in at 'at'; its right child is carryChild */        if ( count < ix->internalMax ) {            uint32_t stride = ix->compositeLength + 4;            memmove( RI_INNER_KEY( ix, page, at + 1 ), RI_INNER_KEY( ix, page, at ), (size_t)( count - at ) * stride );            memcpy( RI_INNER_KEY( ix, page, at ), carryKey, ix->compositeLength );            riPut32( RI_INNER_KEY( ix, page, at ) + ix->compositeLength, carryChild );            riPut32( page + 4, count + 1 );            return riWritePage( ix, parentNo, page ) ? 1 : 0;        }        {   /* split the internal node: count + 1 keys; the middle one goes up */            uint32_t stride = ix->compositeLength + 4, total = count + 1, mid = total / 2, rightNo = riAllocPage( ix );            uint8_t *keys = malloc( (size_t)total * ix->compositeLength );            uint32_t *children = malloc( sizeof( uint32_t ) * ( total + 1 ) );            if ( keys == NULL || children == NULL ) { free( keys ); free( children ); return 0; }            for ( i = 0; i <= count; i++ ) children[i < at + 1 ? i : i + 1] = RI_INNER_CHILD( ix, page, i );            children[at + 1] = carryChild;            for ( i = 0; i < count; i++ ) memcpy( keys + (size_t)( i < at ? i : i + 1 ) * ix->compositeLength, RI_INNER_KEY( ix, page, i ), ix->compositeLength );            memcpy( keys + (size_t)at * ix->compositeLength, carryKey, ix->compositeLength );            /* left: keys 0..mid-1, children 0..mid */            riNewNode( page, 0 );            riPut32( page + RI_NODE_HEADER, children[0] );            for ( i = 0; i < mid; i++ ) {                memcpy( RI_INNER_KEY( ix, page, i ), keys + (size_t)i * ix->compositeLength, ix->compositeLength );                riPut32( RI_INNER_KEY( ix, page, i ) + ix->compositeLength, children[i + 1] );            }            riPut32( page + 4, mid );            /* right: keys mid+1.., children mid+1.. */            riNewNode( right, 0 );            riPut32( right + RI_NODE_HEADER, children[mid + 1] );            for ( i = mid + 1; i < total; i++ ) {                memcpy( RI_INNER_KEY( ix, right, i - mid - 1 ), keys + (size_t)i * ix->compositeLength, ix->compositeLength );                riPut32( RI_INNER_KEY( ix, right, i - mid - 1 ) + ix->compositeLength, children[i + 1] );            }            riPut32( right + 4, total - mid - 1 );            memcpy( carryKey, keys + (size_t)mid * ix->compositeLength, ix->compositeLength );            free( keys ); free( children );            (void)stride;            if ( !riWritePage( ix, rightNo, right ) || !riWritePage( ix, parentNo, page ) ) return 0;            carryChild = rightNo;        }    }    {   /* the root split: a new root above */        uint32_t newRoot = riAllocPage( ix );        riNewNode( page, 0 );        riPut32( page + RI_NODE_HEADER, ix->rootPage );        memcpy( RI_INNER_KEY( ix, page, 0 ), carryKey, ix->compositeLength );        riPut32( RI_INNER_KEY( ix, page, 0 ) + ix->compositeLength, carryChild );        riPut32( page + 4, 1 );        if ( !riWritePage( ix, newRoot, page ) ) return 0;        ix->rootPage = newRoot;        ix->height++;    }    return 1;}/* --- find --- *//* the leaf that holds the first entry >= composite, and its position there */static int riFindLeaf( RIIndex *ix, const uint8_t *composite, uint32_t *pageNo, uint32_t *pos, uint8_t *page ) {    uint32_t no = ix->rootPage, depth = 0;    for ( ;; ) {        if ( depth++ > RI_MAX_HEIGHT || !riReadPage( ix, no, page ) ) return 0;        if ( RI_IS_LEAF( page ) ) break;        no = RI_INNER_CHILD( ix, page, riInnerChildIndex( ix, page, composite ) );    }    *pageNo = no;    *pos = riLeafLowerBound( ix, page, composite );    return 1;}static long riCursorAt( RIIndex *ix, uint32_t pageNo, uint32_t pos, const uint8_t *page ) {    ix->cursorPage = pageNo; ix->cursorIndex = pos;    memcpy( ix->cursorEntry, RI_LEAF_ENTRY( ix, page, pos ), ix->compositeLength );    return (long)riGetBE32( ix->cursorEntry + ix->keyLength );}/* from (pageNo, pos) forward to the first entry there or after: skips the ends of leaves and empty leaves */static long riForwardFrom( RIIndex *ix, uint32_t pageNo, uint32_t pos, uint8_t *page ) {    uint32_t guard = 0;    while ( pos >= RI_COUNT( page ) ) {        uint32_t next = RI_NEXT( page );        if ( next == 0 || guard++ > ix->pageCount ) { ix->cursorPage = 0; return 0; }        pageNo = next; pos = 0;        if ( !riReadPage( ix, pageNo, page ) ) { ix->cursorPage = 0; return 0; }    }    return riCursorAt( ix, pageNo, pos, page );}/* back from (pageNo, pos): the entry before pos, in this leaf or an earlier one */static long riBackwardFrom( RIIndex *ix, uint32_t pageNo, uint32_t pos, uint8_t *page ) {    uint32_t guard = 0;    while ( pos == 0 ) {        uint32_t prev = RI_PREV( page );        if ( prev == 0 || guard++ > ix->pageCount ) { ix->cursorPage = 0; return 0; }        pageNo = prev;        if ( !riReadPage( ix, pageNo, page ) ) { ix->cursorPage = 0; return 0; }        pos = RI_COUNT( page );    }    return riCursorAt( ix, pageNo, pos - 1, page );}/* position the cursor; returns its record number, 0 when there is none. The key (RIKeyAdd...) is used by   every mode but First and Last. Equal: the first entry with exactly that key. */long RISeek( long handle, long mode ) {    RIIndex *ix = riIndex( handle );    uint8_t composite[RI_MAX_KEY + 4], page[RI_PAGE_SIZE];    uint32_t pageNo, pos;    long found;    if ( ix == NULL ) return 0;    ix->cursorPage = 0;    if ( mode == RI_SEEK_FIRST ) { memset( composite, 0, ix->compositeLength ); }    else if ( mode == RI_SEEK_LAST ) { memset( composite, 255, ix->compositeLength ); }    else {        if ( !riKeyReady( ix ) ) return 0;        /* (key, 0) comes before every entry with the key; (key, FFFFFFFF) after them all */        riComposite( ix, ( mode == RI_SEEK_GREATER || mode == RI_SEEK_LESS_OR_EQUAL ) ? 0xFFFFFFFFu : 0, composite );    }    if ( !riFindLeaf( ix, composite, &pageNo, &pos, page ) ) return 0;    switch ( mode ) {        case RI_SEEK_FIRST: case RI_SEEK_GREATER_OR_EQUAL: case RI_SEEK_GREATER:            return riForwardFrom( ix, pageNo, pos, page );        case RI_SEEK_EQUAL:            found = riForwardFrom( ix, pageNo, pos, page );            if ( found && memcmp( ix->cursorEntry, ix->key, ix->keyLength ) == 0 ) return found;            ix->cursorPage = 0;            return 0;        case RI_SEEK_LAST: case RI_SEEK_LESS_OR_EQUAL: case RI_SEEK_LESS:            return riBackwardFrom( ix, pageNo, pos, page );    }    return 0;}/* the next / previous entry from the cursor; 0 at the end (a change to the index ends the cursor: seek again) */long RINext( long handle ) {    RIIndex *ix = riIndex( handle );    uint8_t page[RI_PAGE_SIZE];    if ( ix == NULL || ix->cursorPage == 0 || !riReadPage( ix, ix->cursorPage, page ) ) return 0;    return riForwardFrom( ix, ix->cursorPage, ix->cursorIndex + 1, page );}long RIPrevious( long handle ) {    RIIndex *ix = riIndex( handle );    uint8_t page[RI_PAGE_SIZE];    if ( ix == NULL || ix->cursorPage == 0 || !riReadPage( ix, ix->cursorPage, page ) ) return 0;    return riBackwardFrom( ix, ix->cursorPage, ix->cursorIndex, page );}/* does the cursor's key equal the key being built? (for "every order of this customer": seek, then while equal) */long RICursorKeyEquals( long handle ) {    RIIndex *ix = riIndex( handle );    return ix != NULL && ix->cursorPage != 0 && riKeyReady( ix ) && memcmp( ix->cursorEntry, ix->key, ix->keyLength ) == 0;}/* --- delete: the entry goes; nodes are not merged (an emptied leaf stays in the chain until the index is rebuilt) --- */long RIDelete( long handle, long recordNumber ) {    RIIndex *ix = riIndex( handle );    uint8_t composite[RI_MAX_KEY + 4], page[RI_PAGE_SIZE];    uint32_t pageNo, pos, count;    if ( !riKeyReady( ix ) || recordNumber < 1 ) return 0;    ix->cursorPage = 0;    riComposite( ix, (uint32_t)recordNumber, composite );    if ( !riFindLeaf( ix, composite, &pageNo, &pos, page ) ) return 0;    count = RI_COUNT( page );    if ( pos >= count || memcmp( RI_LEAF_ENTRY( ix, page, pos ), composite, ix->compositeLength ) != 0 ) return 0;    memmove( RI_LEAF_ENTRY( ix, page, pos ), RI_LEAF_ENTRY( ix, page, pos + 1 ), (size_t)( count - pos - 1 ) * ix->compositeLength );    memset( RI_LEAF_ENTRY( ix, page, count - 1 ), 0, ix->compositeLength );    riPut32( page + 4, count - 1 );    if ( !riWritePage( ix, pageNo, page ) ) return 0;    ix->entryCount--;    return 1;}/* --- check: the whole tree, read from the file; "" when sound, else what is wrong --- */typedef struct { RIIndex *ix; uint32_t leafDepth, entries, lastLeaf, leaves; uint8_t last[RI_MAX_KEY + 4]; int haveLast; char *message; size_t messageLength; } RICheckState;static int riCheckFail( RICheckState *st, const char *what, uint32_t pageNo ) {    snprintf( st->message, st->messageLength, "%s (page %u)", what, pageNo );    return 0;}static int riCheckNode( RICheckState *st, uint32_t pageNo, uint32_t depth, const uint8_t *low, const uint8_t *high ) {    RIIndex *ix = st->ix;    uint8_t page[RI_PAGE_SIZE];    uint32_t count, i;    if ( pageNo == 0 || pageNo >= ix->pageCount ) return riCheckFail( st, "a page number outside the file", pageNo );    if ( depth > ix->height ) return riCheckFail( st, "deeper than the tree's height", pageNo );    if ( pread( ix->fd, page, RI_PAGE_SIZE, (off_t)pageNo * RI_PAGE_SIZE ) != RI_PAGE_SIZE ) return riCheckFail( st, "a page could not be read", pageNo );    count = RI_COUNT( page );    if ( RI_IS_LEAF( page ) ) {        if ( depth != ix->height ) return riCheckFail( st, "a leaf at the wrong depth", pageNo );        if ( count > ix->leafMax ) return riCheckFail( st, "a leaf with too many entries", pageNo );        if ( RI_PREV( page ) != st->lastLeaf ) return riCheckFail( st, "a leaf's previous link is wrong", pageNo );        if ( st->lastLeaf != 0 ) {            uint8_t before[RI_PAGE_SIZE];            if ( pread( ix->fd, before, RI_PAGE_SIZE, (off_t)st->lastLeaf * RI_PAGE_SIZE ) != RI_PAGE_SIZE || RI_NEXT( before ) != pageNo )                return riCheckFail( st, "a leaf's next link is wrong", st->lastLeaf );        }        for ( i = 0; i < count; i++ ) {            const uint8_t *e = RI_LEAF_ENTRY( ix, page, i );            if ( st->haveLast && memcmp( st->last, e, ix->compositeLength ) >= 0 ) return riCheckFail( st, "entries out of order", pageNo );            if ( low && memcmp( e, low, ix->compositeLength ) < 0 ) return riCheckFail( st, "an entry below its node's range", pageNo );            if ( high && memcmp( e, high, ix->compositeLength ) >= 0 ) return riCheckFail( st, "an entry above its node's range", pageNo );            if ( riGetBE32( e + ix->keyLength ) == 0 ) return riCheckFail( st, "an entry for record 0", pageNo );            memcpy( st->last, e, ix->compositeLength ); st->haveLast = 1;        }        st->entries += count; st->lastLeaf = pageNo; st->leaves++;        return 1;    }    if ( count < 1 || count > ix->internalMax ) return riCheckFail( st, "an internal node with a wrong count", pageNo );    for ( i = 0; i < count; i++ ) {        const uint8_t *k = RI_INNER_KEY( ix, page, i );        if ( i > 0 && memcmp( RI_INNER_KEY( ix, page, i - 1 ), k, ix->compositeLength ) >= 0 ) return riCheckFail( st, "separators out of order", pageNo );        if ( low && memcmp( k, low, ix->compositeLength ) < 0 ) return riCheckFail( st, "a separator below its node's range", pageNo );        if ( high && memcmp( k, high, ix->compositeLength ) >= 0 ) return riCheckFail( st, "a separator above its node's range", pageNo );    }    for ( i = 0; i <= count; i++ ) {        uint8_t lo[RI_MAX_KEY + 4], hi[RI_MAX_KEY + 4];        const uint8_t *l = low, *h = high;        if ( i > 0 ) { memcpy( lo, RI_INNER_KEY( ix, page, i - 1 ), ix->compositeLength ); l = lo; }        if ( i < count ) { memcpy( hi, RI_INNER_KEY( ix, page, i ), ix->compositeLength ); h = hi; }        if ( !riCheckNode( st, RI_INNER_CHILD( ix, page, i ), depth + 1, l, h ) ) return 0;    }    return 1;}long RICheck( long handle, char *message, long messageLength ) {    RIIndex *ix = riIndex( handle );    RICheckState st;    uint8_t page[RI_PAGE_SIZE];    if ( message == NULL || messageLength < 1 ) return 0;    message[0] = 0;    if ( ix == NULL ) { snprintf( message, (size_t)messageLength, "the index is not open" ); return 0; }    memset( &st, 0, sizeof st );    st.ix = ix; st.message = message; st.messageLength = (size_t)messageLength;    if ( !riCheckNode( &st, ix->rootPage, 1, NULL, NULL ) ) return 0;    if ( st.lastLeaf != 0 && pread( ix->fd, page, RI_PAGE_SIZE, (off_t)st.lastLeaf * RI_PAGE_SIZE ) == RI_PAGE_SIZE && RI_NEXT( page ) != 0 )        return riCheckFail( &st, "the last leaf links to another", st.lastLeaf );    if ( st.entries != ix->entryCount ) { snprintf( message, (size_t)messageLength, "%u entries in the tree, %u in the header", st.entries, ix->entryCount ); return 0; }    return 1;}/* pages read from the file, and written (for the timings) */long RIReads( long handle ) { RIIndex *ix = riIndex( handle ); return ix ? (long)ix->reads : 0; }long RIWrites( long handle ) { RIIndex *ix = riIndex( handle ); return ix ? (long)ix->writes : 0; }/* --- end record index core --- */// --- for FutureBasic ---// an index file: create YES makes a new, empty one (an existing file is replaced); 0 when it cannot be openedlong RIOpen( CFURLRef url, long keyLength, long create ) {    char path[1024];    if ( url == NULL || !CFURLGetFileSystemRepresentation( url, true, (UInt8 *)path, sizeof path ) ) return 0;    return RIOpenPath( path, keyLength, create );}// a text segment from a CFString: its UTF-8 bytes, cut at width (on a character's edge) and paddedvoid RIKeyAddString( long handle, CFStringRef text, long width, long caseless ) {    UInt8 bytes[RI_MAX_KEY];    CFIndex used = 0;    if ( width > RI_MAX_KEY ) width = RI_MAX_KEY;    if ( text != NULL ) CFStringGetBytes( text, CFRangeMake( 0, CFStringGetLength( text ) ), kCFStringEncodingUTF8, 0, false, bytes, width, &used );    RIKeyAddBytes( handle, bytes, used, width, caseless );}// what RICheck found: "" when the tree is soundCFStringRef RICheckText( long handle ) {    char message[300];    CFStringRef answer;    if ( RICheck( handle, message, sizeof message ) ) return CFSTR( "" );    answer = CFStringCreateWithCString( NULL, message, kCFStringEncodingUTF8 );    CFAutorelease( answer );    return answer;}EndCtoolbox fn RIOpen( CFURLRef url, long keyLength, long create ) = longtoolbox RIClose( long handle )toolbox fn RIFlush( long handle ) = longtoolbox fn RIWasClosedCleanly( long handle ) = longtoolbox fn RIEntryCount( long handle ) = longtoolbox fn RIHeight( long handle ) = longtoolbox fn RIPageCount( long handle ) = longtoolbox fn RIKeyLength( long handle ) = longtoolbox RIKeyClear( long handle )toolbox RIKeyAddLong( long handle, long value )toolbox RIKeyAddPascal( long handle, ptr pascalText, long width, long caseless )toolbox RIKeyAddString( long handle, CFStringRef text, long width, long caseless )toolbox fn RIInsert( long handle, long recordNumber ) = longtoolbox fn RIDelete( long handle, long recordNumber ) = longtoolbox fn RISeek( long handle, long mode ) = longtoolbox fn RINext( long handle ) = longtoolbox fn RIPrevious( long handle ) = longtoolbox fn RICursorKeyEquals( long handle ) = longtoolbox fn RICheckText( long handle ) = CFStringReftoolbox fn RIReads( long handle ) = longtoolbox fn RIWrites( long handle ) = long