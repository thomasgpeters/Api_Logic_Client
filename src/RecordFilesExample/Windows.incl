/* *   Windows.incl - the example's window: how many customers, Run, and the results * *   MIT License. Copyright (c) 2026 Imagery Business Systems, LLC. See LICENSE. */// the sizes offered: customers (each with 5 orders of 4 items: 26 records)local fn WindowSizes as CFArrayRefend fn = @[ fn NumberWithInteger( 1000 ), fn NumberWithInteger( 10000 ), fn NumberWithInteger( 50000 ), fn NumberWithInteger( 100000 ) ]void local fn BuildWindowCGFloat w = 980, h = 640CFMutableArrayRef titles = fn MutableArrayNewCFArrayRef        sizes = fn WindowSizesCFNumberRef       sizewindow _window, @"Record Files for FutureBasic Example by Imagery Business Systems, LLC", ( 0, 0, w, h ), NSWindowStyleMaskTitled + NSWindowStyleMaskClosable + NSWindowStyleMaskMiniaturizable + NSWindowStyleMaskResizableWindowSetContentMinSize( _window, fn CGSizeMake( 840, 420 ) )WindowCenter( _window )// the top row: [size] [Run] ... [Show the Files]for size in sizesMutableArrayAddObject( titles, fn StringWithFormat( @"%ld customers (%ld records)", fn NumberLongValue( size ), fn NumberLongValue( size ) * 26 ) )nextpopupbutton _sizePopup, YES, 1, titles, ( 14, h - 44, 260, 28 ), NO, _windowViewSetAutoresizingMask( _sizePopup, NSViewMaxXMargin + NSViewMinYMargin )button _runButton, YES, , @"Run", ( 282, h - 44, 100, 30 ), NSButtonTypeMomentaryPushIn, NSBezelStyleRounded, _windowButtonSetKeyEquivalent( _runButton, @"\r" )ViewSetAutoresizingMask( _runButton, NSViewMaxXMargin + NSViewMinYMargin )button _folderButton, YES, , @"Show the Files", ( w - 156, h - 44, 140, 30 ), NSButtonTypeMomentaryPushIn, NSBezelStyleRounded, _windowViewSetAutoresizingMask( _folderButton, NSViewMinXMargin + NSViewMinYMargin )// the resultsscrollview _outputScroll, ( 16, 34, w - 32, h - 34 - 56 ), NSBezelBorder, , _windowViewSetAutoresizingMask( _outputScroll, NSViewWidthSizable + NSViewHeightSizable )textview _outputView, , _outputScroll, , _windowTextViewSetEditable( _outputView, NO )TextViewSetSelectable( _outputView, YES )TextViewSetTextContainerInset( _outputView, fn CGSizeMake( 12, 10 ) )textlabel _statusLabel, @"Choose a size and Run. The first run creates the files; each run starts them afresh.", ( 16, 10, w - 32, 16 ), _windowControlSetFont( _statusLabel, fn FontSystemFontOfSize( 11.0 ) )TextFieldSetTextColor( _statusLabel, fn ColorSecondaryLabel )ViewSetAutoresizingMask( _statusLabel, NSViewWidthSizable + NSViewMaxYMargin )end fnvoid local fn WindowRunlong index = fn PopUpButtonIndexOfSelectedItem( _sizePopup )long customers = fn NumberLongValue( fn ArrayObjectAtIndex( fn WindowSizes, index ) )ControlSetStringValue( _statusLabel, @"Running..." )fn BenchRun( customers )ControlSetStringValue( _statusLabel, @"Done. Run again, or choose another size." )end fnvoid local fn WindowShowFilesfn WorkspaceOpenURL( fn OrdersFolderURL )end fn