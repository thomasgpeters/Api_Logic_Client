/* *   EventHandlers.incl - the example app's events: launch, menus, buttons * *   MIT License. Copyright (c) 2026 Imagery Business Systems, LLC. See LICENSE. */void local fn DoAppEvent( ev as long )select ( ev )case _appWillFinishLaunchingfn BuildMenufn BuildWindowcase _appShouldTerminateAfterLastWindowClosedAppEventSetBool( YES )end selectend fnvoid local fn DoMenu( menuID as long, itemID as long )select ( menuID )case _mApplicationif ( itemID == _iAboutImagery ) then fn AboutImageryShowcase _mBenchmarkselect ( itemID )case _iRun       : fn WindowRuncase _iShowFiles : fn WindowShowFilescase _iLogToNSLogisLoggingOn = ( isLoggingOn == NO )if ( isLoggingOn ) then MenuItemSetState( _mBenchmark, _iLogToNSLog, NSControlStateValueOn ) else MenuItemSetState( _mBenchmark, _iLogToNSLog, NSControlStateValueOff )end selectend selectend fnvoid local fn DoDialog( ev as long, tag as long, wnd as long )if ( fn AboutImageryHandles( ev, tag ) ) then exit fn         // the About Imagery window's buttonsif ( ev != _btnClick ) then exit fnselect ( tag )case _runButton    : fn WindowRuncase _folderButton : fn WindowShowFilesend selectend fn