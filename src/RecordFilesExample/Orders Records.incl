/* *   Orders Records.incl - Customer, Order and Item as records, with their indexes * *   What App Builder would write for a model when the developer chooses record files instead of SQLite: one *   begin record per entity (fixed sizes: text in Str63 fields, dates as numbers yyyymmdd), one record file per *   entity, an index for its key and one for each relationship and lookup: * *       Customers.records    Customers by Id.index    Customers by Name.index *       Orders.records       Orders by Id.index       Orders by Customer.index *       Items.records        Items by Id.index        Items by Order.index * *   The data is worked on through one record of each kind, gCustomer, gOrder and gItem (as Btrieve's data *   buffer): fill gCustomer and add it; find a customer and gCustomer holds it. * *   MIT License. Copyright (c) 2026 Imagery Business Systems, LLC. See LICENSE. */_customerFile = 21                 // FutureBasic file IDs for the record files_orderFile    = 22_itemFile     = 23_nameKeyWidth = 40                 // a name's first 40 bytes order the name index (caseless)begin record CustomerRecordlong    customerIdStr63   namedouble  creditLimitdouble  discountdouble  balance                    // its unshipped orders' totalslong    unshippedOrdersend recordbegin record OrderRecordlong    orderIdlong    customerIdlong    orderDate                  // yyyymmddlong    shippedDate                // yyyymmdd; 0: not shippeddouble  discount                   // the customer's, when the order was placeddouble  amountTotal                // its items' amountslong    itemCountend recordbegin record ItemRecordlong    itemIdlong    orderIdStr63   productdouble  quantitydouble  unitPricedouble  amount                     // quantity x price, less the order's discountend recordbegin globalsCustomerRecord gCustomer           // the record being worked on, of each kindOrderRecord    gOrderItemRecord     gItemlong gCustomerById, gCustomerByName, gOrderById, gOrderByCustomer, gItemById, gItemByOrder    // index handlesCFStringRef gOrdersProblem         // what went wrong, for the window (kept: OrdersSetProblem)long gOrdersRebuilt                // indexes rebuilt by the last OrdersOpen (0: every one was closed cleanly)end globalsvoid local fn OrdersSetProblem( problemText as CFStringRef )if ( problemText != NULL ) then fn CFRetain( problemText )if ( gOrdersProblem != NULL ) then CFRelease( gOrdersProblem )gOrdersProblem = problemTextend fn// ~/Library/Application Support/Record Files Example/ (created when missing)local fn OrdersFolderURL as CFURLRefCFURLRef url = fn URLByAppendingPathComponent( fn FileManagerURLForDirectory( NSApplicationSupportDirectory, NSUserDomainMask ), @"Record Files Example" )if ( fn FileManagerFileExistsAtURL( url ) == NO ) then fn FileManagerCreateDirectoryAtURL( url, YES, NULL )end fn = urllocal fn OrdersFileURL( fileName as CFStringRef ) as CFURLRefend fn = fn URLByAppendingPathComponent( fn OrdersFolderURL, fileName )// --- keys: the index's key, built in it (RIKeyClear, then the segments) ---void local fn OrdersNumberKey( handle as long, value as long )RIKeyClear( handle )RIKeyAddLong( handle, value )end fnvoid local fn OrdersCustomerNameKeyRIKeyClear( gCustomerByName )RIKeyAddPascal( gCustomerByName, @gCustomer.name, _nameKeyWidth, YES )end fn// --- opening and closing ---// an index, opened; made again when it is missing or was not closed cleanly (the record file is the truth)local fn OrdersOpenIndex( fileName as CFStringRef, keyLength as long, fresh as BOOL, trusted as BOOL ) as longlong handle = 0if ( fresh == NO ) then handle = fn RIOpen( fn OrdersFileURL( fileName ), keyLength, NO )if ( handle != 0 && ( trusted == NO || fn RIWasClosedCleanly( handle ) == NO ) )RIClose( handle )handle = 0end ifif ( handle == 0 ) then handle = fn RIOpen( fn OrdersFileURL( fileName ), keyLength, YES )     // new and empty: rebuilt belowend fn = handle// every record of a file into its (empty) indexesvoid local fn OrdersRebuildIndexes( fileID as long )long recordNumber = fn RecordFileNext( fileID, 0 )while ( recordNumber != 0 )select ( fileID )case _customerFilefn RecordFileRead( fileID, recordNumber, @gCustomer, sizeof( CustomerRecord ) )fn OrdersNumberKey( gCustomerById, gCustomer.customerId ) : fn RIInsert( gCustomerById, recordNumber )fn OrdersCustomerNameKey : fn RIInsert( gCustomerByName, recordNumber )case _orderFilefn RecordFileRead( fileID, recordNumber, @gOrder, sizeof( OrderRecord ) )fn OrdersNumberKey( gOrderById, gOrder.orderId ) : fn RIInsert( gOrderById, recordNumber )fn OrdersNumberKey( gOrderByCustomer, gOrder.customerId ) : fn RIInsert( gOrderByCustomer, recordNumber )case _itemFilefn RecordFileRead( fileID, recordNumber, @gItem, sizeof( ItemRecord ) )fn OrdersNumberKey( gItemById, gItem.itemId ) : fn RIInsert( gItemById, recordNumber )fn OrdersNumberKey( gItemByOrder, gItem.orderId ) : fn RIInsert( gItemByOrder, recordNumber )end selectrecordNumber = fn RecordFileNext( fileID, recordNumber )wendend fn// an entity's two indexes, made again from its record filevoid local fn OrdersRecreate( fileID as long )select ( fileID )case _customerFileRIClose( gCustomerById ) : RIClose( gCustomerByName )gCustomerById   = fn RIOpen( fn OrdersFileURL( @"Customers by Id.index" ), 8, YES )gCustomerByName = fn RIOpen( fn OrdersFileURL( @"Customers by Name.index" ), _nameKeyWidth, YES )case _orderFileRIClose( gOrderById ) : RIClose( gOrderByCustomer )gOrderById       = fn RIOpen( fn OrdersFileURL( @"Orders by Id.index" ), 8, YES )gOrderByCustomer = fn RIOpen( fn OrdersFileURL( @"Orders by Customer.index" ), 8, YES )case _itemFileRIClose( gItemById ) : RIClose( gItemByOrder )gItemById    = fn RIOpen( fn OrdersFileURL( @"Items by Id.index" ), 8, YES )gItemByOrder = fn RIOpen( fn OrdersFileURL( @"Items by Order.index" ), 8, YES )end selectfn OrdersRebuildIndexes( fileID )gOrdersRebuilt = gOrdersRebuilt + 2end fn// an index can be trusted when it was closed cleanly with its file, and holds one entry per recordlocal fn OrdersIndexTrusted( fileID as long, handle as long ) as BOOLif ( handle == 0 ) then exit fn = NOend fn = ( fn RIEntryCount( handle ) == fn RecordFileCount( fileID ) )// the files: fresh YES starts empty (the old files are removed). The number of indexes rebuilt is in// gOrdersRebuilt (0 when every index was closed cleanly).local fn OrdersOpen( fresh as BOOL ) as BOOLCFArrayRef  names = @[ @"Customers.records", @"Orders.records", @"Items.records", @"Customers by Id.index", @"Customers by Name.index", @"Orders by Id.index", @"Orders by Customer.index", @"Items by Id.index", @"Items by Order.index" ]CFStringRef fileNameBOOL        customersOK, ordersOK, itemsOKfn OrdersSetProblem( NULL )if ( fresh )for fileName in namesfn FileManagerRemoveItemAtURL( fn OrdersFileURL( fileName ) )nextend ifif ( fn RecordFileOpen( _customerFile, fn OrdersFileURL( @"Customers.records" ), sizeof( CustomerRecord ) ) == NO )fn OrdersSetProblem( @"Customers.records could not be opened as a customer record file." )exit fn = NOend ifif ( fn RecordFileOpen( _orderFile, fn OrdersFileURL( @"Orders.records" ), sizeof( OrderRecord ) ) == NO )fn OrdersSetProblem( @"Orders.records could not be opened as an order record file." )exit fn = NOend ifif ( fn RecordFileOpen( _itemFile, fn OrdersFileURL( @"Items.records" ), sizeof( ItemRecord ) ) == NO )fn OrdersSetProblem( @"Items.records could not be opened as an item record file." )exit fn = NOend ifcustomersOK = ( fn RecordFileWasRecovered( _customerFile ) == NO )ordersOK    = ( fn RecordFileWasRecovered( _orderFile ) == NO )itemsOK     = ( fn RecordFileWasRecovered( _itemFile ) == NO )gCustomerById    = fn OrdersOpenIndex( @"Customers by Id.index", 8, fresh, customersOK )gCustomerByName  = fn OrdersOpenIndex( @"Customers by Name.index", _nameKeyWidth, fresh, customersOK )gOrderById       = fn OrdersOpenIndex( @"Orders by Id.index", 8, fresh, ordersOK )gOrderByCustomer = fn OrdersOpenIndex( @"Orders by Customer.index", 8, fresh, ordersOK )gItemById        = fn OrdersOpenIndex( @"Items by Id.index", 8, fresh, itemsOK )gItemByOrder     = fn OrdersOpenIndex( @"Items by Order.index", 8, fresh, itemsOK )if ( gCustomerById == 0 || gCustomerByName == 0 || gOrderById == 0 || gOrderByCustomer == 0 || gItemById == 0 || gItemByOrder == 0 )fn OrdersSetProblem( @"An index file could not be opened." )exit fn = NOend ifgOrdersRebuilt = 0if ( fn OrdersIndexTrusted( _customerFile, gCustomerById ) == NO || fn OrdersIndexTrusted( _customerFile, gCustomerByName ) == NO )fn OrdersRecreate( _customerFile )end ifif ( fn OrdersIndexTrusted( _orderFile, gOrderById ) == NO || fn OrdersIndexTrusted( _orderFile, gOrderByCustomer ) == NO )fn OrdersRecreate( _orderFile )end ifif ( fn OrdersIndexTrusted( _itemFile, gItemById ) == NO || fn OrdersIndexTrusted( _itemFile, gItemByOrder ) == NO )fn OrdersRecreate( _itemFile )end ifend fn = YESvoid local fn OrdersCloseRIClose( gCustomerById ) : RIClose( gCustomerByName )RIClose( gOrderById ) : RIClose( gOrderByCustomer )RIClose( gItemById ) : RIClose( gItemByOrder )gCustomerById = 0 : gCustomerByName = 0 : gOrderById = 0 : gOrderByCustomer = 0 : gItemById = 0 : gItemByOrder = 0fn RecordFileClose( _customerFile )fn RecordFileClose( _orderFile )fn RecordFileClose( _itemFile )end fn// --- adding: the record, then its index entries ---local fn OrdersAddCustomer as longlong recordNumber = fn RecordFileAppend( _customerFile, @gCustomer, sizeof( CustomerRecord ) )if ( recordNumber == 0 ) then exit fn = 0fn OrdersNumberKey( gCustomerById, gCustomer.customerId ) : fn RIInsert( gCustomerById, recordNumber )fn OrdersCustomerNameKey : fn RIInsert( gCustomerByName, recordNumber )end fn = recordNumberlocal fn OrdersAddOrder as longlong recordNumber = fn RecordFileAppend( _orderFile, @gOrder, sizeof( OrderRecord ) )if ( recordNumber == 0 ) then exit fn = 0fn OrdersNumberKey( gOrderById, gOrder.orderId ) : fn RIInsert( gOrderById, recordNumber )fn OrdersNumberKey( gOrderByCustomer, gOrder.customerId ) : fn RIInsert( gOrderByCustomer, recordNumber )end fn = recordNumberlocal fn OrdersAddItem as longlong recordNumber = fn RecordFileAppend( _itemFile, @gItem, sizeof( ItemRecord ) )if ( recordNumber == 0 ) then exit fn = 0fn OrdersNumberKey( gItemById, gItem.itemId ) : fn RIInsert( gItemById, recordNumber )fn OrdersNumberKey( gItemByOrder, gItem.orderId ) : fn RIInsert( gItemByOrder, recordNumber )end fn = recordNumber// --- finding ---// the customer with this number, into gCustomerlocal fn OrdersFindCustomer( customerId as long ) as BOOLlong recordNumberfn OrdersNumberKey( gCustomerById, customerId )recordNumber = fn RISeek( gCustomerById, _riSeekEqual )if ( recordNumber == 0 ) then exit fn = NOend fn = fn RecordFileRead( _customerFile, recordNumber, @gCustomer, sizeof( CustomerRecord ) )// a customer's orders, one at a time, into gOrder: First, then Next until NOlocal fn OrdersFirstOrderOf( customerId as long ) as BOOLlong recordNumberfn OrdersNumberKey( gOrderByCustomer, customerId )recordNumber = fn RISeek( gOrderByCustomer, _riSeekEqual )if ( recordNumber == 0 ) then exit fn = NOend fn = fn RecordFileRead( _orderFile, recordNumber, @gOrder, sizeof( OrderRecord ) )local fn OrdersNextOrder as BOOLlong recordNumber = fn RINext( gOrderByCustomer )if ( recordNumber == 0 ) then exit fn = NOif ( fn RICursorKeyEquals( gOrderByCustomer ) == NO ) then exit fn = NO      // the next customer'send fn = fn RecordFileRead( _orderFile, recordNumber, @gOrder, sizeof( OrderRecord ) )// customers in name order, into gCustomer: First, then Next until NOlocal fn OrdersFirstCustomerByName as BOOLlong recordNumber = fn RISeek( gCustomerByName, _riSeekFirst )if ( recordNumber == 0 ) then exit fn = NOend fn = fn RecordFileRead( _customerFile, recordNumber, @gCustomer, sizeof( CustomerRecord ) )local fn OrdersNextCustomerByName as BOOLlong recordNumber = fn RINext( gCustomerByName )if ( recordNumber == 0 ) then exit fn = NOend fn = fn RecordFileRead( _customerFile, recordNumber, @gCustomer, sizeof( CustomerRecord ) )// --- removing: the index entries, then the record (its slot is reused by the next item added) ---local fn OrdersRemoveItem( itemId as long ) as BOOLlong recordNumberfn OrdersNumberKey( gItemById, itemId )recordNumber = fn RISeek( gItemById, _riSeekEqual )if ( recordNumber == 0 ) then exit fn = NOif ( fn RecordFileRead( _itemFile, recordNumber, @gItem, sizeof( ItemRecord ) ) == NO ) then exit fn = NOfn OrdersNumberKey( gItemById, gItem.itemId ) : fn RIDelete( gItemById, recordNumber )fn OrdersNumberKey( gItemByOrder, gItem.orderId ) : fn RIDelete( gItemByOrder, recordNumber )end fn = fn RecordFileDelete( _itemFile, recordNumber )// --- checking: every index's tree, and one entry per record ---void local fn OrdersCheckIndex( report as CFMutableStringRef, indexName as CFStringRef, handle as long, fileID as long )CFStringRef problem = fn RICheckText( handle )if ( fn StringLength( problem ) > 0 ) then MutableStringAppendFormat( report, @"%@: %@\n", indexName, problem )if ( fn RIEntryCount( handle ) != fn RecordFileCount( fileID ) ) then MutableStringAppendFormat( report, @"%@: %ld entries for %ld records\n", indexName, fn RIEntryCount( handle ), fn RecordFileCount( fileID ) )end fn// "" when every index is soundlocal fn OrdersCheck as CFStringRefCFMutableStringRef report = fn MutableStringNewfn OrdersCheckIndex( report, @"Customers by Id", gCustomerById, _customerFile )fn OrdersCheckIndex( report, @"Customers by Name", gCustomerByName, _customerFile )fn OrdersCheckIndex( report, @"Orders by Id", gOrderById, _orderFile )fn OrdersCheckIndex( report, @"Orders by Customer", gOrderByCustomer, _orderFile )fn OrdersCheckIndex( report, @"Items by Id", gItemById, _itemFile )fn OrdersCheckIndex( report, @"Items by Order", gItemByOrder, _itemFile )end fn = report