/* *   Rules.incl - the example's business rules, written by hand (LogicBank for FutureBasic) * *   Customer, Order and Item. Each rule is declared once, in DeclareRules, and the engine enforces it on *   every LogicInsert, LogicUpdate and LogicDelete - in whatever order the saves come, however they chain: * *       Item       Amount = Quantity x UnitPrice x (100 - the order's Discount) / 100;  Quantity > 0 *       Order      its Customer must exist; Discount copied from the Customer when the order is placed; *                  AmountTotal = sum of its Items' Amount; ItemCount = count of its Items; *                  deleting an Order deletes its Items *       Customer   Balance = sum of its unshipped Orders' AmountTotal; UnshippedOrders = their count; *                  Balance <= CreditLimit; a Customer with Orders cannot be deleted * *   A formula or a constraint is an FB function that reads the row (Logic Row.incl) and answers a value or *   YES / NO; @fn hands it to the engine. Sums and counts, copies, parent checks and delete actions need *   no function at all: they are declared by name. * *   App Builder for FutureBasic writes rules like these from sentences in your model's names, and checks *   and tests them; with the module alone, you write them here, by hand. * *   MIT License. Copyright (c) 2026 Imagery Business Systems, LLC. See LICENSE. */// Item.Amount: quantity x price, less the order's discount, to the centlocal fn ItemAmount( logicRow as LogicRowRef ) as CFTypeRefdouble amount = fn LogicDouble( logicRow, @"Quantity" ) * fn LogicDouble( logicRow, @"UnitPrice" ) * ( 100.0 - fn LogicParentDouble( logicRow, @"Order", @"Discount" ) ) / 100.0end fn = fn NumberWithDouble( fix( amount * 100.0 + 0.5 ) / 100.0 )local fn ItemQuantityPositive( logicRow as LogicRowRef ) as BOOLend fn = ( fn LogicDouble( logicRow, @"Quantity" ) > 0 )// which Orders count against the customer's credit: those not shipped yetlocal fn OrderUnshipped( logicRow as LogicRowRef ) as BOOLend fn = fn LogicIsEmpty( logicRow, @"ShippedDate" )local fn CustomerWithinCredit( logicRow as LogicRowRef ) as BOOLend fn = ( fn LogicDouble( logicRow, @"Balance" ) <= fn LogicDouble( logicRow, @"CreditLimit" ) )void local fn DeclareRules// an item: its amount, at the order's discountfn LogicFormula( @"Item", @"Amount", @fn ItemAmount, @[ @"Quantity", @"UnitPrice", @"OrderId", @"Order.Discount" ] )fn LogicConstraint( @"Item", @fn ItemQuantityPositive, @"Quantity {Quantity} must be more than 0" )// an order: the customer's discount when it was placed, and its items added upfn LogicParentCheck( @"Order", @"Customer", @"There is no customer {CustomerId}" )fn LogicCopy( @"Order", @"Discount", @"Customer", @"Discount" )fn LogicSum( @"Order", @"AmountTotal", @"ItemList", @"Amount", NULL )fn LogicCount( @"Order", @"ItemCount", @"ItemList", NULL )fn LogicDeleteAction( @"Order", @"ItemList", @"cascade", NULL )// a customer: what its unshipped orders come to, never more than the credit limitfn LogicSum( @"Customer", @"Balance", @"OrderList", @"AmountTotal", @fn OrderUnshipped )fn LogicCount( @"Customer", @"UnshippedOrders", @"OrderList", @fn OrderUnshipped )fn LogicConstraint( @"Customer", @fn CustomerWithinCredit, @"{Name}'s balance {Balance} would exceed the credit limit {CreditLimit}" )fn LogicDeleteAction( @"Customer", @"OrderList", @"prevent", @"{Name} still has orders" )end fn