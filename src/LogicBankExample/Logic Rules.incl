/* *   I M A G E R Y    B U S I N E S S     S Y S T E M S,   L L C * *   Logic Rules.incl - runtime: LogicBank for FutureBasic, the rule set * *   Rules are declared once at start-up, in FB, then enforced by the engine on every *   save (Logic Engine.incl).  A rule set is FB source: * *       // OrderDetail.Amount = Quantity * UnitPrice *       local fn OrderDetailAmount( logicRow as LogicRowRef ) as CFTypeRef *       end fn = fn NumberWithDouble( fn LogicDouble( logicRow, @"Quantity" ) * fn LogicDouble( logicRow, @"UnitPrice" ) ) * *       // Customer: Balance <= CreditLimit *       local fn CustomerCreditCheck( logicRow as LogicRowRef ) as BOOL *       end fn = ( fn LogicDouble( logicRow, @"Balance" ) <= fn LogicDouble( logicRow, @"CreditLimit" ) ) * *       void local fn DeclareRules *       fn LogicFormula( @"OrderDetail", @"Amount", @fn OrderDetailAmount, @[ @"Quantity", @"UnitPrice" ] ) *       fn LogicConstraint( @"Customer", @fn CustomerCreditCheck, @"Balance {Balance} exceeds credit limit {CreditLimit}" ) *       end fn * *       // Customer.Balance = sum( Order.AmountTotal where ShippedDate is empty ) *       local fn OrderIsUnshipped( logicRow as LogicRowRef ) as BOOL *       end fn = fn LogicIsEmpty( logicRow, @"ShippedDate" ) *       ... *       fn LogicSum( @"Customer", @"Balance", @"OrderList", @"AmountTotal", @fn OrderIsUnshipped ) *       fn LogicCount( @"Customer", @"UnpaidOrderCount", @"OrderList", @fn OrderIsUnshipped ) * *       // copied from the parent on insert (and when the row moves to another parent) *       fn LogicCopy( @"OrderDetail", @"UnitPrice", @"Product", @"UnitPrice" ) *       fn LogicParentCheck( @"OrderDetail", @"Product", @"Product {ProductId} does not exist" ) *       fn LogicDeleteAction( @"Order", @"OrderDetailList", @"cascade", NULL )        // or prevent / nullify *       fn LogicRowEvent( @"Order", @fn OrderAudit )        // void local fn ( logicRow as LogicRowRef ) *       fn LogicCommitEvent( @"Order", @fn OrderNotify )    // after the commit, once per row * *       fn DeclareRules : fn LogicActivate         // in main, after DataOpen * *   Rule functions take the row being saved (LogicRowRef, read with LogicValue / *   LogicDouble / ... in Logic Row.incl) and are called by address.  A formula names *   the attributes it reads (dependsOn): formulas run in dependency order, and on an *   update a formula whose inputs did not change is skipped. * *   Clean-room: written from LogicBank's documented behaviour, not its code. */#define LogicRowRef as CFMutableDictionaryRefbegin globalsCFMutableDictionaryRef gLogicRules        // entity -> { formulas, constraints, declared (sums/counts on this parent), aggregates (filed under the child) }BOOL                 gLogicActive       // LogicActivate succeededend globals// the rule lists of one entity (created on first use)local fn LogicEntityRules( entityName as CFStringRef ) as CFMutableDictionaryRefCFMutableDictionaryRef rulesif ( gLogicRules == NULL ) then gLogicRules = (CFMutableDictionaryRef)fn DataKept( fn MutableDictionaryNew, gLogicRules )rules = (CFMutableDictionaryRef)fn DictionaryObjectForKey( gLogicRules, entityName )if ( rules == NULL )rules = fn MutableDictionaryNewMutableDictionarySetObjectForKey( rules, fn MutableArrayNew, @"formulas" )MutableDictionarySetObjectForKey( rules, fn MutableArrayNew, @"constraints" )MutableDictionarySetObjectForKey( rules, fn MutableArrayNew, @"declared" )MutableDictionarySetObjectForKey( rules, fn MutableArrayNew, @"aggregates" )MutableDictionarySetObjectForKey( rules, fn MutableArrayNew, @"copies" )MutableDictionarySetObjectForKey( rules, fn MutableArrayNew, @"parentChecks" )MutableDictionarySetObjectForKey( rules, fn MutableArrayNew, @"deleteActions" )MutableDictionarySetObjectForKey( rules, fn MutableArrayNew, @"rowEvents" )MutableDictionarySetObjectForKey( rules, fn MutableArrayNew, @"commitEvents" )MutableDictionarySetObjectForKey( rules, fn MutableArrayNew, @"cascades" )MutableDictionarySetObjectForKey( gLogicRules, rules, entityName )end ifend fn = rules/* *   attrName = formulaFn( logicRow )     formulaFn: local fn ( logicRow as LogicRowRef ) as CFTypeRef *   dependsOn: the attributes the formula reads - [ "Quantity", "UnitPrice" ] *   (an empty list: the formula runs on every insert and update) */void local fn LogicFormula( entityName as CFStringRef, attrName as CFStringRef, formulaFn as ptr, dependsOn as CFArrayRef )CFMutableArrayRef formulas = (CFMutableArrayRef)fn DictionaryObjectForKey( fn LogicEntityRules( entityName ), @"formulas" )if ( dependsOn == NULL ) then dependsOn = @[]MutableArrayAddObject( formulas, @{ @"kind":@"formula", @"entity":entityName, @"attr":attrName, @"fn":fn ValueWithPointer( formulaFn ), @"dependsOn":dependsOn } )gLogicActive = NOend fn/* *   constraintFn( logicRow ) must be YES, else the save fails and rolls back. *   constraintFn: local fn ( logicRow as LogicRowRef ) as BOOL *   message: shown to the user; {Attr} (or {row.Attr}) is replaced by the row's value. */void local fn LogicConstraint( entityName as CFStringRef, constraintFn as ptr, message as CFStringRef )CFMutableArrayRef constraints = (CFMutableArrayRef)fn DictionaryObjectForKey( fn LogicEntityRules( entityName ), @"constraints" )if ( message == NULL ) then message = fn StringWithFormat( @"%@ constraint failed", entityName )MutableArrayAddObject( constraints, @{ @"kind":@"constraint", @"entity":entityName, @"fn":fn ValueWithPointer( constraintFn ), @"message":message } )end fn/* *   parentAttr = sum / count over the parent's child list (a tomany relationship of the *   model, e.g. "OrderList"), of the children for which whereFn is YES (NULL: all). *       whereFn: local fn ( logicRow as LogicRowRef ) as BOOL - sees the child row *   Maintained by adjustment: each child save adds its change to the parent; the sum is *   never re-queried.  The parent's own rules then run (chaining). */void local fn LogicAggregate( kind as CFStringRef, parentEntity as CFStringRef, parentAttr as CFStringRef, listName as CFStringRef, childAttr as CFStringRef, whereFn as ptr )CFMutableArrayRef declared = (CFMutableArrayRef)fn DictionaryObjectForKey( fn LogicEntityRules( parentEntity ), @"declared" )CFMutableDictionaryRef aggregate = fn MutableDictionaryNewMutableDictionarySetObjectForKey( aggregate, kind, @"kind" )MutableDictionarySetObjectForKey( aggregate, parentEntity, @"entity" )MutableDictionarySetObjectForKey( aggregate, parentAttr, @"attr" )MutableDictionarySetObjectForKey( aggregate, listName, @"list" )if ( childAttr != NULL ) then MutableDictionarySetObjectForKey( aggregate, childAttr, @"childAttr" )MutableDictionarySetObjectForKey( aggregate, fn ValueWithPointer( whereFn ), @"where" )MutableArrayAddObject( declared, aggregate )gLogicActive = NOend fnvoid local fn LogicSum( parentEntity as CFStringRef, parentAttr as CFStringRef, listName as CFStringRef, childAttr as CFStringRef, whereFn as ptr )fn LogicAggregate( @"sum", parentEntity, parentAttr, listName, childAttr, whereFn )end fnvoid local fn LogicCount( parentEntity as CFStringRef, parentAttr as CFStringRef, listName as CFStringRef, whereFn as ptr )fn LogicAggregate( @"count", parentEntity, parentAttr, listName, NULL, whereFn )end fn// add a rule to one of an entity's listsvoid local fn LogicAddRule( entityName as CFStringRef, listKey as CFStringRef, rule as CFDictionaryRef )CFMutableArrayRef rules = (CFMutableArrayRef)fn DictionaryObjectForKey( fn LogicEntityRules( entityName ), listKey )MutableArrayAddObject( rules, rule )gLogicActive = NOend fn/* *   attrName = the parent's parentAttr, copied on insert and when the row moves to another *   parent (roleName: a toone relationship).  Not kept in step afterwards - that is what a *   parent reference in a formula does.  Without a parent the row keeps its own value. */void local fn LogicCopy( entityName as CFStringRef, attrName as CFStringRef, roleName as CFStringRef, parentAttr as CFStringRef )fn LogicAddRule( entityName, @"copies", @{ @"kind":@"copy", @"entity":entityName, @"attr":attrName, @"role":roleName, @"parentAttr":parentAttr } )end fn// a filled-in foreign key along roleName must point at a parent that exists (an empty one is allowed)void local fn LogicParentCheck( entityName as CFStringRef, roleName as CFStringRef, message as CFStringRef )if ( message == NULL ) then message = fn StringWithFormat( @"The %@ does not exist", roleName )fn LogicAddRule( entityName, @"parentChecks", @{ @"kind":@"parentCheck", @"entity":entityName, @"role":roleName, @"message":message } )end fn/* *   What deleting the parent does to the children of a child list (tomany): *       prevent   the delete fails (message) while there are children *       cascade   the children are deleted too, through their own logic *       nullify   the children's foreign key is emptied, through their own logic */void local fn LogicDeleteAction( parentEntity as CFStringRef, listName as CFStringRef, action as CFStringRef, message as CFStringRef )if ( message == NULL ) then message = fn StringWithFormat( @"%@ has %@ rows", parentEntity, listName )fn LogicAddRule( parentEntity, @"deleteActions", @{ @"kind":@"deleteAction", @"entity":parentEntity, @"list":listName, @"action":action, @"message":message } )end fn// eventFn( logicRow ) during the save, after the constraints (insert, update and delete);// it must not change the row - that would bypass the rules - and the save fails if it doesvoid local fn LogicRowEvent( entityName as CFStringRef, eventFn as ptr )fn LogicAddRule( entityName, @"rowEvents", @{ @"kind":@"rowEvent", @"entity":entityName, @"fn":fn ValueWithPointer( eventFn ) } )end fn// eventFn( logicRow ) after the whole save has committed, once per row (its last state);// never on a rollback.  For messages, mail, notifications.void local fn LogicCommitEvent( entityName as CFStringRef, eventFn as ptr )fn LogicAddRule( entityName, @"commitEvents", @{ @"kind":@"commitEvent", @"entity":entityName, @"fn":fn ValueWithPointer( eventFn ) } )end fn// the entity's sum / count attributes (attr -> "sum" / "count"): maintained by the engine onlylocal fn LogicDerivedAttrs( entityName as CFStringRef ) as CFDictionaryRefCFMutableDictionaryRef derived = fn MutableDictionaryNewCFDictionaryRef        rules, aggregateCFArrayRef             declaredif ( gLogicRules == NULL ) then exit fn = derivedrules = fn DictionaryObjectForKey( gLogicRules, entityName )if ( rules == NULL ) then exit fn = deriveddeclared = fn DictionaryObjectForKey( rules, @"declared" )for aggregate in declaredMutableDictionarySetObjectForKey( derived, fn DictionaryObjectForKey( aggregate, @"kind" ), fn DictionaryObjectForKey( aggregate, @"attr" ) )nextend fn = derivedlocal fn LogicRulesOf( entityName as CFStringRef, kind as CFStringRef ) as CFArrayRefCFDictionaryRef rulesif ( gLogicRules == NULL ) then exit fn = @[]rules = fn DictionaryObjectForKey( gLogicRules, entityName )if ( rules == NULL ) then exit fn = @[]end fn = fn DictionaryObjectForKey( rules, kind )// "Role.Attr": Role is a toone relationship of the entity, Attr a column of that parentlocal fn LogicCheckParentReference( entityName as CFStringRef, reference as CFStringRef ) as BOOLCFArrayRef      parts = fn StringComponentsSeparatedByString( reference, @"." )CFDictionaryRef relationshipif ( fn ArrayCount( parts ) != 2 ) then exit fn = NOrelationship = fn DataRelationship( entityName, fn ArrayObjectAtIndex( parts, 0 ) )if ( relationship == NULL )if ( isLoggingOn ) then NSLog( @"Logic: %@ has no parent role %@ (in %@).", entityName, fn ArrayObjectAtIndex( parts, 0 ), reference )exit fn = NOend ifif ( fn StringIsEqual( fn DictionaryObjectForKey( relationship, @"direction" ), @"toone" ) == NO ) then exit fn = NOif ( fn ArrayContainsObject( fn DataColumns( fn DictionaryObjectForKey( relationship, @"resource" ) ), fn ArrayObjectAtIndex( parts, 1 ) ) == NO )if ( isLoggingOn ) then NSLog( @"Logic: %@ is not an attribute of the parent (in %@.%@).", fn ArrayObjectAtIndex( parts, 1 ), entityName, reference )exit fn = NOend ifend fn = YES// a rule names entities and attributes that must be in the modellocal fn LogicCheckNames( rule as CFDictionaryRef ) as BOOLCFStringRef  entityName = fn DictionaryObjectForKey( rule, @"entity" )CFArrayRef   columns = fn DataColumns( entityName )CFArrayRef   dependsOnCFStringRef  attrNameif ( fn ArrayCount( columns ) == 0 )if ( isLoggingOn ) then NSLog( @"Logic: rule on %@, which is not in the model.", entityName )exit fn = NOend ifattrName = fn DictionaryObjectForKey( rule, @"attr" )if ( attrName != NULL )if ( fn ArrayContainsObject( columns, attrName ) == NO )if ( isLoggingOn ) then NSLog( @"Logic: formula derives %@.%@, which is not in the model.", entityName, attrName )exit fn = NOend ifend ifdependsOn = fn DictionaryObjectForKey( rule, @"dependsOn" )if ( dependsOn != NULL )for attrName in dependsOnif ( fn StringContainsString( attrName, @"." ) )if ( fn LogicCheckParentReference( entityName, attrName ) == NO ) then exit fn = NOelseif ( fn ArrayContainsObject( columns, attrName ) == NO )if ( isLoggingOn ) then NSLog( @"Logic: formula %@.%@ depends on %@, which is not in the model.", entityName, fn DictionaryObjectForKey( rule, @"attr" ), attrName )exit fn = NOend ifend ifnextend ifend fn = YES/* *   Put one entity's formulas in dependency order: a formula runs after every formula *   that derives an attribute it reads.  NO (and a log naming them) on a cycle. */local fn LogicOrderFormulas( entityName as CFStringRef ) as BOOLCFMutableDictionaryRef rules = fn LogicEntityRules( entityName )CFArrayRef             formulas = fn DictionaryObjectForKey( rules, @"formulas" )CFMutableArrayRef      ordered = fn MutableArrayNewCFMutableArrayRef      derived = fn MutableArrayNew     // attributes still waiting to be derivedCFMutableStringRef     cycleCFDictionaryRef        formulaCFArrayRef             dependenciesCFStringRef            attrName, dependencyBOOL                 progress, readyfor formula in formulasMutableArrayAddObject( derived, fn DictionaryObjectForKey( formula, @"attr" ) )nextprogress = YESwhile ( progress && fn ArrayCount( ordered ) < fn ArrayCount( formulas ) )progress = NOfor formula in formulasattrName = fn DictionaryObjectForKey( formula, @"attr" )if ( fn ArrayContainsObject( derived, attrName ) )ready = YESdependencies = fn DictionaryObjectForKey( formula, @"dependsOn" )for dependency in dependenciesif ( fn StringIsEqual( dependency, attrName ) == NO && fn ArrayContainsObject( derived, dependency ) ) then ready = NOnextif ( ready )MutableArrayAddObject( ordered, formula )MutableArrayRemoveObject( derived, attrName )progress = YESend ifend ifnextwendif ( fn ArrayCount( ordered ) < fn ArrayCount( formulas ) )cycle = fn MutableStringNewfor attrName in derivedif ( fn StringLength( cycle ) > 0 ) then MutableStringAppendString( cycle, @", " )MutableStringAppendString( cycle, attrName )nextif ( isLoggingOn ) then NSLog( @"Logic: %@ formulas depend on each other in a cycle: %@", entityName, cycle )exit fn = NOend ifMutableDictionarySetObjectForKey( rules, ordered, @"formulas" )end fn = YES/* *   File a declared sum / count under its child entity: the child list (tomany on the *   parent) gives the child entity and the foreign key (fks -> parentKeys).  The child *   saves are what change the parent, so that is where the engine looks for them. */local fn LogicResolveAggregate( aggregate as CFDictionaryRef ) as BOOLCFStringRef            parentEntity = fn DictionaryObjectForKey( aggregate, @"entity" )CFDictionaryRef        relationship = fn DataRelationship( parentEntity, fn DictionaryObjectForKey( aggregate, @"list" ) )CFStringRef            childEntity, childAttrCFMutableDictionaryRef resolvedCFMutableArrayRef      aggregatesif ( relationship == NULL )if ( isLoggingOn ) then NSLog( @"Logic: %@ has no child list %@.", parentEntity, fn DictionaryObjectForKey( aggregate, @"list" ) )exit fn = NOend ifif ( fn StringIsEqual( fn DictionaryObjectForKey( relationship, @"direction" ), @"tomany" ) == NO )if ( isLoggingOn ) then NSLog( @"Logic: %@.%@ is not a child list.", parentEntity, fn DictionaryObjectForKey( aggregate, @"list" ) )exit fn = NOend ifchildEntity = fn DictionaryObjectForKey( relationship, @"resource" )if ( fn ArrayContainsObject( fn DataColumns( parentEntity ), fn DictionaryObjectForKey( aggregate, @"attr" ) ) == NO )if ( isLoggingOn ) then NSLog( @"Logic: %@ derives %@.%@, which is not in the model.", fn DictionaryObjectForKey( aggregate, @"kind" ), parentEntity, fn DictionaryObjectForKey( aggregate, @"attr" ) )exit fn = NOend ifchildAttr = fn DictionaryObjectForKey( aggregate, @"childAttr" )if ( childAttr != NULL )if ( fn ArrayContainsObject( fn DataColumns( childEntity ), childAttr ) == NO )if ( isLoggingOn ) then NSLog( @"Logic: sum of %@.%@, which is not in the model.", childEntity, childAttr )exit fn = NOend ifend ifresolved = fn MutableDictionaryWithDictionary( aggregate )MutableDictionarySetObjectForKey( resolved, childEntity, @"child" )MutableDictionarySetObjectForKey( resolved, fn DictionaryObjectForKey( relationship, @"fks" ), @"fks" )MutableDictionarySetObjectForKey( resolved, fn DictionaryObjectForKey( relationship, @"parentKeys" ), @"parentKeys" )aggregates = (CFMutableArrayRef)fn DictionaryObjectForKey( fn LogicEntityRules( childEntity ), @"aggregates" )MutableArrayAddObject( aggregates, resolved )end fn = YES// the child list on the parent that matches a child's toone role (same foreign key)local fn LogicListForRole( childEntity as CFStringRef, roleName as CFStringRef ) as CFStringRefCFDictionaryRef role = fn DataRelationship( childEntity, roleName )CFArrayRef      relationshipsCFDictionaryRef relationshipif ( role == NULL ) then exit fn = NULLrelationships = fn DictionaryObjectForKey( fn DataEntity( fn DictionaryObjectForKey( role, @"resource" ) ), @"relationships" )for relationship in relationshipsif ( fn StringIsEqual( fn DictionaryObjectForKey( relationship, @"direction" ), @"tomany" ) && fn StringIsEqual( fn DictionaryObjectForKey( relationship, @"resource" ), childEntity ) && fn ObjectIsEqual( (ObjectRef)fn DictionaryObjectForKey( relationship, @"fks" ), (ObjectRef)fn DictionaryObjectForKey( role, @"fks" ) ) ) then exit fn = fn DictionaryObjectForKey( relationship, @"name" )nextend fn = NULL/* *   Parent attributes read by child formulas ("Order.ShippedDate"): when one changes on the *   parent, the children recompute.  Filed under the parent as cascades: *       { child, role, list, attrs } */void local fn LogicAddCascade( childEntity as CFStringRef, reference as CFStringRef )CFArrayRef             parts = fn StringComponentsSeparatedByString( reference, @"." )CFDictionaryRef        role = fn DataRelationship( childEntity, fn ArrayObjectAtIndex( parts, 0 ) )CFStringRef            parentEntity, listNameCFMutableArrayRef      cascades, attrsCFDictionaryRef        candidateCFMutableDictionaryRef entry = NULLif ( role == NULL || fn ArrayCount( parts ) != 2 ) then exit fnparentEntity = fn DictionaryObjectForKey( role, @"resource" )listName     = fn LogicListForRole( childEntity, fn ArrayObjectAtIndex( parts, 0 ) )if ( listName == NULL ) then exit fncascades = (CFMutableArrayRef)fn DictionaryObjectForKey( fn LogicEntityRules( parentEntity ), @"cascades" )for candidate in cascadesif ( fn StringIsEqual( fn DictionaryObjectForKey( candidate, @"child" ), childEntity ) && fn StringIsEqual( fn DictionaryObjectForKey( candidate, @"role" ), fn ArrayObjectAtIndex( parts, 0 ) ) ) then entry = (CFMutableDictionaryRef)candidatenextif ( entry == NULL )entry = fn MutableDictionaryNewMutableDictionarySetObjectForKey( entry, childEntity, @"child" )MutableDictionarySetObjectForKey( entry, fn ArrayObjectAtIndex( parts, 0 ), @"role" )MutableDictionarySetObjectForKey( entry, listName, @"list" )MutableDictionarySetObjectForKey( entry, fn MutableArrayNew, @"attrs" )MutableArrayAddObject( cascades, entry )end ifattrs = (CFMutableArrayRef)fn DictionaryObjectForKey( entry, @"attrs" )if ( fn ArrayContainsObject( attrs, fn ArrayObjectAtIndex( parts, 1 ) ) == NO ) then MutableArrayAddObject( attrs, fn ArrayObjectAtIndex( parts, 1 ) )end fn// copy, parent check and delete action rules name relationships and attributes of the modellocal fn LogicCheckRelationshipRule( rule as CFDictionaryRef ) as BOOLCFStringRef     kind = fn DictionaryObjectForKey( rule, @"kind" )CFStringRef     entityName = fn DictionaryObjectForKey( rule, @"entity" )CFDictionaryRef relationshipCFStringRef     relationshipName, direction = @"toone", actionrelationshipName = fn DictionaryObjectForKey( rule, @"role" )if ( fn StringIsEqual( kind, @"deleteAction" ) )relationshipName = fn DictionaryObjectForKey( rule, @"list" )direction = @"tomany"action = fn DictionaryObjectForKey( rule, @"action" )if ( fn StringIsEqual( action, @"prevent" ) == NO && fn StringIsEqual( action, @"cascade" ) == NO && fn StringIsEqual( action, @"nullify" ) == NO )if ( isLoggingOn ) then NSLog( @"Logic: delete action %@ on %@.%@ - use prevent, cascade or nullify.", action, entityName, relationshipName )exit fn = NOend ifend ifrelationship = fn DataRelationship( entityName, relationshipName )if ( relationship == NULL )if ( isLoggingOn ) then NSLog( @"Logic: %@ has no relationship %@ (%@ rule).", entityName, relationshipName, kind )exit fn = NOend ifif ( fn StringIsEqual( fn DictionaryObjectForKey( relationship, @"direction" ), direction ) == NO )if ( isLoggingOn ) then NSLog( @"Logic: %@.%@ is not a %@ relationship (%@ rule).", entityName, relationshipName, direction, kind )exit fn = NOend ifif ( fn StringIsEqual( kind, @"copy" ) )if ( fn ArrayContainsObject( fn DataColumns( entityName ), fn DictionaryObjectForKey( rule, @"attr" ) ) == NO || fn ArrayContainsObject( fn DataColumns( fn DictionaryObjectForKey( relationship, @"resource" ) ), fn DictionaryObjectForKey( rule, @"parentAttr" ) ) == NO )if ( isLoggingOn ) then NSLog( @"Logic: copy %@.%@ from %@.%@ names an attribute not in the model.", entityName, fn DictionaryObjectForKey( rule, @"attr" ), relationshipName, fn DictionaryObjectForKey( rule, @"parentAttr" ) )exit fn = NOend ifend ifend fn = YES// after all rules are declared: check names, file sums/counts, order formulas.  NO: the rules are not used.local fn LogicActivate as BOOLCFArrayRef      entityNames, rules, dependsOnCFStringRef     entityName, referenceCFDictionaryRef ruleBOOL          ok = YESgLogicActive = NOif ( gLogicRules == NULL ) then gLogicRules = (CFMutableDictionaryRef)fn DataKept( fn MutableDictionaryNew, gLogicRules )entityNames = fn DictionaryAllKeys( gLogicRules )for entityName in entityNamesMutableArrayRemoveAllObjects( (CFMutableArrayRef)fn DictionaryObjectForKey( fn LogicEntityRules( entityName ), @"aggregates" ) )MutableArrayRemoveAllObjects( (CFMutableArrayRef)fn DictionaryObjectForKey( fn LogicEntityRules( entityName ), @"cascades" ) )nextfor entityName in entityNamesrules = fn LogicRulesOf( entityName, @"declared" )for rule in rulesif ( fn LogicResolveAggregate( rule ) == NO ) then ok = NOnextnextentityNames = fn DictionaryAllKeys( gLogicRules )      // resolving may add child entitiesfor entityName in entityNamesrules = fn LogicRulesOf( entityName, @"formulas" )for rule in rulesif ( fn LogicCheckNames( rule ) == NO ) then ok = NOnextrules = fn LogicRulesOf( entityName, @"constraints" )for rule in rulesif ( fn LogicCheckNames( rule ) == NO ) then ok = NOnextrules = fn LogicRulesOf( entityName, @"copies" )for rule in rulesif ( fn LogicCheckRelationshipRule( rule ) == NO ) then ok = NOnextrules = fn LogicRulesOf( entityName, @"parentChecks" )for rule in rulesif ( fn LogicCheckRelationshipRule( rule ) == NO ) then ok = NOnextrules = fn LogicRulesOf( entityName, @"deleteActions" )for rule in rulesif ( fn LogicCheckRelationshipRule( rule ) == NO ) then ok = NOnext// parent references in formulas become cascades on the parentrules = fn LogicRulesOf( entityName, @"formulas" )for rule in rulesdependsOn = fn DictionaryObjectForKey( rule, @"dependsOn" )for reference in dependsOnif ( fn StringContainsString( reference, @"." ) ) then fn LogicAddCascade( entityName, reference )nextnextif ( fn LogicOrderFormulas( entityName ) == NO ) then ok = NOnextif ( ok == NO )alert 1, NSAlertStyleCritical, @"The business rules could not be activated.", @"See the NSLog window for the rules and attributes involved.", @[@"OK"], NOexit fn = NOend ifgLogicActive = YESif (isLoggingOn) then NSLog( @"Logic: rules active for %ld entities", (long)fn ArrayCount( entityNames ) )end fn = YES