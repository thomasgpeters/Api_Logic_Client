/* *   Help.incl - the Help window: the guide, with the example's rules diagram, in a scrolling, *   read-only rich-text view, and what can be done with it: *       Open in Preview   the guide as a PDF in macOS Preview (to read, mark up or print) *       Export...         save it as PDF, or as Rich Text with the diagram (RTFD: TextEdit, Pages, Word) *       View Diagram      the rules diagram full size in its own window: zoom, full screen * *   The guide is the resource User Guide.txt, in the simple markup of Rich Text.incl (# headings, *   **bold**, ``` code blocks, ![picture] for an image resource), so it is easy to edit and reads *   well in light and dark mode.  PDF and Rich Text are written in the light appearance: black on *   white, whatever mode the Mac is in. * *   MIT License. Copyright (c) 2026 Imagery Business Systems, LLC. See LICENSE. */#define HELP_TITLE        @"LogicBank for FutureBasic Example Help"#define HELP_DIAGRAM      @"LogicBank Diagram"              // the rules diagram, a PNG resource (2x)_helpWidth     = 760_helpHeight    = 720_helpBarHeight = 50// the guide (a text view) -> a paginated PDF file at url; YES when it was writtenlocal fn HelpWritePDF( guideView as CFTypeRef, url as CFURLRef ) as BOOLcln NSView *v = (__bridge NSView *)guideView; NSPrintInfo *info = [[NSPrintInfo sharedPrintInfo] copy]; info.jobDisposition = NSPrintSaveJob; info.dictionary[NSPrintJobSavingURL] = (__bridge NSURL *)url; info.horizontalPagination = NSPrintingPaginationModeFit; info.verticalPagination = NSPrintingPaginationModeAutomatic; info.topMargin = 40; info.bottomMargin = 40; info.leftMargin = 40; info.rightMargin = 40; info.verticallyCentered = NO; NSPrintOperation *op = [NSPrintOperation printOperationWithView:v printInfo:info]; op.showsPrintPanel = NO; op.showsProgressPanel = NO; NSAppearance *saved = v.appearance; v.appearance = [NSAppearance appearanceNamed:NSAppearanceNameAqua]; BOOL ok = [op runOperation]; v.appearance = saved; return ok;end fn = NO// the guide's text, with the diagram -> a Rich Text file (RTFD) at url; YES when it was writtenlocal fn HelpWriteRTFD( guideView as CFTypeRef, url as CFURLRef ) as BOOLcln NSTextView *tv = (__bridge NSTextView *)guideView; __block BOOL ok = NO; [[NSAppearance appearanceNamed:NSAppearanceNameAqua] performAsCurrentDrawingAppearance:^{ NSAttributedString *text = tv.textStorage; NSFileWrapper *fw = [text RTFDFileWrapperFromRange:NSMakeRange( 0, text.length ) documentAttributes:@{ NSDocumentTypeDocumentAttribute:NSRTFDTextDocumentType }]; ok = [fw writeToURL:(__bridge NSURL *)url options:NSFileWrapperWritingAtomic originalContentsURL:nil error:nil]; }]; return ok;end fn = NO// a file in the temporary folder (for Preview)local fn HelpTemporaryURL( fileName as CFStringRef ) as CFURLRefcln return (__bridge CFURLRef)[NSURL fileURLWithPath:[NSTemporaryDirectory() stringByAppendingPathComponent:(__bridge NSString *)fileName]];end fn = NULL// open a file in macOS Preview (or the Mac's PDF app when Preview is not where it should be)void local fn HelpOpenInPreview( url as CFURLRef )CFURLRef previewURL = fn URLFileURLWithPath( @"/System/Applications/Preview.app" )if ( fn FileManagerFileExistsAtURL( previewURL ) == NO )fn WorkspaceOpenURL( url )exit fnend ifcln [[NSWorkspace sharedWorkspace] openURLs:@[ (__bridge NSURL *)url ] withApplicationAtURL:(__bridge NSURL *)previewURL configuration:[NSWorkspaceOpenConfiguration configuration] completionHandler:nil];end fn// the rules diagram, full size, in its own window (pinch or scroll to zoom; full screen from the green button)void local fn DiagramShowImageRef image = fn ImageNamed( HELP_DIAGRAM )CGSize   imageSizeCGFloat  w, hif ( fn WindowExists( _diagramWindow ) )WindowMakeKeyAndOrderFront( _diagramWindow )exit fnend ifif ( image == NULL ) then exit fnimageSize = fn ImageSize( image )w = imageSize.width / 2                                       // a 2x picture: its size in pointsh = imageSize.height / 2window _diagramWindow, @"LogicBank for FutureBasic: the Example's Rules", ( 0, 0, 900, 760 ), NSWindowStyleMaskTitled + NSWindowStyleMaskClosable + NSWindowStyleMaskMiniaturizable + NSWindowStyleMaskResizableWindowSetContentMinSize( _diagramWindow, fn CGSizeMake( 400, 300 ) )WindowSetCollectionBehavior( _diagramWindow, NSWindowCollectionBehaviorFullScreenPrimary )scrollview _diagramScroll, ( 0, 0, 900, 760 ), NSNoBorder, , _diagramWindowViewSetAutoresizingMask( _diagramScroll, NSViewWidthSizable + NSViewHeightSizable )ScrollViewSetAllowsMagnification( _diagramScroll, YES )imageview _diagramImage, YES, image, ( 0, 0, w, h ), NSImageScaleProportionallyUpOrDown, , , _diagramWindowScrollViewSetDocumentView( _diagramScroll, _diagramImage )ScrollViewScrollToTop( _diagramScroll )end fnvoid local fn HelpShowCFURLRef    urlCFStringRef guide = NULLif ( fn WindowExists( _helpWindow ) )WindowMakeKeyAndOrderFront( _helpWindow )                  // already open: bring it forwardexit fnend ifwindow _helpWindow, HELP_TITLE, ( 0, 0, _helpWidth, _helpHeight ), NSWindowStyleMaskTitled + NSWindowStyleMaskClosable + NSWindowStyleMaskMiniaturizable + NSWindowStyleMaskResizableWindowSetContentMinSize( _helpWindow, fn CGSizeMake( 560, 360 ) )// the bar: Open in Preview, Export..., and on the right View Diagrambutton _helpPreviewButton, YES, , @"Open in Preview", ( 12, _helpHeight - 42, 140, 30 ), NSButtonTypeMomentaryPushIn, NSBezelStyleRounded, _helpWindowViewSetAutoresizingMask( _helpPreviewButton, NSViewMaxXMargin + NSViewMinYMargin )button _helpExportButton, YES, , @"Export…", ( 154, _helpHeight - 42, 100, 30 ), NSButtonTypeMomentaryPushIn, NSBezelStyleRounded, _helpWindowViewSetAutoresizingMask( _helpExportButton, NSViewMaxXMargin + NSViewMinYMargin )button _helpDiagramButton, YES, , @"View Diagram", ( _helpWidth - 142, _helpHeight - 42, 130, 30 ), NSButtonTypeMomentaryPushIn, NSBezelStyleRounded, _helpWindowViewSetAutoresizingMask( _helpDiagramButton, NSViewMinXMargin + NSViewMinYMargin )scrollview _helpScroll, ( 0, 0, _helpWidth, _helpHeight - _helpBarHeight ), NSBezelBorder, , _helpWindowViewSetAutoresizingMask( _helpScroll, NSViewWidthSizable + NSViewHeightSizable )textview _helpView, , _helpScroll, , _helpWindowTextViewSetEditable( _helpView, NO )TextViewSetSelectable( _helpView, YES )                     // the code can be copiedTextViewSetTextContainerInset( _helpView, fn CGSizeMake( 28, 22 ) )url = fn BundleURLForResource( fn BundleMain, @"User Guide", @"txt", NULL )if ( url != NULL ) then guide = fn StringWithContentsOfURL( url, NSUTF8StringEncoding, NULL )if ( guide == NULL ) then guide = @"# Help\nThe user guide (User Guide.txt) is missing from the app's resources."fn RichTextFromMarkup( _helpView, guide )TextScrollRangeToVisible( _helpView, fn CFRangeMake( 0, 0 ) )   // start at the topend fn// Open in Preview: the guide as a PDF, opened in Previewvoid local fn HelpPreviewCFURLRef url = fn HelpTemporaryURL( @"LogicBank Example Help.pdf" )fn HelpShowif ( fn HelpWritePDF( (CFTypeRef)fn TextWithTag( _helpView ), url ) == NO )alert 1, NSAlertStyleWarning, @"The help could not be made into a PDF.", fn URLPath( url ), @[@"OK"], NOexit fnend iffn HelpOpenInPreview( url )end fn// Export...: PDF or Rich Text, then wherevoid local fn HelpExportNSModalResponse responseCFURLRef        urlBOOL            ok = NOfn HelpShowresponse = alert 1, NSAlertStyleInformational, @"Export the help as", @"PDF keeps the pages as they print. Rich Text keeps the text and the diagram for TextEdit, Pages or Word (an .rtfd document).", @[@"PDF", @"Rich Text", @"Cancel"]select ( response )case NSAlertFirstButtonReturnurl = savepanel 1, @"Export the help as PDF", @"pdf", @"LogicBank Example Help.pdf", @"Export"if ( url == NULL ) then exit fnok = fn HelpWritePDF( (CFTypeRef)fn TextWithTag( _helpView ), url )case NSAlertSecondButtonReturnurl = savepanel 1, @"Export the help as Rich Text", @"rtfd", @"LogicBank Example Help.rtfd", @"Export"if ( url == NULL ) then exit fnok = fn HelpWriteRTFD( (CFTypeRef)fn TextWithTag( _helpView ), url )case elseexit fnend selectif ( ok == NO ) then alert 1, NSAlertStyleWarning, @"The help could not be exported.", fn URLPath( url ), @[@"OK"], NOend fn