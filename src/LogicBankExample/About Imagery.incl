/* *   About Imagery.incl - the "About Imagery Business Systems" window * *   Shared by the free modules' sample apps (the SQL Generator example, the LogicBank for FutureBasic *   example): one file, identical in each, and its text in the resource "About Imagery.txt" - so what *   Imagery says about its FutureBasic work changes by editing the text, not the code. * *   To use it in an app: *       1. add this file and the resources "About Imagery.txt", "imagery_logo.png" and *          "imagery_logo_white.png" to the project *       2. a menu item that calls fn AboutImageryShow (the samples put it in the application menu) *       3. in DoDialog: if ( fn AboutImageryHandles( ev, tag ) ) then exit fn * *   The text's markup (one paragraph a line): *       # Heading        ## Subheading        - a bullet        a plain paragraph *       **bold** anywhere in a line;  a blank line is a little space * *   MIT License. Copyright (c) 2026 Imagery Business Systems, LLC. */#define ABOUT_IMAGERY_TITLE  @"About Imagery Business Systems"#define ABOUT_IMAGERY_TEXT   @"About Imagery"          // the resource About Imagery.txt// Imagery's FutureBasic site: the modules, the samples, App Builder (built by tools/make_site.py)#define ABOUT_IMAGERY_SITE   @"https://fb.imagery-business-systems.com/"_aboutImageryWindow = 90begin enum 9001_aboutImageryLogo_aboutImageryScroll_aboutImageryText_aboutImageryWebButton_aboutImageryCloseButtonend enum// the Imagery logo that follows light and dark mode (colour text on light, white text on dark)local fn AboutImageryLogo as ImageRefcln NSImage *light = [NSImage imageNamed:@"imagery_logo"]; NSImage *dark = [NSImage imageNamed:@"imagery_logo_white"]; if ( light == nil ) return NULL; NSImage *logo = [NSImage imageWithSize:light.size flipped:NO drawingHandler:^BOOL( NSRect r ) { NSAppearance *a = NSAppearance.currentAppearance; if ( @available( macOS 11.0, * ) ) a = NSAppearance.currentDrawingAppearance; BOOL isDark = [[a bestMatchFromAppearancesWithNames:@[ NSAppearanceNameAqua, NSAppearanceNameDarkAqua ]] isEqualToString:NSAppearanceNameDarkAqua]; [( isDark && dark != nil ? dark : light ) drawInRect:r]; return YES; }]; return (__bridge void *)logo;end fn = NULL// the text, in its markup -> the text view's styled text (system colours: light and dark mode)void local fn AboutImagerySetText( storageRef as CFTypeRef, markup as CFStringRef )cln NSTextStorage *ts = (__bridge NSTextStorage *)storageRef; NSMutableAttributedString *out = [[NSMutableAttributedString alloc] init]; NSFont *body = [NSFont systemFontOfSize:13]; NSFont *bold = [NSFont boldSystemFontOfSize:13]; for ( NSString *raw in [(__bridge NSString *)markup componentsSeparatedByString:@"\n"] ) { NSString *line = [raw stringByTrimmingCharactersInSet:[NSCharacterSet whitespaceCharacterSet]]; NSFont *font = body; NSMutableParagraphStyle *ps = [[NSMutableParagraphStyle alloc] init]; ps.paragraphSpacing = 6; if ( line.length == 0 ) { [out appendAttributedString:[[NSAttributedString alloc] initWithString:@"\n" attributes:@{ NSFontAttributeName:[NSFont systemFontOfSize:4] }]]; continue; } if ( [line hasPrefix:@"## "] ) { line = [line substringFromIndex:3]; font = [NSFont boldSystemFontOfSize:15]; ps.paragraphSpacingBefore = 8; } else if ( [line hasPrefix:@"# "] ) { line = [line substringFromIndex:2]; font = [NSFont boldSystemFontOfSize:20]; ps.paragraphSpacing = 10; } else if ( [line hasPrefix:@"- "] ) { line = [@"•\t" stringByAppendingString:[line substringFromIndex:2]]; ps.headIndent = 18; ps.tabStops = @[ [[NSTextTab alloc] initWithTextAlignment:NSTextAlignmentLeft location:18 options:@{}] ]; } NSArray *parts = [line componentsSeparatedByString:@"**"]; for ( NSUInteger i = 0; i < parts.count; i++ ) { NSFont *f = ( i % 2 == 1 && font == body ) ? bold : font; [out appendAttributedString:[[NSAttributedString alloc] initWithString:parts[i] attributes:@{ NSFontAttributeName:f, NSForegroundColorAttributeName:NSColor.labelColor, NSParagraphStyleAttributeName:ps }]]; } [out appendAttributedString:[[NSAttributedString alloc] initWithString:@"\n" attributes:@{ NSFontAttributeName:font, NSParagraphStyleAttributeName:ps }]]; } [ts setAttributedString:out];end fn// the window: the logo, the text (scrolling, selectable), the website, Closevoid local fn AboutImageryShowCGFloat     w = 600, h = 640CFURLRef    url = fn BundleURLForResource( fn BundleMain, ABOUT_IMAGERY_TEXT, @"txt", NULL )CFStringRef markup = NULLImageRef    logo = fn AboutImageryLogoif ( fn WindowExists( _aboutImageryWindow ) )WindowMakeKeyAndOrderFront( _aboutImageryWindow )exit fnend ifif ( url ) then markup = fn StringWithContentsOfURL( url, NSUTF8StringEncoding, NULL )if ( markup == NULL ) then markup = @"# Imagery Business Systems\nThe text resource About Imagery.txt is not in this app."window _aboutImageryWindow, ABOUT_IMAGERY_TITLE, ( 0, 0, w, h ), NSWindowStyleMaskTitled + NSWindowStyleMaskClosable + NSWindowStyleMaskResizableWindowSetContentMinSize( _aboutImageryWindow, fn CGSizeMake( 460, 420 ) )WindowCenter( _aboutImageryWindow )if ( logo )imageview _aboutImageryLogo, YES, logo, ( ( w - 140 ) / 2, h - 132, 140, 120 ), NSImageScaleProportionallyUpOrDown, , , _aboutImageryWindowViewSetAutoresizingMask( _aboutImageryLogo, NSViewMinXMargin + NSViewMaxXMargin + NSViewMinYMargin )end ifscrollview _aboutImageryScroll, ( 20, 60, w - 40, h - 60 - 144 ), NSBezelBorder, , _aboutImageryWindowViewSetAutoresizingMask( _aboutImageryScroll, NSViewWidthSizable + NSViewHeightSizable )textview _aboutImageryText, , _aboutImageryScroll, , _aboutImageryWindowTextViewSetEditable( _aboutImageryText, NO )TextViewSetSelectable( _aboutImageryText, YES )TextViewSetTextContainerInset( _aboutImageryText, fn CGSizeMake( 14, 12 ) )fn AboutImagerySetText( fn TextViewTextStorage( _aboutImageryText ), markup )ScrollViewScrollToTop( _aboutImageryScroll )button _aboutImageryWebButton, YES, , @"Visit the Website", ( 20, 16, 160, 30 ), NSButtonTypeMomentaryPushIn, NSBezelStyleRounded, _aboutImageryWindowViewSetAutoresizingMask( _aboutImageryWebButton, NSViewMaxXMargin + NSViewMaxYMargin )button _aboutImageryCloseButton, YES, , @"Close", ( w - 120, 16, 100, 30 ), NSButtonTypeMomentaryPushIn, NSBezelStyleRounded, _aboutImageryWindowButtonSetKeyEquivalent( _aboutImageryCloseButton, @"\r" )ViewSetAutoresizingMask( _aboutImageryCloseButton, NSViewMinXMargin + NSViewMaxYMargin )end fn// the window's buttons; YES when the event was the window's (the app's DoDialog then stops)local fn AboutImageryHandles( ev as long, tag as long ) as BOOLif ( ev != _btnClick ) then exit fn = NOselect ( tag )case _aboutImageryWebButtonfn WorkspaceOpenURL( fn URLWithString( ABOUT_IMAGERY_SITE ) )exit fn = YEScase _aboutImageryCloseButtonwindow close _aboutImageryWindowexit fn = YESend selectend fn = NO