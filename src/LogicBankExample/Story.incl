/* *   Story.incl - the example's story: thirteen saves, each through the rules, each followed by the objects *   as they are afterwards. A step says what it does and what should happen; the output shows what did. * *   The same story is worked out by the reference engine in tools/logicbank_example_reference.py, which checks *   every value shown here. * *   MIT License. Copyright (c) 2026 Imagery Business Systems, LLC. See LICENSE. */void local fn OutLine( textValue as CFStringRef, style as long )fn RichAppend( _outputView, textValue, style )if ( isLoggingOn ) then NSLog( @"%@", textValue )end fnvoid local fn OutClearTextSetString( _outputView, @"" )end fnlocal fn StoryTitle( stepNumber as long ) as CFStringRefselect ( stepNumber )case 1  : exit fn = @"Alice is a customer: a credit limit of 1,000.00 and a 10 % discount"case 2  : exit fn = @"Alice places an order: it copies her 10 % discount"case 3  : exit fn = @"2 widgets at 100.00: 180.00 after the discount; the order and Alice's balance follow"case 4  : exit fn = @"1 gadget at 300.00: 270.00; the order is 450.00"case 5  : exit fn = @"5 widgets instead of 2: the item, the order and the balance change together"case 6  : exit fn = @"4 more widgets would take Alice to 1,080.00: refused, and nothing changes"case 7  : exit fn = @"An item with no quantity: refused"case 8  : exit fn = @"The order ships: it no longer counts against Alice's credit"case 9  : exit fn = @"Alice's discount goes up to 20 %: the order placed earlier keeps its 10 %"case 10 : exit fn = @"A new order now copies 20 %: 2 widgets come to 160.00"case 11 : exit fn = @"An order for a customer who does not exist: refused"case 12 : exit fn = @"Alice cannot be deleted: she still has orders"case 13 : exit fn = @"The new order is deleted: its item goes with it, and Alice's balance comes down"end selectend fn = @""// the FB the step runs, as shown in the outputlocal fn StoryCode( stepNumber as long ) as CFStringRefselect ( stepNumber )case 1  : exit fn = @"fn LogicInsert( @\"Customer\", { Name: Alice, CreditLimit: 1000, Discount: 10 } )"case 2  : exit fn = @"fn LogicInsert( @\"Order\", { CustomerId: 1 } )"case 3  : exit fn = @"fn LogicInsert( @\"Item\", { OrderId: 1, Product: Widget, Quantity: 2, UnitPrice: 100 } )"case 4  : exit fn = @"fn LogicInsert( @\"Item\", { OrderId: 1, Product: Gadget, Quantity: 1, UnitPrice: 300 } )"case 5  : exit fn = @"fn LogicUpdate( @\"Item\", { Id: 1, Quantity: 5 }, NULL )"case 6  : exit fn = @"fn LogicInsert( @\"Item\", { OrderId: 1, Product: Widget, Quantity: 4, UnitPrice: 100 } )"case 7  : exit fn = @"fn LogicInsert( @\"Item\", { OrderId: 1, Product: Widget, Quantity: 0, UnitPrice: 100 } )"case 8  : exit fn = @"fn LogicUpdate( @\"Order\", { Id: 1, ShippedDate: 2026-11-26 }, NULL )"case 9  : exit fn = @"fn LogicUpdate( @\"Customer\", { Id: 1, Discount: 20 }, NULL )"case 10 : exit fn = @"fn LogicInsert( @\"Order\", { CustomerId: 1 } )  then  fn LogicInsert( @\"Item\", { OrderId: 2, Product: Widget, Quantity: 2, UnitPrice: 100 } )"case 11 : exit fn = @"fn LogicInsert( @\"Order\", { CustomerId: 99 } )"case 12 : exit fn = @"fn LogicDelete( @\"Customer\", { Id: 1 } )"case 13 : exit fn = @"fn LogicDelete( @\"Order\", { Id: 2 } )"end selectend fn = @""// a record from field names and valueslocal fn StoryRecord( names as CFArrayRef, values as CFArrayRef ) as CFMutableDictionaryRefCFMutableDictionaryRef aRecord = fn MutableDictionaryNewlong                   ifor i = 0 to (long)fn ArrayCount( names ) - 1MutableDictionarySetObjectForKey( aRecord, fn ArrayObjectAtIndex( values, i ), fn ArrayObjectAtIndex( names, i ) )nextend fn = aRecordlocal fn StoryItem( orderId as long, product as CFStringRef, quantity as double, unitPrice as double ) as CFMutableDictionaryRefend fn = fn StoryRecord( @[ @"OrderId", @"Product", @"Quantity", @"UnitPrice" ], @[ fn NumberWithLong( orderId ), product, fn NumberWithDouble( quantity ), fn NumberWithDouble( unitPrice ) ] )local fn StoryKey( keyValue as long ) as CFMutableDictionaryRefend fn = fn StoryRecord( @[ @"Id" ], @[ fn NumberWithLong( keyValue ) ] )// the step's save(s), through the rules; YES when savedlocal fn StorySave( stepNumber as long ) as BOOLselect ( stepNumber )case 1  : exit fn = fn LogicInsert( @"Customer", fn StoryRecord( @[ @"Name", @"CreditLimit", @"Discount" ], @[ @"Alice", fn NumberWithDouble( 1000 ), fn NumberWithDouble( 10 ) ] ) )case 2  : exit fn = fn LogicInsert( @"Order", fn StoryRecord( @[ @"CustomerId" ], @[ fn NumberWithLong( 1 ) ] ) )case 3  : exit fn = fn LogicInsert( @"Item", fn StoryItem( 1, @"Widget", 2, 100 ) )case 4  : exit fn = fn LogicInsert( @"Item", fn StoryItem( 1, @"Gadget", 1, 300 ) )case 5  : exit fn = fn LogicUpdate( @"Item", fn StoryRecord( @[ @"Id", @"Quantity" ], @[ fn NumberWithLong( 1 ), fn NumberWithDouble( 5 ) ] ), NULL )case 6  : exit fn = fn LogicInsert( @"Item", fn StoryItem( 1, @"Widget", 4, 100 ) )case 7  : exit fn = fn LogicInsert( @"Item", fn StoryItem( 1, @"Widget", 0, 100 ) )case 8  : exit fn = fn LogicUpdate( @"Order", fn StoryRecord( @[ @"Id", @"ShippedDate" ], @[ fn NumberWithLong( 1 ), @"2026-11-26" ] ), NULL )case 9  : exit fn = fn LogicUpdate( @"Customer", fn StoryRecord( @[ @"Id", @"Discount" ], @[ fn NumberWithLong( 1 ), fn NumberWithDouble( 20 ) ] ), NULL )case 10if ( fn LogicInsert( @"Order", fn StoryRecord( @[ @"CustomerId" ], @[ fn NumberWithLong( 1 ) ] ) ) == NO ) then exit fn = NOexit fn = fn LogicInsert( @"Item", fn StoryItem( 2, @"Widget", 2, 100 ) )case 11 : exit fn = fn LogicInsert( @"Order", fn StoryRecord( @[ @"CustomerId" ], @[ fn NumberWithLong( 99 ) ] ) )case 12 : exit fn = fn LogicDelete( @"Customer", fn StoryKey( 1 ) )case 13 : exit fn = fn LogicDelete( @"Order", fn StoryKey( 2 ) )end selectend fn = NO// a field's value as a number (0 when empty), for %8.2f and %glocal fn StoryValue( aRecord as CFDictionaryRef, fieldName as CFStringRef ) as doubleend fn = fn LogicNumberOf( fn DictionaryObjectForKey( aRecord, fieldName ) )// a text field, padded to a width for the table ("-" when empty)local fn StoryText( aRecord as CFDictionaryRef, fieldName as CFStringRef, padWidth as long ) as CFStringRefCFTypeRef value = fn DictionaryObjectForKey( aRecord, fieldName )if ( fn DataIsNull( value ) ) then value = @"-"end fn = fn StringByPaddingToLength( (CFStringRef)value, padWidth, @" ", 0 )// every object as it is now: what the rules maintain is to the right of the barvoid local fn StoryShowObjectsCFArrayRef      recordsCFDictionaryRef rrecords = fn DataMemoryRecords( @"Customer" )for r in recordsfn OutLine( fn StringWithFormat( @"  Customer %g  %@ CreditLimit %8.2f  Discount %2g %%   |  Balance %8.2f  UnshippedOrders %g", fn StoryValue( r, @"Id" ), fn StoryText( r, @"Name", 8 ), fn StoryValue( r, @"CreditLimit" ), fn StoryValue( r, @"Discount" ), fn StoryValue( r, @"Balance" ), fn StoryValue( r, @"UnshippedOrders" ) ), _richTable )nextrecords = fn DataMemoryRecords( @"Order" )for r in recordsfn OutLine( fn StringWithFormat( @"  Order    %g  Customer %g  Shipped %@         |  Discount %2g %%  AmountTotal %8.2f  ItemCount %g", fn StoryValue( r, @"Id" ), fn StoryValue( r, @"CustomerId" ), fn StoryText( r, @"ShippedDate", 10 ), fn StoryValue( r, @"Discount" ), fn StoryValue( r, @"AmountTotal" ), fn StoryValue( r, @"ItemCount" ) ), _richTable )nextrecords = fn DataMemoryRecords( @"Item" )for r in recordsfn OutLine( fn StringWithFormat( @"  Item     %g  Order %g     %@ Quantity %2g x %8.2f   |  Amount %8.2f", fn StoryValue( r, @"Id" ), fn StoryValue( r, @"OrderId" ), fn StoryText( r, @"Product", 7 ), fn StoryValue( r, @"Quantity" ), fn StoryValue( r, @"UnitPrice" ), fn StoryValue( r, @"Amount" ) ), _richTable )nextend fnvoid local fn StoryShowNextif ( gStoryStep >= _storyStepCount )ControlSetStringValue( _stepLabel, @"The story is over: Start Again to see it once more." )elseControlSetStringValue( _stepLabel, fn StringWithFormat( @"Next, step %ld of %d: %@", gStoryStep + 1, _storyStepCount, fn StoryTitle( gStoryStep + 1 ) ) )end ifend fn// run one step: what it does, the FB, the outcome, then the objectsvoid local fn StoryRun( stepNumber as long )BOOL savedfn OutLine( fn StringWithFormat( @"%ld. %@", stepNumber, fn StoryTitle( stepNumber ) ), _richSubheading )fn OutLine( fn StoryCode( stepNumber ), _richCode )saved = fn StorySave( stepNumber )if ( saved )fn OutLine( @"Saved.", _richNote )elsefn OutLine( fn StringWithFormat( @"Refused: %@  - and rolled back.", fn LogicMessage ), _richWarning )end iffn StoryShowObjectsfn OutLine( @"", _richBody )gStoryStep = stepNumberfn StoryShowNextend fn// a rule in plain words, as a bulletvoid local fn StoryRule( textValue as CFStringRef )fn OutLine( fn StringWithFormat( @"%C  %@", 0x2022, textValue ), _richBullet )end fn// the opening page: what this is, the rules in plain words, then what the steps will showvoid local fn StoryIntrofn OutLine( @"LogicBank for FutureBasic", _richHeading )fn OutLine( @"Your business logic, in one place.", _richSubheading )fn OutLine( @"Like your bank: what you put in, you can take out again. Every total, balance and limit is worked out for you, by the rules, on every save.", _richBody )fn OutLine( @"This example keeps three objects in memory, with no database: a customer, her orders, and the items on each order.", _richBody )fn OutLine( @"The rules, in plain words", _richSubheading )fn OutLine( @"They are declared once, in Rules.incl. The engine applies them to every save, and a save that breaks one is refused.", _richNote )fn OutLine( @"", _richNote )fn StoryRule( @"An item's amount is its quantity times its price, less the order's discount, to the cent." )fn StoryRule( @"An item's quantity must be more than 0." )fn OutLine( @"", _richNote )fn StoryRule( @"An order must belong to a customer who exists." )fn StoryRule( @"An order takes the customer's discount when it is placed, and keeps it." )fn StoryRule( @"An order's total is the sum of its items' amounts; it also counts its items." )fn StoryRule( @"Deleting an order deletes its items." )fn OutLine( @"", _richNote )fn StoryRule( @"A customer's balance is the total of her orders not shipped yet; she also has a count of them." )fn StoryRule( @"A customer's balance may never go over her credit limit." )fn StoryRule( @"A customer who still has orders cannot be deleted." )fn OutLine( @"What you will see", _richSubheading )fn OutLine( @"Thirteen steps, each one save. After each, the objects are shown as they are now, with the values the rules look after on the right.", _richBody )fn OutLine( @"Next Step runs the story a step at a time. Run the Whole Story runs it all. Help (?) explains every kind of rule, with examples.", _richNote )fn OutLine( @"", _richBody )end fnvoid local fn StoryNextif ( gStoryStep >= _storyStepCount ) then exit fnfn StoryRun( gStoryStep + 1 )TextScrollRangeToVisible( _outputView, fn CFRangeMake( fn StringLength( fn TextString( _outputView ) ), 0 ) )end fnvoid local fn StoryStartAgainfn DataMemoryResetgStoryStep = 0fn OutClearfn StoryIntrofn StoryShowNextend fnvoid local fn StoryRunAlllong nfn StoryStartAgainfor n = 1 to _storyStepCountfn StoryRun( n )nextTextScrollRangeToVisible( _outputView, fn CFRangeMake( 0, 0 ) )end fn