/* *   Windows.incl - the example's window: the story, step by step, in one scrolling output * *   MIT License. Copyright (c) 2026 Imagery Business Systems, LLC. See LICENSE. */void local fn BuildWindowCGFloat w = 980, h = 700window _window, @"LogicBank for FutureBasic Example by Imagery Business Systems, LLC", ( 0, 0, w, h ), NSWindowStyleMaskTitled + NSWindowStyleMaskClosable + NSWindowStyleMaskMiniaturizable + NSWindowStyleMaskResizableWindowSetContentMinSize( _window, fn CGSizeMake( 840, 420 ) )WindowCenter( _window )// the top row: [Next Step] [Run the Whole Story] ... [Start Again] (?)button _nextButton, YES, , @"Next Step", ( 12, h - 44, 110, 30 ), NSButtonTypeMomentaryPushIn, NSBezelStyleRounded, _windowButtonSetKeyEquivalent( _nextButton, @"\r" )                  // Return: the next stepViewSetAutoresizingMask( _nextButton, NSViewMaxXMargin + NSViewMinYMargin )button _runAllButton, YES, , @"Run the Whole Story", ( 124, h - 44, 170, 30 ), NSButtonTypeMomentaryPushIn, NSBezelStyleRounded, _windowViewSetAutoresizingMask( _runAllButton, NSViewMaxXMargin + NSViewMinYMargin )button _startAgainButton, YES, , @"Start Again", ( w - 166, h - 44, 110, 30 ), NSButtonTypeMomentaryPushIn, NSBezelStyleRounded, _windowViewSetAutoresizingMask( _startAgainButton, NSViewMinXMargin + NSViewMinYMargin )button _helpButton, YES, , @"", ( w - 46, h - 42, 28, 28 ), NSButtonTypeMomentaryPushIn, NSBezelStyleHelpButton, _windowViewSetAutoresizingMask( _helpButton, NSViewMinXMargin + NSViewMinYMargin )ViewSetToolTip( _helpButton, @"LogicBank for FutureBasic Example Help" )// the output: a scrolling rich-text view, read-only (the text can be selected and copied)scrollview _outputScroll, ( 16, 34, w - 32, h - 34 - 56 ), NSBezelBorder, , _windowViewSetAutoresizingMask( _outputScroll, NSViewWidthSizable + NSViewHeightSizable )textview _outputView, , _outputScroll, , _windowTextViewSetEditable( _outputView, NO )TextViewSetSelectable( _outputView, YES )TextViewSetTextContainerInset( _outputView, fn CGSizeMake( 12, 10 ) )// the next step, along the bottomtextlabel _stepLabel, @"", ( 16, 10, w - 32, 16 ), _windowControlSetFont( _stepLabel, fn FontSystemFontOfSize( 11.0 ) )TextFieldSetTextColor( _stepLabel, fn ColorSecondaryLabel )ViewSetAutoresizingMask( _stepLabel, NSViewWidthSizable + NSViewMaxYMargin )end fn