/* *   DataObject_Super.incl - the SQL Generator's builders: describe a statement in a dictionary *   (InitQueryDictionary, AddTableToQuery, AddColumnToQuery, AddAssociationToQuery, *   AddFilterToQuery; InitInsertIntoDictionary, InitInsertRowsDictionary, InitUpdateDictionary, *   InitDeleteFromDictionary and their Add... functions).  DataObject.glbl comes before this file, DataObject.incl after it. * *   SQL Generator: describe a SQL statement in a dictionary, get parameterized SQL back. *   Shared as an example project: src/SQLGeneratorExample in Api_Logic_Client. *   MIT License. Copyright (c) 2026 Imagery Business Systems, LLC. */include "NSLog.incl"/* * Table, column and alias names are quoted in the generated SQL, so reserved words * (Order, Group) and names with spaces work:  Order -> "Order",  a.id -> "a"."id". * A name that is already quoted ('Given Name', "x", [x], `x`) is used as given. */local fn QuoteSQLName( name as CFStringRef ) as CFStringRefCFArrayRef         partsCFStringRef        part, firstCFMutableStringRef quotedif ( name == NULL ) then exit fn = @"\"\""if ( fn StringLength( name ) == 0 ) then exit fn = @"\"\""first = fn StringSubstringToIndex( name, 1 )if ( fn StringIsEqual( first, @"\"" ) || fn StringIsEqual( first, @"'" ) || fn StringIsEqual( first, @"[" ) || fn StringIsEqual( first, @"`" ) ) then exit fn = nameparts  = fn StringComponentsSeparatedByString( name, @"." )quoted = fn MutableStringNewfor part in partsif ( fn StringLength( quoted ) > 0 ) then MutableStringAppendString( quoted, @"." )MutableStringAppendString( quoted, fn StringWithFormat( @"\"%@\"", fn StringByReplacingOccurrencesOfString( part, @"\"", @"\"\"" ) ) )nextend fn = quoted/* * Select Query Builder * Supporting Functions * * */local modedim as CFMutableArrayRef     selectfilterArrayReflocal fn GetSelectFilterArray( queryDictionaryRef as CFMutableDictionaryRef ) as CFMutableArrayRefif ( ( fn DictionaryObjectForKey( queryDictionaryRef, @"filter" ) != NULL ) )selectfilterArrayRef = (CFMutableArrayRef)fn DictionaryObjectForKey( queryDictionaryRef, @"filter" )end ifend fn = selectfilterArrayReflocal modedim as CFMutableArrayRef     metadataArrayReflocal fn InitMetadataArray( queryDictionaryRef as CFMutableDictionaryRef )metadataArrayRef = fn MutableArrayNewMutableDictionarySetObjectForKey( queryDictionaryRef, metadataArrayRef, @"metadata" )end fnlocal modedim as CFMutableArrayRef     selecttablesArrayReflocal fn InitTablesArray( queryDictionaryRef as CFMutableDictionaryRef )selecttablesArrayRef = fn MutableArrayNewMutableDictionarySetObjectForKey( queryDictionaryRef, selecttablesArrayRef, @"selecttables" )end fnlocal modedim as CFMutableArrayRef     selectcolsArrayReflocal fn InitColumnsArray( queryDictionaryRef as CFMutableDictionaryRef )selectcolsArrayRef = fn MutableArrayNewMutableDictionarySetObjectForKey( queryDictionaryRef, selectcolsArrayRef, @"selectcols" )end fn// the joins: an ARRAY of { lefttablealias, leftcolumnname, righttablealias, rightcolumnname,// operator }, as AddAssociationToQuery and GenerateSelectSQL use it (it was created as a// dictionary, so the first join crashed: -[__NSDictionaryM addObject:] - fixed 2026-11-25)local modedim as CFMutableArrayRef     associationsArrayReflocal fn InitAssociationsDictionary( queryDictionaryRef as CFMutableDictionaryRef )associationsArrayRef = fn MutableArrayNewMutableDictionarySetObjectForKey( queryDictionaryRef, associationsArrayRef, @"associations" )end fnlocal modedim as CFMutableArrayRef     selectfilterArrayReflocal fn InitFilterArray( queryDictionaryRef as CFMutableDictionaryRef )selectfilterArrayRef = fn MutableArrayNewMutableDictionarySetObjectForKey( queryDictionaryRef, selectfilterArrayRef, @"filter" )end fnlocal modedim as CFMutableDictionaryRef     resultsDictionaryReflocal fn InitResultsDictionary( queryDictionaryRef as CFMutableDictionaryRef )resultsDictionaryRef = fn MutableDictionaryNewMutableDictionarySetObjectForKey( queryDictionaryRef, resultsDictionaryRef, @"results" )end fnlocal modedim as CFMutableDictionaryRef   queryDictionaryReflocal fn InitQueryDictionary as CFMutableDictionaryRef/*  Setup the Dictionary with an empty results array */queryDictionaryRef = fn MutableDictionaryNewfn InitMetadataArray( queryDictionaryRef )fn InitColumnsArray( queryDictionaryRef )fn InitTablesArray( queryDictionaryRef )fn InitAssociationsDictionary( queryDictionaryRef )fn InitFilterArray( queryDictionaryRef )fn InitResultsDictionary( queryDictionaryRef )end fn = queryDictionaryReflocal modedim as CFMutableArrayRef        selecttablesArrayRefdim as CFMutableDictionaryRef   tableDictionaryReflocal fn AddTableToQuery( queryDictionaryRef as CFMutableDictionaryRef, tableName as CFStringRef, aliasName as CFStringRef )if ( ( fn DictionaryObjectForKey( queryDictionaryRef, @"selecttables" ) != NULL ) )selecttablesArrayRef = (CFMutableArrayRef)fn DictionaryObjectForKey( queryDictionaryRef, @"selecttables" )tableDictionaryRef = fn MutableDictionaryNewif ( tableName != NULL ) then MutableDictionarySetObjectForKey( tableDictionaryRef, tableName, @"tablename" )if ( aliasName != NULL ) then MutableDictionarySetObjectForKey( tableDictionaryRef, aliasName, @"aliasname" )MutableArrayAddObject( selecttablesArrayRef, tableDictionaryRef )end ifend fnlocal modedim as CFMutableArrayRef        selectcolsArrayRefdim as CFMutableDictionaryRef   columnDictionaryReflocal fn AddColumnToQuery( queryDictionaryRef as CFMutableDictionaryRef, columnName as CFStringRef, aliasName as CFStringRef)if ( ( fn DictionaryObjectForKey( queryDictionaryRef, @"selectcols" ) != NULL ) )selectcolsArrayRef = (CFMutableArrayRef)fn DictionaryObjectForKey( queryDictionaryRef, @"selectcols" )columnDictionaryRef = fn MutableDictionaryNewif ( columnName != NULL ) then MutableDictionarySetObjectForKey( columnDictionaryRef, columnName, @"columnname" )if ( aliasName != NULL ) then MutableDictionarySetObjectForKey( columnDictionaryRef, aliasName, @"aliasname" )MutableArrayAddObject( selectcolsArrayRef, columnDictionaryRef )end ifend fn/*Operator           Meaninga = b              a is equal to ba != b             a is not equal to ba < b              a is less than ba > b              a is greater than ba <= b             a is less than or equal to ba >= b             a is greater than or equal to ba IN (b, c)        a is equal to either b or ca NOT IN (b, c)    a is equal to neither b nor c*/local modedim as CFMutableArrayRef        selectfilterArrayRefdim as CFMutableDictionaryRef   filterDictionaryRef// value may be a CFStringRef, a CFNumberRef or NSNulllocal fn AddFilterToQuery( queryDictionaryRef as CFMutableDictionaryRef, tableAlias as CFStringRef, columnName as CFStringRef, value as CFTypeRef, type as long, numType as long, operator as long, logic as long )if ( ( fn DictionaryObjectForKey( queryDictionaryRef, @"filter" ) != NULL ) )selectfilterArrayRef = (CFMutableArrayRef)fn DictionaryObjectForKey( queryDictionaryRef, @"filter" )filterDictionaryRef = fn MutableDictionaryNewif ( tableAlias != NULL ) then MutableDictionarySetObjectForKey( filterDictionaryRef, tableAlias, @"tablealias" )if ( columnName != NULL ) then MutableDictionarySetObjectForKey( filterDictionaryRef, columnName, @"columnname" )if value != NULL then MutableDictionarySetObjectForKey( filterDictionaryRef, value, @"value" )MutableDictionarySetObjectForKey( filterDictionaryRef, fn NumberWithInteger( type ), @"type" )if numType > 0 then MutableDictionarySetObjectForKey( filterDictionaryRef, fn NumberWithInteger( numType ), @"numType" )MutableDictionarySetObjectForKey( filterDictionaryRef, fn NumberWithInteger( operator ), @"operator" )if logic > 0 then MutableDictionarySetObjectForKey( filterDictionaryRef, fn NumberWithInteger( logic ), @"logic" )MutableArrayAddObject( selectfilterArrayRef, filterDictionaryRef )end ifend fn/*Operator           Meaninga = b              a is equal to ba != b             a is not equal to ba < b              a is less than ba > b              a is greater than ba <= b             a is less than or equal to ba >= b             a is greater than or equal to ba IN (b, c)        a is equal to either b or ca NOT IN (b, c)    a is equal to neither b nor c*/local modedim as CFMutableArrayRef        selectassociationsArrayRefdim as CFMutableDictionaryRef   associationDictionaryReflocal fn AddAssociationToQuery( queryDictionaryRef as CFMutableDictionaryRef, leftTableAlias as CFStringRef, leftColumnName as CFStringRef, rightTableAlias as CFStringRef, rightColumnName as CFStringRef, operator as long )if ( ( fn DictionaryObjectForKey( queryDictionaryRef, @"associations" ) != NULL ) )selectassociationsArrayRef = (CFMutableArrayRef)fn DictionaryObjectForKey( queryDictionaryRef, @"associations" )associationDictionaryRef = fn MutableDictionaryNewif ( leftTableAlias != NULL ) then MutableDictionarySetObjectForKey( associationDictionaryRef, leftTableAlias, @"lefttablealias" )if ( leftColumnName != NULL ) then MutableDictionarySetObjectForKey( associationDictionaryRef, leftColumnName, @"leftcolumnname" )if ( rightTableAlias != NULL ) then MutableDictionarySetObjectForKey( associationDictionaryRef, rightTableAlias, @"righttablealias" )if ( rightColumnName != NULL ) then MutableDictionarySetObjectForKey( associationDictionaryRef, rightColumnName, @"rightcolumnname" )MutableDictionarySetObjectForKey( associationDictionaryRef, fn NumberWithInteger( operator ), @"operator" )MutableArrayAddObject( selectassociationsArrayRef, associationDictionaryRef )end ifend fn/* * Insert / Update / Delete Builders * Supporting Functions * * Same pattern as the Select builder: describe the statement in a dictionary, * GenerateInsertIntoSQL / GenerateUpdateSQL / GenerateDeleteFromSQL (DataObject.incl) * turn it into parameterized SQL, and fn QueryParameterValues gives the values to bind, * in the same order as the ? placeholders. * *   insert dictionary  ( fn InitInsertIntoDictionary ) *        |___ insertintotable   <-- table name *        |___ columnvalues      <-- ordered array of { columnname, value, type } * *   update dictionary  ( fn InitUpdateDictionary ) *        |___ updatetable       <-- table name *        |___ columnvalues      <-- ordered array of { columnname, value, type }  ( SET ... ) *        |___ filter            <-- WHERE, added with fn AddFilterToQuery ( table alias is ignored ) * *   delete dictionary  ( fn InitDeleteFromDictionary ) *        |___ deletefromtable   <-- table name *        |___ filter            <-- WHERE, added with fn AddFilterToQuery ( table alias is ignored ) * * type is one of _nullType, _integerType, _realType, _textType, _blobType (DataObject.glbl). * value may be a CFStringRef or a CFNumberRef; NULL (or _nullType) writes SQL NULL. * * Storage Class & Description * 1 NULL    The value is a NULL value. * 2 INTEGER The value is a signed integer, stored in 1, 2, 3, 4, 6, or 8 bytes depending on the magnitude of the value. * 3 REAL    The value is a floating point value, stored as an 8-byte IEEE floating point number. * 4 TEXT    The value is a text string, stored using the database encoding (UTF-8, UTF-16BE or UTF-16LE) * 5 BLOB    The value is a blob of data, stored exactly as it was input. */local fn InitWriteDictionary( tableKey as CFStringRef, withFilter as BOOL ) as CFMutableDictionaryRefCFMutableDictionaryRef writeDictionaryRef = fn MutableDictionaryNewMutableDictionarySetObjectForKey( writeDictionaryRef, fn MutableStringNew, tableKey )MutableDictionarySetObjectForKey( writeDictionaryRef, fn MutableArrayNew, @"columnvalues" )if ( withFilter ) then MutableDictionarySetObjectForKey( writeDictionaryRef, fn MutableArrayNew, @"filter" )end fn = writeDictionaryReflocal fn InitInsertIntoDictionary as CFMutableDictionaryRefend fn = fn InitWriteDictionary( @"insertintotable", NO )local fn InitUpdateDictionary as CFMutableDictionaryRefend fn = fn InitWriteDictionary( @"updatetable", YES )local fn InitDeleteFromDictionary as CFMutableDictionaryRefend fn = fn InitWriteDictionary( @"deletefromtable", YES )void local fn SetWriteTable( writeDictionaryRef as CFMutableDictionaryRef, tableKey as CFStringRef, tableName as CFStringRef )CFMutableStringRef tableStringRef = (CFMutableStringRef)fn DictionaryObjectForKey( writeDictionaryRef, tableKey )if ( tableStringRef != NULL ) then MutableStringSetString( tableStringRef, tableName )end fnvoid local fn AddTableToInsert( insertDictionaryRef as CFMutableDictionaryRef, tableName as CFStringRef )fn SetWriteTable( insertDictionaryRef, @"insertintotable", tableName )end fnvoid local fn AddTableToUpdate( updateDictionaryRef as CFMutableDictionaryRef, tableName as CFStringRef )fn SetWriteTable( updateDictionaryRef, @"updatetable", tableName )end fnvoid local fn AddTableToDelete( deleteDictionaryRef as CFMutableDictionaryRef, tableName as CFStringRef )fn SetWriteTable( deleteDictionaryRef, @"deletefromtable", tableName )end fn// one { columnname, value, type } entry, in the order the columns appear in the SQLvoid local fn AddColumnValue( writeDictionaryRef as CFMutableDictionaryRef, columnName as CFStringRef, columnValue as CFTypeRef, columnType as long )CFMutableArrayRef      columnValuesArrayRef = (CFMutableArrayRef)fn DictionaryObjectForKey( writeDictionaryRef, @"columnvalues" )CFMutableDictionaryRef columnDictionaryRefif ( columnValuesArrayRef == NULL ) then exit fncolumnDictionaryRef = fn MutableDictionaryNewif ( columnName != NULL ) then MutableDictionarySetObjectForKey( columnDictionaryRef, columnName, @"columnname" )MutableDictionarySetObjectForKey( columnDictionaryRef, fn NumberWithInteger( columnType ), @"type" )if ( columnValue != NULL ) then MutableDictionarySetObjectForKey( columnDictionaryRef, columnValue, @"value" )MutableArrayAddObject( columnValuesArrayRef, columnDictionaryRef )end fnvoid local fn AddColumnToInsert( insertDictionaryRef as CFMutableDictionaryRef, columnName as CFStringRef, columnValue as CFTypeRef, columnType as long )fn AddColumnValue( insertDictionaryRef, columnName, columnValue, columnType )end fnvoid local fn AddColumnToUpdate( updateDictionaryRef as CFMutableDictionaryRef, columnName as CFStringRef, columnValue as CFTypeRef, columnType as long )fn AddColumnValue( updateDictionaryRef, columnName, columnValue, columnType )end fn/* * Many rows at once: INSERT INTO table ( a, b ) VALUES ( ?, ? ), ( ?, ? ), ... * The opposite of a SELECT's result: an array of dictionaries, column -> value, one per row. * *   rows dictionary  ( fn InitInsertRowsDictionary ) *        |___ insertintotable   <-- table name ( fn AddTableToInsert ) *        |___ rows              <-- array of { column -> value } ( fn AddRowsToInsert ) *        |___ columnnames       <-- the columns, in SQL order: the rows' keys, sorted, unless *                                   fn SetInsertColumns gave them * * A column a row has no value for is inserted as NULL.  Values are bound by their class * (NSNumber, NSString, NSData, NSNull), so rows straight from a SELECT go back in as they are. */local fn InitInsertRowsDictionary as CFMutableDictionaryRefCFMutableDictionaryRef statement = fn InitWriteDictionary( @"insertintotable", NO )MutableDictionarySetObjectForKey( statement, fn MutableArrayNew, @"rows" )MutableDictionarySetObjectForKey( statement, fn MutableArrayNew, @"columnnames" )end fn = statement// the columns, in the order the SQL names them (otherwise the rows' keys, sorted)void local fn SetInsertColumns( statement as CFMutableDictionaryRef, columnNames as CFArrayRef )CFMutableArrayRef columns = (CFMutableArrayRef)fn DictionaryObjectForKey( statement, @"columnnames" )if ( columns == NULL || columnNames == NULL ) then exit fnMutableArrayRemoveAllObjects( columns )MutableArrayAddObjectsFromArray( columns, columnNames )MutableDictionarySetObjectForKey( statement, fn NumberWithBool( YES ), @"columnsgiven" )end fn// add rows (an array of dictionaries); their keys become the columns unless SetInsertColumns gave themvoid local fn AddRowsToInsert( statement as CFMutableDictionaryRef, rows as CFArrayRef )CFMutableArrayRef rowList = (CFMutableArrayRef)fn DictionaryObjectForKey( statement, @"rows" )CFMutableArrayRef columns = (CFMutableArrayRef)fn DictionaryObjectForKey( statement, @"columnnames" )CFDictionaryRef   rowCFStringRef       keyCFMutableArrayRef keysCFArrayRef        rowKeysif ( rowList == NULL || columns == NULL || rows == NULL ) then exit fnMutableArrayAddObjectsFromArray( rowList, rows )if ( fn DictionaryObjectForKey( statement, @"columnsgiven" ) != NULL ) then exit fnkeys = fn MutableArrayWithArray( columns )for row in rowsrowKeys = fn DictionaryAllKeys( row )for key in rowKeysif ( fn ArrayContainsObject( keys, key ) == NO ) then MutableArrayAddObject( keys, key )nextnextMutableArrayRemoveAllObjects( columns )MutableArrayAddObjectsFromArray( columns, fn ArraySortedArrayUsingSelector( keys, @"compare:" ) )end fn