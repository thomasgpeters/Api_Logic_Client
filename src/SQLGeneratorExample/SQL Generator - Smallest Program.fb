/* *   SQL Generator - Smallest Program.fb * *   The SQL Generator in the fewest lines: a single-file FutureBasic program (no project).  Keep it *   in the same folder as the module's four files, open it in FutureBasic and run it; the output goes *   to the NSLog window. * *   It opens a database in memory, makes a table with plain SQL, adds three people with one INSERT *   (an array of dictionaries), and reads back the ones with a balance over 100 - every statement *   described with dictionaries, the SQL written by the generator. * *   MIT License. Copyright (c) 2026 Imagery Business Systems, LLC. See LICENSE. */// 1. the module: the constants first, then the builders, the SQL, and the SQLite runnerinclude "DataObject.glbl"include "DataObject_Super.incl"include "DataObject.incl"include "SQL Generator SQLite.incl"// 2. link SQLite (in a project, put these in Build Settings > Compiler options instead)#build CompilerOptions @"-lsqlite3 -Wno-unused-command-line-argument"void local fn SmallestDemoptr                    db = NULLCFMutableDictionaryRef insertRows, queryCFMutableArrayRef      found = fn MutableArrayNewCFDictionaryRef        personCFStringRef            sql// 3. open a database: ":memory:" here; a file path works the same (YES creates the file)if ( fn SQLGenOpen( @":memory:", YES, @db ) != _sqlGenOK )NSLog( @"The database could not be opened." )exit fnend if// 4. the table: plain SQL - the generator writes queries, not schemasfn SQLGenExecute( db, @"CREATE TABLE IF NOT EXISTS person ( id INTEGER PRIMARY KEY, givenName TEXT, surName TEXT, balance REAL )", NULL, NULL )// 5. INSERT three rows at once: an array of dictionaries, column -> valueinsertRows = fn InitInsertRowsDictionaryfn AddTableToInsert( insertRows, @"person" )fn AddRowsToInsert( insertRows, @[ @{ @"givenName":@"Ada", @"surName":@"Lovelace", @"balance":fn NumberWithDouble( 1815.0 ) }, @{ @"givenName":@"Alan", @"surName":@"Turing", @"balance":fn NumberWithDouble( 42.0 ) }, @{ @"givenName":@"Grace", @"surName":@"Hopper", @"balance":fn NumberWithDouble( 1906.5 ) } ] )sql = fn GenerateInsertRowsSQL( insertRows )NSLog( @"%@", sql )fn SQLGenExecute( db, sql, fn QueryParameterValues( insertRows ), NULL )NSLog( @"%ld rows added", fn SQLGenChanges( db ) )// 6. SELECT: who has a balance over 100, by surnamequery = fn InitQueryDictionaryfn AddTableToQuery( query, @"person", @"p" )fn AddColumnToQuery( query, @"p.givenName", @"Given Name" )fn AddColumnToQuery( query, @"p.surName", @"Surname" )fn AddColumnToQuery( query, @"p.balance", @"Balance" )fn AddFilterToQuery( query, @"p", @"balance", fn NumberWithDouble( 100.0 ), _realType, 0, _isGreaterThan, 0 )fn AddOrderToQuery( query, @"p", @"surName", NO )sql = fn GenerateSelectSQL( query )NSLog( @"%@", sql )NSLog( @"values for ?: %@", fn QueryParameterValues( query ) )// 7. run it: each row is a dictionary keyed by the names given in AddColumnToQueryif ( fn SQLGenExecute( db, sql, fn QueryParameterValues( query ), found ) == _sqlGenDONE )for person in foundNSLog( @"%@ %@: %@", fn DictionaryObjectForKey( person, @"Given Name" ), fn DictionaryObjectForKey( person, @"Surname" ), fn DictionaryObjectForKey( person, @"Balance" ) )nextend iffn SQLGenClose( db )end fnfn SmallestDemoHandleEvents