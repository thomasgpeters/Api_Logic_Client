/* *   DataObject.glbl - the SQL Generator's constants: operators, AND / OR, value types * *   SQL Generator: describe a SQL statement in a dictionary, get parameterized SQL back. *   Shared as an example project: src/SQLGeneratorExample in Api_Logic_Client. *   MIT License. Copyright (c) 2026 Imagery Business Systems, LLC. *//*Operator           Meaninga = b              a is equal to ba != b             a is not equal to ba < b              a is less than ba > b              a is greater than ba <= b             a is less than or equal to ba >= b             a is greater than or equal to ba IN (b, c)        a is equal to either b or ca NOT IN (b, c)    a is equal to neither b nor ca IS NULL          a has no value             (the filter takes no value)a IS NOT NULL      a has a value              (the filter takes no value)a LIKE b           a matches the pattern b    ('B%' starts with B, '%test.com' ends with it)a NOT LIKE b       a does not match b*/begin enum 1_isEqual_isNotEqual_isLessThan_isGreaterThan_isLessThanOrEqual_isGreaterThanOrEqual_isIn_isNotIn_isNull_isNotNull_isLike_isNotLikeend enumbegin enum 1_and_orend enum// a value's type, for the INSERT / UPDATE builders and filtersbegin enum 1_nullType_integerType_realType_textType_blobTypeend enum// AddFilterToQuery's numType: kept with a filter for code that reads the dictionary backbegin enum 1_kCFNumberSInt8Type_kCFNumberSInt16Type_kCFNumberSInt32Type_kCFNumberSInt64Type_kCFNumberFloat32Type_kCFNumberFloat64Type_kCFNumberCharType_kCFNumberShortType_kCFNumberIntType_kCFNumberLongType_kCFNumberLongLongType_kCFNumberFloatType_kCFNumberDoubleType_kCFNumberCFIndexType_kCFNumberNSIntegerType_kCFNumberCGFloatTypeend enum