/* *   Rich Text.incl - styled text in a text view, in light and dark mode * *   Every style uses the system's colours (label, secondary label, system blue, ...), which *   change with the appearance, so the text reads well in both modes.  The output pane and the *   Help window use the same styles. * *   RichTextFromMarkup turns simple markup into styled text: *       # Heading               ## Subheading *       **bold** inside a line   `code` inside a line *       ```                      a code block: every line up to the closing ``` *       - item                   a bulleted line * *   MIT License. Copyright (c) 2026 Imagery Business Systems, LLC. See LICENSE. */begin enum 1_richBody_richHeading_richSubheading_richCode               // a code block: monospaced, coloured, on a tinted background_richSQL                // the SQL the generator wrote_richValues             // the values for its ? placeholders_richTable              // result rows_richNote               // a quieter remark_richWarning            // something refused or failed_richBulletend enumlocal fn RichFont( style as long ) as FontRefselect ( style )case _richHeading    : exit fn = fn FontBoldSystemFontOfSize( 22.0 )case _richSubheading : exit fn = fn FontBoldSystemFontOfSize( 15.0 )case _richCode, _richSQL, _richValues : exit fn = fn FontMonospacedSystemFontOfSize( 12.0, NSFontWeightRegular )case _richTable      : exit fn = fn FontWithName( @"Menlo", 12.0 )      // a terminal's look: results as a SQL command line prints themcase _richNote       : exit fn = fn FontSystemFontOfSize( 12.0 )end selectend fn = fn FontSystemFontOfSize( 13.0 )local fn RichColor( style as long ) as ColorRefselect ( style )case _richCode    : exit fn = fn ColorSystemPurplecase _richSQL     : exit fn = fn ColorSystemBluecase _richValues  : exit fn = fn ColorSystemTealcase _richNote    : exit fn = fn ColorSecondaryLabelcase _richWarning : exit fn = fn ColorSystemOrangeend selectend fn = fn ColorLabel// the attributes of a style: font, colour, a tint behind code, and paragraph spacing / indentlocal fn RichAttributes( style as long ) as CFDictionaryRefCFMutableDictionaryRef   attributes = fn MutableDictionaryNewMutableParagraphStyleRef paragraph = fn MutableParagraphStyleInitMutableDictionarySetObjectForKey( attributes, fn RichFont( style ), NSFontAttributeName )MutableDictionarySetObjectForKey( attributes, fn RichColor( style ), NSForegroundColorAttributeName )select ( style )case _richHeadingMutableParagraphStyleSetParagraphSpacingBefore( paragraph, 14.0 )MutableParagraphStyleSetParagraphSpacing( paragraph, 6.0 )case _richSubheadingMutableParagraphStyleSetParagraphSpacingBefore( paragraph, 12.0 )MutableParagraphStyleSetParagraphSpacing( paragraph, 4.0 )case _richCode, _richSQL, _richValues, _richTableMutableDictionarySetObjectForKey( attributes, fn ColorQuaternarySystemFill, NSBackgroundColorAttributeName )MutableParagraphStyleSetFirstLineHeadIndent( paragraph, 12.0 )MutableParagraphStyleSetHeadIndent( paragraph, 12.0 )case _richBulletMutableParagraphStyleSetFirstLineHeadIndent( paragraph, 8.0 )MutableParagraphStyleSetHeadIndent( paragraph, 22.0 )MutableParagraphStyleSetParagraphSpacing( paragraph, 3.0 )case elseMutableParagraphStyleSetParagraphSpacing( paragraph, 6.0 )end selectMutableDictionarySetObjectForKey( attributes, paragraph, NSParagraphStyleAttributeName )end fn = attributes// styled text at the end of the text view: its text storage is a mutable attributed string// (TextViewAppendAttributedString is newer than FutureBasic 7.0.38)void local fn RichAppendAttributed( tag as long, styled as CFAttributedStringRef )MutableAttributedStringAppendAttributedString( (CFMutableAttributedStringRef)fn TextViewTextStorage( tag ), styled )end fn// one line (or more) in a style, at the end of the text viewvoid local fn RichAppend( tag as long, textValue as CFStringRef, style as long )if ( textValue == NULL ) then exit fnfn RichAppendAttributed( tag, fn AttributedStringWithAttributes( fn StringWithFormat( @"%@\n", textValue ), fn RichAttributes( style ) ) )end fn// a line of body text with **bold** and `code` inside itvoid local fn RichAppendInline( tag as long, textValue as CFStringRef, style as long )CFMutableAttributedStringRef textLine = fn MutableAttributedStringNewCFDictionaryRef              plain = fn RichAttributes( style )CFMutableDictionaryRef       bold, codeCFArrayRef                   boldParts, codePartsCFStringRef                  partlong                         i, jbold = fn MutableDictionaryWithDictionary( plain )MutableDictionarySetObjectForKey( bold, fn FontBoldSystemFontOfSize( 13.0 ), NSFontAttributeName )code = fn MutableDictionaryWithDictionary( plain )MutableDictionarySetObjectForKey( code, fn FontMonospacedSystemFontOfSize( 12.0, NSFontWeightRegular ), NSFontAttributeName )MutableDictionarySetObjectForKey( code, fn ColorSystemPurple, NSForegroundColorAttributeName )// **bold** splits the line into plain / bold / plain ...; `code` splits each plain part againboldParts = fn StringComponentsSeparatedByString( textValue, @"**" )for i = 0 to (long)fn ArrayCount( boldParts ) - 1part = fn ArrayObjectAtIndex( boldParts, i )if ( i mod 2 == 1 )MutableAttributedStringAppendAttributedString( textLine, fn AttributedStringWithAttributes( part, bold ) )elsecodeParts = fn StringComponentsSeparatedByString( part, @"`" )for j = 0 to (long)fn ArrayCount( codeParts ) - 1if ( j mod 2 == 1 )MutableAttributedStringAppendAttributedString( textLine, fn AttributedStringWithAttributes( fn ArrayObjectAtIndex( codeParts, j ), code ) )elseMutableAttributedStringAppendAttributedString( textLine, fn AttributedStringWithAttributes( fn ArrayObjectAtIndex( codeParts, j ), plain ) )end ifnextend ifnextMutableAttributedStringAppendAttributedString( textLine, fn AttributedStringWithAttributes( @"\n", plain ) )fn RichAppendAttributed( tag, textLine )end fn// simple markup (see the top of this file) -> styled text in the text viewvoid local fn RichTextFromMarkup( tag as long, markup as CFStringRef )CFArrayRef  lines = fn StringComponentsSeparatedByString( fn StringByReplacingOccurrencesOfString( markup, @"\r", @"" ), @"\n" )CFStringRef textLineBOOL        inCode = NOfor textLine in linesif ( fn StringHasPrefix( textLine, @"```" ) )inCode = ( inCode == NO )elseif ( inCode )fn RichAppend( tag, textLine, _richCode )elseif ( fn StringHasPrefix( textLine, @"## " ) )fn RichAppend( tag, fn StringSubstringFromIndex( textLine, 3 ), _richSubheading )elseif ( fn StringHasPrefix( textLine, @"# " ) )fn RichAppend( tag, fn StringSubstringFromIndex( textLine, 2 ), _richHeading )elseif ( fn StringHasPrefix( textLine, @"- " ) )fn RichAppendInline( tag, fn StringWithFormat( @"%C  %@", 0x2022, fn StringSubstringFromIndex( textLine, 2 ) ), _richBullet )elseif ( fn StringLength( textLine ) > 0 ) then fn RichAppendInline( tag, textLine, _richBody )end ifend ifend ifend ifend ifnextend fn