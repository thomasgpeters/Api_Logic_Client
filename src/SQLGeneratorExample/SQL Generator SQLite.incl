/* *   SQL Generator SQLite.incl - runs the SQL the SQL Generator writes, on a SQLite database * *   Part of the SQL Generator module (DataObject.glbl, DataObject_Super.incl, DataObject.incl). *   MIT License. Copyright (c) 2026 Imagery Business Systems, LLC. See LICENSE. * *   The generator only writes SQL text and collects the values for its ? placeholders; this file *   is one way to run it.  Use your own SQLite code instead if you have some: bind the values of *   fn QueryParameterValues( statement ) to the placeholders, in order, starting at 1. * *       ptr db *       fn SQLGenOpen( @"/path/to/file.sqlite", YES, @db )       // YES: create it when missing *       fn SQLGenExecute( db, sql, fn QueryParameterValues( statement ), rows ) *       fn SQLGenLastInsertID( db )   fn SQLGenChanges( db )   fn SQLGenClose( db ) * *   Values come back as Cocoa objects: INTEGER and REAL as NSNumber, TEXT as NSString, BLOB as *   NSData, NULL as NSNull.  Link with -lsqlite3 (Build Settings, or #build in a single file). *   SQLite is in the public domain; this file declares the few calls it needs itself. */include "NSLog.incl"BeginCDeclaration#include <sqlite3.h>EndC_sqlGenOK   = 0_sqlGenROW  = 100_sqlGenDONE = 101// SQL NULL as a value (CF collections cannot hold NULL)local fn SQLGenNull as CFTypeRefcln return (__bridge CFTypeRef)[NSNull null];end fn = NULL// open a database file (":memory:" for one in memory); db receives the handle: pass @myDBlocal fn SQLGenOpen( path as CFStringRef, create as BOOL, db as ptr ) as longcln int flags = SQLITE_OPEN_READWRITE | ( create ? SQLITE_OPEN_CREATE : 0 ); return sqlite3_open_v2( [(__bridge NSString *)path fileSystemRepresentation], (sqlite3 **)db, flags, NULL );end fn = 1local fn SQLGenClose( db as ptr ) as longcln return sqlite3_close( (sqlite3 *)db );end fn = 0local fn SQLGenErrorMessage( db as ptr ) as CFStringRefcln return (__bridge CFStringRef)[NSString stringWithUTF8String:sqlite3_errmsg( (sqlite3 *)db )];end fn = NULLlocal fn SQLGenPrepare( db as ptr, sql as CFStringRef, stmt as ptr ) as longcln return sqlite3_prepare_v2( (sqlite3 *)db, [(__bridge NSString *)sql UTF8String], -1, (sqlite3_stmt **)stmt, NULL );end fn = 1local fn SQLGenStep( stmt as ptr ) as longcln return sqlite3_step( (sqlite3_stmt *)stmt );end fn = 1local fn SQLGenFinalize( stmt as ptr ) as longcln return sqlite3_finalize( (sqlite3_stmt *)stmt );end fn = 0// placeholder index (1-based) <- NSNull / NSNumber (REAL when it holds a float) / NSData / textlocal fn SQLGenBind( stmt as ptr, index as long, value as CFTypeRef ) as longcln id v = (__bridge id)value; sqlite3_stmt *s = (sqlite3_stmt *)stmt; int i = (int)index; if ( v == nil || v == [NSNull null] ) return sqlite3_bind_null( s, i ); if ( [v isKindOfClass:[NSNumber class]] ) { const char *t = [v objCType]; if ( *t == 'd' || *t == 'f' ) return sqlite3_bind_double( s, i, [v doubleValue] ); return sqlite3_bind_int64( s, i, [v longLongValue] ); } if ( [v isKindOfClass:[NSData class]] ) return sqlite3_bind_blob( s, i, [v bytes], (int)[v length], SQLITE_TRANSIENT ); return sqlite3_bind_text( s, i, [[v description] UTF8String], -1, SQLITE_TRANSIENT );end fn = 1local fn SQLGenColumnCount( stmt as ptr ) as longcln return sqlite3_column_count( (sqlite3_stmt *)stmt );end fn = 0local fn SQLGenColumnName( stmt as ptr, col as long ) as CFStringRefcln return (__bridge CFStringRef)[NSString stringWithUTF8String:sqlite3_column_name( (sqlite3_stmt *)stmt, (int)col )];end fn = NULL// the current row's value in a column, as NSNumber / NSString / NSData / NSNulllocal fn SQLGenColumnValue( stmt as ptr, col as long ) as CFTypeRefcln sqlite3_stmt *s = (sqlite3_stmt *)stmt; int c = (int)col; switch ( sqlite3_column_type( s, c ) ) { case SQLITE_INTEGER: return (__bridge CFTypeRef)@( sqlite3_column_int64( s, c ) ); case SQLITE_FLOAT: return (__bridge CFTypeRef)@( sqlite3_column_double( s, c ) ); case SQLITE_BLOB: return (__bridge CFTypeRef)[NSData dataWithBytes:sqlite3_column_blob( s, c ) length:sqlite3_column_bytes( s, c )]; case SQLITE_NULL: return (__bridge CFTypeRef)[NSNull null]; default: return (__bridge CFTypeRef)[NSString stringWithUTF8String:(const char *)sqlite3_column_text( s, c )]; }end fn = NULL// rows changed by the last INSERT / UPDATE / DELETElocal fn SQLGenChanges( db as ptr ) as longcln return sqlite3_changes( (sqlite3 *)db );end fn = 0// the rowid of the last INSERTlocal fn SQLGenLastInsertID( db as ptr ) as longcln return (long)sqlite3_last_insert_rowid( (sqlite3 *)db );end fn = 0/* *   Run one statement.  params fill the ? placeholders in order (NULL for none); rows, when *   not NULL, receives one dictionary per result row (column name or alias -> value). *   Returns _sqlGenDONE when it ran; any other value is SQLite's error code, and the message *   and the SQL are logged. */local fn SQLGenExecute( db as ptr, sql as CFStringRef, params as CFArrayRef, rows as CFMutableArrayRef ) as longptr                    statement = NULLlong                   result, i, columns, paramCountCFMutableDictionaryRef rowif ( db == NULL || sql == NULL ) then exit fn = 1result = fn SQLGenPrepare( db, sql, @statement )if ( result != _sqlGenOK )NSLog( @"SQL Generator: prepare failed: %@\nSQL: %@", fn SQLGenErrorMessage( db ), sql )exit fn = resultend ifif ( params != NULL )paramCount = fn ArrayCount( params )            // a signed count: an empty list binds nothingfor i = 0 to paramCount - 1fn SQLGenBind( statement, i + 1, fn ArrayObjectAtIndex( params, i ) )nextend ifcolumns = fn SQLGenColumnCount( statement )result  = fn SQLGenStep( statement )while ( result == _sqlGenROW )if ( rows != NULL )row = fn MutableDictionaryNewfor i = 0 to columns - 1MutableDictionarySetObjectForKey( row, fn SQLGenColumnValue( statement, i ), fn SQLGenColumnName( statement, i ) )nextMutableArrayAddObject( rows, row )end ifresult = fn SQLGenStep( statement )wendif ( result != _sqlGenDONE ) then NSLog( @"SQL Generator: %@\nSQL: %@\nValues: %@", fn SQLGenErrorMessage( db ), sql, params )fn SQLGenFinalize( statement )end fn = result