/* *   Windows.incl - the example's window: one scrolling output with every example's results, each *   step in colour (Example Output.incl); Run All runs them again * *   MIT License. Copyright (c) 2026 Imagery Business Systems, LLC. See LICENSE. */void local fn BuildWindowCGFloat w = 960, h = 680window _window, @"SQL Generator Example by Imagery Business Systems, LLC", ( 0, 0, w, h ), NSWindowStyleMaskTitled + NSWindowStyleMaskClosable + NSWindowStyleMaskMiniaturizable + NSWindowStyleMaskResizableWindowSetContentMinSize( _window, fn CGSizeMake( 820, 420 ) )WindowCenter( _window )// the top row: [Run All] [Clear] ... [Reset Database] (?)button _runAllButton, YES, , @"Run All", ( 12, h - 44, 96, 30 ), NSButtonTypeMomentaryPushIn, NSBezelStyleRounded, _windowButtonSetKeyEquivalent( _runAllButton, @"\r" )               // Return runs them againViewSetAutoresizingMask( _runAllButton, NSViewMaxXMargin + NSViewMinYMargin )button _clearButton, YES, , @"Clear", ( 110, h - 44, 80, 30 ), NSButtonTypeMomentaryPushIn, NSBezelStyleRounded, _windowViewSetAutoresizingMask( _clearButton, NSViewMaxXMargin + NSViewMinYMargin )button _resetButton, YES, , @"Reset Database", ( w - 186, h - 44, 130, 30 ), NSButtonTypeMomentaryPushIn, NSBezelStyleRounded, _windowViewSetAutoresizingMask( _resetButton, NSViewMinXMargin + NSViewMinYMargin )button _helpButton, YES, , @"", ( w - 46, h - 42, 28, 28 ), NSButtonTypeMomentaryPushIn, NSBezelStyleHelpButton, _windowViewSetAutoresizingMask( _helpButton, NSViewMinXMargin + NSViewMinYMargin )ViewSetToolTip( _helpButton, @"SQL Generator Example Help" )// the output: a scrolling rich-text view, read-only (the text can be selected and copied)scrollview _outputScroll, ( 16, 34, w - 32, h - 34 - 56 ), NSBezelBorder, , _windowViewSetAutoresizingMask( _outputScroll, NSViewWidthSizable + NSViewHeightSizable )textview _outputView, , _outputScroll, , _windowTextViewSetEditable( _outputView, NO )TextViewSetSelectable( _outputView, YES )TextViewSetTextContainerInset( _outputView, fn CGSizeMake( 12, 10 ) )// where the database is, along the bottomtextlabel _databaseLabel, @"", ( 16, 10, w - 32, 16 ), _windowControlSetFont( _databaseLabel, fn FontSystemFontOfSize( 11.0 ) )TextFieldSetTextColor( _databaseLabel, fn ColorSecondaryLabel )ViewSetAutoresizingMask( _databaseLabel, NSViewWidthSizable + NSViewMaxYMargin )end fnvoid local fn ShowDatabasePathControlSetStringValue( _databaseLabel, fn StringWithFormat( @"Database: %@", fn URLPath( fn CRMDatabaseURL ) ) )end fn