/* *   Windows.incl - the example's window: choose an example and run it, or run them all; the *   output pane shows each step in colour (Example Output.incl) * *   MIT License. Copyright (c) 2026 Imagery Business Systems, LLC. See LICENSE. */void local fn BuildWindowCGFloat           w = 960, h = 680CFMutableArrayRef titles = fn MutableArrayNewlong              nfor n = 1 to _exampleCountMutableArrayAddObject( titles, fn ExampleTitle( n ) )nextwindow _window, @"SQL Generator Example", ( 0, 0, w, h ), NSWindowStyleMaskTitled + NSWindowStyleMaskClosable + NSWindowStyleMaskMiniaturizable + NSWindowStyleMaskResizableWindowSetContentMinSize( _window, fn CGSizeMake( 820, 420 ) )WindowCenter( _window )// the top row: Example [popup] [Run] [Run All] [Clear] [Reset Database] (?)textlabel _exampleLabel, @"Example:", ( 16, h - 38, 70, 17 ), _windowViewSetAutoresizingMask( _exampleLabel, NSViewMaxXMargin + NSViewMinYMargin )popupbutton _examplePopup, YES, 0, titles, ( 86, h - 44, 420, 28 ), NO, _windowViewSetAutoresizingMask( _examplePopup, NSViewMaxXMargin + NSViewMinYMargin )button _runButton, YES, , @"Run", ( 512, h - 44, 80, 30 ), NSButtonTypeMomentaryPushIn, NSBezelStyleRounded, _windowButtonSetKeyEquivalent( _runButton, @"\r" )                  // Return runs the chosen exampleViewSetAutoresizingMask( _runButton, NSViewMaxXMargin + NSViewMinYMargin )button _runAllButton, YES, , @"Run All", ( 596, h - 44, 90, 30 ), NSButtonTypeMomentaryPushIn, NSBezelStyleRounded, _windowViewSetAutoresizingMask( _runAllButton, NSViewMaxXMargin + NSViewMinYMargin )button _clearButton, YES, , @"Clear", ( 690, h - 44, 80, 30 ), NSButtonTypeMomentaryPushIn, NSBezelStyleRounded, _windowViewSetAutoresizingMask( _clearButton, NSViewMaxXMargin + NSViewMinYMargin )button _resetButton, YES, , @"Reset Database", ( w - 186, h - 44, 130, 30 ), NSButtonTypeMomentaryPushIn, NSBezelStyleRounded, _windowViewSetAutoresizingMask( _resetButton, NSViewMinXMargin + NSViewMinYMargin )button _helpButton, YES, , @"", ( w - 46, h - 42, 28, 28 ), NSButtonTypeMomentaryPushIn, NSBezelStyleHelpButton, _windowViewSetAutoresizingMask( _helpButton, NSViewMinXMargin + NSViewMinYMargin )ViewSetToolTip( _helpButton, @"SQL Generator Example Help" )// the output: a scrolling rich-text view, read-only (the text can be selected and copied)scrollview _outputScroll, ( 16, 34, w - 32, h - 34 - 56 ), NSBezelBorder, , _windowViewSetAutoresizingMask( _outputScroll, NSViewWidthSizable + NSViewHeightSizable )textview _outputView, , _outputScroll, , _windowTextViewSetEditable( _outputView, NO )TextViewSetSelectable( _outputView, YES )TextViewSetTextContainerInset( _outputView, fn CGSizeMake( 12, 10 ) )// where the database is, along the bottomtextlabel _databaseLabel, @"", ( 16, 10, w - 32, 16 ), _windowControlSetFont( _databaseLabel, fn FontSystemFontOfSize( 11.0 ) )TextFieldSetTextColor( _databaseLabel, fn ColorSecondaryLabel )ViewSetAutoresizingMask( _databaseLabel, NSViewWidthSizable + NSViewMaxYMargin )end fnvoid local fn ShowDatabasePathControlSetStringValue( _databaseLabel, fn StringWithFormat( @"Database: %@", fn URLPath( fn CRMDatabaseURL ) ) )end fn// what the window shows before anything runsvoid local fn ShowWelcomeTextfn OutClearfn RichTextFromMarkup( _outputView, @"# SQL Generator Example\nChoose an example and press **Run** (or Return), or **Run All**. Each one shows the FutureBasic that describes the statement, the SQL the SQL Generator writes for it, the values for its `?` placeholders, and what came back.\n\nThe database is a small CRM: **person**, **address** and **contact**, with five made-up people. **Reset Database** puts it back as it started.\n\nThe user guide is under **Help** (the **?** button)." )end fn