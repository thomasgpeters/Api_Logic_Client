/* *   CRM Examples.incl - the examples: each describes one statement with the SQL Generator, *   generates its SQL, runs it on the CRM database and shows every step (Example Output.incl) * *   The FB each example shows comes from the resource Example Code.txt (### n starts example *   n), so it reads as you would type it.  Keep it in step with the functions below. * *   MIT License. Copyright (c) 2026 Imagery Business Systems, LLC. See LICENSE. */_exampleCount = 10begin globalsCFMutableDictionaryRef gExampleCode     // "1" ... "9" -> the FB lines Example Code.txt has for itend globalslocal fn ExampleTitle( n as long ) as CFStringRefselect ( n )case 1 : exit fn = @"1. Everyone, by surname (SELECT, ORDER BY)"case 2 : exit fn = @"2. A person and their addresses (a join and a filter)"case 3 : exit fn = @"3. Addresses without an apartment (IS NULL)"case 4 : exit fn = @"4. Email addresses at test.com (LIKE, AND)"case 5 : exit fn = @"5. Okafor, or a balance over 1000 (OR)"case 6 : exit fn = @"6. Add a person and their email (INSERT)"case 7 : exit fn = @"7. Change a balance (UPDATE)"case 8 : exit fn = @"8. Remove a phone number (DELETE)"case 9 : exit fn = @"9. Change every balance, with no filter (refused)"case 10 : exit fn = @"10. Add three people at once (INSERT of an array of dictionaries)"end selectend fn = @""// Example Code.txt -> gExampleCodevoid local fn ExampleLoadCodeCFURLRef    url = fn BundleURLForResource( fn BundleMain, @"Example Code", @"txt", NULL )CFStringRef textValue = NULLCFArrayRef  linesCFStringRef textLine, key = NULLCFMutableStringRef code = NULLgExampleCode = fn MutableDictionaryNewif ( url != NULL ) then textValue = fn StringWithContentsOfURL( url, NSUTF8StringEncoding, NULL )if ( textValue == NULL ) then exit fnlines = fn StringComponentsSeparatedByString( fn StringByReplacingOccurrencesOfString( textValue, @"\r", @"" ), @"\n" )for textLine in linesif ( fn StringHasPrefix( textLine, @"### " ) )key = fn StringByTrimmingCharactersInSet( fn StringSubstringFromIndex( textLine, 4 ), fn CharacterSetWhitespaceAndNewlineSet )code = fn MutableStringNewMutableDictionarySetObjectForKey( gExampleCode, code, key )elseif ( code != NULL )if ( fn StringLength( code ) > 0 ) then MutableStringAppendString( code, @"\n" )MutableStringAppendString( code, textLine )end ifend ifnextend fnvoid local fn ExampleShowCode( n as long )CFStringRef code = NULLif ( gExampleCode == NULL ) then fn ExampleLoadCodecode = fn DictionaryObjectForKey( gExampleCode, fn StringWithFormat( @"%ld", n ) )if ( code != NULL ) then fn OutCode( fn StringByTrimmingCharactersInSet( code, fn CharacterSetWhitespaceAndNewlineSet ) )end fn// a SELECT: its SQL, its values, its rowsvoid local fn ExampleShowSelect( sql as CFStringRef, values as CFArrayRef, columns as CFArrayRef )CFMutableArrayRef rows = fn MutableArrayNewfn OutSQL( sql )fn OutValues( values )if ( sql == NULL ) then exit fnif ( fn SQLGenExecute( gDB, sql, values, rows ) != _sqlGenDONE )fn OutLine( fn StringWithFormat( @"SQLite: %@", fn SQLGenErrorMessage( gDB ) ), _richWarning )exit fnend iffn OutRows( rows, columns )end fn// an INSERT, UPDATE or DELETE: its SQL, its values, the rows it changedvoid local fn ExampleShowWrite( sql as CFStringRef, values as CFArrayRef )fn OutSQL( sql )fn OutValues( values )if ( sql == NULL ) then exit fnif ( fn SQLGenExecute( gDB, sql, values, NULL ) != _sqlGenDONE )fn OutLine( fn StringWithFormat( @"SQLite: %@", fn SQLGenErrorMessage( gDB ) ), _richWarning )exit fnend ifif ( fn SQLGenChanges( gDB ) == 1 ) then fn OutLine( @"Query OK, 1 row affected", _richTable ) else fn OutLine( fn StringWithFormat( @"Query OK, %ld rows affected", fn SQLGenChanges( gDB ) ), _richTable )end fnvoid local fn Example1CFMutableDictionaryRef query = fn InitQueryDictionaryfn AddTableToQuery( query, @"person", @"p" )fn AddColumnToQuery( query, @"p.id", @"ID" )fn AddColumnToQuery( query, @"p.givenName", @"Given Name" )fn AddColumnToQuery( query, @"p.surName", @"Surname" )fn AddColumnToQuery( query, @"p.balance", @"Balance" )fn AddOrderToQuery( query, @"p", @"surName", NO )                   // NO: ascending, YES: descendingfn ExampleShowSelect( fn GenerateSelectSQL( query ), fn QueryParameterValues( query ), @[ @"ID", @"Given Name", @"Surname", @"Balance" ] )end fnvoid local fn Example2CFMutableDictionaryRef query = fn InitQueryDictionaryfn AddTableToQuery( query, @"person", @"p" )fn AddTableToQuery( query, @"address", @"a" )fn AddColumnToQuery( query, @"p.givenName", @"Given Name" )fn AddColumnToQuery( query, @"p.surName", @"Surname" )fn AddColumnToQuery( query, @"a.street", @"Street" )fn AddColumnToQuery( query, @"a.apartment", @"Apartment" )fn AddColumnToQuery( query, @"a.city", @"City" )fn AddAssociationToQuery( query, @"a", @"personID", @"p", @"id", _isEqual )fn AddFilterToQuery( query, @"p", @"surName", @"Fischer", _textType, 0, _isEqual, 0 )fn ExampleShowSelect( fn GenerateSelectSQL( query ), fn QueryParameterValues( query ), @[ @"Given Name", @"Surname", @"Street", @"Apartment", @"City" ] )end fnvoid local fn Example3CFMutableDictionaryRef query = fn InitQueryDictionaryfn AddTableToQuery( query, @"address", @"a" )fn AddColumnToQuery( query, @"a.street", @"Street" )fn AddColumnToQuery( query, @"a.city", @"City" )fn AddColumnToQuery( query, @"a.state", @"State" )fn AddFilterToQuery( query, @"a", @"apartment", NULL, _textType, 0, _isNull, 0 )fn ExampleShowSelect( fn GenerateSelectSQL( query ), fn QueryParameterValues( query ), @[ @"Street", @"City", @"State" ] )fn OutNote( @"IS NULL takes no value: there is no ? for it." )end fnvoid local fn Example4CFMutableDictionaryRef query = fn InitQueryDictionaryfn AddTableToQuery( query, @"contact", @"c" )fn AddTableToQuery( query, @"person", @"p" )fn AddColumnToQuery( query, @"p.givenName", @"Given Name" )fn AddColumnToQuery( query, @"c.contact", @"Email" )fn AddAssociationToQuery( query, @"c", @"personID", @"p", @"id", _isEqual )fn AddFilterToQuery( query, @"c", @"type", @"Email", _textType, 0, _isEqual, 0 )fn AddFilterToQuery( query, @"c", @"contact", @"%@test.com", _textType, 0, _isLike, _and )fn ExampleShowSelect( fn GenerateSelectSQL( query ), fn QueryParameterValues( query ), @[ @"Given Name", @"Email" ] )end fnvoid local fn Example5CFMutableDictionaryRef query = fn InitQueryDictionaryfn AddTableToQuery( query, @"person", @"p" )fn AddColumnToQuery( query, @"p.givenName", @"Given Name" )fn AddColumnToQuery( query, @"p.surName", @"Surname" )fn AddColumnToQuery( query, @"p.balance", @"Balance" )fn AddFilterToQuery( query, @"p", @"surName", @"Okafor", _textType, 0, _isEqual, 0 )fn AddFilterToQuery( query, @"p", @"balance", fn NumberWithDouble( 1000.0 ), _realType, 0, _isGreaterThan, _or )fn ExampleShowSelect( fn GenerateSelectSQL( query ), fn QueryParameterValues( query ), @[ @"Given Name", @"Surname", @"Balance" ] )end fnvoid local fn Example6CFMutableDictionaryRef statement = fn InitInsertIntoDictionarylong                   newIDfn AddTableToInsert( statement, @"person" )fn AddColumnToInsert( statement, @"type", @"Business", _textType )fn AddColumnToInsert( statement, @"givenName", @"Ana", _textType )fn AddColumnToInsert( statement, @"surName", @"Lima", _textType )fn AddColumnToInsert( statement, @"balance", fn NumberWithDouble( 0.0 ), _realType )fn ExampleShowWrite( fn GenerateInsertIntoSQL( statement ), fn QueryParameterValues( statement ) )newID = fn SQLGenLastInsertID( gDB )fn OutNote( fn StringWithFormat( @"the new person's id: %ld", newID ) )statement = fn InitInsertIntoDictionaryfn AddTableToInsert( statement, @"contact" )fn AddColumnToInsert( statement, @"personID", fn NumberWithInteger( newID ), _integerType )fn AddColumnToInsert( statement, @"type", @"Email", _textType )fn AddColumnToInsert( statement, @"contact", @"ana.lima@test.com", _textType )fn ExampleShowWrite( fn GenerateInsertIntoSQL( statement ), fn QueryParameterValues( statement ) )end fnvoid local fn Example7CFMutableDictionaryRef statement = fn InitUpdateDictionaryfn AddTableToUpdate( statement, @"person" )fn AddColumnToUpdate( statement, @"balance", fn NumberWithDouble( 99.95 ), _realType )fn AddFilterToQuery( statement, @"", @"surName", @"Okafor", _textType, 0, _isEqual, 0 )fn ExampleShowWrite( fn GenerateUpdateSQL( statement ), fn QueryParameterValues( statement ) )fn OutNote( @"Run example 5 again to see the new balance." )end fnvoid local fn Example8CFMutableDictionaryRef statement = fn InitDeleteFromDictionaryfn AddTableToDelete( statement, @"contact" )fn AddFilterToQuery( statement, @"", @"contact", @"608-555-0199", _textType, 0, _isEqual, 0 )fn ExampleShowWrite( fn GenerateDeleteFromSQL( statement ), fn QueryParameterValues( statement ) )fn OutNote( @"A second run changes 0 rows: it is gone. Reset Database brings it back." )end fnvoid local fn Example9CFMutableDictionaryRef statement = fn InitUpdateDictionaryfn AddTableToUpdate( statement, @"person" )fn AddColumnToUpdate( statement, @"balance", fn NumberWithDouble( 0.0 ), _realType )fn ExampleShowWrite( fn GenerateUpdateSQL( statement ), fn QueryParameterValues( statement ) )fn OutNote( @"An UPDATE or DELETE without a filter would change every row, so the generator returns NULL instead of SQL." )end fn// many rows in one statement: an array of dictionaries, column -> value (what a SELECT gives back)void local fn Example10CFMutableDictionaryRef statement = fn InitInsertRowsDictionaryCFArrayRef             rowsrows = @[ @{ @"type":@"Personal", @"givenName":@"Kai", @"surName":@"Nakamura", @"balance":fn NumberWithDouble( 15.0 ) }, @{ @"type":@"Business", @"givenName":@"Sofia", @"surName":@"Rossi", @"balance":fn NumberWithDouble( 880.0 ) }, @{ @"type":@"Personal", @"givenName":@"Noah", @"surName":@"Berg" } ]fn AddTableToInsert( statement, @"person" )fn AddRowsToInsert( statement, rows )fn ExampleShowWrite( fn GenerateInsertRowsSQL( statement ), fn QueryParameterValues( statement ) )fn OutNote( @"Noah has no balance in his dictionary: it goes in as NULL. Example 1 lists everyone." )end fn// one example: its title, the FB that describes it, then what it doesvoid local fn ExampleRun( n as long )if ( fn CRMDatabaseOpen == NO )fn OutLine( @"The database could not be opened.", _richWarning )exit fnend iffn OutTitle( fn ExampleTitle( n ) )fn ExampleShowCode( n )fn OutLine( @"", _richBody )                                  // a line between the dictionaries and the resultsselect ( n )case 1 : fn Example1case 2 : fn Example2case 3 : fn Example3case 4 : fn Example4case 5 : fn Example5case 6 : fn Example6case 7 : fn Example7case 8 : fn Example8case 9 : fn Example9case 10 : fn Example10end selectfn OutLine( @"", _richBody )                                  // and one before the next exampleTextViewScrollToEndOfDocument( _outputView )end fn// every example, one after another, under the introduction - at launch and on Run All; then back to// the top (each example scrolls to its own end, so only the end of the last one would be in view)void local fn ExampleRunAlllong nfn OutClearfn ShowIntroTextif ( fn CRMDatabaseOpen == NO )fn OutLine( @"The database could not be opened.", _richWarning )exit fnend iffor n = 1 to _exampleCountif ( gLogToNSLog ) then NSLog( @"Run All: example %ld of %ld", n, (long)_exampleCount )fn ExampleRun( n )nextfn OutNote( fn StringWithFormat( @"All %ld examples ran - the first one is at the top.", (long)_exampleCount ) )TextScrollRangeToVisible( _outputView, fn CFRangeMake( 0, 0 ) )end fn