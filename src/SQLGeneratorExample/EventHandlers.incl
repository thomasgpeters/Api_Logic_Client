llcase _clearButton  : fn OutClearcase _resetButton  : fn ResetDatabasecase _helpButton   : fn HelpShowcase _helpPreviewButton : fn HelpPreview               // the Help window's barcase _helpExportButton  : fn HelpExportcase _helpDiagramButton : fn DiagramShowend selectend fn