/* *   Example Output.incl - what each example shows: its title, the FB that describes the *   statement, the SQL the generator writes, the values for its ? placeholders, and the result * *   Written to the window's output pane (Rich Text.incl styles) and, when gLogToNSLog is YES, *   to the NSLog window as well. * *   MIT License. Copyright (c) 2026 Imagery Business Systems, LLC. See LICENSE. */void local fn OutLine( textValue as CFStringRef, style as long )fn RichAppend( _outputView, textValue, style )if ( gLogToNSLog ) then NSLog( @"%@", textValue )end fnvoid local fn OutClearTextSetString( _outputView, @"" )end fnvoid local fn OutTitle( title as CFStringRef )fn OutLine( title, _richSubheading )end fn// the FB calls, as the example's source has themvoid local fn OutCode( code as CFStringRef )fn OutLine( code, _richCode )end fnvoid local fn OutSQL( sql as CFStringRef )if ( sql == NULL )fn OutLine( @"No SQL: the generator refused this statement (see the note below).", _richWarning )exit fnend iffn OutLine( fn StringWithFormat( @"sqlite> %@;", sql ), _richSQL )   // as a SQL command line shows itend fn// the values bound to the ? placeholders, in ordervoid local fn OutValues( values as CFArrayRef )CFMutableArrayRef shown = fn MutableArrayNewCFTypeRef         valueif ( values == NULL ) then exit fnif ( fn ArrayCount( values ) == 0 ) then exit fnfor value in valuesif ( fn ObjectIsKindOfClass( (ObjectRef)value, fn StringClass ) ) then MutableArrayAddObject( shown, fn StringWithFormat( @"'%@'", value ) ) else MutableArrayAddObject( shown, fn StringWithFormat( @"%@", value ) )nextfn OutLine( fn StringWithFormat( @"   -> values for ?: %@", fn ArrayComponentsJoinedByString( shown, @", " ) ), _richValues )end fnvoid local fn OutNote( note as CFStringRef )fn OutLine( note, _richNote )end fn// a value as table text: NULL for SQL NULLlocal fn OutCellText( value as CFTypeRef ) as CFStringRefif ( value == NULL ) then exit fn = @"NULL"if ( fn ObjectIsKindOfClass( (ObjectRef)value, fn ClassFromString( @"NSNull" ) ) ) then exit fn = @"NULL"end fn = fn StringWithFormat( @"%@", value )// numbers line up on the right, as a SQL command line shows themlocal fn OutIsNumber( value as CFTypeRef ) as BOOLif ( value == NULL ) then exit fn = NOend fn = fn ObjectIsKindOfClass( (ObjectRef)value, fn ClassFromString( @"NSNumber" ) )// text padded with spaces to a width, on the right (text) or the left (numbers)local fn OutPad( textValue as CFStringRef, padWidth as long, alignRight as BOOL ) as CFStringRefCFMutableStringRef padding = fn MutableStringNewwhile ( fn StringLength( textValue ) + fn StringLength( padding ) < padWidth )MutableStringAppendString( padding, @" " )wendif ( alignRight ) then exit fn = fn StringWithFormat( @"%@%@", padding, textValue )end fn = fn StringWithFormat( @"%@%@", textValue, padding )// +------+-----------+  the border between a table's partslocal fn OutTableBorder( widths as CFArrayRef ) as CFStringRefCFMutableStringRef border = fn MutableStringWithString( @"+" )CFNumberRef        colWidthlong               ifor colWidth in widthsfor i = 1 to fn NumberIntegerValue( colWidth ) + 2MutableStringAppendString( border, @"-" )nextMutableStringAppendString( border, @"+" )nextend fn = border/* *   Result rows as a SQL command line prints them: *       +----+------------+ *       | ID | Given Name | *       +----+------------+ *       |  1 | Maria      | *       +----+------------+ *       5 rows in set *   columns names them in order (a row dictionary has no order of its own). */void local fn OutRows( rows as CFArrayRef, columns as CFArrayRef )CFMutableArrayRef  widths = fn MutableArrayNewCFMutableStringRef textLineCFDictionaryRef    rowCFStringRef        column, borderCFTypeRef          valuelong               c, w, count = fn ArrayCount( rows )for column in columnsw = fn StringLength( column )for row in rowsif ( fn StringLength( fn OutCellText( fn DictionaryObjectForKey( row, column ) ) ) > w ) then w = fn StringLength( fn OutCellText( fn DictionaryObjectForKey( row, column ) ) )nextMutableArrayAddObject( widths, fn NumberWithInteger( w ) )nextborder = fn OutTableBorder( widths )fn OutLine( border, _richTable )textLine = fn MutableStringWithString( @"|" )for c = 0 to (long)fn ArrayCount( columns ) - 1MutableStringAppendString( textLine, fn StringWithFormat( @" %@ |", fn OutPad( fn ArrayObjectAtIndex( columns, c ), fn NumberIntegerValue( fn ArrayObjectAtIndex( widths, c ) ), NO ) ) )nextfn OutLine( textLine, _richTable )fn OutLine( border, _richTable )for row in rowstextLine = fn MutableStringWithString( @"|" )for c = 0 to (long)fn ArrayCount( columns ) - 1value = fn DictionaryObjectForKey( row, fn ArrayObjectAtIndex( columns, c ) )MutableStringAppendString( textLine, fn StringWithFormat( @" %@ |", fn OutPad( fn OutCellText( value ), fn NumberIntegerValue( fn ArrayObjectAtIndex( widths, c ) ), fn OutIsNumber( value ) ) ) )nextfn OutLine( textLine, _richTable )nextif ( count > 0 ) then fn OutLine( border, _richTable )select ( count )case 0 : fn OutLine( @"Empty set", _richTable )case 1 : fn OutLine( @"1 row in set", _richTable )case else : fn OutLine( fn StringWithFormat( @"%ld rows in set", count ), _richTable )end selectend fn