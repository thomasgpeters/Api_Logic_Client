/* *   CRM Database.incl - the example's database: people, their addresses and their contacts * *   ~/Library/Application Support/SQL Generator Example/crm.sqlite, made on first use with the *   three tables and sample people (all made up).  Reset Database makes it again. *   The sample rows go in through the SQL Generator's INSERT builder: the example's first use *   of it. * *   MIT License. Copyright (c) 2026 Imagery Business Systems, LLC. See LICENSE. */#define CRM_FOLDER_NAME   @"SQL Generator Example"#define CRM_DATABASE_NAME @"crm.sqlite"local fn CRMDatabaseURL as CFURLRefCFURLRef folderURL = fn FileManagerURLForDirectory( NSApplicationSupportDirectory, NSUserDomainMask )folderURL = fn URLByAppendingPathComponent( folderURL, CRM_FOLDER_NAME )if ( fn FileManagerFileExistsAtURL( folderURL ) == NO ) then fn FileManagerCreateDirectoryAtURL( folderURL, YES, NULL )end fn = fn URLByAppendingPathComponent( folderURL, CRM_DATABASE_NAME )// the three tables (the generator writes queries, not schemas: this is plain SQL)local fn CRMCreateTables as BOOLif ( fn SQLGenExecute( gDB, @"CREATE TABLE person ( id INTEGER PRIMARY KEY AUTOINCREMENT, type TEXT, givenName TEXT, middleName TEXT, surName TEXT, balance REAL DEFAULT 0 )", NULL, NULL ) != _sqlGenDONE ) then exit fn = NOif ( fn SQLGenExecute( gDB, @"CREATE TABLE address ( id INTEGER PRIMARY KEY AUTOINCREMENT, personID INTEGER REFERENCES person ( id ), type TEXT, street TEXT, apartment TEXT, city TEXT, state TEXT, zip TEXT )", NULL, NULL ) != _sqlGenDONE ) then exit fn = NOif ( fn SQLGenExecute( gDB, @"CREATE TABLE contact ( id INTEGER PRIMARY KEY AUTOINCREMENT, personID INTEGER REFERENCES person ( id ), type TEXT, contact TEXT )", NULL, NULL ) != _sqlGenDONE ) then exit fn = NOend fn = YES// one person, through the INSERT builder; returns the new idlocal fn CRMAddPerson( personType as CFStringRef, givenName as CFStringRef, surName as CFStringRef, balance as double ) as longCFMutableDictionaryRef statement = fn InitInsertIntoDictionaryfn AddTableToInsert( statement, @"person" )fn AddColumnToInsert( statement, @"type", personType, _textType )fn AddColumnToInsert( statement, @"givenName", givenName, _textType )fn AddColumnToInsert( statement, @"surName", surName, _textType )fn AddColumnToInsert( statement, @"balance", fn NumberWithDouble( balance ), _realType )if ( fn SQLGenExecute( gDB, fn GenerateInsertIntoSQL( statement ), fn QueryParameterValues( statement ), NULL ) != _sqlGenDONE ) then exit fn = 0end fn = fn SQLGenLastInsertID( gDB )// an address; apartment NULL when there is nonevoid local fn CRMAddAddress( personID as long, street as CFStringRef, apartment as CFStringRef, city as CFStringRef, state as CFStringRef, zip as CFStringRef )CFMutableDictionaryRef statement = fn InitInsertIntoDictionaryfn AddTableToInsert( statement, @"address" )fn AddColumnToInsert( statement, @"personID", fn NumberWithInteger( personID ), _integerType )fn AddColumnToInsert( statement, @"type", @"Home", _textType )fn AddColumnToInsert( statement, @"street", street, _textType )if ( apartment == NULL ) then fn AddColumnToInsert( statement, @"apartment", NULL, _nullType ) else fn AddColumnToInsert( statement, @"apartment", apartment, _textType )fn AddColumnToInsert( statement, @"city", city, _textType )fn AddColumnToInsert( statement, @"state", state, _textType )fn AddColumnToInsert( statement, @"zip", zip, _textType )fn SQLGenExecute( gDB, fn GenerateInsertIntoSQL( statement ), fn QueryParameterValues( statement ), NULL )end fnvoid local fn CRMAddContact( personID as long, contactType as CFStringRef, contact as CFStringRef )CFMutableDictionaryRef statement = fn InitInsertIntoDictionaryfn AddTableToInsert( statement, @"contact" )fn AddColumnToInsert( statement, @"personID", fn NumberWithInteger( personID ), _integerType )fn AddColumnToInsert( statement, @"type", contactType, _textType )fn AddColumnToInsert( statement, @"contact", contact, _textType )fn SQLGenExecute( gDB, fn GenerateInsertIntoSQL( statement ), fn QueryParameterValues( statement ), NULL )end fn// sample people - all made up; 555 numbers and test addresses are never realvoid local fn CRMAddSampleDatalong idid = fn CRMAddPerson( @"Business", @"Maria", @"Santos", 250.0 )fn CRMAddAddress( id, @"12 Harbor Rd.", @"Suite 4", @"Portland", @"ME", @"04101" )fn CRMAddContact( id, @"Email", @"maria.santos@test.com" )fn CRMAddContact( id, @"Phone", @"207-555-0142" )id = fn CRMAddPerson( @"Personal", @"James", @"Okafor", 0.0 )fn CRMAddAddress( id, @"88 Elm St.", NULL, @"Columbus", @"OH", @"43215" )fn CRMAddContact( id, @"Email", @"j.okafor@example.com" )id = fn CRMAddPerson( @"Business", @"Lena", @"Fischer", 1200.5 )fn CRMAddAddress( id, @"5 Mill Ln.", NULL, @"Madison", @"WI", @"53703" )fn CRMAddAddress( id, @"300 Lake Dr.", @"Apt. 12", @"Madison", @"WI", @"53704" )fn CRMAddContact( id, @"Email", @"lena@test.com" )id = fn CRMAddPerson( @"Personal", @"Tom", @"Becker", 75.25 )fn CRMAddContact( id, @"Phone", @"608-555-0199" )id = fn CRMAddPerson( @"Business", @"Priya", @"Raman", 430.0 )fn CRMAddAddress( id, @"41 Cedar Ave.", NULL, @"Austin", @"TX", @"78701" )fn CRMAddContact( id, @"Email", @"priya.raman@test.com" )end fn// open the database, making it (tables and sample people) when it is not there yetlocal fn CRMDatabaseOpen as BOOLCFURLRef url = fn CRMDatabaseURLBOOL     isNew = ( fn FileManagerFileExistsAtURL( url ) == NO )if ( gDB != NULL ) then exit fn = YESif ( fn SQLGenOpen( fn URLPath( url ), YES, @gDB ) != _sqlGenOK )if ( isLoggingOn ) then NSLog( @"Could not open %@", fn URLPath( url ) )gDB = NULLexit fn = NOend ifif ( isNew )if ( fn CRMCreateTables == NO ) then exit fn = NOfn CRMAddSampleDataend ifend fn = YESvoid local fn CRMDatabaseCloseif ( gDB != NULL ) then fn SQLGenClose( gDB )gDB = NULLend fn// Reset Database: close it, delete the file, make it againlocal fn CRMDatabaseReset as BOOLfn CRMDatabaseCloseif ( fn FileManagerFileExistsAtURL( fn CRMDatabaseURL ) ) then fn FileManagerRemoveItemAtURL( fn CRMDatabaseURL )end fn = fn CRMDatabaseOpen