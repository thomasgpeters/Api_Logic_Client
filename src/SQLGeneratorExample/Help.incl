/* *   Help.incl - the Help window: the user guide in a scrolling, read-only rich-text view * *   The guide is the resource User Guide.txt, written in the simple markup of Rich Text.incl *   (# headings, **bold**, ``` code blocks), so it is easy to edit and reads well in light and *   dark mode. * *   MIT License. Copyright (c) 2026 Imagery Business Systems, LLC. See LICENSE. */void local fn HelpShowCFURLRef    urlCFStringRef guide = NULLif ( fn WindowExists( _helpWindow ) )WindowMakeKeyAndOrderFront( _helpWindow )                  // already open: bring it forwardexit fnend ifwindow _helpWindow, @"SQL Generator Example Help", ( 0, 0, 680, 620 ), NSWindowStyleMaskTitled + NSWindowStyleMaskClosable + NSWindowStyleMaskMiniaturizable + NSWindowStyleMaskResizableWindowSetContentMinSize( _helpWindow, fn CGSizeMake( 420, 300 ) )scrollview _helpScroll, ( 0, 0, 680, 620 ), NSNoBorder, , _helpWindowViewSetAutoresizingMask( _helpScroll, NSViewWidthSizable + NSViewHeightSizable )textview _helpView, , _helpScroll, , _helpWindowTextViewSetEditable( _helpView, NO )TextViewSetSelectable( _helpView, YES )                     // the code can be copiedTextViewSetTextContainerInset( _helpView, fn CGSizeMake( 24, 20 ) )url = fn BundleURLForResource( fn BundleMain, @"User Guide", @"txt", NULL )if ( url != NULL ) then guide = fn StringWithContentsOfURL( url, NSUTF8StringEncoding, NULL )if ( guide == NULL ) then guide = @"# Help\nThe user guide (User Guide.txt) is missing from the app's resources."fn RichTextFromMarkup( _helpView, guide )TextScrollRangeToVisible( _helpView, fn CFRangeMake( 0, 0 ) )   // start at the topend fn