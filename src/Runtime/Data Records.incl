/* *   I M A G E R Y    B U S I N E S S     S Y S T E M S,   L L C * *   Data Records.incl - runtime, copied into every generated app * *   Records of the model's entities, read and written through the DataObject query *   builder (DataObject.glbl / DataObject_Super.incl / DataObject.incl) and run by *   Data SQLite.incl.  This is the layer the app shell and the rules engine use. * *   A record is a mutable dictionary: column name -> NSNumber / NSString / NSData / *   NSNull.  Key values are a dictionary of the key columns (fn DataKeyValues). *   Several writes that belong together go between DataBegin and DataEnd. * *       DataOpen / DataClose                  the project's database (Model.json "database") *       DataFetch( entity, filter, order )    records matching column = value filters *       DataFetchOne( entity, filter )        the first match, or NULL *       DataParent( entity, record, role )    the record's parent along a toone role *       DataChildren( entity, record, list )  the record's children along a tomany list *       DataInsert( entity, record )          YES/NO; a generated key is set in record *       DataUpdate( entity, record, keys )    rows changed (-1: failed) *       DataDelete( entity, keys )            rows changed (-1: failed) */// path NULL: the database named in Model.jsonlocal fn DataOpen( path as CFStringRef ) as BOOLif ( gDataDB != NULL ) then exit fn = YESif ( path == NULL )if ( gDataEntities == NULL ) then fn DataModelLoadpath = gDataDatabasePathend ifif ( path == NULL )NSLog( @"Data: no database - Model.json has no \"database\" and none was given." )exit fn = NOend ifif ( fn FileManagerFileExistsAtURL( fn URLFileURLWithPath( path ) ) == NO )NSLog( @"Data: the database is missing: %@", path )exit fn = NOend ifif ( fn DataSQLiteOpen( path, @gDataDB ) != _dataSQLiteOK )NSLog( @"Data: could not open %@: %@", path, fn DataSQLiteErrorMessage( gDataDB ) )fn DataSQLiteClose( gDataDB )gDataDB = NULLexit fn = NOend ifgDataTransactionDepth = 0if (isLoggingOn) then NSLog( @"Data: opened %@", path )end fn = YESvoid local fn DataCloseif ( gDataDB == NULL ) then exit fnfn DataSQLiteClose( gDataDB )gDataDB = NULLend fn// the key columns' values of a recordlocal fn DataKeyValues( entityName as CFStringRef, aRecord as CFDictionaryRef ) as CFMutableDictionaryRefCFMutableDictionaryRef keyValues = fn MutableDictionaryNewCFArrayRef             keys = fn DataKeys( entityName )CFStringRef            keyNameCFTypeRef              valuefor keyName in keysvalue = fn DictionaryObjectForKey( aRecord, keyName )if ( value == NULL ) then value = fn DataNullMutableDictionarySetObjectForKey( keyValues, value, keyName )nextend fn = keyValues// column = value filters (column IS NULL for NSNull values), all of them (AND)void local fn DataAddFilters( statementDictionaryRef as CFMutableDictionaryRef, tableAlias as CFStringRef, filter as CFDictionaryRef )CFArrayRef  namesCFStringRef columnNameCFTypeRef   valueif ( filter == NULL ) then exit fnnames = fn DictionaryAllKeys( filter )for columnName in namesvalue = fn DictionaryObjectForKey( filter, columnName )if ( fn DataIsNull( value ) )fn AddFilterToQuery( statementDictionaryRef, tableAlias, columnName, NULL, _nullType, 0, _isNull, _and )elsefn AddFilterToQuery( statementDictionaryRef, tableAlias, columnName, value, _textType, 0, _isEqual, _and )end ifnextend fn// records of an entity; filter: { column: value } or NULL for all; orderNames: columns or NULLlocal fn DataFetch( entityName as CFStringRef, filter as CFDictionaryRef, orderNames as CFArrayRef ) as CFMutableArrayRefCFMutableArrayRef      rows = fn MutableArrayNewCFMutableDictionaryRef queryCFMutableStringRef     sqlCFArrayRef             columns = fn DataColumns( entityName )CFStringRef            columnNamelong                   iif ( fn ArrayCount( columns ) == 0 )NSLog( @"Data: %@ is not in the model.", entityName )exit fn = rowsend ifquery = fn InitQueryDictionaryfn AddTableToQuery( query, entityName, @"t" )for columnName in columnsfn AddColumnToQuery( query, columnName, columnName )nextfn DataAddFilters( query, @"t", filter )sql = fn GenerateSelectSQL( query )if ( orderNames != NULL )for i = 0 to (long)fn ArrayCount( orderNames ) - 1if ( i == 0 ) then MutableStringAppendString( sql, @" ORDER BY " ) else MutableStringAppendString( sql, @", " )MutableStringAppendString( sql, fn QuoteSQLName( fn ArrayObjectAtIndex( orderNames, i ) ) )nextend iffn DataExecute( sql, fn QueryParameterValues( query ), rows )end fn = rowslocal fn DataFetchOne( entityName as CFStringRef, filter as CFDictionaryRef ) as CFMutableDictionaryRefCFMutableArrayRef rows = fn DataFetch( entityName, filter, NULL )if ( fn ArrayCount( rows ) == 0 ) then exit fn = NULLend fn = (CFMutableDictionaryRef)fn ArrayObjectAtIndex( rows, 0 )// the record's parent along a toone role (e.g. an Order's "Customer"); NULL when the// foreign key is empty or the parent is missinglocal fn DataParent( entityName as CFStringRef, aRecord as CFDictionaryRef, roleName as CFStringRef ) as CFMutableDictionaryRefCFDictionaryRef        relationship = fn DataRelationship( entityName, roleName )CFMutableDictionaryRef filter = fn MutableDictionaryNewCFArrayRef             fks, parentKeysCFTypeRef              valuelong                   iif ( relationship == NULL ) then exit fn = NULLfks        = fn DictionaryObjectForKey( relationship, @"fks" )parentKeys = fn DictionaryObjectForKey( relationship, @"parentKeys" )for i = 0 to (long)fn ArrayCount( fks ) - 1value = fn DictionaryObjectForKey( aRecord, fn ArrayObjectAtIndex( fks, i ) )if ( fn DataIsNull( value ) ) then exit fn = NULLMutableDictionarySetObjectForKey( filter, value, fn ArrayObjectAtIndex( parentKeys, i ) )nextend fn = fn DataFetchOne( fn DictionaryObjectForKey( relationship, @"resource" ), filter )// the record's children along a tomany list (e.g. a Customer's "OrderList")local fn DataChildren( entityName as CFStringRef, aRecord as CFDictionaryRef, listName as CFStringRef ) as CFMutableArrayRefCFDictionaryRef        relationship = fn DataRelationship( entityName, listName )CFMutableDictionaryRef filter = fn MutableDictionaryNewCFArrayRef             fks, parentKeysCFTypeRef              valuelong                   iif ( relationship == NULL ) then exit fn = fn MutableArrayNewfks        = fn DictionaryObjectForKey( relationship, @"fks" )parentKeys = fn DictionaryObjectForKey( relationship, @"parentKeys" )for i = 0 to (long)fn ArrayCount( fks ) - 1value = fn DictionaryObjectForKey( aRecord, fn ArrayObjectAtIndex( parentKeys, i ) )if ( fn DataIsNull( value ) ) then exit fn = fn MutableArrayNewMutableDictionarySetObjectForKey( filter, value, fn ArrayObjectAtIndex( fks, i ) )nextend fn = fn DataFetch( fn DictionaryObjectForKey( relationship, @"resource" ), filter, NULL )// insert the record's columns; a key SQLite generates (identity / autoincrement) is left// out when empty and set in the record afterwardslocal fn DataInsert( entityName as CFStringRef, aRecord as CFMutableDictionaryRef ) as BOOLCFMutableDictionaryRef statementCFArrayRef             columns = fn DataColumns( entityName )CFArrayRef             keys    = fn DataKeys( entityName )CFStringRef            columnNameCFTypeRef              valueBOOL                   generated = fn DataKeyIsGenerated( entityName )if ( fn DataIsView( entityName ) ) then exit fn = NOstatement = fn InitInsertIntoDictionaryfn AddTableToInsert( statement, entityName )for columnName in columnsvalue = fn DictionaryObjectForKey( aRecord, columnName )if ( value != NULL )if ( generated == NO || fn DataIsNull( value ) == NO || fn ArrayContainsObject( keys, columnName ) == NO ) then fn AddColumnToInsert( statement, columnName, value, _textType )end ifnextif ( fn DataExecute( fn GenerateInsertIntoSQL( statement ), fn QueryParameterValues( statement ), NULL ) != _dataSQLiteDONE ) then exit fn = NOif ( generated && fn ArrayCount( keys ) == 1 )if ( fn DataIsNull( fn DictionaryObjectForKey( aRecord, fn ArrayFirstObject( keys ) ) ) ) then MutableDictionarySetObjectForKey( aRecord, fn DataSQLiteLastInsertID( gDataDB ), fn ArrayFirstObject( keys ) )end ifend fn = YES// write the record's columns to the row with these key values (which may differ from the// record's own, when the key itself changed)local fn DataUpdate( entityName as CFStringRef, aRecord as CFDictionaryRef, keyValues as CFDictionaryRef ) as longCFMutableDictionaryRef statementCFMutableStringRef     sqlCFArrayRef             columns = fn DataColumns( entityName )CFStringRef            columnNameCFTypeRef              valueif ( fn DataIsView( entityName ) || keyValues == NULL ) then exit fn = -1if ( fn DictionaryCount( keyValues ) == 0 ) then exit fn = -1statement = fn InitUpdateDictionaryfn AddTableToUpdate( statement, entityName )for columnName in columnsvalue = fn DictionaryObjectForKey( aRecord, columnName )if ( value != NULL ) then fn AddColumnToUpdate( statement, columnName, value, _textType )nextfn DataAddFilters( statement, @"", keyValues )sql = fn GenerateUpdateSQL( statement )if ( sql == NULL ) then exit fn = -1if ( fn DataExecute( sql, fn QueryParameterValues( statement ), NULL ) != _dataSQLiteDONE ) then exit fn = -1end fn = fn DataSQLiteChanges( gDataDB )local fn DataDelete( entityName as CFStringRef, keyValues as CFDictionaryRef ) as longCFMutableDictionaryRef statementCFMutableStringRef     sqlif ( fn DataIsView( entityName ) || keyValues == NULL ) then exit fn = -1if ( fn DictionaryCount( keyValues ) == 0 ) then exit fn = -1statement = fn InitDeleteFromDictionaryfn AddTableToDelete( statement, entityName )fn DataAddFilters( statement, @"", keyValues )sql = fn GenerateDeleteFromSQL( statement )if ( sql == NULL ) then exit fn = -1if ( fn DataExecute( sql, fn QueryParameterValues( statement ), NULL ) != _dataSQLiteDONE ) then exit fn = -1end fn = fn DataSQLiteChanges( gDataDB )