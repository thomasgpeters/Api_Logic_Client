/* *   I M A G E R Y    B U S I N E S S     S Y S T E M S,   L L C * *   Record Search.incl - runtime: the records that match a search * *   The toolbar's search (App Toolbar.incl) narrows the page's List to the records that match: *       found = fn RecordSearchFilter( records, @"alfreds berlin" ) *   Every word must be found in some value of the record, as Finder matches: any case, any accent *   ("muller" finds "Müller").  Empty text: every record. * *   MIT License. Copyright (c) 2026 Imagery Business Systems, LLC. */// does one record hold every word of the search?local fn RecordSearchMatches( aRecord as CFDictionaryRef, words as CFArrayRef ) as BOOLCFArrayRef  values = fn DictionaryAllValues( aRecord )CFStringRef word, valueTextCFTypeRef   valueBOOL        wordFoundfor word in wordsif ( fn StringLength( word ) > 0 )wordFound = NOfor value in valuesif ( wordFound == NO )valueText = fn StringWithFormat( @"%@", value )if ( fn StringIsEqual( valueText, @"<null>" ) == NO ) then wordFound = fn StringLocalizedStandardContainsString( valueText, word )end ifnextif ( wordFound == NO ) then exit fn = NOend ifnextend fn = YES// the records that match searchText (all of them when it is empty)local fn RecordSearchFilter( records as CFArrayRef, searchText as CFStringRef ) as CFArrayRefCFMutableArrayRef found = fn MutableArrayNewCFArrayRef        wordsCFDictionaryRef   aRecordif ( records == NULL ) then exit fn = @[]if ( fn StringLength( searchText ) == 0 ) then exit fn = recordswords = fn StringComponentsSeparatedByString( searchText, @" " )for aRecord in recordsif ( fn RecordSearchMatches( aRecord, words ) ) then MutableArrayAddObject( found, aRecord )nextend fn = found