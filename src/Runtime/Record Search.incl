/* *   I M A G E R Y    B U S I N E S S     S Y S T E M S,   L L C * *   Record Search.incl - runtime: the records that match a search * *   The toolbar's search (App Toolbar.incl) narrows the page's List to the records that match: *       found = fn RecordSearchFilter( records, @"alfreds berlin" ) *   Every word must be found in some value of the record, as Finder matches: any case, any accent *   ("muller" finds "Müller").  Empty text: every record. * *   The search dialog asks by field (App Toolbar.incl) and sends a query { field, mode, text }: *       found = fn RecordSearchQuery( records, query ) *   mode "text": the field holds every word (field "" : any field); "value": the field's value is exactly text (a *   value chosen from the field's distinct values); "date": the field's date is that day (text "yyyy-mm-dd"). * *   MIT License. Copyright (c) 2026 Imagery Business Systems, LLC. */// does one record hold every word of the search?local fn RecordSearchMatches( aRecord as CFDictionaryRef, words as CFArrayRef ) as BOOLCFArrayRef  values = fn DictionaryAllValues( aRecord )CFStringRef word, valueTextCFTypeRef   valueBOOL        wordFoundfor word in wordsif ( fn StringLength( word ) > 0 )wordFound = NOfor value in valuesif ( wordFound == NO )valueText = fn StringWithFormat( @"%@", value )if ( fn StringIsEqual( valueText, @"<null>" ) == NO ) then wordFound = fn StringLocalizedStandardContainsString( valueText, word )end ifnextif ( wordFound == NO ) then exit fn = NOend ifnextend fn = YES// the records that match searchText (all of them when it is empty)local fn RecordSearchFilter( records as CFArrayRef, searchText as CFStringRef ) as CFArrayRefCFMutableArrayRef found = fn MutableArrayNewCFArrayRef        wordsCFDictionaryRef   aRecordif ( records == NULL ) then exit fn = @[]if ( fn StringLength( searchText ) == 0 ) then exit fn = recordswords = fn StringComponentsSeparatedByString( searchText, @" " )for aRecord in recordsif ( fn RecordSearchMatches( aRecord, words ) ) then MutableArrayAddObject( found, aRecord )nextend fn = found// a value as the search reads it: its text, without spaces around it ("" for none)local fn RecordSearchText( value as CFTypeRef ) as CFStringRefCFStringRef valueTextif ( value == NULL ) then exit fn = @""valueText = fn StringWithFormat( @"%@", value )if ( fn StringIsEqual( valueText, @"<null>" ) ) then exit fn = @""end fn = fn StringByTrimmingCharactersInSet( valueText, fn CharacterSetWhitespaceSet )// the search dialog's query: by one field (or any), as text, as one of its values, or as a datelocal fn RecordSearchQuery( records as CFArrayRef, query as CFDictionaryRef ) as CFArrayRefCFMutableArrayRef found = fn MutableArrayNewCFStringRef       fieldName, searchMode, searchText, valueTextCFArrayRef        wordsCFDictionaryRef   aRecordBOOL              matchesif ( records == NULL ) then exit fn = @[]if ( query == NULL ) then exit fn = recordsfieldName  = fn DictionaryObjectForKey( query, @"field" )searchMode = fn DictionaryObjectForKey( query, @"mode" )searchText = fn DictionaryObjectForKey( query, @"text" )if ( fn StringLength( searchText ) == 0 ) then exit fn = recordsif ( fn StringLength( fieldName ) == 0 ) then exit fn = fn RecordSearchFilter( records, searchText )   // any fieldwords = fn StringComponentsSeparatedByString( searchText, @" " )for aRecord in recordsvalueText = fn RecordSearchText( fn DictionaryObjectForKey( aRecord, fieldName ) )matches = NOif ( fn StringIsEqual( searchMode, @"value" ) )matches = fn StringIsEqual( valueText, searchText )elseif ( fn StringIsEqual( searchMode, @"date" ) )matches = fn StringHasPrefix( valueText, searchText )                 // "1996-07-04", "1996-07-04 00:00:00", "1996-07-04T..."elsematches = fn RecordSearchMatches( @{ @"value":valueText }, words )end ifend ifif ( matches ) then MutableArrayAddObject( found, aRecord )nextend fn = found