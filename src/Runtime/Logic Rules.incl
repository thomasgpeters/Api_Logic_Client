/* *   I M A G E R Y    B U S I N E S S     S Y S T E M S,   L L C * *   Logic Rules.incl - runtime: LogicBank for FutureBasic, the rule set * *   Rules are declared once at start-up, in FB, then enforced by the engine on every *   save (Logic Engine.incl).  A rule set is FB source: * *       // OrderDetail.Amount = Quantity * UnitPrice *       local fn OrderDetailAmount( logicRow as LogicRowRef ) as CFTypeRef *       end fn = fn NumberWithDouble( fn LogicDouble( logicRow, @"Quantity" ) * fn LogicDouble( logicRow, @"UnitPrice" ) ) * *       // Customer: Balance <= CreditLimit *       local fn CustomerCreditCheck( logicRow as LogicRowRef ) as BOOL *       end fn = ( fn LogicDouble( logicRow, @"Balance" ) <= fn LogicDouble( logicRow, @"CreditLimit" ) ) * *       void local fn DeclareRules *       fn LogicFormula( @"OrderDetail", @"Amount", @fn OrderDetailAmount, @[ @"Quantity", @"UnitPrice" ] ) *       fn LogicConstraint( @"Customer", @fn CustomerCreditCheck, @"Balance {Balance} exceeds credit limit {CreditLimit}" ) *       end fn * *       fn DeclareRules : fn LogicActivate         // in main, after DataOpen * *   Rule functions take the row being saved (LogicRowRef, read with LogicValue / *   LogicDouble / ... in Logic Row.incl) and are called by address.  A formula names *   the attributes it reads (dependsOn): formulas run in dependency order, and on an *   update a formula whose inputs did not change is skipped. * *   Clean-room: written from LogicBank's documented behaviour, not its code. */#define LogicRowRef as MutableDictionaryRefbegin globalsMutableDictionaryRef gLogicRules        // entity -> { formulas: [ rule ], constraints: [ rule ] }BOOL                 gLogicActive       // LogicActivate succeededend globals// the rule lists of one entity (created on first use)local fn LogicEntityRules( entityName as StringRef ) as MutableDictionaryRefMutableDictionaryRef rulesif ( gLogicRules == NULL ) then gLogicRules = fn MutableDictionaryNewrules = (MutableDictionaryRef)fn DictionaryObjectForKey( gLogicRules, entityName )if ( rules == NULL )rules = fn MutableDictionaryNewMutableDictionarySetObjectForKey( rules, fn MutableArrayNew, @"formulas" )MutableDictionarySetObjectForKey( rules, fn MutableArrayNew, @"constraints" )MutableDictionarySetObjectForKey( gLogicRules, rules, entityName )end ifend fn = rules/* *   attrName = formulaFn( logicRow )     formulaFn: local fn ( logicRow as LogicRowRef ) as CFTypeRef *   dependsOn: the attributes the formula reads - [ "Quantity", "UnitPrice" ] *   (an empty list: the formula runs on every insert and update) */void local fn LogicFormula( entityName as StringRef, attrName as StringRef, formulaFn as ptr, dependsOn as ArrayRef )MutableArrayRef formulas = (MutableArrayRef)fn DictionaryObjectForKey( fn LogicEntityRules( entityName ), @"formulas" )if ( dependsOn == NULL ) then dependsOn = @[]MutableArrayAddObject( formulas, @{ @"kind":@"formula", @"entity":entityName, @"attr":attrName, @"fn":fn ValueWithPointer( formulaFn ), @"dependsOn":dependsOn } )gLogicActive = NOend fn/* *   constraintFn( logicRow ) must be YES, else the save fails and rolls back. *   constraintFn: local fn ( logicRow as LogicRowRef ) as BOOL *   message: shown to the user; {Attr} (or {row.Attr}) is replaced by the row's value. */void local fn LogicConstraint( entityName as StringRef, constraintFn as ptr, message as StringRef )MutableArrayRef constraints = (MutableArrayRef)fn DictionaryObjectForKey( fn LogicEntityRules( entityName ), @"constraints" )if ( message == NULL ) then message = fn StringWithFormat( @"%@ constraint failed", entityName )MutableArrayAddObject( constraints, @{ @"kind":@"constraint", @"entity":entityName, @"fn":fn ValueWithPointer( constraintFn ), @"message":message } )end fnlocal fn LogicRulesOf( entityName as StringRef, kind as StringRef ) as ArrayRefDictionaryRef rulesif ( gLogicRules == NULL ) then exit fn = @[]rules = fn DictionaryObjectForKey( gLogicRules, entityName )if ( rules == NULL ) then exit fn = @[]end fn = fn DictionaryObjectForKey( rules, kind )// a rule names entities and attributes that must be in the modellocal fn LogicCheckNames( rule as DictionaryRef ) as BOOLStringRef  entityName = fn DictionaryObjectForKey( rule, @"entity" )ArrayRef   columns = fn DataColumns( entityName )ArrayRef   dependsOnStringRef  attrNameif ( fn ArrayCount( columns ) == 0 )NSLog( @"Logic: rule on %@, which is not in the model.", entityName )exit fn = NOend ifattrName = fn DictionaryObjectForKey( rule, @"attr" )if ( attrName != NULL )if ( fn ArrayContainsObject( columns, attrName ) == NO )NSLog( @"Logic: formula derives %@.%@, which is not in the model.", entityName, attrName )exit fn = NOend ifend ifdependsOn = fn DictionaryObjectForKey( rule, @"dependsOn" )if ( dependsOn != NULL )for attrName in dependsOn// parent references (Role.Attr) are checked when parent rules arrive (step 2)if ( fn StringContainsString( attrName, @"." ) == NO && fn ArrayContainsObject( columns, attrName ) == NO )NSLog( @"Logic: formula %@.%@ depends on %@, which is not in the model.", entityName, fn DictionaryObjectForKey( rule, @"attr" ), attrName )exit fn = NOend ifnextend ifend fn = YES/* *   Put one entity's formulas in dependency order: a formula runs after every formula *   that derives an attribute it reads.  NO (and a log naming them) on a cycle. */local fn LogicOrderFormulas( entityName as StringRef ) as BOOLMutableDictionaryRef rules = fn LogicEntityRules( entityName )ArrayRef             formulas = fn DictionaryObjectForKey( rules, @"formulas" )MutableArrayRef      ordered = fn MutableArrayNewMutableArrayRef      derived = fn MutableArrayNew     // attributes still waiting to be derivedMutableStringRef     cycleDictionaryRef        formulaArrayRef             dependenciesStringRef            attrName, dependencyBOOL                 progress, readyfor formula in formulasMutableArrayAddObject( derived, fn DictionaryObjectForKey( formula, @"attr" ) )nextprogress = YESwhile ( progress && fn ArrayCount( ordered ) < fn ArrayCount( formulas ) )progress = NOfor formula in formulasattrName = fn DictionaryObjectForKey( formula, @"attr" )if ( fn ArrayContainsObject( derived, attrName ) )ready = YESdependencies = fn DictionaryObjectForKey( formula, @"dependsOn" )for dependency in dependenciesif ( fn StringIsEqual( dependency, attrName ) == NO && fn ArrayContainsObject( derived, dependency ) ) then ready = NOnextif ( ready )MutableArrayAddObject( ordered, formula )MutableArrayRemoveObject( derived, attrName )progress = YESend ifend ifnextwendif ( fn ArrayCount( ordered ) < fn ArrayCount( formulas ) )cycle = fn MutableStringNewfor attrName in derivedif ( fn StringLength( cycle ) > 0 ) then MutableStringAppendString( cycle, @", " )MutableStringAppendString( cycle, attrName )nextNSLog( @"Logic: %@ formulas depend on each other in a cycle: %@", entityName, cycle )exit fn = NOend ifMutableDictionarySetObjectForKey( rules, ordered, @"formulas" )end fn = YES// after all rules are declared: check names, order formulas.  NO: the rules are not used.local fn LogicActivate as BOOLArrayRef      entityNames, rulesStringRef     entityNameDictionaryRef ruleBOOL          ok = YESgLogicActive = NOif ( gLogicRules == NULL ) then gLogicRules = fn MutableDictionaryNewentityNames = fn DictionaryAllKeys( gLogicRules )for entityName in entityNamesrules = fn LogicRulesOf( entityName, @"formulas" )for rule in rulesif ( fn LogicCheckNames( rule ) == NO ) then ok = NOnextrules = fn LogicRulesOf( entityName, @"constraints" )for rule in rulesif ( fn LogicCheckNames( rule ) == NO ) then ok = NOnextif ( fn LogicOrderFormulas( entityName ) == NO ) then ok = NOnextif ( ok == NO )alert 1, NSAlertStyleCritical, @"The business rules could not be activated.", @"See the NSLog window for the rules and attributes involved.", @[@"OK"], NOexit fn = NOend ifgLogicActive = YESif (isLoggingOn) then NSLog( @"Logic: rules active for %ld entities", (long)fn ArrayCount( entityNames ) )end fn = YES