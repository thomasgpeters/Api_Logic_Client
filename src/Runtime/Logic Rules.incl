/* *   I M A G E R Y    B U S I N E S S     S Y S T E M S,   L L C * *   Logic Rules.incl - runtime: LogicBank for FutureBasic, the rule set * *   Rules are declared once at start-up, in FB, then enforced by the engine on every *   save (Logic Engine.incl).  A rule set is FB source: * *       // OrderDetail.Amount = Quantity * UnitPrice *       local fn OrderDetailAmount( logicRow as LogicRowRef ) as CFTypeRef *       end fn = fn NumberWithDouble( fn LogicDouble( logicRow, @"Quantity" ) * fn LogicDouble( logicRow, @"UnitPrice" ) ) * *       // Customer: Balance <= CreditLimit *       local fn CustomerCreditCheck( logicRow as LogicRowRef ) as BOOL *       end fn = ( fn LogicDouble( logicRow, @"Balance" ) <= fn LogicDouble( logicRow, @"CreditLimit" ) ) * *       void local fn DeclareRules *       fn LogicFormula( @"OrderDetail", @"Amount", @fn OrderDetailAmount, @[ @"Quantity", @"UnitPrice" ] ) *       fn LogicConstraint( @"Customer", @fn CustomerCreditCheck, @"Balance {Balance} exceeds credit limit {CreditLimit}" ) *       end fn * *       // Customer.Balance = sum( Order.AmountTotal where ShippedDate is empty ) *       local fn OrderIsUnshipped( logicRow as LogicRowRef ) as BOOL *       end fn = fn LogicIsEmpty( logicRow, @"ShippedDate" ) *       ... *       fn LogicSum( @"Customer", @"Balance", @"OrderList", @"AmountTotal", @fn OrderIsUnshipped ) *       fn LogicCount( @"Customer", @"UnpaidOrderCount", @"OrderList", @fn OrderIsUnshipped ) * *       fn DeclareRules : fn LogicActivate         // in main, after DataOpen * *   Rule functions take the row being saved (LogicRowRef, read with LogicValue / *   LogicDouble / ... in Logic Row.incl) and are called by address.  A formula names *   the attributes it reads (dependsOn): formulas run in dependency order, and on an *   update a formula whose inputs did not change is skipped. * *   Clean-room: written from LogicBank's documented behaviour, not its code. */#define LogicRowRef as MutableDictionaryRefbegin globalsMutableDictionaryRef gLogicRules        // entity -> { formulas, constraints, declared (sums/counts on this parent), aggregates (filed under the child) }BOOL                 gLogicActive       // LogicActivate succeededend globals// the rule lists of one entity (created on first use)local fn LogicEntityRules( entityName as StringRef ) as MutableDictionaryRefMutableDictionaryRef rulesif ( gLogicRules == NULL ) then gLogicRules = fn MutableDictionaryNewrules = (MutableDictionaryRef)fn DictionaryObjectForKey( gLogicRules, entityName )if ( rules == NULL )rules = fn MutableDictionaryNewMutableDictionarySetObjectForKey( rules, fn MutableArrayNew, @"formulas" )MutableDictionarySetObjectForKey( rules, fn MutableArrayNew, @"constraints" )MutableDictionarySetObjectForKey( rules, fn MutableArrayNew, @"declared" )MutableDictionarySetObjectForKey( rules, fn MutableArrayNew, @"aggregates" )MutableDictionarySetObjectForKey( gLogicRules, rules, entityName )end ifend fn = rules/* *   attrName = formulaFn( logicRow )     formulaFn: local fn ( logicRow as LogicRowRef ) as CFTypeRef *   dependsOn: the attributes the formula reads - [ "Quantity", "UnitPrice" ] *   (an empty list: the formula runs on every insert and update) */void local fn LogicFormula( entityName as StringRef, attrName as StringRef, formulaFn as ptr, dependsOn as ArrayRef )MutableArrayRef formulas = (MutableArrayRef)fn DictionaryObjectForKey( fn LogicEntityRules( entityName ), @"formulas" )if ( dependsOn == NULL ) then dependsOn = @[]MutableArrayAddObject( formulas, @{ @"kind":@"formula", @"entity":entityName, @"attr":attrName, @"fn":fn ValueWithPointer( formulaFn ), @"dependsOn":dependsOn } )gLogicActive = NOend fn/* *   constraintFn( logicRow ) must be YES, else the save fails and rolls back. *   constraintFn: local fn ( logicRow as LogicRowRef ) as BOOL *   message: shown to the user; {Attr} (or {row.Attr}) is replaced by the row's value. */void local fn LogicConstraint( entityName as StringRef, constraintFn as ptr, message as StringRef )MutableArrayRef constraints = (MutableArrayRef)fn DictionaryObjectForKey( fn LogicEntityRules( entityName ), @"constraints" )if ( message == NULL ) then message = fn StringWithFormat( @"%@ constraint failed", entityName )MutableArrayAddObject( constraints, @{ @"kind":@"constraint", @"entity":entityName, @"fn":fn ValueWithPointer( constraintFn ), @"message":message } )end fn/* *   parentAttr = sum / count over the parent's child list (a tomany relationship of the *   model, e.g. "OrderList"), of the children for which whereFn is YES (NULL: all). *       whereFn: local fn ( logicRow as LogicRowRef ) as BOOL - sees the child row *   Maintained by adjustment: each child save adds its change to the parent; the sum is *   never re-queried.  The parent's own rules then run (chaining). */void local fn LogicAggregate( kind as StringRef, parentEntity as StringRef, parentAttr as StringRef, listName as StringRef, childAttr as StringRef, whereFn as ptr )MutableArrayRef declared = (MutableArrayRef)fn DictionaryObjectForKey( fn LogicEntityRules( parentEntity ), @"declared" )MutableDictionaryRef aggregate = fn MutableDictionaryNewMutableDictionarySetObjectForKey( aggregate, kind, @"kind" )MutableDictionarySetObjectForKey( aggregate, parentEntity, @"entity" )MutableDictionarySetObjectForKey( aggregate, parentAttr, @"attr" )MutableDictionarySetObjectForKey( aggregate, listName, @"list" )if ( childAttr != NULL ) then MutableDictionarySetObjectForKey( aggregate, childAttr, @"childAttr" )MutableDictionarySetObjectForKey( aggregate, fn ValueWithPointer( whereFn ), @"where" )MutableArrayAddObject( declared, aggregate )gLogicActive = NOend fnvoid local fn LogicSum( parentEntity as StringRef, parentAttr as StringRef, listName as StringRef, childAttr as StringRef, whereFn as ptr )fn LogicAggregate( @"sum", parentEntity, parentAttr, listName, childAttr, whereFn )end fnvoid local fn LogicCount( parentEntity as StringRef, parentAttr as StringRef, listName as StringRef, whereFn as ptr )fn LogicAggregate( @"count", parentEntity, parentAttr, listName, NULL, whereFn )end fnlocal fn LogicRulesOf( entityName as StringRef, kind as StringRef ) as ArrayRefDictionaryRef rulesif ( gLogicRules == NULL ) then exit fn = @[]rules = fn DictionaryObjectForKey( gLogicRules, entityName )if ( rules == NULL ) then exit fn = @[]end fn = fn DictionaryObjectForKey( rules, kind )// "Role.Attr": Role is a toone relationship of the entity, Attr a column of that parentlocal fn LogicCheckParentReference( entityName as StringRef, reference as StringRef ) as BOOLArrayRef      parts = fn StringComponentsSeparatedByString( reference, @"." )DictionaryRef relationshipif ( fn ArrayCount( parts ) != 2 ) then exit fn = NOrelationship = fn DataRelationship( entityName, fn ArrayObjectAtIndex( parts, 0 ) )if ( relationship == NULL )NSLog( @"Logic: %@ has no parent role %@ (in %@).", entityName, fn ArrayObjectAtIndex( parts, 0 ), reference )exit fn = NOend ifif ( fn StringIsEqual( fn DictionaryObjectForKey( relationship, @"direction" ), @"toone" ) == NO ) then exit fn = NOif ( fn ArrayContainsObject( fn DataColumns( fn DictionaryObjectForKey( relationship, @"resource" ) ), fn ArrayObjectAtIndex( parts, 1 ) ) == NO )NSLog( @"Logic: %@ is not an attribute of the parent (in %@.%@).", fn ArrayObjectAtIndex( parts, 1 ), entityName, reference )exit fn = NOend ifend fn = YES// a rule names entities and attributes that must be in the modellocal fn LogicCheckNames( rule as DictionaryRef ) as BOOLStringRef  entityName = fn DictionaryObjectForKey( rule, @"entity" )ArrayRef   columns = fn DataColumns( entityName )ArrayRef   dependsOnStringRef  attrNameif ( fn ArrayCount( columns ) == 0 )NSLog( @"Logic: rule on %@, which is not in the model.", entityName )exit fn = NOend ifattrName = fn DictionaryObjectForKey( rule, @"attr" )if ( attrName != NULL )if ( fn ArrayContainsObject( columns, attrName ) == NO )NSLog( @"Logic: formula derives %@.%@, which is not in the model.", entityName, attrName )exit fn = NOend ifend ifdependsOn = fn DictionaryObjectForKey( rule, @"dependsOn" )if ( dependsOn != NULL )for attrName in dependsOnif ( fn StringContainsString( attrName, @"." ) )if ( fn LogicCheckParentReference( entityName, attrName ) == NO ) then exit fn = NOelseif ( fn ArrayContainsObject( columns, attrName ) == NO )NSLog( @"Logic: formula %@.%@ depends on %@, which is not in the model.", entityName, fn DictionaryObjectForKey( rule, @"attr" ), attrName )exit fn = NOend ifend ifnextend ifend fn = YES/* *   Put one entity's formulas in dependency order: a formula runs after every formula *   that derives an attribute it reads.  NO (and a log naming them) on a cycle. */local fn LogicOrderFormulas( entityName as StringRef ) as BOOLMutableDictionaryRef rules = fn LogicEntityRules( entityName )ArrayRef             formulas = fn DictionaryObjectForKey( rules, @"formulas" )MutableArrayRef      ordered = fn MutableArrayNewMutableArrayRef      derived = fn MutableArrayNew     // attributes still waiting to be derivedMutableStringRef     cycleDictionaryRef        formulaArrayRef             dependenciesStringRef            attrName, dependencyBOOL                 progress, readyfor formula in formulasMutableArrayAddObject( derived, fn DictionaryObjectForKey( formula, @"attr" ) )nextprogress = YESwhile ( progress && fn ArrayCount( ordered ) < fn ArrayCount( formulas ) )progress = NOfor formula in formulasattrName = fn DictionaryObjectForKey( formula, @"attr" )if ( fn ArrayContainsObject( derived, attrName ) )ready = YESdependencies = fn DictionaryObjectForKey( formula, @"dependsOn" )for dependency in dependenciesif ( fn StringIsEqual( dependency, attrName ) == NO && fn ArrayContainsObject( derived, dependency ) ) then ready = NOnextif ( ready )MutableArrayAddObject( ordered, formula )MutableArrayRemoveObject( derived, attrName )progress = YESend ifend ifnextwendif ( fn ArrayCount( ordered ) < fn ArrayCount( formulas ) )cycle = fn MutableStringNewfor attrName in derivedif ( fn StringLength( cycle ) > 0 ) then MutableStringAppendString( cycle, @", " )MutableStringAppendString( cycle, attrName )nextNSLog( @"Logic: %@ formulas depend on each other in a cycle: %@", entityName, cycle )exit fn = NOend ifMutableDictionarySetObjectForKey( rules, ordered, @"formulas" )end fn = YES/* *   File a declared sum / count under its child entity: the child list (tomany on the *   parent) gives the child entity and the foreign key (fks -> parentKeys).  The child *   saves are what change the parent, so that is where the engine looks for them. */local fn LogicResolveAggregate( aggregate as DictionaryRef ) as BOOLStringRef            parentEntity = fn DictionaryObjectForKey( aggregate, @"entity" )DictionaryRef        relationship = fn DataRelationship( parentEntity, fn DictionaryObjectForKey( aggregate, @"list" ) )StringRef            childEntity, childAttrMutableDictionaryRef resolvedMutableArrayRef      aggregatesif ( relationship == NULL )NSLog( @"Logic: %@ has no child list %@.", parentEntity, fn DictionaryObjectForKey( aggregate, @"list" ) )exit fn = NOend ifif ( fn StringIsEqual( fn DictionaryObjectForKey( relationship, @"direction" ), @"tomany" ) == NO )NSLog( @"Logic: %@.%@ is not a child list.", parentEntity, fn DictionaryObjectForKey( aggregate, @"list" ) )exit fn = NOend ifchildEntity = fn DictionaryObjectForKey( relationship, @"resource" )if ( fn ArrayContainsObject( fn DataColumns( parentEntity ), fn DictionaryObjectForKey( aggregate, @"attr" ) ) == NO )NSLog( @"Logic: %@ derives %@.%@, which is not in the model.", fn DictionaryObjectForKey( aggregate, @"kind" ), parentEntity, fn DictionaryObjectForKey( aggregate, @"attr" ) )exit fn = NOend ifchildAttr = fn DictionaryObjectForKey( aggregate, @"childAttr" )if ( childAttr != NULL )if ( fn ArrayContainsObject( fn DataColumns( childEntity ), childAttr ) == NO )NSLog( @"Logic: sum of %@.%@, which is not in the model.", childEntity, childAttr )exit fn = NOend ifend ifresolved = fn MutableDictionaryWithDictionary( aggregate )MutableDictionarySetObjectForKey( resolved, childEntity, @"child" )MutableDictionarySetObjectForKey( resolved, fn DictionaryObjectForKey( relationship, @"fks" ), @"fks" )MutableDictionarySetObjectForKey( resolved, fn DictionaryObjectForKey( relationship, @"parentKeys" ), @"parentKeys" )aggregates = (MutableArrayRef)fn DictionaryObjectForKey( fn LogicEntityRules( childEntity ), @"aggregates" )MutableArrayAddObject( aggregates, resolved )end fn = YES// after all rules are declared: check names, file sums/counts, order formulas.  NO: the rules are not used.local fn LogicActivate as BOOLArrayRef      entityNames, rulesStringRef     entityNameDictionaryRef ruleBOOL          ok = YESgLogicActive = NOif ( gLogicRules == NULL ) then gLogicRules = fn MutableDictionaryNewentityNames = fn DictionaryAllKeys( gLogicRules )for entityName in entityNamesMutableArrayRemoveAllObjects( (MutableArrayRef)fn DictionaryObjectForKey( fn LogicEntityRules( entityName ), @"aggregates" ) )nextfor entityName in entityNamesrules = fn LogicRulesOf( entityName, @"declared" )for rule in rulesif ( fn LogicResolveAggregate( rule ) == NO ) then ok = NOnextnextentityNames = fn DictionaryAllKeys( gLogicRules )      // resolving may add child entitiesfor entityName in entityNamesrules = fn LogicRulesOf( entityName, @"formulas" )for rule in rulesif ( fn LogicCheckNames( rule ) == NO ) then ok = NOnextrules = fn LogicRulesOf( entityName, @"constraints" )for rule in rulesif ( fn LogicCheckNames( rule ) == NO ) then ok = NOnextif ( fn LogicOrderFormulas( entityName ) == NO ) then ok = NOnextif ( ok == NO )alert 1, NSAlertStyleCritical, @"The business rules could not be activated.", @"See the NSLog window for the rules and attributes involved.", @[@"OK"], NOexit fn = NOend ifgLogicActive = YESif (isLoggingOn) then NSLog( @"Logic: rules active for %ld entities", (long)fn ArrayCount( entityNames ) )end fn = YES