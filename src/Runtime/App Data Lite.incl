/* *   I M A G E R Y    B U S I N E S S     S Y S T E M S,   L L C * *   App Data Lite.incl - runtime: the app's data, Lite edition (SQLite in the app) * *   The pages (App Pages.incl) never talk to a database or a server themselves: they call *   these functions, the app's data interface, and get the answer in one handler: * *       fn AppDataSetHandler( @fn AppDataDone )        once, at start-up *       fn AppDataList( entity )                       -> AppDataDone( _appDataList, entity, records, NULL ) *       fn AppDataSave( entity, aRecord, keyValues )   -> AppDataDone( _appDataSave, entity, aRecord, message ) *       fn AppDataRemove( entity, keyValues )          -> AppDataDone( _appDataRemove, entity, NULL, message ) *       fn AppDataLogin( user, password )              -> AppDataDone( _appDataLogin, NULL, NULL, message ) *       fn AppDataKeyValues( entity, aRecord )         the record's key, for Save and Delete *       fn AppDataNeedsLogin                           does this edition sign in? * *   message is NULL when the operation worked, otherwise why it did not (for the user). * *   Lite edition: the app opens the project's SQLite database itself (Data Records.incl) and *   every save goes through LogicBank for FutureBasic (Logic Engine.incl), so the business *   rules run inside the app, in one transaction per save.  The handler is called at once. * *   The Enterprise edition (a paid build) has the same functions in App Data Enterprise.incl, *   over an API Logic Server: three tiers - this app, the server and its rules, the database. *   The pages, bindings and screens are the same in both editions. */#define APP_EDITION @"Lite"// operations, as the handler receives them_appDataList   = 1_appDataSave   = 2_appDataRemove = 3_appDataLogin  = 4begin globalsptr gAppDataHandler        // void local fn ( op as long, entity as StringRef, result as CFTypeRef, message as StringRef )end globalsvoid local fn AppDataSetHandler( handler as ptr )gAppDataHandler = handlerend fn// call the handler (a function address registered with @fn) through a C castvoid local fn AppDataCallHandler( handler as ptr, op as long, entity as StringRef, result as CFTypeRef, message as StringRef )cln ((void (*)(long, CFStringRef, CFTypeRef, CFStringRef))handler)( op, entity, result, message );end fnvoid local fn AppDataAnswer( op as long, entity as StringRef, result as CFTypeRef, message as StringRef )if ( gAppDataHandler != NULL ) then fn AppDataCallHandler( gAppDataHandler, op, entity, result, message )end fn// Lite apps have no sign-in: the database is on this Maclocal fn AppDataNeedsLogin as BOOLend fn = NOvoid local fn AppDataLogin( user as StringRef, password as StringRef )fn AppDataAnswer( _appDataLogin, NULL, NULL, NULL )end fn// every record of an entityvoid local fn AppDataList( entity as StringRef )MutableArrayRef records = fn DataFetch( entity, NULL, NULL )if ( records == NULL )fn AppDataAnswer( _appDataList, entity, @[], fn StringWithFormat( @"%@ could not be read from the database.", entity ) )exit fnend iffn AppDataAnswer( _appDataList, entity, records, NULL )end fn// the record's key (its primary-key attributes), for Save and Deletelocal fn AppDataKeyValues( entity as StringRef, aRecord as DictionaryRef ) as DictionaryRefend fn = fn DataKeyValues( entity, aRecord )// a new record (keyValues NULL) or a change to the record with that key - through the rulesvoid local fn AppDataSave( entity as StringRef, aRecord as MutableDictionaryRef, keyValues as DictionaryRef )BOOL savedif ( keyValues == NULL )saved = fn LogicInsert( entity, aRecord )elsesaved = fn LogicUpdate( entity, aRecord, keyValues )end ifif ( saved ) then fn AppDataAnswer( _appDataSave, entity, aRecord, NULL ) else fn AppDataAnswer( _appDataSave, entity, aRecord, fn LogicMessage )end fn// delete the record with that key - through the rules (prevent / cascade / nullify)void local fn AppDataRemove( entity as StringRef, keyValues as DictionaryRef )if ( fn LogicDelete( entity, keyValues ) ) then fn AppDataAnswer( _appDataRemove, entity, NULL, NULL ) else fn AppDataAnswer( _appDataRemove, entity, NULL, fn LogicMessage )end fn