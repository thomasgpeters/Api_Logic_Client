/* *   I M A G E R Y    B U S I N E S S     S Y S T E M S,   L L C * *   App Shell.incl - runtime: the common look and feel of every generated app * *       +--------------+------------------------------------------------------------+ *       |  Business    |  [logo]  App Name                      [Theme v] [Log In] | *       |  Objects     |          tag-line                                          | *       |              +------------------------------------------------------------+ *       |  [icon] Page |                                                            | *       |  [icon] Page |     content: the page's parts (nibview ... _shellContent)  | *       |  ...         |                                                            | *       |              +------------------------------------------------------------+ *       |              |  (c) copyright    status          [New][Save][Delete][Refresh] | *       +--------------+------------------------------------------------------------+ * *   The colours come from the theme globals below; the app's Theme.incl (a starting *   template, yours) sets them in ApplyTheme before ShellBuildWindow.  Pages are *   registered with ShellAddNavItem (App Pages.incl does it for every entity); *   ShellShowPage shows one page's views and hides the others.  The app's DoDialog *   passes events to ShellDoDialog first (navigation, theme menu); the Log In button *   (_shellLoginButton) and the page actions in the footer (New, Save, Delete, Refresh) *   are the app's: App Pages.incl handles them. */_shellWindow = 2// tags (62000-62999: clear of the model's tags and the ALS runtime's)_shellNavBox         = 62000_shellNavHeading     = 62001           // "Business Objects", above the entity buttons_shellNavHighlight   = 62003_shellHeaderBox      = 62010_shellLogo           = 62011_shellAppName        = 62012_shellTagline        = 62013_shellThemePopup     = 62014_shellLoginButton    = 62015_shellFooterBox      = 62020_shellCopyright      = 62021_shellStatus         = 62022           // what just happened: "Saved.", a refused save's reason_shellNewButton      = 62023           // the page actions - App Pages.incl handles them_shellSaveButton     = 62024_shellDeleteButton   = 62025_shellRefreshButton  = 62026_shellContent        = 62030_shellContentBackdrop = 62031          // the working area behind the cards_shellCardTagOffset  = 500000         // a part's card: its tag + this (ShellCard)_shellCardTitleOffset = 600000        // its title: the part's tag + this_shellNavButtonBase  = 62100           // + page index// layout_shellNavWidth       = 220_shellHeaderHeight   = 72_shellFooterHeight   = 44_shellNavItemHeight  = 34_shellNavItemGap     = 4_shellNavHeadingHeight = 28            // the heading's line, above the first button#define SHELL_NAV_HEADING @"Business Objects"_shellPadding        = 16_shellMargin         = 24             // around the cards, inside the working area_shellCardPadding    = 16             // inside a card, around its part_shellCardGap        = 16             // between two cards_shellCardRadius     = 10_shellCardTitleHeight = 30            // the card's title line, above its part// menus (Menus.incl builds them; App Pages.incl handles Records)_shellMenuFile    = 1_shellMenuEdit    = 2_shellMenuRecords = 3begin enum 1_shellItemNew_shellItemSave_shellItemDelete_shellItemSeparator_shellItemRefreshend enumbegin globalsColorRef        gThemeNavBackground    // the navigation bar (dark blue)ColorRef        gThemeNavText          // navigation buttons: text and icons (white)ColorRef        gThemeNavSelection     // behind the selected buttonColorRef        gThemeNavHeadingText   // the "Business Objects" heading (NULL: the buttons' colour)ColorRef        gThemeHeaderBackgroundColorRef        gThemeHeaderTextColorRef        gThemeTaglineTextColorRef        gThemeFooterBackgroundColorRef        gThemeFooterTextColorRef        gThemeContentBackground // the working area, behind the cardsColorRef        gThemeCardBackground   // a card: the panel a Form or a List sits onColorRef        gThemeCardBorderCFMutableArrayRef gShellColorPairs     // ShellDynamicColor's light / dark pairsColorRef        gThemeCardTitleText    // a card's titleCGFloat         gThemeCardTitleFontSizeCFMutableArrayRef gShellTitledParts    // the parts whose card has a title (ShellPlacePart leaves room)CGFloat         gThemeNavFontSizeBOOL            gThemePillButtons      // the header's and footer's buttons as pills (Pill Buttons.incl)CFStringRef     gShellAppSymbol        // the app icon's SF Symbol when there is no AppLogo picture (ShellSetAppSymbol)CFMutableArrayRef gShellPages            // [ { title, views: [ view tags ] } ], in navigation orderlong            gShellCurrentPageptr             gShellPageShownFn      // void local fn ( pageIndex as long ): set by App Pages.inclend globals// a view by its tag, in any of the app's windows - also a control inside a XIB part (a nibview). FB's ViewWithTag looks// only in its current output window, which is not always the app's window when an event arrives ("View does not// exist", 2026-11-27: a lookup's info button, tag 40100).// the C functions FB calls, declared for every part of the project (FB compiles in several chunks)BeginCDeclarationvoid *ShellFindView( long tag );EndCBeginCFunctionvoid *ShellFindView( long tag ) {    for ( NSWindow *window in [NSApp windows] ) {        NSView *found = [window.contentView viewWithTag:tag];        if ( found != nil ) return (__bridge void *)found;    }    return NULL;}EndCtoolbox fn ShellFindView( long tag ) = ptr// the look before the app's ApplyTheme changes it// a colour for light mode and one for dark mode: macOS picks the right one as the appearance changeslocal fn ShellColorProvider( name as CFStringRef, appearance as AppearanceRef, userData as ptr ) as ColorReflong       index = (long)userDataCFArrayRef pair = fn ArrayObjectAtIndex( gShellColorPairs, index )CFStringRef best = fn AppearanceBestMatchFromAppearancesWithNames( appearance, @[ @"NSAppearanceNameAqua", @"NSAppearanceNameDarkAqua" ] )if ( best == NULL ) then best = @"NSAppearanceNameAqua"if ( fn StringIsEqual( best, @"NSAppearanceNameDarkAqua" ) ) then exit fn = fn ArrayObjectAtIndex( pair, 1 )end fn = fn ArrayObjectAtIndex( pair, 0 )local fn ShellDynamicColor( lightColor as ColorRef, darkColor as ColorRef ) as ColorReflong indexif ( gShellColorPairs == NULL ) then gShellColorPairs = (CFMutableArrayRef)fn DataKept( fn MutableArrayNew, gShellColorPairs )   // read whenever the appearance changesindex = fn ArrayCount( gShellColorPairs )MutableArrayAddObject( gShellColorPairs, @[ lightColor, darkColor ] )end fn = fn ColorWithName( @"ShellColor", @fn ShellColorProvider, (ptr)index )void local fn ShellDefaultThemegThemeNavBackground    = fn ShellDynamicColor( fn ColorWithSRGB( 0.067, 0.157, 0.329, 1.0 ), fn ColorWithSRGB( 0.027, 0.063, 0.141, 1.0 ) )   // dark blue; darker in dark mode (kept by ShellKeepTheme)gThemeNavText          = fn ColorWhite   // kept by ShellKeepThemegThemeNavSelection     = fn ColorWithSRGB( 1.0, 1.0, 1.0, 0.16 )   // kept by ShellKeepThemegThemeNavHeadingText   = fn ColorWithSRGB( 1.0, 1.0, 1.0, 0.6 )     // white, dimmed (kept by ShellKeepTheme)gThemeHeaderBackground = fn ColorControlBackground                      // follows light / dark (kept by ShellKeepTheme)gThemeHeaderText       = fn ColorLabel   // kept by ShellKeepThemegThemeTaglineText      = fn ColorSecondaryLabel   // kept by ShellKeepThemegThemeFooterBackground = fn ColorWindowBackground   // kept by ShellKeepThemegThemeFooterText       = fn ColorSecondaryLabel   // kept by ShellKeepTheme// the working area is a shade apart from the cards on it, in both modesgThemeContentBackground = fn ShellDynamicColor( fn ColorWithSRGB( 0.918, 0.925, 0.937, 1.0 ), fn ColorWithSRGB( 0.090, 0.094, 0.102, 1.0 ) )   // kept by ShellKeepThemegThemeCardBackground    = fn ShellDynamicColor( fn ColorWhite, fn ColorWithSRGB( 0.169, 0.173, 0.184, 1.0 ) )   // kept by ShellKeepThemegThemeCardBorder        = fn ShellDynamicColor( fn ColorWithSRGB( 0.0, 0.0, 0.0, 0.10 ), fn ColorWithSRGB( 1.0, 1.0, 1.0, 0.10 ) )   // kept by ShellKeepThemegThemeCardTitleText     = fn ColorLabel                               // the card's title: the system font (San Francisco), semibold (kept by ShellKeepTheme)gThemeCardTitleFontSize = 15.0gThemeNavFontSize      = 13.0gThemePillButtons      = YES                                         // Mac-style pill buttonsend fn// a box filled with one colour, no bordervoid local fn ShellPanel( tag as long, r as CGRect, fillColor as ColorRef, mask as long )box tag, @"", r, NSBoxCustom, _shellWindowBoxSetFillColor( tag, fillColor )BoxSetBorderWidth( tag, 0.0 )ViewSetAutoresizingMask( tag, mask )end fn// the app's logo: AppLogo.png in the bundle (Project Settings in the Studio), else a symbol// the app icon: the picture chosen in the Studio (AppLogo.png), else its SF Symbollocal fn ShellLogoImage as ImageRefImageRef    logo = fn ImageNamed( @"AppLogo" )CFStringRef symbolName = gShellAppSymbolif ( logo != NULL ) then exit fn = logoif ( symbolName == NULL ) then symbolName = @"building.2"logo = fn ImageWithSystemSymbolName( symbolName, @"App icon" )if ( logo == NULL ) then logo = fn ImageWithSystemSymbolName( @"building.2", @"App icon" )// drawn at the header's size (a symbol's own size is a text line's, about 17 points)if ( logo != NULL ) then logo = fn ImageWithSymbolConfiguration( logo, fn ImageSymbolConfigurationWithPointSize( 34.0, NSFontWeightRegular ) )end fn = logo// the app icon's SF Symbol (App Pages.incl, from the Studio's Project Settings): shown in the// header when the app has no icon picture (AppLogo.png)void local fn ShellSetAppSymbol( symbolName as CFStringRef )gShellAppSymbol = fn DataKept( symbolName, gShellAppSymbol )if ( fn ImageNamed( @"AppLogo" ) == NULL ) then ImageViewSetImage( _shellLogo, fn ShellLogoImage )end fn// a page action in the footer, kept at the right edge when the window growsvoid local fn ShellFooterButton( tag as long, title as CFStringRef, x as CGFloat )button tag, YES, , title, fn CGRectMake( x, 7, 88, 30 ), NSButtonTypeMomentaryPushIn, NSBezelStyleRounded, _shellWindowViewSetAutoresizingMask( tag, NSViewMinXMargin + NSViewMaxYMargin )if ( gThemePillButtons == NO ) then exit fnselect ( tag )case _shellSaveButton   : fn PillButton( tag, _pillDefault )case _shellDeleteButton : fn PillButton( tag, _pillDestructive )case else               : fn PillButton( tag, _pillPlain )end selectend fn// the theme's colours, kept for the app's life: a global does not keep its value alive (FB), and the// colours are read again after launch (the selected page, a card, the appearance changing). ApplyTheme// (Theme.incl) sets them in the same event as ShellBuildWindow, so they are still alive here.void local fn ShellKeepColour( colour as ColorRef )if ( colour != NULL ) then fn CFRetain( colour )   // NULL: the default (gThemeNavHeadingText: the buttons' colour)end fnvoid local fn ShellKeepThemeif ( gThemeContentBackground == NULL ) then gThemeContentBackground = fn ColorUnderPageBackground   // kept by ShellKeepThemeif ( gThemeCardBackground == NULL ) then gThemeCardBackground = fn ColorControlBackground   // kept by ShellKeepThemeif ( gThemeCardBorder == NULL ) then gThemeCardBorder = fn ColorSeparator   // kept by ShellKeepThemeif ( gThemeCardTitleText == NULL ) then gThemeCardTitleText = fn ColorLabel   // kept by ShellKeepThemefn ShellKeepColour( gThemeNavBackground )fn ShellKeepColour( gThemeNavText )fn ShellKeepColour( gThemeNavSelection )fn ShellKeepColour( gThemeNavHeadingText )fn ShellKeepColour( gThemeHeaderBackground )fn ShellKeepColour( gThemeHeaderText )fn ShellKeepColour( gThemeTaglineText )fn ShellKeepColour( gThemeFooterBackground )fn ShellKeepColour( gThemeFooterText )fn ShellKeepColour( gThemeContentBackground )fn ShellKeepColour( gThemeCardBackground )fn ShellKeepColour( gThemeCardBorder )fn ShellKeepColour( gThemeCardTitleText )end fnvoid local fn ShellBuildWindow( appName as CFStringRef, tagline as CFStringRef, copyright as CFStringRef )CGRect rCGFloat w = 1180, h = 760CGFloat nameYif ( gThemeNavBackground == NULL ) then fn ShellDefaultThemefn ShellKeepThemegShellPages = (CFMutableArrayRef)fn DataKept( fn MutableArrayNew, gShellPages )gShellCurrentPage = -1r = fn CGRectMake( 0, 0, w, h )window _shellWindow, appName, r, NSWindowStyleMaskTitled + NSWindowStyleMaskClosable + NSWindowStyleMaskMiniaturizable + NSWindowStyleMaskResizableWindowSetContentMinSize( _shellWindow, fn CGSizeMake( 900, 560 ) )WindowCenter( _shellWindow )ViewSetAutoresizesSubviews( _windowContentViewTag, YES )// navigation bar: the full height on the left; its buttons run down from the top.  They are// placed in the window, measured from the bar's top edge, with a fixed top margin// (NSViewMinYMargin: the bottom margin stretches), so they stay at the top as the window resizes.fn ShellPanel( _shellNavBox, fn CGRectMake( 0, 0, _shellNavWidth, h ), gThemeNavBackground, NSViewHeightSizable + NSViewMaxXMargin )box _shellNavHighlight, @"", fn CGRectMake( 10, 0, _shellNavWidth - 20, _shellNavItemHeight ), NSBoxCustom, _shellWindowBoxSetFillColor( _shellNavHighlight, gThemeNavSelection )BoxSetBorderWidth( _shellNavHighlight, 0.0 )BoxSetCornerRadius( _shellNavHighlight, 6.0 )ViewSetHidden( _shellNavHighlight, YES )ViewSetAutoresizingMask( _shellNavHighlight, NSViewMinYMargin + NSViewMaxXMargin )// the heading over the entity buttonstextlabel _shellNavHeading, SHELL_NAV_HEADING, fn CGRectMake( 20, h - _shellPadding - 18, _shellNavWidth - 40, 16 ), _shellWindowControlSetFont( _shellNavHeading, fn FontBoldSystemFontOfSize( 11.0 ) )if ( gThemeNavHeadingText != NULL ) then TextFieldSetTextColor( _shellNavHeading, gThemeNavHeadingText ) else TextFieldSetTextColor( _shellNavHeading, gThemeNavText )ViewSetAutoresizingMask( _shellNavHeading, NSViewMinYMargin + NSViewMaxXMargin )// header: logo, app name and tag-line on the left; theme menu and Log In on the rightfn ShellPanel( _shellHeaderBox, fn CGRectMake( _shellNavWidth, h - _shellHeaderHeight, w - _shellNavWidth, _shellHeaderHeight ), gThemeHeaderBackground, NSViewWidthSizable + NSViewMinYMargin )// the app icon, 52 points, centred in the header's height (its middle is h - 36)imageview _shellLogo, YES, fn ShellLogoImage, fn CGRectMake( _shellNavWidth + _shellPadding, h - 62, 52, 52 ), NSImageScaleProportionallyUpOrDown, , , _shellWindowViewSetAutoresizingMask( _shellLogo, NSViewMaxXMargin + NSViewMinYMargin )// the app name, large, centred up and down on the icon (the icon's middle is h - 36); the tag-line, smaller, under itnameY = h - 51textlabel _shellAppName, appName, fn CGRectMake( _shellNavWidth + _shellPadding + 64, nameY, 600, 30 ), _shellWindowControlSetFont( _shellAppName, fn FontBoldSystemFontOfSize( 24.0 ) )TextFieldSetTextColor( _shellAppName, gThemeHeaderText )ViewSetAutoresizingMask( _shellAppName, NSViewMaxXMargin + NSViewMinYMargin )textlabel _shellTagline, tagline, fn CGRectMake( _shellNavWidth + _shellPadding + 66, h - 67, 600, 16 ), _shellWindowControlSetFont( _shellTagline, fn FontSystemFontOfSize( 11.0 ) )TextFieldSetTextColor( _shellTagline, gThemeTaglineText )ViewSetAutoresizingMask( _shellTagline, NSViewMaxXMargin + NSViewMinYMargin )// the Dock and the About box show the app icon too, when it is a pictureif ( fn ImageNamed( @"AppLogo" ) != NULL ) then AppSetIconImage( fn ImageNamed( @"AppLogo" ) )button _shellLoginButton, YES, , @"Log In", fn CGRectMake( w - _shellPadding - 96, h - 50, 96, 30 ), NSButtonTypeMomentaryPushIn, NSBezelStyleRounded, _shellWindowViewSetAutoresizingMask( _shellLoginButton, NSViewMinXMargin + NSViewMinYMargin )if ( gThemePillButtons ) then fn PillButton( _shellLoginButton, _pillPlain )popupbutton _shellThemePopup, YES, 0, @[ @"System Theme", @"Light", @"Dark" ], fn CGRectMake( w - _shellPadding - 96 - 12 - 140, h - 50, 140, 30 ), NO, _shellWindowViewSetAutoresizingMask( _shellThemePopup, NSViewMinXMargin + NSViewMinYMargin )// footer: copyright on the left, then the status line; the page actions on the rightfn ShellPanel( _shellFooterBox, fn CGRectMake( _shellNavWidth, 0, w - _shellNavWidth, _shellFooterHeight ), gThemeFooterBackground, NSViewWidthSizable + NSViewMaxYMargin )textlabel _shellCopyright, copyright, fn CGRectMake( _shellNavWidth + _shellPadding, 14, 260, 16 ), _shellWindowTextFieldSetTextColor( _shellCopyright, gThemeFooterText )ViewSetAutoresizingMask( _shellCopyright, NSViewMaxXMargin + NSViewMaxYMargin )textlabel _shellStatus, @"", fn CGRectMake( _shellNavWidth + _shellPadding + 272, 14, w - _shellNavWidth - _shellPadding * 2 - 272 - 4 * 92, 16 ), _shellWindowTextFieldSetTextColor( _shellStatus, gThemeHeaderText )ViewSetAutoresizingMask( _shellStatus, NSViewWidthSizable + NSViewMaxYMargin )fn ShellFooterButton( _shellRefreshButton, @"Refresh", w - _shellPadding - 88 )fn ShellFooterButton( _shellDeleteButton, @"Delete", w - _shellPadding - 88 * 2 - 4 )fn ShellFooterButton( _shellSaveButton, @"Save", w - _shellPadding - 88 * 3 - 8 )fn ShellFooterButton( _shellNewButton, @"New", w - _shellPadding - 88 * 4 - 12 )// content: the pages' parts go in here (nibview ..., _shellContent)// the working area: a shade apart from the cards that sit on itfn ShellPanel( _shellContentBackdrop, fn CGRectMake( _shellNavWidth, _shellFooterHeight, w - _shellNavWidth, h - _shellHeaderHeight - _shellFooterHeight ), gThemeContentBackground, NSViewWidthSizable + NSViewHeightSizable )view _shellContent, fn CGRectMake( _shellNavWidth + _shellMargin, _shellFooterHeight + _shellMargin, w - _shellNavWidth - _shellMargin * 2, h - _shellHeaderHeight - _shellFooterHeight - _shellMargin * 2 ), _shellWindowViewSetAutoresizingMask( _shellContent, NSViewWidthSizable + NSViewHeightSizable )ViewSetAutoresizesSubviews( _shellContent, YES )end fn// the content area's size, for placing a page's parts (origin 0,0 at its bottom left)local fn ShellContentBounds as CGRectend fn = fn ViewBounds( _shellContent )// a card for a part: a rounded panel in the content area, behind the part (call it before the part's// nibview, so the part lands on top), with a title at its top in the system font (San Francisco, sans-serif),// a little larger than the fields'; "" for none. The card's tag is the part's + _shellCardTagOffset, its title's// + _shellCardTitleOffset; list the card with the page's views (ShellAddNavItem) - the title shows and hides with it.void local fn ShellCard( partTag as long, r as CGRect, mask as long, titleText as CFStringRef )long cardTag = partTag + _shellCardTagOffset, titleTag = partTag + _shellCardTitleOffsetif ( gThemeCardTitleFontSize <= 0 ) then gThemeCardTitleFontSize = 15.0if ( gShellTitledParts == NULL ) then gShellTitledParts = (CFMutableArrayRef)fn DataKept( fn MutableArrayNew, gShellTitledParts )box cardTag, @"", r, NSBoxCustom, _shellWindowBoxSetFillColor( cardTag, gThemeCardBackground )BoxSetBorderColor( cardTag, gThemeCardBorder )BoxSetBorderWidth( cardTag, 1.0 )BoxSetCornerRadius( cardTag, _shellCardRadius )ViewAddSubview( _shellContent, cardTag )ViewSetFrame( cardTag, r )ViewSetAutoresizingMask( cardTag, mask )if ( titleText == NULL ) then exit fnif ( fn StringLength( titleText ) == 0 ) then exit fntextlabel titleTag, titleText, fn CGRectMake( r.origin.x + _shellCardPadding, r.origin.y + r.size.height - _shellCardPadding - _shellCardTitleHeight + 6, r.size.width - _shellCardPadding * 2, _shellCardTitleHeight - 6 ), _shellWindowControlSetFont( titleTag, fn FontSystemFontOfSizeAndWeight( gThemeCardTitleFontSize, NSFontWeightSemibold ) )TextFieldSetTextColor( titleTag, gThemeCardTitleText )ViewAddSubview( _shellContent, titleTag )ViewSetFrame( titleTag, fn CGRectMake( r.origin.x + _shellCardPadding, r.origin.y + r.size.height - _shellCardPadding - _shellCardTitleHeight + 6, r.size.width - _shellCardPadding * 2, _shellCardTitleHeight - 6 ) )// it stays at the card's top and stretches with its widthViewSetAutoresizingMask( titleTag, NSViewWidthSizable + NSViewMinYMargin )if ( ( mask and NSViewHeightSizable ) == 0 ) then ViewSetAutoresizingMask( titleTag, NSViewWidthSizable + NSViewMaxYMargin )MutableArrayAddObject( gShellTitledParts, fn NumberWithLong( partTag ) )end fn// a card's title, shown or hidden with its card (only parts given a title have one)void local fn ShellSetTitleHidden( partTag as long, hidden as BOOL )if ( gShellTitledParts == NULL ) then exit fnif ( fn ArrayContainsObject( gShellTitledParts, fn NumberWithLong( partTag ) ) ) then ViewSetHidden( partTag + _shellCardTitleOffset, hidden )end fn// a part (a Form or a List, after its nibview) fills its card, inside the card's padding and below its title;// it stretches with the window as the mask says - its controls stretch with it (the XIBs' autoresizing masks)void local fn ShellPlacePart( partTag as long, r as CGRect, mask as long )CGFloat titleRoom = 0if ( gShellTitledParts != NULL )if ( fn ArrayContainsObject( gShellTitledParts, fn NumberWithLong( partTag ) ) ) then titleRoom = _shellCardTitleHeightend ifViewSetFrame( partTag, fn CGRectMake( r.origin.x + _shellCardPadding, r.origin.y + _shellCardPadding, r.size.width - _shellCardPadding * 2, r.size.height - _shellCardPadding * 2 - titleRoom ) )ViewSetAutoresizingMask( partTag, mask )end fn// the bottom edge of navigation item index (0 is the top one), in window coordinates: the bar's// height now, less the padding and the items above it (Cocoa's y grows upward)local fn ShellNavItemY( index as long ) as CGFloatCGRect bar = fn ViewFrame( _shellNavBox )end fn = bar.size.height - _shellPadding - _shellNavHeadingHeight - ( index + 1 ) * ( _shellNavItemHeight + _shellNavItemGap ) + _shellNavItemGap/* *   A navigation button for a page: title, an SF Symbol name (e.g. @"person.2") and the *   tags of the views that make up the page.  Returns the page's index. */local fn ShellAddNavItem( title as CFStringRef, symbolName as CFStringRef, viewTags as CFArrayRef ) as longlong   index = fn ArrayCount( gShellPages )long   buttonTag = _shellNavButtonBase + indexCGFloat y = fn ShellNavItemY( index )CFNumberRef viewTagbutton buttonTag, YES, , fn StringWithFormat( @"  %@", title ), fn CGRectMake( 10, y, _shellNavWidth - 20, _shellNavItemHeight ), NSButtonTypeMomentaryPushIn, NSBezelStyleRegularSquare, _shellWindowButtonSetBordered( buttonTag, NO )ButtonSetImage( buttonTag, fn ImageWithSystemSymbolName( symbolName, title ) )ButtonSetImagePosition( buttonTag, NSImageLeft )ControlSetAlignment( buttonTag, NSTextAlignmentLeft )ControlSetFont( buttonTag, fn FontBoldSystemFontOfSize( gThemeNavFontSize ) )ButtonSetContentTintColor( buttonTag, gThemeNavText )ViewSetToolTip( buttonTag, title )ViewSetAutoresizingMask( buttonTag, NSViewMinYMargin + NSViewMaxXMargin )   // a fixed distance from the topfor viewTag in viewTagsViewSetHidden( fn NumberIntegerValue( viewTag ), YES )if ( fn NumberIntegerValue( viewTag ) > _shellCardTagOffset && fn NumberIntegerValue( viewTag ) < _shellCardTitleOffset ) then fn ShellSetTitleHidden( fn NumberIntegerValue( viewTag ) - _shellCardTagOffset, YES )nextMutableArrayAddObject( gShellPages, @{ @"title":title, @"views":viewTags } )end fn = indexvoid local fn ShellSetPageShownHandler( handler as ptr )gShellPageShownFn = handlerend fnvoid local fn ShellCallPageShown( handler as ptr, index as long )cln ((void (*)(long))handler)( index );end fn// show one page's views, hide the others, mark its button; then tell the app (its data)void local fn ShellShowPage( index as long )CFDictionaryRef pageCFArrayRef      viewTagsCFNumberRef     viewTaglong          iptr           handler = gShellPageShownFnif ( index < 0 || index >= fn ArrayCount( gShellPages ) ) then exit fnfor i = 0 to (long)fn ArrayCount( gShellPages ) - 1page = fn ArrayObjectAtIndex( gShellPages, i )viewTags = fn DictionaryObjectForKey( page, @"views" )for viewTag in viewTagsViewSetHidden( fn NumberIntegerValue( viewTag ), ( i != index ) )// a card's title goes with its card (ShellCard)if ( fn NumberIntegerValue( viewTag ) > _shellCardTagOffset && fn NumberIntegerValue( viewTag ) < _shellCardTitleOffset ) then fn ShellSetTitleHidden( fn NumberIntegerValue( viewTag ) - _shellCardTagOffset, ( i != index ) )nextnextViewSetFrame( _shellNavHighlight, fn CGRectMake( 10, fn ShellNavItemY( index ), _shellNavWidth - 20, _shellNavItemHeight ) )ViewSetHidden( _shellNavHighlight, NO )gShellCurrentPage = indexif ( handler != NULL ) then fn ShellCallPageShown( handler, index )end fn// the footer's status line: what just happenedvoid local fn ShellSetStatus( message as CFStringRef )if ( message == NULL ) then message = @""ControlSetStringValue( _shellStatus, message )end fn// the Log In button: shown only when the app's data needs a sign-in (Professional)void local fn ShellShowLogin( flag as BOOL )ViewSetHidden( _shellLoginButton, ( flag == NO ) )end fn// application events: quit when the window closesvoid local fn ShellDoAppEvent( ev as long )select ( ev )case _appShouldTerminateAfterLastWindowClosed : AppEventSetBool( YES )end selectend fn// System / Light / Darkvoid local fn ShellApplyThemeChoice( choice as long )select ( choice )case 1 : AppSetAppearanceNamed( @"NSAppearanceNameAqua" )case 2 : AppSetAppearanceNamed( @"NSAppearanceNameDarkAqua" )case else : AppSetAppearance( NULL )end selectend fn// navigation and the theme menu; YES when the event was the shell'slocal fn ShellDoDialog( ev as long, tag as long, wnd as long ) as BOOLif ( ev != _btnClick ) then exit fn = NOif ( tag >= _shellNavButtonBase && tag < _shellNavButtonBase + fn ArrayCount( gShellPages ) )fn ShellShowPage( tag - _shellNavButtonBase )exit fn = YESend ifif ( tag == _shellThemePopup )fn ShellApplyThemeChoice( fn PopUpButtonIndexOfSelectedItem( _shellThemePopup ) )exit fn = YESend ifend fn = NO