rayCount( gShellPages )long   buttonTag = _shellNavButtonBase + indexCGFloat y = fn ShellNavItemY( index )CFNumberRef viewTagbutton buttonTag, YES, , fn StringWithFormat( @"  %@", title ), fn CGRectMake( 10, y, _shellNavWidth - 20, _shellNavItemHeight ), NSButtonTypeMomentaryPushIn, NSBezelStyleRegularSquare, _shellWindowButtonSetBordered( buttonTag, NO )ButtonSetImage( buttonTag, fn ImageWithSystemSymbolName( symbolName, title ) )ButtonSetImagePosition( buttonTag, NSImageLeft )ControlSetAlignment( buttonTag, NSTextAlignmentLeft )ControlSetFont( buttonTag, fn FontBoldSystemFontOfSize( gThemeNavFontSize ) )ButtonSetContentTintColor( buttonTag, gThemeNavText )ViewSetToolTip( buttonTag, title )ViewSetAutoresizingMask( buttonTag, NSViewMinYMargin + NSViewMaxXMargin )   // a fixed distance from the topfor viewTag in viewTagsViewSetHidden( fn NumberIntegerValue( viewTag ), YES )if ( fn NumberIntegerValue( viewTag ) > _shellCardTagOffset && fn NumberIntegerValue( viewTag ) < _shellCardTitleOffset ) then fn ShellSetTitleHidden( fn NumberIntegerValue( viewTag ) - _shellCardTagOffset, YES )nextMutableArrayAddObject( gShellPages, @{ @"title":title, @"views":viewTags } )end fn = indexvoid local fn ShellSetPageShownHandler( handler as ptr )gShellPageShownFn = handlerend fnvoid local fn ShellCallPageShown( handler as ptr, index as long )cln ((void (*)(long))handler)( index );end fn// a navigation button scrolled into view (the list scrolls when the model has many entities)void local fn ShellNavShowButton( buttonTag as long )ViewRef v = fn ShellFindView( buttonTag )if ( v == NULL ) then exit fncln [(__bridge NSView *)v scrollRectToVisible:NSInsetRect( ((__bridge NSView *)v).bounds, 0, -6 )];end fn// the entity buttons into a scrolling list, from the heading to the bar's foot, once they are all addedvoid local fn ShellNavScrollCGRect bar = fn ViewFrame( _shellNavBox )if ( gShellNavScrolls || fn ArrayCount( gShellPages ) == 0 ) then exit fnShellNavScrollViews( _shellNavButtonBase, fn ArrayCount( gShellPages ), _shellNavHighlight, _shellNavItemHeight, _shellNavItemGap, _shellNavWidth, bar.size.height - _shellPadding - _shellNavHeadingHeight, _shellPadding )gShellNavScrolls = YESend fn// show one page's views, hide the others, mark its button; then tell the app (its data)void local fn ShellShowPage( index as long )CFDictionaryRef pageCFArrayRef      viewTagsCFNumberRef     viewTaglong          iptr           handler = gShellPageShownFnif ( index < 0 || index >= fn ArrayCount( gShellPages ) ) then exit fnfn ShellNavScroll                                  // the first time: every button is added by nowfor i = 0 to (long)fn ArrayCount( gShellPages ) - 1page = fn ArrayObjectAtIndex( gShellPages, i )viewTags = fn DictionaryObjectForKey( page, @"views" )for viewTag in viewTagsViewSetHidden( fn NumberIntegerValue( viewTag ), ( i != index ) )// a card's title goes with its card (ShellCard)if ( fn NumberIntegerValue( viewTag ) > _shellCardTagOffset && fn NumberIntegerValue( viewTag ) < _shellCardTitleOffset ) then fn ShellSetTitleHidden( fn NumberIntegerValue( viewTag ) - _shellCardTagOffset, ( i != index ) )nextnextViewSetFrame( _shellNavHighlight, fn CGRectMake( 10, fn ShellNavItemY( index ), _shellNavWidth - 20, _shellNavItemHeight ) )ViewSetHidden( _shellNavHighlight, NO )fn ShellNavShowButton( _shellNavButtonBase + index )   // scrolled into viewfor i = 0 to (long)fn ArrayCount( gShellPages ) - 1ShellSetViewHidden( _shellSplitterBase + i, ( i != index ) )      // each page's splitter with its pagenextgShellCurrentPage = indexif ( handler != NULL ) then fn ShellCallPageShown( handler, index )end fn// what just happened ("Saved.", a refused save's reason, "5 of 91 match"): under the window's title, in the title bar// (the window's subtitle, beside the toolbar), so the footer is the record navigator'svoid local fn ShellSetStatus( message as CFStringRef )ViewRef contentView = fn ShellFindView( _shellContent )if ( message == NULL ) then message = @""if ( contentView == NULL ) then exit fncln NSWindow *shellWin = ((__bridge NSView *)contentView).window; if ( shellWin != nil ) shellWin.subtitle = (__bridge NSString *)message;end fn// a control on or off, through Cocoa (FB's tag functions look only in the current output window)void local fn ShellSetEnabled( tag as long, enabled as BOOL )ViewRef v = fn ShellFindView( tag )if ( v == NULL ) then exit fncln if ( [(__bridge id)v isKindOfClass:[NSControl class]] ) { ((__bridge NSControl *)v).enabled = enabled; ((__bridge NSView *)v).alphaValue = enabled ? 1.0 : 0.4; }   // a pill drawn by its layer (macOS 15) does not grey itselfend fn// the record navigator (author, 2026-11-27): "Customer 3 of 91" and the buttons that apply - First and Previous// dimmed on the first record, Next and Last on the last.  row -1: no record chosen (a new one).void local fn ShellSetNavigator( row as long, recordCount as long )CFStringRef pageTitle = @"Record", navTextViewRef     labelView = fn ShellFindView( _shellRecordLabel )if ( gShellCurrentPage >= 0 && gShellCurrentPage < fn ArrayCount( gShellPages ) ) then pageTitle = fn DictionaryObjectForKey( fn ArrayObjectAtIndex( gShellPages, gShellCurrentPage ), @"title" )if ( recordCount <= 0 )navText = fn StringWithFormat( @"No %@ records", pageTitle )elseif ( row < 0 ) then navText = fn StringWithFormat( @"%@: %ld records", pageTitle, recordCount ) else navText = fn StringWithFormat( @"%@ %ld of %ld", pageTitle, row + 1, recordCount )end ifif ( labelView != NULL )cln ((__bridge NSTextField *)labelView).stringValue = (__bridge NSString *)navText;end iffn ShellSetEnabled( _shellFirstButton, ( recordCount > 0 && row != 0 ) )fn ShellSetEnabled( _shellPreviousButton, ( row > 0 ) )fn ShellSetEnabled( _shellNextButton, ( row >= 0 && row < recordCount - 1 ) )fn ShellSetEnabled( _shellLastButton, ( recordCount > 0 && row != recordCount - 1 ) )end fn// a List's look, as the Studio's tables (author, 2026-11-27): plain rows with a super-light line between them (no// alternating shades: they make stripes), the column headings a little larger and semibold in a slightly taller row;// the Studio's tables (App Pages.incl calls it for each List when the pages are built)void local fn ShellListHeadings( tableTag as long )ViewRef v = fn ShellFindView( tableTag )if ( v == NULL ) then exit fncln if ( [(__bridge id)v isKindOfClass:[NSTableView class]] ) { NSTableView *t = (__bridge NSTableView *)v; NSFont *f = [NSFont systemFontOfSize:13.0 weight:NSFontWeightSemibold]; t.usesAlternatingRowBackgroundColors = NO; t.gridStyleMask = NSTableViewSolidHorizontalGridLineMask; t.gridColor = [NSColor.labelColor colorWithAlphaComponent:0.06]; for ( NSTableColumn *c in t.tableColumns ) c.headerCell.font = f; if ( t.headerView ) { NSRect r = t.headerView.frame; r.size.height = 28; t.headerView.frame = r; [t.enclosingScrollView tile]; [t.headerView setNeedsDisplay:YES]; } }end fn// a List's row chosen in Cocoa: selected, scrolled to, and the list given the focus (the arrow keys then move it)void local fn ShellSelectRow( tableTag as long, row as long )ViewRef v = fn ShellFindView( tableTag )if ( v == NULL || row < 0 ) then exit fncln if ( [(__bridge id)v isKindOfClass:[NSTableView class]] ) { NSTableView *t = (__bridge NSTableView *)v; if ( row < t.numberOfRows ) { [t selectRowIndexes:[NSIndexSet indexSetWithIndex:(NSUInteger)row] byExtendingSelection:NO]; [t scrollRowToVisible:row]; if ( !t.isHiddenOrHasHiddenAncestor ) [t.window makeFirstResponder:t]; } }end fn// the Log In button: shown only when the app's data needs a sign-in (Professional)void local fn ShellShowLogin( flag as BOOL )ViewSetHidden( _shellLoginButton, ( flag == NO ) )end fn// application events: quit when the window closesvoid local fn ShellDoAppEvent( ev as long )select ( ev )case _appShouldTerminateAfterLastWindowClosed : AppEventSetBool( YES )end selectend fn// navigation; YES when the event was the shell's (the theme menu answers itself: App Toolbar.incl, AppToolbarThemeWire)local fn ShellDoDialog( ev as long, tag as long, wnd as long ) as BOOLif ( ev != _btnClick ) then exit fn = NOif ( tag >= _shellNavButtonBase && tag < _shellNavButtonBase + fn ArrayCount( gShellPages ) )fn ShellShowPage( tag - _shellNavButtonBase )exit fn = YESend ifend fn = NO