_shellNavWidth ) / 2 - ( 4 * 32 + 2 * 6 + 2 * 10 + 200 ) / 2   // four icons, the gaps, the labelfn ShellNavigatorButton( _shellFirstButton, @"First record", @"backward.end.circle.fill", navX )fn ShellNavigatorButton( _shellPreviousButton, @"Previous record", @"chevron.backward.circle.fill", navX + 38 )textlabel _shellRecordLabel, @"", fn CGRectMake( navX + 38 + 32 + 10, _shellCopyrightHeight + 14, 200, 16 ), _shellWindowControlSetAlignment( _shellRecordLabel, NSTextAlignmentCenter )TextFieldSetTextColor( _shellRecordLabel, gThemeHeaderText )ViewSetAutoresizingMask( _shellRecordLabel, NSViewMinXMargin + NSViewMaxXMargin + NSViewMaxYMargin )fn ShellNavigatorButton( _shellNextButton, @"Next record", @"chevron.forward.circle.fill", navX + 38 + 32 + 10 + 200 + 10 )fn ShellNavigatorButton( _shellLastButton, @"Last record", @"forward.end.circle.fill", navX + 38 + 32 + 10 + 200 + 10 + 38 )// content: the pages' parts go in here (nibview ..., _shellContent)// the working area: a shade apart from the cards that sit on itfn ShellPanel( _shellContentBackdrop, fn CGRectMake( _shellNavWidth, _shellFooterHeight, w - _shellNavWidth, h - _shellHeaderHeight - _shellFooterHeight ), gThemeContentBackground, NSViewWidthSizable + NSViewHeightSizable )view _shellContent, fn CGRectMake( _shellNavWidth + _shellMargin, _shellFooterHeight + _shellMargin, w - _shellNavWidth - _shellMargin * 2, h - _shellHeaderHeight - _shellFooterHeight - _shellMargin - _shellMarginTop ), _shellWindowViewSetAutoresizingMask( _shellContent, NSViewWidthSizable + NSViewHeightSizable )ViewSetAutoresizesSubviews( _shellContent, YES )end fn// the content area's size, for placing a page's parts (origin 0,0 at its bottom left)local fn ShellContentBounds as CGRectend fn = fn ViewBounds( _shellContent )// a card for a part: a rounded panel in the content area, behind the part (call it before the part's// nibview, so the part lands on top), with a title at its top in the system font (San Francisco, sans-serif),// a little larger than the fields'; "" for none. The card's tag is the part's + _shellCardTagOffset, its title's// + _shellCardTitleOffset; list the card with the page's views (ShellAddNavItem) - the title shows and hides with it.void local fn ShellCard( partTag as long, r as CGRect, mask as long, titleText as CFStringRef )long cardTag = partTag + _shellCardTagOffset, titleTag = partTag + _shellCardTitleOffsetif ( gThemeCardTitleFontSize <= 0 ) then gThemeCardTitleFontSize = 15.0if ( gShellTitledParts == NULL ) then gShellTitledParts = (CFMutableArrayRef)fn DataKept( fn MutableArrayNew, gShellTitledParts )box cardTag, @"", r, NSBoxCustom, _shellWindowBoxSetFillColor( cardTag, gThemeCardBackground )BoxSetBorderColor( cardTag, gThemeCardBorder )BoxSetBorderWidth( cardTag, 1.0 )BoxSetCornerRadius( cardTag, _shellCardRadius )ViewAddSubview( _shellContent, cardTag )ViewSetFrame( cardTag, r )ViewSetAutoresizingMask( cardTag, mask )if ( titleText == NULL ) then exit fnif ( fn StringLength( titleText ) == 0 ) then exit fntextlabel titleTag, titleText, fn CGRectMake( r.origin.x + _shellCardPadding, r.origin.y + r.size.height - _shellCardPadding - _shellCardTitleHeight + 6, r.size.width - _shellCardPadding * 2, _shellCardTitleHeight - 6 ), _shellWindowControlSetFont( titleTag, fn FontSystemFontOfSizeAndWeight( gThemeCardTitleFontSize, NSFontWeightSemibold ) )TextFieldSetTextColor( titleTag, gThemeCardTitleText )ViewAddSubview( _shellContent, titleTag )ViewSetFrame( titleTag, fn CGRectMake( r.origin.x + _shellCardPadding, r.origin.y + r.size.height - _shellCardPadding - _shellCardTitleHeight + 6, r.size.width - _shellCardPadding * 2, _shellCardTitleHeight - 6 ) )// it stays at the card's top and stretches with its widthViewSetAutoresizingMask( titleTag, NSViewWidthSizable + NSViewMinYMargin )if ( ( mask and NSViewHeightSizable ) == 0 ) then ViewSetAutoresizingMask( titleTag, NSViewWidthSizable + NSViewMaxYMargin )MutableArrayAddObject(