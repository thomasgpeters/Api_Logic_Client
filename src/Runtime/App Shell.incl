/* *   I M A G E R Y    B U S I N E S S     S Y S T E M S,   L L C * *   App Shell.incl - runtime: the common look and feel of every generated app * *       +--------------+------------------------------------------------------------+ *       |  Business    |  [icon] App Name / tag-line                       [Log In] | *       |              +------------------------------------------------------------+ *       |  [icon] Page |                                                            | *       |  [icon] Page |     content: the page's parts (nibview ... _shellContent)  | *       |  ...         |                                                            | *       |              +------------------------------------------------------------+ *       |              |                  |< <  Customer 3 of 91  > >|              | *       |              |-------------- (c) copyright, centred --------------------- | *       +--------------+------------------------------------------------------------+ *   (the window's toolbar, above: Search | New, Save, Delete, Refresh ... Theme - App Toolbar.incl; what just happened, *   "Saved.", under the window's title: ShellSetStatus) * *   The colours come from the theme globals below; the app's Theme.incl (a starting *   template, yours) sets them in ApplyTheme before ShellBuildWindow.  Pages are *   registered with ShellAddNavItem (App Pages.incl does it for every entity); *   ShellShowPage shows one page's views and hides the others.  The app's DoDialog *   passes events to ShellDoDialog first (navigation; the theme menu answers itself, App Toolbar.incl); the Log In button *   (_shellLoginButton) and the record navigator's buttons (ShellSetNavigator says which apply) are the app's: *   App Pages.incl handles them. */_shellWindow = 2// tags (62000-62999: clear of the model's tags and the ALS runtime's)_shellNavBox         = 62000_shellNavHeading     = 62001           // "Business Objects", above the entity buttons_shellNavHighlight   = 62003_shellHeaderBox      = 62010_shellLogo           = 62011_shellAppName        = 62012_shellTagline        = 62013_shellThemePopup     = 62014_shellLoginButton    = 62015_shellFooterBox      = 62020_shellCopyright      = 62021           // centred in the footer's bottom strip_shellCopyrightLine  = 62027           // the line above that strip_shellStatus         = 62022           // (no longer a view: what just happened shows under the window's title, ShellSetStatus)_shellNewButton      = 62023           // the page actions - App Pages.incl handles them_shellSaveButton     = 62024_shellDeleteButton   = 62025_shellRefreshButton  = 62026_shellContent        = 62030_shellFirstButton    = 62040           // the record navigator, at the footer's left - App Pages.incl handles its buttons_shellPreviousButton = 62041_shellNextButton     = 62042_shellLastButton     = 62043_shellRecordLabel    = 62044           // "Customer 3 of 91"_shellContentBackdrop = 62031          // the working area behind the cards_shellCardTagOffset  = 500000         // a part's card: its tag + this (ShellCard)_shellCardTitleOffset = 600000        // its title: the part's tag + this_shellNavButtonBase  = 62100           // + page index_shellSplitterBase   = 64000           // + page index: the divider between a page's List and its Form (ShellSplitter)// layout_shellNavWidth       = 220_shellHeaderHeight   = 56             // the app's icon, name and tag-line (the theme menu is in the toolbar)_shellFooterHeight   = 66              // the navigator's row and, under it, the copyright's strip_shellCopyrightHeight = 22_shellNavItemHeight  = 34_shellNavItemGap     = 4_shellNavHeadingHeight = 28            // the heading's line, above the first button#define SHELL_NAV_HEADING @"Business Objects"_shellPadding        = 16_shellMargin         = 16             // around the cards, inside the working area (left, right, bottom)_shellMarginTop      = 8              // above the first card, under the header (author, 2026-11-28: "only 5 or 10 px")_shellCardPadding    = 12             // inside a card, around its part_shellCardGap        = 12             // between two cards_shellCardRadius     = 10_shellCardTitleHeight = 26            // the card's title line, above its part// menus (Menus.incl builds them; App Pages.incl handles Records)_shellMenuFile    = 1_shellMenuEdit    = 2_shellMenuRecords = 3begin enum 1_shellItemNew_shellItemSave_shellItemDelete_shellItemSeparator_shellItemRefreshend enumbegin globalsColorRef        gThemeNavBackground    // the navigation bar (dark blue)ColorRef        gThemeNavText          // navigation buttons: text and icons (white)ColorRef        gThemeNavSelection     // behind the selected buttonColorRef        gThemeNavHeadingText   // the "Business Objects" heading (NULL: the buttons' colour)ColorRef        gThemeHeaderBackgroundColorRef        gThemeHeaderTextColorRef        gThemeTaglineTextColorRef        gThemeFooterBackgroundColorRef        gThemeFooterTextColorRef        gThemeContentBackground // the working area, behind the cardsColorRef        gThemeCardBackground   // a card: the panel a Form or a List sits onColorRef        gThemeCardBorderCFMutableArrayRef gShellColorPairs     // ShellDynamicColor's light / dark pairsColorRef        gThemeCardTitleText    // a card's titleCGFloat         gThemeCardTitleFontSizeCFMutableArrayRef gShellTitledParts    // the parts whose card has a title (ShellPlacePart leaves room)CGFloat         gThemeNavFontSizeBOOL            gThemePillButtons      // the header's and footer's buttons as pills (Pill Buttons.incl)BOOL            gShellNavScrolls       // the entity buttons are in their scrolling list (ShellNavScroll)CFStringRef     gShellAppSymbol        // the app icon's SF Symbol when there is no AppLogo picture (ShellSetAppSymbol)CFMutableArrayRef gShellPages            // [ { title, views: [ view tags ] } ], in navigation orderlong            gShellCurrentPageptr             gShellPageShownFn      // void local fn ( pageIndex as long ): set by App Pages.inclend globals// a view by its tag, in any of the app's windows - also a control inside a XIB part (a nibview), or in the toolbar. FB's ViewWithTag looks// only in its current output window, which is not always the app's window when an event arrives ("View does not// exist", 2026-11-27: a lookup's info button, tag 40100).// the C functions FB calls, declared for every part of the project (FB compiles in several chunks)BeginCDeclarationvoid *ShellFindView( long tag );EndCBeginCFunctionvoid *ShellFindView( long tag ) {    for ( NSWindow *window in [NSApp windows] ) {        NSView *found = [window.contentView viewWithTag:tag];        if ( found != nil ) return (__bridge void *)found;        for ( NSToolbarItem *item in window.toolbar.items ) {      // a view in the toolbar (the theme menu)            found = [item.view viewWithTag:tag];            if ( found != nil ) return (__bridge void *)found;        }    }    return NULL;}EndCtoolbox fn ShellFindView( long tag ) = ptr// the divider between a page's List card and its Form card (author, 2026-11-27: "a splitter in between the list and// the scalar view"): a handle in the gap between the cards; dragging it moves the line between them - the List card// (with its List and its tiles) gives up or takes height, the Form card takes or gives it. The cursor shows it can be// dragged; a short grip line marks it. Neither card goes below its minimum.BeginCDeclarationvoid ShellSplitterMake( long handleTag, long listTag, long formTag, long tilesTag, long cardOffset, long titleOffset, double gap, CFStringRef defaultsKey );void ShellSetViewHidden( long tag, long hidden );EndCBeginCFunction@interface ABSplitHandle : NSView@property (assign) NSInteger handleTag;@property (assign) NSView *listCard, *listPart, *tiles, *formCard, *formPart, *formTitle;@property (assign) CGFloat lastY;@property (strong) NSString *defaultsKey;     // where its place is kept in the app's preferences ("Splitter <page>")@end@implementation ABSplitHandle- (NSInteger)tag { return self.handleTag; }- (void)resetCursorRects { [self addCursorRect:self.bounds cursor:NSCursor.resizeUpDownCursor]; }- (void)drawRect:(NSRect)dirty {    NSRect grip = NSMakeRect( NSMidX( self.bounds ) - 18, NSMidY( self.bounds ) - 2, 36, 4 );    [[NSColor.secondaryLabelColor colorWithAlphaComponent:0.35] setFill];    [[NSBezierPath bezierPathWithRoundedRect:grip xRadius:2 yRadius:2] fill];}- (void)mouseDown:(NSEvent *)event { self.lastY = [self.superview convertPoint:event.locationInWindow fromView:nil].y; }// the line moved by d points (up: the Form grows), within the minimums; returns the distance it moved- (CGFloat)moveBy:(CGFloat)d {    NSRect r;    NSMutableArray *above = [NSMutableArray array], *below = [NSMutableArray array];   // an array literal with a nil in it stops the app    if ( self.listCard == nil || self.formCard == nil || d == 0 ) return 0;    if ( self.listCard.frame.size.height - d < 140 ) d = self.listCard.frame.size.height - 140;    if ( self.formCard.frame.size.height + d < 90 ) d = 90 - self.formCard.frame.size.height;    if ( d == 0 ) return 0;    if ( self.listCard ) [above addObject:self.listCard];    if ( self.listPart ) [above addObject:self.listPart];    if ( self.tiles ) [above addObject:self.tiles];    if ( self.formCard ) [below addObject:self.formCard];    if ( self.formPart ) [below addObject:self.formPart];    for ( NSView *v in above ) { r = v.frame; r.origin.y += d; r.size.height -= d; v.frame = r; }    for ( NSView *v in below ) { r = v.frame; r.size.height += d; v.frame = r; }    if ( self.formTitle != nil ) { r = self.formTitle.frame; r.origin.y += d; self.formTitle.frame = r; }    r = self.frame; r.origin.y += d; self.frame = r;    return d;}- (void)mouseDragged:(NSEvent *)event {    CGFloat y = [self.superview convertPoint:event.locationInWindow fromView:nil].y;    self.lastY += [self moveBy:y - self.lastY];}// let go: the Form card's height kept for the next launch (author, 2026-11-27: "remember the splitter position per page")- (void)mouseUp:(NSEvent *)event {    if ( self.defaultsKey.length > 0 && self.formCard != nil ) [[NSUserDefaults standardUserDefaults] setDouble:self.formCard.frame.size.height forKey:self.defaultsKey];}@endvoid ShellSplitterMake( long handleTag, long listTag, long formTag, long tilesTag, long cardOffset, long titleOffset, double gap, CFStringRef defaultsKey ) {    NSView *formCard = (__bridge NSView *)ShellFindView( formTag + cardOffset );    NSView *listCard = (__bridge NSView *)ShellFindView( listTag + cardOffset );    ABSplitHandle *handle;    if ( formCard == nil || listCard == nil || formCard.superview == nil ) return;    handle = [[ABSplitHandle alloc] initWithFrame:NSMakeRect( formCard.frame.origin.x, NSMaxY( formCard.frame ), formCard.frame.size.width, gap )];    handle.handleTag = handleTag;    handle.listCard = listCard;    handle.listPart = (__bridge NSView *)ShellFindView( listTag );    handle.tiles = tilesTag ? (__bridge NSView *)ShellFindView( tilesTag ) : nil;    handle.formCard = formCard;    handle.formPart = (__bridge NSView *)ShellFindView( formTag );    handle.formTitle = (__bridge NSView *)ShellFindView( formTag + titleOffset );    handle.autoresizingMask = NSViewWidthSizable | NSViewMaxYMargin;      // it keeps its place above the Form card    handle.toolTip = @"Drag to share the height between the list and the details";    handle.defaultsKey = defaultsKey ? [(__bridge NSString *)defaultsKey copy] : nil;    [formCard.superview addSubview:handle];    if ( handle.defaultsKey.length > 0 ) {                                   // where it was left last time        double kept = [[NSUserDefaults standardUserDefaults] doubleForKey:handle.defaultsKey];        if ( kept > 0 ) [handle moveBy:kept - formCard.frame.size.height];    }}// a view shown or hidden, through Cocoa (the splitters are not FB's views)void ShellSetViewHidden( long tag, long hidden ) {    NSView *v = (__bridge NSView *)ShellFindView( tag );    if ( v != nil ) v.hidden = hidden ? YES : NO;}EndCtoolbox ShellSplitterMake( long handleTag, long listTag, long formTag, long tilesTag, long cardOffset, long titleOffset, double gap, CFStringRef defaultsKey )toolbox ShellSetViewHidden( long tag, long hidden )// a page's splitter, between its List card (above) and its Form card (below); tilesTag: the List's tiles area, or 0.// Its place is kept per page in the app's preferences ("Splitter <page title>") and comes back at the next launch.void local fn ShellSplitter( pageIndex as long, listTag as long, formTag as long, tilesTag as long )CFStringRef splitterKey = @""if ( pageIndex >= 0 && pageIndex < fn ArrayCount( gShellPages ) ) then splitterKey = fn StringWithFormat( @"Splitter %@", fn DictionaryObjectForKey( fn ArrayObjectAtIndex( gShellPages, pageIndex ), @"title" ) )ShellSplitterMake( _shellSplitterBase + pageIndex, listTag, formTag, tilesTag, _shellCardTagOffset, _shellCardTitleOffset, _shellCardGap, splitterKey )ShellSetViewHidden( _shellSplitterBase + pageIndex, YES )             // shown with its page (ShellShowPage)end fn// the navigation bar's entity buttons in a scrolling list (author, 2026-11-27: a model with twenty tables or more):// a flipped document view, so the first button stays at the top; the scroller shows only while scrollingBeginCDeclarationvoid ShellNavScrollViews( long firstTag, long count, long highlightTag, double itemHeight, double gap, double width, double top, double bottom );EndCBeginCFunction@interface ABFlippedView : NSView@end@implementation ABFlippedView- (BOOL)isFlipped { return YES; }@endvoid ShellNavScrollViews( long firstTag, long count, long highlightTag, double itemHeight, double gap, double width, double top, double bottom ) {    NSView *first = (__bridge NSView *)ShellFindView( firstTag );    NSView *bar, *highlight = (__bridge NSView *)ShellFindView( highlightTag );    NSScrollView *scroller;    ABFlippedView *list;    long i;    if ( first == nil ) return;    bar = first.superview;    scroller = [[NSScrollView alloc] initWithFrame:NSMakeRect( 0, bottom, width, top - bottom )];    scroller.autoresizingMask = NSViewHeightSizable | NSViewMaxXMargin;    scroller.drawsBackground = NO;    scroller.contentView.drawsBackground = NO;    scroller.borderType = NSNoBorder;    scroller.hasVerticalScroller = YES;    scroller.autohidesScrollers = YES;    scroller.scrollerStyle = NSScrollerStyleOverlay;    list = [[ABFlippedView alloc] initWithFrame:NSMakeRect( 0, 0, width, count * ( itemHeight + gap ) + gap )];    list.autoresizingMask = NSViewWidthSizable;    scroller.documentView = list;    [bar addSubview:scroller];    if ( highlight != nil ) {        [highlight removeFromSuperview];        highlight.autoresizingMask = NSViewNotSizable;        [list addSubview:highlight];    }    for ( i = 0; i < count; i++ ) {        NSView *button = (__bridge NSView *)ShellFindView( firstTag + i );        if ( button == nil ) continue;        [button removeFromSuperview];        button.autoresizingMask = NSViewNotSizable;        button.frame = NSMakeRect( 10, gap + i * ( itemHeight + gap ), width - 20, itemHeight );        [list addSubview:button];    }}EndCtoolbox ShellNavScrollViews( long firstTag, long count, long highlightTag, double itemHeight, double gap, double width, double top, double bottom )// the look before the app's ApplyTheme changes it// a colour for light mode and one for dark mode: macOS picks the right one as the appearance changeslocal fn ShellColorProvider( name as CFStringRef, appearance as AppearanceRef, userData as ptr ) as ColorReflong       index = (long)userDataCFArrayRef pair = fn ArrayObjectAtIndex( gShellColorPairs, index )CFStringRef best = fn AppearanceBestMatchFromAppearancesWithNames( appearance, @[ @"NSAppearanceNameAqua", @"NSAppearanceNameDarkAqua" ] )if ( best == NULL ) then best = @"NSAppearanceNameAqua"if ( fn StringIsEqual( best, @"NSAppearanceNameDarkAqua" ) ) then exit fn = fn ArrayObjectAtIndex( pair, 1 )end fn = fn ArrayObjectAtIndex( pair, 0 )local fn ShellDynamicColor( lightColor as ColorRef, darkColor as ColorRef ) as ColorReflong indexif ( gShellColorPairs == NULL ) then gShellColorPairs = (CFMutableArrayRef)fn DataKept( fn MutableArrayNew, gShellColorPairs )   // read whenever the appearance changesindex = fn ArrayCount( gShellColorPairs )MutableArrayAddObject( gShellColorPairs, @[ lightColor, darkColor ] )end fn = fn ColorWithName( @"ShellColor", @fn ShellColorProvider, (ptr)index )void local fn ShellDefaultThemegThemeNavBackground    = fn ShellDynamicColor( fn ColorWithSRGB( 0.067, 0.157, 0.329, 1.0 ), fn ColorWithSRGB( 0.027, 0.063, 0.141, 1.0 ) )   // dark blue; darker in dark mode (kept by ShellKeepTheme)gThemeNavText          = fn ColorWhite   // kept by ShellKeepThemegThemeNavSelection     = fn ColorWithSRGB( 1.0, 1.0, 1.0, 0.16 )   // kept by ShellKeepThemegThemeNavHeadingText   = fn ColorWithSRGB( 1.0, 1.0, 1.0, 0.6 )     // white, dimmed (kept by ShellKeepTheme)gThemeHeaderBackground = fn ColorControlBackground                      // follows light / dark (kept by ShellKeepTheme)gThemeHeaderText       = fn ColorLabel   // kept by ShellKeepThemegThemeTaglineText      = fn ColorSecondaryLabel   // kept by ShellKeepThemegThemeFooterBackground = fn ColorWindowBackground   // kept by ShellKeepThemegThemeFooterText       = fn ColorSecondaryLabel   // kept by ShellKeepTheme// the working area is a shade apart from the cards on it, in both modesgThemeContentBackground = fn ShellDynamicColor( fn ColorWithSRGB( 0.918, 0.925, 0.937, 1.0 ), fn ColorWithSRGB( 0.090, 0.094, 0.102, 1.0 ) )   // kept by ShellKeepThemegThemeCardBackground    = fn ShellDynamicColor( fn ColorWhite, fn ColorWithSRGB( 0.169, 0.173, 0.184, 1.0 ) )   // kept by ShellKeepThemegThemeCardBorder        = fn ShellDynamicColor( fn ColorWithSRGB( 0.0, 0.0, 0.0, 0.10 ), fn ColorWithSRGB( 1.0, 1.0, 1.0, 0.10 ) )   // kept by ShellKeepThemegThemeCardTitleText     = fn ColorLabel                               // the card's title: the system font (San Francisco), semibold (kept by ShellKeepTheme)gThemeCardTitleFontSize = 15.0gThemeNavFontSize      = 13.0gThemePillButtons      = YES                                         // Mac-style pill buttonsend fn// a box filled with one colour, no bordervoid local fn ShellPanel( tag as long, r as CGRect, fillColor as ColorRef, mask as long )box tag, @"", r, NSBoxCustom, _shellWindowBoxSetFillColor( tag, fillColor )BoxSetBorderWidth( tag, 0.0 )ViewSetAutoresizingMask( tag, mask )end fn// the app's logo: AppLogo.png in the bundle (Project Settings in the Studio), else a symbol// the app icon: the picture chosen in the Studio (AppLogo.png), else its SF Symbollocal fn ShellLogoImage as ImageRefImageRef    logo = fn ImageNamed( @"AppLogo" )CFStringRef symbolName = gShellAppSymbolif ( logo != NULL ) then exit fn = logoif ( symbolName == NULL ) then symbolName = @"building.2"logo = fn ImageWithSystemSymbolName( symbolName, @"App icon" )if ( logo == NULL ) then logo = fn ImageWithSystemSymbolName( @"building.2", @"App icon" )// drawn at the header's size (a symbol's own size is a text line's, about 17 points)if ( logo != NULL ) then logo = fn ImageWithSymbolConfiguration( logo, fn ImageSymbolConfigurationWithPointSize( 34.0, NSFontWeightRegular ) )end fn = logo// the app icon's SF Symbol (App Pages.incl, from the Studio's Project Settings): shown in the// header when the app has no icon picture (AppLogo.png)void local fn ShellSetAppSymbol( symbolName as CFStringRef )gShellAppSymbol = fn DataKept( symbolName, gShellAppSymbol )if ( fn ImageNamed( @"AppLogo" ) == NULL ) then ImageViewSetImage( _shellLogo, fn ShellLogoImage )end fn// a record navigator button: an icon, no words (author, 2026-11-28) - an SF Symbol in a filled circle, semibold, in the// accent colour, centred in a borderless button; dimmed (and faded, ShellSetEnabled) when it does not applyvoid local fn ShellNavigatorButton( tag as long, tip as CFStringRef, symbolName as CFStringRef, x as CGFloat )ViewRef vbutton tag, NO, , @"", fn CGRectMake( x, _shellCopyrightHeight + 6, 32, 32 ), NSButtonTypeMomentaryPushIn, NSBezelStyleRegularSquare, _shellWindowButtonSetBordered( tag, NO )ButtonSetImagePosition( tag, NSImageOnly )ViewSetToolTip( tag, tip )ViewSetAutoresizingMask( tag, NSViewMinXMargin + NSViewMaxXMargin + NSViewMaxYMargin )   // the group stays centredv = fn ShellFindView( tag )if ( v == NULL ) then exit fncln { NSButton *b = (__bridge NSButton *)v; NSImageSymbolConfiguration *cfg = [NSImageSymbolConfiguration configurationWithPointSize:22 weight:NSFontWeightSemibold]; b.image = [[NSImage imageWithSystemSymbolName:(__bridge NSString *)symbolName accessibilityDescription:(__bridge NSString *)tip] imageWithSymbolConfiguration:cfg]; b.imageScaling = NSImageScaleNone; b.contentTintColor = NSColor.controlAccentColor; }end fn// the theme's colours, kept for the app's life: a global does not keep its value alive (FB), and the// colours are read again after launch (the selected page, a card, the appearance changing). ApplyTheme// (Theme.incl) sets them in the same event as ShellBuildWindow, so they are still alive here.void local fn ShellKeepColour( colour as ColorRef )if ( colour != NULL ) then fn CFRetain( colour )   // NULL: the default (gThemeNavHeadingText: the buttons' colour)end fnvoid local fn ShellKeepThemeif ( gThemeContentBackground == NULL ) then gThemeContentBackground = fn ColorUnderPageBackground   // kept by ShellKeepThemeif ( gThemeCardBackground == NULL ) then gThemeCardBackground = fn ColorControlBackground   // kept by ShellKeepThemeif ( gThemeCardBorder == NULL ) then gThemeCardBorder = fn ColorSeparator   // kept by ShellKeepThemeif ( gThemeCardTitleText == NULL ) then gThemeCardTitleText = fn ColorLabel   // kept by ShellKeepThemefn ShellKeepColour( gThemeNavBackground )fn ShellKeepColour( gThemeNavText )fn ShellKeepColour( gThemeNavSelection )fn ShellKeepColour( gThemeNavHeadingText )fn ShellKeepColour( gThemeHeaderBackground )fn ShellKeepColour( gThemeHeaderText )fn ShellKeepColour( gThemeTaglineText )fn ShellKeepColour( gThemeFooterBackground )fn ShellKeepColour( gThemeFooterText )fn ShellKeepColour( gThemeContentBackground )fn ShellKeepColour( gThemeCardBackground )fn ShellKeepColour( gThemeCardBorder )fn ShellKeepColour( gThemeCardTitleText )end fn// the company in the copyright: "© 2026 Imagery Business Systems, LLC" -> "Imagery Business Systems, LLC"; "" when the// copyright names none (empty, only a year)local fn ShellCompanyName( copyright as CFStringRef ) as CFStringRefCFStringRef companyif ( fn StringLength( copyright ) == 0 ) then exit fn = @""company = fn StringByReplacingOccurrencesOfStringWithOptions( copyright, @"(?i)^\\s*(©|\\(c\\)|copyright)?\\s*([0-9]{4}(\\s*[-–]\\s*[0-9]{4})?)?[\\s,.]*", @"", NSRegularExpressionSearch, fn CFRangeMake( 0, fn StringLength( copyright ) ) )end fn = fn StringByTrimmingCharactersInSet( company, fn CharacterSetWhitespaceSet )// the window's title: "Company | App" (author, 2026-11-27), the company taken from the copyright (Project Settings);// just the app's name when the copyright names no other companylocal fn ShellWindowTitle( appName as CFStringRef, copyright as CFStringRef ) as CFStringRefCFStringRef company = fn ShellCompanyName( copyright )if ( fn StringLength( company ) == 0 || fn StringIsEqual( company, appName ) ) then exit fn = appNameend fn = fn StringWithFormat( @"%@ | %@", company, appName )// the window can go full screen, its own space, width and height (author, 2026-11-27)void local fn ShellAllowFullScreenViewRef v = fn ShellFindView( _shellHeaderBox )if ( v == NULL ) then exit fncln NSWindow *shellWin = ((__bridge NSView *)v).window; if ( shellWin != nil ) shellWin.collectionBehavior = shellWin.collectionBehavior | NSWindowCollectionBehaviorFullScreenPrimary;end fnvoid local fn ShellBuildWindow( appName as CFStringRef, tagline as CFStringRef, copyright as CFStringRef )CGRect rCGFloat w = 1180, h = 760CGFloat nameY, navXif ( gThemeNavBackground == NULL ) then fn ShellDefaultThemefn ShellKeepThemegShellPages = (CFMutableArrayRef)fn DataKept( fn MutableArrayNew, gShellPages )gShellCurrentPage = -1r = fn CGRectMake( 0, 0, w, h )window _shellWindow, fn ShellWindowTitle( appName, copyright ), r, NSWindowStyleMaskTitled + NSWindowStyleMaskClosable + NSWindowStyleMaskMiniaturizable + NSWindowStyleMaskResizableWindowSetContentMinSize( _shellWindow, fn CGSizeMake( 900, 560 ) )WindowCenter( _shellWindow )ViewSetAutoresizesSubviews( _windowContentViewTag, YES )// navigation bar: the full height on the left; its buttons run down from the top.  They are// placed in the window, measured from the bar's top edge, with a fixed top margin// (NSViewMinYMargin: the bottom margin stretches), so they stay at the top as the window resizes.fn ShellPanel( _shellNavBox, fn CGRectMake( 0, 0, _shellNavWidth, h ), gThemeNavBackground, NSViewHeightSizable + NSViewMaxXMargin )box _shellNavHighlight, @"", fn CGRectMake( 10, 0, _shellNavWidth - 20, _shellNavItemHeight ), NSBoxCustom, _shellWindowBoxSetFillColor( _shellNavHighlight, gThemeNavSelection )BoxSetBorderWidth( _shellNavHighlight, 0.0 )BoxSetCornerRadius( _shellNavHighlight, 6.0 )ViewSetHidden( _shellNavHighlight, YES )ViewSetAutoresizingMask( _shellNavHighlight, NSViewMinYMargin + NSViewMaxXMargin )// the heading over the entity buttonstextlabel _shellNavHeading, SHELL_NAV_HEADING, fn CGRectMake( 20, h - _shellPadding - 18, _shellNavWidth - 40, 16 ), _shellWindowControlSetFont( _shellNavHeading, fn FontBoldSystemFontOfSize( 11.0 ) )if ( gThemeNavHeadingText != NULL ) then TextFieldSetTextColor( _shellNavHeading, gThemeNavHeadingText ) else TextFieldSetTextColor( _shellNavHeading, gThemeNavText )ViewSetAutoresizingMask( _shellNavHeading, NSViewMinYMargin + NSViewMaxXMargin )// header: the app's icon, name and tag-line on the left; Log In on the right (Professional). The theme menu is made here// and goes into the window's toolbar (App Toolbar.incl), which gives the header back its room (author, 2026-11-27).fn ShellPanel( _shellHeaderBox, fn CGRectMake( _shellNavWidth, h - _shellHeaderHeight, w - _shellNavWidth, _shellHeaderHeight ), gThemeHeaderBackground, NSViewWidthSizable + NSViewMinYMargin )// the app icon, 40 points, centred in the header's height (its middle is h - 28)imageview _shellLogo, YES, fn ShellLogoImage, fn CGRectMake( _shellNavWidth + _shellPadding, h - 48, 40, 40 ), NSImageScaleProportionallyUpOrDown, , , _shellWindowViewSetAutoresizingMask( _shellLogo, NSViewMaxXMargin + NSViewMinYMargin )// the app name centred up and down on the icon; with a tag-line, the two together arenameY = h - 41if ( fn StringLength( tagline ) > 0 ) then nameY = h - 34textlabel _shellAppName, appName, fn CGRectMake( _shellNavWidth + _shellPadding + 52, nameY, 600, 26 ), _shellWindowControlSetFont( _shellAppName, fn FontBoldSystemFontOfSize( 20.0 ) )TextFieldSetTextColor( _shellAppName, gThemeHeaderText )ViewSetAutoresizingMask( _shellAppName, NSViewMaxXMargin + NSViewMinYMargin )textlabel _shellTagline, tagline, fn CGRectMake( _shellNavWidth + _shellPadding + 54, h - 48, 600, 14 ), _shellWindowControlSetFont( _shellTagline, fn FontSystemFontOfSize( 11.0 ) )TextFieldSetTextColor( _shellTagline, gThemeTaglineText )ViewSetAutoresizingMask( _shellTagline, NSViewMaxXMargin + NSViewMinYMargin )// the Dock and the About box show the app icon too, when it is a pictureif ( fn ImageNamed( @"AppLogo" ) != NULL ) then 