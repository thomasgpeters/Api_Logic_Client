/* *   I M A G E R Y    B U S I N E S S     S Y S T E M S,   L L C * *   App Shell.incl - runtime: the common look and feel of every generated app * *       +--------------+------------------------------------------------------------+ *       |  navigation  |  [logo]  App Name                      [Theme v] [Log In] | *       |  (dark blue) |          tag-line                                          | *       |              +------------------------------------------------------------+ *       |  [icon] Page |                                                            | *       |  [icon] Page |     content: the page's parts (nibview ... _shellContent)  | *       |  ...         |                                                            | *       |  (scrolls)   +------------------------------------------------------------+ *       |              |  (c) copyright    status          [New][Save][Delete][Refresh] | *       +--------------+------------------------------------------------------------+ * *   The colours come from the theme globals below; the app's Theme.incl (a starting *   template, yours) sets them in ApplyTheme before ShellBuildWindow.  Pages are *   registered with ShellAddNavItem (App Pages.incl does it for every entity); *   ShellShowPage shows one page's views and hides the others.  The app's DoDialog *   passes events to ShellDoDialog first (navigation, theme menu); the Log In button *   (_shellLoginButton) and the page actions in the footer (New, Save, Delete, Refresh) *   are the app's: App Pages.incl handles them. */_shellWindow = 2// tags (62000-62999: clear of the model's tags and the ALS runtime's)_shellNavBox         = 62000_shellNavScroll      = 62001_shellNavDocument    = 62002_shellNavHighlight   = 62003_shellHeaderBox      = 62010_shellLogo           = 62011_shellAppName        = 62012_shellTagline        = 62013_shellThemePopup     = 62014_shellLoginButton    = 62015_shellFooterBox      = 62020_shellCopyright      = 62021_shellStatus         = 62022           // what just happened: "Saved.", a refused save's reason_shellNewButton      = 62023           // the page actions - App Pages.incl handles them_shellSaveButton     = 62024_shellDeleteButton   = 62025_shellRefreshButton  = 62026_shellContent        = 62030_shellNavButtonBase  = 62100           // + page index// layout_shellNavWidth       = 220_shellHeaderHeight   = 72_shellFooterHeight   = 44_shellNavItemHeight  = 34_shellNavItemGap     = 4_shellPadding        = 16// menus (Menus.incl builds them; App Pages.incl handles Records)_shellMenuFile    = 1_shellMenuEdit    = 2_shellMenuRecords = 3begin enum 1_shellItemNew_shellItemSave_shellItemDelete_shellItemSeparator_shellItemRefreshend enumbegin globalsColorRef        gThemeNavBackground    // the navigation bar (dark blue)ColorRef        gThemeNavText          // navigation buttons: text and icons (white)ColorRef        gThemeNavSelection     // behind the selected buttonColorRef        gThemeHeaderBackgroundColorRef        gThemeHeaderTextColorRef        gThemeTaglineTextColorRef        gThemeFooterBackgroundColorRef        gThemeFooterTextCGFloat         gThemeNavFontSizeMutableArrayRef gShellPages            // [ { title, views: [ view tags ] } ], in navigation orderlong            gShellCurrentPageptr             gShellPageShownFn      // void local fn ( pageIndex as long ): set by App Pages.inclend globals// the look before the app's ApplyTheme changes itvoid local fn ShellDefaultThemegThemeNavBackground    = fn ColorWithSRGB( 0.067, 0.157, 0.329, 1.0 )   // dark bluegThemeNavText          = fn ColorWhitegThemeNavSelection     = fn ColorWithSRGB( 1.0, 1.0, 1.0, 0.16 )gThemeHeaderBackground = fn ColorControlBackground                      // follows light / darkgThemeHeaderText       = fn ColorLabelgThemeTaglineText      = fn ColorSecondaryLabelgThemeFooterBackground = fn ColorWindowBackgroundgThemeFooterText       = fn ColorSecondaryLabelgThemeNavFontSize      = 13.0end fn// a box filled with one colour, no bordervoid local fn ShellPanel( tag as long, r as CGRect, fillColor as ColorRef, mask as long )box tag, @"", r, NSBoxCustom, _shellWindowBoxSetFillColor( tag, fillColor )BoxSetBorderWidth( tag, 0.0 )ViewSetAutoresizingMask( tag, mask )end fn// the app's logo: AppLogo.png in the bundle (Project Settings in the Studio), else a symbollocal fn ShellLogoImage as ImageRefImageRef logo = fn ImageNamed( @"AppLogo" )if ( logo == NULL ) then logo = fn ImageWithSystemSymbolName( @"building.2", @"Logo" )end fn = logo// a page action in the footer, kept at the right edge when the window growsvoid local fn ShellFooterButton( tag as long, title as StringRef, x as CGFloat )button tag, YES, , title, fn CGRectMake( x, 7, 88, 30 ), NSButtonTypeMomentaryPushIn, NSBezelStyleRounded, _shellWindowViewSetAutoresizingMask( tag, NSViewMinXMargin + NSViewMaxYMargin )end fnvoid local fn ShellBuildWindow( appName as StringRef, tagline as StringRef, copyright as StringRef )CGRect rCGFloat w = 1180, h = 760if ( gThemeNavBackground == NULL ) then fn ShellDefaultThemegShellPages = fn MutableArrayNewgShellCurrentPage = -1r = fn CGRectMake( 0, 0, w, h )window _shellWindow, appName, r, NSWindowStyleMaskTitled + NSWindowStyleMaskClosable + NSWindowStyleMaskMiniaturizable + NSWindowStyleMaskResizableWindowSetContentMinSize( _shellWindow, fn CGSizeMake( 900, 560 ) )WindowCenter( _shellWindow )ViewSetAutoresizesSubviews( _windowContentViewTag, YES )// navigation bar: the full height on the left; its buttons scroll when there are manyfn ShellPanel( _shellNavBox, fn CGRectMake( 0, 0, _shellNavWidth, h ), gThemeNavBackground, NSViewHeightSizable + NSViewMaxXMargin )scrollview _shellNavScroll, fn CGRectMake( 0, _shellPadding, _shellNavWidth, h - _shellPadding * 2 ), NSNoBorder, , _shellWindowScrollViewSetDrawsBackground( _shellNavScroll, NO )ViewSetAutoresizingMask( _shellNavScroll, NSViewHeightSizable + NSViewMaxXMargin )view _shellNavDocument, fn CGRectMake( 0, 0, _shellNavWidth, 10 ), _shellWindowViewSetFlipped( _shellNavDocument, YES )                 // items run from the top downbox _shellNavHighlight, @"", fn CGRectMake( 10, 0, _shellNavWidth - 20, _shellNavItemHeight ), NSBoxCustom, _shellWindowBoxSetFillColor( _shellNavHighlight, gThemeNavSelection )BoxSetBorderWidth( _shellNavHighlight, 0.0 )BoxSetCornerRadius( _shellNavHighlight, 6.0 )ViewAddSubview( _shellNavDocument, _shellNavHighlight )ViewSetHidden( _shellNavHighlight, YES )ScrollViewSetDocumentView( _shellNavScroll, _shellNavDocument )// header: logo, app name and tag-line on the left; theme menu and Log In on the rightfn ShellPanel( _shellHeaderBox, fn CGRectMake( _shellNavWidth, h - _shellHeaderHeight, w - _shellNavWidth, _shellHeaderHeight ), gThemeHeaderBackground, NSViewWidthSizable + NSViewMinYMargin )imageview _shellLogo, YES, fn ShellLogoImage, fn CGRectMake( _shellNavWidth + _shellPadding, h - _shellHeaderHeight + 10, 52, 52 ), NSImageScaleProportionallyUpOrDown, , , _shellWindowViewSetAutoresizingMask( _shellLogo, NSViewMaxXMargin + NSViewMinYMargin )textlabel _shellAppName, appName, fn CGRectMake( _shellNavWidth + _shellPadding + 64, h - 38, 520, 24 ), _shellWindowControlSetFont( _shellAppName, fn FontBoldSystemFontOfSize( 18.0 ) )TextFieldSetTextColor( _shellAppName, gThemeHeaderText )ViewSetAutoresizingMask( _shellAppName, NSViewMaxXMargin + NSViewMinYMargin )textlabel _shellTagline, tagline, fn CGRectMake( _shellNavWidth + _shellPadding + 64, h - 60, 520, 18 ), _shellWindowTextFieldSetTextColor( _shellTagline, gThemeTaglineText )ViewSetAutoresizingMask( _shellTagline, NSViewMaxXMargin + NSViewMinYMargin )button _shellLoginButton, YES, , @"Log In", fn CGRectMake( w - _shellPadding - 96, h - 50, 96, 30 ), NSButtonTypeMomentaryPushIn, NSBezelStyleRounded, _shellWindowViewSetAutoresizingMask( _shellLoginButton, NSViewMinXMargin + NSViewMinYMargin )popupbutton _shellThemePopup, YES, 0, @[ @"System Theme", @"Light", @"Dark" ], fn CGRectMake( w - _shellPadding - 96 - 12 - 140, h - 50, 140, 30 ), NO, _shellWindowViewSetAutoresizingMask( _shellThemePopup, NSViewMinXMargin + NSViewMinYMargin )// footer: copyright on the left, then the status line; the page actions on the rightfn ShellPanel( _shellFooterBox, fn CGRectMake( _shellNavWidth, 0, w - _shellNavWidth, _shellFooterHeight ), gThemeFooterBackground, NSViewWidthSizable + NSViewMaxYMargin )textlabel _shellCopyright, copyright, fn CGRectMake( _shellNavWidth + _shellPadding, 14, 260, 16 ), _shellWindowTextFieldSetTextColor( _shellCopyright, gThemeFooterText )ViewSetAutoresizingMask( _shellCopyright, NSViewMaxXMargin + NSViewMaxYMargin )textlabel _shellStatus, @"", fn CGRectMake( _shellNavWidth + _shellPadding + 272, 14, w - _shellNavWidth - _shellPadding * 2 - 272 - 4 * 92, 16 ), _shellWindowTextFieldSetTextColor( _shellStatus, gThemeHeaderText )ViewSetAutoresizingMask( _shellStatus, NSViewWidthSizable + NSViewMaxYMargin )fn ShellFooterButton( _shellRefreshButton, @"Refresh", w - _shellPadding - 88 )fn ShellFooterButton( _shellDeleteButton, @"Delete", w - _shellPadding - 88 * 2 - 4 )fn ShellFooterButton( _shellSaveButton, @"Save", w - _shellPadding - 88 * 3 - 8 )fn ShellFooterButton( _shellNewButton, @"New", w - _shellPadding - 88 * 4 - 12 )// content: the pages' parts go in here (nibview ..., _shellContent)view _shellContent, fn CGRectMake( _shellNavWidth + _shellPadding, _shellFooterHeight + _shellPadding, w - _shellNavWidth - _shellPadding * 2, h - _shellHeaderHeight - _shellFooterHeight - _shellPadding * 2 ), _shellWindowViewSetAutoresizingMask( _shellContent, NSViewWidthSizable + NSViewHeightSizable )ViewSetAutoresizesSubviews( _shellContent, YES )end fn// the content area's size, for placing a page's parts (origin 0,0 at its bottom left)local fn ShellContentBounds as CGRectend fn = fn ViewBounds( _shellContent )/* *   A navigation button for a page: title, an SF Symbol name (e.g. @"person.2") and the *   tags of the views that make up the page.  Returns the page's index. */local fn ShellAddNavItem( title as StringRef, symbolName as StringRef, viewTags as ArrayRef ) as longlong   index = fn ArrayCount( gShellPages )long   buttonTag = _shellNavButtonBase + indexCGFloat y = _shellNavItemGap + index * ( _shellNavItemHeight + _shellNavItemGap )NumberRef viewTagbutton buttonTag, YES, , fn StringWithFormat( @"  %@", title ), fn CGRectMake( 10, y, _shellNavWidth - 20, _shellNavItemHeight ), NSButtonTypeMomentaryPushIn, NSBezelStyleRegularSquare, _shellWindowButtonSetBordered( buttonTag, NO )ButtonSetImage( buttonTag, fn ImageWithSystemSymbolName( symbolName, title ) )ButtonSetImagePosition( buttonTag, NSImageLeft )ControlSetAlignment( buttonTag, NSTextAlignmentLeft )ControlSetFont( buttonTag, fn FontBoldSystemFontOfSize( gThemeNavFontSize ) )ButtonSetContentTintColor( buttonTag, gThemeNavText )ViewSetToolTip( buttonTag, title )ViewAddSubview( _shellNavDocument, buttonTag )ViewSetFrame( _shellNavDocument, fn CGRectMake( 0, 0, _shellNavWidth, y + _shellNavItemHeight + _shellNavItemGap ) )for viewTag in viewTagsViewSetHidden( fn NumberIntegerValue( viewTag ), YES )nextMutableArrayAddObject( gShellPages, @{ @"title":title, @"views":viewTags } )end fn = indexvoid local fn ShellSetPageShownHandler( handler as ptr )gShellPageShownFn = handlerend fnvoid local fn ShellCallPageShown( handler as ptr, index as long )cln ((void (*)(long))handler)( index );end fn// show one page's views, hide the others, mark its button; then tell the app (its data)void local fn ShellShowPage( index as long )DictionaryRef pageArrayRef      viewTagsNumberRef     viewTaglong          iptr           handler = gShellPageShownFnif ( index < 0 || index >= fn ArrayCount( gShellPages ) ) then exit fnfor i = 0 to fn ArrayCount( gShellPages ) - 1page = fn ArrayObjectAtIndex( gShellPages, i )viewTags = fn DictionaryObjectForKey( page, @"views" )for viewTag in viewTagsViewSetHidden( fn NumberIntegerValue( viewTag ), ( i != index ) )nextnextViewSetFrame( _shellNavHighlight, fn CGRectMake( 10, _shellNavItemGap + index * ( _shellNavItemHeight + _shellNavItemGap ), _shellNavWidth - 20, _shellNavItemHeight ) )ViewSetHidden( _shellNavHighlight, NO )gShellCurrentPage = indexif ( handler != NULL ) then fn ShellCallPageShown( handler, index )end fn// the footer's status line: what just happenedvoid local fn ShellSetStatus( message as StringRef )if ( message == NULL ) then message = @""ControlSetStringValue( _shellStatus, message )end fn// the Log In button: shown only when the app's data needs a sign-in (Enterprise)void local fn ShellShowLogin( flag as BOOL )ViewSetHidden( _shellLoginButton, ( flag == NO ) )end fn// application events: quit when the window closesvoid local fn ShellDoAppEvent( ev as long )select ( ev )case _appShouldTerminateAfterLastWindowClosed : AppEventSetBool( YES )end selectend fn// System / Light / Darkvoid local fn ShellApplyThemeChoice( choice as long )select ( choice )case 1 : AppSetAppearanceNamed( @"NSAppearanceNameAqua" )case 2 : AppSetAppearanceNamed( @"NSAppearanceNameDarkAqua" )case else : AppSetAppearance( NULL )end selectend fn// navigation and the theme menu; YES when the event was the shell'slocal fn ShellDoDialog( ev as long, tag as long, wnd as long ) as BOOLif ( ev != _btnClick ) then exit fn = NOif ( tag >= _shellNavButtonBase && tag < _shellNavButtonBase + fn ArrayCount( gShellPages ) )fn ShellShowPage( tag - _shellNavButtonBase )exit fn = YESend ifif ( tag == _shellThemePopup )fn ShellApplyThemeChoice( fn PopUpButtonIndexOfSelectedItem( _shellThemePopup ) )exit fn = YESend ifend fn = NO