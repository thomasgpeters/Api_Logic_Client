/* *   I M A G E R Y    B U S I N E S S     S Y S T E M S,   L L C * *   Logic Engine.incl - runtime: LogicBank for FutureBasic, enforcing the rules * *   The app saves through the engine instead of writing records directly: * *       LogicInsert( entity, record )            YES: saved (a generated key is set in record) *       LogicUpdate( entity, record, keyValues ) keyValues NULL: the record's own keys *       LogicDelete( entity, keyValues ) *       LogicUpsert( entity, record )            update when the record's key exists, else insert *       LogicMessage                             why the last save failed, for the user * *   Each save is one transaction (Data SQLite.incl: DataBegin / DataEnd).  Per row: * *       insert   formulas (dependency order)           -> adjust parents -> constraints -> write *       update   formulas whose inputs changed (pruned) -> adjust parents -> constraints -> write *       delete                                             adjust parents ->                write * *   Adjust parents: each sum / count the row contributes to changes its parent by the *   difference this save makes (inserted +, deleted -, changed new - old, a where that *   starts or stops holding, a move to another parent: - from the old, + to the new). *   Each changed parent is saved once, through the same logic (chaining): its formulas, *   its own parents, its constraints.  A failed constraint anywhere rolls back the *   whole transaction.  Logged on isLoggingOn, indented by chaining depth. */begin globalsStringRef gLogicMessage            // the last failure, for the user ("" after a successful save)long      gLogicNest               // chaining depth of the save being processedend globals_logicMaxNest = 20                  // a deeper chain is a rule loop: the save fails// updates call row logic, which adjusts parents, which updates them: declared aheaddef fn LogicUpdateRow( entityName as StringRef, aRecord as MutableDictionaryRef, keyValues as DictionaryRef, chained as BOOL ) as BOOLlocal fn LogicMessage as StringRefif ( gLogicMessage == NULL ) then exit fn = @""end fn = gLogicMessagevoid local fn LogicLog( logicRow as LogicRowRef, message as StringRef )MutableStringRef indentlong             iif ( isLoggingOn == NO ) then exit fnindent = fn MutableStringNewfor i = 1 to fn NumberIntegerValue( fn DictionaryObjectForKey( logicRow, @"nest" ) )MutableStringAppendString( indent, @"    " )nextNSLog( @"Logic: %@%@ %@ - %@", indent, fn DictionaryObjectForKey( logicRow, @"verb" ), fn LogicEntityName( logicRow ), message )end fn// a formula is skipped on update when none of the attributes it reads changedlocal fn LogicFormulaPruned( logicRow as LogicRowRef, formula as DictionaryRef ) as BOOLArrayRef  dependsOn = fn DictionaryObjectForKey( formula, @"dependsOn" )StringRef dependencyif ( fn LogicIsUpdate( logicRow ) == NO ) then exit fn = NOif ( fn ArrayCount( dependsOn ) == 0 ) then exit fn = NO           // reads nothing declared: always runsfor dependency in dependsOnif ( fn StringContainsString( dependency, @"." ) )// a parent reference: run when the row now points at another parentif ( fn LogicRoleChanged( logicRow, fn ArrayFirstObject( fn StringComponentsSeparatedByString( dependency, @"." ) ) ) ) then exit fn = NOelseif ( fn LogicChanged( logicRow, dependency ) ) then exit fn = NOend ifnextend fn = YESvoid local fn LogicRunFormulas( logicRow as LogicRowRef )ArrayRef      formulas = fn LogicRulesOf( fn LogicEntityName( logicRow ), @"formulas" )DictionaryRef formulaStringRef     attrNameCFTypeRef     valuefor formula in formulasattrName = fn DictionaryObjectForKey( formula, @"attr" )if ( fn LogicFormulaPruned( logicRow, formula ) )fn LogicLog( logicRow, fn StringWithFormat( @"formula %@ pruned (inputs unchanged)", attrName ) )elsevalue = fn LogicCallFormula( fn ValuePointer( fn DictionaryObjectForKey( formula, @"fn" ) ), logicRow )if ( fn LogicValuesDiffer( value, fn LogicValue( logicRow, attrName ) ) )fn LogicSetValue( logicRow, attrName, value )fn LogicLog( logicRow, fn StringWithFormat( @"formula %@ = %@", attrName, fn LogicString( logicRow, attrName ) ) )end ifend ifnextend fn// NO, with gLogicMessage set, when a constraint failslocal fn LogicRunConstraints( logicRow as LogicRowRef ) as BOOLArrayRef      constraints = fn LogicRulesOf( fn LogicEntityName( logicRow ), @"constraints" )DictionaryRef constraintfor constraint in constraintsif ( fn LogicCallCondition( fn ValuePointer( fn DictionaryObjectForKey( constraint, @"fn" ) ), logicRow ) == NO )gLogicMessage = fn LogicFormatMessage( logicRow, fn DictionaryObjectForKey( constraint, @"message" ) )fn LogicLog( logicRow, fn StringWithFormat( @"constraint failed: %@", gLogicMessage ) )exit fn = NOend ifnextend fn = YES// the parent's key values a child record points at (fks), or NULL when a foreign key is emptylocal fn LogicParentKey( aggregate as DictionaryRef, aRecord as DictionaryRef ) as ArrayRefMutableArrayRef keyValues = fn MutableArrayNewArrayRef        fks = fn DictionaryObjectForKey( aggregate, @"fks" )StringRef       fkCFTypeRef       valueif ( aRecord == NULL ) then exit fn = NULLfor fk in fksvalue = fn DictionaryObjectForKey( aRecord, fk )if ( fn DataIsNull( value ) ) then exit fn = NULLMutableArrayAddObject( keyValues, value )nextend fn = keyValues// what one child row adds to its parent's sum / count (0 when its where is not met)local fn LogicContribution( aggregate as DictionaryRef, viewRow as LogicRowRef ) as doubleptr whereFnif ( viewRow == NULL ) then exit fn = 0.0whereFn = fn ValuePointer( fn DictionaryObjectForKey( aggregate, @"where" ) )if ( whereFn != NULL )if ( fn LogicCallCondition( whereFn, viewRow ) == NO ) then exit fn = 0.0end ifif ( fn StringIsEqual( fn DictionaryObjectForKey( aggregate, @"kind" ), @"count" ) ) then exit fn = 1.0end fn = fn LogicDouble( viewRow, fn DictionaryObjectForKey( aggregate, @"childAttr" ) )// add a change for one parent row and attribute; parents: [ { entity, parentKeys, key, changes, kinds } ]void local fn LogicAddDelta( parents as MutableArrayRef, aggregate as DictionaryRef, parentKey as ArrayRef, delta as double )MutableDictionaryRef entry = NULL, changes, kindsDictionaryRef        candidateStringRef            parentEntity = fn DictionaryObjectForKey( aggregate, @"entity" )StringRef            attrName = fn DictionaryObjectForKey( aggregate, @"attr" )if ( parentKey == NULL || delta == 0.0 ) then exit fnfor candidate in parentsif ( fn StringIsEqual( fn DictionaryObjectForKey( candidate, @"entity" ), parentEntity ) && fn ObjectIsEqual( fn DictionaryObjectForKey( candidate, @"key" ), parentKey ) ) then entry = (MutableDictionaryRef)candidatenextif ( entry == NULL )entry = fn MutableDictionaryNewMutableDictionarySetObjectForKey( entry, parentEntity, @"entity" )MutableDictionarySetObjectForKey( entry, fn DictionaryObjectForKey( aggregate, @"parentKeys" ), @"parentKeys" )MutableDictionarySetObjectForKey( entry, parentKey, @"key" )MutableDictionarySetObjectForKey( entry, fn MutableDictionaryNew, @"changes" )MutableDictionarySetObjectForKey( entry, fn MutableDictionaryNew, @"kinds" )MutableArrayAddObject( parents, entry )end ifchanges = (MutableDictionaryRef)fn DictionaryObjectForKey( entry, @"changes" )kinds   = (MutableDictionaryRef)fn DictionaryObjectForKey( entry, @"kinds" )MutableDictionarySetObjectForKey( changes, fn NumberWithDouble( fn LogicNumberOf( fn DictionaryObjectForKey( changes, attrName ) ) + delta ), attrName )MutableDictionarySetObjectForKey( kinds, fn DictionaryObjectForKey( aggregate, @"kind" ), attrName )end fn/* *   Adjust the parents of a child row by the difference this save makes - never by *   re-querying the sum - and save each changed parent once, through its own logic. */local fn LogicAdjustParents( logicRow as LogicRowRef ) as BOOLArrayRef             aggregates = fn LogicRulesOf( fn LogicEntityName( logicRow ), @"aggregates" )MutableArrayRef      parents = fn MutableArrayNewDictionaryRef        aggregate, entry, stored, changes, kinds, oldRecordLogicRowRef          newView = NULL, oldView = NULLArrayRef             newKey, oldKey, parentKeys, key, attrNamesMutableDictionaryRef filter, parentRecordStringRef            attrNamedouble               newPart, oldPart, totallong                 iif ( fn ArrayCount( aggregates ) == 0 ) then exit fn = YESif ( fn LogicIsDelete( logicRow ) == NO ) then newView = logicRowoldRecord = fn DictionaryObjectForKey( logicRow, @"old" )if ( fn LogicIsInsert( logicRow ) == NO && oldRecord != NULL ) then oldView = fn LogicNewRow( fn LogicEntityName( logicRow ), fn MutableDictionaryWithDictionary( oldRecord ), NULL, fn DictionaryObjectForKey( logicRow, @"verb" ), gLogicNest )for aggregate in aggregatesnewKey = NULLoldKey = NULLif ( newView != NULL ) then newKey = fn LogicParentKey( aggregate, fn LogicRecord( newView ) )if ( oldView != NULL ) then oldKey = fn LogicParentKey( aggregate, fn LogicRecord( oldView ) )newPart = fn LogicContribution( aggregate, newView )oldPart = fn LogicContribution( aggregate, oldView )if ( newKey != NULL && oldKey != NULL && fn ObjectIsEqual( newKey, oldKey ) )fn LogicAddDelta( parents, aggregate, newKey, newPart - oldPart )else// inserted, deleted, or moved to another parent: + to the new, - from the oldfn LogicAddDelta( parents, aggregate, newKey, newPart )fn LogicAddDelta( parents, aggregate, oldKey, -oldPart )end ifnextfor entry in parentsparentKeys = fn DictionaryObjectForKey( entry, @"parentKeys" )key        = fn DictionaryObjectForKey( entry, @"key" )filter     = fn MutableDictionaryNewfor i = 0 to fn ArrayCount( parentKeys ) - 1MutableDictionarySetObjectForKey( filter, fn ArrayObjectAtIndex( key, i ), fn ArrayObjectAtIndex( parentKeys, i ) )nextstored = fn DataFetchOne( fn DictionaryObjectForKey( entry, @"entity" ), filter )if ( stored != NULL )changes      = fn DictionaryObjectForKey( entry, @"changes" )kinds        = fn DictionaryObjectForKey( entry, @"kinds" )parentRecord = fn MutableDictionaryWithDictionary( filter )attrNames    = fn DictionaryAllKeys( changes )for attrName in attrNamestotal = fn LogicNumberOf( fn DictionaryObjectForKey( stored, attrName ) ) + fn NumberDoubleValue( fn DictionaryObjectForKey( changes, attrName ) )if ( fn StringIsEqual( fn DictionaryObjectForKey( kinds, attrName ), @"count" ) )MutableDictionarySetObjectForKey( parentRecord, fn NumberWithInteger( (long)total ), attrName )elseMutableDictionarySetObjectForKey( parentRecord, fn NumberWithDouble( total ), attrName )end ifnextfn LogicLog( logicRow, fn StringWithFormat( @"adjust %@ %@: %@", fn DictionaryObjectForKey( entry, @"entity" ), key, changes ) )if ( fn LogicUpdateRow( fn DictionaryObjectForKey( entry, @"entity" ), parentRecord, filter, YES ) == NO ) then exit fn = NOend ifnextend fn = YES/* *   Sums and counts belong to the rules (LogicBank audit LB-41: clients could write them, *   and later adjustments built on the wrong value).  A new row starts them at 0 - it has *   no children yet; a save from the app keeps their stored values; only the engine's own *   parent saves (chained) change them. */void local fn LogicProtectDerived( entityName as StringRef, aRecord as MutableDictionaryRef, oldRecord as DictionaryRef, chained as BOOL )DictionaryRef derived = fn LogicDerivedAttrs( entityName )ArrayRef      attrNames = fn DictionaryAllKeys( derived )StringRef     attrNameCFTypeRef     storedfor attrName in attrNamesif ( oldRecord == NULL )if ( fn StringIsEqual( fn DictionaryObjectForKey( derived, attrName ), @"count" ) )MutableDictionarySetObjectForKey( aRecord, fn NumberWithInteger( 0 ), attrName )elseMutableDictionarySetObjectForKey( aRecord, fn NumberWithDouble( 0.0 ), attrName )end ifelseif ( chained == NO )stored = fn DictionaryObjectForKey( oldRecord, attrName )if ( stored == NULL ) then stored = fn DataNullif ( fn LogicValuesDiffer( fn DictionaryObjectForKey( aRecord, attrName ), stored ) )MutableDictionarySetObjectForKey( aRecord, stored, attrName )if (isLoggingOn) then NSLog( @"Logic: %@.%@ is derived by the rules - kept the stored value", entityName, attrName )end ifend ifend ifnextend fn// the row logic of one insert or update - top-level saves and chained parent saves alikelocal fn LogicRowLogic( logicRow as LogicRowRef ) as BOOLfn LogicRunFormulas( logicRow )if ( fn LogicAdjustParents( logicRow ) == NO ) then exit fn = NOend fn = fn LogicRunConstraints( logicRow )local fn LogicReady as BOOLif ( gLogicActive ) then exit fn = YESgLogicMessage = @"The business rules are not active (LogicActivate)."NSLog( @"Logic: %@", gLogicMessage )end fn = NOlocal fn LogicInsert( entityName as StringRef, aRecord as MutableDictionaryRef ) as BOOLLogicRowRef logicRowBOOL        okgLogicMessage = @""if ( fn LogicReady == NO ) then exit fn = NOif ( fn DataBegin == NO )gLogicMessage = @"The database is busy or not open."exit fn = NOend iffn LogicProtectDerived( entityName, aRecord, NULL, NO )logicRow = fn LogicNewRow( entityName, aRecord, NULL, @"insert", gLogicNest )fn LogicLog( logicRow, @"begin" )gLogicNest++ok = fn LogicRowLogic( logicRow )if ( ok )ok = fn DataInsert( entityName, aRecord )if ( ok == NO ) then gLogicMessage = fn StringWithFormat( @"Could not insert the %@.", entityName )end ifgLogicNest--ok = fn DataEnd( ok )if ( ok ) then fn LogicLog( logicRow, @"saved" ) else fn LogicLog( logicRow, @"rolled back" )end fn = ok// keyValues: the row's stored key (NULL: the record's own); columns missing from the// record keep their stored values, so rules always see a whole row.  chained: a parent// save made by the engine itself (keeps the message of the save that started it)local fn LogicUpdateRow( entityName as StringRef, aRecord as MutableDictionaryRef, keyValues as DictionaryRef, chained as BOOL ) as BOOLLogicRowRef   logicRowDictionaryRef oldRecordArrayRef      columnsStringRef     columnNameBOOL          okif ( chained == NO ) then gLogicMessage = @""if ( fn LogicReady == NO ) then exit fn = NOif ( gLogicNest > _logicMaxNest )gLogicMessage = fn StringWithFormat( @"The rules chain more than %d levels deep (a rule loop?).", _logicMaxNest )exit fn = NOend ifif ( keyValues == NULL ) then keyValues = fn DataKeyValues( entityName, aRecord )if ( fn DataBegin == NO )gLogicMessage = @"The database is busy or not open."exit fn = NOend ifoldRecord = fn DataFetchOne( entityName, keyValues )if ( oldRecord == NULL )gLogicMessage = fn StringWithFormat( @"The %@ no longer exists.", entityName )fn DataEnd( NO )exit fn = NOend ifcolumns = fn DataColumns( entityName )for columnName in columnsif ( fn DictionaryObjectForKey( aRecord, columnName ) == NULL ) then MutableDictionarySetObjectForKey( aRecord, fn DictionaryObjectForKey( oldRecord, columnName ), columnName )nextfn LogicProtectDerived( entityName, aRecord, oldRecord, chained )logicRow = fn LogicNewRow( entityName, aRecord, oldRecord, @"update", gLogicNest )fn LogicLog( logicRow, @"begin" )gLogicNest++ok = fn LogicRowLogic( logicRow )if ( ok )ok = ( fn DataUpdate( entityName, aRecord, keyValues ) == 1 )if ( ok == NO ) then gLogicMessage = fn StringWithFormat( @"Could not update the %@.", entityName )end ifgLogicNest--ok = fn DataEnd( ok )if ( ok ) then fn LogicLog( logicRow, @"saved" ) else fn LogicLog( logicRow, @"rolled back" )end fn = oklocal fn LogicUpdate( entityName as StringRef, aRecord as MutableDictionaryRef, keyValues as DictionaryRef ) as BOOLend fn = fn LogicUpdateRow( entityName, aRecord, keyValues, NO )// update when a row with the record's key exists, else insert (an empty generated key inserts)local fn LogicUpsert( entityName as StringRef, aRecord as MutableDictionaryRef ) as BOOLDictionaryRef keyValues = fn DataKeyValues( entityName, aRecord )ArrayRef      keyNames = fn DictionaryAllKeys( keyValues )StringRef     keyNameBOOL          complete = ( fn ArrayCount( keyNames ) > 0 )for keyName in keyNamesif ( fn DataIsNull( fn DictionaryObjectForKey( keyValues, keyName ) ) ) then complete = NOnextif ( complete )if ( fn DataFetchOne( entityName, keyValues ) != NULL ) then exit fn = fn LogicUpdateRow( entityName, aRecord, keyValues, NO )end ifend fn = fn LogicInsert( entityName, aRecord )local fn LogicDelete( entityName as StringRef, keyValues as DictionaryRef ) as BOOLLogicRowRef   logicRowDictionaryRef oldRecordBOOL          okgLogicMessage = @""if ( fn LogicReady == NO ) then exit fn = NOif ( fn DataBegin == NO )gLogicMessage = @"The database is busy or not open."exit fn = NOend ifoldRecord = fn DataFetchOne( entityName, keyValues )if ( oldRecord == NULL )gLogicMessage = fn StringWithFormat( @"The %@ no longer exists.", entityName )fn DataEnd( NO )exit fn = NOend iflogicRow = fn LogicNewRow( entityName, fn MutableDictionaryWithDictionary( oldRecord ), oldRecord, @"delete", gLogicNest )fn LogicLog( logicRow, @"begin" )gLogicNest++ok = fn LogicAdjustParents( logicRow )if ( ok )ok = ( fn DataDelete( entityName, keyValues ) == 1 )if ( ok == NO ) then gLogicMessage = fn StringWithFormat( @"Could not delete the %@.", entityName )end ifgLogicNest--ok = fn DataEnd( ok )if ( ok ) then fn LogicLog( logicRow, @"saved" ) else fn LogicLog( logicRow, @"rolled back" )end fn = ok