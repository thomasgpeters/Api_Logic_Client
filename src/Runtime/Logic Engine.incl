/* *   I M A G E R Y    B U S I N E S S     S Y S T E M S,   L L C * *   Logic Engine.incl - runtime: LogicBank for FutureBasic, enforcing the rules * *   The app saves through the engine instead of writing records directly: * *       LogicInsert( entity, record )            YES: saved (a generated key is set in record) *       LogicUpdate( entity, record, keyValues ) keyValues NULL: the record's own keys *       LogicDelete( entity, keyValues ) *       LogicUpsert( entity, record )            update when the record's key exists, else insert *       LogicMessage                             why the last save failed, for the user * *   Each save is one transaction (Data SQLite.incl: DataBegin / DataEnd).  Per row: * *       insert   copy -> parent check -> formulas -> adjust parents -> constraints -> row events -> write *       update   copy -> parent check -> formulas (pruned) -> adjust parents -> constraints *                -> row events -> write -> cascade to children that read a changed attribute *       delete   delete actions (prevent / cascade / nullify) -> adjust parents -> row events -> write *       commit   commit events, once per row, after the outermost transaction commits * *   Adjust parents: each sum / count the row contributes to changes its parent by the *   difference this save makes (inserted +, deleted -, changed new - old, a where that *   starts or stops holding, a move to another parent: - from the old, + to the new). *   Each changed parent is saved once, through the same logic (chaining): its formulas, *   its own parents, its constraints.  A failed constraint anywhere rolls back the *   whole transaction.  Logged on isLoggingOn, indented by chaining depth. */begin globalsCFStringRef gLogicMessage            // the last failure, for the user ("" after a successful save)long      gLogicNest               // chaining depth of the save being processedCFMutableArrayRef gLogicCommitQueue  // [ { fn, row } ]: commit events waiting for the outermost commitCFStringRef gLogicCascadeRole        // set for one chained child update made by a cascadeend globals_logicMaxNest = 20                  // a deeper chain is a rule loop: the save fails// updates call row logic, which adjusts parents, which updates them; deletes cascade to// deletes: declared aheaddef fn LogicUpdateRow( entityName as CFStringRef, aRecord as CFMutableDictionaryRef, keyValues as CFDictionaryRef, chained as BOOL ) as BOOLdef fn LogicDeleteRow( entityName as CFStringRef, keyValues as CFDictionaryRef, chained as BOOL ) as BOOLlocal fn LogicMessage as CFStringRefif ( gLogicMessage == NULL ) then exit fn = @""end fn = gLogicMessagevoid local fn LogicLog( logicRow as LogicRowRef, message as CFStringRef )CFMutableStringRef indentlong             iif ( isLoggingOn == NO ) then exit fnindent = fn MutableStringNewfor i = 1 to fn NumberIntegerValue( fn DictionaryObjectForKey( logicRow, @"nest" ) )MutableStringAppendString( indent, @"    " )nextNSLog( @"Logic: %@%@ %@ - %@", indent, fn DictionaryObjectForKey( logicRow, @"verb" ), fn LogicEntityName( logicRow ), message )end fn// a formula is skipped on update when none of the attributes it reads changedlocal fn LogicFormulaPruned( logicRow as LogicRowRef, formula as CFDictionaryRef ) as BOOLCFArrayRef  dependsOn = fn DictionaryObjectForKey( formula, @"dependsOn" )CFStringRef dependencyif ( fn LogicIsUpdate( logicRow ) == NO ) then exit fn = NOif ( fn ArrayCount( dependsOn ) == 0 ) then exit fn = NO           // reads nothing declared: always runsfor dependency in dependsOnif ( fn StringContainsString( dependency, @"." ) )// a parent reference: run when the row now points at another parent, or the parent changed (cascade)if ( fn LogicRoleChanged( logicRow, fn ArrayFirstObject( fn StringComponentsSeparatedByString( dependency, @"." ) ) ) ) then exit fn = NOif ( fn StringIsEqual( fn DictionaryObjectForKey( logicRow, @"cascadeRole" ), fn ArrayFirstObject( fn StringComponentsSeparatedByString( dependency, @"." ) ) ) ) then exit fn = NOelseif ( fn LogicChanged( logicRow, dependency ) ) then exit fn = NOend ifnextend fn = YESvoid local fn LogicRunFormulas( logicRow as LogicRowRef )CFArrayRef      formulas = fn LogicRulesOf( fn LogicEntityName( logicRow ), @"formulas" )CFDictionaryRef formulaCFStringRef     attrNameCFTypeRef     valuefor formula in formulasattrName = fn DictionaryObjectForKey( formula, @"attr" )if ( fn LogicFormulaPruned( logicRow, formula ) )fn LogicLog( logicRow, fn StringWithFormat( @"formula %@ pruned (inputs unchanged)", attrName ) )elsevalue = fn LogicCallFormula( fn ValuePointer( fn DictionaryObjectForKey( formula, @"fn" ) ), logicRow )if ( fn LogicValuesDiffer( value, fn LogicValue( logicRow, attrName ) ) )fn LogicSetValue( logicRow, attrName, value )fn LogicLog( logicRow, fn StringWithFormat( @"formula %@ = %@", attrName, fn LogicString( logicRow, attrName ) ) )end ifend ifnextend fn// NO, with gLogicMessage set, when a constraint failslocal fn LogicRunConstraints( logicRow as LogicRowRef ) as BOOLCFArrayRef      constraints = fn LogicRulesOf( fn LogicEntityName( logicRow ), @"constraints" )CFDictionaryRef constraintfor constraint in constraintsif ( fn LogicCallCondition( fn ValuePointer( fn DictionaryObjectForKey( constraint, @"fn" ) ), logicRow ) == NO )gLogicMessage = fn LogicFormatMessage( logicRow, fn DictionaryObjectForKey( constraint, @"message" ) )fn LogicLog( logicRow, fn StringWithFormat( @"constraint failed: %@", gLogicMessage ) )exit fn = NOend ifnextend fn = YES// the parent's key values a child record points at (fks), or NULL when a foreign key is emptylocal fn LogicParentKey( aggregate as CFDictionaryRef, aRecord as CFDictionaryRef ) as CFArrayRefCFMutableArrayRef keyValues = fn MutableArrayNewCFArrayRef        fks = fn DictionaryObjectForKey( aggregate, @"fks" )CFStringRef       fkCFTypeRef       valueif ( aRecord == NULL ) then exit fn = NULLfor fk in fksvalue = fn DictionaryObjectForKey( aRecord, fk )if ( fn DataIsNull( value ) ) then exit fn = NULLMutableArrayAddObject( keyValues, value )nextend fn = keyValues// what one child row adds to its parent's sum / count (0 when its where is not met)local fn LogicContribution( aggregate as CFDictionaryRef, viewRow as LogicRowRef ) as doubleptr whereFnif ( viewRow == NULL ) then exit fn = 0.0whereFn = fn ValuePointer( fn DictionaryObjectForKey( aggregate, @"where" ) )if ( whereFn != NULL )if ( fn LogicCallCondition( whereFn, viewRow ) == NO ) then exit fn = 0.0end ifif ( fn StringIsEqual( fn DictionaryObjectForKey( aggregate, @"kind" ), @"count" ) ) then exit fn = 1.0end fn = fn LogicDouble( viewRow, fn DictionaryObjectForKey( aggregate, @"childAttr" ) )// add a change for one parent row and attribute; parents: [ { entity, parentKeys, key, changes, kinds } ]void local fn LogicAddDelta( parents as CFMutableArrayRef, aggregate as CFDictionaryRef, parentKey as CFArrayRef, delta as double )CFMutableDictionaryRef entry = NULL, changes, kindsCFDictionaryRef        candidateCFStringRef            parentEntity = fn DictionaryObjectForKey( aggregate, @"entity" )CFStringRef            attrName = fn DictionaryObjectForKey( aggregate, @"attr" )if ( parentKey == NULL || delta == 0.0 ) then exit fnfor candidate in parentsif ( fn StringIsEqual( fn DictionaryObjectForKey( candidate, @"entity" ), parentEntity ) && fn ObjectIsEqual( (ObjectRef)fn DictionaryObjectForKey( candidate, @"key" ), (ObjectRef)parentKey ) ) then entry = (CFMutableDictionaryRef)candidatenextif ( entry == NULL )entry = fn MutableDictionaryNewMutableDictionarySetObjectForKey( entry, parentEntity, @"entity" )MutableDictionarySetObjectForKey( entry, fn DictionaryObjectForKey( aggregate, @"parentKeys" ), @"parentKeys" )MutableDictionarySetObjectForKey( entry, parentKey, @"key" )MutableDictionarySetObjectForKey( entry, fn MutableDictionaryNew, @"changes" )MutableDictionarySetObjectForKey( entry, fn MutableDictionaryNew, @"kinds" )MutableArrayAddObject( parents, entry )end ifchanges = (CFMutableDictionaryRef)fn DictionaryObjectForKey( entry, @"changes" )kinds   = (CFMutableDictionaryRef)fn DictionaryObjectForKey( entry, @"kinds" )MutableDictionarySetObjectForKey( changes, fn NumberWithDouble( fn LogicNumberOf( fn DictionaryObjectForKey( changes, attrName ) ) + delta ), attrName )MutableDictionarySetObjectForKey( kinds, fn DictionaryObjectForKey( aggregate, @"kind" ), attrName )end fn/* *   Adjust the parents of a child row by the difference this save makes - never by *   re-querying the sum - and save each changed parent once, through its own logic. */local fn LogicAdjustParents( logicRow as LogicRowRef ) as BOOLCFArrayRef             aggregates = fn LogicRulesOf( fn LogicEntityName( logicRow ), @"aggregates" )CFMutableArrayRef      parents = fn MutableArrayNewCFDictionaryRef        aggregate, entry, stored, changes, kinds, oldRecordLogicRowRef          newView = NULL, oldView = NULLCFArrayRef             newKey, oldKey, parentKeys, key, attrNamesCFMutableDictionaryRef filter, parentRecordCFStringRef            attrNamedouble               newPart, oldPart, totallong                 iif ( fn ArrayCount( aggregates ) == 0 ) then exit fn = YESif ( fn LogicIsDelete( logicRow ) == NO ) then newView = logicRowoldRecord = fn DictionaryObjectForKey( logicRow, @"old" )if ( fn LogicIsInsert( logicRow ) == NO && oldRecord != NULL ) then oldView = fn LogicNewRow( fn LogicEntityName( logicRow ), fn MutableDictionaryWithDictionary( oldRecord ), NULL, fn DictionaryObjectForKey( logicRow, @"verb" ), gLogicNest )for aggregate in aggregatesnewKey = NULLoldKey = NULLif ( newView != NULL ) then newKey = fn LogicParentKey( aggregate, fn LogicRecord( newView ) )if ( oldView != NULL ) then oldKey = fn LogicParentKey( aggregate, fn LogicRecord( oldView ) )newPart = fn LogicContribution( aggregate, newView )oldPart = fn LogicContribution( aggregate, oldView )if ( newKey != NULL && oldKey != NULL && fn ObjectIsEqual( (ObjectRef)newKey, (ObjectRef)oldKey ) )fn LogicAddDelta( parents, aggregate, newKey, newPart - oldPart )else// inserted, deleted, or moved to another parent: + to the new, - from the oldfn LogicAddDelta( parents, aggregate, newKey, newPart )fn LogicAddDelta( parents, aggregate, oldKey, -oldPart )end ifnextfor entry in parentsparentKeys = fn DictionaryObjectForKey( entry, @"parentKeys" )key        = fn DictionaryObjectForKey( entry, @"key" )filter     = fn MutableDictionaryNewfor i = 0 to fn ArrayCount( parentKeys ) - 1MutableDictionarySetObjectForKey( filter, fn ArrayObjectAtIndex( key, i ), fn ArrayObjectAtIndex( parentKeys, i ) )nextstored = fn DataFetchOne( fn DictionaryObjectForKey( entry, @"entity" ), filter )if ( stored != NULL )changes      = fn DictionaryObjectForKey( entry, @"changes" )kinds        = fn DictionaryObjectForKey( entry, @"kinds" )parentRecord = fn MutableDictionaryWithDictionary( filter )attrNames    = fn DictionaryAllKeys( changes )for attrName in attrNamestotal = fn LogicNumberOf( fn DictionaryObjectForKey( stored, attrName ) ) + fn NumberDoubleValue( fn DictionaryObjectForKey( changes, attrName ) )if ( fn StringIsEqual( fn DictionaryObjectForKey( kinds, attrName ), @"count" ) )MutableDictionarySetObjectForKey( parentRecord, fn NumberWithInteger( (long)total ), attrName )elseMutableDictionarySetObjectForKey( parentRecord, fn NumberWithDouble( total ), attrName )end ifnextfn LogicLog( logicRow, fn StringWithFormat( @"adjust %@ %@: %@", fn DictionaryObjectForKey( entry, @"entity" ), key, changes ) )if ( fn LogicUpdateRow( fn DictionaryObjectForKey( entry, @"entity" ), parentRecord, filter, YES ) == NO ) then exit fn = NOend ifnextend fn = YES/* *   Sums and counts belong to the rules (LogicBank audit LB-41: clients could write them, *   and later adjustments built on the wrong value).  A new row starts them at 0 - it has *   no children yet; a save from the app keeps their stored values; only the engine's own *   parent saves (chained) change them. */void local fn LogicProtectDerived( entityName as CFStringRef, aRecord as CFMutableDictionaryRef, oldRecord as CFDictionaryRef, chained as BOOL )CFDictionaryRef derived = fn LogicDerivedAttrs( entityName )CFArrayRef      attrNames = fn DictionaryAllKeys( derived )CFStringRef     attrNameCFTypeRef     storedfor attrName in attrNamesif ( oldRecord == NULL )if ( fn StringIsEqual( fn DictionaryObjectForKey( derived, attrName ), @"count" ) )MutableDictionarySetObjectForKey( aRecord, fn NumberWithInteger( 0 ), attrName )elseMutableDictionarySetObjectForKey( aRecord, fn NumberWithDouble( 0.0 ), attrName )end ifelseif ( chained == NO )stored = fn DictionaryObjectForKey( oldRecord, attrName )if ( stored == NULL ) then stored = fn DataNullif ( fn LogicValuesDiffer( fn DictionaryObjectForKey( aRecord, attrName ), stored ) )MutableDictionarySetObjectForKey( aRecord, stored, attrName )if (isLoggingOn) then NSLog( @"Logic: %@.%@ is derived by the rules - kept the stored value", entityName, attrName )end ifend ifend ifnextend fn// copies: on insert, and when the row moves to another parent (no parent: the row keeps its value)void local fn LogicRunCopies( logicRow as LogicRowRef )CFArrayRef      copies = fn LogicRulesOf( fn LogicEntityName( logicRow ), @"copies" )CFDictionaryRef copy, parentRecordCFStringRef     attrNamefor copy in copiesif ( fn LogicRoleChanged( logicRow, fn DictionaryObjectForKey( copy, @"role" ) ) )parentRecord = fn DataParent( fn LogicEntityName( logicRow ), fn LogicRecord( logicRow ), fn DictionaryObjectForKey( copy, @"role" ) )if ( parentRecord != NULL )attrName = fn DictionaryObjectForKey( copy, @"attr" )fn LogicSetValue( logicRow, attrName, fn DictionaryObjectForKey( parentRecord, fn DictionaryObjectForKey( copy, @"parentAttr" ) ) )fn LogicLog( logicRow, fn StringWithFormat( @"copy %@ = %@", attrName, fn LogicString( logicRow, attrName ) ) )end ifend ifnextend fn// NO, with gLogicMessage set, when a filled-in foreign key points at no parentlocal fn LogicRunParentChecks( logicRow as LogicRowRef ) as BOOLCFArrayRef      checks = fn LogicRulesOf( fn LogicEntityName( logicRow ), @"parentChecks" )CFDictionaryRef check, relationshipCFArrayRef      fksCFStringRef     fk, roleNameBOOL          emptyfor check in checksroleName     = fn DictionaryObjectForKey( check, @"role" )relationship = fn DataRelationship( fn LogicEntityName( logicRow ), roleName )fks          = fn DictionaryObjectForKey( relationship, @"fks" )empty = YESfor fk in fksif ( fn LogicIsEmpty( logicRow, fk ) == NO ) then empty = NOnextif ( empty == NO && fn LogicRoleChanged( logicRow, roleName ) )if ( fn DataParent( fn LogicEntityName( logicRow ), fn LogicRecord( logicRow ), roleName ) == NULL )gLogicMessage = fn LogicFormatMessage( logicRow, fn DictionaryObjectForKey( check, @"message" ) )fn LogicLog( logicRow, fn StringWithFormat( @"parent check failed: %@", gLogicMessage ) )exit fn = NOend ifend ifnextend fn = YES/* *   Row events see the row during the save.  One that changes it would bypass the rules *   (LogicBank audit LB-11), so the save fails instead.  Commit events are queued here and *   run by LogicFinish after the outermost commit. */local fn LogicRunRowEvents( logicRow as LogicRowRef ) as BOOLCFArrayRef         events = fn LogicRulesOf( fn LogicEntityName( logicRow ), @"rowEvents" )CFDictionaryRef    event, snapshotCFArrayRef         attrNamesCFStringRef        attrNameCFMutableStringRef changed = fn MutableStringNewsnapshot = fn DictionaryWithDictionary( fn LogicRecord( logicRow ) )for event in eventsfn LogicCallEvent( fn ValuePointer( fn DictionaryObjectForKey( event, @"fn" ) ), logicRow )nextattrNames = fn DictionaryAllKeys( snapshot )for attrName in attrNamesif ( fn LogicValuesDiffer( fn DictionaryObjectForKey( fn LogicRecord( logicRow ), attrName ), fn DictionaryObjectForKey( snapshot, attrName ) ) )if ( fn StringLength( changed ) > 0 ) then MutableStringAppendString( changed, @", " )MutableStringAppendString( changed, attrName )end ifnextif ( fn StringLength( changed ) > 0 )gLogicMessage = fn StringWithFormat( @"A row event changed %@: use a formula or a copy instead.", changed )fn LogicLog( logicRow, gLogicMessage )exit fn = NOend ifevents = fn LogicRulesOf( fn LogicEntityName( logicRow ), @"commitEvents" )if ( fn ArrayCount( events ) > 0 && gLogicCommitQueue == NULL ) then gLogicCommitQueue = fn MutableArrayNewfor event in events// the live row: an insert's generated key is set by commit timeMutableArrayAddObject( gLogicCommitQueue, @{ @"fn":fn DictionaryObjectForKey( event, @"fn" ), @"row":logicRow } )nextend fn = YES// the row logic of one insert or update - top-level saves and chained parent saves alikelocal fn LogicRowLogic( logicRow as LogicRowRef ) as BOOLif ( fn DictionaryObjectForKey( logicRow, @"cascadeRole" ) == NULL ) then fn LogicRunCopies( logicRow )    // a cascade only recomputes formulasif ( fn LogicRunParentChecks( logicRow ) == NO ) then exit fn = NOfn LogicRunFormulas( logicRow )if ( fn LogicAdjustParents( logicRow ) == NO ) then exit fn = NOif ( fn LogicRunConstraints( logicRow ) == NO ) then exit fn = NOend fn = fn LogicRunRowEvents( logicRow )// after the parent is written: children whose formulas read a changed attribute recomputelocal fn LogicCascadeChildren( logicRow as LogicRowRef ) as BOOLCFArrayRef             cascades = fn LogicRulesOf( fn LogicEntityName( logicRow ), @"cascades" )CFDictionaryRef        cascade, childCFArrayRef             attrs, childrenCFStringRef            attrName, childEntityCFMutableDictionaryRef childKeysBOOL                 changedfor cascade in cascadeschanged = NOattrs = fn DictionaryObjectForKey( cascade, @"attrs" )for attrName in attrsif ( fn LogicChanged( logicRow, attrName ) ) then changed = YESnextif ( changed )childEntity = fn DictionaryObjectForKey( cascade, @"child" )children = fn DataChildren( fn LogicEntityName( logicRow ), fn LogicRecord( logicRow ), fn DictionaryObjectForKey( cascade, @"list" ) )for child in childrenchildKeys = fn DataKeyValues( childEntity, child )gLogicCascadeRole = fn DictionaryObjectForKey( cascade, @"role" )if ( fn LogicUpdateRow( childEntity, fn MutableDictionaryWithDictionary( childKeys ), childKeys, YES ) == NO ) then exit fn = NOnextend ifnextend fn = YES// before a delete: prevent, cascade or nullify the children of each child listlocal fn LogicRunDeleteActions( logicRow as LogicRowRef ) as BOOLCFArrayRef             actions = fn LogicRulesOf( fn LogicEntityName( logicRow ), @"deleteActions" )CFDictionaryRef        action, relationship, childCFArrayRef             children, fksCFStringRef            childEntity, verb, fkCFMutableDictionaryRef childKeys, emptiedfor action in actionsrelationship = fn DataRelationship( fn LogicEntityName( logicRow ), fn DictionaryObjectForKey( action, @"list" ) )childEntity  = fn DictionaryObjectForKey( relationship, @"resource" )fks          = fn DictionaryObjectForKey( relationship, @"fks" )children     = fn DataChildren( fn LogicEntityName( logicRow ), fn DictionaryObjectForKey( logicRow, @"old" ), fn DictionaryObjectForKey( action, @"list" ) )verb         = fn DictionaryObjectForKey( action, @"action" )if ( fn ArrayCount( children ) > 0 )if ( fn StringIsEqual( verb, @"prevent" ) )gLogicMessage = fn LogicFormatMessage( logicRow, fn DictionaryObjectForKey( action, @"message" ) )fn LogicLog( logicRow, fn StringWithFormat( @"delete prevented: %@", gLogicMessage ) )exit fn = NOend iffor child in childrenchildKeys = fn DataKeyValues( childEntity, child )if ( fn StringIsEqual( verb, @"cascade" ) )if ( fn LogicDeleteRow( childEntity, childKeys, YES ) == NO ) then exit fn = NOelseemptied = fn MutableDictionaryWithDictionary( childKeys )for fk in fksMutableDictionarySetObjectForKey( emptied, fn DataNull, fk )nextif ( fn LogicUpdateRow( childEntity, emptied, childKeys, YES ) == NO ) then exit fn = NOend ifnextend ifnextend fn = YES// the key values of a row as one text, for telling rows apartlocal fn LogicRowIdentity( entityName as CFStringRef, aRecord as CFDictionaryRef ) as CFStringRefCFMutableStringRef identity = fn MutableStringWithString( entityName )CFArrayRef         keys = fn DataKeys( entityName )CFStringRef        keyNamefor keyName in keysMutableStringAppendString( identity, fn StringWithFormat( @"|%@", fn ObjectDescription( (ObjectRef)fn DictionaryObjectForKey( aRecord, keyName ) ) ) )nextend fn = identity/* *   The end of every save: DataEnd, then - when that closed the outermost transaction - *   the queued commit events: after a commit, once per row and event, with the row's last *   state (a delete wins); after a rollback, none. */local fn LogicFinish( ok as BOOL ) as BOOLCFMutableArrayRef queue, picked, seenCFDictionaryRef   entryLogicRowRef     eventRowCFStringRef       identitylong            iok = fn DataEnd( ok )if ( gDataTransactionDepth > 0 || gLogicCommitQueue == NULL ) then exit fn = okqueue = gLogicCommitQueuegLogicCommitQueue = NULLif ( ok == NO ) then exit fn = NOpicked = fn MutableArrayNewseen   = fn MutableArrayNewfor i = fn ArrayCount( queue ) - 1 to 0 step -1entry    = fn ArrayObjectAtIndex( queue, i )eventRow = (LogicRowRef)fn DictionaryObjectForKey( entry, @"row" )identity = fn StringWithFormat( @"%p|%@", fn ValuePointer( fn DictionaryObjectForKey( entry, @"fn" ) ), fn LogicRowIdentity( fn LogicEntityName( eventRow ), fn LogicRecord( eventRow ) ) )if ( fn ArrayContainsObject( seen, identity ) == NO )MutableArrayAddObject( seen, identity )MutableArrayInsertObjectAtIndex( picked, entry, 0 )end ifnextfor entry in pickedfn LogicCallEvent( fn ValuePointer( fn DictionaryObjectForKey( entry, @"fn" ) ), (LogicRowRef)fn DictionaryObjectForKey( entry, @"row" ) )nextend fn = YESlocal fn LogicReady as BOOLif ( gLogicActive ) then exit fn = YESgLogicMessage = @"The business rules are not active (LogicActivate)."NSLog( @"Logic: %@", gLogicMessage )end fn = NOlocal fn LogicInsert( entityName as CFStringRef, aRecord as CFMutableDictionaryRef ) as BOOLLogicRowRef logicRowBOOL        okgLogicMessage = @""if ( fn LogicReady == NO ) then exit fn = NOif ( fn DataBegin == NO )gLogicMessage = @"The database is busy or not open."exit fn = NOend iffn LogicProtectDerived( entityName, aRecord, NULL, NO )logicRow = fn LogicNewRow( entityName, aRecord, NULL, @"insert", gLogicNest )fn LogicLog( logicRow, @"begin" )gLogicNest++ok = fn LogicRowLogic( logicRow )if ( ok )ok = fn DataInsert( entityName, aRecord )if ( ok == NO ) then gLogicMessage = fn StringWithFormat( @"Could not insert the %@.", entityName )end ifgLogicNest--ok = fn LogicFinish( ok )if ( ok ) then fn LogicLog( logicRow, @"saved" ) else fn LogicLog( logicRow, @"rolled back" )end fn = ok// keyValues: the row's stored key (NULL: the record's own); columns missing from the// record keep their stored values, so rules always see a whole row.  chained: a parent// save made by the engine itself (keeps the message of the save that started it)local fn LogicUpdateRow( entityName as CFStringRef, aRecord as CFMutableDictionaryRef, keyValues as CFDictionaryRef, chained as BOOL ) as BOOLLogicRowRef   logicRowCFDictionaryRef oldRecordCFArrayRef      columnsCFStringRef     columnNameCFStringRef     cascadeRole = gLogicCascadeRole        // set by LogicCascadeChildren for this one callBOOL          okgLogicCascadeRole = NULLif ( chained == NO ) then gLogicMessage = @""if ( fn LogicReady == NO ) then exit fn = NOif ( gLogicNest > _logicMaxNest )gLogicMessage = fn StringWithFormat( @"The rules chain more than %d levels deep (a rule loop?).", _logicMaxNest )exit fn = NOend ifif ( keyValues == NULL ) then keyValues = fn DataKeyValues( entityName, aRecord )if ( fn DataBegin == NO )gLogicMessage = @"The database is busy or not open."exit fn = NOend ifoldRecord = fn DataFetchOne( entityName, keyValues )if ( oldRecord == NULL )gLogicMessage = fn StringWithFormat( @"The %@ no longer exists.", entityName )fn LogicFinish( NO )exit fn = NOend ifcolumns = fn DataColumns( entityName )for columnName in columnsif ( fn DictionaryObjectForKey( aRecord, columnName ) == NULL ) then MutableDictionarySetObjectForKey( aRecord, fn DictionaryObjectForKey( oldRecord, columnName ), columnName )nextfn LogicProtectDerived( entityName, aRecord, oldRecord, chained )logicRow = fn LogicNewRow( entityName, aRecord, oldRecord, @"update", gLogicNest )if ( cascadeRole != NULL ) then MutableDictionarySetObjectForKey( logicRow, cascadeRole, @"cascadeRole" )fn LogicLog( logicRow, @"begin" )gLogicNest++ok = fn LogicRowLogic( logicRow )if ( ok )ok = ( fn DataUpdate( entityName, aRecord, keyValues ) == 1 )if ( ok == NO && fn StringLength( fn LogicMessage ) == 0 ) then gLogicMessage = fn StringWithFormat( @"Could not update the %@.", entityName )end ifif ( ok ) then ok = fn LogicCascadeChildren( logicRow )gLogicNest--ok = fn LogicFinish( ok )if ( ok ) then fn LogicLog( logicRow, @"saved" ) else fn LogicLog( logicRow, @"rolled back" )end fn = oklocal fn LogicUpdate( entityName as CFStringRef, aRecord as CFMutableDictionaryRef, keyValues as CFDictionaryRef ) as BOOLend fn = fn LogicUpdateRow( entityName, aRecord, keyValues, NO )// update when a row with the record's key exists, else insert (an empty generated key inserts)local fn LogicUpsert( entityName as CFStringRef, aRecord as CFMutableDictionaryRef ) as BOOLCFDictionaryRef keyValues = fn DataKeyValues( entityName, aRecord )CFArrayRef      keyNames = fn DictionaryAllKeys( keyValues )CFStringRef     keyNameBOOL          complete = ( fn ArrayCount( keyNames ) > 0 )for keyName in keyNamesif ( fn DataIsNull( fn DictionaryObjectForKey( keyValues, keyName ) ) ) then complete = NOnextif ( complete )if ( fn DataFetchOne( entityName, keyValues ) != NULL ) then exit fn = fn LogicUpdateRow( entityName, aRecord, keyValues, NO )end ifend fn = fn LogicInsert( entityName, aRecord )// chained: a delete made by the engine itself (a cascade), keeping the message of the save that started itlocal fn LogicDeleteRow( entityName as CFStringRef, keyValues as CFDictionaryRef, chained as BOOL ) as BOOLLogicRowRef   logicRowCFDictionaryRef oldRecordBOOL          okif ( chained == NO ) then gLogicMessage = @""if ( fn LogicReady == NO ) then exit fn = NOif ( gLogicNest > _logicMaxNest )gLogicMessage = fn StringWithFormat( @"The rules chain more than %d levels deep (a rule loop?).", _logicMaxNest )exit fn = NOend ifif ( fn DataBegin == NO )gLogicMessage = @"The database is busy or not open."exit fn = NOend ifoldRecord = fn DataFetchOne( entityName, keyValues )if ( oldRecord == NULL )gLogicMessage = fn StringWithFormat( @"The %@ no longer exists.", entityName )fn LogicFinish( NO )exit fn = NOend iflogicRow = fn LogicNewRow( entityName, fn MutableDictionaryWithDictionary( oldRecord ), oldRecord, @"delete", gLogicNest )fn LogicLog( logicRow, @"begin" )gLogicNest++ok = fn LogicRunDeleteActions( logicRow )if ( ok )// the delete actions changed this row (deleted children adjusted its totals): read it again,// or its parents would be adjusted by the totals it had beforeoldRecord = fn DataFetchOne( entityName, keyValues )logicRow  = fn LogicNewRow( entityName, fn MutableDictionaryWithDictionary( oldRecord ), oldRecord, @"delete", gLogicNest - 1 )ok = fn LogicAdjustParents( logicRow )end ifif ( ok ) then ok = fn LogicRunRowEvents( logicRow )if ( ok )ok = ( fn DataDelete( entityName, keyValues ) == 1 )if ( ok == NO && fn StringLength( fn LogicMessage ) == 0 ) then gLogicMessage = fn StringWithFormat( @"Could not delete the %@.", entityName )end ifgLogicNest--ok = fn LogicFinish( ok )if ( ok ) then fn LogicLog( logicRow, @"saved" ) else fn LogicLog( logicRow, @"rolled back" )end fn = oklocal fn LogicDelete( entityName as CFStringRef, keyValues as CFDictionaryRef ) as BOOLend fn = fn LogicDeleteRow( entityName, keyValues, NO )