/* *   I M A G E R Y    B U S I N E S S     S Y S T E M S,   L L C * *   Logic Engine.incl - runtime: LogicBank for FutureBasic, enforcing the rules * *   The app saves through the engine instead of writing records directly: * *       LogicInsert( entity, record )            YES: saved (a generated key is set in record) *       LogicUpdate( entity, record, keyValues ) keyValues NULL: the record's own keys *       LogicDelete( entity, keyValues ) *       LogicMessage                             why the last save failed, for the user * *   Each save is one transaction (Data SQLite.incl: DataBegin / DataEnd).  Per row: * *       insert   formulas (dependency order)            -> constraints -> write *       update   formulas whose inputs changed (pruned)  -> constraints -> write *       delete                                               write * *   A failed constraint rolls back the whole transaction - with parent chaining *   (step 2: sums, counts), everything the save changed.  Logged on isLoggingOn, *   indented by chaining depth, so a developer sees why each value changed. */begin globalsStringRef gLogicMessage            // the last failure, for the user ("" after a successful save)long      gLogicNest               // chaining depth of the save being processedend globalslocal fn LogicMessage as StringRefif ( gLogicMessage == NULL ) then exit fn = @""end fn = gLogicMessagevoid local fn LogicLog( logicRow as LogicRowRef, message as StringRef )MutableStringRef indentlong             iif ( isLoggingOn == NO ) then exit fnindent = fn MutableStringNewfor i = 1 to fn NumberIntegerValue( fn DictionaryObjectForKey( logicRow, @"nest" ) )MutableStringAppendString( indent, @"    " )nextNSLog( @"Logic: %@%@ %@ - %@", indent, fn DictionaryObjectForKey( logicRow, @"verb" ), fn LogicEntityName( logicRow ), message )end fn// a formula is skipped on update when none of the attributes it reads changedlocal fn LogicFormulaPruned( logicRow as LogicRowRef, formula as DictionaryRef ) as BOOLArrayRef  dependsOn = fn DictionaryObjectForKey( formula, @"dependsOn" )StringRef dependencyif ( fn LogicIsUpdate( logicRow ) == NO ) then exit fn = NOif ( fn ArrayCount( dependsOn ) == 0 ) then exit fn = NO           // reads nothing declared: always runsfor dependency in dependsOnif ( fn StringContainsString( dependency, @"." ) ) then exit fn = NO  // parent reference: run (step 2 prunes)if ( fn LogicChanged( logicRow, dependency ) ) then exit fn = NOnextend fn = YESvoid local fn LogicRunFormulas( logicRow as LogicRowRef )ArrayRef      formulas = fn LogicRulesOf( fn LogicEntityName( logicRow ), @"formulas" )DictionaryRef formulaStringRef     attrNameCFTypeRef     valuefor formula in formulasattrName = fn DictionaryObjectForKey( formula, @"attr" )if ( fn LogicFormulaPruned( logicRow, formula ) )fn LogicLog( logicRow, fn StringWithFormat( @"formula %@ pruned (inputs unchanged)", attrName ) )elsevalue = fn LogicCallFormula( fn ValuePointer( fn DictionaryObjectForKey( formula, @"fn" ) ), logicRow )if ( fn LogicValuesDiffer( value, fn LogicValue( logicRow, attrName ) ) )fn LogicSetValue( logicRow, attrName, value )fn LogicLog( logicRow, fn StringWithFormat( @"formula %@ = %@", attrName, fn LogicString( logicRow, attrName ) ) )end ifend ifnextend fn// NO, with gLogicMessage set, when a constraint failslocal fn LogicRunConstraints( logicRow as LogicRowRef ) as BOOLArrayRef      constraints = fn LogicRulesOf( fn LogicEntityName( logicRow ), @"constraints" )DictionaryRef constraintfor constraint in constraintsif ( fn LogicCallCondition( fn ValuePointer( fn DictionaryObjectForKey( constraint, @"fn" ) ), logicRow ) == NO )gLogicMessage = fn LogicFormatMessage( logicRow, fn DictionaryObjectForKey( constraint, @"message" ) )fn LogicLog( logicRow, fn StringWithFormat( @"constraint failed: %@", gLogicMessage ) )exit fn = NOend ifnextend fn = YES// the row logic of one insert or update - shared by top-level saves and (step 2) chained oneslocal fn LogicRowLogic( logicRow as LogicRowRef ) as BOOLfn LogicRunFormulas( logicRow )end fn = fn LogicRunConstraints( logicRow )local fn LogicReady as BOOLif ( gLogicActive ) then exit fn = YESgLogicMessage = @"The business rules are not active (LogicActivate)."NSLog( @"Logic: %@", gLogicMessage )end fn = NOlocal fn LogicInsert( entityName as StringRef, aRecord as MutableDictionaryRef ) as BOOLLogicRowRef logicRowBOOL        okgLogicMessage = @""if ( fn LogicReady == NO ) then exit fn = NOif ( fn DataBegin == NO )gLogicMessage = @"The database is busy or not open."exit fn = NOend iflogicRow = fn LogicNewRow( entityName, aRecord, NULL, @"insert", gLogicNest )fn LogicLog( logicRow, @"begin" )gLogicNest++ok = fn LogicRowLogic( logicRow )if ( ok )ok = fn DataInsert( entityName, aRecord )if ( ok == NO ) then gLogicMessage = fn StringWithFormat( @"Could not insert the %@.", entityName )end ifgLogicNest--ok = fn DataEnd( ok )if ( ok ) then fn LogicLog( logicRow, @"saved" ) else fn LogicLog( logicRow, @"rolled back" )end fn = ok// keyValues: the row's stored key (NULL: the record's own); columns missing from the// record keep their stored values, so rules always see a whole rowlocal fn LogicUpdate( entityName as StringRef, aRecord as MutableDictionaryRef, keyValues as DictionaryRef ) as BOOLLogicRowRef   logicRowDictionaryRef oldRecordArrayRef      columnsStringRef     columnNameBOOL          okgLogicMessage = @""if ( fn LogicReady == NO ) then exit fn = NOif ( keyValues == NULL ) then keyValues = fn DataKeyValues( entityName, aRecord )if ( fn DataBegin == NO )gLogicMessage = @"The database is busy or not open."exit fn = NOend ifoldRecord = fn DataFetchOne( entityName, keyValues )if ( oldRecord == NULL )gLogicMessage = fn StringWithFormat( @"The %@ no longer exists.", entityName )fn DataEnd( NO )exit fn = NOend ifcolumns = fn DataColumns( entityName )for columnName in columnsif ( fn DictionaryObjectForKey( aRecord, columnName ) == NULL ) then MutableDictionarySetObjectForKey( aRecord, fn DictionaryObjectForKey( oldRecord, columnName ), columnName )nextlogicRow = fn LogicNewRow( entityName, aRecord, oldRecord, @"update", gLogicNest )fn LogicLog( logicRow, @"begin" )gLogicNest++ok = fn LogicRowLogic( logicRow )if ( ok )ok = ( fn DataUpdate( entityName, aRecord, keyValues ) == 1 )if ( ok == NO ) then gLogicMessage = fn StringWithFormat( @"Could not update the %@.", entityName )end ifgLogicNest--ok = fn DataEnd( ok )if ( ok ) then fn LogicLog( logicRow, @"saved" ) else fn LogicLog( logicRow, @"rolled back" )end fn = oklocal fn LogicDelete( entityName as StringRef, keyValues as DictionaryRef ) as BOOLLogicRowRef   logicRowDictionaryRef oldRecordBOOL          okgLogicMessage = @""if ( fn LogicReady == NO ) then exit fn = NOif ( fn DataBegin == NO )gLogicMessage = @"The database is busy or not open."exit fn = NOend ifoldRecord = fn DataFetchOne( entityName, keyValues )if ( oldRecord == NULL )gLogicMessage = fn StringWithFormat( @"The %@ no longer exists.", entityName )fn DataEnd( NO )exit fn = NOend iflogicRow = fn LogicNewRow( entityName, fn MutableDictionaryWithDictionary( oldRecord ), oldRecord, @"delete", gLogicNest )fn LogicLog( logicRow, @"begin" )ok = ( fn DataDelete( entityName, keyValues ) == 1 )if ( ok == NO ) then gLogicMessage = fn StringWithFormat( @"Could not delete the %@.", entityName )ok = fn DataEnd( ok )if ( ok ) then fn LogicLog( logicRow, @"saved" ) else fn LogicLog( logicRow, @"rolled back" )end fn = ok