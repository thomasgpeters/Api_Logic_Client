/* *   Binding Support.incl * *   Helpers for the generated <Entity> Binding.incl files. Copied unchanged into *   every generated project by Api Logic Client. * *   A record is a dictionary keyed by attribute name - a SQLite row or ALS *   attributes alike. "Show" puts a record value into a control; "Take" reads a *   control back into a record and leaves empty controls out (stored as NULL). */#define BINDING_DATE_FORMAT @"yyyy-MM-dd"// the value for an attribute; NULL for a missing key or a JSON / SQL nulllocal fn BindingValue( record as CFDictionaryRef, name as CFStringRef ) as CFTypeRefCFTypeRef valueif ( record == NULL ) then exit fn = NULLvalue = fn DictionaryObjectForKey( record, name )if ( value == NULL ) then exit fn = NULLif ( fn ObjectIsKindOfClass( (ObjectRef)value, fn ClassFromString( @"NSNull" ) ) ) then exit fn = NULLend fn = value// any value as text; "" for NULLlocal fn BindingString( record as CFDictionaryRef, name as CFStringRef ) as CFStringRefCFTypeRef value = fn BindingValue( record, name )if ( value == NULL ) then exit fn = @""if ( fn ObjectIsKindOfClass( (ObjectRef)value, fn StringClass ) ) then exit fn = (CFStringRef)valueend fn = fn StringWithFormat( @"%@", value )local fn BindingDateFormatter as DateFormatterRefDateFormatterRef formatter = fn DateFormatterInitDateFormatterSetDateFormat( formatter, BINDING_DATE_FORMAT )end fn = formatter/* *   record -> control */void local fn BindingShowText( tag as long, record as CFDictionaryRef, name as CFStringRef )ControlSetStringValue( tag, fn BindingString( record, name ) )end fnvoid local fn BindingShowNumber( tag as long, record as CFDictionaryRef, name as CFStringRef )CFTypeRef value = fn BindingValue( record, name )if ( value == NULL ) then ControlSetStringValue( tag, @"" ) else ControlSetObjectValue( tag, value )end fn// "1996-07-04" or "1996-07-04 00:00:00"; today when NULL or unreadablevoid local fn BindingShowDate( tag as long, record as CFDictionaryRef, name as CFStringRef )CFStringRef text = fn BindingString( record, name )CFDateRef   dt = NULLif ( fn StringLength( text ) >= 10 ) then dt = fn DateFormatterDateFromString( fn BindingDateFormatter, fn StringSubstringToIndex( text, 10 ) )if ( dt == NULL ) then dt = fn DateInitDatePickerSetDateValue( tag, dt )end fnvoid local fn BindingShowCheck( tag as long, record as CFDictionaryRef, name as CFStringRef )CFStringRef text = fn StringLowercaseString( fn BindingString( record, name ) )if ( fn StringIsEqual( text, @"1" ) || fn StringIsEqual( text, @"true" ) || fn StringIsEqual( text, @"yes" ) ) then ButtonSetState( tag, NSControlStateValueOn ) else ButtonSetState( tag, NSControlStateValueOff )end fn/* *   control -> record (empty controls are left out) */void local fn BindingTakeText( record as CFMutableDictionaryRef, name as CFStringRef, tag as long )CFStringRef text = fn ControlStringValue( tag )if ( fn StringLength( text ) > 0 ) then MutableDictionarySetObjectForKey( record, text, name )end fnvoid local fn BindingTakeInteger( record as CFMutableDictionaryRef, name as CFStringRef, tag as long )if ( fn StringLength( fn ControlStringValue( tag ) ) > 0 ) then MutableDictionarySetObjectForKey( record, fn NumberWithInteger( fn ControlIntegerValue( tag ) ), name )end fnvoid local fn BindingTakeDecimal( record as CFMutableDictionaryRef, name as CFStringRef, tag as long )if ( fn StringLength( fn ControlStringValue( tag ) ) > 0 ) then MutableDictionarySetObjectForKey( record, fn NumberWithDouble( fn ControlDoubleValue( tag ) ), name )end fnvoid local fn BindingTakeDate( record as CFMutableDictionaryRef, name as CFStringRef, tag as long )MutableDictionarySetObjectForKey( record, fn DateFormatterStringFromDate( fn BindingDateFormatter, fn DatePickerDateValue( tag ) ), name )end fnvoid local fn BindingTakeCheck( record as CFMutableDictionaryRef, name as CFStringRef, tag as long )MutableDictionarySetObjectForKey( record, fn NumberWithBool( fn ButtonState( tag ) == NSControlStateValueOn ), name )end fn