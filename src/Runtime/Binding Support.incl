/* *   Binding Support.incl * *   Helpers for the generated <Entity> Binding.incl files. Copied unchanged into *   every generated project by App Builder for FutureBasic. * *   A record is a dictionary keyed by attribute name - a SQLite row or ALS *   attributes alike. "Show" puts a record value into a control; "Take" reads a *   control back into a record and leaves empty controls out (stored as NULL). */// how dates and times are stored: SQLite's own text forms (its date and time functions read them)#define BINDING_DATE_FORMAT     @"yyyy-MM-dd"#define BINDING_TIME_FORMAT     @"HH:mm:ss"#define BINDING_DATETIME_FORMAT @"yyyy-MM-dd HH:mm:ss"// the value for an attribute; NULL for a missing key or a JSON / SQL nulllocal fn BindingValue( aRecord as CFDictionaryRef, name as CFStringRef ) as CFTypeRefCFTypeRef valueif ( aRecord == NULL ) then exit fn = NULLvalue = fn DictionaryObjectForKey( aRecord, name )if ( value == NULL ) then exit fn = NULLif ( fn ObjectIsKindOfClass( (ObjectRef)value, fn ClassFromString( @"NSNull" ) ) ) then exit fn = NULLend fn = value// any value as text; "" for NULLlocal fn BindingString( aRecord as CFDictionaryRef, name as CFStringRef ) as CFStringRefCFTypeRef value = fn BindingValue( aRecord, name )if ( value == NULL ) then exit fn = @""if ( fn ObjectIsKindOfClass( (ObjectRef)value, fn StringClass ) ) then exit fn = (CFStringRef)valueend fn = fn StringWithFormat( @"%@", value )// a formatter for one stored form; en_US_POSIX so the user's region never changes the digitslocal fn BindingFormatter( format as CFStringRef ) as DateFormatterRefDateFormatterRef formatter = fn DateFormatterInitDateFormatterSetLocale( formatter, fn LocaleWithIdentifier( @"en_US_POSIX" ) )DateFormatterSetDateFormat( formatter, format )end fn = formatterlocal fn BindingDateFormatter as DateFormatterRefend fn = fn BindingFormatter( BINDING_DATE_FORMAT )// text -> date in the given form, reading only as many characters as the form has; NULL if unreadablelocal fn BindingParse( textValue as CFStringRef, format as CFStringRef ) as CFDateRefif ( fn StringLength( textValue ) < fn StringLength( format ) ) then exit fn = NULLend fn = fn DateFormatterDateFromString( fn BindingFormatter( format ), fn StringSubstringToIndex( textValue, fn StringLength( format ) ) )/* *   record -> control */void local fn BindingShowText( tag as long, aRecord as CFDictionaryRef, name as CFStringRef )ControlSetStringValue( tag, fn BindingString( aRecord, name ) )end fnvoid local fn BindingShowNumber( tag as long, aRecord as CFDictionaryRef, name as CFStringRef )CFTypeRef value = fn BindingValue( aRecord, name )if ( value == NULL ) then ControlSetStringValue( tag, @"" ) else ControlSetObjectValue( tag, value )end fn// "1996-07-04" or "1996-07-04 00:00:00"; today when NULL or unreadablevoid local fn BindingShowDate( tag as long, aRecord as CFDictionaryRef, name as CFStringRef )CFStringRef textValue = fn BindingString( aRecord, name )CFDateRef   dt = NULLif ( fn StringLength( textValue ) >= 10 ) then dt = fn DateFormatterDateFromString( fn BindingDateFormatter, fn StringSubstringToIndex( textValue, 10 ) )if ( dt == NULL ) then dt = fn DateInitDatePickerSetDateValue( tag, dt )end fn// "14:30:00" or "14:30"; now when NULL or unreadablevoid local fn BindingShowTime( tag as long, aRecord as CFDictionaryRef, name as CFStringRef )CFStringRef textValue = fn BindingString( aRecord, name )CFDateRef   dt = fn BindingParse( textValue, BINDING_TIME_FORMAT )if ( dt == NULL ) then dt = fn BindingParse( textValue, @"HH:mm" )if ( dt == NULL ) then dt = fn DateInitDatePickerSetDateValue( tag, dt )end fn// "1996-07-04 14:30:00", or a date alone (midnight); now when NULL or unreadablevoid local fn BindingShowDateTime( tag as long, aRecord as CFDictionaryRef, name as CFStringRef )CFStringRef textValue = fn StringByReplacingOccurrencesOfString( fn BindingString( aRecord, name ), @"T", @" " )   // ISO 8601's TCFDateRef   dt = fn BindingParse( textValue, BINDING_DATETIME_FORMAT )if ( dt == NULL ) then dt = fn BindingParse( textValue, BINDING_DATE_FORMAT )if ( dt == NULL ) then dt = fn DateInitDatePickerSetDateValue( tag, dt )end fnvoid local fn BindingShowCheck( tag as long, aRecord as CFDictionaryRef, name as CFStringRef )CFStringRef textValue = fn StringLowercaseString( fn BindingString( aRecord, name ) )if ( fn StringIsEqual( textValue, @"1" ) || fn StringIsEqual( textValue, @"true" ) || fn StringIsEqual( textValue, @"yes" ) ) then ButtonSetState( tag, NSControlStateValueOn ) else ButtonSetState( tag, NSControlStateValueOff )end fn/* *   control -> record (empty controls are left out) */void local fn BindingTakeText( aRecord as CFMutableDictionaryRef, name as CFStringRef, tag as long )CFStringRef textValue = fn ControlStringValue( tag )if ( fn StringLength( textValue ) > 0 ) then MutableDictionarySetObjectForKey( aRecord, textValue, name )end fnvoid local fn BindingTakeInteger( aRecord as CFMutableDictionaryRef, name as CFStringRef, tag as long )if ( fn StringLength( fn ControlStringValue( tag ) ) > 0 ) then MutableDictionarySetObjectForKey( aRecord, fn NumberWithInteger( fn ControlIntegerValue( tag ) ), name )end fnvoid local fn BindingTakeDecimal( aRecord as CFMutableDictionaryRef, name as CFStringRef, tag as long )if ( fn StringLength( fn ControlStringValue( tag ) ) > 0 ) then MutableDictionarySetObjectForKey( aRecord, fn NumberWithDouble( fn ControlDoubleValue( tag ) ), name )end fnvoid local fn BindingTakeDate( aRecord as CFMutableDictionaryRef, name as CFStringRef, tag as long )MutableDictionarySetObjectForKey( aRecord, fn DateFormatterStringFromDate( fn BindingDateFormatter, fn DatePickerDateValue( tag ) ), name )end fnvoid local fn BindingTakeTime( aRecord as CFMutableDictionaryRef, name as CFStringRef, tag as long )MutableDictionarySetObjectForKey( aRecord, fn DateFormatterStringFromDate( fn BindingFormatter( BINDING_TIME_FORMAT ), fn DatePickerDateValue( tag ) ), name )end fnvoid local fn BindingTakeDateTime( aRecord as CFMutableDictionaryRef, name as CFStringRef, tag as long )MutableDictionarySetObjectForKey( aRecord, fn DateFormatterStringFromDate( fn BindingFormatter( BINDING_DATETIME_FORMAT ), fn DatePickerDateValue( tag ) ), name )end fnvoid local fn BindingTakeCheck( aRecord as CFMutableDictionaryRef, name as CFStringRef, tag as long )MutableDictionarySetObjectForKey( aRecord, fn NumberWithBool( fn ButtonState( tag ) == NSControlStateValueOn ), name )end fn/* *   Choices: a Dropdown (a popup button) offers a value list or the rows of a lookup table; Radio *   buttons offer a short value list.  Item 0 of a Dropdown is empty: no value (NULL). * *   A Dropdown keeps, per tag, the value behind each item (gBindingChoiceKeys): the value itself *   for a value list, the parent's key for a lookup - the item shows the parent's display column. *   The value a record wants is kept too (gBindingChoiceWanted), so a lookup that arrives after the *   record (from a server) still selects it. */_bindingRadioTagBase = 100000     // radio button n of field tag t: 100000 + t * 10 + n (the XIB generator's _xibRadioTagBase).// It was 30000, and the range below took the lookups' info buttons (40000 + t) for radio buttons: their clicks// never reached the popover (2026-11-27)begin globalsCFMutableDictionaryRef gBindingChoiceKeys       // tag (as text) -> [ value of item 0, 1, ... ]CFMutableDictionaryRef gBindingChoiceWanted     // tag (as text) -> the value the record shown wantsCFMutableDictionaryRef gBindingChoiceRecords    // tag (as text) -> a lookup's rows, item 1 = row 0 (Record Popover.incl)end globalslocal fn BindingTagKey( tag as long ) as CFStringRefend fn = fn StringWithFormat( @"%ld", tag )// select the item whose value reads as wanted (item 0, no value, when none does)void local fn BindingSelectChoice( tag as long, wanted as CFStringRef )CFArrayRef keys = NULLlong       i, found = 0if ( gBindingChoiceKeys != NULL ) then keys = fn DictionaryObjectForKey( gBindingChoiceKeys, fn BindingTagKey( tag ) )if ( keys != NULL && wanted != NULL )for i = 1 to (long)fn ArrayCount( keys ) - 1if ( found == 0 )if ( fn StringIsEqual( fn StringWithFormat( @"%@", fn ArrayObjectAtIndex( keys, i ) ), wanted ) ) then found = iend ifnextend ifif ( fn PopUpButtonNumberOfItems( tag ) > found ) then PopUpButtonSelectItemAtIndex( tag, found )end fn// a Dropdown's items: titles, and the value behind each; item 0 is empty (no value)void local fn BindingSetChoices( tag as long, titles as CFArrayRef, keys as CFArrayRef )CFMutableArrayRef allTitles = fn MutableArrayNewCFMutableArrayRef allKeys = fn MutableArrayNewif ( gBindingChoiceKeys == NULL ) then gBindingChoiceKeys = (CFMutableDictionaryRef)fn DataKept( fn MutableDictionaryNew, gBindingChoiceKeys )if ( gBindingChoiceWanted == NULL ) then gBindingChoiceWanted = (CFMutableDictionaryRef)fn DataKept( fn MutableDictionaryNew, gBindingChoiceWanted )MutableArrayAddObject( allTitles, @"" )MutableArrayAddObject( allKeys, @"" )MutableArrayAddObjectsFromArray( allTitles, titles )MutableArrayAddObjectsFromArray( allKeys, keys )PopUpButtonRemoveAllItems( tag )PopUpButtonAddItemsWithTitles( tag, allTitles )MutableDictionarySetObjectForKey( gBindingChoiceKeys, allKeys, fn BindingTagKey( tag ) )fn BindingSelectChoice( tag, fn DictionaryObjectForKey( gBindingChoiceWanted, fn BindingTagKey( tag ) ) )end fn// a value list: each value is its own titlevoid local fn BindingFillChoices( tag as long, values as CFArrayRef )fn BindingSetChoices( tag, values, values )end fn// a lookup table's rows: the item shows displayName, its value is keyName (the parent's key)void local fn BindingFillLookup( tag as long, records as CFArrayRef, keyName as CFStringRef, displayName as CFStringRef )CFMutableArrayRef titles = fn MutableArrayNewCFMutableArrayRef keys = fn MutableArrayNewCFDictionaryRef   aRecordCFStringRef       titlefor aRecord in recordstitle = fn BindingString( aRecord, displayName )if ( fn StringLength( title ) == 0 ) then title = fn BindingString( aRecord, keyName )MutableArrayAddObject( titles, title )if ( fn BindingValue( aRecord, keyName ) != NULL ) then MutableArrayAddObject( keys, fn BindingValue( aRecord, keyName ) ) else MutableArrayAddObject( keys, @"" )nextfn BindingSetChoices( tag, titles, keys )if ( gBindingChoiceRecords == NULL ) then gBindingChoiceRecords = (CFMutableDictionaryRef)fn DataKept( fn MutableDictionaryNew, gBindingChoiceRecords )MutableDictionarySetObjectForKey( gBindingChoiceRecords, records, fn BindingTagKey( tag ) )   // the whole rows, for the info buttonend fn// the lookup row a Dropdown has chosen (all its columns); NULL when none is chosenlocal fn BindingChosenRecord( tag as long ) as CFDictionaryRefCFArrayRef records = NULLlong       index = fn PopUpButtonIndexOfSelectedItem( tag )if ( gBindingChoiceRecords != NULL ) then records = fn DictionaryObjectForKey( gBindingChoiceRecords, fn BindingTagKey( tag ) )if ( records == NULL || index <= 0 ) then exit fn = NULL                // item 0 is "no value"if ( index > fn ArrayCount( records ) ) then exit fn = NULLend fn = fn ArrayObjectAtIndex( records, index - 1 )void local fn BindingShowChoice( tag as long, aRecord as CFDictionaryRef, name as CFStringRef )if ( gBindingChoiceWanted == NULL ) then gBindingChoiceWanted = (CFMutableDictionaryRef)fn DataKept( fn MutableDictionaryNew, gBindingChoiceWanted )MutableDictionarySetObjectForKey( gBindingChoiceWanted, fn BindingString( aRecord, name ), fn BindingTagKey( tag ) )fn BindingSelectChoice( tag, fn BindingString( aRecord, name ) )end fn// the chosen item's value (the parent's key keeps its type: a number stays a number)void local fn BindingTakeChoice( aRecord as CFMutableDictionaryRef, name as CFStringRef, tag as long )CFArrayRef keys = NULLlong       index = fn PopUpButtonIndexOfSelectedItem( tag )if ( gBindingChoiceKeys != NULL ) then keys = fn DictionaryObjectForKey( gBindingChoiceKeys, fn BindingTagKey( tag ) )if ( keys == NULL || index <= 0 ) then exit fnif ( index < fn ArrayCount( keys ) ) then MutableDictionarySetObjectForKey( aRecord, fn ArrayObjectAtIndex( keys, index ), name )end fn// radio button n of a field (the XIB generator gives it this tag)local fn BindingRadioTag( fieldTag as long, n as long ) as longend fn = _bindingRadioTagBase + fieldTag * 10 + nvoid local fn BindingShowRadio( fieldTag as long, values as CFArrayRef, aRecord as CFDictionaryRef, name as CFStringRef )CFStringRef wanted = fn BindingString( aRecord, name )long        nfor n = 0 to (long)fn ArrayCount( values ) - 1if ( fn StringIsEqual( fn ArrayObjectAtIndex( values, n ), wanted ) ) then ButtonSetState( fn BindingRadioTag( fieldTag, n ), NSControlStateValueOn ) else ButtonSetState( fn BindingRadioTag( fieldTag, n ), NSControlStateValueOff )nextend fnvoid local fn BindingTakeRadio( aRecord as CFMutableDictionaryRef, name as CFStringRef, fieldTag as long, values as CFArrayRef )long nfor n = 0 to (long)fn ArrayCount( values ) - 1if ( fn ButtonState( fn BindingRadioTag( fieldTag, n ) ) == NSControlStateValueOn ) then MutableDictionarySetObjectForKey( aRecord, fn ArrayObjectAtIndex( values, n ), name )nextend fn// a radio button was clicked: the others of its field go off (AppKit groups radio buttons only// when they share an action).  YES when tag was a radio button.local fn BindingRadioClicked( tag as long ) as BOOLlong n, first, iif ( tag < _bindingRadioTagBase || tag >= _bindingRadioTagBase + 100000 ) then exit fn = NO   // 100000-199999: radio buttons onlyn = tag mod 10first = tag - nfor i = 0 to 9if ( first + i != tag )if ( fn ButtonExists( first + i ) ) then ButtonSetState( first + i, NSControlStateValueOff )end ifnextend fn = YES