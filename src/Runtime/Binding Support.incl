/* *   Binding Support.incl * *   Helpers for the generated <Entity> Binding.incl files. Copied unchanged into *   every generated project by Api Logic Client. * *   A record is a dictionary keyed by attribute name - a SQLite row or ALS *   attributes alike. "Show" puts a record value into a control; "Take" reads a *   control back into a record and leaves empty controls out (stored as NULL). */// how dates and times are stored: SQLite's own text forms (its date and time functions read them)#define BINDING_DATE_FORMAT     @"yyyy-MM-dd"#define BINDING_TIME_FORMAT     @"HH:mm:ss"#define BINDING_DATETIME_FORMAT @"yyyy-MM-dd HH:mm:ss"// the value for an attribute; NULL for a missing key or a JSON / SQL nulllocal fn BindingValue( aRecord as CFDictionaryRef, name as CFStringRef ) as CFTypeRefCFTypeRef valueif ( aRecord == NULL ) then exit fn = NULLvalue = fn DictionaryObjectForKey( aRecord, name )if ( value == NULL ) then exit fn = NULLif ( fn ObjectIsKindOfClass( (ObjectRef)value, fn ClassFromString( @"NSNull" ) ) ) then exit fn = NULLend fn = value// any value as text; "" for NULLlocal fn BindingString( aRecord as CFDictionaryRef, name as CFStringRef ) as CFStringRefCFTypeRef value = fn BindingValue( aRecord, name )if ( value == NULL ) then exit fn = @""if ( fn ObjectIsKindOfClass( (ObjectRef)value, fn StringClass ) ) then exit fn = (CFStringRef)valueend fn = fn StringWithFormat( @"%@", value )// a formatter for one stored form; en_US_POSIX so the user's region never changes the digitslocal fn BindingFormatter( format as CFStringRef ) as DateFormatterRefDateFormatterRef formatter = fn DateFormatterInitDateFormatterSetLocale( formatter, fn LocaleWithIdentifier( @"en_US_POSIX" ) )DateFormatterSetDateFormat( formatter, format )end fn = formatterlocal fn BindingDateFormatter as DateFormatterRefend fn = fn BindingFormatter( BINDING_DATE_FORMAT )// text -> date in the given form, reading only as many characters as the form has; NULL if unreadablelocal fn BindingParse( textValue as CFStringRef, format as CFStringRef ) as CFDateRefif ( fn StringLength( textValue ) < fn StringLength( format ) ) then exit fn = NULLend fn = fn DateFormatterDateFromString( fn BindingFormatter( format ), fn StringSubstringToIndex( textValue, fn StringLength( format ) ) )/* *   record -> control */void local fn BindingShowText( tag as long, aRecord as CFDictionaryRef, name as CFStringRef )ControlSetStringValue( tag, fn BindingString( aRecord, name ) )end fnvoid local fn BindingShowNumber( tag as long, aRecord as CFDictionaryRef, name as CFStringRef )CFTypeRef value = fn BindingValue( aRecord, name )if ( value == NULL ) then ControlSetStringValue( tag, @"" ) else ControlSetObjectValue( tag, value )end fn// "1996-07-04" or "1996-07-04 00:00:00"; today when NULL or unreadablevoid local fn BindingShowDate( tag as long, aRecord as CFDictionaryRef, name as CFStringRef )CFStringRef textValue = fn BindingString( aRecord, name )CFDateRef   dt = NULLif ( fn StringLength( textValue ) >= 10 ) then dt = fn DateFormatterDateFromString( fn BindingDateFormatter, fn StringSubstringToIndex( textValue, 10 ) )if ( dt == NULL ) then dt = fn DateInitDatePickerSetDateValue( tag, dt )end fn// "14:30:00" or "14:30"; now when NULL or unreadablevoid local fn BindingShowTime( tag as long, aRecord as CFDictionaryRef, name as CFStringRef )CFStringRef textValue = fn BindingString( aRecord, name )CFDateRef   dt = fn BindingParse( textValue, BINDING_TIME_FORMAT )if ( dt == NULL ) then dt = fn BindingParse( textValue, @"HH:mm" )if ( dt == NULL ) then dt = fn DateInitDatePickerSetDateValue( tag, dt )end fn// "1996-07-04 14:30:00", or a date alone (midnight); now when NULL or unreadablevoid local fn BindingShowDateTime( tag as long, aRecord as CFDictionaryRef, name as CFStringRef )CFStringRef textValue = fn StringByReplacingOccurrencesOfString( fn BindingString( aRecord, name ), @"T", @" " )   // ISO 8601's TCFDateRef   dt = fn BindingParse( textValue, BINDING_DATETIME_FORMAT )if ( dt == NULL ) then dt = fn BindingParse( textValue, BINDING_DATE_FORMAT )if ( dt == NULL ) then dt = fn DateInitDatePickerSetDateValue( tag, dt )end fnvoid local fn BindingShowCheck( tag as long, aRecord as CFDictionaryRef, name as CFStringRef )CFStringRef textValue = fn StringLowercaseString( fn BindingString( aRecord, name ) )if ( fn StringIsEqual( textValue, @"1" ) || fn StringIsEqual( textValue, @"true" ) || fn StringIsEqual( textValue, @"yes" ) ) then ButtonSetState( tag, NSControlStateValueOn ) else ButtonSetState( tag, NSControlStateValueOff )end fn/* *   control -> record (empty controls are left out) */void local fn BindingTakeText( aRecord as CFMutableDictionaryRef, name as CFStringRef, tag as long )CFStringRef textValue = fn ControlStringValue( tag )if ( fn StringLength( textValue ) > 0 ) then MutableDictionarySetObjectForKey( aRecord, textValue, name )end fnvoid local fn BindingTakeInteger( aRecord as CFMutableDictionaryRef, name as CFStringRef, tag as long )if ( fn StringLength( fn ControlStringValue( tag ) ) > 0 ) then MutableDictionarySetObjectForKey( aRecord, fn NumberWithInteger( fn ControlIntegerValue( tag ) ), name )end fnvoid local fn BindingTakeDecimal( aRecord as CFMutableDictionaryRef, name as CFStringRef, tag as long )if ( fn StringLength( fn ControlStringValue( tag ) ) > 0 ) then MutableDictionarySetObjectForKey( aRecord, fn NumberWithDouble( fn ControlDoubleValue( tag ) ), name )end fnvoid local fn BindingTakeDate( aRecord as CFMutableDictionaryRef, name as CFStringRef, tag as long )MutableDictionarySetObjectForKey( aRecord, fn DateFormatterStringFromDate( fn BindingDateFormatter, fn DatePickerDateValue( tag ) ), name )end fnvoid local fn BindingTakeTime( aRecord as CFMutableDictionaryRef, name as CFStringRef, tag as long )MutableDictionarySetObjectForKey( aRecord, fn DateFormatterStringFromDate( fn BindingFormatter( BINDING_TIME_FORMAT ), fn DatePickerDateValue( tag ) ), name )end fnvoid local fn BindingTakeDateTime( aRecord as CFMutableDictionaryRef, name as CFStringRef, tag as long )MutableDictionarySetObjectForKey( aRecord, fn DateFormatterStringFromDate( fn BindingFormatter( BINDING_DATETIME_FORMAT ), fn DatePickerDateValue( tag ) ), name )end fnvoid local fn BindingTakeCheck( aRecord as CFMutableDictionaryRef, name as CFStringRef, tag as long )MutableDictionarySetObjectForKey( aRecord, fn NumberWithBool( fn ButtonState( tag ) == NSControlStateValueOn ), name )end fn