// DataObject.glbl is included ahead of this file in data.fbprojinclude "NSLog.incl"/* * Table, column and alias names are quoted in the generated SQL, so reserved words * (Order, Group) and names with spaces work:  Order -> "Order",  a.id -> "a"."id". * A name that is already quoted ('Given Name', "x", [x], `x`) is used as given. */local fn QuoteSQLName( name as StringRef ) as StringRefArrayRef         partsStringRef        part, firstMutableStringRef quotedif ( name == NULL ) then exit fn = @"\"\""if ( fn StringLength( name ) == 0 ) then exit fn = @"\"\""first = fn StringSubstringToIndex( name, 1 )if ( fn StringIsEqual( first, @"\"" ) || fn StringIsEqual( first, @"'" ) || fn StringIsEqual( first, @"[" ) || fn StringIsEqual( first, @"`" ) ) then exit fn = nameparts  = fn StringComponentsSeparatedByString( name, @"." )quoted = fn MutableStringNewfor part in partsif ( fn StringLength( quoted ) > 0 ) then MutableStringAppendString( quoted, @"." )MutableStringAppendString( quoted, fn StringWithFormat( @"\"%@\"", fn StringByReplacingOccurrencesOfString( part, @"\"", @"\"\"" ) ) )nextend fn = quoted/* * Select Query Builder * Supporting Functions * * */local modedim as MutableArrayRef     selectfilterArrayReflocal fn GetSelectFilterArray( queryDictionaryRef as MutableDictionaryRef ) as MutableArrayRefif ( ( fn DictionaryObjectForKey( queryDictionaryRef, @"filter" ) != NULL ) )selectfilterArrayRef = (MutableArrayRef)fn DictionaryObjectForKey( queryDictionaryRef, @"filter" )end ifend fn = selectfilterArrayReflocal modedim as MutableArrayRef     metadataArrayReflocal fn InitMetadataArray( queryDictionaryRef as MutableDictionaryRef )metadataArrayRef = fn MutableArrayNewMutableDictionarySetObjectForKey( queryDictionaryRef, metadataArrayRef, @"metadata" )end fnlocal modedim as MutableArrayRef     selecttablesArrayReflocal fn InitTablesArray( queryDictionaryRef as MutableDictionaryRef )selecttablesArrayRef = fn MutableArrayNewMutableDictionarySetObjectForKey( queryDictionaryRef, selecttablesArrayRef, @"selecttables" )end fnlocal modedim as MutableArrayRef     selectcolsArrayReflocal fn InitColumnsArray( queryDictionaryRef as MutableDictionaryRef )selectcolsArrayRef = fn MutableArrayNewMutableDictionarySetObjectForKey( queryDictionaryRef, selectcolsArrayRef, @"selectcols" )end fnlocal modedim as MutableDictionaryRef     associationsDictionaryReflocal fn InitAssociationsDictionary( queryDictionaryRef as MutableDictionaryRef )associationsDictionaryRef = fn MutableDictionaryNewMutableDictionarySetObjectForKey( queryDictionaryRef, associationsDictionaryRef, @"associations" )end fnlocal modedim as MutableArrayRef     selectfilterArrayReflocal fn InitFilterArray( queryDictionaryRef as MutableDictionaryRef )selectfilterArrayRef = fn MutableArrayNewMutableDictionarySetObjectForKey( queryDictionaryRef, selectfilterArrayRef, @"filter" )end fnlocal modedim as MutableDictionaryRef     resultsDictionaryReflocal fn InitResultsDictionary( queryDictionaryRef as MutableDictionaryRef )resultsDictionaryRef = fn MutableDictionaryNewMutableDictionarySetObjectForKey( queryDictionaryRef, resultsDictionaryRef, @"results" )end fnlocal modedim as MutableDictionaryRef   queryDictionaryReflocal fn InitQueryDictionary as MutableDictionaryRef/*  Setup the Dictionary with an empty results array */queryDictionaryRef = fn MutableDictionaryNewfn InitMetadataArray( queryDictionaryRef )fn InitColumnsArray( queryDictionaryRef )fn InitTablesArray( queryDictionaryRef )fn InitAssociationsDictionary( queryDictionaryRef )fn InitFilterArray( queryDictionaryRef )fn InitResultsDictionary( queryDictionaryRef )end fn = queryDictionaryReflocal modedim as MutableArrayRef        selecttablesArrayRefdim as MutableDictionaryRef   tableDictionaryReflocal fn AddTableToQuery( queryDictionaryRef as MutableDictionaryRef, tableName as StringRef, aliasName as StringRef )if ( ( fn DictionaryObjectForKey( queryDictionaryRef, @"selecttables" ) != NULL ) )selecttablesArrayRef = (MutableArrayRef)fn DictionaryObjectForKey( queryDictionaryRef, @"selecttables" )tableDictionaryRef = fn MutableDictionaryNewif ( tableName != NULL ) then MutableDictionarySetObjectForKey( tableDictionaryRef, tableName, @"tablename" )if ( aliasName != NULL ) then MutableDictionarySetObjectForKey( tableDictionaryRef, aliasName, @"aliasname" )MutableArrayAddObject( selecttablesArrayRef, tableDictionaryRef )end ifend fnlocal modedim as MutableArrayRef        selectcolsArrayRefdim as MutableDictionaryRef   columnDictionaryReflocal fn AddColumnToQuery( queryDictionaryRef as MutableDictionaryRef, columnName as StringRef, aliasName as StringRef)if ( ( fn DictionaryObjectForKey( queryDictionaryRef, @"selectcols" ) != NULL ) )selectcolsArrayRef = (MutableArrayRef)fn DictionaryObjectForKey( queryDictionaryRef, @"selectcols" )columnDictionaryRef = fn MutableDictionaryNewif ( columnName != NULL ) then MutableDictionarySetObjectForKey( columnDictionaryRef, columnName, @"columnname" )if ( aliasName != NULL ) then MutableDictionarySetObjectForKey( columnDictionaryRef, aliasName, @"aliasname" )MutableArrayAddObject( selectcolsArrayRef, columnDictionaryRef )end ifend fn/*Operator           Meaninga = b              a is equal to ba != b             a is not equal to ba < b              a is less than ba > b              a is greater than ba <= b             a is less than or equal to ba >= b             a is greater than or equal to ba IN (b, c)        a is equal to either b or ca NOT IN (b, c)    a is equal to neither b nor c*/local modedim as MutableArrayRef        selectfilterArrayRefdim as MutableDictionaryRef   filterDictionaryRef// value may be a StringRef, a NumberRef or NSNulllocal fn AddFilterToQuery( queryDictionaryRef as MutableDictionaryRef, tableAlias as StringRef, columnName as StringRef, value as CFTypeRef, type as long, numType as long, operator as long, logic as long )if ( ( fn DictionaryObjectForKey( queryDictionaryRef, @"filter" ) != NULL ) )selectfilterArrayRef = (MutableArrayRef)fn DictionaryObjectForKey( queryDictionaryRef, @"filter" )filterDictionaryRef = fn MutableDictionaryNewif ( tableAlias != NULL ) then MutableDictionarySetObjectForKey( filterDictionaryRef, tableAlias, @"tablealias" )if ( columnName != NULL ) then MutableDictionarySetObjectForKey( filterDictionaryRef, columnName, @"columnname" )if value != NULL then MutableDictionarySetObjectForKey( filterDictionaryRef, value, @"value" )MutableDictionarySetObjectForKey( filterDictionaryRef, fn NumberWithInteger( type ), @"type" )if numType > 0 then MutableDictionarySetObjectForKey( filterDictionaryRef, fn NumberWithInteger( numType ), @"numType" )MutableDictionarySetObjectForKey( filterDictionaryRef, fn NumberWithInteger( operator ), @"operator" )if logic > 0 then MutableDictionarySetObjectForKey( filterDictionaryRef, fn NumberWithInteger( logic ), @"logic" )MutableArrayAddObject( selectfilterArrayRef, filterDictionaryRef )end ifend fn/*Operator           Meaninga = b              a is equal to ba != b             a is not equal to ba < b              a is less than ba > b              a is greater than ba <= b             a is less than or equal to ba >= b             a is greater than or equal to ba IN (b, c)        a is equal to either b or ca NOT IN (b, c)    a is equal to neither b nor c*/local modedim as MutableArrayRef        selectassociationsArrayRefdim as MutableDictionaryRef   associationDictionaryReflocal fn AddAssociationToQuery( queryDictionaryRef as MutableDictionaryRef, leftTableAlias as StringRef, leftColumnName as StringRef, rightTableAlias as StringRef, rightColumnName as StringRef, operator as long )if ( ( fn DictionaryObjectForKey( queryDictionaryRef, @"associations" ) != NULL ) )selectassociationsArrayRef = (MutableArrayRef)fn DictionaryObjectForKey( queryDictionaryRef, @"associations" )associationDictionaryRef = fn MutableDictionaryNewif ( leftTableAlias != NULL ) then MutableDictionarySetObjectForKey( associationDictionaryRef, leftTableAlias, @"lefttablealias" )if ( leftColumnName != NULL ) then MutableDictionarySetObjectForKey( associationDictionaryRef, leftColumnName, @"leftcolumnname" )if ( rightTableAlias != NULL ) then MutableDictionarySetObjectForKey( associationDictionaryRef, rightTableAlias, @"righttablealias" )if ( rightColumnName != NULL ) then MutableDictionarySetObjectForKey( associationDictionaryRef, rightColumnName, @"rightcolumnname" )MutableDictionarySetObjectForKey( associationDictionaryRef, fn NumberWithInteger( operator ), @"operator" )MutableArrayAddObject( selectassociationsArrayRef, associationDictionaryRef )end ifend fn/* * Types *dim as CFTypeID  typeIDtypeID = fn CFGetTypeID( thingOfUnknownType )select typeID  case fn CFStringGetTypeID()    fn DoSomethingWithString( thingOfUnknownType )  case fn CFDateGetTypeID()    fn DoSomethingWithDate( thingOfUnknownType )  case fn CFNumberGetTypeID()    fn DoSomethingWithNumber( thingOfUnknownType )  case else    stop "Oops"end select*//* * Insert / Update / Delete Builders * Supporting Functions * * Same pattern as the Select builder: describe the statement in a dictionary, * GenerateInsertIntoSQL / GenerateUpdateSQL / GenerateDeleteFromSQL (DataObject.incl) * turn it into parameterized SQL, and BuildPreparedStatement (SQLite Interface.incl) * binds the values in the same order as the ? placeholders. * *   insert dictionary  ( fn InitInsertIntoDictionary ) *        |___ insertintotable   <-- table name *        |___ columnvalues      <-- ordered array of { columnname, value, type } * *   update dictionary  ( fn InitUpdateDictionary ) *        |___ updatetable       <-- table name *        |___ columnvalues      <-- ordered array of { columnname, value, type }  ( SET ... ) *        |___ filter            <-- WHERE, added with fn AddFilterToQuery ( table alias is ignored ) * *   delete dictionary  ( fn InitDeleteFromDictionary ) *        |___ deletefromtable   <-- table name *        |___ filter            <-- WHERE, added with fn AddFilterToQuery ( table alias is ignored ) * * type is one of _nullType, _integerType, _realType, _textType, _blobType (DataObject.glbl). * value may be a StringRef or a NumberRef; NULL (or _nullType) writes SQL NULL. * * Storage Class & Description * 1 NULL    The value is a NULL value. * 2 INTEGER The value is a signed integer, stored in 1, 2, 3, 4, 6, or 8 bytes depending on the magnitude of the value. * 3 REAL    The value is a floating point value, stored as an 8-byte IEEE floating point number. * 4 TEXT    The value is a text string, stored using the database encoding (UTF-8, UTF-16BE or UTF-16LE) * 5 BLOB    The value is a blob of data, stored exactly as it was input. */local fn InitWriteDictionary( tableKey as StringRef, withFilter as BOOL ) as MutableDictionaryRefMutableDictionaryRef writeDictionaryRef = fn MutableDictionaryNewMutableDictionarySetObjectForKey( writeDictionaryRef, fn MutableStringNew, tableKey )MutableDictionarySetObjectForKey( writeDictionaryRef, fn MutableArrayNew, @"columnvalues" )if ( withFilter ) then MutableDictionarySetObjectForKey( writeDictionaryRef, fn MutableArrayNew, @"filter" )end fn = writeDictionaryReflocal fn InitInsertIntoDictionary as MutableDictionaryRefend fn = fn InitWriteDictionary( @"insertintotable", NO )local fn InitUpdateDictionary as MutableDictionaryRefend fn = fn InitWriteDictionary( @"updatetable", YES )local fn InitDeleteFromDictionary as MutableDictionaryRefend fn = fn InitWriteDictionary( @"deletefromtable", YES )void local fn SetWriteTable( writeDictionaryRef as MutableDictionaryRef, tableKey as StringRef, tableName as StringRef )MutableStringRef tableStringRef = (MutableStringRef)fn DictionaryObjectForKey( writeDictionaryRef, tableKey )if ( tableStringRef != NULL ) then MutableStringSetString( tableStringRef, tableName )end fnvoid local fn AddTableToInsert( insertDictionaryRef as MutableDictionaryRef, tableName as StringRef )fn SetWriteTable( insertDictionaryRef, @"insertintotable", tableName )end fnvoid local fn AddTableToUpdate( updateDictionaryRef as MutableDictionaryRef, tableName as StringRef )fn SetWriteTable( updateDictionaryRef, @"updatetable", tableName )end fnvoid local fn AddTableToDelete( deleteDictionaryRef as MutableDictionaryRef, tableName as StringRef )fn SetWriteTable( deleteDictionaryRef, @"deletefromtable", tableName )end fn// one { columnname, value, type } entry, in the order the columns appear in the SQLvoid local fn AddColumnValue( writeDictionaryRef as MutableDictionaryRef, columnName as StringRef, columnValue as CFTypeRef, columnType as long )MutableArrayRef      columnValuesArrayRef = (MutableArrayRef)fn DictionaryObjectForKey( writeDictionaryRef, @"columnvalues" )MutableDictionaryRef columnDictionaryRefif ( columnValuesArrayRef == NULL ) then exit fncolumnDictionaryRef = fn MutableDictionaryNewif ( columnName != NULL ) then MutableDictionarySetObjectForKey( columnDictionaryRef, columnName, @"columnname" )MutableDictionarySetObjectForKey( columnDictionaryRef, fn NumberWithInteger( columnType ), @"type" )if ( columnValue != NULL ) then MutableDictionarySetObjectForKey( columnDictionaryRef, columnValue, @"value" )MutableArrayAddObject( columnValuesArrayRef, columnDictionaryRef )end fnvoid local fn AddColumnToInsert( insertDictionaryRef as MutableDictionaryRef, columnName as StringRef, columnValue as CFTypeRef, columnType as long )fn AddColumnValue( insertDictionaryRef, columnName, columnValue, columnType )end fnvoid local fn AddColumnToUpdate( updateDictionaryRef as MutableDictionaryRef, columnName as StringRef, columnValue as CFTypeRef, columnType as long )fn AddColumnValue( updateDictionaryRef, columnName, columnValue, columnType )end fn