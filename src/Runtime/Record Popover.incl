/* *   I M A G E R Y    B U S I N E S S     S Y S T E M S,   L L C * *   Record Popover.incl - runtime: a related record's details in a popover * *   Every Dropdown that picks a parent record (a lookup: Order's Customer, Employee's Department) *   has a small info button beside it (the XIB generator puts it there, tag _lookupInfoTagBase + *   the field's tag).  Clicking it shows the chosen parent's fields - their titles and values - in *   a popover next to the button; a click anywhere else closes it.  The rows come from the lookup *   the Dropdown was filled with (Binding Support.incl: BindingChosenRecord), so nothing is read *   again and it works the same in both editions. * *   <Entity>FormSetUp (the generated binding) registers each lookup: *       fn RecordPopoverRegister( fieldTag, @"Customer", @[ names ], @[ titles ] ) *   and App Pages.incl passes button clicks to RecordPopoverClicked first. */_lookupInfoTagBase     = 40000      // info button of field tag t: 40000 + t (the XIB generator's _xibLookupInfoTagBase)_recordPopover         = 62900      // the popover (a popover's tag is apart from the windows' and controls')_recordPopoverHeading  = 1          // inside the popover: the heading,_recordPopoverNameBase = 100        // ... a field's title (row n: 100 + n)_recordPopoverValueBase = 200       // ... and its value (row n: 200 + n)_recordPopoverRows     = 16         // at most this many fields are shown_recordPopoverWidth    = 360_recordPopoverRowHeight = 20begin globalsCFMutableDictionaryRef gRecordPopoverLookups     // info button tag (as text) -> { entity, names, titles, fieldTag }end globals// a lookup's info button: what it shows (the parent's fields, in the model's order, with their titles)void local fn RecordPopoverRegister( fieldTag as long, entity as CFStringRef, names as CFArrayRef, titles as CFArrayRef )long infoTag = _lookupInfoTagBase + fieldTagif ( gRecordPopoverLookups == NULL ) then gRecordPopoverLookups = (CFMutableDictionaryRef)fn DataKept( fn MutableDictionaryNew, gRecordPopoverLookups )MutableDictionarySetObjectForKey( gRecordPopoverLookups, @{ @"entity":entity, @"names":names, @"titles":titles, @"fieldTag":fn NumberWithInteger( fieldTag ) }, fn StringWithFormat( @"%ld", infoTag ) )ButtonSetBordered( infoTag, NO )ButtonSetImage( infoTag, fn ImageWithSystemSymbolName( @"info.circle", @"Details" ) )ButtonSetContentTintColor( infoTag, fn ColorSecondaryLabel )ViewSetToolTip( infoTag, fn StringWithFormat( @"Show the %@'s details", entity ) )end fn// the popover, made once: a heading and a title / value pair per rowvoid local fn RecordPopoverBuildlong iif ( fn PopoverExists( _recordPopover ) ) then exit fnpopover _recordPopover, fn CGRectMake( 0, 0, _recordPopoverWidth, 100 ), NSPopoverBehaviorTransienttextlabel _recordPopoverHeading, @"", fn CGRectMake( 14, 70, _recordPopoverWidth - 28, 20 )ControlSetFont( _recordPopoverHeading, fn FontBoldSystemFontOfSize( 13.0 ) )for i = 0 to _recordPopoverRows - 1textlabel _recordPopoverNameBase + i, @"", fn CGRectMake( 14, 0, 120, 16 )ControlSetAlignment( _recordPopoverNameBase + i, NSTextAlignmentRight )TextFieldSetTextColor( _recordPopoverNameBase + i, fn ColorSecondaryLabel )textlabel _recordPopoverValueBase + i, @"", fn CGRectMake( 142, 0, _recordPopoverWidth - 156, 16 )TextFieldSetSelectable( _recordPopoverValueBase + i, YES )             // a value can be copiednextwindow _shellWindow                                                      // later controls go to the window againend fn// show aRecord's fields (names, with titles) under heading, beside the view anchorTagvoid local fn RecordPopoverShow( anchorTag as long, heading as CFStringRef, aRecord as CFDictionaryRef, names as CFArrayRef, titles as CFArrayRef )long        rows = fn ArrayCount( names ), iCGFloat     height, yCFStringRef valueTextif ( rows > _recordPopoverRows ) then rows = _recordPopoverRowsfn RecordPopoverBuildheight = 14 + 22 + 8 + rows * _recordPopoverRowHeight + 10textlabel _recordPopoverHeading, heading, fn CGRectMake( 14, height - 14 - 20, _recordPopoverWidth - 28, 20 ), _recordPopoverfor i = 0 to _recordPopoverRows - 1y = height - 14 - 22 - 8 - ( i + 1 ) * _recordPopoverRowHeight + 4if ( i < rows )valueText = fn BindingString( aRecord, fn ArrayObjectAtIndex( names, i ) )if ( fn StringLength( valueText ) == 0 ) then valueText = @"—"textlabel _recordPopoverNameBase + i, fn StringWithFormat( @"%@:", fn ArrayObjectAtIndex( titles, i ) ), fn CGRectMake( 14, y, 120, 16 ), _recordPopovertextlabel _recordPopoverValueBase + i, valueText, fn CGRectMake( 142, y, _recordPopoverWidth - 156, 16 ), _recordPopoverelsetextlabel _recordPopoverNameBase + i, @"", fn CGRectMake( 14, 0, 120, 16 ), _recordPopovertextlabel _recordPopoverValueBase + i, @"", fn CGRectMake( 142, 0, _recordPopoverWidth - 156, 16 ), _recordPopoverend ifnextPopoverSetContentSize( _recordPopover, fn CGSizeMake( _recordPopoverWidth, height ) )window _shellWindowPopoverShow( _recordPopover, CGRectZero, anchorTag, CGRectMaxXEdge )end fn// a button was clicked: YES when it was a lookup's info button (the chosen parent is shown)local fn RecordPopoverClicked( tag as long ) as BOOLCFDictionaryRef lookup, aRecordlong            fieldTagif ( gRecordPopoverLookups == NULL ) then exit fn = NOlookup = fn DictionaryObjectForKey( gRecordPopoverLookups, fn StringWithFormat( @"%ld", tag ) )if ( lookup == NULL ) then exit fn = NOfieldTag = fn NumberIntegerValue( fn DictionaryObjectForKey( lookup, @"fieldTag" ) )aRecord  = fn BindingChosenRecord( fieldTag )if ( aRecord == NULL )fn RecordPopoverShow( tag, fn StringWithFormat( @"No %@ chosen", fn DictionaryObjectForKey( lookup, @"entity" ) ), @{}, @[], @[] )exit fn = YESend iffn RecordPopoverShow( tag, fn StringWithFormat( @"%@: %@", fn DictionaryObjectForKey( lookup, @"entity" ), fn PopUpButtonTitleOfSelectedItem( fieldTag ) ), aRecord, fn DictionaryObjectForKey( lookup, @"names" ), fn DictionaryObjectForKey( lookup, @"titles" ) )end fn = YES