/* *   I M A G E R Y    B U S I N E S S     S Y S T E M S,   L L C * *   Record Popover.incl - runtime: a related record's details in a popover * *   Every Dropdown or auto-complete that picks a parent record (a lookup: Order's Customer, Employee's Department) *   has a small info button beside it (the XIB generator puts it there, tag _lookupInfoTagBase + *   the field's tag).  It is on only while a parent is chosen (RecordPopoverRefresh; an auto-complete turns its own *   on and off, Auto Complete.incl); with nothing chosen there is nothing to show.  Clicking it shows the chosen parent's fields - their titles and values - in *   a popover next to the button; a click anywhere else closes it.  The rows come from the lookup *   the Dropdown was filled with (Binding Support.incl: BindingChosenRecord), so nothing is read *   again and it works the same in both editions. * *   <Entity>FormSetUp (the generated binding) registers each lookup: *       fn RecordPopoverRegister( fieldTag, @"Customer", @[ names ], @[ titles ] ) *   and App Pages.incl passes button clicks to RecordPopoverClicked first. * *   Every view here is reached through Cocoa (ShellFindView), never FB's tag functions: FB looks only in its current *   output window, which is not always the app's when an event arrives ("View does not exist", 2026-11-27). */_lookupInfoTagBase     = 40000      // info button of field tag t: 40000 + t (the XIB generator's _xibLookupInfoTagBase)_recordPopoverRows     = 16         // at most this many fields are shownbegin globalsCFMutableDictionaryRef gRecordPopoverLookups     // info button tag (as text) -> { entity, names, titles, fieldTag }end globals// a lookup's info button: what it shows (the parent's fields, in the model's order, with their titles).  It starts// off: RecordPopoverRefresh turns it on when a parent is chosen.void local fn RecordPopoverRegister( fieldTag as long, entity as CFStringRef, names as CFArrayRef, titles as CFArrayRef )long    infoTag = _lookupInfoTagBase + fieldTagViewRef infoView = fn ShellFindView( infoTag )if ( gRecordPopoverLookups == NULL ) then gRecordPopoverLookups = (CFMutableDictionaryRef)fn DataKept( fn MutableDictionaryNew, gRecordPopoverLookups )MutableDictionarySetObjectForKey( gRecordPopoverLookups, @{ @"entity":entity, @"names":names, @"titles":titles, @"fieldTag":fn NumberWithInteger( fieldTag ) }, fn StringWithFormat( @"%ld", infoTag ) )if ( infoView == NULL ) then exit fncln if ( [(__bridge id)infoView isKindOfClass:[NSButton class]] ) { NSButton *info = (__bridge NSButton *)infoView; info.bordered = NO; info.image = [NSImage imageWithSystemSymbolName:@"info.circle" accessibilityDescription:@"Details"]; info.contentTintColor = NSColor.secondaryLabelColor; info.toolTip = [NSString stringWithFormat:@"Show the %@'s details", (__bridge NSString *)entity]; info.enabled = NO; }end fn// the parent record chosen in a lookup field (an auto-complete or a Dropdown); NULL when none islocal fn RecordPopoverChosen( fieldTag as long ) as CFDictionaryRefCFArrayRef records = NULLlong       itemIndex = -1ViewRef    fieldViewif ( fn AutoCompleteIsField( fieldTag ) ) then exit fn = fn AutoCompleteChosenRecord( fieldTag )fieldView = fn ShellFindView( fieldTag )if ( fieldView == NULL ) then exit fn = NULLcln if ( [(__bridge id)fieldView isKindOfClass:[NSPopUpButton class]] ) itemIndex = [(__bridge NSPopUpButton *)fieldView indexOfSelectedItem];if ( gBindingChoiceRecords != NULL ) then records = fn DictionaryObjectForKey( gBindingChoiceRecords, fn BindingTagKey( fieldTag ) )if ( records == NULL || itemIndex <= 0 ) then exit fn = NULL                 // item 0 is "no value"if ( itemIndex > fn ArrayCount( records ) ) then exit fn = NULLend fn = fn ArrayObjectAtIndex( records, itemIndex - 1 )// what the field shows for its choice: the Dropdown's title, or the auto-complete's textlocal fn RecordPopoverChosenTitle( fieldTag as long ) as CFStringRefCFStringRef chosenTitle = @""ViewRef     fieldView = fn ShellFindView( fieldTag )if ( fieldView == NULL ) then exit fn = @""cln id v = (__bridge id)fieldView; if ( [v isKindOfClass:[NSPopUpButton class]] ) chosenTitle = (__bridge CFStringRef)[(NSPopUpButton *)v titleOfSelectedItem]; else if ( [v isKindOfClass:[NSTextField class]] ) chosenTitle = (__bridge CFStringRef)[(NSTextField *)v stringValue];if ( chosenTitle == NULL ) then chosenTitle = @""end fn = chosenTitle// every info button on only while its field has a parent chosen (author, 2026-11-27: "If no related record is chosen// disable the info button so that you never see the dialogue.").  App Pages.incl calls it after a record is shown, after// a lookup's rows arrive and after a click (a Dropdown's choice); an auto-complete does its own (Auto Complete.incl).void local fn RecordPopoverRefreshCFArrayRef      keysCFDictionaryRef lookupViewRef         infoViewlong            i, fieldTagBOOL            hasChoiceif ( gRecordPopoverLookups == NULL ) then exit fnkeys = fn DictionaryAllKeys( gRecordPopoverLookups )if ( fn ArrayCount( keys ) == 0 ) then exit fnfor i = 0 to (long)fn ArrayCount( keys ) - 1lookup    = fn DictionaryObjectForKey( gRecordPopoverLookups, fn ArrayObjectAtIndex( keys, i ) )fieldTag  = fn NumberIntegerValue( fn DictionaryObjectForKey( lookup, @"fieldTag" ) )hasChoice = ( fn RecordPopoverChosen( fieldTag ) != NULL )infoView  = fn ShellFindView( _lookupInfoTagBase + fieldTag )if ( infoView != NULL )cln if ( [(__bridge id)infoView isKindOfClass:[NSButton class]] ) ((__bridge NSButton *)infoView).enabled = hasChoice;end ifnextend fn// show aRecord's fields (names, with titles) under heading, in a popover beside the view anchorTag. The popover is// made in Cocoa, anchored to the button itself: no FB tags inside it to look up ("View does not exist", 2026-11-27).void local fn RecordPopoverShow( anchorTag as long, heading as CFStringRef, aRecord as CFDictionaryRef, names as CFArrayRef, titles as CFArrayRef )long              rows = fn ArrayCount( names ), iCFMutableArrayRef labels = fn MutableArrayNew, values = fn MutableArrayNewCFStringRef       valueTextViewRef           anchor = fn ShellFindView( anchorTag )if ( anchor == NULL ) then exit fnif ( rows > _recordPopoverRows ) then rows = _recordPopoverRowsfor i = 0 to rows - 1valueText = fn BindingString( aRecord, fn ArrayObjectAtIndex( names, i ) )if ( fn StringLength( valueText ) == 0 ) then valueText = @"-"MutableArrayAddObject( labels, fn StringWithFormat( @"%@:", fn ArrayObjectAtIndex( titles, i ) ) )MutableArrayAddObject( values, valueText )nextcln static NSPopover *recordPopover = nil; [recordPopover close]; NSView *anchorView = (__bridge NSView *)anchor; NSTextField *title = [NSTextField labelWithString:(__bridge NSString *)heading]; title.font = [NSFont boldSystemFontOfSize:13.0]; NSMutableArray *gridRows = [NSMutableArray array]; NSArray *ls = (__bridge NSArray *)labels, *vs = (__bridge NSArray *)values; for ( NSUInteger r = 0; r < ls.count; r++ ) { NSTextField *l = [NSTextField labelWithString:ls[r]]; l.textColor = NSColor.secondaryLabelColor; l.alignment = NSTextAlignmentRight; NSTextField *v = [NSTextField labelWithString:vs[r]]; v.selectable = YES; v.lineBreakMode = NSLineBreakByTruncatingTail; [v.widthAnchor constraintLessThanOrEqualToConstant:260].active = YES; [gridRows addObject:@[ l, v ]]; } NSGridView *grid = [NSGridView gridViewWithViews:gridRows]; grid.rowSpacing = 5; grid.columnSpacing = 10; if ( grid.numberOfColumns > 0 ) [grid columnAtIndex:0].xPlacement = NSGridCellPlacementTrailing; NSStackView *stack = [NSStackView stackViewWithViews:@[ title, grid ]]; stack.orientation = NSUserInterfaceLayoutOrientationVertical; stack.alignment = NSLayoutAttributeLeading; stack.spacing = 10; stack.edgeInsets = NSEdgeInsetsMake( 14, 16, 14, 16 ); NSViewController *content = [[NSViewController alloc] init]; content.view = stack; recordPopover = [[NSPopover alloc] init]; recordPopover.behavior = NSPopoverBehaviorTransient; recordPopover.contentViewController = content; recordPopover.contentSize = stack.fittingSize; [recordPopover showRelativeToRect:anchorView.bounds ofView:anchorView preferredEdge:NSRectEdgeMaxX];end fn// a button was clicked: YES when it was a lookup's info button (the chosen parent is shown).  The button is off with// nothing chosen, so a click always has a parent to show.local fn RecordPopoverClicked( tag as long ) as BOOLCFDictionaryRef lookup, aRecordlong            fieldTagif ( gRecordPopoverLookups == NULL ) then exit fn = NOlookup = fn DictionaryObjectForKey( gRecordPopoverLookups, fn StringWithFormat( @"%ld", tag ) )if ( lookup == NULL ) then exit fn = NOfieldTag = fn NumberIntegerValue( fn DictionaryObjectForKey( lookup, @"fieldTag" ) )aRecord  = fn RecordPopoverChosen( fieldTag )if ( aRecord == NULL ) then exit fn = YES                                       // nothing chosen: nothing to showfn RecordPopoverShow( tag, fn StringWithFormat( @"%@: %@", fn DictionaryObjectForKey( lookup, @"entity" ), fn RecordPopoverChosenTitle( fieldTag ) ), aRecord, fn DictionaryObjectForKey( lookup, @"names" ), fn DictionaryObjectForKey( lookup, @"titles" ) )end fn = YES