/* *   I M A G E R Y    B U S I N E S S     S Y S T E M S,   L L C * *   Record Popover.incl - runtime: a related record's details in a popover * *   Every Dropdown or auto-complete that picks a parent record (a lookup: Order's Customer, Employee's Department) *   has a small info button beside it (the XIB generator puts it there, tag _lookupInfoTagBase + *   the field's tag).  Clicking it shows the chosen parent's fields - their titles and values - in *   a popover next to the button; a click anywhere else closes it.  The rows come from the lookup *   the Dropdown was filled with (Binding Support.incl: BindingChosenRecord), so nothing is read *   again and it works the same in both editions. * *   <Entity>FormSetUp (the generated binding) registers each lookup: *       fn RecordPopoverRegister( fieldTag, @"Customer", @[ names ], @[ titles ] ) *   and App Pages.incl passes button clicks to RecordPopoverClicked first. */_lookupInfoTagBase     = 40000      // info button of field tag t: 40000 + t (the XIB generator's _xibLookupInfoTagBase)_recordPopoverRows     = 16         // at most this many fields are shownbegin globalsCFMutableDictionaryRef gRecordPopoverLookups     // info button tag (as text) -> { entity, names, titles, fieldTag }end globals// a lookup's info button: what it shows (the parent's fields, in the model's order, with their titles)void local fn RecordPopoverRegister( fieldTag as long, entity as CFStringRef, names as CFArrayRef, titles as CFArrayRef )long infoTag = _lookupInfoTagBase + fieldTagif ( gRecordPopoverLookups == NULL ) then gRecordPopoverLookups = (CFMutableDictionaryRef)fn DataKept( fn MutableDictionaryNew, gRecordPopoverLookups )MutableDictionarySetObjectForKey( gRecordPopoverLookups, @{ @"entity":entity, @"names":names, @"titles":titles, @"fieldTag":fn NumberWithInteger( fieldTag ) }, fn StringWithFormat( @"%ld", infoTag ) )ButtonSetBordered( infoTag, NO )ButtonSetImage( infoTag, fn ImageWithSystemSymbolName( @"info.circle", @"Details" ) )ButtonSetContentTintColor( infoTag, fn ColorSecondaryLabel )ViewSetToolTip( infoTag, fn StringWithFormat( @"Show the %@'s details", entity ) )end fn// show aRecord's fields (names, with titles) under heading, in a popover beside the view anchorTag. The popover is// made in Cocoa, anchored to the button itself: no FB tags inside it to look up ("View does not exist", 2026-11-27).void local fn RecordPopoverShow( anchorTag as long, heading as CFStringRef, aRecord as CFDictionaryRef, names as CFArrayRef, titles as CFArrayRef )long              rows = fn ArrayCount( names ), iCFMutableArrayRef labels = fn MutableArrayNew, values = fn MutableArrayNewCFStringRef       valueTextViewRef           anchor = fn ShellFindView( anchorTag )if ( anchor == NULL ) then exit fnif ( rows > _recordPopoverRows ) then rows = _recordPopoverRowsfor i = 0 to rows - 1valueText = fn BindingString( aRecord, fn ArrayObjectAtIndex( names, i ) )if ( fn StringLength( valueText ) == 0 ) then valueText = @"-"MutableArrayAddObject( labels, fn StringWithFormat( @"%@:", fn ArrayObjectAtIndex( titles, i ) ) )MutableArrayAddObject( values, valueText )nextcln static NSPopover *recordPopover = nil; [recordPopover close]; NSView *anchorView = (__bridge NSView *)anchor; NSTextField *title = [NSTextField labelWithString:(__bridge NSString *)heading]; title.font = [NSFont boldSystemFontOfSize:13.0]; NSMutableArray *gridRows = [NSMutableArray array]; NSArray *ls = (__bridge NSArray *)labels, *vs = (__bridge NSArray *)values; for ( NSUInteger r = 0; r < ls.count; r++ ) { NSTextField *l = [NSTextField labelWithString:ls[r]]; l.textColor = NSColor.secondaryLabelColor; l.alignment = NSTextAlignmentRight; NSTextField *v = [NSTextField labelWithString:vs[r]]; v.selectable = YES; v.lineBreakMode = NSLineBreakByTruncatingTail; [v.widthAnchor constraintLessThanOrEqualToConstant:260].active = YES; [gridRows addObject:@[ l, v ]]; } NSGridView *grid = [NSGridView gridViewWithViews:gridRows]; grid.rowSpacing = 5; grid.columnSpacing = 10; if ( grid.numberOfColumns > 0 ) [grid columnAtIndex:0].xPlacement = NSGridCellPlacementTrailing; NSStackView *stack = [NSStackView stackViewWithViews:@[ title, grid ]]; stack.orientation = NSUserInterfaceLayoutOrientationVertical; stack.alignment = NSLayoutAttributeLeading; stack.spacing = 10; stack.edgeInsets = NSEdgeInsetsMake( 14, 16, 14, 16 ); NSViewController *content = [[NSViewController alloc] init]; content.view = stack; recordPopover = [[NSPopover alloc] init]; recordPopover.behavior = NSPopoverBehaviorTransient; recordPopover.contentViewController = content; recordPopover.contentSize = stack.fittingSize; [recordPopover showRelativeToRect:anchorView.bounds ofView:anchorView preferredEdge:NSRectEdgeMaxX];end fn// a button was clicked: YES when it was a lookup's info button (the chosen parent is shown)local fn RecordPopoverClicked( tag as long ) as BOOLCFDictionaryRef lookup, aRecordCFStringRef     choseText = @""long            fieldTagif ( gRecordPopoverLookups == NULL ) then exit fn = NOlookup = fn DictionaryObjectForKey( gRecordPopoverLookups, fn StringWithFormat( @"%ld", tag ) )if ( lookup == NULL ) then exit fn = NOfieldTag = fn NumberIntegerValue( fn DictionaryObjectForKey( lookup, @"fieldTag" ) )// the chosen parent: from an auto-complete (Auto Complete.incl) or a Dropdown (Binding Support.incl)if ( fn AutoCompleteIsField( fieldTag ) )aRecord   = fn AutoCompleteChosenRecord( fieldTag )choseText = fn ControlStringValue( fieldTag )elseaRecord   = fn BindingChosenRecord( fieldTag )if ( aRecord != NULL ) then choseText = fn PopUpButtonTitleOfSelectedItem( fieldTag )end ifif ( aRecord == NULL )fn RecordPopoverShow( tag, fn StringWithFormat( @"No %@ chosen", fn DictionaryObjectForKey( lookup, @"entity" ) ), @{}, @[], @[] )exit fn = YESend iffn RecordPopoverShow( tag, fn StringWithFormat( @"%@: %@", fn DictionaryObjectForKey( lookup, @"entity" ), choseText ), aRecord, fn DictionaryObjectForKey( lookup, @"names" ), fn DictionaryObjectForKey( lookup, @"titles" ) )end fn = YES