/* *   ALS Client.incl * *   API Logic Server client for generated FutureBasic apps.  Copied unchanged *   into every generated project by the Api Logic Client generator. * *   ALS serves JSON:API: *       GET    /api/<Resource>?page[limit]=n&page[offset]=0   -> { data:[ {type,id,attributes} ] } *       POST   /api/<Resource>          { data:{ type, attributes } } *       PATCH  /api/<Resource>/<id>     { data:{ type, id, attributes } } *       DELETE /api/<Resource>/<id> * *   Login tries gALSLoginPath (stock ALS: /api/auth/login) and, if that *   endpoint does not exist (404), gALSFallbackLoginPath. * *   Requests are asynchronous.  Each call takes the address of a URLSession *   completion handler; ALS App.incl supplies one that hops to the main thread. *   This file has no UI code and no dependency on the other runtime files. */begin globalsCFStringRef gALSHost                  // e.g. http://localhost:5656  (no trailing slash)CFStringRef gALSLoginPath             // tried firstCFStringRef gALSFallbackLoginPath     // tried when the first returns 404CFStringRef gALSUserCFStringRef gALSPasswordCFStringRef gALSToken                 // bearer token after a successful loginBOOL        gALSSecurityOnlong        gALSPageLimitend globalslocal fn ALSURLForPath( path as CFStringRef ) as CFURLRefend fn = fn URLWithString( fn StringWithFormat( @"%@%@", gALSHost, path ) )// "ALFKI" -> "ALFKI",  "a b/c" -> "a%20b%2Fc"local fn ALSEncodeID( recordID as CFTypeRef ) as CFStringRefCFStringRef idString = fn StringWithFormat( @"%@", recordID )idString = fn StringByReplacingOccurrencesOfString( idString, @"/", @"%2F" )end fn = fn StringByAddingPercentEncodingWithAllowedCharacters( idString, fn CharacterSetURLPathAllowedSet )/* *   send one request *   body      : any JSON object (dictionary/array) or NULL *   isJSONAPI : YES for resource calls (application/vnd.api+json), NO for login */local fn ALSSendRequest( method as CFStringRef, path as CFStringRef, body as CFTypeRef, isJSONAPI as BOOL, handler as ptr ) as BOOLCFURLRef              urlMutableURLRequestRef  requestCFDataRef             bodyDataCFStringRef           contentType = @"application/json"URLSessionDataTaskRef taskErrorRef              err = NULLurl = fn ALSURLForPath( path )if ( url == NULL ) then exit fn = NOif ( isJSONAPI ) then contentType = @"application/vnd.api+json"request = fn MutableURLRequestWithURL( url )MutableURLRequestSetHTTPMethod( request, method )MutableURLRequestSetTimeoutInterval( request, 30.0 )MutableURLRequestSetValueForHTTPHeaderField( request, contentType, @"Content-Type" )MutableURLRequestSetValueForHTTPHeaderField( request, @"application/vnd.api+json, application/json", @"Accept" )if ( gALSToken != NULL ) then MutableURLRequestSetValueForHTTPHeaderField( request, fn StringWithFormat( @"Bearer %@", gALSToken ), @"Authorization" )if ( body != NULL )bodyData = fn JSONSerializationDataWithJSONObject( body, 0, @err )if ( bodyData == NULL ) then exit fn = NOMutableURLRequestSetHTTPBody( request, bodyData )end iftask = fn URLSessionDataTaskWithRequestCompletionHandler( fn URLSessionSharedSession, (URLRequestRef)request, handler, NULL )if ( task == NULL ) then exit fn = NOURLSessionTaskResume( task )end fn = YES/* *   ALS operations */local fn ALSLogin( loginPath as CFStringRef, handler as ptr ) as BOOLCFStringRef user = gALSUser, password = gALSPasswordif ( user == NULL ) then user = @""if ( password == NULL ) then password = @""gALSToken = NULLend fn = fn ALSSendRequest( @"POST", loginPath, @{ @"username":user, @"password":password }, NO, handler )local fn ALSList( resource as CFStringRef, handler as ptr ) as BOOLlong limit = gALSPageLimitif ( limit <= 0 ) then limit = 100end fn = fn ALSSendRequest( @"GET", fn StringWithFormat( @"/api/%@?page%%5Blimit%%5D=%ld&page%%5Boffset%%5D=0", resource, limit ), NULL, YES, handler )local fn ALSCreate( resource as CFStringRef, attributes as CFDictionaryRef, handler as ptr ) as BOOLCFDictionaryRef body = @{ @"data":@{ @"type":resource, @"attributes":attributes } }end fn = fn ALSSendRequest( @"POST", fn StringWithFormat( @"/api/%@", resource ), body, YES, handler )local fn ALSUpdate( resource as CFStringRef, recordID as CFTypeRef, attributes as CFDictionaryRef, handler as ptr ) as BOOLCFDictionaryRef body = @{ @"data":@{ @"type":resource, @"id":recordID, @"attributes":attributes } }end fn = fn ALSSendRequest( @"PATCH", fn StringWithFormat( @"/api/%@/%@", resource, fn ALSEncodeID( recordID ) ), body, YES, handler )local fn ALSDelete( resource as CFStringRef, recordID as CFTypeRef, handler as ptr ) as BOOLend fn = fn ALSSendRequest( @"DELETE", fn StringWithFormat( @"/api/%@/%@", resource, fn ALSEncodeID( recordID ) ), NULL, YES, handler )/* *   response helpers - call these from the completion handler */local fn ALSResponseStatus( response as URLResponseRef ) as longif ( response == NULL ) then exit fn = 0end fn = fn HTTPURLResponseStatusCode( (HTTPURLResponseRef)response )local fn ALSResponseJSON( dta as CFDataRef ) as CFTypeRefCFTypeRef json = NULLErrorRef  err  = NULLif ( dta != NULL )if ( fn DataLength( dta ) > 0 ) then json = fn JSONSerializationJSONObjectWithData( dta, NSJSONReadingMutableContainers, @err )end ifend fn = json// best human-readable message from an ALS / JSON:API error responselocal fn ALSErrorMessage( status as long, json as CFTypeRef, err as ErrorRef ) as CFStringRefCFStringRef     messageCFArrayRef      errorsCFDictionaryRef firstErrorCFTypeRef       textValueif ( status == 0 )if ( err != NULL ) then exit fn = fn ErrorLocalizedDescription( err )exit fn = @"No response from server."end ifmessage = fn StringWithFormat( @"HTTP %ld %@", status, fn HTTPURLResponseLocalizedStringForStatusCode( status ) )if ( json != NULL )if ( fn ObjectIsKindOfClass( json, fn ClassFromString( @"NSDictionary" ) ) )errors = fn DictionaryObjectForKey( json, @"errors" )if ( errors != NULL )if ( fn ArrayCount( errors ) > 0 )firstError = fn ArrayFirstObject( errors )textValue = fn DictionaryObjectForKey( firstError, @"detail" )if ( textValue == NULL ) then textValue = fn DictionaryObjectForKey( firstError, @"title" )if ( textValue != NULL ) then message = fn StringWithFormat( @"%@: %@", message, textValue )end ifelsetextValue = fn DictionaryObjectForKey( json, @"message" )if ( textValue == NULL ) then textValue = fn DictionaryObjectForKey( json, @"msg" )if ( textValue != NULL ) then message = fn StringWithFormat( @"%@: %@", message, textValue )end ifend ifend ifend fn = message