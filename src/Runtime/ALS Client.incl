/* *   ALS Client.incl * *   API Logic Server client for generated FutureBasic apps.  Copied unchanged *   into every generated project by the App Builder for FutureBasic generator. * *   ALS serves JSON:API: *       GET    /api/<Resource>?page[limit]=n&page[offset]=0   -> { data:[ {type,id,attributes} ] } *       POST   /api/<Resource>          { data:{ type, attributes } } *       PATCH  /api/<Resource>/<id>     { data:{ type, id, attributes } } *       DELETE /api/<Resource>/<id> * *   Login tries gALSLoginPath (stock ALS: /api/auth/login) and, if that *   endpoint does not exist (404), gALSFallbackLoginPath. * *   The contract it follows - checked against a running server by tools/als_contract.py, and *   written up in docs/design/ALS Contract.md: *     - login: POST /api/auth/login {username, password} -> {"access_token": JWT}; Bearer after *     - 401 (no / expired token, wrong password) and 422 (not a token) mean: sign in again *     - lists page by offset until meta.total rows have arrived: links.next comes one page short *     - every record carries S_CheckSum; send it back with an update, and read the record again *       afterwards: the update's answer still holds the old one *     - errors: {"errors":[{"title"}]} (a rule's message is the title), {"msg"}, or a bare string * *   Requests are asynchronous.  Each call takes the address of a URLSession *   completion handler; ALS App.incl supplies one that hops to the main thread. *   This file has no UI code and no dependency on the other runtime files. */begin globalsCFStringRef gALSHost                  // e.g. http://localhost:5656  (no trailing slash)CFStringRef gALSLoginPath             // tried firstCFStringRef gALSFallbackLoginPath     // tried when the first returns 404CFStringRef gALSUserCFStringRef gALSPasswordCFStringRef gALSToken                 // bearer token after a successful loginBOOL        gALSSecurityOnlong        gALSPageLimitend globalslocal fn ALSURLForPath( path as CFStringRef ) as CFURLRefend fn = fn URLWithString( fn StringWithFormat( @"%@%@", gALSHost, path ) )// "ALFKI" -> "ALFKI",  "a b/c" -> "a%20b%2Fc"local fn ALSEncodeID( recordID as CFTypeRef ) as CFStringRefCFStringRef idString = fn StringWithFormat( @"%@", recordID )idString = fn StringByReplacingOccurrencesOfString( idString, @"/", @"%2F" )end fn = fn StringByAddingPercentEncodingWithAllowedCharacters( idString, fn CharacterSetURLPathAllowedSet )/* *   send one request *   body      : any JSON object (dictionary/array) or NULL *   isJSONAPI : YES for resource calls (application/vnd.api+json), NO for login */local fn ALSSendRequest( method as CFStringRef, path as CFStringRef, body as CFTypeRef, isJSONAPI as BOOL, handler as ptr ) as BOOLCFURLRef              urlMutableURLRequestRef  requestCFDataRef             bodyDataCFStringRef           contentType = @"application/json"URLSessionDataTaskRef taskErrorRef              err = NULLurl = fn ALSURLForPath( path )if ( url == NULL ) then exit fn = NOif ( isJSONAPI ) then contentType = @"application/vnd.api+json"request = fn MutableURLRequestWithURL( url )MutableURLRequestSetHTTPMethod( request, method )MutableURLRequestSetTimeoutInterval( request, 30.0 )MutableURLRequestSetValueForHTTPHeaderField( request, contentType, @"Content-Type" )MutableURLRequestSetValueForHTTPHeaderField( request, @"application/vnd.api+json, application/json", @"Accept" )if ( gALSToken != NULL ) then MutableURLRequestSetValueForHTTPHeaderField( request, fn StringWithFormat( @"Bearer %@", gALSToken ), @"Authorization" )if ( body != NULL )bodyData = fn JSONSerializationDataWithJSONObject( body, 0, @err )if ( bodyData == NULL ) then exit fn = NOMutableURLRequestSetHTTPBody( request, bodyData )end iftask = fn URLSessionDataTaskWithRequestCompletionHandler( fn URLSessionSharedSession, (URLRequestRef)request, handler, NULL )if ( task == NULL ) then exit fn = NOURLSessionTaskResume( task )end fn = YES/* *   ALS operations */local fn ALSLogin( loginPath as CFStringRef, handler as ptr ) as BOOLCFStringRef user = gALSUser, password = gALSPasswordif ( user == NULL ) then user = @""if ( password == NULL ) then password = @""gALSToken = NULLend fn = fn ALSSendRequest( @"POST", loginPath, @{ @"username":user, @"password":password }, NO, handler )// the page size for lists (gALSPageLimit, else 200)local fn ALSPageLimit as longif ( gALSPageLimit > 0 ) then exit fn = gALSPageLimitend fn = 200// one page of a list, from offset.  query: more parameters ("&filter[Country]=Germany&sort=CompanyName"),// already percent-encoded where needed, or NULL.  Page on by offset until meta.total rows have// arrived (fn ALSResponseTotal): ALS leaves links.next out one page early.local fn ALSListPage( resource as CFStringRef, offset as long, query as CFStringRef, handler as ptr ) as BOOLif ( query == NULL ) then query = @""end fn = fn ALSSendRequest( @"GET", fn StringWithFormat( @"/api/%@?page%%5Blimit%%5D=%ld&page%%5Boffset%%5D=%ld%@", resource, fn ALSPageLimit, offset, query ), NULL, YES, handler )// the first page of a listlocal fn ALSList( resource as CFStringRef, handler as ptr ) as BOOLend fn = fn ALSListPage( resource, 0, NULL, handler )// one record: also to read its S_CheckSum again after an updatelocal fn ALSGet( resource as CFStringRef, recordID as CFTypeRef, handler as ptr ) as BOOLend fn = fn ALSSendRequest( @"GET", fn StringWithFormat( @"/api/%@/%@", resource, fn ALSEncodeID( recordID ) ), NULL, YES, handler )local fn ALSCreate( resource as CFStringRef, attributes as CFDictionaryRef, handler as ptr ) as BOOLCFDictionaryRef body = @{ @"data":@{ @"type":resource, @"attributes":attributes } }end fn = fn ALSSendRequest( @"POST", fn StringWithFormat( @"/api/%@", resource ), body, YES, handler )// attributes: only what changed, plus the S_CheckSum the record was read with (a stale one is// refused with "row altered by another user": another user saved it first)local fn ALSUpdate( resource as CFStringRef, recordID as CFTypeRef, attributes as CFDictionaryRef, handler as ptr ) as BOOLCFDictionaryRef body = @{ @"data":@{ @"type":resource, @"id":recordID, @"attributes":attributes } }end fn = fn ALSSendRequest( @"PATCH", fn StringWithFormat( @"/api/%@/%@", resource, fn ALSEncodeID( recordID ) ), body, YES, handler )local fn ALSDelete( resource as CFStringRef, recordID as CFTypeRef, handler as ptr ) as BOOLend fn = fn ALSSendRequest( @"DELETE", fn StringWithFormat( @"/api/%@/%@", resource, fn ALSEncodeID( recordID ) ), NULL, YES, handler )/* *   response helpers - call these from the completion handler */local fn ALSResponseStatus( response as URLResponseRef ) as longif ( response == NULL ) then exit fn = 0end fn = fn HTTPURLResponseStatusCode( (HTTPURLResponseRef)response )local fn ALSResponseJSON( dta as CFDataRef ) as CFTypeRefCFTypeRef json = NULLErrorRef  err  = NULLif ( dta != NULL )// fragments allowed: a refused login answers with a bare JSON stringif ( fn DataLength( dta ) > 0 ) then json = fn JSONSerializationJSONObjectWithData( dta, NSJSONReadingMutableContainers + NSJSONReadingFragmentsAllowed, @err )end ifend fn = json// meta.total of a list answer: how many rows there are in all (0 when it has none)local fn ALSResponseTotal( json as CFTypeRef ) as longCFDictionaryRef metaif ( json == NULL ) then exit fn = 0if ( fn ObjectIsKindOfClass( (ObjectRef)json, fn ClassFromString( @"NSDictionary" ) ) == NO ) then exit fn = 0meta = fn DictionaryObjectForKey( json, @"meta" )if ( meta == NULL ) then exit fn = 0end fn = fn NumberIntegerValue( fn DictionaryObjectForKey( meta, @"total" ) )// 401 (no or expired token, a wrong password) and 422 (something that is not a token): sign in againlocal fn ALSNeedsSignIn( status as long ) as BOOLend fn = ( status == 401 || status == 422 )// what the user should read from an ALS / JSON:API error answer (tools/als_contract.py,// error_message, is the reference)://   {"errors":[{"title", "detail"}]}  -> the title: a rule's message ("balance (2102) exceeds credit (1)");//                                        detail can be a dictionary, so it is used only when it is text//   {"msg"} or {"message"}            -> that text (token problems)//   "text"                            -> the text itself (a wrong password)local fn ALSErrorMessage( status as long, json as CFTypeRef, err as ErrorRef ) as CFStringRefCFArrayRef      errorsCFDictionaryRef firstErrorCFTypeRef       textValueif ( status == 0 )if ( err != NULL ) then exit fn = fn ErrorLocalizedDescription( err )exit fn = @"No response from the server."end ifif ( json != NULL )if ( fn ObjectIsKindOfClass( (ObjectRef)json, fn StringClass ) )if ( fn StringLength( (CFStringRef)json ) > 0 ) then exit fn = (CFStringRef)jsonend ifif ( fn ObjectIsKindOfClass( (ObjectRef)json, fn ClassFromString( @"NSDictionary" ) ) )errors = fn DictionaryObjectForKey( json, @"errors" )if ( errors != NULL )if ( fn ArrayCount( errors ) > 0 )firstError = fn ArrayFirstObject( errors )textValue = fn DictionaryObjectForKey( firstError, @"title" )if ( textValue != NULL ) then if ( fn ObjectIsKindOfClass( (ObjectRef)textValue, fn StringClass ) ) then exit fn = (CFStringRef)textValuetextValue = fn DictionaryObjectForKey( firstError, @"detail" )if ( textValue != NULL ) then if ( fn ObjectIsKindOfClass( (ObjectRef)textValue, fn StringClass ) ) then exit fn = (CFStringRef)textValueend ifend iftextValue = fn DictionaryObjectForKey( json, @"msg" )if ( textValue == NULL ) then textValue = fn DictionaryObjectForKey( json, @"message" )if ( textValue != NULL ) then if ( fn ObjectIsKindOfClass( (ObjectRef)textValue, fn StringClass ) ) then exit fn = (CFStringRef)textValueend ifend ifend fn = fn StringWithFormat( @"HTTP %ld %@", status, fn HTTPURLResponseLocalizedStringForStatusCode( status ) )