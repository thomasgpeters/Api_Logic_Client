/* *   ALS Binding.incl * *   Moves values between JSON:API "attributes" dictionaries and the controls in *   a generated <Resource>View.xib.  Driven entirely by the field list that the *   generator writes to Model.json: * *       fields: [ { name, label, type, kind, tag }, ... ] * *   kind values match the generator's XIB control kinds (XIB Generator.incl): */begin enum 1_alsKindText_alsKindTextArea_alsKindInteger_alsKindDecimal_alsKindDate_alsKindCheckboxend enum#define ALS_DATE_FORMAT @"yyyy-MM-dd"/* *   value helpers */local fn ALSIsNull( value as CFTypeRef ) as BOOLif ( value == NULL ) then exit fn = YESend fn = fn ObjectIsKindOfClass( value, fn ClassFromString( @"NSNull" ) )// JSON null, for clearing a value on the server (there is no NSNull toolbox wrapper)local fn ALSJSONNull as CFTypeRefErrorRef   err = NULLCFArrayRef wrapped = fn JSONSerializationJSONObjectWithData( fn StringData( @"[null]", NSUTF8StringEncoding ), 0, @err )end fn = fn ArrayFirstObject( wrapped )local fn ALSStringForValue( value as CFTypeRef ) as CFStringRefif ( fn ALSIsNull( value ) ) then exit fn = @""if ( fn ObjectIsKindOfClass( value, fn StringClass ) ) then exit fn = (CFStringRef)valueend fn = fn StringWithFormat( @"%@", value )local fn ALSBoolForValue( value as CFTypeRef ) as BOOLCFStringRef sif ( fn ALSIsNull( value ) ) then exit fn = NOif ( fn ObjectIsKindOfClass( value, fn NumberClass ) ) then exit fn = ( fn NumberIntegerValue( value ) != 0 )s = fn StringLowercaseString( fn ALSStringForValue( value ) )end fn = ( fn StringIsEqual( s, @"true" ) || fn StringIsEqual( s, @"yes" ) || fn StringIsEqual( s, @"1" ) )local fn ALSDateFormatter as DateFormatterRefDateFormatterRef formatter = fn DateFormatterInitDateFormatterSetDateFormat( formatter, ALS_DATE_FORMAT )end fn = formatter// "1996-07-04" or "1996-07-04T00:00:00" -> date;  NULL when empty/unparseablelocal fn ALSDateForValue( value as CFTypeRef ) as CFDateRefCFStringRef s = fn ALSStringForValue( value )if ( fn StringLength( s ) < 10 ) then exit fn = NULLend fn = fn DateFormatterDateFromString( fn ALSDateFormatter, fn StringSubstringToIndex( s, 10 ) )local fn ALSFieldTag( field as CFDictionaryRef ) as longend fn = fn NumberIntegerValue( fn DictionaryObjectForKey( field, @"tag" ) )local fn ALSFieldKind( field as CFDictionaryRef ) as longend fn = fn NumberIntegerValue( fn DictionaryObjectForKey( field, @"kind" ) )/* *   record -> view *   attributes NULL clears the view (new record): empty text, today's date, unchecked */void local fn ALSBindRecordToView( fields as CFArrayRef, attributes as CFDictionaryRef )CFDictionaryRef fieldCFStringRef     nameCFTypeRef       valueCFDateRef       dtlong            tagfor field in fieldstag   = fn ALSFieldTag( field )name  = fn DictionaryObjectForKey( field, @"name" )value = NULLif ( attributes != NULL ) then value = fn DictionaryObjectForKey( attributes, name )if ( fn ViewExists( tag ) )select ( fn ALSFieldKind( field ) )case _alsKindDatedt = fn ALSDateForValue( value )if ( dt == NULL ) then dt = fn DateInitDatePickerSetDateValue( tag, dt )case _alsKindCheckboxif ( fn ALSBoolForValue( value ) ) then ButtonSetState( tag, NSControlStateValueOn ) else ButtonSetState( tag, NSControlStateValueOff )case _alsKindInteger, _alsKindDecimalif ( fn ALSIsNull( value ) ) then ControlSetStringValue( tag, @"" ) else ControlSetObjectValue( tag, value )case elseControlSetStringValue( tag, fn ALSStringForValue( value ) )end selectend ifnextend fn/* *   view -> attributes to send *   Returns only the attributes whose value differs from `original`, so a PATCH *   never overwrites columns the user did not touch.  With original NULL (new *   record) every non-empty control is returned. */local fn ALSAttributesFromView( fields as CFArrayRef, original as CFDictionaryRef ) as CFMutableDictionaryRefCFMutableDictionaryRef changes = fn MutableDictionaryNewCFDictionaryRef        fieldCFStringRef            name, textValue, todayCFTypeRef              oldValue, newValueBOOL                   oldIsNull, isNew, checkedlong                   tagisNew = ( original == NULL )today = fn DateFormatterStringFromDate( fn ALSDateFormatter, fn DateInit )for field in fieldstag      = fn ALSFieldTag( field )name     = fn DictionaryObjectForKey( field, @"name" )oldValue = NULLif ( original != NULL ) then oldValue = fn DictionaryObjectForKey( original, name )oldIsNull = fn ALSIsNull( oldValue )newValue  = NULLif ( fn ViewExists( tag ) )select ( fn ALSFieldKind( field ) )case _alsKindIntegertextValue = fn ControlStringValue( tag )if ( fn StringLength( textValue ) == 0 )if ( oldIsNull == NO ) then newValue = fn ALSJSONNullelseif ( oldIsNull ) then newValue = fn NumberWithInteger( fn ControlIntegerValue( tag ) )if ( oldIsNull == NO )if ( fn NumberIntegerValue( oldValue ) != fn ControlIntegerValue( tag ) ) then newValue = fn NumberWithInteger( fn ControlIntegerValue( tag ) )end ifend ifcase _alsKindDecimaltextValue = fn ControlStringValue( tag )if ( fn StringLength( textValue ) == 0 )if ( oldIsNull == NO ) then newValue = fn ALSJSONNullelseif ( oldIsNull ) then newValue = fn NumberWithDouble( fn ControlDoubleValue( tag ) )if ( oldIsNull == NO )if ( fn NumberDoubleValue( oldValue ) != fn ControlDoubleValue( tag ) ) then newValue = fn NumberWithDouble( fn ControlDoubleValue( tag ) )end ifend ifcase _alsKindDatetextValue = fn DateFormatterStringFromDate( fn ALSDateFormatter, fn DatePickerDateValue( tag ) )if ( oldIsNull )// a null date is shown as today; only send it if the user picked something elseif ( fn StringIsEqual( textValue, today ) == NO ) then newValue = textValueelseif ( fn StringHasPrefix( fn ALSStringForValue( oldValue ), textValue ) == NO ) then newValue = textValueend ifcase _alsKindCheckboxchecked = ( fn ButtonState( tag ) == NSControlStateValueOn )if ( isNew || checked != fn ALSBoolForValue( oldValue ) ) then newValue = fn NumberWithBool( checked )case elsetextValue = fn ControlStringValue( tag )if ( fn StringIsEqual( textValue, fn ALSStringForValue( oldValue ) ) == NO )if ( fn StringLength( textValue ) == 0 ) then newValue = fn ALSJSONNull else newValue = textValueend ifend selectend ifif ( newValue != NULL ) then MutableDictionarySetObjectForKey( changes, newValue, name )nextend fn = changes