/* *   DataObject.incl - the SQL Generator's SQL: GenerateSelectSQL, GenerateInsertIntoSQL, *   GenerateInsertRowsSQL, GenerateUpdateSQL, GenerateDeleteFromSQL, and QueryParameterValues (the values for the ? *   placeholders, in order).  DataObject.glbl and DataObject_Super.incl come before this file. * *   SQL Generator: describe a SQL statement in a dictionary, get parameterized SQL back. *   Shared as an example project: src/SQLGeneratorExample in Api_Logic_Client. *   MIT License. Copyright (c) 2026 Imagery Business Systems, LLC. */include "NSLog.incl"/* * WHERE clause from a "filter" array built with fn AddFilterToQuery. *   useAlias    YES -> alias.column (SELECT), NO -> column (UPDATE / DELETE) *   connector   @" WHERE ", or @" AND " when joins already started the WHERE * Filters after the first are joined by their logic (_and / _or), AND when none was given. * Returns the number of filters written (0 writes nothing). */local fn AppendWhereSQL( sqlString as CFMutableStringRef, filterArrayRef as CFArrayRef, useAlias as BOOL, connector as CFStringRef ) as longCFDictionaryRef filterDictionaryRefCFNumberRef     numberReflong            filterCount, i, aOperator, aLogicif ( filterArrayRef == NULL ) then exit fn = 0filterCount = fn ArrayCount( filterArrayRef )if ( filterCount == 0 ) then exit fn = 0MutableStringAppendString( sqlString, connector )for i = 0 to filterCount - 1filterDictionaryRef = fn ArrayObjectAtIndex( filterArrayRef, i )if ( i > 0 )aLogic = _andnumberRef = fn DictionaryObjectForKey( filterDictionaryRef, @"logic" )if ( numberRef != NULL ) then aLogic = fn NumberIntegerValue( numberRef )if ( aLogic == _or ) then MutableStringAppendString( sqlString, @" OR " ) else MutableStringAppendString( sqlString, @" AND " )end ifif ( useAlias ) then MutableStringAppendString( sqlString, fn StringWithFormat( @"%@.", fn QuoteSQLName( fn DictionaryObjectForKey( filterDictionaryRef, @"tablealias" ) ) ) )MutableStringAppendString( sqlString, fn QuoteSQLName( fn DictionaryObjectForKey( filterDictionaryRef, @"columnname" ) ) )aOperator = fn NumberIntegerValue( fn DictionaryObjectForKey( filterDictionaryRef, @"operator" ) )select ( aOperator )case _isNotEqual            : MutableStringAppendString( sqlString, @" != ?" )case _isLessThan            : MutableStringAppendString( sqlString, @" < ?" )case _isGreaterThan         : MutableStringAppendString( sqlString, @" > ?" )case _isLessThanOrEqual     : MutableStringAppendString( sqlString, @" <= ?" )case _isGreaterThanOrEqual  : MutableStringAppendString( sqlString, @" >= ?" )case _isIn                  : MutableStringAppendString( sqlString, @" IN ( ? )" )case _isNotIn               : MutableStringAppendString( sqlString, @" NOT IN ( ? )" )case _isNull                : MutableStringAppendString( sqlString, @" IS NULL" )case _isNotNull             : MutableStringAppendString( sqlString, @" IS NOT NULL" )case _isLike                : MutableStringAppendString( sqlString, @" LIKE ?" )case _isNotLike             : MutableStringAppendString( sqlString, @" NOT LIKE ?" )case else                   : MutableStringAppendString( sqlString, @" = ?" )end selectnextend fn = filterCount/* * ORDER BY alias.column [DESC], ... from an "orderby" array built with fn AddOrderToQuery. */void local fn AppendOrderBySQL( sqlString as CFMutableStringRef, orderArrayRef as CFArrayRef )CFDictionaryRef orderDictionaryReflong            iif ( orderArrayRef == NULL ) then exit fnfor i = 0 to (long)fn ArrayCount( orderArrayRef ) - 1orderDictionaryRef = fn ArrayObjectAtIndex( orderArrayRef, i )if ( i == 0 ) then MutableStringAppendString( sqlString, @" ORDER BY " ) else MutableStringAppendString( sqlString, @", " )if ( fn DictionaryObjectForKey( orderDictionaryRef, @"tablealias" ) != NULL ) then MutableStringAppendString( sqlString, fn StringWithFormat( @"%@.", fn QuoteSQLName( fn DictionaryObjectForKey( orderDictionaryRef, @"tablealias" ) ) ) )MutableStringAppendString( sqlString, fn QuoteSQLName( fn DictionaryObjectForKey( orderDictionaryRef, @"columnname" ) ) )if ( fn NumberIntegerValue( fn DictionaryObjectForKey( orderDictionaryRef, @"descending" ) ) != 0 ) then MutableStringAppendString( sqlString, @" DESC" )nextend fnlocal modedim as CFMutableArrayRef         selectcolsArrayRef, selecttablesArrayRef, selectassociationsArrayRefdim as CFMutableDictionaryRef    columnDictionaryRef, tableDictionaryRef, associationsDictionaryRefdim as CFMutableStringRef        mySQLStringdim as CFIndex                   sqlColumnCount, sqlTableCount, sqlAssociationCount, idim as CFNumberRef               myOperatordim as long                      aOperatorlocal fn GenerateSelectSQL( queryDictionaryRef as CFMutableDictionaryRef ) as CFMutableStringRefmySQLString = fn MutableStringNewsqlAssociationCount = 0MutableStringAppendString( mySQLString, @"SELECT " )if ( ( fn DictionaryObjectForKey( queryDictionaryRef, @"selectcols" ) != NULL ) )selectcolsArrayRef = (CFMutableArrayRef)fn DictionaryObjectForKey( queryDictionaryRef, @"selectcols" )if ( selectcolsArrayRef )sqlColumnCount = fn ArrayCount( selectcolsArrayRef )for i = 0 to sqlColumnCount - 1columnDictionaryRef = (CFMutableDictionaryRef) fn ArrayObjectAtIndex( selectcolsArrayRef, i )MutableStringAppendString( mySQLString, fn QuoteSQLName( fn DictionaryObjectForKey( columnDictionaryRef, @"columnname" ) ) )MutableStringAppendString( mySQLString, @" AS " )MutableStringAppendString( mySQLString, fn QuoteSQLName( fn DictionaryObjectForKey( columnDictionaryRef, @"aliasname" ) ) )if ( i < sqlColumnCount - 1 ) then MutableStringAppendString( mySQLString, @", " )next iend ifend ifMutableStringAppendString( mySQLString, @" FROM " )if ( ( fn DictionaryObjectForKey( queryDictionaryRef, @"selecttables" ) != NULL ) )selecttablesArrayRef = (CFMutableArrayRef)fn DictionaryObjectForKey( queryDictionaryRef, @"selecttables" )if ( selecttablesArrayRef )sqlTableCount = fn ArrayCount( selecttablesArrayRef )for i = 0 to sqlTableCount - 1tableDictionaryRef = (CFMutableDictionaryRef) fn ArrayObjectAtIndex( selecttablesArrayRef, i )MutableStringAppendString( mySQLString, fn QuoteSQLName( fn DictionaryObjectForKey( tableDictionaryRef, @"tablename" ) ) )MutableStringAppendString( mySQLString, @" AS " )MutableStringAppendString( mySQLString, fn QuoteSQLName( fn DictionaryObjectForKey( tableDictionaryRef, @"aliasname" ) ) )if ( i < sqlTableCount - 1 ) then MutableStringAppendString( mySQLString, @", " )next iend ifend ifif ( ( fn DictionaryObjectForKey( queryDictionaryRef, @"associations" ) != NULL ) )selectassociationsArrayRef = (CFMutableArrayRef)fn DictionaryObjectForKey( queryDictionaryRef, @"associations" )if ( selectassociationsArrayRef )sqlAssociationCount = fn ArrayCount( selectassociationsArrayRef )if ( sqlAssociationCount > 0 )MutableStringAppendString( mySQLString, @" WHERE " )for i = 0 to sqlAssociationCount - 1if ( i > 0 ) then MutableStringAppendString( mySQLString, @" AND " )associationsDictionaryRef = (CFMutableDictionaryRef) fn ArrayObjectAtIndex( selectassociationsArrayRef, i )MutableStringAppendString( mySQLString, fn QuoteSQLName( fn DictionaryObjectForKey( associationsDictionaryRef, @"lefttablealias" ) ) )MutableStringAppendString( mySQLString, @"." )MutableStringAppendString( mySQLString, fn QuoteSQLName( fn DictionaryObjectForKey( associationsDictionaryRef, @"leftcolumnname" ) ) )/* * * Operator           Meaning * a = b              a is equal to b * a != b             a is not equal to b * a < b              a is less than b * a > b              a is greater than b * a <= b             a is less than or equal to b * a >= b             a is greater than or equal to b * a IN (b, c)        a is equal to either b or c * a NOT IN (b, c)    a is equal to neither b nor c * a LIKE             a is LIKE 'b%' * a NOT LIKE         a is NOT LIKE 'b%' * *  only equal ( = ) should be used with associations *  associations are the JOINS in the SQL SELECT STATEMENT * */myOperator = (CFNumberRef)fn DictionaryObjectForKey( associationsDictionaryRef, @"operator" )aOperator = fn NumberIntegerValue( myOperator )select case aOperatorcase _isEqual : MutableStringAppendString( mySQLString, @" = " )case _isNotEqual : MutableStringAppendString( mySQLString, @" != " )case _isLessThan : MutableStringAppendString( mySQLString, @" < " )case _isGreaterThan : MutableStringAppendString( mySQLString, @" > " )case _isLessThanOrEqual : MutableStringAppendString( mySQLString, @" <= " )case _isGreaterThanOrEqual : MutableStringAppendString( mySQLString, @" >= " )case _isIn : MutableStringAppendString( mySQLString, @" IN " )case _isNotIn : MutableStringAppendString( mySQLString, @" NOT IN " )end select// myOperator came from CFDictionaryGetValue: not owned here, so not releasedMutableStringAppendString( mySQLString, fn QuoteSQLName( fn DictionaryObjectForKey( associationsDictionaryRef, @"righttablealias" ) ) )MutableStringAppendString( mySQLString, @"." )MutableStringAppendString( mySQLString, fn QuoteSQLName( fn DictionaryObjectForKey( associationsDictionaryRef, @"rightcolumnname" ) ) )next iend ifend ifend if// filters - after the joins (AND) or starting the WHEREif ( ( fn DictionaryObjectForKey( queryDictionaryRef, @"filter" ) != NULL ) )if ( sqlAssociationCount > 0 )fn AppendWhereSQL( mySQLString, fn DictionaryObjectForKey( queryDictionaryRef, @"filter" ), YES, @" AND " )elsefn AppendWhereSQL( mySQLString, fn DictionaryObjectForKey( queryDictionaryRef, @"filter" ), YES, @" WHERE " )end ifend if// ORDER BY - from AddOrderToQueryfn AppendOrderBySQL( mySQLString, fn DictionaryObjectForKey( queryDictionaryRef, @"orderby" ) )end fn = mySQLString/* * INSERT INTO table ( col1, col2 ) VALUES ( ?, ? ) * from a dictionary built with InitInsertIntoDictionary / AddTableToInsert / AddColumnToInsert. * NULL when the table or columns are missing. */local fn GenerateInsertIntoSQL( insertDictionaryRef as CFMutableDictionaryRef ) as CFMutableStringRefCFMutableStringRef sqlString, valuesStringCFArrayRef         columnValuesArrayRefCFStringRef        tableNamelong               columnCount, itableName            = fn DictionaryObjectForKey( insertDictionaryRef, @"insertintotable" )columnValuesArrayRef = fn DictionaryObjectForKey( insertDictionaryRef, @"columnvalues" )if ( tableName == NULL || columnValuesArrayRef == NULL ) then exit fn = NULLcolumnCount = fn ArrayCount( columnValuesArrayRef )if ( fn StringLength( tableName ) == 0 || columnCount == 0 ) then exit fn = NULLsqlString    = fn MutableStringNewvaluesString = fn MutableStringNewMutableStringAppendString( sqlString, fn StringWithFormat( @"INSERT INTO %@ ( ", fn QuoteSQLName( tableName ) ) )for i = 0 to columnCount - 1if ( i > 0 )MutableStringAppendString( sqlString, @", " )MutableStringAppendString( valuesString, @", " )end ifMutableStringAppendString( sqlString, fn QuoteSQLName( fn DictionaryObjectForKey( fn ArrayObjectAtIndex( columnValuesArrayRef, i ), @"columnname" ) ) )MutableStringAppendString( valuesString, @"?" )nextMutableStringAppendString( sqlString, fn StringWithFormat( @" ) VALUES ( %@ )", valuesString ) )end fn = sqlString/* * UPDATE table SET col1 = ?, col2 = ? WHERE ... * from a dictionary built with InitUpdateDictionary / AddTableToUpdate / AddColumnToUpdate * and AddFilterToQuery (table alias ignored). NULL without a filter, so an UPDATE can * never change every row by accident. */local fn GenerateUpdateSQL( updateDictionaryRef as CFMutableDictionaryRef ) as CFMutableStringRefCFMutableStringRef sqlStringCFArrayRef         columnValuesArrayRefCFStringRef        tableNamelong               columnCount, itableName            = fn DictionaryObjectForKey( updateDictionaryRef, @"updatetable" )columnValuesArrayRef = fn DictionaryObjectForKey( updateDictionaryRef, @"columnvalues" )if ( tableName == NULL || columnValuesArrayRef == NULL ) then exit fn = NULLcolumnCount = fn ArrayCount( columnValuesArrayRef )if ( fn StringLength( tableName ) == 0 || columnCount == 0 ) then exit fn = NULLsqlString = fn MutableStringNewMutableStringAppendString( sqlString, fn StringWithFormat( @"UPDATE %@ SET ", fn QuoteSQLName( tableName ) ) )for i = 0 to columnCount - 1if ( i > 0 ) then MutableStringAppendString( sqlString, @", " )MutableStringAppendString( sqlString, fn StringWithFormat( @"%@ = ?", fn QuoteSQLName( fn DictionaryObjectForKey( fn ArrayObjectAtIndex( columnValuesArrayRef, i ), @"columnname" ) ) ) )nextif ( fn AppendWhereSQL( sqlString, fn DictionaryObjectForKey( updateDictionaryRef, @"filter" ), NO, @" WHERE " ) == 0 )if ( isLoggingOn ) then NSLog( @"GenerateUpdateSQL: no filter - refusing to update every row of %@", tableName )exit fn = NULLend ifend fn = sqlString/* * DELETE FROM table WHERE ... * from a dictionary built with InitDeleteFromDictionary / AddTableToDelete and * AddFilterToQuery (table alias ignored). NULL without a filter, so a DELETE can * never empty a table by accident. */local fn GenerateDeleteFromSQL( deleteDictionaryRef as CFMutableDictionaryRef ) as CFMutableStringRefCFMutableStringRef sqlStringCFStringRef        tableName = fn DictionaryObjectForKey( deleteDictionaryRef, @"deletefromtable" )if ( tableName == NULL ) then exit fn = NULLif ( fn StringLength( tableName ) == 0 ) then exit fn = NULLsqlString = fn MutableStringNewMutableStringAppendString( sqlString, fn StringWithFormat( @"DELETE FROM %@", fn QuoteSQLName( tableName ) ) )if ( fn AppendWhereSQL( sqlString, fn DictionaryObjectForKey( deleteDictionaryRef, @"filter" ), NO, @" WHERE " ) == 0 )if ( isLoggingOn ) then NSLog( @"GenerateDeleteFromSQL: no filter - refusing to delete every row of %@", tableName )exit fn = NULLend ifend fn = sqlString/* * INSERT INTO table ( a, b ) VALUES ( ?, ? ), ( ?, ? ), ... for every row of a rows dictionary * (InitInsertRowsDictionary, AddTableToInsert, AddRowsToInsert).  NULL when the table, the rows * or the columns are missing.  SQLite takes up to 32766 values in one statement: for thousands * of rows, insert a few hundred at a time inside one transaction. */local fn GenerateInsertRowsSQL( statement as CFDictionaryRef ) as CFMutableStringRefCFMutableStringRef sqlString, rowPlaceholdersCFArrayRef         rows, columnsCFStringRef        tableNamelong               columnCount, rowCount, itableName = fn DictionaryObjectForKey( statement, @"insertintotable" )rows      = fn DictionaryObjectForKey( statement, @"rows" )columns   = fn DictionaryObjectForKey( statement, @"columnnames" )if ( tableName == NULL || rows == NULL || columns == NULL ) then exit fn = NULLrowCount    = fn ArrayCount( rows )columnCount = fn ArrayCount( columns )if ( fn StringLength( tableName ) == 0 || rowCount == 0 || columnCount == 0 ) then exit fn = NULLsqlString = fn MutableStringNewrowPlaceholders = fn MutableStringNewMutableStringAppendString( sqlString, fn StringWithFormat( @"INSERT INTO %@ ( ", fn QuoteSQLName( tableName ) ) )for i = 0 to columnCount - 1if ( i > 0 )MutableStringAppendString( sqlString, @", " )MutableStringAppendString( rowPlaceholders, @", " )end ifMutableStringAppendString( sqlString, fn QuoteSQLName( fn ArrayObjectAtIndex( columns, i ) ) )MutableStringAppendString( rowPlaceholders, @"?" )nextMutableStringAppendString( sqlString, @" ) VALUES " )for i = 0 to rowCount - 1if ( i > 0 ) then MutableStringAppendString( sqlString, @", " )MutableStringAppendString( sqlString, fn StringWithFormat( @"( %@ )", rowPlaceholders ) )nextend fn = sqlString// SQL NULL as a value (CF collections cannot hold NULL)local fn QueryNull as CFTypeRefcln return (__bridge CFTypeRef)[NSNull null];end fn = NULL/* * The values for the ? placeholders of a statement described by one of the dictionaries * above, in placeholder order: SET / VALUES columns first, then the rows of a multi-row INSERT * (row by row, in its column order), then the filters (IS NULL and IS NOT NULL filters take no * value).  A missing value is SQL NULL (NSNull). */local fn QueryParameterValues( statementDictionaryRef as CFDictionaryRef ) as CFMutableArrayRefCFMutableArrayRef values = fn MutableArrayNewCFArrayRef        entries, rows, columnsCFDictionaryRef   entry, rowCFStringRef       columnCFTypeRef         valuelong              aOperatorentries = fn DictionaryObjectForKey( statementDictionaryRef, @"columnvalues" )if ( entries != NULL )for entry in entriesvalue = fn DictionaryObjectForKey( entry, @"value" )if ( value == NULL ) then value = fn QueryNullMutableArrayAddObject( values, value )nextend ifrows = fn DictionaryObjectForKey( statementDictionaryRef, @"rows" )columns = fn DictionaryObjectForKey( statementDictionaryRef, @"columnnames" )if ( rows != NULL && columns != NULL )for row in rowsfor column in columnsvalue = fn DictionaryObjectForKey( row, column )if ( value == NULL ) then value = fn QueryNullMutableArrayAddObject( values, value )nextnextend ifentries = fn DictionaryObjectForKey( statementDictionaryRef, @"filter" )if ( entries != NULL )for entry in entriesaOperator = fn NumberIntegerValue( fn DictionaryObjectForKey( entry, @"operator" ) )if ( aOperator != _isNull && aOperator != _isNotNull )value = fn DictionaryObjectForKey( entry, @"value" )if ( value == NULL ) then value = fn QueryNullMutableArrayAddObject( values, value )end ifnextend ifend fn = values