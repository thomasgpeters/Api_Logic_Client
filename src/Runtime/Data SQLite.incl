/* *   I M A G E R Y    B U S I N E S S     S Y S T E M S,   L L C * *   Data SQLite.incl - runtime, copied into every generated app * *   SQLite 3, read-write, declared here against the public SQLite C API (SQLite is *   in the public domain; no FB toolbox file is copied).  The bottom layer of the *   data runtime: * *       Data SQLite.incl    open/close, statements, values, transactions   <- this file *       Data SQL.incl       parameterized SQL text from names *       Data Model.incl     the entities, keys and relationships in Model.json *       Data Records.incl   records: fetch, parent, children, insert, update, delete * *   Values cross this layer as Cocoa objects: INTEGER/REAL -> NSNumber, TEXT -> *   NSString, BLOB -> NSData, NULL -> NSNull (fn DataNull).  Link with -lsqlite3. */BeginCDeclaration#include <sqlite3.h>EndC_dataSQLiteOK   = 0_dataSQLiteROW  = 100_dataSQLiteDONE = 101begin globalsBOOL isLoggingOn                   // trace logging; set in <project>.main (errors always log)ptr  gDataDB                       // the open database - DataOpen (Data Records.incl)long gDataTransactionDepth         // DataBegin / DataEnd nestingBOOL gDataRollbackOnly             // a nested part failed: the outermost DataEnd rolls backend globals// SQL NULL as a value (CF collections cannot hold NULL)local fn DataNull as CFTypeRefcln return (__bridge CFTypeRef)[NSNull null];end fn = NULLlocal fn DataIsNull( value as CFTypeRef ) as BOOLif ( value == NULL ) then exit fn = YESend fn = fn ObjectIsKindOfClass( (ObjectRef)value, fn ClassFromString( @"NSNull" ) )// the file must exist: it is never created here (sqlite3_open would leave an empty file)local fn DataSQLiteOpen( path as CFStringRef, db as ptr ) as longcln return sqlite3_open_v2( [(__bridge NSString *)path fileSystemRepresentation], (sqlite3 **)db, SQLITE_OPEN_READWRITE, NULL );end fn = 1local fn DataSQLiteClose( db as ptr ) as longcln return sqlite3_close( (sqlite3 *)db );end fn = 0local fn DataSQLiteErrorMessage( db as ptr ) as CFStringRefcln return (__bridge CFStringRef)[NSString stringWithUTF8String:sqlite3_errmsg( (sqlite3 *)db )];end fn = NULL// stmt receives the statement handle: pass @myStatement (a ptr variable)local fn DataSQLitePrepare( db as ptr, sql as CFStringRef, stmt as ptr ) as longcln return sqlite3_prepare_v2( (sqlite3 *)db, [(__bridge NSString *)sql UTF8String], -1, (sqlite3_stmt **)stmt, NULL );end fn = 1local fn DataSQLiteStep( stmt as ptr ) as longcln return sqlite3_step( (sqlite3_stmt *)stmt );end fn = 1local fn DataSQLiteFinalize( stmt as ptr ) as longcln return sqlite3_finalize( (sqlite3_stmt *)stmt );end fn = 0// parameter index (1-based) <- NSNull / NSNumber (REAL when it holds a float) / NSData / textlocal fn DataSQLiteBind( stmt as ptr, index as long, value as CFTypeRef ) as longcln id v = (__bridge id)value; sqlite3_stmt *s = (sqlite3_stmt *)stmt; int i = (int)index; if ( v == nil || v == [NSNull null] ) return sqlite3_bind_null( s, i ); if ( [v isKindOfClass:[NSNumber class]] ) { const char *t = [v objCType]; if ( *t == 'd' || *t == 'f' ) return sqlite3_bind_double( s, i, [v doubleValue] ); return sqlite3_bind_int64( s, i, [v longLongValue] ); } if ( [v isKindOfClass:[NSData class]] ) return sqlite3_bind_blob( s, i, [v bytes], (int)[v length], SQLITE_TRANSIENT ); return sqlite3_bind_text( s, i, [[v description] UTF8String], -1, SQLITE_TRANSIENT );end fn = 1local fn DataSQLiteColumnCount( stmt as ptr ) as longcln return sqlite3_column_count( (sqlite3_stmt *)stmt );end fn = 0local fn DataSQLiteColumnName( stmt as ptr, col as long ) as CFStringRefcln return (__bridge CFStringRef)[NSString stringWithUTF8String:sqlite3_column_name( (sqlite3_stmt *)stmt, (int)col )];end fn = NULL// the current row's value in a column, as NSNumber / NSString / NSData / NSNulllocal fn DataSQLiteColumnValue( stmt as ptr, col as long ) as CFTypeRefcln sqlite3_stmt *s = (sqlite3_stmt *)stmt; int c = (int)col; switch ( sqlite3_column_type( s, c ) ) { case SQLITE_INTEGER: return (__bridge CFTypeRef)@( sqlite3_column_int64( s, c ) ); case SQLITE_FLOAT: return (__bridge CFTypeRef)@( sqlite3_column_double( s, c ) ); case SQLITE_BLOB: return (__bridge CFTypeRef)[NSData dataWithBytes:sqlite3_column_blob( s, c ) length:sqlite3_column_bytes( s, c )]; case SQLITE_NULL: return (__bridge CFTypeRef)[NSNull null]; default: return (__bridge CFTypeRef)[NSString stringWithUTF8String:(const char *)sqlite3_column_text( s, c )]; }end fn = NULL// rows changed by the last INSERT / UPDATE / DELETElocal fn DataSQLiteChanges( db as ptr ) as longcln return sqlite3_changes( (sqlite3 *)db );end fn = 0// rowid of the last INSERT, as an NSNumberlocal fn DataSQLiteLastInsertID( db as ptr ) as CFNumberRefcln return (__bridge CFNumberRef)@( sqlite3_last_insert_rowid( (sqlite3 *)db ) );end fn = NULL/* *   Run one statement on the open database.  params fill the ? placeholders in *   order; rows, when not NULL, receives one mutable dictionary per result row *   (column name -> value).  Returns _dataSQLiteDONE when the statement ran; *   any other value is SQLite's error code, logged with the message and the SQL. */local fn DataExecute( sql as CFStringRef, params as CFArrayRef, rows as CFMutableArrayRef ) as longptr                    statement = NULLlong                   result, i, columnsCFMutableDictionaryRef rowif ( gDataDB == NULL )NSLog( @"Data: no database is open (DataOpen).\nSQL: %@", sql )exit fn = 1end ifresult = fn DataSQLitePrepare( gDataDB, sql, @statement )if ( result != _dataSQLiteOK )NSLog( @"Data: prepare failed: %@\nSQL: %@", fn DataSQLiteErrorMessage( gDataDB ), sql )exit fn = resultend ifif ( params != NULL )for i = 0 to (long)fn ArrayCount( params ) - 1fn DataSQLiteBind( statement, i + 1, fn ArrayObjectAtIndex( params, i ) )nextend ifcolumns = fn DataSQLiteColumnCount( statement )result  = fn DataSQLiteStep( statement )while ( result == _dataSQLiteROW )if ( rows != NULL )row = fn MutableDictionaryNewfor i = 0 to columns - 1MutableDictionarySetObjectForKey( row, fn DataSQLiteColumnValue( statement, i ), fn DataSQLiteColumnName( statement, i ) )nextMutableArrayAddObject( rows, row )end ifresult = fn DataSQLiteStep( statement )wendif ( result != _dataSQLiteDONE ) then NSLog( @"Data: %@\nSQL: %@\nValues: %@", fn DataSQLiteErrorMessage( gDataDB ), sql, params )fn DataSQLiteFinalize( statement )end fn = result/* *   Transactions.  DataBegin / DataEnd nest: only the outermost pair talks to *   SQLite.  A part that ends with keep = NO marks the whole transaction, and the *   outermost DataEnd rolls everything back - how a failed rule undoes a save and *   every change it chained to.  DataEnd returns YES when the work was kept (so far). */local fn DataBegin as BOOLif ( gDataTransactionDepth == 0 )if ( fn DataExecute( @"BEGIN IMMEDIATE", NULL, NULL ) != _dataSQLiteDONE ) then exit fn = NOgDataRollbackOnly = NOend ifgDataTransactionDepth++end fn = YESlocal fn DataEnd( keep as BOOL ) as BOOLif ( gDataTransactionDepth == 0 ) then exit fn = NOif ( keep == NO ) then gDataRollbackOnly = YESgDataTransactionDepth--if ( gDataTransactionDepth > 0 ) then exit fn = ( gDataRollbackOnly == NO )if ( gDataRollbackOnly )fn DataExecute( @"ROLLBACK", NULL, NULL )exit fn = NOend ifend fn = ( fn DataExecute( @"COMMIT", NULL, NULL ) == _dataSQLiteDONE )