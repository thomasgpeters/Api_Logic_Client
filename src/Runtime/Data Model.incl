/* *   I M A G E R Y    B U S I N E S S     S Y S T E M S,   L L C * *   Data Model.incl - runtime, copied into every generated app * *   The entities the data runtime works with, from the app's Model.json (written by *   Api Logic Client):  name, kind (table/view), fields, keys, keyKind and *   relationships, plus "database", the project's SQLite file. * *   relationships   { name, direction, resource, fks, parentKeys } *       toone   on the child:  name = the parent role (e.g. "Customer"), *               fks = child columns, parentKeys = the parent's columns they hold *       tomany  on the parent: name = "<Child>List", same fks / parentKeys */begin globalsCFDictionaryRef gDataEntities          // entity name -> its Model.json entryCFStringRef     gDataDatabasePath      // Model.json "database"end globalslocal fn DataModelLoad as BOOLCFURLRef               urlCFDataRef              dtaCFDictionaryRef        json, entryCFArrayRef             entriesCFMutableDictionaryRef byName = fn MutableDictionaryNewErrorRef               err = NULLurl = fn BundleURLForResource( fn BundleMain, @"Model", @"json", NULL )if ( url == NULL )NSLog( @"Data: Model.json is not in the app bundle." )exit fn = NOend ifdta = fn DataWithContentsOfURL( url, 0, @err )if ( dta == NULL ) then exit fn = NOjson = fn JSONSerializationJSONObjectWithData( dta, 0, @err )if ( json == NULL )NSLog( @"Data: Model.json is not valid JSON: %@", fn ErrorLocalizedDescription( err ) )exit fn = NOend ifentries = fn DictionaryObjectForKey( json, @"resources" )for entry in entriesMutableDictionarySetObjectForKey( byName, entry, fn DictionaryObjectForKey( entry, @"name" ) )nextgDataEntities     = byNamegDataDatabasePath = fn DictionaryObjectForKey( json, @"database" )end fn = YESlocal fn DataEntity( entityName as CFStringRef ) as CFDictionaryRefif ( gDataEntities == NULL ) then fn DataModelLoadend fn = fn DictionaryObjectForKey( gDataEntities, entityName )// the entity's column names, in column orderlocal fn DataColumns( entityName as CFStringRef ) as CFArrayRefCFMutableArrayRef names = fn MutableArrayNewCFArrayRef        fields = fn DictionaryObjectForKey( fn DataEntity( entityName ), @"fields" )CFDictionaryRef   fieldfor field in fieldsMutableArrayAddObject( names, fn DictionaryObjectForKey( field, @"name" ) )nextend fn = names// primary-key columns, in key order (empty for a table without a key, and for views)local fn DataKeys( entityName as CFStringRef ) as CFArrayRefCFArrayRef keys = fn DictionaryObjectForKey( fn DataEntity( entityName ), @"keys" )if ( keys == NULL ) then keys = @[]end fn = keys// identity | autoincrement (SQLite assigns the key) | assigned | nonelocal fn DataKeyKind( entityName as CFStringRef ) as CFStringRefCFStringRef keyKind = fn DictionaryObjectForKey( fn DataEntity( entityName ), @"keyKind" )if ( keyKind == NULL ) then keyKind = @"none"end fn = keyKindlocal fn DataKeyIsGenerated( entityName as CFStringRef ) as BOOLCFStringRef keyKind = fn DataKeyKind( entityName )end fn = ( fn StringIsEqual( keyKind, @"identity" ) || fn StringIsEqual( keyKind, @"autoincrement" ) )local fn DataIsView( entityName as CFStringRef ) as BOOLend fn = fn StringIsEqual( fn DictionaryObjectForKey( fn DataEntity( entityName ), @"kind" ), @"view" )// a relationship of the entity by its name: a parent role (toone) or a child list (tomany)local fn DataRelationship( entityName as CFStringRef, roleName as CFStringRef ) as CFDictionaryRefCFArrayRef      relationships = fn DictionaryObjectForKey( fn DataEntity( entityName ), @"relationships" )CFDictionaryRef relationshipfor relationship in relationshipsif ( fn StringIsEqual( fn DictionaryObjectForKey( relationship, @"name" ), roleName ) ) then exit fn = relationshipnextend fn = NULL