/* *   I M A G E R Y    B U S I N E S S     S Y S T E M S,   L L C * *   Pill Buttons.incl - Mac-style pill (capsule) push buttons * *   PillButton( tag, kind ) turns a push button - made in code, or loaded from a XIB (it is *   found by its tag) - into a pill: *       macOS 26 and later   AppKit's own capsule (ButtonSetBorderShape, NSControlBorderShapeCapsule): *                            the system draws it - light and dark, pressed, disabled, the *                            window's Return button in the accent colour. *       macOS 15             the property does not exist there (calling it would stop the app), *                            so the button's layer draws the same shape: borderless, rounded to *                            half its height, filled with a system colour. *   kind  _pillPlain        an ordinary action (Cancel, Choose..., Refresh) *         _pillDefault      the main action (Create, Save; Return on macOS 26 needs no more) *         _pillDestructive  an action that removes something (Delete) * *   One copy in the Studio (src/Generator) and one in the runtime every generated app gets *   (src/Runtime); tools/run_tests.sh checks they are identical. * *   MIT License. Copyright (c) 2026 Imagery Business Systems, LLC. */begin enum 0_pillPlain_pillDefault_pillDestructiveend enum#define PILL_FALLBACK_HEIGHT 24     // macOS 15: the pill's height inside a push button's taller frame#define PILL_FALLBACK_INSET   6     // ... and its inset from the frame's sides (as a push button's bezel)// does AppKit draw capsule buttons itself?  (macOS 26 and later)local fn PillButtonsNative as BOOLNSOperatingSystemVersion versionversion.majorVersion = 26version.minorVersion = 0version.patchVersion = 0end fn = fn ProcessInfoIsOperatingSystemAtLeastVersion( version )// macOS 15: the capsule drawn by the button's layervoid local fn PillButtonDrawn( tag as long, kind as long )CGRect     r = fn ViewFrame( tag )CALayerRef layerif ( r.size.height > PILL_FALLBACK_HEIGHT )                   // keep it where the push button's bezel wasr.origin.y    = r.origin.y + ( r.size.height - PILL_FALLBACK_HEIGHT ) / 2r.size.height = PILL_FALLBACK_HEIGHTr.origin.x    = r.origin.x + PILL_FALLBACK_INSETr.size.width  = r.size.width - PILL_FALLBACK_INSET * 2ViewSetFrame( tag, r )end ifButtonSetBordered( tag, NO )ViewSetWantsLayer( tag, YES )layer = fn ViewLayer( tag )if ( layer == NULL ) then exit fnCALayerSetCornerRadius( layer, r.size.height / 2 )CALayerSetMasksToBounds( layer, YES )select ( kind )case _pillDefaultCALayerSetBackgroundColor( layer, fn ColorControlAccent )ButtonSetContentTintColor( tag, fn ColorWhite )case _pillDestructiveCALayerSetBackgroundColor( layer, fn ColorSystemRed )ButtonSetContentTintColor( tag, fn ColorWhite )case elseCALayerSetBackgroundColor( layer, fn ColorSecondarySystemFill )   // a translucent grey: right in light and darkButtonSetContentTintColor( tag, fn ColorLabel )end selectend fn// a push button -> a pill (after the button exists: after nibview, or after the button statement)void local fn PillButton( tag as long, kind as long )if ( tag == 0 ) then exit fnif ( fn PillButtonsNative )ButtonSetBezelStyle( tag, NSBezelStylePush )ButtonSetBorderShape( tag, NSControlBorderShapeCapsule )if ( kind == _pillDestructive ) then ButtonSetHasDestructiveAction( tag, YES )exit fnend iffn PillButtonDrawn( tag, kind )end fn