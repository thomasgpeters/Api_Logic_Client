/* *   I M A G E R Y    B U S I N E S S     S Y S T E M S,   L L C * *   Auto Complete.incl - runtime: a text field that finds a related record as you type * *   Type a few letters and the matches appear in a list right under the field, or above it when the field is low in *   the window. The matches come from one of two places: *     - a related table (a foreign key: an Order's Customer): its records, the key stored, the name shown; *     - local values (the attribute's Values list: "Retail, Wholesale" or "R = Retail, W = Wholesale"): the code *       stored, the label shown; with "allow other values", whatever the user types is kept as it is, and is *       offered from then on: new values are remembered in the app's preferences (its plist), one list per field. Choose one (click, or the arrow keys and *   Return) and the field shows its name; the key is kept behind the scenes and saved with the record. Escape closes *   the list. The records are the lookup rows App Pages.incl already asks for (the same as a Dropdown's). * *   <Entity> Binding.incl, generated, uses it like this: *       fn AutoCompleteAttach( _orderCustomerId, 1, 8 )                       // FormSetUp: letters before results, most results *       fn AutoCompleteSetRecords( _orderCustomerId, records, @"Id", @"CompanyName" )   // FillLookup: the rows arrived *       fn AutoCompleteSetValues( _orderChannel, @[ @"Retail", @"Wholesale" ], @[ @"R", @"W" ], NO, @"Order.Channel" )   // local values, in FormSetUp *       fn AutoCompleteShow( _orderCustomerId, aRecord, @"CustomerId" )       // RecordToForm: the key's name shown *       fn AutoCompleteTake( aRecord, @"CustomerId", _orderCustomerId )       // FormToRecord: the chosen key saved * *   The list is Cocoa (a small panel with a table, attached to the field's window); no FB tags inside it. * *   MIT License. Copyright (c) 2026 Imagery Business Systems, LLC. */// the C functions FB calls, declared for every part of the project (FB compiles in several chunks)BeginCDeclarationCFTypeRef ACChosenKey( long tag );void ACSetRecords( long tag, CFArrayRef records, CFStringRef keyName, CFStringRef displayName );void ACSetValues( long tag, CFArrayRef labels, CFArrayRef codes, long allowsOther, CFStringRef listName );void ACShowKey( long tag, CFTypeRef key );CFTypeRef ACValueToStore( long tag );void AutoCompleteAttachView( void *fieldView, long tag, long minChars, long maxResults );CFDictionaryRef AutoCompleteChosenRecord( long tag );long AutoCompleteIsField( long tag );EndCBeginCFunction@interface ABAutoComplete : NSObject <NSTableViewDataSource, NSTableViewDelegate>@property (assign) NSTextField *field;@property (assign) long minChars;@property (assign) long maxResults;@property (strong) NSArray *records;@property (strong) NSString *keyName;@property (strong) NSString *displayName;@property (strong) NSArray *matches;@property (strong) id chosenKey;@property (strong) NSDictionary *chosenRecord;@property (strong) id wantedKey;@property (assign) BOOL allowsOther;@property (strong) NSString *listName;@property (strong) NSPanel *panel;@property (strong) NSTableView *table;@property (strong) id keyMonitor;@endstatic NSMutableDictionary *abAutoCompletes = nil;static NSString *ABACText( NSDictionary *aRecord, NSString *name ) {    id value = ( aRecord && name ) ? aRecord[name] : nil;    if ( value == nil || value == [NSNull null] ) return @"";    return [value description];}static BOOL ABACSameKey( id a, id b ) {    if ( a == nil || b == nil || a == [NSNull null] || b == [NSNull null] ) return NO;    return [[a description] isEqualToString:[b description]];}@implementation ABAutoComplete// a record chosen or cleared: the field's info button (a lookup's, 40000 + the field's tag: Record Popover.incl) is on// only while one is chosen - with nothing chosen there is nothing to show (author, 2026-11-27)- (void)updateInfoButton {    NSView *info = [self.field.window.contentView viewWithTag:40000 + self.field.tag];    if ( [info isKindOfClass:[NSButton class]] ) ((NSButton *)info).enabled = ( self.chosenRecord != nil );}- (void)textChanged:(NSNotification *)note {    NSString *typed = self.field.stringValue;    NSMutableArray *starts = [NSMutableArray array], *contains = [NSMutableArray array];    if ( self.chosenRecord && ![typed isEqualToString:ABACText( self.chosenRecord, self.displayName )] ) {        self.chosenRecord = nil; self.chosenKey = nil; self.wantedKey = nil; [self updateInfoButton];    // typing again: nothing chosen until a new choice    }    if ( (long)typed.length < self.minChars || self.records.count == 0 ) { [self hideList]; return; }    for ( NSDictionary *aRecord in self.records ) {        NSString *text = ABACText( aRecord, self.displayName );        NSRange found = [text rangeOfString:typed options:NSCaseInsensitiveSearch | NSDiacriticInsensitiveSearch];        if ( found.location == NSNotFound ) continue;        if ( found.location == 0 ) [starts addObject:aRecord]; else [contains addObject:aRecord];    }    [starts addObjectsFromArray:contains];                                     // names that start with it first    if ( (long)starts.count > self.maxResults ) [starts removeObjectsInRange:NSMakeRange( self.maxResults, starts.count - self.maxResults )];    self.matches = starts;    if ( starts.count == 0 ) [self hideList]; else [self showList];}- (void)editingEnded:(NSNotification *)note {    [self performSelector:@selector(hideList) withObject:nil afterDelay:0.2];  // after a click in the list has landed}- (void)makePanel {    NSScrollView *scroll;    NSTableColumn *column;    NSVisualEffectView *back;    if ( self.panel ) return;    self.panel = [[NSPanel alloc] initWithContentRect:NSMakeRect( 0, 0, 240, 100 ) styleMask:NSWindowStyleMaskBorderless | NSWindowStyleMaskNonactivatingPanel backing:NSBackingStoreBuffered defer:YES];    self.panel.hasShadow = YES;    self.panel.opaque = NO;    self.panel.backgroundColor = [NSColor clearColor];    back = [[NSVisualEffectView alloc] initWithFrame:NSMakeRect( 0, 0, 240, 100 )];    back.material = NSVisualEffectMaterialMenu;    back.state = NSVisualEffectStateActive;    back.wantsLayer = YES;    back.layer.cornerRadius = 6.0;    back.layer.masksToBounds = YES;    self.panel.contentView = back;    self.table = [[NSTableView alloc] initWithFrame:NSMakeRect( 0, 0, 240, 100 )];    column = [[NSTableColumn alloc] initWithIdentifier:@"name"];    column.resizingMask = NSTableColumnAutoresizingMask;    [self.table addTableColumn:column];    self.table.headerView = nil;    self.table.rowHeight = 20.0;    self.table.backgroundColor = [NSColor clearColor];    self.table.columnAutoresizingStyle = NSTableViewLastColumnOnlyAutoresizingStyle;    self.table.dataSource = self;    self.table.delegate = self;    self.table.target = self;    self.table.action = @selector(listClicked:);    scroll = [[NSScrollView alloc] initWithFrame:NSMakeRect( 0, 4, 240, 92 )];    scroll.documentView = self.table;    scroll.hasVerticalScroller = YES;    scroll.drawsBackground = NO;    scroll.borderType = NSNoBorder;    scroll.autoresizingMask = NSViewWidthSizable | NSViewHeightSizable;    [back addSubview:scroll];}- (void)showList {    NSWindow *window = self.field.window;    NSRect inWindow, onScreen;    CGFloat height, width, y;    if ( window == nil ) return;    [self makePanel];    [self.table reloadData];    [self.table deselectAll:nil];    inWindow = [self.field convertRect:self.field.bounds toView:nil];    onScreen = [window convertRectToScreen:inWindow];    height = self.matches.count * ( self.table.rowHeight + self.table.intercellSpacing.height ) + 8.0;    width = MAX( onScreen.size.width, 240.0 );    y = onScreen.origin.y - height - 2.0;                                        // under the field ...    if ( y < NSMinY( window.frame ) + 4.0 ) y = NSMaxY( onScreen ) + 2.0;      // ... or above it, when it is low in the window    [self.panel setFrame:NSMakeRect( onScreen.origin.x, y, width, height ) display:YES];    if ( self.panel.parentWindow == nil ) [window addChildWindow:self.panel ordered:NSWindowAbove];    [self.panel orderFront:nil];    if ( self.keyMonitor == nil ) {        __unsafe_unretained ABAutoComplete *me = self;        self.keyMonitor = [NSEvent addLocalMonitorForEventsMatchingMask:NSEventMaskKeyDown handler:^NSEvent *( NSEvent *event ) {            NSInteger row;            if ( !me.panel.isVisible || me.field.currentEditor == nil ) return event;            row = me.table.selectedRow;            switch ( event.keyCode ) {                case 125:                                                        // down                    row = MIN( row + 1, (NSInteger)me.matches.count - 1 );                    [me.table selectRowIndexes:[NSIndexSet indexSetWithIndex:row] byExtendingSelection:NO];                    [me.table scrollRowToVisible:row];                    return nil;                case 126:                                                        // up                    if ( row > 0 ) { [me.table selectRowIndexes:[NSIndexSet indexSetWithIndex:row - 1] byExtendingSelection:NO]; [me.table scrollRowToVisible:row - 1]; }                    return nil;                case 36: case 76:                                                // Return, Enter                    if ( row < 0 ) return event;                    [me choose:row];                    return nil;                case 53:                                                         // Escape                    [me hideList];                    return nil;            }            return event;        }];    }}- (void)hideList {    if ( self.panel == nil ) return;    if ( self.panel.parentWindow ) [self.panel.parentWindow removeChildWindow:self.panel];    [self.panel orderOut:nil];}- (void)choose:(NSInteger)row {    NSDictionary *aRecord;    if ( row < 0 || row >= (NSInteger)self.matches.count ) return;    aRecord = self.matches[row];    self.chosenRecord = aRecord;    self.chosenKey = aRecord[self.keyName];    self.wantedKey = nil;    self.field.stringValue = ABACText( aRecord, self.displayName );    [self updateInfoButton];    [self hideList];}- (void)listClicked:(id)sender { [self choose:self.table.clickedRow]; }- (void)showKey:(id)key {    self.chosenRecord = nil;    self.chosenKey = ( key == [NSNull null] ) ? nil : key;    self.wantedKey = self.chosenKey;    self.field.stringValue = @"";    [self updateInfoButton];    if ( self.chosenKey == nil ) return;    for ( NSDictionary *aRecord in self.records ) {        if ( ABACSameKey( aRecord[self.keyName], self.chosenKey ) ) {            self.chosenRecord = aRecord;            self.field.stringValue = ABACText( aRecord, self.displayName );            self.wantedKey = nil;            [self updateInfoButton];            return;        }    }    if ( self.allowsOther && self.records.count > 0 ) {                         // local values: a value of its own        self.field.stringValue = [self.chosenKey description];        self.wantedKey = nil;    }}- (NSInteger)numberOfRowsInTableView:(NSTableView *)tableView { return (NSInteger)self.matches.count; }- (NSView *)tableView:(NSTableView *)tableView viewForTableColumn:(NSTableColumn *)tableColumn row:(NSInteger)row {    NSTextField *label = [NSTextField labelWithString:ABACText( self.matches[row], self.displayName )];    label.lineBreakMode = NSLineBreakByTruncatingTail;    return label;}@endstatic ABAutoComplete *ABACFor( long tag ) { return abAutoCompletes ? abAutoCompletes[@(tag)] : nil; }// the field (by its view) becomes an auto-complete: results after minChars letters, at most maxResults of themvoid AutoCompleteAttachView( void *fieldView, long tag, long minChars, long maxResults ) {    ABAutoComplete *ac;    NSTextField *field = (__bridge NSTextField *)fieldView;    if ( field == nil || ![field isKindOfClass:[NSTextField class]] ) return;    if ( abAutoCompletes == nil ) abAutoCompletes = [[NSMutableDictionary alloc] init];    ac = ABACFor( tag );    if ( ac == nil ) {        ac = [[ABAutoComplete alloc] init];        abAutoCompletes[@(tag)] = ac;        ac.field = field;        [[NSNotificationCenter defaultCenter] addObserver:ac selector:@selector(textChanged:) name:NSControlTextDidChangeNotification object:field];        [[NSNotificationCenter defaultCenter] addObserver:ac selector:@selector(editingEnded:) name:NSControlTextDidEndEditingNotification object:field];    }    ac.minChars = minChars < 1 ? 1 : minChars;    ac.maxResults = maxResults < 1 ? 8 : maxResults;}// the rows to choose from (the lookup table), the key column and the column shownvoid ACSetRecords( long tag, CFArrayRef records, CFStringRef keyName, CFStringRef displayName ) {    ABAutoComplete *ac = ABACFor( tag );    if ( ac == nil ) return;    ac.records = records ? [(__bridge NSArray *)records copy] : @[];    ac.keyName = (__bridge NSString *)keyName;    ac.displayName = (__bridge NSString *)displayName;    if ( ac.wantedKey ) [ac showKey:ac.wantedKey];                            // a record shown before its rows arrived}// local values: labels shown, codes stored (the same array twice for a plain list); allowsOther keeps typed text// the values a user added (allow other values), kept in the app's preferences plist: "Auto-complete <Entity.attribute>"static NSString *ABACDefaultsKey( NSString *listName ) { return [@"Auto-complete " stringByAppendingString:listName ?: @""]; }void ACSetValues( long tag, CFArrayRef labels, CFArrayRef codes, long allowsOther, CFStringRef listName ) {    ABAutoComplete *ac = ABACFor( tag );    NSArray *ls = (__bridge NSArray *)labels, *cs = (__bridge NSArray *)codes, *added;    NSMutableArray *rows = [NSMutableArray array];    if ( ac == nil || ls == nil ) return;    for ( NSUInteger i = 0; i < ls.count; i++ ) [rows addObject:@{ @"code":( cs && i < cs.count ) ? cs[i] : ls[i], @"label":ls[i] }];    ac.allowsOther = allowsOther != 0;    ac.listName = (__bridge NSString *)listName;    if ( ac.allowsOther && ac.listName.length > 0 ) {        added = [[NSUserDefaults standardUserDefaults] arrayForKey:ABACDefaultsKey( ac.listName )];        for ( NSString *value in added ) {            BOOL known = NO;            for ( NSDictionary *row in rows ) if ( [row[@"label"] caseInsensitiveCompare:value] == NSOrderedSame ) { known = YES; break; }            if ( !known && [value isKindOfClass:[NSString class]] ) [rows addObject:@{ @"code":value, @"label":value }];        }    }    ACSetRecords( tag, (__bridge CFArrayRef)rows, CFSTR( "code" ), CFSTR( "label" ) );}// what to store: the chosen key, or (local values that allow it) the text as typed; NULL when nothingCFTypeRef ACValueToStore( long tag ) {    ABAutoComplete *ac = ABACFor( tag );    NSString *typed;    if ( ac == nil ) return NULL;    if ( ac.chosenKey ) return (__bridge CFTypeRef)ac.chosenKey;    typed = [ac.field.stringValue stringByTrimmingCharactersInSet:[NSCharacterSet whitespaceAndNewlineCharacterSet]];    if ( ac.allowsOther && typed.length > 0 ) {        NSMutableArray *added, *rows;        for ( NSDictionary *aRecord in ac.records )                             // a label typed in full: its code            if ( [ABACText( aRecord, ac.displayName ) caseInsensitiveCompare:typed] == NSOrderedSame ) return (__bridge CFTypeRef)aRecord[ac.keyName];        // a new value: offered from now on, and remembered in the app's preferences for the next launch        rows = [ac.records mutableCopy];        [rows addObject:@{ @"code":typed, @"label":typed }];        ac.records = rows;        if ( ac.listName.length > 0 ) {            added = [[[NSUserDefaults standardUserDefaults] arrayForKey:ABACDefaultsKey( ac.listName )] mutableCopy] ?: [NSMutableArray array];            [added addObject:typed];            [[NSUserDefaults standardUserDefaults] setObject:added forKey:ABACDefaultsKey( ac.listName )];        }        ac.chosenKey = typed;        return (__bridge CFTypeRef)typed;    }    return NULL;}void ACShowKey( long tag, CFTypeRef key ) {    ABAutoComplete *ac = ABACFor( tag );    if ( ac ) [ac showKey:(__bridge id)key];}// the chosen record's key (NULL when nothing is chosen)CFTypeRef ACChosenKey( long tag ) {    ABAutoComplete *ac = ABACFor( tag );    return ac ? (__bridge CFTypeRef)ac.chosenKey : NULL;}// the chosen record, all its columns (NULL when nothing is chosen): the info button's popover shows itCFDictionaryRef AutoCompleteChosenRecord( long tag ) {    ABAutoComplete *ac = ABACFor( tag );    return ac ? (__bridge CFDictionaryRef)ac.chosenRecord : NULL;}long AutoCompleteIsField( long tag ) { return ABACFor( tag ) != nil; }EndCtoolbox AutoCompleteAttachView( ptr fieldView, long tag, long minChars, long maxResults )toolbox ACSetRecords( long tag, CFArrayRef records, CFStringRef keyName, CFStringRef displayName )toolbox ACSetValues( long tag, CFArrayRef labels, CFArrayRef codes, long allowsOther, CFStringRef listName )toolbox fn ACValueToStore( long tag ) = CFTypeReftoolbox ACShowKey( long tag, CFTypeRef key )toolbox fn ACChosenKey( long tag ) = CFTypeReftoolbox fn AutoCompleteChosenRecord( long tag ) = CFDictionaryReftoolbox fn AutoCompleteIsField( long tag ) = long// the text field with this tag (on a Form) becomes an auto-completevoid local fn AutoCompleteAttach( tag as long, minChars as long, maxResults as long )ViewRef fieldView = fn ShellFindView( tag )if ( fieldView == NULL ) then exit fnAutoCompleteAttachView( fieldView, tag, minChars, maxResults )end fn// a lookup table's rows arrived: the records to choose fromvoid local fn AutoCompleteSetRecords( tag as long, records as CFArrayRef, keyName as CFStringRef, displayName as CFStringRef )ACSetRecords( tag, records, keyName, displayName )end fn// local values: what the list offers (labels shown, codes stored; pass the same array twice for a plain list).// allowsOther YES keeps a value the user types that is not in the list, and remembers it (the app's preferences,// under listName: "Entity.attribute") so it is offered after the next launch too.void local fn AutoCompleteSetValues( tag as long, labels as CFArrayRef, codes as CFArrayRef, allowsOther as BOOL, listName as CFStringRef )ACSetValues( tag, labels, codes, allowsOther, listName )end fn// record -> Form: the name of the record its key points atvoid local fn AutoCompleteShow( tag as long, aRecord as CFDictionaryRef, name as CFStringRef )ACShowKey( tag, fn DictionaryObjectForKey( aRecord, name ) )end fn// Form -> record: the chosen key, or the typed value where other values are allowed (left out when nothing: NULL)void local fn AutoCompleteTake( aRecord as CFMutableDictionaryRef, name as CFStringRef, tag as long )CFTypeRef key = fn ACValueToStore( tag )if ( key != NULL ) then MutableDictionarySetObjectForKey( aRecord, key, name )end fn