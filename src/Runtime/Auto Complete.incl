/* *   I M A G E R Y    B U S I N E S S     S Y S T E M S,   L L C * *   Auto Complete.incl - runtime: a text field that finds a related record as you type * *   For a foreign key (an Order's Customer): type a few letters and the matching records appear in a list right *   under the field, or above it when the field is low in the window. Choose one (click, or the arrow keys and *   Return) and the field shows its name; the key is kept behind the scenes and saved with the record. Escape closes *   the list. The records are the lookup rows App Pages.incl already asks for (the same as a Dropdown's). * *   <Entity> Binding.incl, generated, uses it like this: *       fn AutoCompleteAttach( _orderCustomerId, 1, 8 )                       // FormSetUp: letters before results, most results *       fn AutoCompleteSetRecords( _orderCustomerId, records, @"Id", @"CompanyName" )   // FillLookup: the rows arrived *       fn AutoCompleteShow( _orderCustomerId, aRecord, @"CustomerId" )       // RecordToForm: the key's name shown *       fn AutoCompleteTake( aRecord, @"CustomerId", _orderCustomerId )       // FormToRecord: the chosen key saved * *   The list is Cocoa (a small panel with a table, attached to the field's window); no FB tags inside it. * *   MIT License. Copyright (c) 2026 Imagery Business Systems, LLC. */BeginCFunction@interface ABAutoComplete : NSObject <NSTableViewDataSource, NSTableViewDelegate>@property (assign) NSTextField *field;@property (assign) long minChars;@property (assign) long maxResults;@property (strong) NSArray *records;@property (strong) NSString *keyName;@property (strong) NSString *displayName;@property (strong) NSArray *matches;@property (strong) id chosenKey;@property (strong) NSDictionary *chosenRecord;@property (strong) id wantedKey;@property (strong) NSPanel *panel;@property (strong) NSTableView *table;@property (strong) id keyMonitor;@endstatic NSMutableDictionary *abAutoCompletes = nil;static NSString *ABACText( NSDictionary *aRecord, NSString *name ) {    id value = ( aRecord && name ) ? aRecord[name] : nil;    if ( value == nil || value == [NSNull null] ) return @"";    return [value description];}static BOOL ABACSameKey( id a, id b ) {    if ( a == nil || b == nil || a == [NSNull null] || b == [NSNull null] ) return NO;    return [[a description] isEqualToString:[b description]];}@implementation ABAutoComplete- (void)textChanged:(NSNotification *)note {    NSString *typed = self.field.stringValue;    NSMutableArray *starts = [NSMutableArray array], *contains = [NSMutableArray array];    if ( self.chosenRecord && ![typed isEqualToString:ABACText( self.chosenRecord, self.displayName )] ) {        self.chosenRecord = nil; self.chosenKey = nil; self.wantedKey = nil;    // typing again: nothing chosen until a new choice    }    if ( (long)typed.length < self.minChars || self.records.count == 0 ) { [self hideList]; return; }    for ( NSDictionary *aRecord in self.records ) {        NSString *text = ABACText( aRecord, self.displayName );        NSRange found = [text rangeOfString:typed options:NSCaseInsensitiveSearch | NSDiacriticInsensitiveSearch];        if ( found.location == NSNotFound ) continue;        if ( found.location == 0 ) [starts addObject:aRecord]; else [contains addObject:aRecord];    }    [starts addObjectsFromArray:contains];                                     // names that start with it first    if ( (long)starts.count > self.maxResults ) [starts removeObjectsInRange:NSMakeRange( self.maxResults, starts.count - self.maxResults )];    self.matches = starts;    if ( starts.count == 0 ) [self hideList]; else [self showList];}- (void)editingEnded:(NSNotification *)note {    [self performSelector:@selector(hideList) withObject:nil afterDelay:0.2];  // after a click in the list has landed}- (void)makePanel {    NSScrollView *scroll;    NSTableColumn *column;    NSVisualEffectView *back;    if ( self.panel ) return;    self.panel = [[NSPanel alloc] initWithContentRect:NSMakeRect( 0, 0, 240, 100 ) styleMask:NSWindowStyleMaskBorderless | NSWindowStyleMaskNonactivatingPanel backing:NSBackingStoreBuffered defer:YES];    self.panel.hasShadow = YES;    self.panel.opaque = NO;    self.panel.backgroundColor = [NSColor clearColor];    back = [[NSVisualEffectView alloc] initWithFrame:NSMakeRect( 0, 0, 240, 100 )];    back.material = NSVisualEffectMaterialMenu;    back.state = NSVisualEffectStateActive;    back.wantsLayer = YES;    back.layer.cornerRadius = 6.0;    back.layer.masksToBounds = YES;    self.panel.contentView = back;    self.table = [[NSTableView alloc] initWithFrame:NSMakeRect( 0, 0, 240, 100 )];    column = [[NSTableColumn alloc] initWithIdentifier:@"name"];    column.resizingMask = NSTableColumnAutoresizingMask;    [self.table addTableColumn:column];    self.table.headerView = nil;    self.table.rowHeight = 20.0;    self.table.backgroundColor = [NSColor clearColor];    self.table.columnAutoresizingStyle = NSTableViewLastColumnOnlyAutoresizingStyle;    self.table.dataSource = self;    self.table.delegate = self;    self.table.target = self;    self.table.action = @selector(listClicked:);    scroll = [[NSScrollView alloc] initWithFrame:NSMakeRect( 0, 4, 240, 92 )];    scroll.documentView = self.table;    scroll.hasVerticalScroller = YES;    scroll.drawsBackground = NO;    scroll.borderType = NSNoBorder;    scroll.autoresizingMask = NSViewWidthSizable | NSViewHeightSizable;    [back addSubview:scroll];}- (void)showList {    NSWindow *window = self.field.window;    NSRect inWindow, onScreen;    CGFloat height, width, y;    if ( window == nil ) return;    [self makePanel];    [self.table reloadData];    [self.table deselectAll:nil];    inWindow = [self.field convertRect:self.field.bounds toView:nil];    onScreen = [window convertRectToScreen:inWindow];    height = self.matches.count * ( self.table.rowHeight + self.table.intercellSpacing.height ) + 8.0;    width = MAX( onScreen.size.width, 240.0 );    y = onScreen.origin.y - height - 2.0;                                        // under the field ...    if ( y < NSMinY( window.frame ) + 4.0 ) y = NSMaxY( onScreen ) + 2.0;      // ... or above it, when it is low in the window    [self.panel setFrame:NSMakeRect( onScreen.origin.x, y, width, height ) display:YES];    if ( self.panel.parentWindow == nil ) [window addChildWindow:self.panel ordered:NSWindowAbove];    [self.panel orderFront:nil];    if ( self.keyMonitor == nil ) {        __unsafe_unretained ABAutoComplete *me = self;        self.keyMonitor = [NSEvent addLocalMonitorForEventsMatchingMask:NSEventMaskKeyDown handler:^NSEvent *( NSEvent *event ) {            NSInteger row;            if ( !me.panel.isVisible || me.field.currentEditor == nil ) return event;            row = me.table.selectedRow;            switch ( event.keyCode ) {                case 125:                                                        // down                    row = MIN( row + 1, (NSInteger)me.matches.count - 1 );                    [me.table selectRowIndexes:[NSIndexSet indexSetWithIndex:row] byExtendingSelection:NO];                    [me.table scrollRowToVisible:row];                    return nil;                case 126:                                                        // up                    if ( row > 0 ) { [me.table selectRowIndexes:[NSIndexSet indexSetWithIndex:row - 1] byExtendingSelection:NO]; [me.table scrollRowToVisible:row - 1]; }                    return nil;                case 36: case 76:                                                // Return, Enter                    if ( row < 0 ) return event;                    [me choose:row];                    return nil;                case 53:                                                         // Escape                    [me hideList];                    return nil;            }            return event;        }];    }}- (void)hideList {    if ( self.panel == nil ) return;    if ( self.panel.parentWindow ) [self.panel.parentWindow removeChildWindow:self.panel];    [self.panel orderOut:nil];}- (void)choose:(NSInteger)row {    NSDictionary *aRecord;    if ( row < 0 || row >= (NSInteger)self.matches.count ) return;    aRecord = self.matches[row];    self.chosenRecord = aRecord;    self.chosenKey = aRecord[self.keyName];    self.wantedKey = nil;    self.field.stringValue = ABACText( aRecord, self.displayName );    [self hideList];}- (void)listClicked:(id)sender { [self choose:self.table.clickedRow]; }- (void)showKey:(id)key {    self.chosenRecord = nil;    self.chosenKey = ( key == [NSNull null] ) ? nil : key;    self.wantedKey = self.chosenKey;    self.field.stringValue = @"";    if ( self.chosenKey == nil ) return;    for ( NSDictionary *aRecord in self.records ) {        if ( ABACSameKey( aRecord[self.keyName], self.chosenKey ) ) {            self.chosenRecord = aRecord;            self.field.stringValue = ABACText( aRecord, self.displayName );            self.wantedKey = nil;            return;        }    }}- (NSInteger)numberOfRowsInTableView:(NSTableView *)tableView { return (NSInteger)self.matches.count; }- (NSView *)tableView:(NSTableView *)tableView viewForTableColumn:(NSTableColumn *)tableColumn row:(NSInteger)row {    NSTextField *label = [NSTextField labelWithString:ABACText( self.matches[row], self.displayName )];    label.lineBreakMode = NSLineBreakByTruncatingTail;    return label;}@endstatic ABAutoComplete *ABACFor( long tag ) { return abAutoCompletes ? abAutoCompletes[@(tag)] : nil; }// the field (by its view) becomes an auto-complete: results after minChars letters, at most maxResults of themvoid AutoCompleteAttachView( void *fieldView, long tag, long minChars, long maxResults ) {    ABAutoComplete *ac;    NSTextField *field = (__bridge NSTextField *)fieldView;    if ( field == nil || ![field isKindOfClass:[NSTextField class]] ) return;    if ( abAutoCompletes == nil ) abAutoCompletes = [[NSMutableDictionary alloc] init];    ac = ABACFor( tag );    if ( ac == nil ) {        ac = [[ABAutoComplete alloc] init];        abAutoCompletes[@(tag)] = ac;        ac.field = field;        [[NSNotificationCenter defaultCenter] addObserver:ac selector:@selector(textChanged:) name:NSControlTextDidChangeNotification object:field];        [[NSNotificationCenter defaultCenter] addObserver:ac selector:@selector(editingEnded:) name:NSControlTextDidEndEditingNotification object:field];    }    ac.minChars = minChars < 1 ? 1 : minChars;    ac.maxResults = maxResults < 1 ? 8 : maxResults;}// the rows to choose from (the lookup table), the key column and the column shownvoid ACSetRecords( long tag, CFArrayRef records, CFStringRef keyName, CFStringRef displayName ) {    ABAutoComplete *ac = ABACFor( tag );    if ( ac == nil ) return;    ac.records = records ? [(__bridge NSArray *)records copy] : @[];    ac.keyName = (__bridge NSString *)keyName;    ac.displayName = (__bridge NSString *)displayName;    if ( ac.wantedKey ) [ac showKey:ac.wantedKey];                            // a record shown before its rows arrived}void ACShowKey( long tag, CFTypeRef key ) {    ABAutoComplete *ac = ABACFor( tag );    if ( ac ) [ac showKey:(__bridge id)key];}// the chosen record's key (NULL when nothing is chosen)CFTypeRef ACChosenKey( long tag ) {    ABAutoComplete *ac = ABACFor( tag );    return ac ? (__bridge CFTypeRef)ac.chosenKey : NULL;}// the chosen record, all its columns (NULL when nothing is chosen): the info button's popover shows itCFDictionaryRef AutoCompleteChosenRecord( long tag ) {    ABAutoComplete *ac = ABACFor( tag );    return ac ? (__bridge CFDictionaryRef)ac.chosenRecord : NULL;}long AutoCompleteIsField( long tag ) { return ABACFor( tag ) != nil; }EndCtoolbox AutoCompleteAttachView( ptr fieldView, long tag, long minChars, long maxResults )toolbox ACSetRecords( long tag, CFArrayRef records, CFStringRef keyName, CFStringRef displayName )toolbox ACShowKey( long tag, CFTypeRef key )toolbox fn ACChosenKey( long tag ) = CFTypeReftoolbox fn AutoCompleteChosenRecord( long tag ) = CFDictionaryReftoolbox fn AutoCompleteIsField( long tag ) = long// the text field with this tag (on a Form) becomes an auto-completevoid local fn AutoCompleteAttach( tag as long, minChars as long, maxResults as long )ViewRef fieldView = fn ShellFindView( tag )if ( fieldView == NULL ) then exit fnAutoCompleteAttachView( fieldView, tag, minChars, maxResults )end fn// a lookup table's rows arrived: the records to choose fromvoid local fn AutoCompleteSetRecords( tag as long, records as CFArrayRef, keyName as CFStringRef, displayName as CFStringRef )ACSetRecords( tag, records, keyName, displayName )end fn// record -> Form: the name of the record its key points atvoid local fn AutoCompleteShow( tag as long, aRecord as CFDictionaryRef, name as CFStringRef )ACShowKey( tag, fn DictionaryObjectForKey( aRecord, name ) )end fn// Form -> record: the chosen key (left out when nothing is chosen: stored as NULL)void local fn AutoCompleteTake( aRecord as CFMutableDictionaryRef, name as CFStringRef, tag as long )CFTypeRef key = fn ACChosenKey( tag )if ( key != NULL ) then MutableDictionarySetObjectForKey( aRecord, key, name )end fn