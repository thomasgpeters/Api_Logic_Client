/* *   I M A G E R Y    B U S I N E S S     S Y S T E M S,   L L C * *   App Toolbar.incl - runtime: the window's toolbar * *   A Mac toolbar at the top of the app's window, built with FB's toolbar and toolbaritem (author, 2026-11-27): *       Search (a magnifying glass)  |  New   Save   Delete   Refresh  ......  Theme (System, Light, Dark) *   The first item is Search, and its label follows the page on screen: "Search Customers", "Search Products" *   (AppToolbarShowPage).  Clicking it opens the search dialog under it - Search by a field, then a text box, a *   dropdown of the field's values, or a calendar for a date - and each change narrows the page's List at once *   (App Pages.incl: AppPageSearchChanged; Record Search.incl: RecordSearchQuery).  New, Save, Delete and Refresh live here; the footer *   keeps the record navigator.  The items know the context (AppToolbarSetEnabled): Save is on only when the Form has *   a change to save, Delete only when a record is shown. *   Like any Mac toolbar it can be customised (View > Customize Toolbar..., or a right-click on it): items dragged *   into another order, spaces added; macOS remembers the arrangement. * *   The items send _toolbarItemClick with their tag to the app's dialog handler (App Pages.incl handles them). *   FB has no search toolbar item, so the search dialog is our own: a Cocoa popover under the Search item. * *   MIT License. Copyright (c) 2026 Imagery Business Systems, LLC. */_appToolbar        = 1_appToolbarSearch  = 63001             // item tags (a toolbar's own: they come with _toolbarItemClick)_appToolbarNew     = 63002_appToolbarDelete  = 63003_appToolbarRefresh = 63004_appToolbarSpace   = 63005_appToolbarSave    = 63006_appToolbarDivider = 63007             // the line between Search and the record actions_appToolbarDividerView = 63010         // its view (a vertical separator box)_appToolbarFlex    = 63008             // the space before the theme menu_appToolbarTheme   = 63009             // the theme menu (App Shell.incl's _shellThemePopup, moved here)#define APP_TOOLBAR_SEARCH_ID @"App.Search"// the C functions FB calls, declared for every part of the project (FB compiles in several chunks)BeginCDeclarationvoid AppToolbarSearchPopover( CFStringRef prompt, CFArrayRef fields, CFArrayRef records, void *handler );void AppToolbarSearchReset( void );void AppToolbarWatchEdits( void *handler );EndCBeginCFunctiontypedef void (*ABSearchFn)( CFDictionaryRef query );/* *   The search dialog (author, 2026-11-27): "Search by" a field (a dropdown of the page's fields, or Any Field), then *   the value, in the control that suits the field: *     - a date field: a calendar (day, month, year), the records of that day; *     - a field with few distinct values (a type, a status: at most 15, each used more than once on average): a second *       dropdown of those values, worked out from the records themselves; *     - anything else: a text box, the records that contain what is typed (every word, any case, any accent). *   Each change is sent at once as a query: { field, mode ("text" | "value" | "date"), text }. */@interface ABSearchPopover : NSObject <NSPopoverDelegate>@property (strong) NSPopover *popover;@property (strong) NSStackView *stack;@property (strong) NSPopUpButton *fieldPopup;@property (strong) NSSearchField *textField;@property (strong) NSPopUpButton *valuePopup;@property (strong) NSDatePicker *datePicker;@property (strong) NSArray *fields;          // [ { name, title, kind: text | date | key } ]@property (strong) NSArray *records;@property (strong) NSString *mode;@property (assign) void *handler;@end@implementation ABSearchPopover- (NSDictionary *)chosenField {    NSInteger i = self.fieldPopup.indexOfSelectedItem - 1;           // item 0: Any Field    return ( i >= 0 && i < (NSInteger)self.fields.count ) ? self.fields[i] : nil;}// the field's distinct values, when there are few of them (a type, a status); nil otherwise- (NSArray *)distinctValuesOf:(NSDictionary *)field {    NSMutableSet *seen = [NSMutableSet set];    NSUInteger used = 0;    if ( field == nil || [field[@"kind"] isEqualToString:@"key"] || [field[@"kind"] isEqualToString:@"date"] ) return nil;    for ( NSDictionary *aRecord in self.records ) {        id value = aRecord[field[@"name"]];        NSString *text;        if ( value == nil || value == [NSNull null] ) continue;        text = [[value description] stringByTrimmingCharactersInSet:NSCharacterSet.whitespaceCharacterSet];        if ( text.length == 0 ) continue;        [seen addObject:text];        used++;        if ( seen.count > 15 ) return nil;    }    if ( seen.count < 2 || used < seen.count * 2 ) return nil;          // each value used more than once on average    return [seen.allObjects sortedArrayUsingSelector:@selector(localizedStandardCompare:)];}- (void)send:(NSString *)text {    NSDictionary *field = [self chosenField];    NSDictionary *query = @{ @"field":( field ? field[@"name"] : @"" ), @"mode":self.mode, @"text":( text ? text : @"" ) };    if ( self.handler ) ((ABSearchFn)self.handler)( (__bridge CFDictionaryRef)query );}- (void)fit {    self.popover.contentSize = self.stack.fittingSize;}// the value control that suits the field chosen- (void)showValueControl {    NSDictionary *field = [self chosenField];    NSArray *values = [self distinctValuesOf:field];    self.textField.hidden = YES;    self.valuePopup.hidden = YES;    self.datePicker.hidden = YES;    if ( field != nil && [field[@"kind"] isEqualToString:@"date"] ) {        self.mode = @"date";        self.datePicker.hidden = NO;    } else if ( values != nil ) {        self.mode = @"value";        [self.valuePopup removeAllItems];        [self.valuePopup addItemWithTitle:@"Any Value"];        [self.valuePopup addItemsWithTitles:values];        self.valuePopup.hidden = NO;    } else {        self.mode = @"text";        self.textField.stringValue = @"";        self.textField.placeholderString = field ? [NSString stringWithFormat:@"%@ contains…", field[@"title"]] : @"Any field contains…";        self.textField.hidden = NO;    }    [self fit];}- (void)fieldChanged:(id)sender {    [self showValueControl];    if ( [self.mode isEqualToString:@"date"] ) [self dateChanged:nil]; else [self send:@""];    if ( [self.mode isEqualToString:@"text"] ) [self.textField.window makeFirstResponder:self.textField];}- (void)textChanged:(NSSearchField *)sender { [self send:[sender.stringValue copy]]; }- (void)valueChanged:(NSPopUpButton *)sender {    [self send:( sender.indexOfSelectedItem <= 0 ) ? @"" : sender.titleOfSelectedItem];}- (void)dateChanged:(id)sender {    NSDateFormatter *format = [[NSDateFormatter alloc] init];    format.locale = [NSLocale localeWithLocaleIdentifier:@"en_US_POSIX"];    format.dateFormat = @"yyyy-MM-dd";    [self send:[format stringFromDate:self.datePicker.dateValue]];}- (void)showAll:(id)sender {    [self.fieldPopup selectItemAtIndex:0];    [self showValueControl];    [self send:@""];}- (void)build {    NSTextField *label = [NSTextField labelWithString:@"Search by"];    NSStackView *byRow;    NSButton *showAll = [NSButton buttonWithTitle:@"Show All" target:self action:@selector(showAll:)];    self.fieldPopup = [[NSPopUpButton alloc] initWithFrame:NSMakeRect( 0, 0, 200, 26 ) pullsDown:NO];    self.fieldPopup.target = self;    self.fieldPopup.action = @selector(fieldChanged:);    byRow = [NSStackView stackViewWithViews:@[ label, self.fieldPopup ]];    byRow.spacing = 8;    self.textField = [[NSSearchField alloc] initWithFrame:NSMakeRect( 0, 0, 300, 24 )];    [self.textField.widthAnchor constraintEqualToConstant:300].active = YES;    self.textField.target = self;    self.textField.action = @selector(textChanged:);    self.valuePopup = [[NSPopUpButton alloc] initWithFrame:NSMakeRect( 0, 0, 300, 26 ) pullsDown:NO];    [self.valuePopup.widthAnchor constraintEqualToConstant:300].active = YES;    self.valuePopup.target = self;    self.valuePopup.action = @selector(valueChanged:);    self.datePicker = [[NSDatePicker alloc] initWithFrame:NSZeroRect];    self.datePicker.datePickerStyle = NSDatePickerStyleClockAndCalendar;      // a little calendar: day, month, year    self.datePicker.datePickerElements = NSDatePickerElementFlagYearMonthDay;    self.datePicker.dateValue = [NSDate date];    self.datePicker.target = self;    self.datePicker.action = @selector(dateChanged:);    self.stack = [NSStackView stackViewWithViews:@[ byRow, self.textField, self.valuePopup, self.datePicker, showAll ]];    self.stack.orientation = NSUserInterfaceLayoutOrientationVertical;    self.stack.alignment = NSLayoutAttributeLeading;    self.stack.spacing = 12;    self.stack.edgeInsets = NSEdgeInsetsMake( 14, 16, 14, 16 );    self.popover = [[NSPopover alloc] init];    self.popover.behavior = NSPopoverBehaviorTransient;    self.popover.contentViewController = [[NSViewController alloc] init];    self.popover.contentViewController.view = self.stack;}@endstatic ABSearchPopover *abSearchPopover = nil;// a new page: the dialog starts again from Any Fieldvoid AppToolbarSearchReset( void ) {    if ( abSearchPopover != nil ) abSearchPopover.fields = nil;}// the search dialog under the toolbar's Search item (or under the window's top, if the item was removed)void AppToolbarSearchPopover( CFStringRef prompt, CFArrayRef fields, CFArrayRef records, void *handler ) {    NSWindow *window = NSApp.mainWindow ? NSApp.mainWindow : NSApp.keyWindow;    NSToolbarItem *anchor = nil;    NSArray *newFields = fields ? [(__bridge NSArray *)fields copy] : @[];    if ( window == nil ) return;    if ( abSearchPopover == nil ) {        abSearchPopover = [[ABSearchPopover alloc] init];        [abSearchPopover build];    }    abSearchPopover.handler = handler;    abSearchPopover.records = records ? [(__bridge NSArray *)records copy] : @[];    if ( ![abSearchPopover.fields isEqualToArray:newFields] ) {                 // another page: its fields, from Any Field        abSearchPopover.fields = newFields;        [abSearchPopover.fieldPopup removeAllItems];        [abSearchPopover.fieldPopup addItemWithTitle:@"Any Field"];        for ( NSDictionary *field in newFields ) [abSearchPopover.fieldPopup addItemWithTitle:field[@"title"]];        [abSearchPopover.fieldPopup selectItemAtIndex:0];        [abSearchPopover showValueControl];    }    abSearchPopover.textField.placeholderString = ( abSearchPopover.fieldPopup.indexOfSelectedItem <= 0 ) ? (__bridge NSString *)prompt : abSearchPopover.textField.placeholderString;    [abSearchPopover fit];    for ( NSToolbarItem *item in window.toolbar.items ) if ( [item.itemIdentifier isEqualToString:@"App.Search"] ) anchor = item;    if ( anchor != nil )        [abSearchPopover.popover showRelativeToToolbarItem:anchor];    else        [abSearchPopover.popover showRelativeToRect:NSMakeRect( NSMidX( window.contentView.bounds ) - 1, NSMaxY( window.contentView.bounds ) - 1, 2, 1 ) ofView:window.contentView preferredEdge:NSRectEdgeMaxY];    if ( [abSearchPopover.mode isEqualToString:@"text"] ) [abSearchPopover.popover.contentViewController.view.window makeFirstResponder:abSearchPopover.textField];}// typing in any field of the app's window (not the search): handler is called, so Save can come on at the first keyvoid AppToolbarWatchEdits( void *handler ) {    static id watcher = nil;    if ( watcher != nil || handler == NULL ) return;    watcher = [[NSNotificationCenter defaultCenter] addObserverForName:NSControlTextDidChangeNotification object:nil queue:nil usingBlock:^( NSNotification *note ) {        if ( [note.object isKindOfClass:[NSSearchField class]] ) return;        ((void (*)(void))handler)();    }];}EndCtoolbox AppToolbarSearchPopover( CFStringRef prompt, CFArrayRef fields, CFArrayRef records, ptr handler )toolbox AppToolbarSearchResettoolbox AppToolbarWatchEdits( ptr handler )/* *   The toolbar on the app's window - call it after ShellBuildWindow (the window is the current one). *   Search first; New, Save, Delete and Refresh at the right; a customisation palette with spaces.  The items do not *   validate themselves: AppToolbarSetEnabled says which apply. */void local fn AppToolbarBuild( windowTag as long )toolbar _appToolbartoolbaritem _appToolbarSearch, APP_TOOLBAR_SEARCH_ID, @"Search", @"magnifyingglass", YES, YES// a thin vertical line: Search on its own, the record actions after it (macOS has no separator item since 11)box _appToolbarDividerView, @"", fn CGRectMake( 0, 0, 13, 28 ), NSBoxSeparator, windowTagtoolbaritem _appToolbarDivider, @"App.Divider", @"", NULL, YES, YESToolbarItemSetView( _appToolbar, _appToolbarDivider, _appToolbarDividerView )ToolbarItemSetPaletteLabel( _appToolbar, _appToolbarDivider, @"Separator" )toolbaritem _appToolbarNew, @"App.New", @"New", @"plus", YES, YEStoolbaritem _appToolbarSave, @"App.Save", @"Save", @"square.and.arrow.down", YES, YEStoolbaritem _appToolbarDelete, @"App.Delete", @"Delete", @"trash", YES, YEStoolbaritem _appToolbarRefresh, @"App.Refresh", @"Refresh", @"arrow.clockwise", YES, YES// at the right: the theme menu (System, Light, Dark), out of the header (author, 2026-11-27)toolbaritem _appToolbarFlex, NSToolbarFlexibleSpaceItemIdentifier, , , YES, YEStoolbaritem _appToolbarTheme, @"App.Theme", @"Theme", NULL, YES, YESToolbarItemSetView( _appToolbar, _appToolbarTheme, _shellThemePopup )ToolbarItemSetToolTip( _appToolbar, _appToolbarTheme, @"Light, dark, or as the Mac is set" )ToolbarItemSetToolTip( _appToolbar, _appToolbarSearch, @"Search the records on this page" )ToolbarItemSetToolTip( _appToolbar, _appToolbarNew, @"A new record (Command-N)" )ToolbarItemSetToolTip( _appToolbar, _appToolbarSave, @"Save the changes in the Form (Command-S)" )ToolbarItemSetToolTip( _appToolbar, _appToolbarDelete, @"Delete the record shown" )ToolbarItemSetAutovalidates( _appToolbar, _appToolbarSearch, NO )   // AppToolbarSetEnabled decides (AppKit would turn them back on)ToolbarItemSetAutovalidates( _appToolbar, _appToolbarNew, NO )ToolbarItemSetAutovalidates( _appToolbar, _appToolbarSave, NO )ToolbarItemSetAutovalidates( _appToolbar, _appToolbarDelete, NO )ToolbarItemSetAutovalidates( _appToolbar, _appToolbarRefresh, NO )ToolbarItemSetToolTip( _appToolbar, _appToolbarRefresh, @"Read the records again (Command-R)" )ToolbarSetAllowsUserCustomization( _appToolbar, YES )          // View > Customize Toolbar..., drag to reorderToolbarSetAutosavesConfiguration( _appToolbar, YES )           // the arrangement is rememberedToolbarSetDisplayMode( _appToolbar, NSToolbarDisplayModeIconAndLabel )WindowSetToolbar( windowTag, _appToolbar )end fn// "Customer" -> "Customers", "Category" -> "Categories", "Box" -> "Boxes"; a title already plural stayslocal fn AppToolbarPlural( word as CFStringRef ) as CFStringReflong        n = fn StringLength( word )CFStringRef beforeif ( n == 0 ) then exit fn = wordif ( fn StringHasSuffix( word, @"ss" ) || fn StringHasSuffix( word, @"x" ) || fn StringHasSuffix( word, @"ch" ) || fn StringHasSuffix( word, @"sh" ) ) then exit fn = fn StringWithFormat( @"%@es", word )if ( fn StringHasSuffix( word, @"s" ) ) then exit fn = wordif ( n > 1 && fn StringHasSuffix( word, @"y" ) )before = fn StringSubstringWithRange( word, fn CFRangeMake( n - 2, 1 ) )if ( fn StringContainsString( @"aeiouAEIOU", before ) == NO ) then exit fn = fn StringWithFormat( @"%@ies", fn StringSubstringToIndex( word, n - 1 ) )end ifend fn = fn StringWithFormat( @"%@s", word )// the page shown: Search names it ("Search Customers"); the dialog starts again from Any Fieldvoid local fn AppToolbarShowPage( pageTitle as CFStringRef )ToolbarItemSetLabel( _appToolbar, _appToolbarSearch, fn StringWithFormat( @"Search %@", fn AppToolbarPlural( pageTitle ) ) )AppToolbarSearchResetend fn// Search clicked: the search dialog, with the page's fields ([ { name, title, kind } ]) and its records (for the// fields' distinct values); handler gets every change as a query { field, mode, text }void local fn AppToolbarSearch( pageTitle as CFStringRef, fields as CFArrayRef, records as CFArrayRef, handler as ptr )AppToolbarSearchPopover( fn StringWithFormat( @"Search %@", fn AppToolbarPlural( pageTitle ) ), fields, records, handler )end fn// which items apply now: a page on screen (Search, New, Refresh), a change in the Form (Save), a record shown (Delete)void local fn AppToolbarSetEnabled( hasPage as BOOL, hasChange as BOOL, hasRecord as BOOL )ToolbarItemSetEnabled( _appToolbar, _appToolbarSearch, hasPage )ToolbarItemSetEnabled( _appToolbar, _appToolbarNew, hasPage )ToolbarItemSetEnabled( _appToolbar, _appToolbarSave, hasChange )ToolbarItemSetEnabled( _appToolbar, _appToolbarDelete, hasRecord )ToolbarItemSetEnabled( _appToolbar, _appToolbarRefresh, hasPage )end fn