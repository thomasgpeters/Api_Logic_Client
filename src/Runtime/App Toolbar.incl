/* *   I M A G E R Y    B U S I N E S S     S Y S T E M S,   L L C * *   App Toolbar.incl - runtime: the window's toolbar * *   A Mac toolbar at the top of the app's window, built with FB's toolbar and toolbaritem (author, 2026-11-27): *       Search (a magnifying glass)   New   Save   Delete   Refresh *   The first item is Search, and its label follows the page on screen: "Search Customers", "Search Products" *   (AppToolbarShowPage).  Clicking it opens a search field under it; typing narrows the page's List as you type *   (App Pages.incl: AppPageSearchChanged; Record Search.incl).  New, Save, Delete and Refresh live here; the footer *   keeps the record navigator.  The items know the context (AppToolbarSetEnabled): Save is on only when the Form has *   a change to save, Delete only when a record is shown. *   Like any Mac toolbar it can be customised (View > Customize Toolbar..., or a right-click on it): items dragged *   into another order, spaces added; macOS remembers the arrangement. * *   The items send _toolbarItemClick with their tag to the app's dialog handler (App Pages.incl handles them). *   FB has no search toolbar item, so the search field is our own: a small Cocoa popover under the Search item. * *   MIT License. Copyright (c) 2026 Imagery Business Systems, LLC. */_appToolbar        = 1_appToolbarSearch  = 63001             // item tags (a toolbar's own: they come with _toolbarItemClick)_appToolbarNew     = 63002_appToolbarDelete  = 63003_appToolbarRefresh = 63004_appToolbarSpace   = 63005_appToolbarSave    = 63006#define APP_TOOLBAR_SEARCH_ID @"App.Search"// the C functions FB calls, declared for every part of the project (FB compiles in several chunks)BeginCDeclarationvoid AppToolbarSearchPopover( CFStringRef prompt, CFStringRef searchText, void *handler );void AppToolbarWatchEdits( void *handler );EndCBeginCFunctiontypedef void (*ABSearchFn)( CFStringRef searchText );@interface ABSearchPopover : NSObject <NSPopoverDelegate>@property (strong) NSPopover *popover;@property (strong) NSSearchField *field;@property (assign) void *handler;@end@implementation ABSearchPopover// typed (as you type; Esc or the clear button sends an empty search)- (void)searchChanged:(NSSearchField *)sender {    NSString *searchText = [sender.stringValue copy];    if ( self.handler ) ((ABSearchFn)self.handler)( (__bridge CFStringRef)searchText );}@endstatic ABSearchPopover *abSearchPopover = nil;// the search field in a popover under the toolbar's Search item (or under the window's top, if it was removed)void AppToolbarSearchPopover( CFStringRef prompt, CFStringRef searchText, void *handler ) {    NSWindow *window = NSApp.mainWindow ? NSApp.mainWindow : NSApp.keyWindow;    NSToolbarItem *anchor = nil;    NSViewController *content;    if ( window == nil ) return;    if ( abSearchPopover == nil ) {        abSearchPopover = [[ABSearchPopover alloc] init];        abSearchPopover.field = [[NSSearchField alloc] initWithFrame:NSMakeRect( 12, 12, 280, 24 )];        abSearchPopover.field.target = abSearchPopover;        abSearchPopover.field.action = @selector(searchChanged:);        content = [[NSViewController alloc] init];        content.view = [[NSView alloc] initWithFrame:NSMakeRect( 0, 0, 304, 48 )];        [content.view addSubview:abSearchPopover.field];        abSearchPopover.popover = [[NSPopover alloc] init];        abSearchPopover.popover.behavior = NSPopoverBehaviorTransient;        abSearchPopover.popover.contentViewController = content;        abSearchPopover.popover.contentSize = NSMakeSize( 304, 48 );    }    abSearchPopover.handler = handler;    abSearchPopover.field.placeholderString = (__bridge NSString *)prompt;    abSearchPopover.field.stringValue = searchText ? (__bridge NSString *)searchText : @"";    for ( NSToolbarItem *item in window.toolbar.items ) if ( [item.itemIdentifier isEqualToString:@"App.Search"] ) anchor = item;    if ( anchor != nil )        [abSearchPopover.popover showRelativeToToolbarItem:anchor];    else        [abSearchPopover.popover showRelativeToRect:NSMakeRect( NSMidX( window.contentView.bounds ) - 1, NSMaxY( window.contentView.bounds ) - 1, 2, 1 ) ofView:window.contentView preferredEdge:NSRectEdgeMaxY];    [abSearchPopover.popover.contentViewController.view.window makeFirstResponder:abSearchPopover.field];}// typing in any field of the app's window (not the search): handler is called, so Save can come on at the first keyvoid AppToolbarWatchEdits( void *handler ) {    static id watcher = nil;    if ( watcher != nil || handler == NULL ) return;    watcher = [[NSNotificationCenter defaultCenter] addObserverForName:NSControlTextDidChangeNotification object:nil queue:nil usingBlock:^( NSNotification *note ) {        if ( [note.object isKindOfClass:[NSSearchField class]] ) return;        ((void (*)(void))handler)();    }];}EndCtoolbox AppToolbarSearchPopover( CFStringRef prompt, CFStringRef searchText, ptr handler )toolbox AppToolbarWatchEdits( ptr handler )/* *   The toolbar on the app's window - call it after ShellBuildWindow (the window is the current one). *   Search first; New, Save, Delete and Refresh at the right; a customisation palette with spaces.  The items do not *   validate themselves: AppToolbarSetEnabled says which apply. */void local fn AppToolbarBuild( windowTag as long )toolbar _appToolbartoolbaritem _appToolbarSearch, APP_TOOLBAR_SEARCH_ID, @"Search", @"magnifyingglass", YES, YEStoolbaritem _appToolbarSpace, NSToolbarFlexibleSpaceItemIdentifier, , , YES, YEStoolbaritem _appToolbarNew, @"App.New", @"New", @"plus", YES, YEStoolbaritem _appToolbarSave, @"App.Save", @"Save", @"square.and.arrow.down", YES, YEStoolbaritem _appToolbarDelete, @"App.Delete", @"Delete", @"trash", YES, YEStoolbaritem _appToolbarRefresh, @"App.Refresh", @"Refresh", @"arrow.clockwise", YES, YESToolbarItemSetToolTip( _appToolbar, _appToolbarSearch, @"Search the records on this page" )ToolbarItemSetToolTip( _appToolbar, _appToolbarNew, @"A new record (Command-N)" )ToolbarItemSetToolTip( _appToolbar, _appToolbarSave, @"Save the changes in the Form (Command-S)" )ToolbarItemSetToolTip( _appToolbar, _appToolbarDelete, @"Delete the record shown" )ToolbarItemSetAutovalidates( _appToolbar, _appToolbarSearch, NO )   // AppToolbarSetEnabled decides (AppKit would turn them back on)ToolbarItemSetAutovalidates( _appToolbar, _appToolbarNew, NO )ToolbarItemSetAutovalidates( _appToolbar, _appToolbarSave, NO )ToolbarItemSetAutovalidates( _appToolbar, _appToolbarDelete, NO )ToolbarItemSetAutovalidates( _appToolbar, _appToolbarRefresh, NO )ToolbarItemSetToolTip( _appToolbar, _appToolbarRefresh, @"Read the records again (Command-R)" )ToolbarSetAllowsUserCustomization( _appToolbar, YES )          // View > Customize Toolbar..., drag to reorderToolbarSetAutosavesConfiguration( _appToolbar, YES )           // the arrangement is rememberedToolbarSetDisplayMode( _appToolbar, NSToolbarDisplayModeIconAndLabel )WindowSetToolbar( windowTag, _appToolbar )end fn// "Customer" -> "Customers", "Category" -> "Categories", "Box" -> "Boxes"; a title already plural stayslocal fn AppToolbarPlural( word as CFStringRef ) as CFStringReflong        n = fn StringLength( word )CFStringRef beforeif ( n == 0 ) then exit fn = wordif ( fn StringHasSuffix( word, @"ss" ) || fn StringHasSuffix( word, @"x" ) || fn StringHasSuffix( word, @"ch" ) || fn StringHasSuffix( word, @"sh" ) ) then exit fn = fn StringWithFormat( @"%@es", word )if ( fn StringHasSuffix( word, @"s" ) ) then exit fn = wordif ( n > 1 && fn StringHasSuffix( word, @"y" ) )before = fn StringSubstringWithRange( word, fn CFRangeMake( n - 2, 1 ) )if ( fn StringContainsString( @"aeiouAEIOU", before ) == NO ) then exit fn = fn StringWithFormat( @"%@ies", fn StringSubstringToIndex( word, n - 1 ) )end ifend fn = fn StringWithFormat( @"%@s", word )// the page shown: Search names it ("Search Customers")void local fn AppToolbarShowPage( pageTitle as CFStringRef )ToolbarItemSetLabel( _appToolbar, _appToolbarSearch, fn StringWithFormat( @"Search %@", fn AppToolbarPlural( pageTitle ) ) )end fn// Search clicked: the search field under it, with what was typed before; handler gets every changevoid local fn AppToolbarSearch( pageTitle as CFStringRef, searchText as CFStringRef, handler as ptr )AppToolbarSearchPopover( fn StringWithFormat( @"Search %@", fn AppToolbarPlural( pageTitle ) ), searchText, handler )end fn// which items apply now: a page on screen (Search, New, Refresh), a change in the Form (Save), a record shown (Delete)void local fn AppToolbarSetEnabled( hasPage as BOOL, hasChange as BOOL, hasRecord as BOOL )ToolbarItemSetEnabled( _appToolbar, _appToolbarSearch, hasPage )ToolbarItemSetEnabled( _appToolbar, _appToolbarNew, hasPage )ToolbarItemSetEnabled( _appToolbar, _appToolbarSave, hasChange )ToolbarItemSetEnabled( _appToolbar, _appToolbarDelete, hasRecord )ToolbarItemSetEnabled( _appToolbar, _appToolbarRefresh, hasPage )end fn