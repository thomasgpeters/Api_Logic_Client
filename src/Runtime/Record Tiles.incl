/* *   I M A G E R Y    B U S I N E S S     S Y S T E M S,   L L C * *   Record Tiles.incl - runtime: a List's records as tiles, three or four across * *   Beside the grid (the List's table), a page can show its records as tiles: each a rounded panel that stands *   out a little from its card, the record's name as a subheading and a few of its other fields under it in *   smaller text. A switch in the List card's title row chooses Grid or Tiles. Clicking a tile picks its record, *   as clicking a row does. * *       fn RecordTilesBuild( pageIndex, listPartTag )                   // once, after the List part is placed *       fn RecordTilesShow( pageIndex, records, @"Name", @[ @"City", @"Phone" ], @[ @"City", @"Phone" ] ) *       tile = fn RecordTilesClicked( tag )    // in the dialog handler: a record's index, -2 the switch, -1 not ours *       fn RecordTilesPageShown( pageIndex )   // when a page is shown: its grid or its tiles * *   Four across when the List is at least 880 points wide, else three; the tiles stretch with the window and *   are laid out again with the next records. At most 400 tiles (the grid shows every record). * *   MIT License. Copyright (c) 2026 Imagery Business Systems, LLC. */_tilesTagBase     = 700000        // tags: each page has 2000 from here (the shell's cards use 500000 and 600000)_tilesTagsPerPage = 2000_tilesMax         = 400_tilesGap         = 14_tilesHeight      = 118_tilesWideList    = 880           // four tiles across from this width, three below itbegin globalsCFMutableDictionaryRef gTilesPages   // page number (as text) -> { list, tiles, count, selected }ColorRef gTilesFill                  // a tile: a shade apart from its cardColorRef gTilesBorderend globalslocal fn TilesScrollTag( pageIndex as long ) as longend fn = _tilesTagBase + pageIndex * _tilesTagsPerPage// a tile's views: its panel, its name, its details, and the clear button over it that takes the clicklocal fn TilesTileTag( pageIndex as long, index as long ) as longend fn = fn TilesScrollTag( pageIndex ) + 10 + index * 4local fn TilesPage( pageIndex as long ) as CFMutableDictionaryRefCFMutableDictionaryRef pageif ( gTilesPages == NULL ) then gTilesPages = (CFMutableDictionaryRef)fn DataKept( fn MutableDictionaryNew, gTilesPages )page = (CFMutableDictionaryRef)fn DictionaryObjectForKey( gTilesPages, fn StringWithFormat( @"%ld", pageIndex ) )if ( page == NULL )page = fn MutableDictionaryWithDictionary( @{ @"list":fn NumberWithLong( 0 ), @"tiles":fn NumberWithBool( NO ), @"count":fn NumberWithLong( 0 ), @"built":fn NumberWithLong( 0 ), @"selected":fn NumberWithLong( -1 ) } )MutableDictionarySetObjectForKey( gTilesPages, page, fn StringWithFormat( @"%ld", pageIndex ) )end ifend fn = pagelocal fn TilesPageLong( pageIndex as long, key as CFStringRef ) as longend fn = fn NumberLongValue( fn DictionaryObjectForKey( fn TilesPage( pageIndex ), key ) )void local fn TilesPageSetLong( pageIndex as long, key as CFStringRef, value as long )MutableDictionarySetObjectForKey( fn TilesPage( pageIndex ), fn NumberWithLong( value ), key )end fnvoid local fn TilesColorsif ( gTilesFill != NULL ) then exit fngTilesFill   = fn DataKept( fn ShellDynamicColor( fn ColorWithSRGB( 0.976, 0.979, 0.986, 1.0 ), fn ColorWithSRGB( 0.220, 0.226, 0.240, 1.0 ) ), gTilesFill )gTilesBorder = fn DataKept( fn ShellDynamicColor( fn ColorWithSRGB( 0.0, 0.0, 0.0, 0.09 ), fn ColorWithSRGB( 1.0, 1.0, 1.0, 0.10 ) ), gTilesBorder )end fn// a soft shadow under a tile, so it stands out from its cardvoid local fn TilesShadow( tag as long )ViewRef v = fn ShellFindView( tag )if ( v == NULL ) then exit fncln NSView *tileView = (__bridge NSView *)v; NSShadow *shadow = [[NSShadow alloc] init]; shadow.shadowBlurRadius = 6.0; shadow.shadowOffset = NSMakeSize( 0, -2 ); shadow.shadowColor = [NSColor colorWithWhite:0.0 alpha:0.16]; tileView.wantsLayer = YES; tileView.shadow = shadow;end fn// the switch in the List card's title row (Grid / Tiles) and the scrolling area the tiles go in, over the Listvoid local fn RecordTilesBuild( pageIndex as long, listTag as long )long   scrollTag = fn TilesScrollTag( pageIndex )CGRect r = fn ViewFrame( listTag )CGRect card = fn ViewFrame( listTag + _shellCardTagOffset )fn TilesColorsfn TilesPageSetLong( pageIndex, @"list", listTag )scrollview scrollTag, r, NSNoBorder, , _shellWindowViewAddSubview( _shellContent, scrollTag )ViewSetFrame( scrollTag, r )ViewSetAutoresizingMask( scrollTag, NSViewWidthSizable + NSViewHeightSizable )ScrollViewSetDrawsBackground( scrollTag, NO )view scrollTag + 1, fn CGRectMake( 0, 0, r.size.width, r.size.height ), _shellWindowScrollViewSetDocumentView( scrollTag, scrollTag + 1 )ViewSetAutoresizingMask( scrollTag + 1, NSViewWidthSizable )ViewSetHidden( scrollTag, YES )// the switch: at the right of the card's title rowsegmentedcontrol scrollTag + 2, YES, 0, fn CGRectMake( card.origin.x + card.size.width - _shellCardPadding - 72, card.origin.y + card.size.height - _shellCardPadding - 26, 72, 24 ), 2, _shellWindowSegmentedControlSetSegmentImage( scrollTag + 2, 0, fn ImageWithSystemSymbolName( @"list.bullet", @"Grid" ) )SegmentedControlSetSegmentImage( scrollTag + 2, 1, fn ImageWithSystemSymbolName( @"square.grid.2x2", @"Tiles" ) )ViewSetToolTip( scrollTag + 2, @"Show the records as a grid or as tiles" )ViewAddSubview( _shellContent, scrollTag + 2 )ViewSetFrame( scrollTag + 2, fn CGRectMake( card.origin.x + card.size.width - _shellCardPadding - 72, card.origin.y + card.size.height - _shellCardPadding - 26, 72, 24 ) )ViewSetAutoresizingMask( scrollTag + 2, NSViewMinXMargin + NSViewMinYMargin )ViewSetHidden( scrollTag + 2, YES )end fn// grid or tiles, for the page on screenvoid local fn RecordTilesApplyMode( pageIndex as long )long listTag = fn TilesPageLong( pageIndex, @"list" )BOOL tiles = ( fn TilesPageLong( pageIndex, @"tiles" ) != 0 )if ( listTag == 0 ) then exit fnViewSetHidden( listTag, tiles )ViewSetHidden( fn TilesScrollTag( pageIndex ), ( tiles == NO ) )ViewSetHidden( fn TilesScrollTag( pageIndex ) + 2, NO )if ( tiles ) then SegmentedControlSetSegmentSelected( fn TilesScrollTag( pageIndex ) + 2, 1, YES ) else SegmentedControlSetSegmentSelected( fn TilesScrollTag( pageIndex ) + 2, 0, YES )end fn// a page was shown: the other pages' switches and tiles hidden, this page's grid or tilesvoid local fn RecordTilesPageShown( pageIndex as long )CFArrayRef  keysCFStringRef keylong        otherif ( gTilesPages == NULL ) then exit fnkeys = fn DictionaryAllKeys( gTilesPages )for key in keysother = fn StringIntegerValue( key )if ( other != pageIndex )ViewSetHidden( fn TilesScrollTag( other ), YES )ViewSetHidden( fn TilesScrollTag( other ) + 2, YES )end ifnextfn RecordTilesApplyMode( pageIndex )end fn// one tile's look: picked (the accent colour, a heavier edge) or notvoid local fn TilesMark( pageIndex as long, index as long, picked as BOOL )long boxTag = fn TilesTileTag( pageIndex, index )if ( index < 0 || index >= fn TilesPageLong( pageIndex, @"built" ) ) then exit fnif ( picked )BoxSetBorderColor( boxTag, fn ColorControlAccent )BoxSetBorderWidth( boxTag, 2.0 )elseBoxSetBorderColor( boxTag, gTilesBorder )BoxSetBorderWidth( boxTag, 1.0 )end ifend fn// the records as tiles: titleKey's value as the subheading, then each detail as "Title: value"void local fn RecordTilesShow( pageIndex as long, records as CFArrayRef, titleKey as CFStringRef, detailKeys as CFArrayRef, detailTitles as CFArrayRef )long               scrollTag = fn TilesScrollTag( pageIndex ), docTag = scrollTag + 1long               count = 0, built = fn TilesPageLong( pageIndex, @"built" )long               i, d, columns, rows, column, row, tagCGRect             area = fn ViewFrame( scrollTag )CGFloat            tileW, docH, x, yCFDictionaryRef    aRecordCFMutableStringRef detailsCFStringRef        titlelong               proportional = NSViewMinXMargin + NSViewWidthSizable + NSViewMaxXMarginif ( fn TilesPageLong( pageIndex, @"list" ) == 0 ) then exit fn         // RecordTilesBuild firstfn TilesColorsif ( records != NULL ) then count = fn ArrayCount( records )if ( count > _tilesMax ) then count = _tilesMaxcolumns = 3if ( area.size.width >= _tilesWideList ) then columns = 4tileW = ( area.size.width - _tilesGap * ( columns + 1 ) ) / columnsrows = ( count + columns - 1 ) / columnsdocH = rows * ( _tilesHeight + _tilesGap ) + _tilesGapif ( docH < area.size.height ) then docH = area.size.heightViewSetFrame( docTag, fn CGRectMake( 0, 0, area.size.width, docH ) )for i = 0 to count - 1aRecord = fn ArrayObjectAtIndex( records, i )column = i mod columnsrow = i / columnsx = _tilesGap + column * ( tileW + _tilesGap )y = docH - ( row + 1 ) * ( _tilesHeight + _tilesGap )tag = fn TilesTileTag( pageIndex, i )title = fn BindingString( aRecord, titleKey )if ( fn StringLength( title ) == 0 ) then title = @"(no name)"details = fn MutableStringNewfor d = 0 to (long)fn ArrayCount( detailKeys ) - 1if ( d > 0 ) then MutableStringAppendString( details, @"\n" )MutableStringAppendFormat( details, @"%@: %@", fn ArrayObjectAtIndex( detailTitles, d ), fn BindingString( aRecord, fn ArrayObjectAtIndex( detailKeys, d ) ) )nextif ( i >= built )// a new tile: its panel, its name, its details, the clear button that takes the clickbox tag, @"", fn CGRectMake( x, y, tileW, _tilesHeight ), NSBoxCustom, _shellWindowBoxSetFillColor( tag, gTilesFill )BoxSetBorderColor( tag, gTilesBorder )BoxSetBorderWidth( tag, 1.0 )BoxSetCornerRadius( tag, 10.0 )ViewAddSubview( docTag, tag )fn TilesShadow( tag )textlabel tag + 1, title, fn CGRectMake( x + 14, y + _tilesHeight - 34, tileW - 28, 20 ), _shellWindowControlSetFont( tag + 1, fn FontSystemFontOfSizeAndWeight( 14.0, NSFontWeightSemibold ) )TextFieldSetTextColor( tag + 1, fn ColorLabel )ViewAddSubview( docTag, tag + 1 )textlabel tag + 2, details, fn CGRectMake( x + 14, y + 10, tileW - 28, _tilesHeight - 48 ), _shellWindowControlSetFont( tag + 2, fn FontSystemFontOfSize( 11.0 ) )TextFieldSetTextColor( tag + 2, fn ColorSecondaryLabel )TextFieldSetMaximumNumberOfLines( tag + 2, 4 )ViewAddSubview( docTag, tag + 2 )button tag + 3, YES, , @"", fn CGRectMake( x, y, tileW, _tilesHeight ), NSButtonTypeMomentaryChange, NSBezelStyleRegularSquare, _shellWindowButtonSetBordered( tag + 3, NO )ButtonSetTransparent( tag + 3, YES )ViewAddSubview( docTag, tag + 3 )built = i + 1end ifControlSetStringValue( tag + 1, title )ControlSetStringValue( tag + 2, details )ViewSetFrame( tag, fn CGRectMake( x, y, tileW, _tilesHeight ) )ViewSetFrame( tag + 1, fn CGRectMake( x + 14, y + _tilesHeight - 34, tileW - 28, 20 ) )ViewSetFrame( tag + 2, fn CGRectMake( x + 14, y + 10, tileW - 28, _tilesHeight - 48 ) )ViewSetFrame( tag + 3, fn CGRectMake( x, y, tileW, _tilesHeight ) )ViewSetAutoresizingMask( tag, proportional )                // the tiles stretch with the windowViewSetAutoresizingMask( tag + 1, proportional )ViewSetAutoresizingMask( tag + 2, proportional )ViewSetAutoresizingMask( tag + 3, proportional )ViewSetHidden( tag, NO ) : ViewSetHidden( tag + 1, NO ) : ViewSetHidden( tag + 2, NO ) : ViewSetHidden( tag + 3, NO )fn TilesMark( pageIndex, i, NO )next// tiles left over from more recordsfor i = count to built - 1tag = fn TilesTileTag( pageIndex, i )ViewSetHidden( tag, YES ) : ViewSetHidden( tag + 1, YES ) : ViewSetHidden( tag + 2, YES ) : ViewSetHidden( tag + 3, YES )nextfn TilesPageSetLong( pageIndex, @"built", built )fn TilesPageSetLong( pageIndex, @"count", count )fn TilesPageSetLong( pageIndex, @"selected", -1 )ViewScrollPoint( docTag, fn CGPointMake( 0, docH ) )        // start at the topend fn// a click: the index of the tile's record (it is marked as picked), -2 for the Grid / Tiles switch (handled// here), -1 when the click was not ourslocal fn RecordTilesClicked( tag as long ) as longlong pageIndex, offset, indexif ( tag < _tilesTagBase || tag >= _tilesTagBase + 100 * _tilesTagsPerPage ) then exit fn = -1pageIndex = ( tag - _tilesTagBase ) / _tilesTagsPerPageoffset = ( tag - _tilesTagBase ) mod _tilesTagsPerPageif ( offset == 2 )fn TilesPageSetLong( pageIndex, @"tiles", fn SegmentedControlSelectedSegment( tag ) )fn RecordTilesApplyMode( pageIndex )exit fn = -2end ifif ( offset < 10 || ( offset - 10 ) mod 4 != 3 ) then exit fn = -1index = ( offset - 10 ) / 4if ( index >= fn TilesPageLong( pageIndex, @"count" ) ) then exit fn = -1fn TilesMark( pageIndex, fn TilesPageLong( pageIndex, @"selected" ), NO )fn TilesMark( pageIndex, index, YES )fn TilesPageSetLong( pageIndex, @"selected", index )end fn = index