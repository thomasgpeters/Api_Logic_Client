/* *   ALS App.incl * *   Master-detail shell for generated FutureBasic apps.  Copied unchanged into *   every generated project.  Needs ALS Client.incl and ALS Binding.incl first, *   and a Model.json resource written by the generator: * *       { "resources": [ { name, nib, viewTag, viewWidth, viewHeight, *                          listColumns:[names], fields:[ {name,label,type,kind,tag} ] } ] } * *   Window layout *       +---------------------------------------------------------------+ *       | User [____]  Password [____]  [Connect]      (security on)    | *       | Resources  | records table (listColumns of the resource)      | *       |  Category  |                                                  | *       |  Customer  |--------------------------------------------------| *       |  ...       | <Resource>View.xib  (the generated detail view)  | *       | [New] [Save] [Delete] [Refresh]   status                       | *       +---------------------------------------------------------------+ * *   Requests run one at a time; gALSPendingOp says what the reply is for. */_alsWindow = 1// fixed controls (generated field tags start at 100)_alsResourceScroll  = 10_alsResourceTable   = 11_alsUserLabel       = 20_alsUserField       = 21_alsPasswordLabel   = 22_alsPasswordField   = 23_alsConnectBtn      = 24_alsNewBtn          = 30_alsSaveBtn         = 31_alsDeleteBtn       = 32_alsRefreshBtn      = 33_alsStatusLabel     = 34_alsRecordTableBase = 50000           // + resource index_alsRecordScrollBase = 51000          // + resource index// layout_alsMargin        = 20_alsSidebarWidth  = 200_alsButtonBarH    = 60_alsLoginBarH     = 40_alsWindowHeight  = 780_alsGap           = 12// menus_alsMenuFile    = 1_alsMenuEdit    = 2_alsMenuRecords = 3begin enum 1_alsItemNew_alsItemSave_alsItemDelete_alsItemSeparator_alsItemRefreshend enum// pending operationsbegin enum 1_alsOpLogin_alsOpLoginFallback_alsOpList_alsOpCreate_alsOpUpdate_alsOpDeleteend enumbegin globalsCFArrayRef      gALSModel              // resources from Model.jsonCFArrayRef      gALSRecordList         // records currently in the records tableCFTypeRef       gALSCurrentID          // id of the record in the detail view; NULL = newCFDictionaryRef gALSCurrentAttributes  // its attributes as loaded; NULL = newlong            gALSCurrentIndex       // selected resource; -1 = nonelong            gALSPendingOpBOOL            gALSBusyptr             gALSHandler            // @fn ALSResponseHandler, set in ALSAppStartend globals// a value kept in a global past this event: FB's globals do not retain (as DataKept, Data Model.incl)local fn ALSAppKept( valueToKeep as CFTypeRef, valueBefore as CFTypeRef ) as CFTypeRefif ( valueToKeep != NULL ) then fn CFRetain( valueToKeep )if ( valueBefore != NULL ) then CFRelease( valueBefore )end fn = valueToKeep/* *   model access */local fn ALSLoadModel as BOOLCFURLRef        urlCFDataRef       dtaCFDictionaryRef jsonErrorRef        err = NULLurl = fn BundleURLForResource( fn BundleMain, @"Model", @"json", NULL )if ( url == NULL ) then exit fn = NOdta = fn DataWithContentsOfURL( url, 0, @err )if ( dta == NULL ) then exit fn = NOjson = fn JSONSerializationJSONObjectWithData( dta, 0, @err )if ( json == NULL ) then exit fn = NOgALSModel = fn ALSAppKept( fn DictionaryObjectForKey( json, @"resources" ), gALSModel )end fn = ( gALSModel != NULL )local fn ALSResource( index as long ) as CFDictionaryRefif ( index < 0 || index >= fn ArrayCount( gALSModel ) ) then exit fn = NULLend fn = fn ArrayObjectAtIndex( gALSModel, index )local fn ALSResourceName( index as long ) as CFStringRefend fn = fn DictionaryObjectForKey( fn ALSResource( index ), @"name" )local fn ALSResourceFields( index as long ) as CFArrayRefend fn = fn DictionaryObjectForKey( fn ALSResource( index ), @"fields" )local fn ALSResourceInteger( index as long, key as CFStringRef ) as longend fn = fn NumberIntegerValue( fn DictionaryObjectForKey( fn ALSResource( index ), key ) )local fn ALSTopY as longlong top = _alsWindowHeight - _alsMarginif ( gALSSecurityOn ) then top = _alsWindowHeight - _alsLoginBarHend fn = topvoid local fn ALSSetStatus( message as CFStringRef )ControlSetStringValue( _alsStatusLabel, message )end fn/* *   window */// the app's menus are built by its own Menus.incl (BuildMenus) with the _alsMenu... constants// left edge of the entity parts (records table and Form view)local fn ALSPartX as longend fn = _alsMargin + _alsSidebarWidth + _alsMarginvoid local fn ALSBuildWindow( title as CFStringRef )CGRect            rCFDictionaryRef   resourceCFMutableArrayRef rows = fn MutableArrayNewlong              maxViewWidth = 600, w, x, topfor resource in gALSModelw = fn NumberIntegerValue( fn DictionaryObjectForKey( resource, @"viewWidth" ) )if ( w > maxViewWidth ) then maxViewWidth = wMutableArrayAddObject( rows, @{ @"resource":fn DictionaryObjectForKey( resource, @"name" ) } )nextr = fn CGRectMake( 0, 0, _alsMargin + _alsSidebarWidth + _alsMargin + maxViewWidth + _alsMargin, _alsWindowHeight )window _alsWindow, title, r, NSWindowStyleMaskTitled + NSWindowStyleMaskClosable + NSWindowStyleMaskMiniaturizableWindowCenter( _alsWindow )top = fn ALSTopY// login barif ( gALSSecurityOn )x = _alsMarginr = fn CGRectMake( x, _alsWindowHeight - 30, 40, 16 )         : textlabel _alsUserLabel, @"User:", r, _alsWindowr = fn CGRectMake( x + 44, _alsWindowHeight - 32, 160, 22 )   : textfield _alsUserField, YES, gALSUser, r, _alsWindowr = fn CGRectMake( x + 220, _alsWindowHeight - 30, 70, 16 )   : textlabel _alsPasswordLabel, @"Password:", r, _alsWindowr = fn CGRectMake( x + 294, _alsWindowHeight - 32, 160, 22 )  : securetextfield _alsPasswordField, YES, @"", r, _alsWindowr = fn CGRectMake( x + 466, _alsWindowHeight - 36, 100, 32 )  : button _alsConnectBtn, YES, , @"Connect", r, NSButtonTypeMomentaryPushIn, NSBezelStyleRounded, _alsWindowend if// resource listr = fn CGRectMake( _alsMargin, _alsButtonBarH, _alsSidebarWidth, top - _alsButtonBarH )scrollview _alsResourceScroll, r, NSBezelBorder, , _alsWindowtableview _alsResourceTable, YES, r, @[ @"resource" ], fn NumberWithInteger( _alsSidebarWidth - 4 ), _alsResourceScroll, _alsWindowTableColumnSetTitle( fn TableViewTableColumnWithIdentifier( _alsResourceTable, @"resource" ), @"Resources" )TableViewSetData( _alsResourceTable, rows )TableViewReloadData( _alsResourceTable )// button barr = fn CGRectMake( _alsMargin, 14, 90, 32 )   : button _alsNewBtn,     YES, , @"New",     r, NSButtonTypeMomentaryPushIn, NSBezelStyleRounded, _alsWindowr = fn CGRectMake( _alsMargin + 94, 14, 90, 32 )  : button _alsSaveBtn,    YES, , @"Save",    r, NSButtonTypeMomentaryPushIn, NSBezelStyleRounded, _alsWindowr = fn CGRectMake( _alsMargin + 188, 14, 90, 32 ) : button _alsDeleteBtn,  YES, , @"Delete",  r, NSButtonTypeMomentaryPushIn, NSBezelStyleRounded, _alsWindowr = fn CGRectMake( _alsMargin + 282, 14, 90, 32 ) : button _alsRefreshBtn, YES, , @"Refresh", r, NSButtonTypeMomentaryPushIn, NSBezelStyleRounded, _alsWindowr = fn CGRectMake( _alsMargin + 390, 22, maxViewWidth, 16 ) : textlabel _alsStatusLabel, @"", r, _alsWindowend fn// records table + detail view for one resource, created the first time it is shown;// the app's Windows.incl normally loads the Form views already (nibview)void local fn ALSEnsureResourceViews( index as long )CGRect          rCFArrayRef      listColumns, fieldsCFDictionaryRef fieldCFStringRef     namelong            viewTag, viewHeight, tableTag, scrollTag, x, tableYviewTag = fn ALSResourceInteger( index, @"viewTag" )scrollTag  = _alsRecordScrollBase + indexif ( fn ViewExists( viewTag ) && fn ViewExists( scrollTag ) ) then exit fnviewHeight = fn ALSResourceInteger( index, @"viewHeight" )tableTag   = _alsRecordTableBase + indexx          = fn ALSPartXtableY     = _alsButtonBarH + viewHeight + _alsGap// detail view, from the generated XIBif ( fn ViewExists( viewTag ) == NO )nibview viewTag, fn DictionaryObjectForKey( fn ALSResource( index ), @"nib" ), , ( x, _alsButtonBarH )end ifif ( fn ViewExists( scrollTag ) ) then exit fn// records table above itlistColumns = fn DictionaryObjectForKey( fn ALSResource( index ), @"listColumns" )r = fn CGRectMake( x, tableY, fn ALSResourceInteger( index, @"viewWidth" ), fn ALSTopY - tableY )scrollview scrollTag, r, NSBezelBorder, , _alsWindowtableview tableTag, YES, r, listColumns, fn NumberWithInteger( 140 ), scrollTag, _alsWindowfields = fn ALSResourceFields( index )for field in fieldsname = fn DictionaryObjectForKey( field, @"name" )if ( fn TableViewTableColumnWithIdentifier( tableTag, name ) != NULL ) then TableColumnSetTitle( fn TableViewTableColumnWithIdentifier( tableTag, name ), fn DictionaryObjectForKey( field, @"title" ) )nextTableViewSetData( tableTag, fn MutableArrayNew )end fnvoid local fn ALSSetResourceViewsHidden( index as long, hidden as BOOL )long viewTagif ( fn ALSResource( index ) == NULL ) then exit fnviewTag = fn ALSResourceInteger( index, @"viewTag" )if ( fn ViewExists( viewTag ) ) then ViewSetHidden( viewTag, hidden )if ( fn ViewExists( _alsRecordScrollBase + index ) ) then ViewSetHidden( _alsRecordScrollBase + index, hidden )end fn/* *   records */void local fn ALSFillRecordTable( records as CFArrayRef )CFMutableArrayRef      rows = fn MutableArrayNewCFMutableDictionaryRef rowCFDictionaryRef        aRecord, attributesCFArrayRef             listColumnsCFStringRef            namelong                   tableTag = _alsRecordTableBase + gALSCurrentIndexgALSRecordList = recordslistColumns = fn DictionaryObjectForKey( fn ALSResource( gALSCurrentIndex ), @"listColumns" )for aRecord in recordsattributes = fn DictionaryObjectForKey( aRecord, @"attributes" )row = fn MutableDictionaryNewfor name in listColumnsMutableDictionarySetObjectForKey( row, fn ALSStringForValue( fn DictionaryObjectForKey( attributes, name ) ), name )nextMutableArrayAddObject( rows, row )nextTableViewSetData( tableTag, rows )TableViewReloadData( tableTag )fn ALSSetStatus( fn StringWithFormat( @"%ld %@ records", fn ArrayCount( records ), fn ALSResourceName( gALSCurrentIndex ) ) )end fnvoid local fn ALSShowRecord( row as long )CFDictionaryRef aRecordif ( gALSRecordList == NULL || row < 0 || row >= fn ArrayCount( gALSRecordList ) ) then exit fnaRecord = fn ArrayObjectAtIndex( gALSRecordList, row )gALSCurrentID         = fn ALSAppKept( fn DictionaryObjectForKey( aRecord, @"id" ), gALSCurrentID )gALSCurrentAttributes = fn ALSAppKept( fn DictionaryObjectForKey( aRecord, @"attributes" ), gALSCurrentAttributes )fn ALSBindRecordToView( fn ALSResourceFields( gALSCurrentIndex ), gALSCurrentAttributes )end fnvoid local fn ALSNewRecordif ( gALSCurrentIndex < 0 ) then exit fngALSCurrentID         = NULLgALSCurrentAttributes = NULLTableViewDeselectAll( _alsRecordTableBase + gALSCurrentIndex )fn ALSBindRecordToView( fn ALSResourceFields( gALSCurrentIndex ), NULL )fn ALSSetStatus( fn StringWithFormat( @"New %@", fn ALSResourceName( gALSCurrentIndex ) ) )end fn/* *   requests */local fn ALSBegin( op as long ) as BOOLif ( gALSBusy ) then exit fn = NOgALSBusy      = YESgALSPendingOp = opend fn = YESvoid local fn ALSRequestFailedToStartgALSBusy = NOfn ALSSetStatus( @"Could not start the request - check the server address." )end fnvoid local fn ALSRefreshif ( gALSCurrentIndex < 0 ) then exit fnif ( fn ALSBegin( _alsOpList ) == NO ) then exit fnfn ALSSetStatus( fn StringWithFormat( @"Loading %@…", fn ALSResourceName( gALSCurrentIndex ) ) )if ( fn ALSList( fn ALSResourceName( gALSCurrentIndex ), gALSHandler ) == NO ) then fn ALSRequestFailedToStartend fnvoid local fn ALSConnect( loginPath as CFStringRef, op as long )if ( fn ALSBegin( op ) == NO ) then exit fnif ( fn ViewExists( _alsUserField ) )gALSUser     = fn ALSAppKept( fn ControlStringValue( _alsUserField ), gALSUser )gALSPassword = fn ALSAppKept( fn ControlStringValue( _alsPasswordField ), gALSPassword )end iffn ALSSetStatus( fn StringWithFormat( @"Connecting to %@…", gALSHost ) )if ( fn ALSLogin( loginPath, gALSHandler ) == NO ) then fn ALSRequestFailedToStartend fnvoid local fn ALSSaveRecordCFDictionaryRef changesCFStringRef     resourceBOOL            startedif ( gALSCurrentIndex < 0 ) then exit fnchanges = fn ALSAttributesFromView( fn ALSResourceFields( gALSCurrentIndex ), gALSCurrentAttributes )if ( fn DictionaryCount( changes ) == 0 )fn ALSSetStatus( @"No changes to save." )exit fnend ifresource = fn ALSResourceName( gALSCurrentIndex )if ( gALSCurrentID == NULL )if ( fn ALSBegin( _alsOpCreate ) == NO ) then exit fnstarted = fn ALSCreate( resource, changes, gALSHandler )elseif ( fn ALSBegin( _alsOpUpdate ) == NO ) then exit fnstarted = fn ALSUpdate( resource, gALSCurrentID, changes, gALSHandler )end ifif ( started ) then fn ALSSetStatus( @"Saving…" ) else fn ALSRequestFailedToStartend fnvoid local fn ALSDeleteRecordNSModalResponse responseif ( gALSCurrentIndex < 0 || gALSCurrentID == NULL ) then exit fnresponse = alert 1, NSAlertStyleWarning, fn StringWithFormat( @"Delete this %@?", fn ALSResourceName( gALSCurrentIndex ) ), @"This cannot be undone.", @[@"Delete", @"Cancel"]if ( response != NSAlertFirstButtonReturn ) then exit fnif ( fn ALSBegin( _alsOpDelete ) == NO ) then exit fnif ( fn ALSDelete( fn ALSResourceName( gALSCurrentIndex ), gALSCurrentID, gALSHandler ) ) then fn ALSSetStatus( @"Deleting…" ) else fn ALSRequestFailedToStartend fnvoid local fn ALSShowResource( index as long )if ( fn ALSResource( index ) == NULL ) then exit fnif ( index != gALSCurrentIndex ) then fn ALSSetResourceViewsHidden( gALSCurrentIndex, YES )fn ALSEnsureResourceViews( index )fn ALSSetResourceViewsHidden( index, NO )gALSCurrentIndex = indexgALSRecordList   = NULLfn ALSNewRecordfn ALSRefreshend fn/* *   replies - always on the main thread */void local fn ALSRequestFinished( status as long, json as CFTypeRef, err as ErrorRef )long op = gALSPendingOpBOOL ok = ( status >= 200 && status < 300 )gALSBusy = NOselect ( op )case _alsOpLogin, _alsOpLoginFallbackif ( status == 404 && op == _alsOpLogin && gALSFallbackLoginPath != NULL )fn ALSConnect( gALSFallbackLoginPath, _alsOpLoginFallback )exit fnend ifif ( ok ) then gALSToken = fn ALSAppKept( fn DictionaryObjectForKey( json, @"access_token" ), gALSToken )if ( gALSToken == NULL )fn ALSSetStatus( fn StringWithFormat( @"Login failed - %@", fn ALSErrorMessage( status, json, err ) ) )exit fnend iffn ALSSetStatus( @"Connected." )if ( gALSCurrentIndex < 0 ) then TableViewSelectRow( _alsResourceTable, 0 ) else fn ALSRefreshcase _alsOpListif ( ok ) then fn ALSFillRecordTable( fn DictionaryObjectForKey( json, @"data" ) ) else fn ALSSetStatus( fn ALSErrorMessage( status, json, err ) )case _alsOpCreate, _alsOpUpdate, _alsOpDeleteif ( ok )if ( op == _alsOpDelete ) then fn ALSNewRecordfn ALSRefreshelsefn ALSSetStatus( fn ALSErrorMessage( status, json, err ) )end ifend selectend fnvoid local fn ALSResponseHandler( session as URLSessionRef, dta as CFDataRef, response as URLResponseRef, err as ErrorRef, userData as ptr )long      status = fn ALSResponseStatus( response )CFTypeRef json   = fn ALSResponseJSON( dta )dispatchmainfn ALSRequestFinished( status, json, err )dispatchendend fn/* *   events - call these from the app's own DoDialog / DoMenu / DoAppEvent */void local fn ALSDoDialog( ev as long, tag as long, wnd as long )select ( ev )case _btnClickselect ( tag )case _alsConnectBtn : fn ALSConnect( gALSLoginPath, _alsOpLogin )case _alsNewBtn     : fn ALSNewRecordcase _alsSaveBtn    : fn ALSSaveRecordcase _alsDeleteBtn  : fn ALSDeleteRecordcase _alsRefreshBtn : fn ALSRefreshend selectcase _tableViewSelectionDidChangeif ( tag == _alsResourceTable )if ( fn TableViewSelectedRow( tag ) >= 0 ) then fn ALSShowResource( fn TableViewSelectedRow( tag ) )elseif ( tag == _alsRecordTableBase + gALSCurrentIndex ) then fn ALSShowRecord( fn TableViewSelectedRow( tag ) )end ifend selectend fnvoid local fn ALSDoMenu( menuID as long, itemID as long )if ( menuID != _alsMenuRecords ) then exit fnselect ( itemID )case _alsItemNew     : fn ALSNewRecordcase _alsItemSave    : fn ALSSaveRecordcase _alsItemDelete  : fn ALSDeleteRecordcase _alsItemRefresh : fn ALSRefreshend selectend fnvoid local fn ALSDoAppEvent( ev as long )select ( ev )case _appShouldTerminateAfterLastWindowClosed : AppEventSetBool( YES )end selectend fn/* *   start-up - from the app's main, after setting the gALS... connection globals: *       if ( fn ALSAppStart ) then BuildMenus, BuildWindows( title ), ALSAppReady */local fn ALSAppStart as BOOLgALSHandler      = @fn ALSResponseHandlergALSCurrentIndex = -1if ( fn ALSLoadModel == NO )alert 1, NSAlertStyleCritical, @"Model.json is missing or invalid.", @"Regenerate the project with App Builder for FutureBasic.", @[@"OK"], NOexit fn = NOend ifend fn = YES// after the window is builtvoid local fn ALSAppReadyif ( gALSSecurityOn )fn ALSSetStatus( @"Enter your credentials and Connect." )elseTableViewSelectRow( _alsResourceTable, 0 )end ifend fn