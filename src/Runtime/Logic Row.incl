/* *   I M A G E R Y    B U S I N E S S     S Y S T E M S,   L L C * *   Logic Row.incl - runtime: LogicBank for FutureBasic, the row a rule sees * *   A LogicRowRef is the record being saved, with its old values: *       { entity, row (the record), old (stored values; absent on insert), *         verb ("insert" / "update" / "delete"), nest (chaining depth) } *   Rule functions read it only through these calls - so the engine knows what a *   rule reads, and rules stay readable:  fn LogicDouble( logicRow, @"Quantity" ) */local fn LogicNewRow( entityName as StringRef, aRecord as MutableDictionaryRef, oldRecord as DictionaryRef, verb as StringRef, nest as long ) as LogicRowRefLogicRowRef logicRow = fn MutableDictionaryNewMutableDictionarySetObjectForKey( logicRow, entityName, @"entity" )MutableDictionarySetObjectForKey( logicRow, aRecord, @"row" )if ( oldRecord != NULL ) then MutableDictionarySetObjectForKey( logicRow, oldRecord, @"old" )MutableDictionarySetObjectForKey( logicRow, verb, @"verb" )MutableDictionarySetObjectForKey( logicRow, fn NumberWithInteger( nest ), @"nest" )end fn = logicRowlocal fn LogicEntityName( logicRow as LogicRowRef ) as StringRefend fn = fn DictionaryObjectForKey( logicRow, @"entity" )local fn LogicRecord( logicRow as LogicRowRef ) as MutableDictionaryRefend fn = (MutableDictionaryRef)fn DictionaryObjectForKey( logicRow, @"row" )local fn LogicIsInsert( logicRow as LogicRowRef ) as BOOLend fn = fn StringIsEqual( fn DictionaryObjectForKey( logicRow, @"verb" ), @"insert" )local fn LogicIsUpdate( logicRow as LogicRowRef ) as BOOLend fn = fn StringIsEqual( fn DictionaryObjectForKey( logicRow, @"verb" ), @"update" )local fn LogicIsDelete( logicRow as LogicRowRef ) as BOOLend fn = fn StringIsEqual( fn DictionaryObjectForKey( logicRow, @"verb" ), @"delete" )// the attribute's value: NSNumber / NSString / NSData, or NSNull when emptylocal fn LogicValue( logicRow as LogicRowRef, attrName as StringRef ) as CFTypeRefCFTypeRef value = fn DictionaryObjectForKey( fn LogicRecord( logicRow ), attrName )if ( value == NULL ) then value = fn DataNullend fn = value// the stored value before this save (NSNull on insert)local fn LogicOldValue( logicRow as LogicRowRef, attrName as StringRef ) as CFTypeRefDictionaryRef oldRecord = fn DictionaryObjectForKey( logicRow, @"old" )CFTypeRef     value = NULLif ( oldRecord != NULL ) then value = fn DictionaryObjectForKey( oldRecord, attrName )if ( value == NULL ) then value = fn DataNullend fn = value// a value as a number: NSNumber as is, numeric valueText parsed, empty as 0local fn LogicNumberOf( value as CFTypeRef ) as doubleif ( fn DataIsNull( value ) ) then exit fn = 0.0if ( fn ObjectIsKindOfClass( value, fn ClassFromString( @"NSNumber" ) ) ) then exit fn = fn NumberDoubleValue( value )if ( fn ObjectIsKindOfClass( value, fn ClassFromString( @"NSString" ) ) ) then exit fn = fn StringDoubleValue( value )end fn = 0.0local fn LogicDouble( logicRow as LogicRowRef, attrName as StringRef ) as doubleend fn = fn LogicNumberOf( fn LogicValue( logicRow, attrName ) )local fn LogicLong( logicRow as LogicRowRef, attrName as StringRef ) as longend fn = (long)fn LogicNumberOf( fn LogicValue( logicRow, attrName ) )// a value as valueText ("" when empty)local fn LogicString( logicRow as LogicRowRef, attrName as StringRef ) as StringRefCFTypeRef value = fn LogicValue( logicRow, attrName )if ( fn DataIsNull( value ) ) then exit fn = @""if ( fn ObjectIsKindOfClass( value, fn ClassFromString( @"NSString" ) ) ) then exit fn = valueend fn = fn ObjectDescription( value )local fn LogicIsEmpty( logicRow as LogicRowRef, attrName as StringRef ) as BOOLend fn = fn DataIsNull( fn LogicValue( logicRow, attrName ) )// YES when two values differ (NULL and NSNull are the same empty value)local fn LogicValuesDiffer( a as CFTypeRef, b as CFTypeRef ) as BOOLif ( fn DataIsNull( a ) && fn DataIsNull( b ) ) then exit fn = NOif ( fn DataIsNull( a ) || fn DataIsNull( b ) ) then exit fn = YESend fn = ( fn ObjectIsEqual( a, b ) == NO )// YES when this save changes the attribute (always YES on insert)local fn LogicChanged( logicRow as LogicRowRef, attrName as StringRef ) as BOOLif ( fn LogicIsInsert( logicRow ) ) then exit fn = YESend fn = fn LogicValuesDiffer( fn LogicValue( logicRow, attrName ), fn LogicOldValue( logicRow, attrName ) )// the parent along a toone role (e.g. an OrderDetail's "Order"), read once per save; NULL when nonelocal fn LogicParent( logicRow as LogicRowRef, roleName as StringRef ) as DictionaryRefMutableDictionaryRef parents = (MutableDictionaryRef)fn DictionaryObjectForKey( logicRow, @"parents" )CFTypeRef            parentRecordif ( parents == NULL )parents = fn MutableDictionaryNewMutableDictionarySetObjectForKey( logicRow, parents, @"parents" )end ifparentRecord = fn DictionaryObjectForKey( parents, roleName )if ( parentRecord == NULL )parentRecord = fn DataParent( fn LogicEntityName( logicRow ), fn LogicRecord( logicRow ), roleName )if ( parentRecord == NULL ) then parentRecord = fn DataNullMutableDictionarySetObjectForKey( parents, parentRecord, roleName )end ifif ( fn DataIsNull( parentRecord ) ) then exit fn = NULLend fn = parentRecord// a parent's attribute: fn LogicParentValue( logicRow, @"Order", @"ShippedDate" ); NSNull without a parentlocal fn LogicParentValue( logicRow as LogicRowRef, roleName as StringRef, attrName as StringRef ) as CFTypeRefDictionaryRef parentRecord = fn LogicParent( logicRow, roleName )CFTypeRef     value = NULLif ( parentRecord != NULL ) then value = fn DictionaryObjectForKey( parentRecord, attrName )if ( value == NULL ) then value = fn DataNullend fn = valuelocal fn LogicParentDouble( logicRow as LogicRowRef, roleName as StringRef, attrName as StringRef ) as doubleend fn = fn LogicNumberOf( fn LogicParentValue( logicRow, roleName, attrName ) )// YES when this save points the row at a different parent along the role (always on insert)local fn LogicRoleChanged( logicRow as LogicRowRef, roleName as StringRef ) as BOOLDictionaryRef relationship = fn DataRelationship( fn LogicEntityName( logicRow ), roleName )ArrayRef      fksStringRef     fkif ( fn LogicIsInsert( logicRow ) ) then exit fn = YESif ( relationship == NULL ) then exit fn = NOfks = fn DictionaryObjectForKey( relationship, @"fks" )for fk in fksif ( fn LogicChanged( logicRow, fk ) ) then exit fn = YESnextend fn = NO// set an attribute from rule code (formulas return their value instead)void local fn LogicSetValue( logicRow as LogicRowRef, attrName as StringRef, value as CFTypeRef )if ( value == NULL ) then value = fn DataNullMutableDictionarySetObjectForKey( fn LogicRecord( logicRow ), value, attrName )end fn// rule functions are called by address, as plain C functions (as FB passes @fn callbacks to Cocoa)local fn LogicCallFormula( formulaFn as ptr, logicRow as LogicRowRef ) as CFTypeRefcln return ((CFTypeRef (*)(CFMutableDictionaryRef))formulaFn)( logicRow );end fn = NULLlocal fn LogicCallCondition( conditionFn as ptr, logicRow as LogicRowRef ) as BOOLcln return ((BOOL (*)(CFMutableDictionaryRef))conditionFn)( logicRow );end fn = NO// a message with {Attr} / {row.Attr} replaced by the row's valueslocal fn LogicFormatMessage( logicRow as LogicRowRef, template as StringRef ) as StringRefArrayRef  columns = fn DataColumns( fn LogicEntityName( logicRow ) )StringRef columnName, valueTextfor columnName in columnsvalueText     = fn LogicString( logicRow, columnName )template = fn StringByReplacingOccurrencesOfString( template, fn StringWithFormat( @"{row.%@}", columnName ), valueText )template = fn StringByReplacingOccurrencesOfString( template, fn StringWithFormat( @"{%@}", columnName ), valueText )nextend fn = template