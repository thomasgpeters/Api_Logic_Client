/* *   I M A G E R Y    B U S I N E S S     S Y S T E M S,   L L C * *   Licence Window.incl - the Licence window, the Licence menu, and the gate on licensed features * *   App Builder menu (after About): *       Licence...                  the licence: who, which edition, until when, every feature ticked or "Enterprise" *       Enter Licence...            the same window, ready for a licence to be pasted *       Upgrade to Enterprise...    the License Server's upgrade page for this licence *       Manage Licence Online...    the account's page on the License Server *       Remove Licence...           off this Mac (asks first) * *   LicenceGate( feature, what ) is how a command asks: YES when the feature is licensed; otherwise it says what the *   feature needs and offers the upgrade (or the Licence window, without a licence). Commands stay visible; a locked *   one carries "(Enterprise)" in its menu title (LicenceUpdateMenus). * *   Design: docs/design/Licensing Design.md */_licenceWindow = 70begin enum 7001_licenceSummaryScroll_licenceSummaryText_licenceEntryLabel_licenceEntryField_licenceEnterButton_licenceGetButton_licenceUpgradeButton_licenceManageButton_licenceRemoveButton_licenceCloseButtonend enum// the menu titles: "(Enterprise)" after a command the licence does not includevoid local fn LicenceUpdateMenusCFStringRef lockedALS = @"", lockedRules = @""if ( fn LicenceAllows( _licenceFeatureALSProjects ) == NO ) then lockedALS = @"  (Enterprise)"if ( fn LicenceAllows( _licenceFeatureRulesExchange ) == NO ) then lockedRules = @"  (Enterprise)"MenuItemSetTitle( _mProject, _iNewALSProject, fn StringWithFormat( @"New Project from API Logic Server…%@", lockedALS ) )MenuItemSetTitle( _mModel, _iOpenMetadata, fn StringWithFormat( @"Open API Logic Server Metadata…%@", lockedALS ) )MenuItemSetTitle( _mModel, _iImportRules, fn StringWithFormat( @"Import Rules from declare_logic.py…%@", lockedRules ) )MenuItemSetTitle( _mModel, _iExportRules, fn StringWithFormat( @"Export Rules to declare_logic.py…%@", lockedRules ) )if ( fn LicenceAllows( _licenceFeatureALSProjects ) ) then MenuItemSetTitle( _mApplication, _iUpgradeLicence, @"Licensed: Enterprise" ) else MenuItemSetTitle( _mApplication, _iUpgradeLicence, @"Upgrade to Enterprise…" )end fn// what the window shows: the licence in words, and the buttons that applyvoid local fn LicenceWindowRefreshif ( fn WindowExists( _licenceWindow ) == NO ) then exit fnTextSetString( _licenceSummaryText, fn LicenceSummary )ControlSetEnabled( _licenceUpgradeButton, ( fn LicenceAllows( _licenceFeatureALSProjects ) == NO ) )ControlSetEnabled( _licenceRemoveButton, ( gLicence != NULL ) )ControlSetEnabled( _licenceManageButton, ( gLicence != NULL ) )end fnvoid local fn LicenceShowCGFloat w = 620, h = 520if ( fn WindowExists( _licenceWindow ) )fn LicenceWindowRefreshWindowMakeKeyAndOrderFront( _licenceWindow )exit fnend ifwindow _licenceWindow, @"App Builder Licence", ( 0, 0, w, h ), NSWindowStyleMaskTitled + NSWindowStyleMaskClosable + NSWindowStyleMaskResizableWindowSetContentMinSize( _licenceWindow, fn CGSizeMake( 520, 440 ) )WindowCenter( _licenceWindow )// the licence in wordsscrollview _licenceSummaryScroll, ( 20, 200, w - 40, h - 220 ), NSBezelBorder, , _licenceWindowViewSetAutoresizingMask( _licenceSummaryScroll, NSViewWidthSizable + NSViewHeightSizable )textview _licenceSummaryText, , _licenceSummaryScroll, , _licenceWindowTextViewSetEditable( _licenceSummaryText, NO )TextViewSetSelectable( _licenceSummaryText, YES )TextViewSetTextContainerInset( _licenceSummaryText, fn CGSizeMake( 12, 10 ) )// a licence to enter: paste it, Enter Licencetextlabel _licenceEntryLabel, @"Paste the licence from your email (or click the link in it), then Enter Licence:", ( 20, 168, w - 40, 18 ), _licenceWindowViewSetAutoresizingMask( _licenceEntryLabel, NSViewWidthSizable + NSViewMaxYMargin )textfield _licenceEntryField, YES, @"", ( 20, 108, w - 40, 54 ), _licenceWindowTextFieldSetPlaceholderString( _licenceEntryField, @"the licence: two long parts joined by a full stop" )ViewSetAutoresizingMask( _licenceEntryField, NSViewWidthSizable + NSViewMaxYMargin )button _licenceEnterButton, YES, , @"Enter Licence", ( w - 160, 70, 140, 30 ), NSButtonTypeMomentaryPushIn, NSBezelStyleRounded, _licenceWindowViewSetAutoresizingMask( _licenceEnterButton, NSViewMinXMargin + NSViewMaxYMargin )button _licenceGetButton, YES, , @"Get a Free Lite Licence", ( 20, 70, 200, 30 ), NSButtonTypeMomentaryPushIn, NSBezelStyleRounded, _licenceWindowViewSetAutoresizingMask( _licenceGetButton, NSViewMaxXMargin + NSViewMaxYMargin )// the bottom rowbutton _licenceUpgradeButton, YES, , @"Upgrade to Enterprise…", ( 20, 20, 190, 30 ), NSButtonTypeMomentaryPushIn, NSBezelStyleRounded, _licenceWindowViewSetAutoresizingMask( _licenceUpgradeButton, NSViewMaxXMargin + NSViewMaxYMargin )button _licenceManageButton, YES, , @"Manage Online…", ( 212, 20, 140, 30 ), NSButtonTypeMomentaryPushIn, NSBezelStyleRounded, _licenceWindowViewSetAutoresizingMask( _licenceManageButton, NSViewMaxXMargin + NSViewMaxYMargin )button _licenceRemoveButton, YES, , @"Remove…", ( 354, 20, 100, 30 ), NSButtonTypeMomentaryPushIn, NSBezelStyleRounded, _licenceWindowViewSetAutoresizingMask( _licenceRemoveButton, NSViewMaxXMargin + NSViewMaxYMargin )button _licenceCloseButton, YES, , @"Close", ( w - 120, 20, 100, 30 ), NSButtonTypeMomentaryPushIn, NSBezelStyleRounded, _licenceWindowViewSetAutoresizingMask( _licenceCloseButton, NSViewMinXMargin + NSViewMaxYMargin )fn LicenceWindowRefreshend fn// Enter Licence: the pasted licence, verified and kept - or why notvoid local fn LicenceEnterFromWindowif ( fn LicenceEnter( fn ControlStringValue( _licenceEntryField ) ) )ControlSetStringValue( _licenceEntryField, @"" )alert 1, NSAlertStyleInformational, fn StringWithFormat( @"Thank you: App Builder %@ is licensed to %@.", fn LicenceEdition, fn LicenceAccount ), @"", @[@"OK"], NOelsealert 1, NSAlertStyleWarning, @"The licence was not entered.", gLicenceProblem, @[@"OK"], NOend iffn LicenceUpdateMenusfn LicenceWindowRefreshend fnvoid local fn LicenceRemoveAskingNSModalResponse responseresponse = alert 1, NSAlertStyleWarning, @"Remove the licence from this Mac?", @"App Builder will not generate apps until a licence is entered again. The licence itself stays yours: it is in your email and on your account.", @[@"Remove", @"Cancel"]if ( response != NSAlertFirstButtonReturn ) then exit fnfn LicenceRemovefn LicenceUpdateMenusfn LicenceWindowRefreshend fn// Upgrade: this licence's upgrade page; without a licence, the product page (register first)void local fn LicenceUpgradeif ( gLicence == NULL ) then fn LicenceOpenPage( LICENCE_PAGE ) else fn LicenceOpenUpgradeend fn// is the feature licensed?  If not, say what it needs and offer the way there; NO stops the commandlocal fn LicenceGate( featureMask as long, what as CFStringRef ) as BOOLNSModalResponse responseif ( fn LicenceAllows( featureMask ) ) then exit fn = YESif ( gLicence == NULL )response = alert 1, NSAlertStyleInformational, fn StringWithFormat( @"%@ needs a licence.", what ), fn StringWithFormat( @"%@\n\nLite is free: register on Imagery's App Builder page, and enter the licence that comes by email.", gLicenceProblem ), @[@"Licence…", @"Not Now"]if ( response == NSAlertFirstButtonReturn ) then fn LicenceShowexit fn = NOend ifresponse = alert 1, NSAlertStyleInformational, fn StringWithFormat( @"%@ is part of the Enterprise edition.", what ), @"Enterprise adds API Logic Server: three-tier apps for many users, the rules enforced on the server, sign-in and security, and rules shared with your Python project. Upgrade from your Lite licence, on Imagery's App Builder page.", @[@"Upgrade to Enterprise…", @"Not Now"]if ( response == NSAlertFirstButtonReturn ) then fn LicenceUpgradeend fn = NO// at launch: the licence from the Keychain; without a valid one, the Licence windowvoid local fn LicenceStartfn LicenceLoadfn LicenceUpdateMenusif ( gLicence == NULL ) then fn LicenceShowend fnvoid local fn LicenceMenu( itemID as long )select ( itemID )case _iLicence        : fn LicenceShowcase _iEnterLicencefn LicenceShowWindowMakeFirstResponder( _licenceWindow, _licenceEntryField )case _iUpgradeLicence : fn LicenceUpgradecase _iManageLicence  : fn LicenceOpenPage( LICENCE_ACCOUNT_PAGE )case _iRemoveLicence  : fn LicenceRemoveAskingend selectend fn// the window's buttons; YES when the event was the window's (DoDialog then stops)local fn LicenceWindowHandles( ev as long, tag as long ) as BOOLif ( ev != _btnClick ) then exit fn = NOselect ( tag )case _licenceEnterButton   : fn LicenceEnterFromWindowcase _licenceGetButton     : fn LicenceOpenPage( LICENCE_PAGE )case _licenceUpgradeButton : fn LicenceUpgradecase _licenceManageButton  : fn LicenceOpenPage( LICENCE_ACCOUNT_PAGE )case _licenceRemoveButton  : fn LicenceRemoveAskingcase _licenceCloseButton   : window close _licenceWindowcase else                  : exit fn = NOend selectend fn = YES