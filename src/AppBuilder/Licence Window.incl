/* *   I M A G E R Y    B U S I N E S S     S Y S T E M S,   L L C * *   Licence Window.incl - the Licence page, the Licence menu item, and the gate on licensed features * *   App Builder menu (after About): Licence... - one item (author, 2026-11-28: "simple, not too many menus"). * *   The Licence page is information and buttons, in the Studio's window (a page like Project Settings): *     without a licence   one big button, Get the Free Lite Edition (the Imagery License Server's sign-up page: the *                         licence comes by email); when a licence is on the clipboard, Use the Licence on the *                         Clipboard - one click; Enter Licence... (a small dialog, the clipboard's licence filled in) *     with a licence      who it is licensed to, the edition, the licence number, issued, valid until, what it *                         includes; Upgrade to Professional (Lite), Renew (the account page on the License Server) *   The key itself is never shown. Getting a licence should meet as little resistance as possible (author). * *   LicenceGate( feature, what ) is how a command asks: YES when the feature is licensed; otherwise it says what the *   feature needs and offers the way there in one click. Commands stay visible; a locked one carries *   "(Professional)" in its menu title (LicenceUpdateMenus). * *   The page's contents are Cocoa (no FB tags inside it). Design: docs/design/Licensing Design.md */begin enum 7101_licencePageGet                 // Get the Free Lite Edition_licencePageEnter               // Enter Licence..._licencePageClipboard           // Use the Licence on the Clipboard_licencePageUpgrade             // Upgrade to Professional_licencePageRenew               // Renewend enumbegin globalsptr gLicencePageHandler          // LicencePageAction, set by LicenceShow (the page calls it; it builds the page again)end globals// the C functions FB calls, declared for every part of the project (FB compiles in several chunks)BeginCDeclarationvoid LicencePageBuild( void *pageView, CFStringRef heading, CFStringRef status, CFArrayRef rows, CFArrayRef features, CFArrayRef buttons, void *cardColor, void *handler );CFStringRef LicenceAskForKey( CFStringRef prefilled );CFStringRef LicenceClipboardText( void );EndCBeginCFunctiontypedef void (*ABLicenceActionFn)( long tag );@interface ABLicenceActions : NSObject@property (assign) void *handler;@end@implementation ABLicenceActions- (void)clicked:(NSButton *)sender { if ( self.handler ) ((ABLicenceActionFn)self.handler)( (long)sender.tag ); }@endstatic ABLicenceActions *abLicenceActions = nil;static NSTextField *ABLicenceLabel( NSString *text, CGFloat size, NSFontWeight weight, NSColor *colour ) {    NSTextField *label = [NSTextField wrappingLabelWithString:text ? text : @""];    label.font = [NSFont systemFontOfSize:size weight:weight];    label.textColor = colour;    label.selectable = YES;    return label;}// the page: a raised card; in it the heading, the status, the rows (title, value), what the licence includes// ([ name, "1" | "0" ]), and the buttons ([ title, tag, "1" for the main one ])void LicencePageBuild( void *pageView, CFStringRef heading, CFStringRef status, CFArrayRef rows, CFArrayRef features, CFArrayRef buttons, void *cardColor, void *handler ) {    NSView *page = (__bridge NSView *)pageView;    NSBox *card;    NSMutableArray *gridRows = [NSMutableArray array], *featureRows = [NSMutableArray array], *buttonViews = [NSMutableArray array];    NSMutableArray *parts = [NSMutableArray array];    NSStackView *stack, *buttonRow;    NSShadow *shadow;    if ( page == nil ) return;    for ( NSView *old in [page.subviews copy] ) [old removeFromSuperview];    if ( abLicenceActions == nil ) abLicenceActions = [[ABLicenceActions alloc] init];    abLicenceActions.handler = handler;    card = [[NSBox alloc] initWithFrame:NSInsetRect( page.bounds, 2, 2 )];    card.boxType = NSBoxCustom; card.borderWidth = 0.0; card.cornerRadius = 12.0; card.titlePosition = NSNoTitle;    card.fillColor = cardColor ? (__bridge NSColor *)cardColor : NSColor.controlBackgroundColor;    card.autoresizingMask = NSViewWidthSizable | NSViewHeightSizable;    shadow = [[NSShadow alloc] init]; shadow.shadowBlurRadius = 8.0; shadow.shadowOffset = NSMakeSize( 0, -2 );    shadow.shadowColor = [NSColor colorWithWhite:0.0 alpha:0.18];    card.wantsLayer = YES; card.shadow = shadow;    [page addSubview:card];    [parts addObject:ABLicenceLabel( (__bridge NSString *)heading, 22, NSFontWeightSemibold, NSColor.labelColor )];    [parts addObject:ABLicenceLabel( (__bridge NSString *)status, 14, NSFontWeightRegular, NSColor.secondaryLabelColor )];    for ( NSArray *row in (__bridge NSArray *)rows ) {        NSTextField *t = ABLicenceLabel( row[0], 13, NSFontWeightRegular, NSColor.secondaryLabelColor );        t.alignment = NSTextAlignmentRight;        [gridRows addObject:@[ t, ABLicenceLabel( row[1], 13, NSFontWeightMedium, NSColor.labelColor ) ]];    }    if ( gridRows.count > 0 ) {        NSGridView *grid = [NSGridView gridViewWithViews:gridRows];        grid.rowSpacing = 8; grid.columnSpacing = 14;        [grid columnAtIndex:0].xPlacement = NSGridCellPlacementTrailing;        [parts addObject:grid];    }    for ( NSArray *f in (__bridge NSArray *)features ) {        BOOL has = [f[1] isEqualToString:@"1"];        NSImageView *mark = [NSImageView imageViewWithImage:[NSImage imageWithSystemSymbolName:( has ? @"checkmark.circle.fill" : @"lock.circle" ) accessibilityDescription:nil]];        mark.contentTintColor = has ? NSColor.systemGreenColor : NSColor.tertiaryLabelColor;        [featureRows addObject:@[ mark, ABLicenceLabel( has ? f[0] : [NSString stringWithFormat:@"%@  (Professional)", f[0]], 13, NSFontWeightRegular, has ? NSColor.labelColor : NSColor.secondaryLabelColor ) ]];    }    if ( featureRows.count > 0 ) {        NSGridView *fg = [NSGridView gridViewWithViews:featureRows];        fg.rowSpacing = 6; fg.columnSpacing = 8;        [parts addObject:ABLicenceLabel( @"Includes", 15, NSFontWeightSemibold, NSColor.labelColor )];        [parts addObject:fg];    }    for ( NSArray *b in (__bridge NSArray *)buttons ) {        NSButton *button = [NSButton buttonWithTitle:b[0] target:abLicenceActions action:@selector(clicked:)];        button.tag = [b[1] integerValue];        button.bezelStyle = NSBezelStylePush;        if ( [b[2] isEqualToString:@"1"] ) { button.keyEquivalent = @"\r"; button.controlSize = NSControlSizeLarge; }        [buttonViews addObject:button];    }    buttonRow = [NSStackView stackViewWithViews:buttonViews];    buttonRow.spacing = 12;    [parts addObject:buttonRow];    stack = [NSStackView stackViewWithViews:parts];    stack.orientation = NSUserInterfaceLayoutOrientationVertical;    stack.alignment = NSLayoutAttributeLeading;    stack.spacing = 18;    stack.translatesAutoresizingMaskIntoConstraints = NO;    [page addSubview:stack];    [stack.topAnchor constraintEqualToAnchor:page.topAnchor constant:34].active = YES;    [stack.leadingAnchor constraintEqualToAnchor:page.leadingAnchor constant:36].active = YES;    [stack.trailingAnchor constraintLessThanOrEqualToAnchor:page.trailingAnchor constant:-36].active = YES;}static NSString *abLicenceText = nil;// Enter Licence...: a small dialog with the licence pasted in (the clipboard's, when it holds one); NULL on CancelCFStringRef LicenceAskForKey( CFStringRef prefilled ) {    NSAlert *alert = [[NSAlert alloc] init];    NSTextField *field = [[NSTextField alloc] initWithFrame:NSMakeRect( 0, 0, 420, 24 )];    field.placeholderString = @"Paste the licence from your email";    field.stringValue = prefilled ? (__bridge NSString *)prefilled : @"";    alert.messageText = @"Enter your licence";    alert.informativeText = @"Paste the licence from your email. It is checked on this Mac and kept in your Keychain.";    alert.accessoryView = field;    [alert addButtonWithTitle:@"Enter"];    [alert addButtonWithTitle:@"Cancel"];    alert.window.initialFirstResponder = field;    if ( [alert runModal] != NSAlertFirstButtonReturn ) return NULL;    abLicenceText = [field.stringValue stringByTrimmingCharactersInSet:NSCharacterSet.whitespaceAndNewlineCharacterSet];    return (__bridge CFStringRef)abLicenceText;}// the text on the clipboard (NULL when there is none)CFStringRef LicenceClipboardText( void ) {    NSString *text = [[NSPasteboard generalPasteboard] stringForType:NSPasteboardTypeString];    if ( text == nil ) return NULL;    abLicenceText = [text stringByTrimmingCharactersInSet:NSCharacterSet.whitespaceAndNewlineCharacterSet];    return (__bridge CFStringRef)abLicenceText;}EndCtoolbox LicencePageBuild( ptr pageView, CFStringRef heading, CFStringRef status, CFArrayRef rows, CFArrayRef features, CFArrayRef buttons, ptr cardColor, ptr handler )toolbox fn LicenceAskForKey( CFStringRef prefilled ) = CFStringReftoolbox fn LicenceClipboardText = CFStringRef// the menu titles: "(Professional)" after a command the licence does not includevoid local fn LicenceUpdateMenusCFStringRef lockedALS = @"", lockedRules = @"", lockedPages = @""if ( fn LicenceAllows( _licenceFeatureALSProjects ) == NO ) then lockedALS = @"  (Professional)"if ( fn LicenceAllows( _licenceFeatureRulesExchange ) == NO ) then lockedRules = @"  (Professional)"if ( fn LicenceAllows( _licenceFeatureProfessionalRuntime ) == NO ) then lockedPages = @"  (Professional)"MenuItemSetTitle( _mProject, _iNewALSProject, fn StringWithFormat( @"New Project from API Logic Server…%@", lockedALS ) )MenuItemSetTitle( _mModel, _iOpenMetadata, fn StringWithFormat( @"Open API Logic Server Metadata…%@", lockedALS ) )MenuItemSetTitle( _mModel, _iImportRules, fn StringWithFormat( @"Import Rules from declare_logic.py…%@", lockedRules ) )MenuItemSetTitle( _mModel, _iExportRules, fn StringWithFormat( @"Export Rules to declare_logic.py…%@", lockedRules ) )MenuItemSetTitle( _mProject, _iPages, fn StringWithFormat( @"Pages%@", lockedPages ) )end fn// a licence on the clipboard, when the text there is one that verifies (NULL otherwise)local fn LicenceOnClipboard as CFStringRefCFStringRef clip = fn LicenceClipboardTextif ( fn StringLength( clip ) < 40 ) then exit fn = NULLif ( fn LicenceVerify( clip, fn LicenceToday ) == NULL ) then exit fn = NULLend fn = clip// what the page shows, built again each time it is shown or the licence changesvoid local fn LicencePageRefreshCFMutableArrayRef rows = fn MutableArrayNew, features = fn MutableArrayNew, buttons = fn MutableArrayNewCFStringRef       status, expireslong              i, mask = 1ViewRef           page = fn StudioFindView( _licenceView )if ( page == NULL ) then exit fnif ( gLicence == NULL )status = @"App Builder needs a licence to generate apps. The Lite edition is free: get it from the Imagery License Server, and your licence comes by email in a minute."if ( fn LicenceOnClipboard != NULL )status = @"A licence is on your clipboard: one click and you are licensed."MutableArrayAddObject( buttons, @[ @"Use the Licence on the Clipboard", fn StringWithFormat( @"%ld", _licencePageClipboard ), @"1" ] )MutableArrayAddObject( buttons, @[ @"Get the Free Lite Edition", fn StringWithFormat( @"%ld", _licencePageGet ), @"0" ] )elseMutableArrayAddObject( buttons, @[ @"Get the Free Lite Edition", fn StringWithFormat( @"%ld", _licencePageGet ), @"1" ] )end ifMutableArrayAddObject( buttons, @[ @"Enter Licence…", fn StringWithFormat( @"%ld", _licencePageEnter ), @"0" ] )LicencePageBuild( page, @"Licence", status, rows, features, buttons, fn StudioCardColor, gLicencePageHandler )exit fnend ifexpires = fn LicenceValue( @"expires" )if ( fn StringLength( expires ) == 0 ) then expires = @"No end date"MutableArrayAddObject( rows, @[ @"Licensed to", fn LicenceValue( @"name" ) ] )MutableArrayAddObject( rows, @[ @"Account", fn LicenceAccount ] )MutableArrayAddObject( rows, @[ @"Edition", fn StringWithFormat( @"%@ edition", fn LicenceEdition ) ] )MutableArrayAddObject( rows, @[ @"Licence number", fn LicenceValue( @"lic" ) ] )MutableArrayAddObject( rows, @[ @"Issued", fn LicenceValue( @"issued" ) ] )MutableArrayAddObject( rows, @[ @"Valid until", expires ] )for i = 0 to _licenceFeatureCount - 1if ( fn LicenceAllows( mask ) ) then MutableArrayAddObject( features, @[ fn LicenceFeatureName( i ), @"1" ] ) else MutableArrayAddObject( features, @[ fn LicenceFeatureName( i ), @"0" ] )mask = mask * 2nextif ( fn LicenceAllows( _licenceFeatureALSProjects ) == NO ) then MutableArrayAddObject( buttons, @[ @"Upgrade to Professional…", fn StringWithFormat( @"%ld", _licencePageUpgrade ), @"1" ] )MutableArrayAddObject( buttons, @[ @"Renew…", fn StringWithFormat( @"%ld", _licencePageRenew ), @"0" ] )MutableArrayAddObject( buttons, @[ @"Enter Licence…", fn StringWithFormat( @"%ld", _licencePageEnter ), @"0" ] )status = fn StringWithFormat( @"App Builder for FutureBasic, %@ edition: licensed and checked on this Mac.", fn LicenceEdition )LicencePageBuild( page, @"Licence", status, rows, features, buttons, fn StudioCardColor, gLicencePageHandler )end fn// a licence entered (from the dialog or the clipboard): kept, thanked, the page and the menus updated - or why notvoid local fn LicenceTake( licenceText as CFStringRef )if ( licenceText == NULL ) then exit fnif ( fn LicenceEnter( licenceText ) )alert 1, NSAlertStyleInformational, fn StringWithFormat( @"Thank you: App Builder %@ edition is licensed to %@.", fn LicenceEdition, fn LicenceAccount ), @"", @[@"OK"], NOelsealert 1, NSAlertStyleWarning, @"The licence was not entered.", gLicenceProblem, @[@"OK"], NOend iffn LicenceUpdateMenusfn LicencePageRefreshend fn// Upgrade: this licence's upgrade page; without a licence, the product page (register first)void local fn LicenceUpgradeif ( gLicence == NULL ) then fn LicenceOpenPage( LICENCE_PAGE ) else fn LicenceOpenUpgradeend fn// the page's buttons (called from Cocoa, LicencePageBuild)void local fn LicencePageAction( tag as long )select ( tag )case _licencePageGet       : fn LicenceOpenPage( LICENCE_PAGE )case _licencePageEnter     : fn LicenceTake( fn LicenceAskForKey( fn LicenceOnClipboard ) )case _licencePageClipboard : fn LicenceTake( fn LicenceOnClipboard )case _licencePageUpgrade   : fn LicenceUpgradecase _licencePageRenew     : fn LicenceOpenPage( LICENCE_ACCOUNT_PAGE )end selectend fn// Licence...: the page, in the Studio's window, across its width (no entity list), the product's name as its headingvoid local fn LicenceShowViewSetHidden( _welcomeView, YES )ViewSetHidden( _projectCreateView, YES )ViewSetHidden( _projectDetailView, YES )ViewSetHidden( _projectSettingsView, YES )ViewSetHidden( _newProjectView, YES )ViewSetHidden( _alsProjectView, YES )ViewSetHidden( _pagesView, YES )ViewSetHidden( _licenceView, NO )gLicencePageHandler = @fn LicencePageActionControlSetStringValue( _projectHeadingName, APP_DISPLAY_NAME )ViewSetHidden( _projectHeadingIcon, YES )fn LicencePageRefreshfn StudioUpdateCommands                               // the layout and the crumb trail: Projects / Licenceend fn// is the feature licensed?  If not, say what it needs and offer the way there in one click; NO stops the commandlocal fn LicenceGate( featureMask as long, what as CFStringRef ) as BOOLNSModalResponse responseif ( fn LicenceAllows( featureMask ) ) then exit fn = YESif ( gLicence == NULL )response = alert 1, NSAlertStyleInformational, fn StringWithFormat( @"%@ needs a licence.", what ), @"The Lite edition is free: get it from the Imagery License Server, and your licence comes by email in a minute.", @[@"Get the Free Lite Edition", @"Licence…", @"Not Now"]if ( response == NSAlertFirstButtonReturn ) then fn LicenceOpenPage( LICENCE_PAGE )if ( response == NSAlertSecondButtonReturn ) then fn LicenceShowexit fn = NOend ifresponse = alert 1, NSAlertStyleInformational, fn StringWithFormat( @"%@ is part of the Professional edition.", what ), @"Professional adds API Logic Server: three-tier apps for many users, the rules enforced on the server, sign-in and security, and rules shared with your Python project. Upgrade from your Lite licence, on Imagery's App Builder page.", @[@"Upgrade to Professional…", @"Not Now"]if ( response == NSAlertFirstButtonReturn ) then fn LicenceUpgradeend fn = NO// at launch: the licence from the Keychain; without a valid one, the Licence pagevoid local fn LicenceStartfn LicenceLoadfn LicenceUpdateMenusif ( gLicence == NULL ) then fn LicenceShowend fnvoid local fn LicenceMenu( itemID as long )if ( itemID == _iLicence ) then fn LicenceShowend fn