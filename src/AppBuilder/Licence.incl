/* *   I M A G E R Y    B U S I N E S S     S Y S T E M S,   L L C * *   Licence.incl - App Builder's licence: verified offline, kept in the Keychain, and the gate on features * *   One app for Lite and Enterprise: the licence's feature bits switch features on (docs/design/Licensing Design.md). *   A licence is "<payload>.<signature>", both base64url: the payload is JSON (lic, product, account, name, edition, *   features, issued, expires); the signature is ECDSA P-256 / SHA-256 (ANSI X9.62, DER) of the payload's text, *   made by the Imagery License Server, which alone holds the private key. App Builder holds the public key and *   checks with macOS's Security framework - offline, and nobody can make a licence without the server's key. * *       LicenceVerify( text, day )   the payload of a genuine licence for this product, not expired; else NULL *       LicenceLoad                   at launch: the licence in the Keychain, verified (gLicence, or gLicenceProblem) *       LicenceEnter( text )          a pasted licence: verified, then saved to the Keychain; YES when it was good *       LicenceRemove                 off this Mac (the Keychain item) *       LicenceAllows( feature )      is the feature licensed?  (_licenceFeature... masks) *       LicenceEdition, LicenceAccount, LicenceSummary    for the Licence window and the About box * *   The reference, and the test licences: tools/licence_reference.py. The Mac test: src/MacTests/Licence Verify Test.fb, *   which carries the part between the "verify" markers below, unchanged (run_tests.sh checks). */// the License Server (to confirm before release), and the Keychain item#define LICENCE_SERVER        @"https://license.imagery.com"#define LICENCE_PAGE          @"/appbuilder"                     // the product's page: register, download#define LICENCE_UPGRADE_PAGE  @"/appbuilder/upgrade?lic=%@"     // the upgrade, for this licence#define LICENCE_ACCOUNT_PAGE  @"/account"                       // the account's licences, renewal, invoices#define LICENCE_KEYCHAIN      @"App Builder for FutureBasic"#define LICENCE_KEYCHAIN_ITEM @"licence"// the feature bits (the License Server's product app_builder_fb mirrors them)_licenceFeatureCore              = 1      // bit 0  Studio core: SQLite projects, generation, rules, LogicBank for FutureBasic_licenceFeatureAI                = 2      // bit 1  the AI Assistant (your own key)_licenceFeatureALSProjects       = 4      // bit 2  API Logic Server projects_licenceFeatureEnterpriseRuntime = 8      // bit 3  Enterprise apps: the API Logic Server client_licenceFeatureRulesExchange     = 16     // bit 4  rules exchanged with ALS (declare_logic.py)_licenceFeatureIntegration       = 32     // bit 5  integration and scheduled rules_licenceFeatureAuthorization     = 64     // bit 6  authorization rules_licenceFeatureGovernance        = 128    // bit 7  rule governance_licenceFeatureGenAILogic        = 256    // bit 8  AI through API Logic Server (genai-logic)_licenceFeatureCount             = 9begin globalsCFDictionaryRef gLicence           // the verified licence's payload; NULL: none, or not validCFStringRef     gLicenceProblem    // why there is no valid licence, for the userend globals// --- verify (shared with the Mac test: src/MacTests/Licence Verify Test.fb) ---#define LICENCE_PRODUCT     @"app_builder_fb"begin globalsCFStringRef gLicenceVerifyProblem   // why LicenceVerify refused the last licence it was givenend globals// THE TEST KEY (tools/licence_test_keys): replaced by the License Server's production public key before release#define LICENCE_PUBLIC_KEY  @"BDuI+tIRfRlumTbUjrwYpvd1KK22UtTexA1UuW+8Pg6cmfLwLCYwm8V+hE5thgQtCLCg9Fbe1KzLDo70enYwsmQ="// base64url (no padding) -> data; NULL when it is not base64urllocal fn LicenceBase64URLDecode( textValue as CFStringRef ) as CFDataRefCFStringRef base64 = fn StringByReplacingOccurrencesOfString( fn StringByReplacingOccurrencesOfString( textValue, @"-", @"+" ), @"_", @"/" )while ( fn StringLength( base64 ) mod 4 != 0 )base64 = fn StringByAppendingString( base64, @"=" )wendend fn = fn DataWithBase64EncodedString( base64, 0 )// today, as the licence writes dates (yyyy-MM-dd)local fn LicenceToday as CFStringRefend fn = fn DateFormatterStringFromDate( fn DateFormatterWithFormat( @"yyyy-MM-dd" ), fn DateNow )// does the signature, made by the License Server's private key, match the text?local fn LicenceSignatureMatches( signedText as CFStringRef, signature as CFDataRef ) as BOOLCFMutableDictionaryRef attributes = fn MutableDictionaryNewCFDataRef              keyData = fn DataWithBase64EncodedString( LICENCE_PUBLIC_KEY, 0 )SecKeyRef              publicKeyif ( keyData == NULL || signature == NULL ) then exit fn = NOMutableDictionarySetObjectForKey( attributes, kSecAttrKeyTypeECSECPrimeRandom, kSecAttrKeyType )MutableDictionarySetObjectForKey( attributes, kSecAttrKeyClassPublic, kSecAttrKeyClass )MutableDictionarySetObjectForKey( attributes, fn NumberWithLong( 256 ), kSecAttrKeySizeInBits )publicKey = fn SecKeyCreateWithData( keyData, attributes, NULL )if ( publicKey == NULL ) then exit fn = NOend fn = fn SecKeyVerifySignature( publicKey, kSecKeyAlgorithmECDSASignatureMessageX962SHA256, fn StringData( signedText, NSUTF8StringEncoding ), signature, NULL )// a licence's text -> its payload when it is genuine, for this product, and not expired (on this day);// else NULL, and why in gLicenceVerifyProblemlocal fn LicenceVerify( licenceText as CFStringRef, onDay as CFStringRef ) as CFDictionaryRefCFArrayRef      partsCFStringRef     body, expiresCFDataRef       signature, payloadDataCFDictionaryRef payloadCFTypeRef       productgLicenceVerifyProblem = @""if ( licenceText == NULL ) then licenceText = @""licenceText = fn StringByTrimmingCharactersInSet( licenceText, fn CharacterSetWhitespaceAndNewlineSet )parts = fn StringComponentsSeparatedByString( licenceText, @"." )if ( fn ArrayCount( parts ) != 2 )gLicenceVerifyProblem = @"This is not a licence: it should be two parts joined by a full stop."exit fn = NULLend ifbody = fn ArrayObjectAtIndex( parts, 0 )signature = fn LicenceBase64URLDecode( fn ArrayObjectAtIndex( parts, 1 ) )payloadData = fn LicenceBase64URLDecode( body )if ( fn StringLength( body ) == 0 || signature == NULL || payloadData == NULL )gLicenceVerifyProblem = @"This is not a licence: it contains characters a licence never has."exit fn = NULLend ifif ( fn LicenceSignatureMatches( body, signature ) == NO )gLicenceVerifyProblem = @"The licence's signature does not match: it was changed, or it was not issued by Imagery."exit fn = NULLend ifpayload = fn JSONSerializationJSONObjectWithData( payloadData, 0, NULL )if ( payload == NULL )gLicenceVerifyProblem = @"The licence could not be read."exit fn = NULLend ifproduct = fn DictionaryObjectForKey( payload, @"product" )if ( product == NULL ) then product = @""if ( fn StringIsEqual( (CFStringRef)product, LICENCE_PRODUCT ) == NO )gLicenceVerifyProblem = @"This licence is for another product."exit fn = NULLend ifexpires = fn DictionaryObjectForKey( payload, @"expires" )if ( expires != NULL )if ( fn ObjectIsKindOfClass( (ObjectRef)expires, fn ClassFromString( @"NSString" ) ) )if ( fn StringCompare( expires, onDay ) == NSOrderedAscending )gLicenceVerifyProblem = fn StringWithFormat( @"This licence expired on %@.", expires )exit fn = NULLend ifend ifend ifend fn = payload// the payload's feature bitslocal fn LicenceFeaturesOf( payload as CFDictionaryRef ) as longCFTypeRef featuresif ( payload == NULL ) then exit fn = 0features = fn DictionaryObjectForKey( payload, @"features" )if ( features == NULL ) then exit fn = 0end fn = fn NumberIntegerValue( features )// --- end verify ---// the Keychain item that holds the licence's textlocal fn LicenceKeychainQuery as CFMutableDictionaryRefCFMutableDictionaryRef query = fn MutableDictionaryNewMutableDictionarySetObjectForKey( query, kSecClassGenericPassword, kSecClass )MutableDictionarySetObjectForKey( query, LICENCE_KEYCHAIN, kSecAttrService )MutableDictionarySetObjectForKey( query, LICENCE_KEYCHAIN_ITEM, kSecAttrAccount )end fn = querylocal fn LicenceKeychainRead as CFStringRefCFMutableDictionaryRef query = fn LicenceKeychainQueryCFTypeRef              result = NULLMutableDictionarySetObjectForKey( query, fn NumberWithBool( YES ), kSecReturnData )MutableDictionarySetObjectForKey( query, kSecMatchLimitOne, kSecMatchLimit )if ( fn SecItemCopyMatching( query, @result ) != errSecSuccess ) then exit fn = NULLif ( result == NULL ) then exit fn = NULLend fn = fn StringWithData( (CFDataRef)result, NSUTF8StringEncoding )local fn LicenceKeychainSave( licenceText as CFStringRef ) as BOOLCFMutableDictionaryRef item = fn LicenceKeychainQueryfn SecItemDelete( fn LicenceKeychainQuery )                  // replace whatever was thereMutableDictionarySetObjectForKey( item, fn StringData( licenceText, NSUTF8StringEncoding ), kSecValueData )MutableDictionarySetObjectForKey( item, @"App Builder for FutureBasic licence", kSecAttrLabel )end fn = ( fn SecItemAdd( item, NULL ) == errSecSuccess )// at launch: the licence in the Keychain, verifiedvoid local fn LicenceLoadCFStringRef licenceText = fn LicenceKeychainReadgLicence = NULLif ( licenceText == NULL )gLicenceProblem = @"No licence is entered on this Mac yet. Lite is free: register on Imagery's App Builder page and your licence comes by email."exit fnend ifgLicence = fn LicenceVerify( licenceText, fn LicenceToday )gLicenceProblem = gLicenceVerifyProblemend fn// a licence entered by the user: verified, then kept; YES when it was good (else gLicenceProblem says why,// and the licence already there stays)local fn LicenceEnter( licenceText as CFStringRef ) as BOOLCFDictionaryRef payload = fn LicenceVerify( licenceText, fn LicenceToday )if ( payload == NULL )gLicenceProblem = gLicenceVerifyProblemexit fn = NOend ifif ( fn LicenceKeychainSave( fn StringByTrimmingCharactersInSet( licenceText, fn CharacterSetWhitespaceAndNewlineSet ) ) == NO )gLicenceProblem = @"The licence is good, but it could not be saved in the Keychain."exit fn = NOend ifgLicence = payloadgLicenceProblem = @""end fn = YESvoid local fn LicenceRemovefn SecItemDelete( fn LicenceKeychainQuery )gLicence = NULLgLicenceProblem = @"The licence was removed from this Mac."end fnlocal fn LicenceAllows( featureMask as long ) as BOOLend fn = ( ( fn LicenceFeaturesOf( gLicence ) and featureMask ) != 0 )local fn LicenceValue( keyName as CFStringRef ) as CFStringRefCFTypeRef valueif ( gLicence == NULL ) then exit fn = @""value = fn DictionaryObjectForKey( gLicence, keyName )if ( value == NULL ) then exit fn = @""if ( fn ObjectIsKindOfClass( (ObjectRef)value, fn ClassFromString( @"NSString" ) ) ) then exit fn = valueend fn = @""// "Lite", "Enterprise", or "" without a licencelocal fn LicenceEdition as CFStringRefif ( gLicence == NULL ) then exit fn = @""if ( fn StringIsEqual( fn LicenceValue( @"edition" ), @"enterprise" ) ) then exit fn = @"Enterprise"end fn = @"Lite"local fn LicenceAccount as CFStringRefend fn = fn LicenceValue( @"account" )local fn LicenceFeatureName( featureIndex as long ) as CFStringRefselect ( featureIndex )case 0 : exit fn = @"Studio: SQLite projects, generation, rules, LogicBank for FutureBasic"case 1 : exit fn = @"AI Assistant (your own key)"case 2 : exit fn = @"API Logic Server projects"case 3 : exit fn = @"Enterprise apps: the API Logic Server client"case 4 : exit fn = @"Rules exchanged with API Logic Server (declare_logic.py)"case 5 : exit fn = @"Integration and scheduled rules"case 6 : exit fn = @"Authorization rules"case 7 : exit fn = @"Rule governance"case 8 : exit fn = @"AI through API Logic Server (genai-logic)"end selectend fn = @""// the licence in words: who, which edition, until when, and each feature with a tick or "Enterprise"local fn LicenceSummary as CFStringRefCFMutableStringRef s = fn MutableStringNewCFStringRef        expireslong               i, mask = 1if ( gLicence == NULL )MutableStringAppendString( s, fn StringWithFormat( @"No valid licence.\n%@\n", gLicenceProblem ) )exit fn = send ifexpires = fn LicenceValue( @"expires" )if ( fn StringLength( expires ) == 0 ) then expires = @"no end date"MutableStringAppendString( s, fn StringWithFormat( @"%@ edition\nLicensed to %@ (%@)\nLicence %@, issued %@, %@\n\n", fn LicenceEdition, fn LicenceValue( @"name" ), fn LicenceAccount, fn LicenceValue( @"lic" ), fn LicenceValue( @"issued" ), expires ) )for i = 0 to _licenceFeatureCount - 1if ( fn LicenceAllows( mask ) ) then MutableStringAppendString( s, @"✓  " ) else MutableStringAppendString( s, @"Enterprise:  " )MutableStringAppendString( s, fn LicenceFeatureName( i ) )MutableStringAppendString( s, @"\n" )mask = mask * 2nextend fn = s// the License Server's pages, in the browservoid local fn LicenceOpenPage( pagePath as CFStringRef )fn WorkspaceOpenURL( fn URLWithString( fn StringByAppendingString( LICENCE_SERVER, pagePath ) ) )end fnvoid local fn LicenceOpenUpgradefn LicenceOpenPage( fn StringWithFormat( LICENCE_UPGRADE_PAGE, fn LicenceValue( @"lic" ) ) )end fn