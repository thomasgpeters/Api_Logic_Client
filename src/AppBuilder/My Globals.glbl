// FutureBasic's own headers, included from source so FB finds them in its Headers folder.// Never list them as project items: FB then looks for the files beside the project, and// with no such file its translator crashes (FutureBasic 7.0.38, 2026-11-24).include "NSLog.incl"include "Tlbx XML.incl"_window 							= 1_objectTableView			= 1_attributeTableView		= 2100_welcomeView	 				= 2_projectCreateView			= 3_projectDetailView			= 4_projectHeadingName		= 5_projectSettingsView		= 6			// ProjectSettingsView.xib (Project Settings.incl)_newProjectView			= 7			// NewProjectView.xib (New Project.incl)_alsProjectView			= 8			// ALSProjectView.xib (Open ALS Project.incl)_mainToolbar       		= 5000// main window layout (MainWindow.xib): the entity list on the left, the page views beside it_minWindowWidth          = 1000_minWindowHeight         = 620_crumbTrailHeight        = 26       // the crumb trail above the heading (Menus.incl)_pageHeadingHeight       = 86       // the crumb trail and the project heading above the page viewsCFMutableDictionaryRef		gProjectDictionary, newResourceDict, newAttributeDict, projectResourcesDict, anObject, theObjectDict, anObjectDictCFMutableArrayRef				resourceList, tempColumnArray, columnArrayCFArrayRef 							arrayOfObjectKeys, arrayOfAttributeKeysCFStringRef							objectName, anObjectKey, newValueCFMutableStringRef				projectNameEnumeratorRef 					keyEnumerator, attributeEnumeratorCFTypeRef 							anAttributeKey, anAttributeCFDictionaryRef					gAuthDictionaryCFDataRef								gAuthDataBOOL										isSecurityOn	=	NOBOOL										isLoggingOn		=	NO		// YES: the Studio's log in the NSLog window (every NSLog is gated on it)CFStringRef 						host = @"http://tnas-appliance.imagery.local:5656"CFURLRef								xibUrl, templateFolderURL, projectFolderURL, apiLogicWorkFolderURLErrorRef 								urlErrorlong										gXibNextID		// XIB Generator: per-document object id counter#define ID_KEY @"identifier"#define OBJECT_KEY @"Object"_mainWindowHeight  			= 797_mainWindowWidth  				= 793_controlSpacer     			= 20_tableViewHeight				= 689_tableViewWidth  				= 254_welcomeViewHeight				= 416_welcomeViewWidth				= 648_projectCreateViewHeight = 416_projectCreateViewWidth  = 648_projectDetailViewHeight = 332_projectDetailViewWidth  = 885begin enum 1000_tableRating_tableCheckbox_tablePopUpend enum_createProjectBtn 				= 100_openProjectBtn					= 101		// WelcomeView.xib_recentProjectsTable			= 102		// WelcomeView.xib - Recent Projects (Recent Projects.incl)begin enum 400								// NewProjectView.xib_newProjectNameEdit_newProjectDatabaseField_newProjectChooseBtn_newProjectTablesLabel_newProjectCreateBtn_newProjectCancelBtn_newProjectUseALSBtnend enumbegin enum 410								// ALSProjectView.xib (Open ALS Project.incl)_alsNameEdit_alsSourceField                             // a folder, a model file or a GitHub address_alsReadBtn_alsFolderBtn_alsFileBtn_alsDropZone                                // made in code: a subclassed view (ALSProjectSetUp)_alsDropLabel_alsSummaryLabel_alsServerEdit                              // where the generated app finds the API_alsCancelBtn_alsCreateBtn_alsRunningServerBtnend enumbegin enum 300								// ProjectSettingsView.xib_aboutTextEdit_aboutCountLabel_projectSettingsDoneBtn_taglineEdit                                // the generated app's header: a line under its name_copyrightEdit                              // the generated app's footer_logoImageWell                              // the generated app's icon picture (paste or drag)_appSymbolLabel                             // ... or, without a picture, an SF Symbol (Project Settings.incl)_appSymbolPopup_appSymbolPreviewend enum#define TAGLINE_TEXT_MAX        80                  // characters of tag-line under the app's name#define BRANDING_FOLDER         @"Branding"         // <project>/Branding/logo.pngbegin enum 200_projectNameEdit_baseURLEdit_authNameEdit_authPasswordEdit_createProjectCancelBtn_createProjectCreateBtnend enumbegin enum 76_objectNameLabel_attributeNameEdit_attributeTypeEdit_formColumnsPopup                           // ProjectDetailView: the entity's Form layout (Windows.incl)_controlPopup                               // ProjectDetailView: the selected attribute's Form control_entityIconPopup                            // ProjectDetailView: the entity's navigation icon (an SF Symbol)_entityIconPreview                          // ... and what it looks likeend enum