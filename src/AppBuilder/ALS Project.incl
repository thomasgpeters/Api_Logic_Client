/* *   I M A G E R Y    B U S I N E S S     S Y S T E M S,   L L C * *   ALS Project.incl - where the Studio finds an API Logic Server project's model * *   API Logic Server generates the model; the Studio only reads it (ALS Model.incl), from *   wherever the developer points: *       a folder   the ALS project's own folder (a clone of its repository): *                  database/models.py, else ui/app/app_model.yaml (ALS 17.3 and earlier), *                  else ui/admin/admin.yaml.  The project's database/ or ui/ folder works too. *       a file     one of those, chosen or dropped (told apart by what is in it, not its name) *       GitHub     a public repository: https://github.com/<owner>/<repo>, optionally *                  /tree/<branch>/<subfolder> or /blob/<branch>/<file>.  The same files over *                  plain HTTPS from raw.githubusercontent.com - no sign-in, no GitHub API; *                  branch main, else master, unless the address names one. *   admin.yaml, when the project has it, adds the column that names a record (user_key): what a *   lookup (Dropdown) shows. * *   The Studio keeps a copy in <project>/ALS Model/ and works from it, so the project opens *   without the original; Project.json "alsSource" says where it came from. * *   ALSProjectStudioModel turns the ALS model into the Studio's own (SQLite Model.incl's shape), *   so definitions, design, XIBs and bindings work on it unchanged. */#define ALS_MODEL_FOLDER        @"ALS Model"#define ALS_MODELS_PY_PATH      @"database/models.py"#define ALS_APP_MODEL_PATH      @"ui/app/app_model.yaml"#define ALS_ADMIN_YAML_PATH     @"ui/admin/admin.yaml"#define ALS_DEFAULT_SERVER      @"http://localhost:5656"#define ALS_MODEL_FILE_TYPES    @"py;yaml;yml"begin globalsCFStringRef gALSProjectModelText        // the model file's text, as readCFStringRef gALSProjectModelName        // the name its copy gets: models.py, app_model.yaml or admin.yamlCFStringRef gALSProjectAdminText        // admin.yaml's text beside it, or NULLCFStringRef gALSProjectSource           // where it came from: a path or a GitHub addressend globalsvoid local fn ALSProjectForgetgALSProjectModelText = fn LicenceKept( NULL, gALSProjectModelText )gALSProjectModelName = fn LicenceKept( NULL, gALSProjectModelName )gALSProjectAdminText = fn LicenceKept( NULL, gALSProjectAdminText )gALSProjectSource    = NULLend fn// a file's text, or NULLlocal fn ALSProjectReadFile( url as CFURLRef ) as CFStringRefif ( url == NULL ) then exit fn = NULLif ( fn FileManagerFileExistsAtURL( url ) == NO ) then exit fn = NULLend fn = fn StringWithContentsOfURL( url, NSUTF8StringEncoding, NULL )// does the text hold a model?  (a 404 page or any other file does not)local fn ALSProjectIsModel( modelText as CFStringRef ) as BOOLif ( modelText == NULL ) then exit fn = NOend fn = ( fn DictionaryCount( fn ALSModelFromText( modelText ) ) > 0 )// the name the project's copy of a model file gets (it is opened again by that name)local fn ALSProjectKeptName( modelText as CFStringRef ) as CFStringRefif ( fn ALSModelIsModelsPy( modelText ) ) then exit fn = @"models.py"if ( fn StringHasPrefix( modelText, @"entities:" ) || fn StringContainsString( modelText, @"\nentities:" ) ) then exit fn = @"app_model.yaml"end fn = @"admin.yaml"// the model was found: keep its text, and admin.yaml's when that is a different filevoid local fn ALSProjectFound( modelText as CFStringRef, adminText as CFStringRef, source as CFStringRef )gALSProjectModelText = fn LicenceKept( modelText, gALSProjectModelText )gALSProjectModelName = fn LicenceKept( fn ALSProjectKeptName( modelText ), gALSProjectModelName )gALSProjectAdminText = fn LicenceKept( NULL, gALSProjectAdminText )if ( fn StringIsEqual( gALSProjectModelName, @"admin.yaml" ) == NO && adminText != NULL )if ( fn StringContainsString( adminText, @"resources:" ) ) then gALSProjectAdminText = fn LicenceKept( adminText, gALSProjectAdminText )end ifgALSProjectSource = fn LicenceKept( source, gALSProjectSource )end fn// an ALS project folder -> the model; NO when none of its model files is therelocal fn ALSProjectReadFolder( folderURL as CFURLRef ) as BOOLCFMutableArrayRef folders = fn MutableArrayNewCFArrayRef        paths = @[ ALS_MODELS_PY_PATH, ALS_APP_MODEL_PATH, ALS_ADMIN_YAML_PATH ]CFStringRef       folderName = fn StringLowercaseString( fn URLLastPathComponent( folderURL ) )CFStringRef       path, modelTextCFURLRef          folderMutableArrayAddObject( folders, folderURL )// the project's database/ or ui/ folder, or ui/admin/ or ui/app/: the project is above itif ( fn StringIsEqual( folderName, @"database" ) || fn StringIsEqual( folderName, @"ui" ) ) then MutableArrayAddObject( folders, fn URLByDeletingLastPathComponent( folderURL ) )if ( fn StringIsEqual( folderName, @"admin" ) || fn StringIsEqual( folderName, @"app" ) ) then MutableArrayAddObject( folders, fn URLByDeletingLastPathComponent( fn URLByDeletingLastPathComponent( folderURL ) ) )for folder in foldersfor path in pathsmodelText = fn ALSProjectReadFile( fn URLByAppendingPathComponent( folder, path ) )if ( fn ALSProjectIsModel( modelText ) )fn ALSProjectFound( modelText, fn ALSProjectReadFile( fn URLByAppendingPathComponent( folder, ALS_ADMIN_YAML_PATH ) ), fn URLPath( folder ) )exit fn = YESend ifnextnextend fn = NO// a model file, chosen or dropped -> the model (with admin.yaml when it is the project's models.py)local fn ALSProjectReadModelFile( fileURL as CFURLRef ) as BOOLCFStringRef modelText = fn ALSProjectReadFile( fileURL )CFURLRef    projectURLif ( fn ALSProjectIsModel( modelText ) == NO ) then exit fn = NOprojectURL = fn URLByDeletingLastPathComponent( fn URLByDeletingLastPathComponent( fileURL ) )     // database/models.py -> the projectfn ALSProjectFound( modelText, fn ALSProjectReadFile( fn URLByAppendingPathComponent( projectURL, ALS_ADMIN_YAML_PATH ) ), fn URLPath( fileURL ) )end fn = YES// a GitHub address -> @[ "owner/repo", branch or "", path or "" ]; NULL when it is not one//   https://github.com/o/r     github.com/o/r/tree/b/sub     .../blob/b/database/models.py//   https://raw.githubusercontent.com/o/r/b/database/models.pylocal fn ALSProjectGitHubParts( address as CFStringRef ) as CFArrayRefCFStringRef       a = fn StringByTrimmingCharactersInSet( address, fn CharacterSetWhitespaceSet )CFArrayRef        piecesCFMutableArrayRef parts = fn MutableArrayNewCFStringRef       piece, repo, branch = @"", path = @""BOOL              isRaw = NOif ( fn StringHasPrefix( a, @"https://" ) ) then a = fn StringSubstringFromIndex( a, 8 )if ( fn StringHasPrefix( a, @"http://" ) ) then a = fn StringSubstringFromIndex( a, 7 )if ( fn StringHasPrefix( a, @"www." ) ) then a = fn StringSubstringFromIndex( a, 4 )if ( fn StringHasPrefix( a, @"raw.githubusercontent.com/" ) )isRaw = YESa = fn StringSubstringFromIndex( a, 26 )elseif ( fn StringHasPrefix( a, @"github.com/" ) == NO ) then exit fn = NULLa = fn StringSubstringFromIndex( a, 11 )end ifpieces = fn StringComponentsSeparatedByString( a, @"/" )for piece in piecesif ( fn StringLength( piece ) > 0 ) then MutableArrayAddObject( parts, piece )nextif ( fn ArrayCount( parts ) < 2 ) then exit fn = NULLrepo = fn ArrayObjectAtIndex( parts, 1 )if ( fn StringHasSuffix( repo, @".git" ) ) then repo = fn StringSubstringToIndex( repo, fn StringLength( repo ) - 4 )repo = fn StringWithFormat( @"%@/%@", fn ArrayObjectAtIndex( parts, 0 ), repo )if ( isRaw )if ( fn ArrayCount( parts ) > 2 ) then branch = fn ArrayObjectAtIndex( parts, 2 )if ( fn ArrayCount( parts ) > 3 ) then path = fn ArrayComponentsJoinedByString( fn ArraySubarrayWithRange( parts, fn CFRangeMake( 3, fn ArrayCount( parts ) - 3 ) ), @"/" )elseif ( fn ArrayCount( parts ) > 3 )if ( fn StringIsEqual( fn ArrayObjectAtIndex( parts, 2 ), @"tree" ) || fn StringIsEqual( fn ArrayObjectAtIndex( parts, 2 ), @"blob" ) ) then branch = fn ArrayObjectAtIndex( parts, 3 )end ifif ( fn ArrayCount( parts ) > 4 ) then path = fn ArrayComponentsJoinedByString( fn ArraySubarrayWithRange( parts, fn CFRangeMake( 4, fn ArrayCount( parts ) - 4 ) ), @"/" )end ifend fn = @[ repo, branch, path ]// a file of a public repository, over raw.githubusercontent.com; NULL when it does not answerlocal fn ALSProjectFetch( repo as CFStringRef, branch as CFStringRef, path as CFStringRef ) as CFStringRefCFURLRef url = fn URLWithString( fn StringWithFormat( @"https://raw.githubusercontent.com/%@/%@/%@", repo, branch, path ) )if ( url == NULL ) then exit fn = NULLif ( isLoggingOn ) then NSLog( @"ALS model: reading %@", fn URLAbsoluteString( url ) )end fn = fn StringWithContentsOfURL( url, NSUTF8StringEncoding, NULL )// a public GitHub repository -> the model; NO when none of its model files answers// (read while the developer waits: one small file, a few requests at most)local fn ALSProjectReadGitHub( address as CFStringRef ) as BOOLCFArrayRef        parts = fn ALSProjectGitHubParts( address )CFMutableArrayRef branches = fn MutableArrayNewCFMutableArrayRef paths = fn MutableArrayNewCFStringRef       repo, given, prefix = @"", branch, path, modelText, lowerif ( parts == NULL ) then exit fn = NOrepo = fn ArrayObjectAtIndex( parts, 0 )given = fn ArrayObjectAtIndex( parts, 1 )if ( fn StringLength( given ) > 0 )MutableArrayAddObject( branches, given )elseMutableArrayAddObject( branches, @"main" )MutableArrayAddObject( branches, @"master" )end ifgiven = fn ArrayObjectAtIndex( parts, 2 )lower = fn StringLowercaseString( given )if ( fn StringHasSuffix( lower, @".py" ) || fn StringHasSuffix( lower, @".yaml" ) || fn StringHasSuffix( lower, @".yml" ) )MutableArrayAddObject( paths, given )                                    // the model file itselfelseif ( fn StringLength( given ) > 0 ) then prefix = fn StringWithFormat( @"%@/", given )   // the project in a subfolderMutableArrayAddObject( paths, fn StringWithFormat( @"%@%@", prefix, ALS_MODELS_PY_PATH ) )MutableArrayAddObject( paths, fn StringWithFormat( @"%@%@", prefix, ALS_APP_MODEL_PATH ) )MutableArrayAddObject( paths, fn StringWithFormat( @"%@%@", prefix, ALS_ADMIN_YAML_PATH ) )end iffor branch in branchesfor path in pathsmodelText = fn ALSProjectFetch( repo, branch, path )if ( fn ALSProjectIsModel( modelText ) )fn ALSProjectFound( modelText, fn ALSProjectFetch( repo, branch, fn StringWithFormat( @"%@%@", prefix, ALS_ADMIN_YAML_PATH ) ), fn StringWithFormat( @"https://github.com/%@/blob/%@/%@", repo, branch, path ) )exit fn = YESend ifnextnextend fn = NO// where the developer pointed - a GitHub address, a folder or a model file -> the modellocal fn ALSProjectRead( address as CFStringRef ) as BOOLCFURLRef urlfn ALSProjectForgetif ( address == NULL ) then exit fn = NOaddress = fn StringByTrimmingCharactersInSet( address, fn CharacterSetWhitespaceSet )if ( fn StringLength( address ) == 0 ) then exit fn = NOif ( fn ALSProjectGitHubParts( address ) != NULL ) then exit fn = fn ALSProjectReadGitHub( address )url = fn URLFileURLWithPath( fn StringByExpandingTildeInPath( address ) )if ( fn FileManagerFileExistsAtURL( url ) == NO ) then exit fn = NOif ( fn ALSProjectReadFolder( url ) ) then exit fn = YESend fn = fn ALSProjectReadModelFile( url )// a name for the project: the repository's, or the ALS project folder'slocal fn ALSProjectSuggestedName( address as CFStringRef ) as CFStringRefCFArrayRef  parts = fn ALSProjectGitHubParts( address )CFStringRef path = gALSProjectSource, lowerif ( parts != NULL ) then exit fn = fn StringLastPathComponent( fn ArrayFirstObject( parts ) )if ( path == NULL ) then exit fn = @""lower = fn StringLowercaseString( path )if ( fn StringHasSuffix( lower, @".py" ) ) then path = fn StringByDeletingLastPathComponent( fn StringByDeletingLastPathComponent( path ) )     // database/models.pyif ( fn StringHasSuffix( lower, @".yaml" ) || fn StringHasSuffix( lower, @".yml" ) ) then path = fn StringByDeletingLastPathComponent( fn StringByDeletingLastPathComponent( fn StringByDeletingLastPathComponent( path ) ) )   // ui/admin/admin.yamlpath = fn StringLastPathComponent( path )if ( fn StringLength( path ) == 0 || fn StringIsEqual( path, @"/" ) ) then exit fn = @""end fn = path// what the model holds, in a line or two: "17 resources, 56 relationships: Category, Customer, ..."local fn ALSProjectSummary( alsModel as CFDictionaryRef ) as CFStringRefCFArrayRef      names = fn ArraySortedArrayUsingSelector( fn DictionaryAllKeys( alsModel ), @"compare:" )CFStringRef     name, shownlong            relationships = 0for name in namesrelationships = relationships + fn ArrayCount( fn DictionaryObjectForKey( fn DictionaryObjectForKey( alsModel, name ), @"relationships" ) )nextif ( fn ArrayCount( names ) > 12 )shown = fn StringWithFormat( @"%@, ...", fn ArrayComponentsJoinedByString( fn ArraySubarrayWithRange( names, fn CFRangeMake( 0, 12 ) ), @", " ) )elseshown = fn ArrayComponentsJoinedByString( names, @", " )end ifend fn = fn StringWithFormat( @"%ld resources, %ld relationships: %@", fn ArrayCount( names ), relationships, shown )// the column a parent's lookup shows: admin.yaml's user_key, the model's own display column,// else the Lite edition's choice (a name, title or description column)local fn ALSProjectDisplayColumn( alsModel as CFDictionaryRef, displayModel as CFDictionaryRef, parentName as CFStringRef, studioParent as CFDictionaryRef, parentKey as CFStringRef ) as CFStringRefCFDictionaryRef entityCFStringRef     displayif ( displayModel != NULL )entity = fn DictionaryObjectForKey( displayModel, parentName )if ( entity != NULL )display = fn DictionaryObjectForKey( entity, @"display" )if ( display != NULL ) then if ( fn StringLength( display ) > 0 ) then exit fn = displayend ifend ifentity = fn DictionaryObjectForKey( alsModel, parentName )if ( entity != NULL )display = fn DictionaryObjectForKey( entity, @"display" )if ( display != NULL ) then if ( fn StringLength( display ) > 0 ) then exit fn = displayend ifend fn = fn SQLiteModelDisplayAttribute( studioParent, parentKey )// one ALS entity -> the Studio's resource: attributes (pk in key order, the key the server// assigns marked generated), keys, keyKind, relationships with the parent's keyslocal fn ALSProjectStudioResource( alsModel as CFDictionaryRef, entity as CFDictionaryRef ) as CFMutableDictionaryRefCFMutableDictionaryRef resource = fn MutableDictionaryNewCFMutableArrayRef      attributes = fn MutableArrayNewCFMutableArrayRef      relationships = fn MutableArrayNewCFMutableDictionaryRef studioAttributeCFArrayRef             keys = fn DictionaryObjectForKey( entity, @"keys" )CFArrayRef             alsAttributes = fn DictionaryObjectForKey( entity, @"attributes" )CFArrayRef             alsRelationships = fn DictionaryObjectForKey( entity, @"relationships" )CFArrayRef             fks, parentKeysCFDictionaryRef        attribute, relationship, parentCFStringRef            typeName, keyKind = @"assigned", tableNameNSUInteger             positionBOOL                   isKeyif ( keys == NULL ) then keys = @[]if ( alsAttributes == NULL ) then alsAttributes = @[]if ( alsRelationships == NULL ) then alsRelationships = @[]if ( fn ArrayCount( keys ) == 0 ) then keyKind = @"none"for attribute in alsAttributesstudioAttribute = fn MutableDictionaryNewtypeName = fn DictionaryObjectForKey( attribute, @"type" )if ( typeName == NULL ) then typeName = @"VARCHAR"position = fn ArrayIndexOfObject( keys, fn DictionaryObjectForKey( attribute, @"name" ) )isKey = ( position != NSNotFound )MutableDictionarySetObjectForKey( studioAttribute, fn DictionaryObjectForKey( attribute, @"name" ), @"name" )MutableDictionarySetObjectForKey( studioAttribute, typeName, @"type" )MutableDictionarySetObjectForKey( studioAttribute, fn NumberWithBool( isKey || fn NumberBoolValue( fn DictionaryObjectForKey( attribute, @"required" ) ) ), @"notnull" )if ( isKey )MutableDictionarySetObjectForKey( studioAttribute, fn NumberWithInteger( position + 1 ), @"pk" )// one INTEGER key: the server (SQLAlchemy autoincrement) assigns it - the Form shows it, never asks for itif ( fn ArrayCount( keys ) == 1 && fn StringHasPrefix( fn StringUppercaseString( typeName ), @"INTEGER" ) )keyKind = @"identity"MutableDictionarySetObjectForKey( studioAttribute, fn NumberWithBool( YES ), @"generated" )end ifelseMutableDictionarySetObjectForKey( studioAttribute, fn NumberWithInteger( 0 ), @"pk" )end ifMutableArrayAddObject( attributes, studioAttribute )nextfor relationship in alsRelationshipsfks = fn DictionaryObjectForKey( relationship, @"fks" )if ( fks == NULL ) then fks = @[]parentKeys = @[]parent = fn DictionaryObjectForKey( alsModel, fn DictionaryObjectForKey( relationship, @"resource" ) )if ( parent != NULL ) then parentKeys = fn DictionaryObjectForKey( parent, @"keys" )if ( parentKeys == NULL ) then parentKeys = @[]MutableArrayAddObject( relationships, fn SQLiteModelRelationship( fn DictionaryObjectForKey( relationship, @"name" ), fn DictionaryObjectForKey( relationship, @"direction" ), fn DictionaryObjectForKey( relationship, @"resource" ), fks, parentKeys ) )nexttableName = fn DictionaryObjectForKey( entity, @"table" )MutableDictionarySetObjectForKey( resource, @"table", @"kind" )MutableDictionarySetObjectForKey( resource, attributes, @"attributes" )MutableDictionarySetObjectForKey( resource, keys, @"keys" )MutableDictionarySetObjectForKey( resource, keyKind, @"keyKind" )MutableDictionarySetObjectForKey( resource, relationships, @"relationships" )if ( tableName != NULL ) then MutableDictionarySetObjectForKey( resource, tableName, @"table" )end fn = resource// the ALS model -> the Studio's model { "resources": { <resource>: ... } } (SQLite Model.incl's// shape), with a lookup on every single-column key to a parent (what a Dropdown lists and shows)local fn ALSProjectStudioModel( alsModel as CFDictionaryRef, displayModel as CFDictionaryRef ) as CFMutableDictionaryRefCFMutableDictionaryRef studioResources = fn MutableDictionaryNewCFArrayRef             names = fn DictionaryAllKeys( alsModel )CFArrayRef             relationships, attributes, fks, parentKeysCFDictionaryRef        resource, relationship, attribute, parentCFStringRef            name, parentNamefor name in namesMutableDictionarySetObjectForKey( studioResources, fn ALSProjectStudioResource( alsModel, fn DictionaryObjectForKey( alsModel, name ) ), name )nextfor name in namesresource      = fn DictionaryObjectForKey( studioResources, name )relationships = fn DictionaryObjectForKey( resource, @"relationships" )attributes    = fn DictionaryObjectForKey( resource, @"attributes" )for relationship in relationshipsfks        = fn DictionaryObjectForKey( relationship, @"fks" )parentKeys = fn DictionaryObjectForKey( relationship, @"parentKeys" )parentName = fn DictionaryObjectForKey( relationship, @"resource" )parent     = fn DictionaryObjectForKey( studioResources, parentName )if ( fn StringIsEqual( fn DictionaryObjectForKey( relationship, @"direction" ), @"toone" ) && fn ArrayCount( fks ) == 1 && fn ArrayCount( parentKeys ) == 1 && parent != NULL )for attribute in attributesif ( fn StringIsEqual( fn DictionaryObjectForKey( attribute, @"name" ), fn ArrayFirstObject( fks ) ) ) then MutableDictionarySetObjectForKey( (CFMutableDictionaryRef)attribute, @{ @"entity":parentName, @"key":fn ArrayFirstObject( parentKeys ), @"display":fn ALSProjectDisplayColumn( alsModel, displayModel, parentName, parent, fn ArrayFirstObject( parentKeys ) ) }, @"lookup" )nextend ifnextnextend fn = fn MutableDictionaryWithDictionary( @{ @"resources":studioResources } )// the copy the project works from: <project>/ALS Model/<models.py | app_model.yaml | admin.yaml>,// and admin.yaml beside it when there is one.  The model file's URL; NULL when it cannot be writtenlocal fn ALSProjectKeepCopy( nameOfProject as CFStringRef ) as CFURLRefCFURLRef folderURL = fn URLByAppendingPathComponent( fn ProjectFolderURLNamed( nameOfProject ), ALS_MODEL_FOLDER )CFURLRef modelURL, adminURLErrorRef err = NULLif ( gALSProjectModelText == NULL ) then exit fn = NULLfn FileManagerCreateDirectoryAtURL( folderURL, YES, NULL )modelURL = fn URLByAppendingPathComponent( folderURL, gALSProjectModelName )if ( fn StringWriteToURL( gALSProjectModelText, modelURL, YES, NSUTF8StringEncoding, @err ) == NO )if ( isLoggingOn ) then NSLog( @"Could not write %@: %@", fn URLPath( modelURL ), fn ErrorLocalizedDescription( err ) )exit fn = NULLend ifadminURL = fn URLByAppendingPathComponent( folderURL, @"admin.yaml" )if ( gALSProjectAdminText != NULL )fn StringWriteToURL( gALSProjectAdminText, adminURL, YES, NSUTF8StringEncoding, NULL )elseif ( fn StringIsEqual( gALSProjectModelName, @"admin.yaml" ) == NO && fn FileManagerFileExistsAtURL( adminURL ) ) then fn FileManagerRemoveItemAtURL( adminURL )end ifif ( isLoggingOn ) then NSLog( @"ALS model from %@ kept in %@", gALSProjectSource, fn URLPath( modelURL ) )end fn = modelURL