/* *   Validations.incl - the running server form: Create comes on only when every field is filled in */void local fn ValidateRequiredValuesif ( len( textfield( _projectNameEdit ) ) > 0 && len( textfield( _baseURLEdit ) ) > 0 && len( textfield( _authNameEdit ) ) > 0 && len( textfield( _authPasswordEdit ) ) > 0 )button _createProjectCreateBtn, YESelsebutton _createProjectCreateBtn, NOend ifend fn