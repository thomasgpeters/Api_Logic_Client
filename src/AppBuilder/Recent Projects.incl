/* *   Recent Projects.incl * *   The projects opened most recently, newest first, kept in *   ~/Library/Application Support/App Builder for FutureBasic/Recent Projects.json: *       [ { "Project": "Northwind", "Model": "db.sqlite", "path": ".../Project.json" }, ... ] *   "Project" and "Model" are also the column identifiers of the Welcome view's table. */#define RECENT_PROJECTS_FILE @"Recent Projects.json"#define RECENT_PROJECTS_MAX  10local fn RecentProjectsFileURL as CFURLRefend fn = fn URLByAppendingPathComponent( fn AppSupportFolderURL, RECENT_PROJECTS_FILE )// the list - empty when there is none yetlocal fn RecentProjects as CFMutableArrayRefCFMutableArrayRef list = NULLCFDataRef         jsonErrorRef          err = NULLjson = fn DataWithContentsOfURL( fn RecentProjectsFileURL, 0, @err )if ( json != NULL ) then list = (CFMutableArrayRef)fn JSONSerializationJSONObjectWithData( json, NSJSONReadingMutableContainers, @err )if ( list == NULL ) then list = fn MutableArrayNewend fn = listvoid local fn RecentProjectsShowTableViewSetData( _recentProjectsTable, fn RecentProjects )TableViewReloadData( _recentProjectsTable )end fnvoid local fn RecentProjectsWrite( list as CFArrayRef )CFDataRef jsonErrorRef  err = NULLjson = fn JSONSerializationDataWithJSONObject( list, NSJSONWritingPrettyPrinted, @err )if ( json == NULL ) then exit fnif ( fn DataWriteToURL( json, fn RecentProjectsFileURL, NSDataWritingAtomic, @err ) == NO )if (isLoggingOn) then NSLog( @"Could not write %@: %@", fn URLPath( fn RecentProjectsFileURL ), fn ErrorLocalizedDescription( err ) )end iffn RecentProjectsShowend fn// the current project goes to the top (once)void local fn RecentProjectsAddCFMutableArrayRef list = fn RecentProjectsCFDictionaryRef   entryCFStringRef       path, sourcelong              iif ( fn StringLength( projectName ) == 0 ) then exit fnpath = fn URLPath( fn ProjectSettingsFileURL )for i = fn ArrayCount( list ) - 1 to 0 step -1entry = fn ArrayObjectAtIndex( list, i )if ( fn StringIsEqual( fn DictionaryObjectForKey( entry, @"path" ), path ) ) then MutableArrayRemoveObjectAtIndex( list, i )nextsource = fn DictionaryObjectForKey( gProjectDictionary, @"source" )if ( source == NULL ) then source = @"" else source = fn StringLastPathComponent( source )MutableArrayInsertObjectAtIndex( list, @{ @"Project":fn ProjectAppName, @"Model":source, @"path":path }, 0 )while ( fn ArrayCount( list ) > RECENT_PROJECTS_MAX )MutableArrayRemoveLastObject( list )wendfn RecentProjectsWrite( list )end fn// Project.json path of a row of the list; NULL when out of rangelocal fn RecentProjectPath( row as long ) as CFStringRefCFArrayRef list = fn RecentProjectsif ( row < 0 || row >= fn ArrayCount( list ) ) then exit fn = NULLend fn = fn DictionaryObjectForKey( fn ArrayObjectAtIndex( list, row ), @"path" )void local fn RecentProjectsClearfn RecentProjectsWrite( fn MutableArrayNew )end fn