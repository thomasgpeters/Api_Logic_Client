/* *   Menus.incl - the Studio's menu bar and toolbar, and which of their commands apply now * *   Menus, grouped by what the developer works on (docs/STUDIO_REVIEW.md): *     Project   new, open, recent, close, settings, Finder, delete *     Edit      FB's standard edit menu *     Model     open a SQLite database or ALS metadata, the model diagram, rules *     Generate  the app, its XIBs and bindings, the runtime *     Window    minimize, zoom, close *     Help      the user guide, the workspace *   Item numbers are display positions: separators count. *   Shortcuts: the usual ones (N, O, W, M, ?), command-1 / command-2 for the two main views *   (Recent Projects, Entity Definitions), option-command for the Finder and the less frequent *   commands; deleting a project has none (it asks first anyway). * *   StudioUpdateCommands enables each command, toolbar item and design control only when what it *   acts on exists: a project, a selected entity, a selected attribute.  Call it whenever one of *   those changes (EventHandlers.incl, Project Actions.incl). */// menus_mApplication = 0begin enum 1_iSeparator                 // required for the application menu_iLicence                   // the Licence menu (Licence Window.incl)_iEnterLicence_iUpgradeLicence_iManageLicence_iRemoveLicenceend enum_mProject = 1begin enum 1_iNewProject_iNewALSProject_iOpenProject_iRecentProjects_iEntityDefinitions_iClearRecentProjects_iProjectSeparator1_iCloseProject_iProjectSettings_iShowProjectInFinder_iProjectSeparator2_iDeleteProjectend enum_mEdit = 2                  // Cut, Copy, Paste: the cells, the text fields, the app icon well_mModel = 3begin enum 1_iOpenSQLite_iOpenMetadata_iModelSeparator1_iShowModelDiagram_iModelSeparator2_iImportRules_iExportRulesend enum_mGenerate = 4begin enum 1_iGenerateApp_iGenerateSeparator1_iGenerateXIBs_iGenerateXIB_iGenerateBinding_iGenerateSeparator2_iShowGeneratedApp_iUpdateLibrary_iOpenOneXib                // a developer's tool: only when STUDIO_DEBUG_MENU is YESend enum_mWindow = 5begin enum 1_iMinimize_iZoom_iCloseWindowend enum_mHelp = 6begin enum 1_iStudioHelp_iShowWorkspaceend enum// right-click menus, not in the menu bar (Windows.incl attaches them to their lists); items count from 0_mRecentContext = 101       // a project in Recent Projects (the Welcome page)begin enum 0_iRecentOpen_iRecentShowInFinder_iRecentSeparator_iRecentRemove_iRecentDeleteend enum_mObjectContext = 102       // an entity in the Objects listbegin enum 0_iObjectGenerateXIB_iObjectShowDiagramend enum#define STUDIO_DEBUG_MENU NO// toolbar items (Toolbar.xib): a tag range of their own, clear of every view's controls_tbProjects  = 600          // the Welcome view: new, open, recent_tbEntities  = 601          // the entity definitions of the open project_tbDiagram   = 602          // Show Model Diagram_tbGenerate  = 603          // Generate App_tbSettings  = 604          // Project Settings// the crumb trail along the top of the page area (StudioUpdateCrumbs): up to four borderless// buttons, a chevron between them.  (An NSPathControl was tried first: its item images were// squeezed and its clicks never reached an action we could read.)_crumbButtonBase    = 611           // 611-614_crumbSeparatorBase = 621           // 621-623: the chevron before crumb 1, 2, 3_crumbMax           = 4_crumbHeight        = 22begin globalsCFMutableArrayRef gStudioCrumbActions       // beside each crumb: "projects", "entities" or ""CGFloat           gStudioCrumbLeft          // where the trail starts (Windows.incl)CGFloat           gStudioCrumbBottomCGFloat           gStudioHeadingLeft        // the heading's left edge with no icon beside it (Windows.incl)CGFloat           gStudioPageLeft           // where the pages start: beside the entity list, or at the left with no projectend globalsvoid local fn BuildMenu// application menu (FB adds About, Hide, Quit); then the licence (Licence Window.incl)menu _mApplication, _iSeparatormenu _mApplication, _iLicence,,        @"Licence…"menu _mApplication, _iEnterLicence,,   @"Enter Licence…"menu _mApplication, _iUpgradeLicence,, @"Upgrade to Professional…"menu _mApplication, _iManageLicence,,  @"Manage Licence Online…"menu _mApplication, _iRemoveLicence,,  @"Remove Licence…"// projectmenu _mProject,,, @"Project"menu _mProject, _iNewProject,,          @"New Project…", @"n"menu _mProject, _iNewALSProject,,       @"New Project from API Logic Server…", @"N"   // shift-command-Nmenu _mProject, _iOpenProject,,         @"Open Project…", @"o"menu _mProject, _iRecentProjects,,      @"Recent Projects", @"1"menu _mProject, _iEntityDefinitions,,   @"Entity Definitions", @"2"menu _mProject, _iClearRecentProjects,, @"Clear Recent Projects"menu _mProject, _iProjectSeparator1menu _mProject, _iCloseProject,,        @"Close Project", @"W"          // shift-command-Wmenu _mProject, _iProjectSettings,,     @"Project Settings…", @";"menu _mProject, _iShowProjectInFinder,, @"Show Project in Finder", @"r", NSEventModifierFlagCommand + NSEventModifierFlagOptionmenu _mProject, _iProjectSeparator2menu _mProject, _iDeleteProject,,       @"Delete Project…"MenuSetAutoenablesItems( _mProject, NO )                                // StudioUpdateCommands decides// edit - FB's standard Edit menu (Undo, Cut, Copy, Paste, Select All)editmenu _mEdit// modelmenu _mModel,,, @"Model"menu _mModel, _iOpenSQLite,,        @"Open SQLite Database…", @"d"menu _mModel, _iOpenMetadata,,      @"Open API Logic Server Metadata…", @"j"menu _mModel, _iModelSeparator1menu _mModel, _iShowModelDiagram,,  @"Show Model Diagram", @"D"        // shift-command-D: the ERD in the browsermenu _mModel, _iModelSeparator2menu _mModel, _iImportRules,,       @"Import Rules from declare_logic.py…", @"i", NSEventModifierFlagCommand + NSEventModifierFlagOptionmenu _mModel, _iExportRules,,       @"Export Rules to declare_logic.py…", @"e", NSEventModifierFlagCommand + NSEventModifierFlagOptionMenuSetAutoenablesItems( _mModel, NO )// generatemenu _mGenerate,,, @"Generate"menu _mGenerate, _iGenerateApp,,      @"Generate App", @"g"menu _mGenerate, _iGenerateSeparator1menu _mGenerate, _iGenerateXIBs,,     @"Generate XIBs", @"X"           // shift-command-X: command-X is Cutmenu _mGenerate, _iGenerateXIB,,      @"Generate XIB for Selected Entity", @"e"menu _mGenerate, _iGenerateBinding,,  @"Generate Binding Code", @"b"menu _mGenerate, _iGenerateSeparator2menu _mGenerate, _iShowGeneratedApp,, @"Show Generated App in Finder", @"g", NSEventModifierFlagCommand + NSEventModifierFlagOptionmenu _mGenerate, _iUpdateLibrary,,    @"Update Runtime and Templates…", @"u", NSEventModifierFlagCommand + NSEventModifierFlagOption  // copy them again from the repository (Studio Library.incl)if ( STUDIO_DEBUG_MENU ) then menu _mGenerate, _iOpenOneXib,, @"Open One Xib (debug)"MenuSetAutoenablesItems( _mGenerate, NO )// windowmenu _mWindow,,, @"Window"menu _mWindow, _iMinimize,,    @"Minimize", @"m"MenuItemSetAction( _mWindow, _iMinimize, @"performMiniaturize:" )menu _mWindow, _iZoom,,        @"Zoom"MenuItemSetAction( _mWindow, _iZoom, @"performZoom:" )menu _mWindow, _iCloseWindow,, @"Close", @"w"MenuItemSetAction( _mWindow, _iCloseWindow, @"performClose:" )// helpmenu _mHelp,,, @"Help"menu _mHelp, _iStudioHelp,,    @"App Builder Help", @"?"menu _mHelp, _iShowWorkspace,, @"Show Workspace in Finder", @"K"           // shift-command-K// the right-click menus (a Mac user expects them on a list's rows)menu _mRecentContextmenu _mRecentContext, _iRecentOpen,,          @"Open"menu _mRecentContext, _iRecentShowInFinder,,  @"Show in Finder"menu _mRecentContext, _iRecentSeparatormenu _mRecentContext, _iRecentRemove,,        @"Remove from Recent Projects"menu _mRecentContext, _iRecentDelete,,        @"Delete Project…"menu _mObjectContextmenu _mObjectContext, _iObjectGenerateXIB,,   @"Generate XIB"menu _mObjectContext, _iObjectShowDiagram,,   @"Show Model Diagram"end fn// the crumb trail along the top of the page area: where the developer is, and the way back.// Each item's action is kept beside it: "projects" (the Projects screen), "entities" (the open// project's definitions), "" (where you are).// one crumb's content: its title, its symbol, what clicking it doesvoid local fn StudioCrumb( titles as CFMutableArrayRef, symbols as CFMutableArrayRef, title as CFStringRef, symbolName as CFStringRef, action as CFStringRef )MutableArrayAddObject( titles, title )MutableArrayAddObject( symbols, symbolName )MutableArrayAddObject( gStudioCrumbActions, action )end fn// the crumb trail: where the developer is.  Each crumb is a button sized to its title, placed// after the previous one and its chevron; the last one (where you are) is bold.// the entity list only with a project open (author: "not needed until the user actually opens a project"); without// one, the pages, the crumb trail and the heading move left and fill the whole working areavoid local fn StudioLayoutForProject( hasProject as BOOL )CGFloat pageLeft = _controlSpacer, dxCGRect  rlong    i, tagViewRef list = fn StudioFindView( _objectTableView )if ( hasProject ) then pageLeft = _tableViewWidth + _controlSpacer * 2cln if ( list != NULL ) [[(__bridge NSView *)list enclosingScrollView] setHidden:!hasProject];ViewSetHidden( _objectListButtons, ( hasProject == NO ) )if ( gStudioPageLeft == 0 || pageLeft == gStudioPageLeft ) then exit fndx = pageLeft - gStudioPageLeftfor i = 0 to 6select ( i )case 0 : tag = _welcomeViewcase 1 : tag = _projectCreateViewcase 2 : tag = _projectDetailViewcase 3 : tag = _newProjectViewcase 4 : tag = _alsProjectViewcase 5 : tag = _projectSettingsViewcase 6 : tag = _projectHeadingNameend selectr = fn ViewFrame( tag )r.origin.x = r.origin.x + dxr.size.width = r.size.width - dxViewSetFrame( tag, r )nextr = fn ViewFrame( _projectHeadingIcon )r.origin.x = r.origin.x + dxViewSetFrame( _projectHeadingIcon, r )gStudioCrumbLeft = gStudioCrumbLeft + dxgStudioHeadingLeft = gStudioHeadingLeft + dxgStudioPageLeft = pageLeftend fnvoid local fn StudioUpdateCrumbs( hasProject as BOOL, hasEntity as BOOL )CFMutableArrayRef titles = fn MutableArrayNewCFMutableArrayRef symbols = fn MutableArrayNewCGRect            rCGFloat           xlong              i, count, tagfn StudioLayoutForProject( hasProject )x = gStudioCrumbLeftif ( gStudioCrumbActions != NULL ) then CFRelease( gStudioCrumbActions )   // kept by hand: a global does not keep its value alive (Menus.incl comes before Licence.incl's LicenceKept)gStudioCrumbActions = fn MutableArrayNewfn CFRetain( gStudioCrumbActions )fn StudioCrumb( titles, symbols, @"Projects", @"house", @"projects" )if ( fn ViewIsHidden( _newProjectView ) == NO ) then fn StudioCrumb( titles, symbols, @"New Project", @"plus.square", @"" )if ( fn ViewIsHidden( _alsProjectView ) == NO ) then fn StudioCrumb( titles, symbols, @"API Logic Server Project", @"server.rack", @"" )if ( fn ViewIsHidden( _projectCreateView ) == NO ) then fn StudioCrumb( titles, symbols, @"API Logic Server", @"server.rack", @"" )if ( hasProject && fn ViewIsHidden( _welcomeView ) && fn ViewIsHidden( _newProjectView ) && fn ViewIsHidden( _alsProjectView ) && fn ViewIsHidden( _projectCreateView ) )fn StudioCrumb( titles, symbols, projectName, @"folder", @"entities" )if ( fn ViewIsHidden( _projectSettingsView ) == NO ) then fn StudioCrumb( titles, symbols, @"Settings", @"gearshape", @"" )if ( hasEntity && fn ViewIsHidden( _projectDetailView ) == NO ) then fn StudioCrumb( titles, symbols, objectName, @"tablecells", @"" )end ifcount = fn ArrayCount( titles )for i = 0 to _crumbMax - 1tag = _crumbButtonBase + iif ( i < count )if ( i > 0 )ViewSetFrame( _crumbSeparatorBase + i - 1, fn CGRectMake( x, gStudioCrumbBottom + 4, 12, 14 ) )ViewSetHidden( _crumbSeparatorBase + i - 1, NO )x = x + 14end ifButtonSetTitle( tag, fn ArrayObjectAtIndex( titles, i ) )ButtonSetImage( tag, fn ImageWithSystemSymbolName( fn ArrayObjectAtIndex( symbols, i ), fn ArrayObjectAtIndex( titles, i ) ) )if ( i == count - 1 ) then ControlSetFont( tag, fn FontBoldSystemFontOfSize( 13.0 ) ) else ControlSetFont( tag, fn FontSystemFontOfSize( 13.0 ) )ControlSizeToFit( tag )r = fn ViewFrame( tag )ViewSetFrame( tag, fn CGRectMake( x, gStudioCrumbBottom, r.size.width + 6, _crumbHeight ) )ViewSetHidden( tag, NO )x = x + r.size.width + 10elseViewSetHidden( tag, YES )if ( i > 0 ) then ViewSetHidden( _crumbSeparatorBase + i - 1, YES )end ifnextViewSetHidden( _projectHeadingName, ( fn ViewIsHidden( _welcomeView ) == NO || fn ViewIsHidden( _projectCreateView ) == NO ) )   // pages with their own heading (Windows.incl, FitOwnHeadingView)end fn// the project a Project command acts on: on the Welcome page, the one selected in Recent Projects (its row);// anywhere else -1, the open project.  The menu names it, so the developer sees what Delete or Finder will act on.local fn StudioRecentTargetRow as longif ( fn ViewIsHidden( _welcomeView ) ) then exit fn = -1end fn = fn TableViewSelectedRow( _recentProjectsTable )// a Recent Projects row's name, as the list shows itlocal fn StudioRecentName( row as long ) as CFStringRefCFArrayRef  list = fn TableViewData( _recentProjectsTable )CFStringRef name = NULLif ( list != NULL ) then if ( row >= 0 && row < fn ArrayCount( list ) ) then name = fn DictionaryObjectForKey( fn ArrayObjectAtIndex( list, row ), @"Project" )if ( name == NULL ) then name = @"Project"end fn = name/* *   Which commands apply now.  The states, each needing the one before: *     a project is open        a model is loaded under a project name *     an entity is selected    a row of the Objects list *     an attribute is selected a row of the attribute table *   Delete Project also applies to a project selected in Recent Projects (the Welcome view). */void local fn StudioUpdateCommandsBOOL hasProject = NO, hasEntity = NO, hasAttribute = NO, hasRecent = NOlong recentRow = fn StudioRecentTargetRowCFArrayRef recentList = fn TableViewData( _recentProjectsTable )if ( fn StringLength( projectName ) > 0 && fn DictionaryObjectForKey( gProjectDictionary, @"resources" ) != NULL ) then hasProject = YESif ( hasProject && objectName != NULL ) then hasEntity = ( fn TableViewSelectedRow( _objectTableView ) >= 0 )if ( hasEntity ) then hasAttribute = ( fn TableViewSelectedRow( _attributeTableView ) >= 0 )hasRecent = ( recentRow >= 0 )// Project: new, open and recent always applyMenuItemSetEnabled( _mProject, _iNewProject, YES )MenuItemSetEnabled( _mProject, _iNewALSProject, YES )MenuItemSetEnabled( _mProject, _iOpenProject, YES )MenuItemSetEnabled( _mProject, _iRecentProjects, YES )MenuItemSetEnabled( _mProject, _iEntityDefinitions, hasProject )MenuItemSetEnabled( _mProject, _iClearRecentProjects, ( recentList != NULL && fn ArrayCount( recentList ) > 0 ) )MenuItemSetEnabled( _mProject, _iCloseProject, hasProject )MenuItemSetEnabled( _mProject, _iProjectSettings, hasProject )MenuItemSetEnabled( _mProject, _iShowProjectInFinder, ( hasProject || hasRecent ) )MenuItemSetEnabled( _mProject, _iDeleteProject, ( hasProject || hasRecent ) )// the items name what they act on: the project selected on the Welcome page, else the open oneif ( hasRecent )MenuItemSetTitle( _mProject, _iShowProjectInFinder, fn StringWithFormat( @"Show “%@” in Finder", fn StudioRecentName( recentRow ) ) )MenuItemSetTitle( _mProject, _iDeleteProject, fn StringWithFormat( @"Delete “%@”…", fn StudioRecentName( recentRow ) ) )elseif ( hasProject )MenuItemSetTitle( _mProject, _iShowProjectInFinder, fn StringWithFormat( @"Show “%@” in Finder", projectName ) )MenuItemSetTitle( _mProject, _iDeleteProject, fn StringWithFormat( @"Delete “%@”…", projectName ) )elseMenuItemSetTitle( _mProject, _iShowProjectInFinder, @"Show Project in Finder" )MenuItemSetTitle( _mProject, _iDeleteProject, @"Delete Project…" )end ifend ifif ( hasProject ) then MenuItemSetTitle( _mProject, _iCloseProject, fn StringWithFormat( @"Close “%@”", projectName ) ) else MenuItemSetTitle( _mProject, _iCloseProject, @"Close Project" )// a tick beside the page that is showingif ( fn ViewIsHidden( _welcomeView ) ) then MenuItemSetState( _mProject, _iRecentProjects, NSControlStateValueOff ) else MenuItemSetState( _mProject, _iRecentProjects, NSControlStateValueOn )if ( fn ViewIsHidden( _projectDetailView ) ) then MenuItemSetState( _mProject, _iEntityDefinitions, NSControlStateValueOff ) else MenuItemSetState( _mProject, _iEntityDefinitions, NSControlStateValueOn )// Model: opening a model always applies; the rest needs oneMenuItemSetEnabled( _mModel, _iOpenSQLite, YES )MenuItemSetEnabled( _mModel, _iOpenMetadata, YES )MenuItemSetEnabled( _mModel, _iShowModelDiagram, hasProject )MenuItemSetEnabled( _mModel, _iImportRules, hasProject )MenuItemSetEnabled( _mModel, _iExportRules, hasProject )// Generate: a project; one entity's XIB needs that entity, and its name is on the itemMenuItemSetEnabled( _mGenerate, _iGenerateApp, hasProject )MenuItemSetEnabled( _mGenerate, _iGenerateXIBs, hasProject )MenuItemSetEnabled( _mGenerate, _iGenerateBinding, hasProject )MenuItemSetEnabled( _mGenerate, _iShowGeneratedApp, hasProject )MenuItemSetEnabled( _mGenerate, _iUpdateLibrary, YES )MenuItemSetEnabled( _mGenerate, _iGenerateXIB, hasEntity )if ( hasEntity )MenuItemSetTitle( _mGenerate, _iGenerateXIB, fn StringWithFormat( @"Generate XIB for %@", objectName ) )elseMenuItemSetTitle( _mGenerate, _iGenerateXIB, @"Generate XIB for Selected Entity" )end ifif ( STUDIO_DEBUG_MENU ) then MenuItemSetEnabled( _mGenerate, _iOpenOneXib, YES )// toolbar: Projects always; the rest needs a project (autovalidation off, or AppKit re-enables them)ToolbarItemSetAutovalidates( _mainToolbar, _tbProjects, NO )ToolbarItemSetAutovalidates( _mainToolbar, _tbEntities, NO )ToolbarItemSetAutovalidates( _mainToolbar, _tbDiagram, NO )ToolbarItemSetAutovalidates( _mainToolbar, _tbGenerate, NO )ToolbarItemSetAutovalidates( _mainToolbar, _tbSettings, NO )ToolbarItemSetEnabled( _mainToolbar, _tbProjects, YES )ToolbarItemSetEnabled( _mainToolbar, _tbEntities, hasProject )ToolbarItemSetEnabled( _mainToolbar, _tbDiagram, hasProject )ToolbarItemSetEnabled( _mainToolbar, _tbGenerate, hasProject )ToolbarItemSetEnabled( _mainToolbar, _tbSettings, hasProject )// the toolbar's tooltips name the menu shortcutToolbarItemSetToolTip( _mainToolbar, _tbProjects, @"New, open and recent projects (Command-1)" )ToolbarItemSetToolTip( _mainToolbar, _tbEntities, @"The open project's entity definitions (Command-2)" )ToolbarItemSetToolTip( _mainToolbar, _tbDiagram, @"Show Model Diagram (Shift-Command-D)" )ToolbarItemSetToolTip( _mainToolbar, _tbGenerate, @"Generate App (Command-G)" )ToolbarItemSetToolTip( _mainToolbar, _tbSettings, @"Project Settings (Command-;)" )// the crumb trail: where the developer isfn StudioUpdateCrumbs( hasProject, hasEntity )// the entity summary line asks for an entity until one is chosen (the XIB's text is a placeholder)if ( hasProject && hasEntity == NO ) then ControlSetStringValue( _objectNameLabel, @"Choose an entity in the Objects list" )// the entity view's design row: the entity's popups need an entity, Control needs an attributeControlSetEnabled( _formColumnsPopup, hasEntity )ControlSetEnabled( _entityIconPopup, hasEntity )ControlSetEnabled( _controlPopup, hasAttribute )end fn