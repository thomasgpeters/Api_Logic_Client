/* *   I M A G E R Y    B U S I N E S S     S Y S T E M S,   L L C * *   Branding.incl - the product's name and the Imagery logo * *   The logos are the canonical Imagery files (imagery_logo.png: colour text for light *   backgrounds, imagery_logo_white.png: white text for dark ones), bundled as resources. *   ImageryLogo is one image that draws whichever suits the current appearance, so it *   follows the Mac between light and dark mode by itself. */#define APP_DISPLAY_NAME @"App Builder for FutureBasic"_welcomeLogoImage = 103                // WelcomeView.xib_createLogoImage  = 104                // ProjectCreateView.xib// a view by its tag, in any of the app's windows - also a control inside a XIB part (a nibview). FB's ViewWithTag looks// only in its current output window, which is not always the app's window when an event arrives ("View does not// exist", 2026-11-27: in a generated app).// the C functions FB calls, declared for every part of the project (FB compiles in several chunks)BeginCDeclarationvoid *StudioFindView( long tag );EndCBeginCFunctionvoid *StudioFindView( long tag ) {    for ( NSWindow *window in [NSApp windows] ) {        NSView *found = [window.contentView viewWithTag:tag];        if ( found != nil ) return (__bridge void *)found;    }    return NULL;}EndCtoolbox fn StudioFindView( long tag ) = ptrlocal fn ImageryLogo as ImageRefcln NSImage *light = [NSImage imageNamed:@"imagery_logo"]; NSImage *dark = [NSImage imageNamed:@"imagery_logo_white"]; if ( light == nil ) return NULL; NSImage *logo = [NSImage imageWithSize:light.size flipped:NO drawingHandler:^BOOL( NSRect r ) { NSAppearance *a = NSAppearance.currentAppearance; if ( @available( macOS 11.0, * ) ) a = NSAppearance.currentDrawingAppearance; BOOL isDark = [[a bestMatchFromAppearancesWithNames:@[ NSAppearanceNameAqua, NSAppearanceNameDarkAqua ]] isEqualToString:NSAppearanceNameDarkAqua]; [( isDark && dark != nil ? dark : light ) drawInRect:r]; return YES; }]; return (__bridge void *)logo;end fn = NULL// the working area's card: white on the light window (grey behind it), as the generated app's panels are (author,// 2026-11-27); a step lighter than the dark window, worked out from its own colour so it follows macOSlocal fn StudioCardColor as ColorRefcln NSColor *card = [NSColor colorWithName:nil dynamicProvider:^NSColor *( NSAppearance *a ) { BOOL isDark = [[a bestMatchFromAppearancesWithNames:@[ NSAppearanceNameAqua, NSAppearanceNameDarkAqua ]] isEqualToString:NSAppearanceNameDarkAqua]; __block NSColor *win = nil; if ( !isDark ) return [NSColor whiteColor]; [a performAsCurrentDrawingAppearance:^{ win = [[NSColor windowBackgroundColor] colorUsingColorSpace:NSColorSpace.sRGBColorSpace]; }]; if ( win == nil ) win = [NSColor colorWithSRGBRed:0.196 green:0.196 blue:0.196 alpha:1.0]; return [win blendedColorWithFraction:0.07 ofColor:NSColor.whiteColor]; }]; return (__bridge void *)card;end fn = NULL// the box around a control, as a card: rounded corners, no outline, the card colour. A box in a XIB has no tag FB can// find (NSBox is not a control: a tag set in Interface Builder never reaches it), so the card is found from a// control inside it that has one, by walking up to the nearest box.void local fn StudioCardAround( innerTag as long )ViewRef  inner = fn StudioFindView( innerTag )ColorRef cardColor = fn StudioCardColorif ( inner == NULL ) then exit fncln NSView *v = (__bridge NSView *)inner; while ( v != nil && ![v isKindOfClass:[NSBox class]] ) v = v.superview; if ( v != nil ) { NSBox *card = (NSBox *)v; card.boxType = NSBoxCustom; card.borderWidth = 0.0; card.cornerRadius = 12.0; card.fillColor = (__bridge NSColor *)cardColor; }end fn// the logo on the Welcome view and the server formvoid local fn ApplyBrandingImageRef logo = fn ImageryLogoif ( logo == NULL )if ( isLoggingOn ) then NSLog( @"imagery_logo.png is not in the app bundle - check resources in the FB project." )exit fnend ifImageViewSetImage( _welcomeLogoImage, logo )ImageViewSetImage( _createLogoImage, logo )end fn// one look for every table, the Studio's and the generated apps' Lists (author, 2026-11-27: "match the grid on the// welcome screen with the other grids"): plain rows with a super-light line between them - no alternating shades,// which make stripes (author) - and the column headings a little larger and semibold in a slightly taller header row.// The generated apps' Lists look the same (App Shell.incl: ShellListHeadings)void local fn StudioTableStyle( tableTag as long )ViewRef table = fn StudioFindView( tableTag )if ( table == NULL ) then exit fncln if ( [(__bridge id)table isKindOfClass:[NSTableView class]] ) { NSTableView *t = (__bridge NSTableView *)table; NSFont *f = [NSFont systemFontOfSize:13.0 weight:NSFontWeightSemibold]; t.usesAlternatingRowBackgroundColors = NO; t.gridStyleMask = NSTableViewSolidHorizontalGridLineMask; t.gridColor = [NSColor.labelColor colorWithAlphaComponent:0.06]; for ( NSTableColumn *c in t.tableColumns ) c.headerCell.font = f; if ( t.headerView ) { NSRect r = t.headerView.frame; r.size.height = 28; t.headerView.frame = r; [t.enclosingScrollView tile]; [t.headerView setNeedsDisplay:YES]; } }end fn// a page as a raised card (author, 2026-11-28): a rounded box behind its controls, white in light mode and a step// lighter than the window in dark mode (StudioCardColor), with a soft shadow; it fills the page and stretches with itvoid local fn StudioRaisedCard( pageTag as long )ViewRef  page = fn StudioFindView( pageTag )ColorRef cardColor = fn StudioCardColorif ( page == NULL ) then exit fncln { NSView *p = (__bridge NSView *)page; NSBox *card = [[NSBox alloc] initWithFrame:NSInsetRect( p.bounds, 2, 2 )]; card.boxType = NSBoxCustom; card.borderWidth = 0.0; card.cornerRadius = 12.0; card.fillColor = (__bridge NSColor *)cardColor; card.titlePosition = NSNoTitle; card.autoresizingMask = NSViewWidthSizable | NSViewHeightSizable; NSShadow *shadow = [[NSShadow alloc] init]; shadow.shadowBlurRadius = 8.0; shadow.shadowOffset = NSMakeSize( 0, -2 ); shadow.shadowColor = [NSColor colorWithWhite:0.0 alpha:0.18]; card.wantsLayer = YES; card.shadow = shadow; [p addSubview:card positioned:NSWindowBelow relativeTo:nil]; }end fn// the pages' cards (Windows.incl, after the page views are loaded)void local fn StudioCardsfn StudioCardAround( _recentProjectsTable )       // the Welcome page's card (WelcomeView.xib)fn StudioTableStyle( _recentProjectsTable )       // every table the same: alternating rows, larger headingsfn StudioTableStyle( _objectTableView )fn StudioTableStyle( _attributeTableView )fn StudioCardAround( _projectNameEdit )           // the running server form's card (ProjectCreateView.xib)fn StudioRaisedCard( _projectDetailView )         // Entity Details, a raised cardfn StudioRaisedCard( _projectSettingsView )       // Settings, a raised cardend fn