/* *   I M A G E R Y    B U S I N E S S     S Y S T E M S,   L L C * *   Branding.incl - the product's name and the Imagery logo * *   The logos are the canonical Imagery files (imagery_logo.png: colour text for light *   backgrounds, imagery_logo_white.png: white text for dark ones), bundled as resources. *   ImageryLogo is one image that draws whichever suits the current appearance, so it *   follows the Mac between light and dark mode by itself. */#define APP_DISPLAY_NAME @"App Builder for FutureBasic"_welcomeLogoImage = 103                // WelcomeView.xib_createLogoImage  = 104                // ProjectCreateView.xib_welcomeCard      = 110                // WelcomeView.xib: the box around the projects_createCard       = 111                // ProjectCreateView.xib: the box around the server formlocal fn ImageryLogo as ImageRefcln NSImage *light = [NSImage imageNamed:@"imagery_logo"]; NSImage *dark = [NSImage imageNamed:@"imagery_logo_white"]; if ( light == nil ) return NULL; NSImage *logo = [NSImage imageWithSize:light.size flipped:NO drawingHandler:^BOOL( NSRect r ) { NSAppearance *a = NSAppearance.currentAppearance; if ( @available( macOS 11.0, * ) ) a = NSAppearance.currentDrawingAppearance; BOOL isDark = [[a bestMatchFromAppearancesWithNames:@[ NSAppearanceNameAqua, NSAppearanceNameDarkAqua ]] isEqualToString:NSAppearanceNameDarkAqua]; [( isDark && dark != nil ? dark : light ) drawInRect:r]; return YES; }]; return (__bridge void *)logo;end fn = NULL// the working area's card: a shade apart from the window, so it stands out a little - white on the light window,// a lighter grey on the dark one (macOS picks as the appearance changes)local fn StudioCardColor as ColorRefcln NSColor *card = [NSColor colorWithName:nil dynamicProvider:^NSColor *( NSAppearance *a ) { BOOL isDark = [[a bestMatchFromAppearancesWithNames:@[ NSAppearanceNameAqua, NSAppearanceNameDarkAqua ]] isEqualToString:NSAppearanceNameDarkAqua]; return isDark ? [NSColor colorWithSRGBRed:0.235 green:0.235 blue:0.243 alpha:1.0] : [NSColor whiteColor]; }]; return (__bridge void *)card;end fn = NULL// a box as a card: rounded corners, no outline, the card colourvoid local fn StudioCard( boxTag as long )BoxSetFillColor( boxTag, fn StudioCardColor )BoxSetBorderWidth( boxTag, 0.0 )BoxSetCornerRadius( boxTag, 12.0 )end fn// the logo on the Welcome view and the server formvoid local fn ApplyBrandingImageRef logo = fn ImageryLogoif ( logo == NULL )if (isLoggingOn) then NSLog( @"imagery_logo.png is not in the app bundle - check resources in the FB project." )exit fnend ifImageViewSetImage( _welcomeLogoImage, logo )ImageViewSetImage( _createLogoImage, logo )end fn// the pages' cards (Windows.incl, after the page views are loaded)void local fn StudioCardsfn StudioCard( _welcomeCard )fn StudioCard( _createCard )end fn