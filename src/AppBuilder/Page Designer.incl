/* *   I M A G E R Y    B U S I N E S S     S Y S T E M S,   L L C * *   Page Designer.incl - the Pages view (Professional edition): a project's pages composed from its entities *   (author, 2026-11-27; docs/design/Page Designer Design.md, phase 2b) * *       +- Pages -------+ +- Entities ---+ +- Parts of Order Entry, top to bottom -------------------------+ *       | Customers     | | Categories   | | 1.  Orders · Detail · drives the page                         | *       | Order Entry < | | Customers    | | 2.  Customers · Detail · follows Orders to Customers (n : 1)  | *       | Products      | | Orders  ...  | | 3.  Order Details · List · follows Orders to Order Details    | *       +---------------+ +--------------+ +---------------------------------------------------------------+ *       [New Page] [Remove Page] [Start from the Model's Pages]     Shown as [Detail]  Follows [ ... ]  [Remove Part] *       what is wrong, if anything (PagesCheck); otherwise "Saved" * *   - Drag an entity onto the parts (or double-click it): a sheet asks how it shows (Detail, List, List with detail) *     and, after the first part (the driver, which the navigator moves), the part it follows - the proposed link chosen *     (Pages Model.incl: PagesProposedLinks). *   - The selected part: its display and its link change in place; Remove Part keeps the others' links right. *   - Pages: New Page, Remove Page, rename (double-click the title), reorder (drag). A page's links to other pages *     follow a rename or a removal. *   - Every change is saved to <project>/Pages.json at once, and checked (PagesCheck): the problems show under the parts. *   Not yet (backlog): a page dragged onto another (its links), page icons, parts reordered by drag, the page flow *   diagram. The generated app reads Pages.json from phase 4; until then it keeps one page per entity. * *   The view is Cocoa (no FB tags inside it); the model work is FB's, called back: PagesDesignerOffer, ...Check, *   ...Save, ...Default. */begin globalsCFDictionaryRef gPagesDesignerResources   // the open project's model, for the callbacks (kept: LicenceKept)end globals// the C functions FB calls, declared for every part of the project (FB compiles in several chunks)BeginCDeclarationvoid PagesDesignerBuild( void *pageView, CFDictionaryRef pages, CFArrayRef entities, void *offerFn, void *checkFn, void *saveFn, void *defaultFn, void *cardColor );EndCBeginCFunctiontypedef CFArrayRef (*ABPagesOfferFn)( CFArrayRef parts, CFStringRef entityName );typedef CFArrayRef (*ABPagesCheckFn)( CFDictionaryRef pages );typedef BOOL (*ABPagesSaveFn)( CFDictionaryRef pages );typedef CFDictionaryRef (*ABPagesDefaultFn)( void );static NSString *const ABPagesEntityType = @"com.imagery.appbuilder.entity";     // an entity dragged from the palettestatic NSString *const ABPagesPageRowType = @"com.imagery.appbuilder.pagerow";   // a page dragged to a new placestatic NSArray *ABPagesDisplays( void ) { return @[ @"detail", @"list", @"listDetail" ]; }static NSArray *ABPagesDisplayNames( void ) { return @[ @"Detail", @"List", @"List with detail" ]; }static NSString *ABPagesDisplayName( id display ) {    NSUInteger i = [ABPagesDisplays() indexOfObject:display ? display : @""];    return i == NSNotFound ? @"?" : ABPagesDisplayNames()[i];}static NSString *ABPagesNotation( id cardinality ) {    NSDictionary *notation = @{ @"oneToMany":@"1 : n", @"manyToOne":@"n : 1", @"oneToOne":@"1 : 1", @"manyToMany":@"n : n" };    NSString *n = [cardinality isKindOfClass:NSString.class] ? notation[cardinality] : nil;    return n ? n : @"";}// an association in words: "Orders to Customers (n : 1), from part 1"static NSString *ABPagesLinkTitle( NSDictionary *link ) {    return [NSString stringWithFormat:@"%@ (%@), from part %ld", link[@"name"], ABPagesNotation( link[@"cardinality"] ), (long)[link[@"part"] integerValue] + 1];}// a popup item even when its title repeats (addItemWithTitle: would replace the first)static void ABPagesAddItem( NSPopUpButton *popup, NSString *title ) {    [popup.menu addItem:[[NSMenuItem alloc] initWithTitle:title action:nil keyEquivalent:@""]];}static BOOL ABPagesSameLink( id stored, NSDictionary *offered, NSString *partKey, NSInteger partIndex ) {    if ( ![stored isKindOfClass:NSDictionary.class] ) return NO;    if ( [offered[partKey] integerValue] != partIndex ) return NO;    if ( ![offered[@"how"] isEqual:stored[@"how"]] ) return NO;    return [offered[@"relationship"] isEqual:stored[@"relationship"]];}static NSTextField *ABPagesLabel( NSString *text, CGFloat size, NSFontWeight weight, NSColor *colour, NSRect frame ) {    NSTextField *label = [NSTextField wrappingLabelWithString:text ? text : @""];    label.font = [NSFont systemFontOfSize:size weight:weight];    label.textColor = colour;    label.frame = frame;    return label;}@interface ABPagesDesigner : NSObject <NSTableViewDataSource, NSTableViewDelegate>@property (strong) NSMutableDictionary *pages;              // nil until there are pages (none saved yet)@property (strong) NSArray *entities;@property (strong) NSTableView *pagesTable, *paletteTable, *partsTable;@property (strong) NSPopUpButton *displayPopup, *followsPopup;@property (strong) NSButton *removePartButton, *removePageButton;@property (strong) NSTextField *statusLabel;@property (strong) NSArray *followsOffered;                 // the links offered to the selected part (the popup's items)@property (assign) void *offerFn, *checkFn, *saveFn, *defaultFn;@property (assign) NSInteger pageIndex;@end@implementation ABPagesDesigner- (NSMutableArray *)pageList {    id list = self.pages[@"pages"];    return [list isKindOfClass:NSMutableArray.class] ? list : nil;}- (NSMutableDictionary *)currentPage {    NSMutableArray *list = self.pageList;    return ( list && self.pageIndex >= 0 && self.pageIndex < (NSInteger)list.count ) ? list[self.pageIndex] : nil;}- (NSMutableArray *)currentParts {    NSMutableDictionary *page = self.currentPage;    if ( page == nil ) return nil;    if ( ![page[@"parts"] isKindOfClass:NSMutableArray.class] ) page[@"parts"] = [NSMutableArray array];    return page[@"parts"];}- (NSMutableArray *)linksOf:(NSMutableDictionary *)page {    if ( ![page[@"links"] isKindOfClass:NSMutableArray.class] ) page[@"links"] = [NSMutableArray array];    return page[@"links"];}// what the model offers (FB: PagesProposedLinks)- (NSArray *)offerFor:(NSArray *)parts entity:(NSString *)entityName {    CFArrayRef offered;    if ( self.offerFn == NULL || entityName == nil ) return @[];    offered = ((ABPagesOfferFn)self.offerFn)( (__bridge CFArrayRef)parts, (__bridge CFStringRef)entityName );    return offered ? (__bridge NSArray *)offered : @[];}- (BOOL)titleUsed:(NSString *)title except:(NSDictionary *)page {    for ( NSDictionary *other in self.pageList ) if ( other != page && [other[@"title"] isEqual:title] ) return YES;    return NO;}// saved, checked, shown again; the part row given is selected (-1: none)- (void)changedSelectingPart:(NSInteger)partRow {    NSArray *problems = @[];    BOOL saved = NO;    if ( self.pages && self.saveFn ) saved = ((ABPagesSaveFn)self.saveFn)( (__bridge CFDictionaryRef)self.pages );    if ( self.pages && self.checkFn ) {        CFArrayRef found = ((ABPagesCheckFn)self.checkFn)( (__bridge CFDictionaryRef)self.pages );        if ( found ) problems = (__bridge NSArray *)found;    }    if ( problems.count > 0 ) {        NSArray *firstFew = [problems subarrayWithRange:NSMakeRange( 0, MIN( problems.count, (NSUInteger)3 ) )];        self.statusLabel.stringValue = [NSString stringWithFormat:@"%@%@", [firstFew componentsJoinedByString:@"\n"], problems.count > 3 ? [NSString stringWithFormat:@"\n... and %lu more", (unsigned long)( problems.count - 3 )] : @""];        self.statusLabel.textColor = NSColor.systemRedColor;    } else {        self.statusLabel.stringValue = saved ? @"Saved in Pages.json. Nothing to correct." : @"Not saved: the project folder could not be written.";        self.statusLabel.textColor = saved ? NSColor.secondaryLabelColor : NSColor.systemRedColor;    }    [self reloadSelectingPart:partRow];}- (void)reloadSelectingPart:(NSInteger)partRow {    NSInteger count = self.pageList ? (NSInteger)self.pageList.count : 0;    if ( self.pageIndex >= count ) self.pageIndex = count - 1;    if ( self.pageIndex < 0 && count > 0 ) self.pageIndex = 0;    [self.pagesTable reloadData];    if ( self.pageIndex >= 0 ) [self.pagesTable selectRowIndexes:[NSIndexSet indexSetWithIndex:self.pageIndex] byExtendingSelection:NO];    self.partsTable.tableColumns.firstObject.title = self.currentPage ? [NSString stringWithFormat:@"Parts of %@, top to bottom", self.currentPage[@"title"]] : @"Parts";    [self.partsTable.headerView setNeedsDisplay:YES];    [self.partsTable reloadData];    if ( partRow >= 0 && partRow < (NSInteger)self.currentParts.count ) [self.partsTable selectRowIndexes:[NSIndexSet indexSetWithIndex:partRow] byExtendingSelection:NO];    else [self.partsTable deselectAll:nil];    self.removePageButton.enabled = ( self.currentPage != nil );    [self showSelectedPart];}// --- the tables ---- (NSInteger)numberOfRowsInTableView:(NSTableView *)tableView {    if ( tableView == self.pagesTable ) return self.pageList ? (NSInteger)self.pageList.count : 0;    if ( tableView == self.paletteTable ) return (NSInteger)self.entities.count;    return self.currentParts ? (NSInteger)self.currentParts.count : 0;}- (id)tableView:(NSTableView *)tableView objectValueForTableColumn:(NSTableColumn *)column row:(NSInteger)row {    if ( tableView == self.pagesTable ) return self.pageList[row][@"title"];    if ( tableView == self.paletteTable ) return self.entities[row];    NSDictionary *part = self.currentParts[row];    NSString *how;    id follows = part[@"follows"];    if ( row == 0 ) how = @"drives the page (the navigator moves it)";    else if ( [follows isKindOfClass:NSDictionary.class] ) how = [NSString stringWithFormat:@"follows %@ (%@)", follows[@"name"], ABPagesNotation( follows[@"cardinality"] )];    else how = @"not linked";    return [NSString stringWithFormat:@"%ld.   %@   ·   %@   ·   %@", (long)row + 1, part[@"entity"], ABPagesDisplayName( part[@"display"] ), how];}// a page renamed (its links from other pages follow)- (void)tableView:(NSTableView *)tableView setObjectValue:(id)value forTableColumn:(NSTableColumn *)column row:(NSInteger)row {    NSMutableDictionary *page;    NSString *before, *title = [[value description] stringByTrimmingCharactersInSet:NSCharacterSet.whitespaceAndNewlineCharacterSet];    if ( tableView != self.pagesTable ) return;    page = self.pageList[row];    before = page[@"title"];    if ( title.length == 0 || [title isEqual:before] || [self titleUsed:title except:page] ) { if ( ![title isEqual:before] ) NSBeep(); return; }    page[@"title"] = title;    for ( NSMutableDictionary *other in self.pageList ) {        for ( NSUInteger k = 0; k < [self linksOf:other].count; k++ ) {            NSMutableArray *links = [self linksOf:other];            if ( [links[k][@"page"] isEqual:before] ) { NSMutableDictionary *link = [links[k] mutableCopy]; link[@"page"] = title; links[k] = link; }        }    }    [self changedSelectingPart:self.partsTable.selectedRow];}- (void)tableViewSelectionDidChange:(NSNotification *)note {    if ( note.object == self.pagesTable ) {        if ( self.pagesTable.selectedRow >= 0 && self.pagesTable.selectedRow != self.pageIndex ) {            self.pageIndex = self.pagesTable.selectedRow;            [self reloadSelectingPart:-1];        }    } else if ( note.object == self.partsTable ) {        [self showSelectedPart];    }}// drags: an entity from the palette, a page to a new place- (id<NSPasteboardWriting>)tableView:(NSTableView *)tableView pasteboardWriterForRow:(NSInteger)row {    NSPasteboardItem *item = [[NSPasteboardItem alloc] init];    if ( tableView == self.paletteTable ) { [item setString:self.entities[row] forType:ABPagesEntityType]; return item; }    if ( tableView == self.pagesTable ) { [item setString:[NSString stringWithFormat:@"%ld", (long)row] forType:ABPagesPageRowType]; return item; }    return nil;}- (NSDragOperation)tableView:(NSTableView *)tableView validateDrop:(id<NSDraggingInfo>)info proposedRow:(NSInteger)row proposedDropOperation:(NSTableViewDropOperation)operation {    NSPasteboard *board = info.draggingPasteboard;    if ( tableView == self.partsTable && [board stringForType:ABPagesEntityType] && self.currentPage ) {        [tableView setDropRow:(NSInteger)self.currentParts.count dropOperation:NSTableViewDropAbove];   // a new part goes last        return NSDragOperationCopy;    }    if ( tableView == self.pagesTable && [board stringForType:ABPagesPageRowType] && operation == NSTableViewDropAbove ) return NSDragOperationMove;    return NSDragOperationNone;}- (BOOL)tableView:(NSTableView *)tableView acceptDrop:(id<NSDraggingInfo>)info row:(NSInteger)row dropOperation:(NSTableViewDropOperation)operation {    NSPasteboard *board = info.draggingPasteboard;    if ( tableView == self.partsTable ) {        NSString *entityName = [board stringForType:ABPagesEntityType];        if ( entityName == nil ) return NO;        [self addEntity:entityName];        return YES;    }    if ( tableView == self.pagesTable ) {        NSInteger from = [[board stringForType:ABPagesPageRowType] integerValue], to = row;        NSMutableArray *list = self.pageList;        id moved;        if ( list == nil || from < 0 || from >= (NSInteger)list.count ) return NO;        moved = list[from];        [list removeObjectAtIndex:from];        if ( to > from ) to--;        if ( to > (NSInteger)list.count ) to = list.count;        [list insertObject:moved atIndex:to];        self.pageIndex = to;        [self changedSelectingPart:-1];        return YES;    }    return NO;}// --- adding a part: the sheet ---- (void)paletteDoubleClicked:(id)sender {    NSInteger row = self.paletteTable.clickedRow;    if ( row >= 0 && row < (NSInteger)self.entities.count ) [self addEntity:self.entities[row]];}- (void)addEntity:(NSString *)entityName {    NSMutableArray *parts = self.currentParts;    NSArray *offered;    NSAlert *alert;    NSPopUpButton *display, *follows = nil;    NSView *accessory;    NSInteger proposedDisplay = 2;    if ( parts == nil ) { NSBeep(); return; }                       // no page: New Page first    offered = parts.count > 0 ? [self offerFor:parts entity:entityName] : @[];    if ( parts.count > 0 ) {        proposedDisplay = 2;        if ( offered.count > 0 ) proposedDisplay = [offered[0][@"how"] isEqual:@"children"] || [offered[0][@"how"] isEqual:@"through"] ? 1 : 0;    }    alert = [[NSAlert alloc] init];    alert.messageText = [NSString stringWithFormat:@"Add %@ to %@", entityName, self.currentPage[@"title"]];    alert.informativeText = parts.count == 0 ? @"The first part drives the page: the navigator and the search move it. How should it show?"                          : offered.count > 0 ? @"How should it show, and which part does it follow? The proposed link is chosen."                          : @"Nothing on this page is related to it in the model: it will not be linked. How should it show?";    [alert addButtonWithTitle:@"Add"];    [alert addButtonWithTitle:@"Cancel"];    accessory = [[NSView alloc] initWithFrame:NSMakeRect( 0, 0, 420, offered.count > 0 ? 60 : 28 )];    display = [[NSPopUpButton alloc] initWithFrame:NSMakeRect( 0, offered.count > 0 ? 32 : 0, 420, 26 ) pullsDown:NO];    for ( NSString *title in ABPagesDisplayNames() ) ABPagesAddItem( display, [NSString stringWithFormat:@"Shown as: %@", title] );    [display selectItemAtIndex:proposedDisplay];    [accessory addSubview:display];    if ( offered.count > 0 ) {        follows = [[NSPopUpButton alloc] initWithFrame:NSMakeRect( 0, 0, 420, 26 ) pullsDown:NO];        for ( NSDictionary *link in offered ) ABPagesAddItem( follows, [NSString stringWithFormat:@"Follows: %@", ABPagesLinkTitle( link )] );        ABPagesAddItem( follows, @"Not linked" );        [follows selectItemAtIndex:0];        [accessory addSubview:follows];    }    alert.accessoryView = accessory;    [alert beginSheetModalForWindow:self.partsTable.window completionHandler:^( NSModalResponse response ) {        id link = NSNull.null;        if ( response != NSAlertFirstButtonReturn ) return;        if ( follows != nil && follows.indexOfSelectedItem >= 0 && follows.indexOfSelectedItem < (NSInteger)offered.count ) link = [offered[follows.indexOfSelectedItem] mutableCopy];        [parts addObject:[@{ @"entity":entityName, @"display":ABPagesDisplays()[display.indexOfSelectedItem], @"follows":link } mutableCopy]];        [self changedSelectingPart:(NSInteger)parts.count - 1];    }];}// --- the selected part ---- (void)showSelectedPart {    NSMutableArray *parts = self.currentParts;    NSInteger row = self.partsTable.selectedRow, chosen, storedPart;    NSUInteger displayIndex;    NSDictionary *part;    id stored;    BOOL hasPart = ( parts != nil && row >= 0 && row < (NSInteger)parts.count );    self.displayPopup.enabled = hasPart;    self.removePartButton.enabled = hasPart;    self.followsPopup.enabled = ( hasPart && row > 0 );    [self.followsPopup removeAllItems];    self.followsOffered = @[];    if ( !hasPart ) { ABPagesAddItem( self.followsPopup, @"Choose a part" ); return; }    part = parts[row];    displayIndex = [ABPagesDisplays() indexOfObject:part[@"display"] ? part[@"display"] : @""];    [self.displayPopup selectItemAtIndex:displayIndex == NSNotFound ? 0 : (NSInteger)displayIndex];    if ( row == 0 ) { ABPagesAddItem( self.followsPopup, @"Drives the page: the navigator moves it" ); return; }    self.followsOffered = [self offerFor:[parts subarrayWithRange:NSMakeRange( 0, row )] entity:part[@"entity"]];    for ( NSDictionary *link in self.followsOffered ) ABPagesAddItem( self.followsPopup, ABPagesLinkTitle( link ) );    ABPagesAddItem( self.followsPopup, @"Not linked" );    chosen = (NSInteger)self.followsOffered.count;                      // Not linked, unless the stored link is offered    stored = part[@"follows"];    storedPart = [stored isKindOfClass:NSDictionary.class] ? [stored[@"part"] integerValue] : -1;    for ( NSUInteger k = 0; k < self.followsOffered.count; k++ ) {        if ( ABPagesSameLink( stored, self.followsOffered[k], @"part", storedPart ) ) chosen = (NSInteger)k;    }    [self.followsPopup selectItemAtIndex:chosen];}- (NSMutableDictionary *)selectedPartMutable {    NSMutableArray *parts = self.currentParts;    NSInteger row = self.partsTable.selectedRow;    if ( parts == nil || row < 0 || row >= (NSInteger)parts.count ) return nil;    if ( ![parts[row] isKindOfClass:NSMutableDictionary.class] ) parts[row] = [parts[row] mutableCopy];    return parts[row];}- (void)displayChosen:(id)sender {    NSMutableDictionary *part = self.selectedPartMutable;    if ( part == nil ) return;    part[@"display"] = ABPagesDisplays()[self.displayPopup.indexOfSelectedItem];    [self changedSelectingPart:self.partsTable.selectedRow];}- (void)followsChosen:(id)sender {    NSMutableDictionary *part = self.selectedPartMutable;    NSInteger i = self.followsPopup.indexOfSelectedItem;    if ( part == nil || self.partsTable.selectedRow == 0 ) return;    part[@"follows"] = ( i >= 0 && i < (NSInteger)self.followsOffered.count ) ? [self.followsOffered[i] mutableCopy] : NSNull.null;    [self changedSelectingPart:self.partsTable.selectedRow];}// Remove Part: the parts after it that followed it are no longer linked; the others keep following the same part- (void)removePart:(id)sender {    NSMutableArray *parts = self.currentParts;    NSInteger removed = self.partsTable.selectedRow;    NSMutableArray *links;    if ( parts == nil || removed < 0 || removed >= (NSInteger)parts.count ) return;    [parts removeObjectAtIndex:removed];    for ( NSUInteger j = 0; j < parts.count; j++ ) {        id follows = parts[j][@"follows"];        NSInteger followed;        if ( ![follows isKindOfClass:NSDictionary.class] ) continue;        if ( ![parts[j] isKindOfClass:NSMutableDictionary.class] ) parts[j] = [parts[j] mutableCopy];        followed = [follows[@"part"] integerValue];        if ( followed == removed || j == 0 ) parts[j][@"follows"] = NSNull.null;           // the driver follows nothing        else if ( followed > removed ) { NSMutableDictionary *moved = [follows mutableCopy]; moved[@"part"] = @( followed - 1 ); parts[j][@"follows"] = moved; }    }    links = [self linksOf:self.currentPage];                                              // the page's links to others    for ( NSInteger k = (NSInteger)links.count - 1; k >= 0; k-- ) {        NSInteger from = [links[k][@"fromPart"] integerValue];        if ( from == removed ) [links removeObjectAtIndex:k];        else if ( from > removed ) { NSMutableDictionary *moved = [links[k] mutableCopy]; moved[@"fromPart"] = @( from - 1 ); links[k] = moved; }    }    [self changedSelectingPart:MIN( removed, (NSInteger)parts.count - 1 )];}// --- pages ---- (void)newPage:(id)sender {    NSString *title = @"New Page";    int n = 2;    if ( self.pages == nil ) self.pages = [@{ @"pages":[NSMutableArray array] } mutableCopy];    if ( self.pageList == nil ) self.pages[@"pages"] = [NSMutableArray array];    while ( [self titleUsed:title except:nil] ) title = [NSString stringWithFormat:@"New Page %d", n++];    [self.pageList addObject:[@{ @"title":title, @"icon":NSNull.null, @"parts":[NSMutableArray array], @"links":[NSMutableArray array] } mutableCopy]];    self.pageIndex = (NSInteger)self.pageList.count - 1;    [self changedSelectingPart:-1];    [self.pagesTable editColumn:0 row:self.pageIndex withEvent:nil select:YES];   // name it now}- (void)removePage:(id)sender {    NSMutableDictionary *page = self.currentPage;    NSAlert *alert;    if ( page == nil ) return;    alert = [[NSAlert alloc] init];    alert.messageText = [NSString stringWithFormat:@"Remove the page %@?", page[@"title"]];    alert.informativeText = @"Its parts go with it, and the links other pages have to it.";    [alert addButtonWithTitle:@"Remove"];    [alert addButtonWithTitle:@"Cancel"];    [alert beginSheetModalForWindow:self.pagesTable.window completionHandler:^( NSModalResponse response ) {        NSString *title = page[@"title"];        if ( response != NSAlertFirstButtonReturn ) return;        [self.pageList removeObject:page];        for ( NSMutableDictionary *other in self.pageList ) {            NSMutableArray *links = [self linksOf:other];            for ( NSInteger k = (NSInteger)links.count - 1; k >= 0; k-- ) if ( [links[k][@"page"] isEqual:title] ) [links removeObjectAtIndex:k];        }        [self changedSelectingPart:-1];    }];}// the model's own pages (one per table, List with detail), to edit - replacing the pages there are, after asking- (void)startFromModel:(id)sender {    void (^replace)( void ) = ^{        CFDictionaryRef fresh = self.defaultFn ? ((ABPagesDefaultFn)self.defaultFn)() : NULL;        if ( fresh == NULL ) return;        self.pages = (__bridge NSMutableDictionary *)fresh;        self.pageIndex = 0;        [self changedSelectingPart:-1];    };    NSAlert *alert;    if ( self.pageList.count == 0 ) { replace(); return; }    alert = [[NSAlert alloc] init];    alert.messageText = [NSString stringWithFormat:@"Replace the %lu pages with the model's own?", (unsigned long)self.pageList.count];    alert.informativeText = @"One page per table, each a List with its Form - what the Lite edition shows. Your pages are replaced.";    [alert addButtonWithTitle:@"Replace"];    [alert addButtonWithTitle:@"Cancel"];    [alert beginSheetModalForWindow:self.pagesTable.window completionHandler:^( NSModalResponse response ) {        if ( response == NSAlertFirstButtonReturn ) replace();    }];}@endstatic ABPagesDesigner *abPagesDesigner = nil;static NSTableView *ABPagesTable( NSView *parent, NSRect frame, NSString *title, NSUInteger mask, BOOL editable, ABPagesDesigner *owner ) {    NSScrollView *scroll = [[NSScrollView alloc] initWithFrame:frame];    NSTableView *table = [[NSTableView alloc] initWithFrame:scroll.bounds];    NSTableColumn *column = [[NSTableColumn alloc] initWithIdentifier:@"main"];    scroll.hasVerticalScroller = YES;    scroll.borderType = NSBezelBorder;    scroll.autoresizingMask = mask;    column.title = title;    column.editable = editable;    column.width = frame.size.width - 4;    column.resizingMask = NSTableColumnAutoresizingMask;    [table addTableColumn:column];    table.columnAutoresizingStyle = NSTableViewUniformColumnAutoresizingStyle;    table.rowHeight = 24;    table.usesAlternatingRowBackgroundColors = NO;                       // no stripes (author)    table.gridStyleMask = NSTableViewSolidHorizontalGridLineMask;    table.gridColor = [NSColor.labelColor colorWithAlphaComponent:0.06];    table.dataSource = owner;    table.delegate = owner;    scroll.documentView = table;    [parent addSubview:scroll];    return table;}static NSButton *ABPagesButton( NSView *parent, NSString *title, NSRect frame, SEL action, NSUInteger mask ) {    NSButton *button = [NSButton buttonWithTitle:title target:abPagesDesigner action:action];    button.frame = frame;    button.autoresizingMask = mask;    [parent addSubview:button];    return button;}void PagesDesignerBuild( void *pageView, CFDictionaryRef pages, CFArrayRef entities, void *offerFn, void *checkFn, void *saveFn, void *defaultFn, void *cardColor ) {    NSView *page = (__bridge NSView *)pageView;    NSBox *card;    NSView *inside;    NSShadow *shadow;    CGFloat w, h, tablesBottom = 112, tablesTop, partsLeft = 436;    if ( page == nil ) return;    for ( NSView *old in [page.subviews copy] ) [old removeFromSuperview];    abPagesDesigner = [[ABPagesDesigner alloc] init];    abPagesDesigner.pages = pages ? (__bridge NSMutableDictionary *)pages : nil;    abPagesDesigner.entities = entities ? (__bridge NSArray *)entities : @[];    abPagesDesigner.offerFn = offerFn;    abPagesDesigner.checkFn = checkFn;    abPagesDesigner.saveFn = saveFn;    abPagesDesigner.defaultFn = defaultFn;    abPagesDesigner.pageIndex = 0;    // the raised card the Studio's pages sit on (Branding.incl: StudioCardColor)    card = [[NSBox alloc] initWithFrame:NSInsetRect( page.bounds, 2, 2 )];    card.boxType = NSBoxCustom; card.borderWidth = 0.0; card.cornerRadius = 12.0; card.titlePosition = NSNoTitle;    card.contentViewMargins = NSZeroSize;    card.fillColor = cardColor ? (__bridge NSColor *)cardColor : NSColor.controlBackgroundColor;    card.autoresizingMask = NSViewWidthSizable | NSViewHeightSizable;    shadow = [[NSShadow alloc] init]; shadow.shadowBlurRadius = 8.0; shadow.shadowOffset = NSMakeSize( 0, -2 );    shadow.shadowColor = [NSColor.blackColor colorWithAlphaComponent:0.18];    card.shadow = shadow;    [page addSubview:card];    inside = card.contentView;    w = inside.bounds.size.width; h = inside.bounds.size.height;    tablesTop = h - 64;    [inside addSubview:ABPagesLabel( @"Pages", 17, NSFontWeightSemibold, NSColor.labelColor, NSMakeRect( 16, h - 36, 300, 22 ) )];    ((NSView *)inside.subviews.lastObject).autoresizingMask = NSViewMinYMargin;    [inside addSubview:ABPagesLabel( @"Drag an entity onto a page's parts, or double-click it. The first part drives the page; each next one follows a part above it, through the model's relationships.", 12, NSFontWeightRegular, NSColor.secondaryLabelColor, NSMakeRect( 16, h - 58, w - 32, 18 ) )];    ((NSView *)inside.subviews.lastObject).autoresizingMask = NSViewMinYMargin | NSViewWidthSizable;    abPagesDesigner.pagesTable = ABPagesTable( inside, NSMakeRect( 16, tablesBottom, 200, tablesTop - tablesBottom ), @"Pages", NSViewHeightSizable | NSViewMaxXMargin, YES, abPagesDesigner );    abPagesDesigner.paletteTable = ABPagesTable( inside, NSMakeRect( 226, tablesBottom, 200, tablesTop - tablesBottom ), @"Entities", NSViewHeightSizable | NSViewMaxXMargin, NO, abPagesDesigner );    abPagesDesigner.partsTable = ABPagesTable( inside, NSMakeRect( partsLeft, tablesBottom, w - partsLeft - 16, tablesTop - tablesBottom ), @"Parts", NSViewHeightSizable | NSViewWidthSizable, NO, abPagesDesigner );    abPagesDesigner.paletteTable.target = abPagesDesigner;    abPagesDesigner.paletteTable.doubleAction = @selector(paletteDoubleClicked:);    [abPagesDesigner.paletteTable setDraggingSourceOperationMask:NSDragOperationCopy forLocal:YES];    [abPagesDesigner.partsTable registerForDraggedTypes:@[ ABPagesEntityType ]];    [abPagesDesigner.pagesTable registerForDraggedTypes:@[ ABPagesPageRowType ]];    [abPagesDesigner.pagesTable setDraggingSourceOperationMask:NSDragOperationMove forLocal:YES];    // under the pages: New Page, Remove Page, Start from the Model's Pages    ABPagesButton( inside, @"New Page", NSMakeRect( 12, 72, 104, 32 ), @selector(newPage:), NSViewMaxXMargin | NSViewMaxYMargin );    abPagesDesigner.removePageButton = ABPagesButton( inside, @"Remove Page", NSMakeRect( 116, 72, 110, 32 ), @selector(removePage:), NSViewMaxXMargin | NSViewMaxYMargin );    ABPagesButton( inside, @"Start from the Model's Pages", NSMakeRect( 226, 72, 204, 32 ), @selector(startFromModel:), NSViewMaxXMargin | NSViewMaxYMargin );    // under the parts: the selected part's display, its link, Remove Part    abPagesDesigner.displayPopup = [[NSPopUpButton alloc] initWithFrame:NSMakeRect( partsLeft, 76, 170, 26 ) pullsDown:NO];    for ( NSString *title in ABPagesDisplayNames() ) ABPagesAddItem( abPagesDesigner.displayPopup, title );    abPagesDesigner.displayPopup.target = abPagesDesigner;    abPagesDesigner.displayPopup.action = @selector(displayChosen:);    abPagesDesigner.displayPopup.autoresizingMask = NSViewMaxXMargin | NSViewMaxYMargin;    [inside addSubview:abPagesDesigner.displayPopup];    abPagesDesigner.followsPopup = [[NSPopUpButton alloc] initWithFrame:NSMakeRect( partsLeft + 178, 76, w - partsLeft - 178 - 16 - 128, 26 ) pullsDown:NO];    abPagesDesigner.followsPopup.target = abPagesDesigner;    abPagesDesigner.followsPopup.action = @selector(followsChosen:);    abPagesDesigner.followsPopup.autoresizingMask = NSViewWidthSizable | NSViewMaxYMargin;    [inside addSubview:abPagesDesigner.followsPopup];    abPagesDesigner.removePartButton = ABPagesButton( inside, @"Remove Part", NSMakeRect( w - 16 - 124, 72, 128, 32 ), @selector(removePart:), NSViewMinXMargin | NSViewMaxYMargin );    // what is wrong, or "Saved"    abPagesDesigner.statusLabel = ABPagesLabel( @"", 12, NSFontWeightRegular, NSColor.secondaryLabelColor, NSMakeRect( 16, 12, w - 32, 52 ) );    abPagesDesigner.statusLabel.autoresizingMask = NSViewWidthSizable | NSViewMaxYMargin;    [inside addSubview:abPagesDesigner.statusLabel];    if ( abPagesDesigner.pages == nil ) {        abPagesDesigner.statusLabel.stringValue = @"No pages yet: Start from the Model's Pages (one per table, to change), or New Page. Until a project has pages, its app shows one page per entity.";        [abPagesDesigner reloadSelectingPart:-1];    } else {        [abPagesDesigner changedSelectingPart:-1];    }}EndCtoolbox PagesDesignerBuild( ptr pageView, CFDictionaryRef pages, CFArrayRef entities, ptr offerFn, ptr checkFn, ptr saveFn, ptr defaultFn, ptr cardColor )// --- the model's side, called back from the view ---local fn PagesDesignerOffer( parts as CFArrayRef, entityName as CFStringRef ) as CFArrayRefend fn = fn PagesProposedLinks( gPagesDesignerResources, parts, entityName )local fn PagesDesignerCheck( pages as CFDictionaryRef ) as CFArrayRefend fn = fn PagesCheck( gPagesDesignerResources, pages )local fn PagesDesignerSave( pages as CFDictionaryRef ) as BOOLend fn = fn PagesSave( pages )local fn PagesDesignerDefault as CFMutableDictionaryRefend fn = fn PagesDefault( gPagesDesignerResources )// Model > Pages (Professional): the page, in the Studio's window, beside the entity listvoid local fn PagesShowCFDictionaryRef modelResources = fn DictionaryObjectForKey( gProjectDictionary, @"resources" )if ( modelResources == NULL )alert 1, NSAlertStyleInformational, @"No project is open.", @"Open a project first: its pages are made from its entities.", @[@"OK"], NOexit fnend ifif ( fn LicenceGate( _licenceFeatureProfessionalRuntime, @"The page designer" ) == NO ) then exit fngPagesDesignerResources = fn LicenceKept( modelResources, gPagesDesignerResources )ViewSetHidden( _welcomeView, YES )ViewSetHidden( _projectCreateView, YES )ViewSetHidden( _projectDetailView, YES )ViewSetHidden( _projectSettingsView, YES )ViewSetHidden( _newProjectView, YES )ViewSetHidden( _alsProjectView, YES )ViewSetHidden( _licenceView, YES )ViewSetHidden( _pagesView, NO )PagesDesignerBuild( fn StudioFindView( _pagesView ), fn PagesLoad, fn PagesTables( modelResources ), @fn PagesDesignerOffer, @fn PagesDesignerCheck, @fn PagesDesignerSave, @fn PagesDesignerDefault, fn StudioCardColor )fn StudioUpdateCommands                               // the crumb trail: Projects / <project> / Pagesend fn