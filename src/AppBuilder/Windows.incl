// the page area beside the entity list, below the heading: every page view fills it// and stretches with the window (its XIB's autoresizing masks place its controls)local fn PageFrame as CGRectCGRect content = fn ViewBounds( _windowContentViewTag )CGFloat x = _tableViewWidth + ( _controlSpacer * 2 )end fn = fn CGRectMake( x, _controlSpacer, content.size.width - x - _controlSpacer, content.size.height - _controlSpacer - _pageHeadingHeight )void local fn FitPageView( viewTag as long )ViewSetFrame( viewTag, fn PageFrame )ViewSetAutoresizingMask( viewTag, NSViewWidthSizable + NSViewHeightSizable )end fn// a page that is its own heading (the Imagery logo, the product's name and a line under it, then the box with the// page's work): the Welcome view and the running server's form. It also takes the heading's place under the crumb// trail, and the window's heading hides while it shows (StudioUpdateCrumbs)void local fn FitOwnHeadingView( viewTag as long )CGRect r = fn PageFramer.size.height = r.size.height + _pageHeadingHeight - _crumbTrailHeightViewSetFrame( viewTag, r )ViewSetAutoresizingMask( viewTag, NSViewWidthSizable + NSViewHeightSizable )end fn// the Studio's push buttons as Mac-style pills (Pill Buttons.incl); the Return button of each// page is its main actionvoid local fn StudioPillButtonsfn PillButton( _createProjectBtn, _pillDefault )           // Welcomefn PillButton( _openProjectBtn, _pillPlain )fn PillButton( _newProjectChooseBtn, _pillPlain )          // New Projectfn PillButton( _newProjectUseALSBtn, _pillPlain )fn PillButton( _newProjectCancelBtn, _pillPlain )fn PillButton( _newProjectCreateBtn, _pillDefault )fn PillButton( _alsReadBtn, _pillPlain )                   // API Logic Server Projectfn PillButton( _alsFolderBtn, _pillPlain )fn PillButton( _alsFileBtn, _pillPlain )fn PillButton( _alsRunningServerBtn, _pillPlain )fn PillButton( _alsCancelBtn, _pillPlain )fn PillButton( _alsCreateBtn, _pillDefault )fn PillButton( _createProjectCancelBtn, _pillPlain )       // the running server's formfn PillButton( _createProjectCreateBtn, _pillDefault )fn PillButton( _projectSettingsDoneBtn, _pillDefault )     // Project Settingsend fnvoid local fn BuildSubViewsCGRect r, headinglong   inibview _welcomeView, 		   @"WelcomeView",,  				( _tableViewWidth + (_controlSpacer * 2), _mainWindowHeight - _welcomeViewHeight - ( _controlSpacer * 2) )nibview _projectCreateView,	 @"ProjectCreateView",,		( _tableViewWidth + (_controlSpacer * 2), _mainWindowHeight - _projectCreateViewHeight - ( _controlSpacer * 2) )nibview _projectDetailView,	 @"ProjectDetailView",,		( _tableViewWidth + (_controlSpacer * 2), _mainWindowHeight - _projectDetailViewHeight - ( _controlSpacer * 2) )nibview _newProjectView, 	 @"NewProjectView",,			( _tableViewWidth + (_controlSpacer * 2), _mainWindowHeight - _welcomeViewHeight - ( _controlSpacer * 2) )nibview _alsProjectView, 	 @"ALSProjectView",,			( _tableViewWidth + (_controlSpacer * 2), _mainWindowHeight - _welcomeViewHeight - ( _controlSpacer * 2) )nibview _projectSettingsView, @"ProjectSettingsView",,	( _tableViewWidth + (_controlSpacer * 2), _mainWindowHeight - _welcomeViewHeight - ( _controlSpacer * 2) )// Init Toolbar and Viewsnibtoolbar _mainToolbar, @"Toolbar"WindowSetToolbar( _window, _mainToolbar )// every page fills the area beside the entity list and resizes with the windowfn FitOwnHeadingView( _welcomeView )fn FitOwnHeadingView( _projectCreateView )fn FitPageView( _projectDetailView )fn FitPageView( _newProjectView )fn FitPageView( _alsProjectView )fn FitPageView( _projectSettingsView )   // after the toolbar: it changes the content area// the design row of the entity view, under its summary (Project Actions.incl): the selected// attribute's control, the entity's Form layout, the entity's icon and its previewr = fn ViewBounds( _projectDetailView )// the Control popup's items are rebuilt for each attribute, so the first one names the recommendationpopupbutton _controlPopup, NO, 0, @[ @"Control: choose an attribute" ], fn CGRectMake( 12, r.size.height - 78, 230, 28 ), NO, _windowViewAddSubview( _projectDetailView, _controlPopup )ViewSetAutoresizingMask( _controlPopup, NSViewMaxXMargin + NSViewMinYMargin )ViewSetToolTip( _controlPopup, @"The control the selected attribute has on the generated Form." )popupbutton _formColumnsPopup, YES, 0, @[ @"Form: automatic", @"Form: 1 column", @"Form: 2 columns", @"Form: 3 columns" ], fn CGRectMake( 252, r.size.height - 78, 170, 28 ), NO, _windowViewAddSubview( _projectDetailView, _formColumnsPopup )ViewSetAutoresizingMask( _formColumnsPopup, NSViewMaxXMargin + NSViewMinYMargin )ViewSetToolTip( _formColumnsPopup, @"How many columns of fields the generated Form has. Automatic: 1 up to 10 fields, 2 up to 24, then 3." )imageview _entityIconPreview, YES, NULL, fn CGRectMake( 436, r.size.height - 74, 22, 22 ), NSImageScaleProportionallyUpOrDown, , , _windowViewAddSubview( _projectDetailView, _entityIconPreview )ViewSetAutoresizingMask( _entityIconPreview, NSViewMaxXMargin + NSViewMinYMargin )popupbutton _entityIconPopup, YES, 0, @[ @"Icon" ], fn CGRectMake( 464, r.size.height - 78, 230, 28 ), NO, _windowViewAddSubview( _projectDetailView, _entityIconPopup )ViewSetAutoresizingMask( _entityIconPopup, NSViewMaxXMargin + NSViewMinYMargin )ViewSetToolTip( _entityIconPopup, @"The entity's icon on its button in the generated app's navigation bar (an SF Symbol)." )// the crumb trail along the top, the heading under it (Menus.incl, StudioUpdateCrumbs): its// buttons and chevrons are made once here, then titled, placed and shown as the developer movesheading = fn ViewFrame( _projectHeadingName )gStudioCrumbLeft   = heading.origin.x - 4gStudioCrumbBottom = heading.origin.y + heading.size.height - _crumbHeightfor i = 0 to _crumbMax - 1button _crumbButtonBase + i, YES, , @"", fn CGRectMake( gStudioCrumbLeft, gStudioCrumbBottom, 80, _crumbHeight ), NSButtonTypeMomentaryPushIn, NSBezelStyleRegularSquare, _windowButtonSetBordered( _crumbButtonBase + i, NO )ButtonSetImagePosition( _crumbButtonBase + i, NSImageLeft )ViewSetAutoresizingMask( _crumbButtonBase + i, NSViewMaxXMargin + NSViewMinYMargin )ViewSetHidden( _crumbButtonBase + i, YES )nextfor i = 0 to _crumbMax - 2imageview _crumbSeparatorBase + i, YES, fn ImageWithSystemSymbolName( @"chevron.right", @"then" ), fn CGRectMake( gStudioCrumbLeft, gStudioCrumbBottom + 4, 12, 14 ), NSImageScaleProportionallyDown, , , _windowViewSetAutoresizingMask( _crumbSeparatorBase + i, NSViewMaxXMargin + NSViewMinYMargin )ViewSetHidden( _crumbSeparatorBase + i, YES )nextheading.origin.y = heading.origin.y - _crumbTrailHeightViewSetFrame( _projectHeadingName, heading )gStudioHeadingFrame = heading// the open project's icon, left of its name (Project Workspace.incl, ProjectShowHeading): 32 points, centred on the textimageview _projectHeadingIcon, YES, NULL, fn CGRectMake( heading.origin.x + 2, heading.origin.y + ( heading.size.height - 32 ) / 2, 32, 32 ), NSImageScaleProportionallyUpOrDown, , , _windowViewSetAutoresizingMask( _projectHeadingIcon, NSViewMaxXMargin + NSViewMinYMargin )ViewSetHidden( _projectHeadingIcon, YES )// set hiddenViewSetHidden( _welcomeView, NO )ViewSetHidden( _projectCreateView, YES )ViewSetHidden( _projectDetailView, YES )ViewSetHidden( _projectSettingsView, YES )ViewSetHidden( _newProjectView, YES )ViewSetHidden( _alsProjectView, YES )fn ApplyBranding                                            // the Imagery logo (Branding.incl)fn ProjectSettingsSetUp                                     // the logo well takes paste and dropfn ALSProjectSetUp                                          // the ALS project view's drop zone (a subclassed view)fn StudioPillButtons                                        // pill-shaped push buttons (Pill Buttons.incl)fn RecentProjectsShow                                       // Welcome view: Recent ProjectsWindowMakeFirstResponder( _window, _createProjectCreateBtn )fn StudioUpdateCommands                                     // no project yet: only what applies (Menus.incl)end fnvoid local fn BuildWindownibwindow _window, @"MainWindow"WindowSetContentMinSize( _window, fn CGSizeMake( _minWindowWidth, _minWindowHeight ) )WindowCenter( _window )fn TableViewSetCustomCellCallback( _objectTableView, @[ID_KEY,OBJECT_KEY], @fn MyCustomCellCallback, NULL )fn TableViewSizeLastColumnToFit( _objectTableView )ViewSetAutoresizesSubviews( _windowContentViewTag, YES )   // View* functions take a view tag, not the window tagend fn