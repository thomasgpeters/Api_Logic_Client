/* *   Windows.incl - the Studio's window: its page views (one XIB each), the toolbar, the entity list and the *   attribute table, laid out beside the list and stretched with the window */// the page area beside the entity list, below the heading: every page view fills it// and stretches with the window (its XIB's autoresizing masks place its controls)local fn PageFrame as CGRectCGRect content = fn ViewBounds( _windowContentViewTag )CGFloat x = _tableViewWidth + ( _controlSpacer * 2 )end fn = fn CGRectMake( x, _controlSpacer + _studioFooterHeight, content.size.width - x - _controlSpacer, content.size.height - _controlSpacer - _studioFooterHeight - _pageHeadingHeight )void local fn FitPageView( viewTag as long )ViewSetFrame( viewTag, fn PageFrame )ViewSetAutoresizingMask( viewTag, NSViewWidthSizable + NSViewHeightSizable )end fn// a page that is its own heading (the Imagery logo, the product's name and a line under it, then the box with the// page's work): the Welcome view and the running server's form. It also takes the heading's place under the crumb// trail, and the window's heading hides while it shows (StudioUpdateCrumbs)void local fn FitOwnHeadingView( viewTag as long )CGRect r = fn PageFramer.size.height = r.size.height + _pageHeadingHeight - _crumbTrailHeightViewSetFrame( viewTag, r )ViewSetAutoresizingMask( viewTag, NSViewWidthSizable + NSViewHeightSizable )end fn// the window's frame (author, 2026-11-28): the entity list starts under the heading (which runs across the window) and// ends above a black footer that carries the copyright, small and centredvoid local fn StudioLayoutFrameCGRect  content = fn ViewBounds( _windowContentViewTag )ViewRef list = fn StudioFindView( _objectTableView )CGFloat listTop = content.size.height - _pageHeadingHeightCGFloat footerH = _studioFooterHeightcln if ( list != NULL ) { NSScrollView *sv = [(__bridge NSView *)list enclosingScrollView]; NSRect r = sv.frame; CGFloat bottom = r.origin.y + footerH; sv.frame = NSMakeRect( r.origin.x, bottom, r.size.width, listTop - bottom ); }ViewSetFrame( _objectListButtons, fn CGRectOffset( fn ViewFrame( _objectListButtons ), 0, _studioFooterHeight ) )box _studioFooterBox, @"", fn CGRectMake( 0, 0, content.size.width, _studioFooterHeight ), NSBoxCustom, _windowBoxSetFillColor( _studioFooterBox, fn ColorBlack )BoxSetBorderWidth( _studioFooterBox, 0.0 )BoxSetCornerRadius( _studioFooterBox, 0.0 )ViewSetAutoresizingMask( _studioFooterBox, NSViewWidthSizable + NSViewMaxYMargin )textlabel _studioFooterText, @"© 2026 Imagery Business Systems, LLC", fn CGRectMake( 0, 4, content.size.width, 14 ), _windowControlSetFont( _studioFooterText, fn FontSystemFontOfSize( 10.0 ) )ControlSetAlignment( _studioFooterText, NSTextAlignmentCenter )TextFieldSetTextColor( _studioFooterText, fn ColorWithSRGB( 1.0, 1.0, 1.0, 0.7 ) )ViewSetAutoresizingMask( _studioFooterText, NSViewWidthSizable + NSViewMaxYMargin )end fn// the Studio's push buttons as Mac-style pills (Pill Buttons.incl); the Return button of each// page is its main actionvoid local fn StudioPillButtonsfn PillButton( _createProjectBtn, _pillDefault )           // Welcomefn PillButton( _openProjectBtn, _pillPlain )fn PillButton( _newProjectChooseBtn, _pillPlain )          // New Projectfn PillButton( _newProjectUseALSBtn, _pillPlain )fn PillButton( _newProjectCancelBtn, _pillPlain )fn PillButton( _newProjectCreateBtn, _pillDefault )fn PillButton( _alsReadBtn, _pillPlain )                   // API Logic Server Projectfn PillButton( _alsFolderBtn, _pillPlain )fn PillButton( _alsFileBtn, _pillPlain )fn PillButton( _alsRunningServerBtn, _pillPlain )fn PillButton( _alsCancelBtn, _pillPlain )fn PillButton( _alsCreateBtn, _pillDefault )fn PillButton( _createProjectCancelBtn, _pillPlain )       // the running server's formfn PillButton( _createProjectCreateBtn, _pillDefault )fn PillButton( _projectSettingsDoneBtn, _pillDefault )     // Project Settingsend fnvoid local fn BuildSubViewsCGRect r, headinglong   inibview _welcomeView,         @"WelcomeView",,         ( _tableViewWidth + ( _controlSpacer * 2 ), _mainWindowHeight - _welcomeViewHeight - ( _controlSpacer * 2 ) )nibview _projectCreateView,   @"ProjectCreateView",,   ( _tableViewWidth + ( _controlSpacer * 2 ), _mainWindowHeight - _projectCreateViewHeight - ( _controlSpacer * 2 ) )nibview _projectDetailView,   @"ProjectDetailView",,   ( _tableViewWidth + ( _controlSpacer * 2 ), _mainWindowHeight - _projectDetailViewHeight - ( _controlSpacer * 2 ) )nibview _newProjectView,      @"NewProjectView",,      ( _tableViewWidth + ( _controlSpacer * 2 ), _mainWindowHeight - _welcomeViewHeight - ( _controlSpacer * 2 ) )nibview _alsProjectView,      @"ALSProjectView",,      ( _tableViewWidth + ( _controlSpacer * 2 ), _mainWindowHeight - _welcomeViewHeight - ( _controlSpacer * 2 ) )nibview _projectSettingsView, @"ProjectSettingsView",, ( _tableViewWidth + ( _controlSpacer * 2 ), _mainWindowHeight - _welcomeViewHeight - ( _controlSpacer * 2 ) )// Init Toolbar and Viewsnibtoolbar _mainToolbar, @"Toolbar"WindowSetToolbar( _window, _mainToolbar )// every page fills the area beside the entity list and resizes with the windowfn FitOwnHeadingView( _welcomeView )fn FitOwnHeadingView( _projectCreateView )fn FitPageView( _projectDetailView )fn FitPageView( _newProjectView )fn FitPageView( _alsProjectView )fn FitPageView( _projectSettingsView )   // after the toolbar: it changes the content area// the design row of the entity view, under its summary (Project Actions.incl): the selected// attribute's control, the entity's Form layout, the entity's icon and its previewr = fn ViewBounds( _projectDetailView )// the Control popup's items are rebuilt for each attribute, so the first one names the recommendationpopupbutton _controlPopup, NO, 0, @[ @"Control: choose an attribute" ], fn CGRectMake( 12, r.size.height - 78, 230, 28 ), NO, _windowViewAddSubview( _projectDetailView, _controlPopup )ViewSetAutoresizingMask( _controlPopup, NSViewMaxXMargin + NSViewMinYMargin )ViewSetToolTip( _controlPopup, @"The control the selected attribute has on the generated Form." )popupbutton _formColumnsPopup, YES, 0, @[ @"Form: automatic", @"Form: 1 column", @"Form: 2 columns", @"Form: 3 columns" ], fn CGRectMake( 252, r.size.height - 78, 170, 28 ), NO, _windowViewAddSubview( _projectDetailView, _formColumnsPopup )ViewSetAutoresizingMask( _formColumnsPopup, NSViewMaxXMargin + NSViewMinYMargin )ViewSetToolTip( _formColumnsPopup, @"How many columns of fields the generated Form has. Automatic: 1 up to 10 fields, 2 up to 24, then 3." )imageview _entityIconPreview, YES, NULL, fn CGRectMake( 436, r.size.height - 74, 22, 22 ), NSImageScaleProportionallyUpOrDown, , , _windowViewAddSubview( _projectDetailView, _entityIconPreview )ViewSetAutoresizingMask( _entityIconPreview, NSViewMaxXMargin + NSViewMinYMargin )popupbutton _entityIconPopup, YES, 0, @[ @"Icon" ], fn CGRectMake( 464, r.size.height - 78, 230, 28 ), NO, _windowViewAddSubview( _projectDetailView, _entityIconPopup )ViewSetAutoresizingMask( _entityIconPopup, NSViewMaxXMargin + NSViewMinYMargin )ViewSetToolTip( _entityIconPopup, @"The entity's icon on its button in the generated app's navigation bar (an SF Symbol)." )// a complex control's settings, under the design row: shown only for the attribute that has one (an Auto-complete)textlabel _acSettingsLabel, @"Auto-complete:", fn CGRectMake( 14, r.size.height - 111, 100, 16 ), _windowViewAddSubview( _projectDetailView, _acSettingsLabel )ViewSetAutoresizingMask( _acSettingsLabel, NSViewMaxXMargin + NSViewMinYMargin )popupbutton _acDisplayPopup, YES, 0, @[ @"Show: name" ], fn CGRectMake( 112, r.size.height - 116, 230, 28 ), NO, _windowViewAddSubview( _projectDetailView, _acDisplayPopup )ViewSetAutoresizingMask( _acDisplayPopup, NSViewMaxXMargin + NSViewMinYMargin )ViewSetToolTip( _acDisplayPopup, @"The related record's field the user sees and types to find it (the key is stored behind the scenes)." )popupbutton _acMinCharsPopup, YES, 0, @[ @"After 1 letter", @"After 2 letters", @"After 3 letters" ], fn CGRectMake( 350, r.size.height - 116, 150, 28 ), NO, _windowViewAddSubview( _projectDetailView, _acMinCharsPopup )ViewSetAutoresizingMask( _acMinCharsPopup, NSViewMaxXMargin + NSViewMinYMargin )ViewSetToolTip( _acMinCharsPopup, @"How many letters the user types before the matches appear." )popupbutton _acMaxPopup, YES, 1, @[ @"Up to 5 results", @"Up to 8 results", @"Up to 12 results", @"Up to 20 results" ], fn CGRectMake( 508, r.size.height - 116, 170, 28 ), NO, _windowViewAddSubview( _projectDetailView, _acMaxPopup )ViewSetAutoresizingMask( _acMaxPopup, NSViewMaxXMargin + NSViewMinYMargin )ViewSetToolTip( _acMaxPopup, @"The most matches the list shows at once." )button _acOthersCheck, YES, NSControlStateValueOn, @"Allow other values", fn CGRectMake( 688, r.size.height - 112, 170, 20 ), NSButtonTypeSwitch, NSBezelStyleRegularSquare, _windowViewAddSubview( _projectDetailView, _acOthersCheck )ViewSetAutoresizingMask( _acOthersCheck, NSViewMaxXMargin + NSViewMinYMargin )ViewSetToolTip( _acOthersCheck, @"Local values: keep what the user types even when it is not in the Values list." )ViewSetHidden( _acSettingsLabel, YES ) : ViewSetHidden( _acDisplayPopup, YES ) : ViewSetHidden( _acMinCharsPopup, YES ) : ViewSetHidden( _acMaxPopup, YES ) : ViewSetHidden( _acOthersCheck, YES )// the crumb trail along the top, the heading under it (Menus.incl, StudioUpdateCrumbs): its// buttons and chevrons are made once here, then titled, placed and shown as the developer moves.// Both run across the whole window, the entity list below them (author, 2026-11-28).heading = fn ViewFrame( _projectHeadingName )heading.size.width = heading.size.width + heading.origin.x - _controlSpacerheading.origin.x = _controlSpacergStudioCrumbLeft   = heading.origin.x - 4gStudioCrumbBottom = heading.origin.y + heading.size.height - _crumbHeightfor i = 0 to _crumbMax - 1button _crumbButtonBase + i, YES, , @"", fn CGRectMake( gStudioCrumbLeft, gStudioCrumbBottom, 80, _crumbHeight ), NSButtonTypeMomentaryPushIn, NSBezelStyleRegularSquare, _windowButtonSetBordered( _crumbButtonBase + i, NO )ButtonSetImagePosition( _crumbButtonBase + i, NSImageLeft )ViewSetAutoresizingMask( _crumbButtonBase + i, NSViewMaxXMargin + NSViewMinYMargin )ViewSetHidden( _crumbButtonBase + i, YES )nextfor i = 0 to _crumbMax - 2imageview _crumbSeparatorBase + i, YES, fn ImageWithSystemSymbolName( @"chevron.right", @"then" ), fn CGRectMake( gStudioCrumbLeft, gStudioCrumbBottom + 4, 12, 14 ), NSImageScaleProportionallyDown, , , _windowViewSetAutoresizingMask( _crumbSeparatorBase + i, NSViewMaxXMargin + NSViewMinYMargin )ViewSetHidden( _crumbSeparatorBase + i, YES )nextheading.origin.y = heading.origin.y - _crumbTrailHeightViewSetFrame( _projectHeadingName, heading )gStudioHeadingLeft = heading.origin.xgStudioPageLeft = _tableViewWidth + _controlSpacer * 2     // the pages start beside the entity list (StudioLayoutForProject)// the open project's icon, left of its name (Project Workspace.incl, ProjectShowHeading): 32 points, centred on the textimageview _projectHeadingIcon, YES, NULL, fn CGRectMake( heading.origin.x + 2, heading.origin.y + ( heading.size.height - 32 ) / 2, 32, 32 ), NSImageScaleProportionallyUpOrDown, , , _windowViewSetAutoresizingMask( _projectHeadingIcon, NSViewMaxXMargin + NSViewMinYMargin )ViewSetHidden( _projectHeadingIcon, YES )// the Pages view (Professional): pages composed from entities, made in code (Page Designer.incl)view _pagesView, fn PageFrame, _windowViewSetAutoresizingMask( _pagesView, NSViewWidthSizable + NSViewHeightSizable )// the Licence page: information and buttons, made in code (Licence Window.incl)view _licenceView, fn PageFrame, _windowViewSetAutoresizingMask( _licenceView, NSViewWidthSizable + NSViewHeightSizable )ViewSetHidden( _licenceView, YES )ViewSetHidden( _pagesView, YES )// the entity list under the heading, above the footer; the black footer with the copyright, across the windowfn StudioLayoutFrame// set hiddenViewSetHidden( _welcomeView, NO )ViewSetHidden( _projectCreateView, YES )ViewSetHidden( _projectDetailView, YES )ViewSetHidden( _projectSettingsView, YES )ViewSetHidden( _licenceView, YES )ViewSetHidden( _pagesView, YES )ViewSetHidden( _newProjectView, YES )ViewSetHidden( _alsProjectView, YES )fn ApplyBranding                                            // the Imagery logo (Branding.incl)fn StudioCards                                              // the working areas as cards (Branding.incl)fn ProjectSettingsSetUp                                     // the logo well takes paste and dropfn ALSProjectSetUp                                          // the ALS project view's drop zone (a subclassed view)fn StudioPillButtons                                        // pill-shaped push buttons (Pill Buttons.incl)fn RecentProjectsShow                                       // Welcome view: Recent ProjectsResponderSetMenu( (ResponderRef)fn StudioFindView( _recentProjectsTable ), _mRecentContext )   // right-click a project (Menus.incl)ResponderSetMenu( (ResponderRef)fn StudioFindView( _objectTableView ), _mObjectContext )       // right-click an entityWindowMakeFirstResponder( _window, _createProjectCreateBtn )fn StudioUpdateCommands                                     // no project yet: only what applies (Menus.incl)end fnvoid local fn BuildWindownibwindow _window, @"MainWindow"WindowSetContentMinSize( _window, fn CGSizeMake( _minWindowWidth, _minWindowHeight ) )WindowCenter( _window )fn TableViewSetCustomCellCallback( _objectTableView, @[ID_KEY,OBJECT_KEY], @fn MyCustomCellCallback, NULL )fn TableViewSizeLastColumnToFit( _objectTableView )ViewSetAutoresizesSubviews( _windowContentViewTag, YES )   // View* functions take a view tag, not the window tagend fn