/* *   I M A G E R Y    B U S I N E S S     S Y S T E M S,   L L C * *   Edition.incl - which edition of the generated app the Studio can make * *       Lite        free and open source (this repository).  The app opens the project's *                   SQLite database itself and runs the business rules in the app *                   (LogicBank for FutureBasic).  Runtime: App Data Lite.incl. *       Enterprise  paid.  A true three-tier app: this app, an API Logic Server (open *                   source, the same for everyone) with the rules on the server, and the *                   database.  Runtime: App Data Enterprise.incl. * *   This file is the open, Lite-only version.  The Enterprise build replaces it with its *   own Edition.incl (a private repository) that offers Enterprise when its licence is *   valid, and adds the Enterprise runtime files.  Everything else in the Studio - the *   screens, bindings, pages, the shell - is the same in both editions. * *   Design: docs/design/Editions and Licensing.md */#define EDITION_LITE        @"lite"#define EDITION_ENTERPRISE  @"enterprise"// can this Studio generate Enterprise apps?  When the licence includes them (Licence.incl)local fn EditionEnterpriseAvailable as BOOLend fn = fn LicenceAllows( _licenceFeatureEnterpriseRuntime )// the edition a project's app is generated as: Project.json "edition", Lite when absentlocal fn EditionOfProject( projectDict as CFDictionaryRef ) as CFStringRefCFStringRef edition = fn DictionaryObjectForKey( projectDict, @"edition" )if ( edition == NULL ) then exit fn = EDITION_LITEif ( fn StringIsEqual( edition, EDITION_ENTERPRISE ) && fn EditionEnterpriseAvailable ) then exit fn = EDITION_ENTERPRISEend fn = EDITION_LITE// for the user: the edition, in a few wordslocal fn EditionDescription( edition as CFStringRef ) as CFStringRefif ( fn StringIsEqual( edition, EDITION_ENTERPRISE ) ) then exit fn = @"Enterprise - an API Logic Server client (three-tier)"end fn = @"Lite - SQLite in the app, rules in the app (free and open source)"// the runtime files that give the app its data: copied into the project, in build orderlocal fn EditionDataRuntimeFiles( edition as CFStringRef ) as CFArrayRefend fn = @[ @"Data SQLite.incl", @"DataObject.glbl", @"DataObject_Super.incl", @"DataObject.incl", @"Data Model.incl", @"Data Records.incl", @"Logic Rules.incl", @"Logic Row.incl", @"Logic Engine.incl", @"App Data Lite.incl" ]// the main program's start-up for the edition: how the app reaches its datalocal fn EditionMainStart( edition as CFStringRef, hostURL as CFStringRef, userName as CFStringRef ) as CFStringRefCFMutableStringRef s = fn MutableStringNewMutableStringAppendString( s, @"// the data: the project's SQLite database, with the business rules in this app (Lite edition)\n" )MutableStringAppendString( s, @"fn DataOpen( NULL )                    // the project's SQLite database (Model.json)\n" )MutableStringAppendString( s, @"fn DeclareStudioRules                  // Studio Rules.incl (generated from Rules.json)\n" )MutableStringAppendString( s, @"fn DeclareRules                        // Rules.incl (yours)\n" )MutableStringAppendString( s, @"fn LogicActivate                       // saves go through LogicInsert / LogicUpdate / LogicDelete\n" )end fn = s// do the business rules run in the app?  Lite: yes (LogicBank for FutureBasic, Rules.incl)local fn EditionRulesInApp( edition as CFStringRef ) as BOOLend fn = fn StringIsEqual( edition, EDITION_LITE )// why a project cannot be generated as an app in this edition (NULL when it can)local fn EditionRefusal( edition as CFStringRef, hasDatabase as BOOL ) as CFStringRefif ( hasDatabase ) then exit fn = NULLend fn = @"This project's model comes from an API Logic Server, and an app that talks to the server is the Enterprise edition. For a Lite app, create a project from the server's SQLite database (New Project), which gives the same model."