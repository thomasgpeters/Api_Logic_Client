/* *   Licence Security.incl - the few Security framework calls the licence needs, declared here * *   The licence (Licence.incl) checks its ES256 signature (SecKey) and keeps itself in the Keychain (SecItem). FutureBasic's *   own "Tlbx Security.incl" has these, but it only arrived in 2026 (FB's Headers, dated 2026-05-05), so a FutureBasic *   without it stops at "Missing or invalid source file ... error 1234". These declarations are our own, written from *   Apple's Security headers: they build with any FutureBasic. Do not include FB's Tlbx Security.incl as well. * *   MIT License. Copyright (c) 2026 Imagery Business Systems, LLC. */include library "Security"BeginCDeclaration#import <Security/Security.h>EndC#define SecKeyRef as ptr#define SecKeyAlgorithm as CFStringRef// keys (SecKey.h, SecItem.h)system CFStringRef kSecAttrKeyTypesystem CFStringRef kSecAttrKeyClasssystem CFStringRef kSecAttrKeySizeInBitssystem CFStringRef kSecAttrKeyTypeECSECPrimeRandomsystem CFStringRef kSecAttrKeyClassPublicsystem SecKeyAlgorithm kSecKeyAlgorithmECDSASignatureMessageX962SHA256toolbox fn SecKeyCreateWithData( CFDataRef keyData, CFDictionaryRef attributes, CFErrorRef *error ) = SecKeyReftoolbox fn SecKeyVerifySignature( SecKeyRef key, SecKeyAlgorithm algorithm, CFDataRef signedData, CFDataRef signature, CFErrorRef *error ) = Boolean// the Keychain (SecItem.h, SecBase.h)system CFStringRef kSecClasssystem CFStringRef kSecClassGenericPasswordsystem CFStringRef kSecAttrServicesystem CFStringRef kSecAttrAccountsystem CFStringRef kSecAttrLabelsystem CFStringRef kSecValueDatasystem CFStringRef kSecReturnDatasystem CFStringRef kSecMatchLimitsystem CFStringRef kSecMatchLimitOnesystem OSStatus errSecSuccesstoolbox fn SecItemCopyMatching( CFDictionaryRef query, CFTypeRef *result ) = OSStatustoolbox fn SecItemAdd( CFDictionaryRef attributes, CFTypeRef *result ) = OSStatustoolbox fn SecItemDelete( CFDictionaryRef query ) = OSStatus