/* *   I M A G E R Y    B U S I N E S S     S Y S T E M S,   L L C * *   Open ALS Project.incl - the API Logic Server Project view (ALSProjectView.xib) * *   A project from the model API Logic Server generated.  The developer points at the ALS *   project - its folder, its model file, or a public GitHub repository - in one of four ways: *       type or paste the path or address, then Read (or Return) *       Folder...      the project's folder (a clone of its repository) *       Model File...  database/models.py (or app_model.yaml / admin.yaml) *       drop           the folder or the file onto the drop zone (a subclassed view, made in *                      code: ALSProjectSetUp) *   The view shows what the model holds; Create keeps a copy in <project>/ALS Model/ and *   opens the project from it (Project Actions.incl: LoadALSModel).  The API Server is where the *   generated app finds the API (Project.json "baseURL"). * *   ALS Project.incl finds and reads the model; ALS Model.incl parses it. */#define ALS_DROP_TOP        214     // the drop zone: from the view's top (ALSProjectView.xib)#define ALS_DROP_LEFT       160#define ALS_DROP_RIGHT      52      // ... and from its right#define ALS_DROP_HEIGHT     56// once, when the views are built (Windows.incl): the drop zone over the XIB's boxvoid local fn ALSProjectSetUpCGRect r = fn ViewBounds( _alsProjectView )subclass view _alsDropZone, fn CGRectMake( ALS_DROP_LEFT, r.size.height - ALS_DROP_TOP - ALS_DROP_HEIGHT, r.size.width - ALS_DROP_LEFT - ALS_DROP_RIGHT, ALS_DROP_HEIGHT ), _windowViewAddSubview( _alsProjectView, _alsDropZone )ViewSetAutoresizingMask( _alsDropZone, NSViewWidthSizable + NSViewMinYMargin )ViewRegisterForDraggedFileTypes( _alsDropZone, NULL )      // folders and files of any kind: the model is told by its contentsViewSetToolTip( _alsDropZone, @"Drop the ALS project's folder, or its database/models.py, app_model.yaml or admin.yaml." )end fnvoid local fn ShowOpenALSProjectViewSetHidden( _welcomeView, YES )ViewSetHidden( _projectCreateView, YES )ViewSetHidden( _projectDetailView, YES )ViewSetHidden( _projectSettingsView, YES )ViewSetHidden( _newProjectView, YES )ViewSetHidden( _alsProjectView, NO )fn ALSProjectForgetControlSetStringValue( _alsNameEdit, @"" )ControlSetStringValue( _alsSourceField, @"" )ControlSetStringValue( _alsSummaryLabel, @"" )ControlSetStringValue( _alsDropLabel, @"Drop the ALS project folder or its model file here" )if ( fn StringLength( fn ControlStringValue( _alsServerEdit ) ) == 0 ) then ControlSetStringValue( _alsServerEdit, ALS_DEFAULT_SERVER )ControlSetEnabled( _alsCreateBtn, NO )WindowMakeFirstResponder( _window, _alsSourceField )end fn// show what was read - or why nothing was - and suggest the project's namevoid local fn OpenALSShowResult( found as BOOL, address as CFStringRef )CFMutableStringRef summaryif ( found == NO )ControlSetStringValue( _alsSummaryLabel, fn StringWithFormat( @"No API Logic Server model at %@. Point at the ALS project's folder (it has database/models.py), at the model file itself, or at a public GitHub repository (https://github.com/owner/repo).", address ) )ControlSetEnabled( _alsCreateBtn, NO )exit fnend ifsummary = fn MutableStringWithString( fn ALSProjectSummary( fn ALSModelFromText( gALSProjectModelText ) ) )MutableStringAppendFormat( summary, @"\nFrom %@ (%@", gALSProjectSource, gALSProjectModelName )if ( gALSProjectAdminText != NULL ) then MutableStringAppendString( summary, @", with admin.yaml for the columns that name records" )MutableStringAppendString( summary, @")" )ControlSetStringValue( _alsSummaryLabel, summary )ControlSetStringValue( _alsDropLabel, fn StringWithFormat( @"%@ - drop another to replace it", gALSProjectModelName ) )if ( fn StringLength( fn ControlStringValue( _alsNameEdit ) ) == 0 ) then ControlSetStringValue( _alsNameEdit, fn ALSProjectSuggestedName( address ) )ControlSetEnabled( _alsCreateBtn, YES )WindowMakeFirstResponder( _window, _alsNameEdit )end fn// Read (or Return in the field): the path or address typed or pastedvoid local fn OpenALSReadCFStringRef address = fn ControlStringValue( _alsSourceField )if ( fn StringLength( address ) == 0 ) then exit fnfn OpenALSShowResult( fn ALSProjectRead( address ), address )end fn// a folder or file chosen or dropped: into the field, then readvoid local fn OpenALSUseURL( url as CFURLRef )if ( url == NULL ) then exit fnControlSetStringValue( _alsSourceField, fn URLPath( url ) )fn OpenALSReadend fnvoid local fn OpenALSChooseFolderCFURLRef urlOpenPanelSetCanChooseDirectories( 1, YES )OpenPanelSetCanChooseFiles( 1, NO )url = openpanel 1, @"Choose the API Logic Server project's folder", , @"Choose"fn OpenALSUseURL( url )end fnvoid local fn OpenALSChooseFileCFURLRef url = openpanel 1, @"Choose the ALS project's model file: database/models.py (or ui/app/app_model.yaml, ui/admin/admin.yaml)", ALS_MODEL_FILE_TYPESfn OpenALSUseURL( url )end fn// files dropped on the drop zone (DialogEventArray): the first onevoid local fn OpenALSDropped( urls as CFArrayRef )if ( urls == NULL ) then exit fnif ( fn ArrayCount( urls ) == 0 ) then exit fnfn OpenALSUseURL( fn ArrayFirstObject( urls ) )end fn// Create: keep a copy of the model in the project, open the project from itvoid local fn OpenALSCreateCFStringRef     name = fn ControlStringValue( _alsNameEdit )CFStringRef     server = fn ControlStringValue( _alsServerEdit )CFURLRef        existingURL, modelURLNSModalResponse responseif ( gALSProjectModelText == NULL ) then fn OpenALSRead                 // typed, then Create without Readif ( gALSProjectModelText == NULL ) then exit fnif ( fn StringLength( name ) == 0 )alert 1, NSAlertStyleInformational, @"Name the project.", @"The name is used for its workspace folder and the generated app.", @[@"OK"], NOexit fnend ifexistingURL = fn URLByAppendingPathComponent( fn ProjectFolderURLNamed( name ), PROJECT_SETTINGS_FILE )if ( fn FileManagerFileExistsAtURL( existingURL ) )response = alert 1, NSAlertStyleWarning, fn StringWithFormat( @"A project named %@ already exists.", name ), @"Open it with this model (its copy of the model is replaced), or choose another name.", @[@"Open It", @"Cancel"]if ( response != NSAlertFirstButtonReturn ) then exit fnend ifmodelURL = fn ALSProjectKeepCopy( name )if ( modelURL == NULL )alert 1, NSAlertStyleWarning, @"Could not keep a copy of the model in the project.", fn URLPath( fn ProjectFolderURLNamed( name ) ), @[@"OK"], NOexit fnend if// a fresh start: the new name and server, no About text carried overControlSetStringValue( _projectNameEdit, name )if ( fn StringLength( server ) == 0 ) then server = ALS_DEFAULT_SERVERControlSetStringValue( _baseURLEdit, server )ControlSetStringValue( _authNameEdit, @"" )ControlSetStringValue( _aboutTextEdit, @"" )ControlSetStringValue( _taglineEdit, @"" )ControlSetStringValue( _copyrightEdit, @"" )ImageViewSetImage( _logoImageWell, NULL )MutableDictionarySetObjectForKey( gProjectDictionary, gALSProjectSource, @"alsSource" )ViewSetHidden( _alsProjectView, YES )if ( fn LoadALSModel( modelURL ) == NO ) then ViewSetHidden( _alsProjectView, NO )end fn// the older route: a running server's /metadata (no relationships)void local fn OpenALSUseRunningServerViewSetHidden( _alsProjectView, YES )fn NewProjectUseALSend fnvoid local fn OpenALSCancelViewSetHidden( _alsProjectView, YES )fn ShowWelcomeend fn