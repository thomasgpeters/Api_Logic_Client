/* *   Studio for FB.main - the Studio's main program: the window, its views and the menus, the event handlers, *   the open project's globals kept, then the event loop */fn BuildWindowfn BuildSubViewsfn BuildMenuon appevent fn DoAppEvent // assign application event handler functionon menu     fn DoMenu     // assign menu event handler functionon dialog   fn DoDialog   // assign window/control event handler functiongProjectDictionary = (CFMutableDictionaryRef)fn LicenceKept( fn MutableDictionaryNew, gProjectDictionary )   // kept: a global does not keep its value alive (Licence.incl)projectName = (CFMutableStringRef)fn LicenceKept( fn MutableStringNew, projectName )HandleEvents