/* *   Project Settings.incl * *   The Project Settings view (ProjectSettingsView.xib, Project > Project Settings...): *   what is deployed with the generated app beyond the model.  Today: the About *   text (at most ABOUT_TEXT_MAX characters), which becomes the app's Credits.rtf - *   the standard About box shows it under the app's name, icon and version. *   Branding for the app's header and footer (App Shell.incl in the generated app): *   the app icon (paste or drag a picture into the well; kept as <project>/Branding/logo.png, *   deployed as AppLogo.png: the header, the Dock and the About box show it), or without a *   picture an SF Symbol (appSymbol, the header only), the tag-line under the app's *   name (at most TAGLINE_TEXT_MAX characters) and the footer's copyright. *   Saved in Project.json (Project Workspace.incl). */void local fn ProjectSettingsShowCountControlSetStringValue( _aboutCountLabel, fn StringWithFormat( @"%ld / %d", (long)fn StringLength( fn ControlStringValue( _aboutTextEdit ) ), ABOUT_TEXT_MAX ) )end fn// typing in the About text: keep it within the limit, update the countervoid local fn AboutTextChangedCFStringRef about = fn ControlStringValue( _aboutTextEdit )if ( fn StringLength( about ) > ABOUT_TEXT_MAX )ControlSetStringValue( _aboutTextEdit, fn StringSubstringToIndex( about, ABOUT_TEXT_MAX ) )beepend iffn ProjectSettingsShowCountend fn// the icon well takes a pasted or dropped picture (Edit > Paste needs the Edit menu); beside it,// the symbol for an app without a picture (placed from the view's top: its XIB items keep theirs)void local fn ProjectSettingsSetUpCGRect r = fn ViewBounds( _projectSettingsView )ImageViewSetEditable( _logoImageWell, YES )ImageViewSetAllowsCutCopyPaste( _logoImageWell, YES )textlabel _appSymbolLabel, @"Without a picture, the symbol:", fn CGRectMake( 44, r.size.height - 430, 190, 16 ), _windowViewAddSubview( _projectSettingsView, _appSymbolLabel )ViewSetAutoresizingMask( _appSymbolLabel, NSViewMaxXMargin + NSViewMinYMargin )popupbutton _appSymbolPopup, YES, 0, fn TypeMapIconChoices, fn CGRectMake( 236, r.size.height - 436, 220, 28 ), NO, _windowViewAddSubview( _projectSettingsView, _appSymbolPopup )ViewSetAutoresizingMask( _appSymbolPopup, NSViewMaxXMargin + NSViewMinYMargin )imageview _appSymbolPreview, YES, NULL, fn CGRectMake( 464, r.size.height - 432, 22, 22 ), NSImageScaleProportionallyUpOrDown, , , _windowViewAddSubview( _projectSettingsView, _appSymbolPreview )ViewSetAutoresizingMask( _appSymbolPreview, NSViewMaxXMargin + NSViewMinYMargin )fn ProjectAppSymbolChosenend fn// typing a tag-line: keep it within the limitvoid local fn TaglineTextChangedCFStringRef tagline = fn ControlStringValue( _taglineEdit )if ( fn StringLength( tagline ) > TAGLINE_TEXT_MAX )ControlSetStringValue( _taglineEdit, fn StringSubstringToIndex( tagline, TAGLINE_TEXT_MAX ) )beepend ifend fnvoid local fn ShowProjectSettingsif ( fn DictionaryObjectForKey( gProjectDictionary, @"resources" ) == NULL )alert 1, NSAlertStyleInformational, @"No project is open.", @"Open a project or a model first.", @[@"OK"], NOexit fnend ifViewSetHidden( _welcomeView, YES )ViewSetHidden( _projectCreateView, YES )ViewSetHidden( _projectDetailView, YES )ViewSetHidden( _projectSettingsView, NO )ViewSetHidden( _licenceView, YES )ViewSetHidden( _pagesView, YES )fn ProjectSettingsShowCountWindowMakeFirstResponder( _window, _aboutTextEdit )end fn// Done: save and go back to the entity definitionsvoid local fn ProjectSettingsDonefn ProjectSettingsSaveViewSetHidden( _projectSettingsView, YES )ViewSetHidden( _licenceView, YES )ViewSetHidden( _pagesView, YES )ViewSetHidden( _projectDetailView, NO )fn ProjectShowHeading( NO )                 // the icon may have changedend fn