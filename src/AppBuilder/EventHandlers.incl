void local fn MyCustomCellCallback( tag as long, identifier as CFStringRef, row as NSInteger, vw as CFTypeRef, userData as ptr )CFDictionaryRef dict = fn ArrayObjectAtIndex( fn TableViewData( tag ), row )select ( fn ViewTag( vw ) )case _tableCheckboxButtonSetState( vw, fn NumberIntegerValue( fn DictionaryObjectForKey( dict, identifier ) ) )case _tablePopUpPopUpButtonSelectItemAtIndex( vw, fn NumberIntegerValue( fn DictionaryObjectForKey( dict, identifier ) ) )case _tableRatingControlSetIntegerValue( vw, fn NumberIntegerValue( fn DictionaryObjectForKey( dict, identifier ) ) )end selectend fnvoid local fn ShowdProjectCreateViewViewSetHidden( _welcomeView, YES )ViewSetHidden( _projectCreateView, NO )WindowMakeFirstResponder( _window, _projectNameEdit )// ButtonSetKeyEquivalent( _createProjectCreateBtn, @"insertLineBreak:" )end fnvoid local fn NextView ( wnd as long, tag as long )CFStringRef eventStr = fn DialogEventString// ProjectCreateView// _projectNameEdit// _baseURLEdit// _authNameEdit// _authPasswordEdit// Keyboard Event Strings// insertNewLine: 			return key// insertLineBreak:			ctrl-return key// insertTab:					tab key// insertBackTab:			shift tab keyif (isLoggingOn) then NSLog( @"%@ key for %i !", eventStr, tag )select case eventStrcase @"insertNewline:", @"insertTab:"select case tagcase _projectNameEdit		: WindowMakeFirstResponder( _window, _baseURLEdit )case _baseURLEdit				: WindowMakeFirstResponder( _window, _authNameEdit )case _authNameEdit				: WindowMakeFirstResponder( _window, _authPasswordEdit )case _authPasswordEdit		: WindowMakeFirstResponder( _window, _projectNameEdit )end selectcase @"insertBacktab:"select case tagcase _projectNameEdit		: WindowMakeFirstResponder( _window, _authPasswordEdit )case _baseURLEdit				: WindowMakeFirstResponder( _window, _projectNameEdit )case _authNameEdit				: WindowMakeFirstResponder( _window, _baseURLEdit )case _authPasswordEdit		: WindowMakeFirstResponder( _window, _authNameEdit )end selectcase @"insertLineBreak:"			: fn GrabProjectDetails : fn ProjectMetadataAPI(@"/metadata?include=attributes")end selectend fn// application events arrive herevoid local fn DoAppEvent( ev as long )select ( ev )case _appWillFinishLaunching// app is about to finish launching - build menu and window// gProjectDictionary = fn MutableDictionaryNew// fn URLSessionAuthAPI(@"/api/authentication-User/login")case _appDidFinishLaunchingfn StudioLibraryReady          // first launch: the runtime and templates into the workspace (Studio Library.incl)fn LicenceStart                // the licence from the Keychain; without one, the Licence window (Licence Window.incl)case _appShouldTerminateAfterLastWindowClosedAppEventSetBool( YES )// tell the runtime we can quitend selectend fn// menu events arrive here (Menus.incl builds the menus and enables what applies)void local fn DoMenu( menuID as long, itemID as long )select ( menuID )case _mApplicationfn LicenceMenu( itemID )case _mProjectselect ( itemID )case _iNewProject			: fn ShowNewProjectcase _iNewALSProject		: if ( fn LicenceGate( _licenceFeatureALSProjects, @"A project from API Logic Server" ) ) then fn ShowOpenALSProjectcase _iOpenProject			: fn OpenProjectcase _iRecentProjects		: fn ShowWelcomecase _iEntityDefinitions	: fn ShowEntityDefinitionscase _iClearRecentProjects	: fn RecentProjectsClearcase _iCloseProject			: fn ProjectClosecase _iProjectSettings		: fn ShowProjectSettingscase _iShowProjectInFinder	: fn ShowWorkspaceInFindercase _iDeleteProject		: fn ProjectDeleteend selectcase _mModelselect ( itemID )case _iOpenSQLite			: fn OpenSQLiteDatabasecase _iOpenMetadata			: if ( fn LicenceGate( _licenceFeatureALSProjects, @"API Logic Server metadata" ) ) then fn OpenMetadataFilecase _iShowModelDiagram		: fn ErdShowcase _iImportRules			: if ( fn LicenceGate( _licenceFeatureRulesExchange, @"Importing rules from declare_logic.py" ) ) then fn RulesImportcase _iExportRules			: if ( fn LicenceGate( _licenceFeatureRulesExchange, @"Exporting rules to declare_logic.py" ) ) then fn RulesExportend selectcase _mGenerateif ( itemID == _iGenerateApp || itemID == _iGenerateXIBs || itemID == _iGenerateXIB || itemID == _iGenerateBinding )if ( fn LicenceGate( _licenceFeatureCore, @"Generating" ) == NO ) then exit fnend ifselect ( itemID )case _iGenerateApp			: fn GenerateProjectParts( _genApp )case _iGenerateXIBs			: fn GenerateProjectParts( _genXIBs )case _iGenerateXIB			: fn GenerateProjectParts( _genXIB )case _iGenerateBinding		: fn GenerateProjectParts( _genBinding )case _iShowGeneratedApp		: fn ShowGeneratedAppInFindercase _iUpdateLibrary		: fn StudioLibraryUpdatecase _iOpenOneXib			: fn OpenXibFileAsXMLDocumentend selectcase _mHelpselect ( itemID )case _iStudioHelp			: fn StudioShowHelpcase _iShowWorkspace		: fn StudioShowWorkspaceend selectend selectfn StudioUpdateCommands                                      // a command can change what appliesend fn// a crumb was clicked: the action kept beside it (StudioCrumb)void local fn StudioCrumbClicked( index as long )CFStringRef action = @""if ( gStudioCrumbActions != NULL ) then if ( index >= 0 && index < fn ArrayCount( gStudioCrumbActions ) ) then action = fn ArrayObjectAtIndex( gStudioCrumbActions, index )if (isLoggingOn) then NSLog( @"Crumb %ld clicked: %@", index, action )if ( fn StringIsEqual( action, @"projects" ) ) then fn ShowWelcomeif ( fn StringIsEqual( action, @"entities" ) ) then fn ShowEntityDefinitionsend fn// window and control events arrive herevoid local fn DoDialog( ev as long, tag as long, wnd as long )if ( fn LicenceWindowHandles( ev, tag ) ) then exit fn        // the Licence window's buttons (Licence Window.incl)select ( ev )case _viewPerformDragOperation// the ALS project's folder or model file dropped on the drop zone (Open ALS Project.incl)if ( tag == _alsDropZone ) then fn OpenALSDropped( fn DialogEventArray )case _tableViewCellTextDidEndEditing// the designer adjusted a recommendation in the entity-definition tableif ( tag == _attributeTableView ) then fn DesignCellEdited( fn TableViewEventRow( tag ), fn TableViewEventColumnIdentifier( tag ), fn TableViewEventCellString( tag ) )case _tableViewDoubleAction// a double-click in the Welcome view's Recent Projects opens that projectif ( tag == _recentProjectsTable ) then fn OpenRecentProject( fn TableViewClickedRow( tag ) )case _tableViewSelectionDidChange//SegmentedControlSetSegmentEnabled( _addRemoveSegment, _removeContactSegmentItem, ( fn TableViewSelectedRow( whichTag ) != -1 ))select case ( tag )case _attributeTableViewfn DisplayAttributeControl                                   // the Control popup follows the selected attributecase _objectTableView// identifier = fn DictionaryObjectForKey( fn ArrayObjectAtIndex( fn TableViewData( _objectTableView ), fn TableViewSelectedRow( _objectTableView )), @"ID" )fn DisplayObjectDetails ( gProjectDictionary, fn TableViewSelectedRow( _objectTableView ) )//if (isLoggingOn) then NSLog( @"Clicked Row %i ", fn TableViewSelectedRow( _objectTableView ) )//if (isLoggingOn) then NSLog( @"Clicked Table View %@ ", identifier )//resultsDictionaryRef = fn GetPersonByIDRecord( identifier )//fn PopulatePersonView( resultsDictionaryRef )//resultsDictionaryRef = fn GetAddressesByPersonIDRecord( identifier )//fn PopulateAddressesView( resultsDictionaryRef )//resultsDictionaryRef = fn GetContactsByPersonIDRecord( identifier )//fn PopulateContactsView( resultsDictionaryRef )end selectfn StudioUpdateCommands                                      // an entity or attribute selected (or not)case _controlDoCommandBySelectorselect ( wnd )case _windowfn NextView (wnd, tag )end selectcase _textFieldDidChangeselect ( tag )case _projectNameEdit	: fn ValidateRequiredValuescase _baseURLEdit 			: fn ValidateRequiredValuescase _authNameEdit		 	: fn ValidateRequiredValuescase _authPasswordEdit	: fn ValidateRequiredValuescase _aboutTextEdit		: fn AboutTextChangedcase _taglineEdit		: fn TaglineTextChangedend selectcase _toolbarItemClickselect ( tag )case _tbProjects		: fn ShowWelcomecase _tbEntities		: fn ShowEntityDefinitionscase _tbDiagram			: fn ErdShowcase _tbGenerate		: if ( fn LicenceGate( _licenceFeatureCore, @"Generating" ) ) then fn GenerateProjectParts( _genApp )case _tbSettings		: fn ShowProjectSettingsend selectfn StudioUpdateCommandscase _btnClick// the crumb trail: back to Projects, or to the open project's definitions (Menus.incl)if ( tag >= _crumbButtonBase && tag < _crumbButtonBase + _crumbMax ) then fn StudioCrumbClicked( tag - _crumbButtonBase )select ( tag )case _createProjectCreateBtn	: fn ProjectMetadataAPI(@"/metadata?include=attributes") : fn InitProject ( gProjectDictionary )case _createProjectBtn				: fn ShowNewProject				// New Project: from a SQLite databasecase _newProjectChooseBtn			: fn NewProjectChooseDatabasecase _newProjectCreateBtn			: fn NewProjectCreatecase _newProjectCancelBtn			: fn NewProjectCancelcase _newProjectUseALSBtn			: if ( fn LicenceGate( _licenceFeatureALSProjects, @"A project from API Logic Server" ) ) then fn ShowOpenALSProject			// API Logic Server Project...case _alsReadBtn					: fn OpenALSReadcase _alsFolderBtn					: fn OpenALSChooseFoldercase _alsFileBtn					: fn OpenALSChooseFilecase _alsCreateBtn					: fn OpenALSCreatecase _alsCancelBtn					: fn OpenALSCancelcase _alsRunningServerBtn			: fn OpenALSUseRunningServercase _openProjectBtn					: fn OpenProjectcase _projectSettingsDoneBtn		: fn ProjectSettingsDonecase _createProjectCancelBtn		: fn ShowWelcome				// the ALS form's Cancelcase _formColumnsPopup				: fn DesignFormColumnsChosencase _controlPopup					: fn DesignControlChosencase _entityIconPopup				: fn DesignIconChosencase _appSymbolPopup				: fn ProjectAppSymbolChosenend selectfn StudioUpdateCommands                                      // a button can open or close a projectend selectend fn