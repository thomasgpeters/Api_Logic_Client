/* *   I M A G E R Y    B U S I N E S S     S Y S T E M S,   L L C * *   Pages Model.incl - the page designer's model (Professional edition): a project's pages, their parts and the *   associations between them, kept in <project>/Pages.json. The FB port of tools/pages_reference.py, which is the *   reference and holds the tests: the same names, the same JSON, the same order of proposals. *   Design: docs/design/Page Designer Design.md. * *       { "pages": [ { "title", "icon", "parts": [ { "entity", "display", "follows" } ], "links": [ ... ] } ] } *       display    detail | list | listDetail *       follows    null (the driver, or not linked), or an association to an earlier part: *                  { part, name, how, cardinality, relationship, fks, parentKeys, through } *       how        children | parent | same | through;  cardinality: oneToMany | manyToOne | oneToOne | manyToMany *       links      associations to other pages: { name, page, fromPart, how, cardinality, relationship, fks, *                  parentKeys, through } * *       PagesDefault( modelResources )                        one page per table, List with detail (the Lite edition's) *       PagesProposedLinks( modelResources, parts, entity )   the links an entity dropped on a page can have, proposed first *       PagesAssociations( modelResources, source, target )   the links a page dragged onto another can have, proposed first *       PagesDrop( modelResources, page, entity, display )    the part added with the proposed link; the links offered *       PagesCheck( modelResources, pages )                   what is wrong with the pages ([] when nothing) *       PagesLoad / PagesSave( pages )                   <project>/Pages.json * *   modelResources is the model's "resources" dictionary (SQLite Model.incl, ALS Model.incl): each table's keys and its *   relationships { name, direction (toone | tomany), resource, fks, parentKeys }. *   Logging: every NSLog is gated on isLoggingOn. */#define PAGES_FILE @"Pages.json"// a JSON null (a dictionary cannot hold NULL)local fn PagesNull as CFTypeRefcln return (__bridge CFTypeRef)[NSNull null];end fn = NULLlocal fn PagesIsNull( value as CFTypeRef ) as BOOLif ( value == NULL ) then exit fn = YESend fn = fn ObjectIsKindOfClass( (ObjectRef)value, fn ClassFromString( @"NSNull" ) )// the same columns, in any order (Python's set( a ) == set( b ))local fn PagesSameColumns( first as CFArrayRef, second as CFArrayRef ) as BOOLif ( first == NULL ) then first = @[]if ( second == NULL ) then second = @[]end fn = fn SetIsEqual( fn SetWithArray( first ), fn SetWithArray( second ) )// the model's tables (not its views), by namelocal fn PagesTables( modelResources as CFDictionaryRef ) as CFArrayRefCFMutableArrayRef names = fn MutableArrayNewCFArrayRef        allNames = fn DictionaryAllKeys( modelResources )CFStringRef       entityNamefor entityName in allNamesif ( fn StringIsEqual( fn DictionaryObjectForKey( fn DictionaryObjectForKey( modelResources, entityName ), @"kind" ), @"table" ) ) then MutableArrayAddObject( names, entityName )nextend fn = fn ArraySortedArrayUsingSelector( names, @"compare:" )local fn PagesRelationships( modelResources as CFDictionaryRef, entityName as CFStringRef ) as CFArrayRefCFArrayRef relationships = fn DictionaryObjectForKey( fn DictionaryObjectForKey( modelResources, entityName ), @"relationships" )if ( relationships == NULL ) then relationships = @[]end fn = relationships/* *   Tables that only join two others (EmployeeTerritories, Order Details): two foreign keys to two different tables *   whose columns are, together, the table's whole primary key. In table order: [ { table, first, second } ], first *   and second the two toone relationships. */local fn PagesJoinTables( modelResources as CFDictionaryRef ) as CFArrayRefCFMutableArrayRef found = fn MutableArrayNewCFMutableArrayRef toOnes, bothFksCFArrayRef        tableNames = fn PagesTables( modelResources )CFArrayRef        relationships, keysCFStringRef       tableNameCFDictionaryRef   relationship, first, secondfor tableName in tableNamestoOnes = fn MutableArrayNewrelationships = fn PagesRelationships( modelResources, tableName )for relationship in relationshipsif ( fn StringIsEqual( fn DictionaryObjectForKey( relationship, @"direction" ), @"toone" ) ) then MutableArrayAddObject( toOnes, relationship )nextkeys = fn DictionaryObjectForKey( fn DictionaryObjectForKey( modelResources, tableName ), @"keys" )if ( fn ArrayCount( toOnes ) == 2 && fn ArrayCount( keys ) > 0 )first  = fn ArrayObjectAtIndex( toOnes, 0 )second = fn ArrayObjectAtIndex( toOnes, 1 )if ( fn StringIsEqual( fn DictionaryObjectForKey( first, @"resource" ), fn DictionaryObjectForKey( second, @"resource" ) ) == NO )bothFks = fn MutableArrayWithArray( fn DictionaryObjectForKey( first, @"fks" ) )MutableArrayAddObjectsFromArray( bothFks, fn DictionaryObjectForKey( second, @"fks" ) )if ( fn PagesSameColumns( bothFks, keys ) ) then MutableArrayAddObject( found, @{ @"table":tableName, @"first":first, @"second":second } )end ifend ifnextend fn = found// an association's cardinality, from the source's current record to the target's recordslocal fn PagesCardinality( modelResources as CFDictionaryRef, how as CFStringRef, source as CFStringRef, target as CFStringRef, fks as CFArrayRef ) as CFStringRefif ( fn StringIsEqual( how, @"same" ) ) then exit fn = @"oneToOne"if ( fn StringIsEqual( how, @"through" ) ) then exit fn = @"manyToMany"if ( fn StringIsEqual( how, @"children" ) )// the target holds the foreign key: one source, many targets - unless the key is the target's whole keyif ( fn PagesSameColumns( fks, fn DictionaryObjectForKey( fn DictionaryObjectForKey( modelResources, target ), @"keys" ) ) ) then exit fn = @"oneToOne"exit fn = @"oneToMany"end if// parent: the source holds the foreign keyif ( fn PagesSameColumns( fks, fn DictionaryObjectForKey( fn DictionaryObjectForKey( modelResources, source ), @"keys" ) ) ) then exit fn = @"oneToOne"end fn = @"manyToOne"// the proposed name: "Customers to Orders", "Orders to Shippers (ShipVia)", "Employees to Territories (through// EmployeeTerritories)", "Orders, the same record" - the developer's to changelocal fn PagesAssociationName( source as CFStringRef, target as CFStringRef, how as CFStringRef, relationship as CFStringRef, fks as CFArrayRef, parentKeys as CFArrayRef ) as CFStringRefCFStringRef nameTextif ( fn StringIsEqual( how, @"same" ) ) then exit fn = fn StringWithFormat( @"%@, the same record", source )nameText = fn StringWithFormat( @"%@ to %@", source, target )if ( fn StringIsEqual( how, @"parent" ) || fn StringIsEqual( how, @"children" ) )if ( fn ArrayCount( fks ) == 1 && fn ArrayCount( parentKeys ) > 0 )// a role: Orders.ShipVia -> Shippers.ShipperIDif ( fn StringIsEqual( fn ArrayFirstObject( fks ), fn ArrayFirstObject( parentKeys ) ) == NO ) then nameText = fn StringWithFormat( @"%@ (%@)", nameText, fn ArrayFirstObject( fks ) )end ifend ifif ( fn StringIsEqual( how, @"through" ) ) then nameText = fn StringWithFormat( @"%@ (through %@)", nameText, relationship )end fn = nameText// one association offered: { part, name, how, cardinality, relationship, fks, parentKeys, through }local fn PagesLink( modelResources as CFDictionaryRef, partIndex as long, other as CFStringRef, entityName as CFStringRef, how as CFStringRef, relationship as CFStringRef, fks as CFArrayRef, parentKeys as CFArrayRef, through as CFDictionaryRef ) as CFMutableDictionaryRefCFMutableDictionaryRef link = fn MutableDictionaryNewCFTypeRef              relationshipValue = relationshipCFTypeRef              throughValue = throughif ( fks == NULL ) then fks = @[]if ( parentKeys == NULL ) then parentKeys = @[]if ( relationshipValue == NULL ) then relationshipValue = fn PagesNullif ( throughValue == NULL ) then throughValue = fn PagesNullMutableDictionarySetObjectForKey( link, fn NumberWithLong( partIndex ), @"part" )MutableDictionarySetObjectForKey( link, fn PagesAssociationName( other, entityName, how, relationship, fks, parentKeys ), @"name" )MutableDictionarySetObjectForKey( link, how, @"how" )MutableDictionarySetObjectForKey( link, fn PagesCardinality( modelResources, how, other, entityName, fks ), @"cardinality" )MutableDictionarySetObjectForKey( link, relationshipValue, @"relationship" )MutableDictionarySetObjectForKey( link, fks, @"fks" )MutableDictionarySetObjectForKey( link, parentKeys, @"parentKeys" )MutableDictionarySetObjectForKey( link, throughValue, @"through" )end fn = link/* *   The links an entity dropped on a page can have with the parts already there, the proposed one first. *   The parts in page order (the driver first); for each, the same entity (a Detail of the row chosen in a List), then *   the model's relationships in its order; then, after every direct one, many to many through a join table. *   Empty: no link (the part is not linked). */local fn PagesProposedLinks( modelResources as CFDictionaryRef, parts as CFArrayRef, entityName as CFStringRef ) as CFArrayRefCFMutableArrayRef links = fn MutableArrayNewCFMutableArrayRef indirect = fn MutableArrayNewCFArrayRef        relationships = fn PagesRelationships( modelResources, entityName )CFArrayRef        joins = fn PagesJoinTables( modelResources )CFDictionaryRef   part, relationship, joinEntry, fromRel, toRelCFStringRef       other, display, howlong              partIndex, sidefor partIndex = 0 to (long)fn ArrayCount( parts ) - 1part = fn ArrayObjectAtIndex( parts, partIndex )other = fn DictionaryObjectForKey( part, @"entity" )if ( fn StringIsEqual( other, entityName ) )// the same entity: a Detail of the row chosen in a List (a self-relationship, an employee's manager: later)display = fn DictionaryObjectForKey( part, @"display" )if ( fn StringIsEqual( display, @"list" ) || fn StringIsEqual( display, @"listDetail" ) ) then MutableArrayAddObject( links, fn PagesLink( modelResources, partIndex, other, entityName, @"same", NULL, @[], @[], NULL ) )elsefor relationship in relationshipsif ( fn StringIsEqual( fn DictionaryObjectForKey( relationship, @"resource" ), other ) )how = @"parent"if ( fn StringIsEqual( fn DictionaryObjectForKey( relationship, @"direction" ), @"toone" ) ) then how = @"children"MutableArrayAddObject( links, fn PagesLink( modelResources, partIndex, other, entityName, how, fn DictionaryObjectForKey( relationship, @"name" ), fn DictionaryObjectForKey( relationship, @"fks" ), fn DictionaryObjectForKey( relationship, @"parentKeys" ), NULL ) )end ifnextfor joinEntry in joinsfor side = 0 to 1fromRel = fn DictionaryObjectForKey( joinEntry, @"first" )toRel   = fn DictionaryObjectForKey( joinEntry, @"second" )if ( side == 1 )fromRel = fn DictionaryObjectForKey( joinEntry, @"second" )toRel   = fn DictionaryObjectForKey( joinEntry, @"first" )end ifif ( fn StringIsEqual( fn DictionaryObjectForKey( fromRel, @"resource" ), other ) && fn StringIsEqual( fn DictionaryObjectForKey( toRel, @"resource" ), entityName ) )MutableArrayAddObject( indirect, fn PagesLink( modelResources, partIndex, other, entityName, @"through", fn DictionaryObjectForKey( joinEntry, @"table" ), @[], @[], @{ @"table":fn DictionaryObjectForKey( joinEntry, @"table" ), @"fromFks":fn DictionaryObjectForKey( fromRel, @"fks" ), @"fromKeys":fn DictionaryObjectForKey( fromRel, @"parentKeys" ), @"toFks":fn DictionaryObjectForKey( toRel, @"fks" ), @"toKeys":fn DictionaryObjectForKey( toRel, @"parentKeys" ) } ) )end ifnextnextend ifnextMutableArrayAddObjectsFromArray( links, indirect )        // direct relationships first, then many to manyend fn = links/* *   The associations from page source to page target (a page dragged onto another): from any part of source to *   target's driver (the part that receives the record), the proposed one first - source's parts in page order, as *   PagesProposedLinks orders them, many to many last. Each: { name, fromPart, page, how, cardinality, relationship, *   fks, parentKeys, through }. Empty: the two pages have nothing in common. */local fn PagesAssociations( modelResources as CFDictionaryRef, source as CFDictionaryRef, target as CFDictionaryRef ) as CFArrayRefCFMutableArrayRef direct = fn MutableArrayNewCFMutableArrayRef indirect = fn MutableArrayNewCFArrayRef        sourceParts = fn DictionaryObjectForKey( source, @"parts" )CFArrayRef        targetParts = fn DictionaryObjectForKey( target, @"parts" )CFArrayRef        offeredCFDictionaryRef   part, linkCFMutableDictionaryRef associationCFStringRef       receiverlong              partIndexif ( fn ArrayCount( targetParts ) == 0 ) then exit fn = directreceiver = fn DictionaryObjectForKey( fn ArrayFirstObject( targetParts ), @"entity" )for partIndex = 0 to (long)fn ArrayCount( sourceParts ) - 1part = fn ArrayObjectAtIndex( sourceParts, partIndex )offered = fn PagesProposedLinks( modelResources, @[ @{ @"entity":fn DictionaryObjectForKey( part, @"entity" ), @"display":@"list" } ], receiver )for link in offeredassociation = fn MutableDictionaryWithDictionary( link )MutableDictionaryRemoveObjectForKey( association, @"part" )MutableDictionarySetObjectForKey( association, fn NumberWithLong( partIndex ), @"fromPart" )MutableDictionarySetObjectForKey( association, fn DictionaryObjectForKey( target, @"title" ), @"page" )if ( fn StringIsEqual( fn DictionaryObjectForKey( association, @"how" ), @"through" ) ) then MutableArrayAddObject( indirect, association ) else MutableArrayAddObject( direct, association )nextnextMutableArrayAddObjectsFromArray( direct, indirect )end fn = direct// a new page part: { entity, display, follows }local fn PagesPart( entityName as CFStringRef, display as CFStringRef, follows as CFTypeRef ) as CFMutableDictionaryRefCFMutableDictionaryRef part = fn MutableDictionaryNewif ( follows == NULL ) then follows = fn PagesNullMutableDictionarySetObjectForKey( part, entityName, @"entity" )MutableDictionarySetObjectForKey( part, display, @"display" )MutableDictionarySetObjectForKey( part, follows, @"follows" )end fn = part// a new page: { title, icon, parts, links }local fn PagesPage( title as CFStringRef ) as CFMutableDictionaryRefCFMutableDictionaryRef page = fn MutableDictionaryNewMutableDictionarySetObjectForKey( page, title, @"title" )MutableDictionarySetObjectForKey( page, fn PagesNull, @"icon" )MutableDictionarySetObjectForKey( page, fn MutableArrayNew, @"parts" )MutableDictionarySetObjectForKey( page, fn MutableArrayNew, @"links" )end fn = page// the model's own pages: one per table, List with detail - what the Lite edition always shows, and where the// designer starts ("Start from the model's pages")local fn PagesDefault( modelResources as CFDictionaryRef ) as CFMutableDictionaryRefCFMutableArrayRef      pageList = fn MutableArrayNewCFMutableDictionaryRef pageCFArrayRef             tableNames = fn PagesTables( modelResources )CFStringRef            tableNamefor tableName in tableNamespage = fn PagesPage( tableName )MutableArrayAddObject( (CFMutableArrayRef)fn DictionaryObjectForKey( page, @"parts" ), fn PagesPart( tableName, @"listDetail", NULL ) )MutableArrayAddObject( pageList, page )nextend fn = fn MutableDictionaryWithDictionary( @{ @"pages":pageList } )/* *   What the designer does on a drop: the part added to the page, following the proposed link (none for the first *   part, the driver). Returns the links offered, the proposed one first, for the sheet to show (and change). */local fn PagesDrop( modelResources as CFDictionaryRef, page as CFMutableDictionaryRef, entityName as CFStringRef, display as CFStringRef ) as CFArrayRefCFMutableArrayRef      parts = (CFMutableArrayRef)fn DictionaryObjectForKey( page, @"parts" )CFArrayRef             offered = fn PagesProposedLinks( modelResources, parts, entityName )CFTypeRef              follows = NULLif ( fn ArrayCount( parts ) > 0 && fn ArrayCount( offered ) > 0 ) then follows = fn MutableDictionaryWithDictionary( fn ArrayFirstObject( offered ) )MutableArrayAddObject( parts, fn PagesPart( entityName, display, follows ) )end fn = offered// does an offered association match what is stored (the same part, how and relationship)?local fn PagesSameAssociation( offered as CFDictionaryRef, stored as CFDictionaryRef, partKey as CFStringRef, storedPart as long ) as BOOLCFTypeRef wantedRelationship = fn DictionaryObjectForKey( stored, @"relationship" )CFTypeRef offeredRelationship = fn DictionaryObjectForKey( offered, @"relationship" )CFTypeRef wantedHow = fn DictionaryObjectForKey( stored, @"how" )if ( fn NumberIntegerValue( fn DictionaryObjectForKey( offered, partKey ) ) != storedPart ) then exit fn = NOif ( fn PagesIsNull( wantedHow ) ) then exit fn = NOif ( fn StringIsEqual( fn DictionaryObjectForKey( offered, @"how" ), wantedHow ) == NO ) then exit fn = NOif ( fn PagesIsNull( wantedRelationship ) || fn PagesIsNull( offeredRelationship ) ) then exit fn = ( fn PagesIsNull( wantedRelationship ) && fn PagesIsNull( offeredRelationship ) )end fn = fn StringIsEqual( offeredRelationship, wantedRelationship )// a value in a problem's words: 'Order Entry', or None (as the reference writes them)local fn PagesQuoted( value as CFTypeRef ) as CFStringRefif ( fn PagesIsNull( value ) ) then exit fn = @"None"end fn = fn StringWithFormat( @"'%@'", value )/* *   What is wrong with a project's pages, in words ([] when nothing): a page with no title, a title used twice, no *   parts; a part whose entity is not a table, whose display is unknown, or which follows a part along a relationship *   the model does not have; a link to a missing page, to its own page, or along a relationship that does not exist. */local fn PagesCheck( modelResources as CFDictionaryRef, pages as CFDictionaryRef ) as CFArrayRefCFMutableArrayRef      problems = fn MutableArrayNewCFMutableArrayRef      titles = fn MutableArrayNewCFMutableDictionaryRef byTitle = fn MutableDictionaryNewCFArrayRef             pageList = fn DictionaryObjectForKey( pages, @"pages" )CFArrayRef             parts, links, offered, earlierCFDictionaryRef        page, part, follows, link, target, resource, candidateCFStringRef            where, at, entityName, displayCFTypeRef              titlelong                   p, i, k, followedBOOL                   matchedif ( pageList == NULL ) then pageList = @[]for page in pageListtitle = fn DictionaryObjectForKey( page, @"title" )if ( fn PagesIsNull( title ) == NO ) then MutableDictionarySetObjectForKey( byTitle, page, title )nextfor p = 0 to (long)fn ArrayCount( pageList ) - 1page = fn ArrayObjectAtIndex( pageList, p )title = fn DictionaryObjectForKey( page, @"title" )where = fn StringWithFormat( @"page %ld (%@)", p + 1, fn PagesQuoted( title ) )if ( fn PagesIsNull( title ) )MutableArrayAddObject( problems, fn StringWithFormat( @"%@: no title", where ) )elseif ( fn StringLength( title ) == 0 )MutableArrayAddObject( problems, fn StringWithFormat( @"%@: no title", where ) )elseif ( fn ArrayContainsObject( titles, title ) ) then MutableArrayAddObject( problems, fn StringWithFormat( @"%@: the title is used twice", where ) )MutableArrayAddObject( titles, title )end ifend ifparts = fn DictionaryObjectForKey( page, @"parts" )if ( parts == NULL ) then parts = @[]if ( fn ArrayCount( parts ) == 0 ) then MutableArrayAddObject( problems, fn StringWithFormat( @"%@: no parts", where ) )for i = 0 to (long)fn ArrayCount( parts ) - 1part = fn ArrayObjectAtIndex( parts, i )at = fn StringWithFormat( @"%@, part %ld", where, i + 1 )entityName = fn DictionaryObjectForKey( part, @"entity" )resource = NULLif ( fn PagesIsNull( entityName ) == NO ) then resource = fn DictionaryObjectForKey( modelResources, entityName )if ( resource == NULL )MutableArrayAddObject( problems, fn StringWithFormat( @"%@: %@ is not a table of the model", at, fn PagesQuoted( entityName ) ) )continueend ifif ( fn StringIsEqual( fn DictionaryObjectForKey( resource, @"kind" ), @"table" ) == NO )MutableArrayAddObject( problems, fn StringWithFormat( @"%@: %@ is not a table of the model", at, fn PagesQuoted( entityName ) ) )continueend ifdisplay = fn DictionaryObjectForKey( part, @"display" )if ( fn PagesIsNull( display ) ) then display = @""if ( fn StringIsEqual( display, @"detail" ) == NO && fn StringIsEqual( display, @"list" ) == NO && fn StringIsEqual( display, @"listDetail" ) == NO ) then MutableArrayAddObject( problems, fn StringWithFormat( @"%@: display %@", at, fn PagesQuoted( display ) ) )follows = fn DictionaryObjectForKey( part, @"follows" )if ( fn PagesIsNull( follows ) ) then continueif ( i == 0 )MutableArrayAddObject( problems, fn StringWithFormat( @"%@: the driver follows nothing", at ) )continueend iffollowed = -1if ( fn PagesIsNull( fn DictionaryObjectForKey( follows, @"part" ) ) == NO ) then followed = fn NumberIntegerValue( fn DictionaryObjectForKey( follows, @"part" ) )if ( followed < 0 || followed >= i )MutableArrayAddObject( problems, fn StringWithFormat( @"%@: it follows part %ld, which is not an earlier part", at, followed ) )continueend ifearlier = fn ArraySubarrayWithRange( parts, fn CFRangeMake( 0, followed + 1 ) )offered = fn PagesProposedLinks( modelResources, earlier, entityName )matched = NOfor candidate in offeredif ( fn PagesSameAssociation( candidate, follows, @"part", followed ) ) then matched = YESnextif ( matched == NO ) then MutableArrayAddObject( problems, fn StringWithFormat( @"%@: no relationship \"%@\" (%@) between %@ and %@", at, fn DictionaryObjectForKey( follows, @"relationship" ), fn DictionaryObjectForKey( follows, @"how" ), entityName, fn DictionaryObjectForKey( fn ArrayObjectAtIndex( parts, followed ), @"entity" ) ) )nextlinks = fn DictionaryObjectForKey( page, @"links" )if ( links == NULL ) then links = @[]for k = 0 to (long)fn ArrayCount( links ) - 1link = fn ArrayObjectAtIndex( links, k )at = fn StringWithFormat( @"%@, link %ld", where, k + 1 )target = NULLif ( fn PagesIsNull( fn DictionaryObjectForKey( link, @"page" ) ) == NO ) then target = fn DictionaryObjectForKey( byTitle, fn DictionaryObjectForKey( link, @"page" ) )if ( target == NULL )MutableArrayAddObject( problems, fn StringWithFormat( @"%@: no page %@", at, fn PagesQuoted( fn DictionaryObjectForKey( link, @"page" ) ) ) )continueend ifif ( target == page )MutableArrayAddObject( problems, fn StringWithFormat( @"%@: a link to its own page", at ) )continueend ifoffered = fn PagesAssociations( modelResources, page, target )matched = NOfor candidate in offeredif ( fn PagesSameAssociation( candidate, link, @"fromPart", fn NumberIntegerValue( fn DictionaryObjectForKey( link, @"fromPart" ) ) ) ) then matched = YESnextif ( matched == NO ) then MutableArrayAddObject( problems, fn StringWithFormat( @"%@: no relationship \"%@\" (%@) from part %@ to %@", at, fn DictionaryObjectForKey( link, @"relationship" ), fn DictionaryObjectForKey( link, @"how" ), fn DictionaryObjectForKey( link, @"fromPart" ), fn PagesQuoted( fn DictionaryObjectForKey( link, @"page" ) ) ) )nextnextend fn = problems// <project>/Pages.jsonlocal fn PagesFileURL as CFURLRefend fn = fn URLByAppendingPathComponent( fn ProjectFolderURL, PAGES_FILE )// the project's pages, mutable for the designer; NULL when the project has none yet (the designer offers the// model's own pages to start from)local fn PagesLoad as CFMutableDictionaryRefCFDataRef jsonCFTypeRef pagesErrorRef  err = NULLjson = fn DataWithContentsOfURL( fn PagesFileURL, 0, @err )if ( json == NULL ) then exit fn = NULLpages = fn JSONSerializationJSONObjectWithData( json, NSJSONReadingMutableContainers, @err )if ( pages == NULL )if ( isLoggingOn ) then NSLog( @"Pages: %@ could not be read: %@", fn URLPath( fn PagesFileURL ), err )exit fn = NULLend ifend fn = (CFMutableDictionaryRef)pageslocal fn PagesSave( pages as CFDictionaryRef ) as BOOLCFDataRef jsonErrorRef  err = NULLjson = fn JSONSerializationDataWithJSONObject( pages, NSJSONWritingPrettyPrinted + NSJSONWritingSortedKeys, @err )if ( json == NULL )if ( isLoggingOn ) then NSLog( @"Pages: not saved: %@", err )exit fn = NOend ifend fn = fn DataWriteToURL( json, fn PagesFileURL, NSDataWritingAtomic, @err )