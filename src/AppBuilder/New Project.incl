/* *   New Project.incl * *   The New Project view (NewProjectView.xib): a project starts from a SQLite *   database - the lite edition's catalyst.  Choose the file, see the tables it *   holds, name the project, Create.  The database is copied into the project's *   Database/ folder; the project works from that copy.  "API Logic Server Project..." shows the *   ALS project view (Open ALS Project.incl): a project from the model ALS generated. * *   The chosen path lives in the database field itself, so nothing has to be *   kept alive between Choose and Create; the model is read again on Create. */#define NEW_PROJECT_DATABASE_TYPES @"sqlite;db;sqlite3"#define NEW_PROJECT_TABLES_SHOWN   12void local fn ShowNewProjectViewSetHidden( _welcomeView, YES )ViewSetHidden( _projectCreateView, YES )ViewSetHidden( _projectDetailView, YES )ViewSetHidden( _projectSettingsView, YES )ViewSetHidden( _alsProjectView, YES )ViewSetHidden( _newProjectView, NO )ControlSetStringValue( _newProjectNameEdit, @"" )ControlSetStringValue( _newProjectDatabaseField, @"" )ControlSetStringValue( _newProjectTablesLabel, @"" )ControlSetEnabled( _newProjectCreateBtn, NO )WindowMakeFirstResponder( _window, _newProjectChooseBtn )fn StudioUpdateCommands                            // the layout: this page across the whole width (no entity list)end fn// what the database holds, in a line or two: "8 tables, 2 views: Category, Customer, ..."local fn NewProjectSummary( model as CFDictionaryRef ) as CFStringRefCFDictionaryRef resourceDict = fn DictionaryObjectForKey( model, @"resources" )CFArrayRef      names = fn ArraySortedArrayUsingSelector( fn DictionaryAllKeys( resourceDict ), @"compare:" )CFStringRef     name, shownlong            tables = 0, views = 0for name in namesif ( fn StringIsEqual( fn DictionaryObjectForKey( fn DictionaryObjectForKey( resourceDict, name ), @"kind" ), @"view" ) ) then views++ else tables++nextif ( fn ArrayCount( names ) > NEW_PROJECT_TABLES_SHOWN )shown = fn StringWithFormat( @"%@, ...", fn ArrayComponentsJoinedByString( fn ArraySubarrayWithRange( names, fn CFRangeMake( 0, NEW_PROJECT_TABLES_SHOWN ) ), @", " ) )elseshown = fn ArrayComponentsJoinedByString( names, @", " )end ifend fn = fn StringWithFormat( @"%ld tables, %ld views: %@", tables, views, shown )// Choose...: pick the database, show what it holds, suggest the namevoid local fn NewProjectChooseDatabaseCFURLRef        databaseURLCFDictionaryRef modeldatabaseURL = openpanel 1, @"Choose the SQLite database for the new project", NEW_PROJECT_DATABASE_TYPESif ( databaseURL == NULL ) then exit fnmodel = fn SQLiteReadModel( fn URLPath( databaseURL ) )if ( model == NULL || fn DictionaryCount( fn DictionaryObjectForKey( model, @"resources" ) ) == 0 )ControlSetStringValue( _newProjectDatabaseField, @"" )ControlSetStringValue( _newProjectTablesLabel, @"No tables found - is it a SQLite database?" )ControlSetEnabled( _newProjectCreateBtn, NO )exit fnend ifControlSetStringValue( _newProjectDatabaseField, fn URLPath( databaseURL ) )ControlSetStringValue( _newProjectTablesLabel, fn NewProjectSummary( model ) )if ( fn StringLength( fn ControlStringValue( _newProjectNameEdit ) ) == 0 ) then ControlSetStringValue( _newProjectNameEdit, fn StringByDeletingPathExtension( fn URLLastPathComponent( databaseURL ) ) )ControlSetEnabled( _newProjectCreateBtn, YES )WindowMakeFirstResponder( _window, _newProjectNameEdit )end fn// Create: a fresh project from the database (or, if the name is taken, open that one)void local fn NewProjectCreateCFStringRef     name = fn ControlStringValue( _newProjectNameEdit )CFStringRef     path = fn ControlStringValue( _newProjectDatabaseField )CFURLRef        existingURLNSModalResponse responseif ( fn StringLength( path ) == 0 ) then exit fnif ( fn StringLength( name ) == 0 )alert 1, NSAlertStyleInformational, @"Name the project.", @"The name is used for its workspace folder and the generated app.", @[@"OK"], NOexit fnend ifexistingURL = fn URLByAppendingPathComponent( fn ProjectFolderURLNamed( name ), PROJECT_SETTINGS_FILE )if ( fn FileManagerFileExistsAtURL( existingURL ) )response = alert 1, NSAlertStyleWarning, fn StringWithFormat( @"A project named %@ already exists.", name ), @"Open it with this database, or choose another name.", @[@"Open It", @"Cancel"]if ( response != NSAlertFirstButtonReturn ) then exit fnend if// a fresh start: the new name, no connection or About text carried overControlSetStringValue( _projectNameEdit, name )ControlSetStringValue( _baseURLEdit, @"" )ControlSetStringValue( _authNameEdit, @"" )ControlSetStringValue( _aboutTextEdit, @"" )ControlSetStringValue( _taglineEdit, @"" )ControlSetStringValue( _copyrightEdit, @"" )ImageViewSetImage( _logoImageWell, NULL )ViewSetHidden( _newProjectView, YES )ViewSetHidden( _alsProjectView, YES )if ( fn LoadSQLiteModel( fn URLFileURLWithPath( path ) ) == NO ) then ViewSetHidden( _newProjectView, NO )end fn// the older route: a running API Logic Server's /metadata (Open ALS Project.incl: From a Running Server...)void local fn NewProjectUseALSViewSetHidden( _newProjectView, YES )ViewSetHidden( _alsProjectView, YES )ViewSetHidden( _welcomeView, YES )ViewSetHidden( _projectCreateView, NO )WindowMakeFirstResponder( _window, _projectNameEdit )end fnvoid local fn NewProjectCancelViewSetHidden( _newProjectView, YES )ViewSetHidden( _alsProjectView, YES )fn ShowWelcomeend fn