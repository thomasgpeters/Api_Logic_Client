/* *   I M A G E R Y    B U S I N E S S     S Y S T E M S,   L L C * *   App Generator * *   model -> a complete FutureBasic project in *   ~/Library/Application Support/App Builder for FutureBasic/workspace/<project>/ * *       <project>.fbeproj   the FB project: Settings2.plist (template) + data.fbproj (groups *                           Runtime, Model, Bindings, Resources, Controller, View, Main) *       <project>.main      main program: connection settings, handler registration, start *       EventHandlers.incl  starting templates - written only when missing, then the *       Menus.incl          developer's: event handlers, menus, and the window with *       Windows.incl        the nibview call for each entity's Form part *       Model.json          resources, fields, kinds and tags - read at run time by Data Model.incl *       Credits.rtf         the designer's About text - the standard About box shows it *       Model Tags.incl     tag constants for your own code *       <Entity> Binding.incl  record <-> Form / List code per entity (Binding Generator.incl) *       <Resource>List.xib  list part per resource: table, one column per attribute *       <Resource>Form.xib  scalar part per resource: the record's fields (XIB Generator.incl) *       Data SQLite / DataObject / Data Model / Data Records   the data runtime: SQLite, *                           the query builder, Model.json entities, records (copied from ../Runtime) *       Logic Rules / Logic Row / Logic Engine   LogicBank for FutureBasic (copied from ../Runtime) *       Rules.incl          the app's business rules - starting template, written only when missing *       App Data Lite.incl  the app's data interface, Lite edition (Edition.incl picks the edition) *       App Shell.incl      the window's frame: navigation, header, footer, page actions * *   The generated project contains only our own code; it relies on the user's *   FutureBasic install for the Cocoa toolboxes, which are never copied. */#define APP_DEFAULT_LOGIN_PATH  @"/api/auth/login"#define APP_FALLBACK_LOGIN_PATH @"/api/authentication-User/login"#define APP_DEFAULT_PAGE_LIMIT  100// FB source files use classic-Mac line endingslocal fn AppWriteSource( source as CFStringRef, folderURL as CFURLRef, fileName as CFStringRef ) as BOOLErrorRef err = NULLCFURLRef url = fn URLByAppendingPathComponent( folderURL, fileName )BOOL     ok  = fn StringWriteToURL( fn StringByReplacingOccurrencesOfString( source, @"\n", @"\r" ), url, YES, NSUTF8StringEncoding, @err )if ( ok == NO && isLoggingOn ) then NSLog( @"Could not write %@: %@", fn URLPath( url ), fn ErrorLocalizedDescription( err ) )end fn = ok// text safe to place inside an FB @"..." literallocal fn AppQuote( s as CFStringRef ) as CFStringRefif ( s == NULL ) then exit fn = @""s = fn StringByReplacingOccurrencesOfString( s, @"\\", @"\\\\" )end fn = fn StringByReplacingOccurrencesOfString( s, @"\"", @"\\\"" )// the runtime copied into every generated app, in build order (data runtime first)// the runtime copied into the project, in build order: the edition's data files (Edition.incl),// then the shell and the binding helpers, which are the same in every editionlocal fn AppRuntimeFiles( edition as CFStringRef ) as CFArrayRefCFMutableArrayRef files = fn MutableArrayWithArray( fn EditionDataRuntimeFiles( edition ) )MutableArrayAddObjectsFromArray( files, @[ @"Pill Buttons.incl", @"App Shell.incl", @"Binding Support.incl", @"Auto Complete.incl", @"Record Popover.incl", @"Record Tiles.incl", @"Record Search.incl", @"App Toolbar.incl" ] )end fn = fileslocal fn AppCopyRuntimeFile( fileName as CFStringRef, folderURL as CFURLRef ) as BOOLCFURLRef srcURL, dstURLsrcURL = fn URLByAppendingPathComponent( fn StudioRuntimeURL, fileName )   // workspace/Runtime (Studio Library.incl)if ( fn FileManagerFileExistsAtURL( srcURL ) == NO )if ( isLoggingOn ) then NSLog( @"Runtime/%@ is not in the workspace - Generate > Update Runtime and Templates.", fileName )exit fn = NOend ifdstURL = fn URLByAppendingPathComponent( folderURL, fileName )if ( fn FileManagerFileExistsAtURL( dstURL ) ) then fn FileManagerRemoveItemAtURL( dstURL )if ( fn FileManagerCopyItemAtURL( srcURL, dstURL ) == NO )if (isLoggingOn) then NSLog( @"Could not copy %@ to %@", fileName, fn URLPath( dstURL ) )exit fn = NOend ifend fn = YES// starting template from the bundled Templates folder - copied only when missing,// so the developer's edits survive regenerationlocal fn AppCopyTemplateFile( subfolder as CFStringRef, fileName as CFStringRef, dstFolderURL as CFURLRef ) as BOOLCFURLRef srcURL, dstURLdstURL = fn URLByAppendingPathComponent( dstFolderURL, fileName )if ( fn FileManagerFileExistsAtURL( dstURL ) ) then exit fn = YESsrcURL = fn URLByAppendingPathComponent( fn URLByAppendingPathComponent( fn StudioTemplatesURL, subfolder ), fileName )   // workspace/Templatesif ( fn FileManagerFileExistsAtURL( srcURL ) == NO )if ( isLoggingOn ) then NSLog( @"Templates/%@/%@ is not in the workspace - Generate > Update Runtime and Templates.", subfolder, fileName )exit fn = NOend ifif ( fn FileManagerCopyItemAtURL( srcURL, dstURL ) == NO )if (isLoggingOn) then NSLog( @"Could not copy %@ to %@", fileName, fn URLPath( dstURL ) )exit fn = NOend ifend fn = YES// starting Windows.incl: the shell window and its pages - written only when missinglocal fn AppWindowsSource as CFStringRefCFMutableStringRef s = fn MutableStringNewMutableStringAppendString( s, @"/*\n *   Windows.incl - the app's window\n *\n" )MutableStringAppendString( s, @" *   Starting template from App Builder for FutureBasic: created once, then\n" )MutableStringAppendString( s, @" *   yours.  Regeneration never overwrites it (delete it to get a fresh copy).\n *\n" )MutableStringAppendString( s, @" *   Developer notes\n" )MutableStringAppendString( s, @" *   - The window has the common look of every generated app (App Shell.incl): the\n" )MutableStringAppendString( s, @" *     navigation bar, the header with the logo, the app name, the theme menu and Log In,\n" )MutableStringAppendString( s, @" *     and the footer.  Its colours come from Theme.incl.\n" )MutableStringAppendString( s, @" *   - App Pages.incl (regenerated) adds a page per entity.  Add pages of your own here,\n" )MutableStringAppendString( s, @" *     after AppPagesBuild: load a XIB into the content view, then add its button:\n" )MutableStringAppendString( s, @" *         nibview _myView, @\"MyView\", , ( 0, 0 ), _shellContent\n" )MutableStringAppendString( s, @" *         fn ShellAddNavItem( @\"Reports\", @\"chart.bar\", @[ fn NumberWithInteger( _myView ) ] )\n */\n\n" )MutableStringAppendString( s, @"void local fn BuildWindows( title as CFStringRef )\n" )MutableStringAppendString( s, @"fn ApplyTheme                                           // Theme.incl: the colours\n" )MutableStringAppendString( s, @"fn ShellBuildWindow( title, APP_TAGLINE, APP_COPYRIGHT ) // App Shell.incl: navigation, header, footer\n" )MutableStringAppendString( s, @"fn AppPagesBuild                                        // App Pages.incl: a page per entity\n" )MutableStringAppendString( s, @"fn ShellShowPage( 0 )                                   // start on the first page\n" )MutableStringAppendString( s, @"end fn\n" )end fn = s// a generated source file only when missing - for starting templateslocal fn AppWriteSourceIfMissing( source as CFStringRef, folderURL as CFURLRef, fileName as CFStringRef ) as BOOLif ( fn FileManagerFileExistsAtURL( fn URLByAppendingPathComponent( folderURL, fileName ) ) ) then exit fn = YESend fn = fn AppWriteSource( source, folderURL, fileName )local fn AppWriteModel( modelResources as CFArrayRef, folderURL as CFURLRef, projectLabel as CFStringRef, about as CFStringRef, databasePath as CFStringRef ) as BOOLCFDataRef jsonErrorRef  err = NULLCFURLRef  url = fn URLByAppendingPathComponent( folderURL, @"Model.json" )// "database": the project's SQLite copy, opened by the data runtime (Data Records.incl: DataOpen)json = fn JSONSerializationDataWithJSONObject( @{ @"project":projectLabel, @"about":about, @"database":databasePath, @"resources":modelResources }, NSJSONWritingPrettyPrinted, @err )if ( json == NULL ) then exit fn = NOif ( fn DataWriteToURL( json, url, NSDataWritingAtomic, @err ) == NO )if (isLoggingOn) then NSLog( @"Could not write %@: %@", fn URLPath( url ), fn ErrorLocalizedDescription( err ) )exit fn = NOend ifend fn = YES// Credits.rtf - FB's About menu item opens the standard About box, which shows the// bundle's Credits.rtf under the app's name, icon and version.  No colour is set, so// the text follows light and dark mode.  No About text: no file.local fn AppWriteCredits( about as CFStringRef, folderURL as CFURLRef ) as BOOLCFURLRef  url = fn URLByAppendingPathComponent( folderURL, @"Credits.rtf" )CFDataRef rtfErrorRef  err = NULLif ( fn FileManagerFileExistsAtURL( url ) ) then fn FileManagerRemoveItemAtURL( url )if ( fn StringLength( about ) == 0 ) then exit fn = YESrtf = fn AttributedStringRTFFromRange( fn AttributedStringWithString( about ), fn CFRangeMake( 0, fn StringLength( about ) ), NULL )if ( rtf == NULL ) then exit fn = NOif ( fn DataWriteToURL( rtf, url, NSDataWritingAtomic, @err ) == NO )if (isLoggingOn) then NSLog( @"Could not write %@: %@", fn URLPath( url ), fn ErrorLocalizedDescription( err ) )exit fn = NOend ifend fn = YES/* *   App Pages.incl (regenerated): a page per entity in the app shell - its List part above *   its Form part - the navigation buttons, and the page actions (New, Save, Delete, *   Refresh) through the app's data interface (App Data: Lite or Professional).  Written to *   be read: FB developers who open the generated project should understand it without *   this generator. */// a List's records as tiles (Record Tiles.incl): the name field as the subheading (name, title, description or// label, else a field with "name" in it, else the first text), then up to four other shown fieldslocal fn AppTilesCall( pageIndex as long, resource as CFDictionaryRef ) as CFStringRefCFArrayRef         fields = fn DictionaryObjectForKey( resource, @"fields" )CFDictionaryRef    fieldCFStringRef        attrName, lower, titleKey = NULL, withName = NULL, firstText = NULLCFMutableStringRef keys = fn MutableStringNew, titles = fn MutableStringNewlong               details = 0for field in fieldsif ( fn NumberIntegerValue( fn DictionaryObjectForKey( field, @"kind" ) ) != _xibKindHidden && fn NumberIntegerValue( fn DictionaryObjectForKey( field, @"pk" ) ) == 0 )attrName = fn DictionaryObjectForKey( field, @"name" )lower = fn StringLowercaseString( attrName )if ( titleKey == NULL )if ( fn StringIsEqual( lower, @"name" ) || fn StringIsEqual( lower, @"title" ) || fn StringIsEqual( lower, @"description" ) || fn StringIsEqual( lower, @"label" ) ) then titleKey = attrNameend ifif ( withName == NULL && fn StringContainsString( lower, @"name" ) ) then withName = attrNameif ( firstText == NULL && ( fn StringContainsString( fn StringUppercaseString( fn DictionaryObjectForKey( field, @"type" ) ), @"CHAR" ) || fn StringContainsString( fn StringUppercaseString( fn DictionaryObjectForKey( field, @"type" ) ), @"TEXT" ) ) ) then firstText = attrNameend ifnextif ( titleKey == NULL ) then titleKey = withNameif ( titleKey == NULL ) then titleKey = firstTextif ( titleKey == NULL ) then titleKey = fn DictionaryObjectForKey( fn ArrayObjectAtIndex( fields, 0 ), @"name" )for field in fieldsattrName = fn DictionaryObjectForKey( field, @"name" )if ( details < 4 && fn StringIsEqual( attrName, titleKey ) == NO && fn NumberIntegerValue( fn DictionaryObjectForKey( field, @"kind" ) ) != _xibKindHidden && fn NumberIntegerValue( fn DictionaryObjectForKey( field, @"pk" ) ) == 0 )if ( details > 0 )MutableStringAppendString( keys, @", " )MutableStringAppendString( titles, @", " )end ifMutableStringAppendFormat( keys, @"@\"%@\"", fn AppQuote( attrName ) )MutableStringAppendFormat( titles, @"@\"%@\"", fn AppQuote( fn DictionaryObjectForKey( field, @"title" ) ) )details++end ifnextend fn = fn StringWithFormat( @"fn RecordTilesShow( %ld, records, @\"%@\", @[ %@ ], @[ %@ ] )", pageIndex, fn AppQuote( titleKey ), keys, titles )// a page's searchable fields as an FB array literal: every field shown, its title, and how it is searched (the search// dialog: a calendar for a date, a text box for a key or a parent, a text box or a dropdown of its values otherwise)local fn AppSearchFieldsLiteral( resource as CFDictionaryRef ) as CFStringRefCFMutableStringRef s = fn MutableStringNewCFArrayRef         fields = fn DictionaryObjectForKey( resource, @"fields" )CFDictionaryRef    fieldCFStringRef        kindName, sqlTypelong               kindfor field in fieldskind = fn NumberIntegerValue( fn DictionaryObjectForKey( field, @"kind" ) )if ( kind != _xibKindHidden && fn NumberIntegerValue( fn DictionaryObjectForKey( field, @"hidden" ) ) == 0 )sqlType = fn StringUppercaseString( fn DictionaryObjectForKey( field, @"type" ) )kindName = @"text"if ( kind == _xibKindDate || kind == _xibKindDateTime || fn StringContainsString( sqlType, @"DATE" ) || fn StringContainsString( sqlType, @"TIMESTAMP" ) ) then kindName = @"date"if ( fn NumberIntegerValue( fn DictionaryObjectForKey( field, @"pk" ) ) != 0 || fn DictionaryObjectForKey( field, @"lookup" ) != NULL ) then kindName = @"key"if ( fn StringLength( s ) > 0 ) then MutableStringAppendString( s, @", " )MutableStringAppendFormat( s, @"@{ @\"name\":@\"%@\", @\"title\":@\"%@\", @\"kind\":@\"%@\" }", fn AppQuote( fn DictionaryObjectForKey( field, @"name" ) ), fn AppQuote( fn DictionaryObjectForKey( field, @"title" ) ), kindName )end ifnextend fn = slocal fn AppPagesSource( modelResources as CFArrayRef, tagline as CFStringRef, copyright as CFStringRef, appSymbol as CFStringRef ) as CFStringRefCFMutableStringRef s = fn MutableStringNewCFDictionaryRef    resourceCFStringRef        name, prefixlong               indexMutableStringAppendString( s, @"/*\n *   App Pages.incl - the app's pages: one per entity\n *\n" )MutableStringAppendString( s, @" *   Generated by App Builder for FutureBasic from the data model.\n" )MutableStringAppendString( s, @" *   Regenerating overwrites this file - put your own code in EventHandlers.incl,\n" )MutableStringAppendString( s, @" *   Windows.incl or files of your own.\n *\n" )MutableStringAppendString( s, @" *   Developer notes\n" )MutableStringAppendString( s, @" *   - Each page is two XIB parts loaded into the shell's content view with nibview\n" )MutableStringAppendString( s, @" *     (its last parameter, _shellContent, is the superview): the entity's List part on\n" )MutableStringAppendString( s, @" *     top, filling the space, and its Form part below.  The tags (_customerList,\n" )MutableStringAppendString( s, @" *     _customerView, ...) are named in Model Tags.incl.\n" )MutableStringAppendString( s, @" *   - ShellAddNavItem (App Shell.incl) adds the page's button to the navigation bar.\n" )MutableStringAppendString( s, @" *   - The pages never read or write data themselves: they ask App Data (AppDataList,\n" )MutableStringAppendString( s, @" *     AppDataSave, AppDataRemove) and get the answer in AppDataDone.  In the Lite edition\n" )MutableStringAppendString( s, @" *     App Data is the SQLite database and the rules engine in this app; in the Professional\n" )MutableStringAppendString( s, @" *     edition it is an API Logic Server.  This file is the same in both.\n" )MutableStringAppendString( s, @" *   - Records move between the screens and App Data through <Entity> Binding.incl:\n" )MutableStringAppendString( s, @" *     <Entity>RecordsToList, <Entity>RecordToForm, <Entity>FormToRecord.\n" )MutableStringAppendString( s, @" *   - Page numbers follow the navigation bar: 0 is the first entity.\n */\n\n" )MutableStringAppendString( s, @"// the header's tag-line and the footer's copyright (Project Settings in the Studio)\n" )MutableStringAppendString( s, fn StringWithFormat( @"#define APP_TAGLINE   @\"%@\"\n", fn AppQuote( tagline ) ) )MutableStringAppendString( s, fn StringWithFormat( @"#define APP_COPYRIGHT @\"%@\"\n", fn AppQuote( copyright ) ) )MutableStringAppendString( s, @"// the app icon's SF Symbol, shown when the project has no app icon picture (AppLogo.png)\n" )MutableStringAppendString( s, fn StringWithFormat( @"#define APP_SYMBOL    @\"%@\"\n\n", fn AppQuote( appSymbol ) ) )MutableStringAppendString( s, @"begin globals\n" )MutableStringAppendString( s, @"CFMutableArrayRef      gAppPageEntities     // page number -> entity name\n" )MutableStringAppendString( s, @"CFMutableDictionaryRef gAppPageRecords      // entity name -> the records its List shows\n" )MutableStringAppendString( s, @"CFDictionaryRef        gAppPageKeys         // the key of the record in the Form; NULL for a new one\n" )MutableStringAppendString( s, @"long                   gAppPageRow          // its row in the List (the record navigator); -1 for none\n" )MutableStringAppendString( s, @"CFDictionaryRef        gAppPageQuery        // the search dialog's query on this page: { field, mode, text } (NULL: every record)\n" )MutableStringAppendString( s, @"CFArrayRef             gAppPageShown        // the records the List shows: those that match the search\n" )MutableStringAppendString( s, @"CFDictionaryRef        gAppPageClean        // the Form as it was shown: a difference is a change to save\n" )MutableStringAppendString( s, @"end globals\n\n\n" )// the entity on screenMutableStringAppendString( s, @"// the entity of the page on screen (NULL before the first page is shown)\n" )MutableStringAppendString( s, @"local fn AppPageEntity as CFStringRef\n" )MutableStringAppendString( s, @"if ( gShellCurrentPage < 0 || gShellCurrentPage >= fn ArrayCount( gAppPageEntities ) ) then exit fn = NULL\n" )MutableStringAppendString( s, @"end fn = fn ArrayObjectAtIndex( gAppPageEntities, gShellCurrentPage )\n\n\n" )// per-page bindingsMutableStringAppendString( s, @"// each page's List table, and its bindings (<Entity> Binding.incl), by page number\n" )MutableStringAppendString( s, @"local fn AppPageTable( pageIndex as long ) as long\nlong tag = 0\nselect ( pageIndex )\n" )index = 0for resource in modelResourcesMutableStringAppendString( s, fn StringWithFormat( @"case %ld : tag = _%@ListTable\n", index, fn XibResourcePrefix( fn DictionaryObjectForKey( resource, @"name" ) ) ) )index++nextMutableStringAppendString( s, @"end select\nend fn = tag\n\n" )MutableStringAppendString( s, @"void local fn AppPageShowRecords( pageIndex as long, records as CFArrayRef )\nselect ( pageIndex )\n" )index = 0for resource in modelResourcesMutableStringAppendString( s, fn StringWithFormat( @"case %ld\nfn %@RecordsToList( records )\n%@     // the same records as tiles (Record Tiles.incl)\n", index, fn DictionaryObjectForKey( resource, @"name" ), fn AppTilesCall( index, resource ) ) )index++nextMutableStringAppendString( s, @"end select\nend fn\n\n" )MutableStringAppendString( s, @"local fn AppPageFormRecord( pageIndex as long ) as CFMutableDictionaryRef\nCFMutableDictionaryRef aRecord = NULL\nselect ( pageIndex )\n" )index = 0for resource in modelResourcesMutableStringAppendString( s, fn StringWithFormat( @"case %ld : aRecord = fn %@FormToRecord\n", index, fn DictionaryObjectForKey( resource, @"name" ) ) )index++nextMutableStringAppendString( s, @"end select\nend fn = aRecord\n\n" )MutableStringAppendString( s, @"// a change in the Form not yet saved: the Form now differs from the Form as it was shown\n" )MutableStringAppendString( s, @"local fn AppPageHasChange as BOOL\nif ( gAppPageClean == NULL || gShellCurrentPage < 0 ) then exit fn = NO\nend fn = ( fn DictionaryIsEqual( fn AppPageFormRecord( gShellCurrentPage ), gAppPageClean ) == NO )\n\n" )MutableStringAppendString( s, @"// the toolbar knows the context: Save with a change to save, Delete with a record shown (App Toolbar.incl)\n" )MutableStringAppendString( s, @"void local fn AppPageUpdateToolbar\nfn AppToolbarSetEnabled( ( gShellCurrentPage >= 0 ), fn AppPageHasChange, ( gAppPageKeys != NULL ) )\nend fn\n\n" )MutableStringAppendString( s, @"// the Form as it is now is the clean one (a record shown, or its lookups filled in)\n" )MutableStringAppendString( s, @"void local fn AppPageMarkClean( pageIndex as long )\ngAppPageClean = fn DataKept( fn AppPageFormRecord( pageIndex ), gAppPageClean )\nfn AppPageUpdateToolbar\nend fn\n\n" )MutableStringAppendString( s, @"void local fn AppPageShowRecord( pageIndex as long, aRecord as CFDictionaryRef )\nselect ( pageIndex )\n" )index = 0for resource in modelResourcesMutableStringAppendString( s, fn StringWithFormat( @"case %ld : fn %@RecordToForm( aRecord )\n", index, fn DictionaryObjectForKey( resource, @"name" ) ) )index++nextMutableStringAppendString( s, @"end select\nfn RecordPopoverRefresh                         // the info buttons: on only where a parent is chosen (Record Popover.incl)\nfn AppPageMarkClean( pageIndex )               // nothing to save yet\nend fn\n\n" )MutableStringAppendString( s, @"// the lookup tables a page's Dropdowns offer: ask App Data for their rows\n" )MutableStringAppendString( s, @"void local fn AppPageRequestLookups( pageIndex as long )\nCFArrayRef  lookups = NULL\nCFStringRef lookupEntity\n\nselect ( pageIndex )\n" )index = 0for resource in modelResourcesMutableStringAppendString( s, fn StringWithFormat( @"case %ld : lookups = fn %@Lookups\n", index, fn DictionaryObjectForKey( resource, @"name" ) ) )index++nextMutableStringAppendString( s, @"end select\nif ( lookups == NULL ) then exit fn\nfor lookupEntity in lookups\nfn AppDataLookup( lookupEntity )\nnext\nend fn\n\n" )MutableStringAppendString( s, @"void local fn AppPageFillLookup( pageIndex as long, lookupEntity as CFStringRef, records as CFArrayRef )\nselect ( pageIndex )\n" )index = 0for resource in modelResourcesMutableStringAppendString( s, fn StringWithFormat( @"case %ld : fn %@FillLookup( lookupEntity, records )\n", index, fn DictionaryObjectForKey( resource, @"name" ) ) )index++nextMutableStringAppendString( s, @"end select\nfn RecordPopoverRefresh                         // the rows arrived: the chosen parent may be there now\nfn AppPageMarkClean( pageIndex )               // the Dropdowns show their choice now: not a change\nend fn\n\n\n" )// the record navigatorMutableStringAppendString( s, @"// the records the page on screen lists: those that match the search (an empty array before they arrive)\n" )MutableStringAppendString( s, @"local fn AppPageRecordsShown as CFArrayRef\nif ( gAppPageShown == NULL ) then exit fn = @[]\nend fn = gAppPageShown\n\n\n" )MutableStringAppendString( s, @"// the page's records narrowed by the search (Record Search.incl), kept for the List and the navigator\n" )MutableStringAppendString( s, @"void local fn AppPageFilterShown\nCFArrayRef records = NULL\nif ( fn AppPageEntity != NULL ) then records = fn DictionaryObjectForKey( gAppPageRecords, fn AppPageEntity )\nif ( records == NULL ) then records = @[]\nrecords = fn RecordSearchQuery( records, gAppPageQuery )\ngAppPageShown = fn DataKept( records, gAppPageShown )\nend fn\n\n\n" )MutableStringAppendString( s, @"// the fields the search dialog offers on the page on screen: { name, title, kind } - kind date (a calendar), key (a\n// key or a parent: a text box), text (a text box, or a dropdown when the field has few distinct values)\n" )MutableStringAppendString( s, @"local fn AppPageSearchFields as CFArrayRef\nCFArrayRef fields = @[]\nselect ( gShellCurrentPage )\n" )index = 0for resource in modelResourcesMutableStringAppendString( s, fn StringWithFormat( @"case %ld : fields = @[ %@ ]\n", index, fn AppSearchFieldsLiteral( resource ) ) )index++nextMutableStringAppendString( s, @"end select\nend fn = fields\n\n\n" )MutableStringAppendString( s, @"// the page's title in the navigation bar (\"Customer\")\n" )MutableStringAppendString( s, @"local fn AppPageTitle as CFStringRef\nif ( gShellCurrentPage < 0 || gShellCurrentPage >= fn ArrayCount( gShellPages ) ) then exit fn = @\"Record\"\nend fn = fn DictionaryObjectForKey( fn ArrayObjectAtIndex( gShellPages, gShellCurrentPage ), @\"title\" )\n\n\n" )MutableStringAppendString( s, @"// the record navigator: row n of the List selected (the list has the focus), shown in the Form, and the footer's\n// \"Customer 3 of 91\" and its buttons updated.  The Lists start on their first record, as the Studio's do (author).\n" )MutableStringAppendString( s, @"void local fn AppPageGoTo( row as long )\nCFArrayRef      records = fn AppPageRecordsShown\nCFDictionaryRef aRecord\nlong            recordCount = fn ArrayCount( records )\n\n" )MutableStringAppendString( s, @"if ( recordCount == 0 )\ngAppPageRow = -1\nfn RecordTilesSelect( gShellCurrentPage, -1 )\ngAppPageKeys = fn DataKept( NULL, gAppPageKeys )\nfn AppPageShowRecord( gShellCurrentPage, @{} )\nfn ShellSetNavigator( -1, 0 )\nexit fn\nend if\n" )MutableStringAppendString( s, @"if ( row < 0 ) then row = 0\nif ( row > recordCount - 1 ) then row = recordCount - 1\n" )MutableStringAppendString( s, @"aRecord = fn ArrayObjectAtIndex( records, row )\ngAppPageRow = row\n" )MutableStringAppendString( s, @"gAppPageKeys = fn DataKept( fn AppDataKeyValues( fn AppPageEntity, aRecord ), gAppPageKeys )   // Save and Delete act on this record\n" )MutableStringAppendString( s, @"fn ShellSelectRow( fn AppPageTable( gShellCurrentPage ), row )\nfn RecordTilesSelect( gShellCurrentPage, row )   // the same record as a tile: a ring round it (Record Tiles.incl)\nfn AppPageShowRecord( gShellCurrentPage, aRecord )\nfn ShellSetNavigator( row, recordCount )\nend fn\n\n\n" )MutableStringAppendString( s, @"// the row of the record with these key values; -1 when it is not there\n" )MutableStringAppendString( s, @"local fn AppPageKeyRow( records as CFArrayRef, keyValues as CFDictionaryRef ) as long\nlong i, found = -1\n" )MutableStringAppendString( s, @"if ( records == NULL || keyValues == NULL ) then exit fn = -1\nif ( fn ArrayCount( records ) == 0 ) then exit fn = -1\n" )MutableStringAppendString( s, @"for i = 0 to (long)fn ArrayCount( records ) - 1\nif ( found < 0 ) then if ( fn DictionaryIsEqual( fn AppDataKeyValues( fn AppPageEntity, fn ArrayObjectAtIndex( records, i ) ), keyValues ) ) then found = i\nnext\nend fn = found\n\n\n" )MutableStringAppendString( s, @"// a list arrived: back on the record that was showing (after a save or a refresh); after adding one, the new one;\n// after a delete, the one that took its place; otherwise the first\n" )MutableStringAppendString( s, @"void local fn AppPageChooseRow( records as CFArrayRef, previous as CFArrayRef )\nCFArrayRef shown = fn AppPageRecordsShown\nlong       row = fn AppPageKeyRow( shown, gAppPageKeys ), i\n\n" )MutableStringAppendString( s, @"if ( row < 0 && gAppPageKeys == NULL && previous != NULL )\nif ( fn ArrayCount( records ) == fn ArrayCount( previous ) + 1 )\nfor i = 0 to (long)fn ArrayCount( records ) - 1\nif ( row < 0 ) then if ( fn AppPageKeyRow( previous, fn AppDataKeyValues( fn AppPageEntity, fn ArrayObjectAtIndex( records, i ) ) ) < 0 ) then row = fn AppPageKeyRow( shown, fn AppDataKeyValues( fn AppPageEntity, fn ArrayObjectAtIndex( records, i ) ) )\nnext\nend if\nend if\n" )MutableStringAppendString( s, @"if ( row < 0 && gAppPageRow >= 0 ) then row = gAppPageRow        // a delete: the record now in its place\n" )MutableStringAppendString( s, @"if ( row < 0 ) then row = 0\nfn AppPageGoTo( row )\nend fn\n\n\n" )MutableStringAppendString( s, @"// the toolbar's search changed (App Toolbar.incl calls this as you type): the List narrows, the navigator follows\n" )MutableStringAppendString( s, @"void local fn AppPageSearchChanged( query as CFDictionaryRef )\nlong        total = 0\nCFStringRef searchText = NULL\n" )MutableStringAppendString( s, @"gAppPageQuery = fn DataKept( query, gAppPageQuery )\nif ( query != NULL ) then searchText = fn DictionaryObjectForKey( query, @\"text\" )\n" )MutableStringAppendString( s, @"fn AppPageFilterShown\nfn AppPageShowRecords( gShellCurrentPage, fn AppPageRecordsShown )\nfn AppPageChooseRow( fn AppPageRecordsShown, NULL )\n" )MutableStringAppendString( s, @"if ( fn AppPageEntity != NULL ) then if ( fn DictionaryObjectForKey( gAppPageRecords, fn AppPageEntity ) != NULL ) then total = fn ArrayCount( fn DictionaryObjectForKey( gAppPageRecords, fn AppPageEntity ) )\n" )MutableStringAppendString( s, @"if ( fn StringLength( searchText ) > 0 ) then fn ShellSetStatus( fn StringWithFormat( @\"%ld of %ld match “%@”\", (long)fn ArrayCount( fn AppPageRecordsShown ), total, searchText ) ) else fn ShellSetStatus( @\"\" )\n" )MutableStringAppendString( s, @"end fn\n\n\n" )// AppDataDoneMutableStringAppendString( s, @"// App Data's answer: records to show, or what became of a save, a delete, a sign-in.\n" )MutableStringAppendString( s, @"// message is NULL when it worked, otherwise the reason (a rule's message, the server's error).\n" )MutableStringAppendString( s, @"void local fn AppDataDone( op as long, entity as CFStringRef, result as CFTypeRef, message as CFStringRef )\n" )MutableStringAppendString( s, @"long       pageIndex = -1\nCFArrayRef previous\n\n" )MutableStringAppendString( s, @"if ( entity != NULL )\nif ( fn ArrayContainsObject( gAppPageEntities, entity ) ) then pageIndex = fn ArrayIndexOfObject( gAppPageEntities, entity )\nend if\n" )MutableStringAppendString( s, @"select ( op )\n" )MutableStringAppendString( s, @"case _appDataList\n" )MutableStringAppendString( s, @"if ( result == NULL ) then result = @[]\n" )MutableStringAppendString( s, @"previous = fn DictionaryObjectForKey( gAppPageRecords, entity )   // the list before: a record just added is the one not in it\n" )MutableStringAppendString( s, @"MutableDictionarySetObjectForKey( gAppPageRecords, result, entity )\n" )MutableStringAppendString( s, @"if ( pageIndex == gShellCurrentPage )\nfn AppPageFilterShown                          // the toolbar's search, if any\nfn AppPageShowRecords( pageIndex, fn AppPageRecordsShown )\nfn AppPageChooseRow( result, previous )         // the record navigator: a record selected and shown\nend if\n" )MutableStringAppendString( s, @"if ( message != NULL ) then fn ShellSetStatus( message )\n\n" )MutableStringAppendString( s, @"case _appDataSave, _appDataRemove\n" )MutableStringAppendString( s, @"if ( message != NULL )\n" )MutableStringAppendString( s, @"fn ShellSetStatus( message )\n" )MutableStringAppendString( s, @"if ( op == _appDataSave )\nalert 1, NSAlertStyleWarning, @\"The record was not saved.\", message, @[@\"OK\"], NO\nelse\nalert 1, NSAlertStyleWarning, @\"The record was not deleted.\", message, @[@\"OK\"], NO\nend if\n" )MutableStringAppendString( s, @"exit fn\nend if\n" )MutableStringAppendString( s, @"if ( op == _appDataSave ) then fn ShellSetStatus( @\"Saved.\" ) else fn ShellSetStatus( @\"Deleted.\" )\n" )MutableStringAppendString( s, @"// after a delete, or after adding a new record, the Form starts over (Save twice adds nothing twice)\n" )MutableStringAppendString( s, @"if ( op == _appDataRemove || gAppPageKeys == NULL )\ngAppPageKeys = fn DataKept( NULL, gAppPageKeys )\nfn AppPageShowRecord( pageIndex, @{} )\nend if\n" )MutableStringAppendString( s, @"fn AppDataList( entity )               // show the list as it is now (the rules may have changed other rows)\n\n" )MutableStringAppendString( s, @"case _appDataLookup\n" )MutableStringAppendString( s, @"if ( message != NULL ) then fn ShellSetStatus( message ) else fn AppPageFillLookup( gShellCurrentPage, entity, result )\n\n" )MutableStringAppendString( s, @"case _appDataLogin\n" )MutableStringAppendString( s, @"if ( message != NULL )\nfn ShellSetStatus( message )\nalert 1, NSAlertStyleWarning, @\"Sign-in failed.\", message, @[@\"OK\"], NO\nexit fn\nend if\n" )MutableStringAppendString( s, @"fn ShellSetStatus( @\"Signed in.\" )\n" )MutableStringAppendString( s, @"if ( fn AppPageEntity != NULL ) then fn AppDataList( fn AppPageEntity )\n" )MutableStringAppendString( s, @"end select\nend fn\n\n\n" )// AppPageShown and the actionsMutableStringAppendString( s, @"// a page was shown (App Shell.incl calls this): ask for its records\n" )MutableStringAppendString( s, @"void local fn AppPageShown( pageIndex as long )\ngAppPageKeys = fn DataKept( NULL, gAppPageKeys )\ngAppPageRow = -1                             // the list starts on its first record\nfn ShellSetNavigator( -1, 0 )\ngAppPageQuery = fn DataKept( NULL, gAppPageQuery )   // a new page: no search\ngAppPageShown = fn DataKept( NULL, gAppPageShown )\nfn AppToolbarShowPage( fn AppPageTitle )      // \"Search Customers\" (App Toolbar.incl)\nfn RecordTilesPageShown( pageIndex )          // its grid or its tiles (Record Tiles.incl)\n" )MutableStringAppendString( s, @"fn AppPageRequestLookups( pageIndex )      // the Dropdowns' lookup tables first\n" )MutableStringAppendString( s, @"fn AppDataList( fn ArrayObjectAtIndex( gAppPageEntities, pageIndex ) )\nend fn\n\n\n" )MutableStringAppendString( s, @"// New: an empty Form; Save will add the record\n" )MutableStringAppendString( s, @"void local fn AppPageNew\nif ( fn AppPageEntity == NULL ) then exit fn\ngAppPageKeys = fn DataKept( NULL, gAppPageKeys )\n" )MutableStringAppendString( s, @"TableViewDeselectAll( fn AppPageTable( gShellCurrentPage ) )\ngAppPageRow = -1\nfn RecordTilesSelect( gShellCurrentPage, -1 )\nfn ShellSetNavigator( -1, fn ArrayCount( fn AppPageRecordsShown ) )\n" )MutableStringAppendString( s, @"fn AppPageShowRecord( gShellCurrentPage, @{} )\n" )MutableStringAppendString( s, @"fn ShellSetStatus( @\"New record: fill in the form, then Save.\" )\nend fn\n\n\n" )MutableStringAppendString( s, @"// Save: the Form's record - new, or a change to the chosen one - through App Data (and the rules)\n" )MutableStringAppendString( s, @"void local fn AppPageSave\nif ( fn AppPageEntity == NULL ) then exit fn\n" )MutableStringAppendString( s, @"fn AppDataSave( fn AppPageEntity, fn AppPageFormRecord( gShellCurrentPage ), gAppPageKeys )\nend fn\n\n\n" )MutableStringAppendString( s, @"// Delete: the chosen record, after asking\n" )MutableStringAppendString( s, @"void local fn AppPageDelete\nNSModalResponse response\n\n" )MutableStringAppendString( s, @"if ( fn AppPageEntity == NULL ) then exit fn\n" )MutableStringAppendString( s, @"if ( gAppPageKeys == NULL )\nfn ShellSetStatus( @\"Choose a record in the list first.\" )\nexit fn\nend if\n" )MutableStringAppendString( s, @"response = alert 1, NSAlertStyleWarning, @\"Delete this record?\", @\"The business rules decide what happens to its related records.\", @[@\"Delete\", @\"Cancel\"]\n" )MutableStringAppendString( s, @"if ( response != NSAlertFirstButtonReturn ) then exit fn\n" )MutableStringAppendString( s, @"fn AppDataRemove( fn AppPageEntity, gAppPageKeys )\nend fn\n\n\n" )MutableStringAppendString( s, @"void local fn AppPageRefresh\nif ( fn AppPageEntity != NULL ) then fn AppDataList( fn AppPageEntity )\nend fn\n\n\n" )MutableStringAppendString( s, @"// Log In (EventHandlers.incl, DoLogin): App Data asks for the name and password it needs\n" )MutableStringAppendString( s, @"void local fn AppPagesLogin\nfn AppDataLogin( NULL, NULL )\nend fn\n\n\n" )// AppPagesBuildMutableStringAppendString( s, @"// the pages: each entity's List and Form parts in the content view, and its button\n" )MutableStringAppendString( s, @"void local fn AppPagesBuild\nCGRect  content = fn ShellContentBounds      // the content view, origin at its bottom left\nCGFloat listY, formH\n\n" )MutableStringAppendString( s, @"gAppPageEntities = (CFMutableArrayRef)fn DataKept( fn MutableArrayNew, gAppPageEntities )   // kept: read by later events (a global does not keep its value alive)\ngAppPageRecords  = (CFMutableDictionaryRef)fn DataKept( fn MutableDictionaryNew, gAppPageRecords )\n" )MutableStringAppendString( s, @"fn ShellSetAppSymbol( APP_SYMBOL )                  // the header's icon when there is no picture\n" )MutableStringAppendString( s, @"fn AppToolbarBuild( _shellWindow )                  // Search, New, Save, Delete, Refresh (App Toolbar.incl)\n" )MutableStringAppendString( s, @"AppToolbarWatchEdits( @fn AppPageUpdateToolbar )    // typing in the Form turns Save on at once\n\n" )index = 0for resource in modelResourcesname   = fn DictionaryObjectForKey( resource, @"name" )prefix = fn XibResourcePrefix( name )MutableStringAppendString( s, fn StringWithFormat( @"// %@: the Form in a card at the bottom, the List in a card above it, filling the rest; both span the width\n", name ) )MutableStringAppendString( s, fn StringWithFormat( @"formH = _%@ViewHeight + _shellCardPadding * 2 + _shellCardTitleHeight\n", prefix ) )MutableStringAppendString( s, fn StringWithFormat( @"fn ShellCard( _%@View, fn CGRectMake( 0, 0, content.size.width, formH ), NSViewWidthSizable + NSViewMaxYMargin, @\"%@ Details\" )\n", prefix, fn AppQuote( fn TypeMapDefaultTitle( name ) ) ) )MutableStringAppendString( s, fn StringWithFormat( @"nibview _%@View, @\"%@\", , ( 0, 0 ), _shellContent\n", prefix, fn DictionaryObjectForKey( resource, @"formNib" ) ) )MutableStringAppendString( s, fn StringWithFormat( @"fn ShellPlacePart( _%@View, fn CGRectMake( 0, 0, content.size.width, formH ), NSViewWidthSizable + NSViewMaxYMargin )\n", prefix ) )MutableStringAppendString( s, @"listY = formH + _shellCardGap\n" )MutableStringAppendString( s, fn StringWithFormat( @"fn ShellCard( _%@List, fn CGRectMake( 0, listY, content.size.width, content.size.height - listY ), NSViewWidthSizable + NSViewHeightSizable, @\"%@ List\" )\n", prefix, fn AppQuote( fn TypeMapDefaultTitle( name ) ) ) )MutableStringAppendString( s, fn StringWithFormat( @"nibview _%@List, @\"%@\", , ( 0, listY ), _shellContent\n", prefix, fn DictionaryObjectForKey( resource, @"listNib" ) ) )MutableStringAppendString( s, fn StringWithFormat( @"fn ShellPlacePart( _%@List, fn CGRectMake( 0, listY, content.size.width, content.size.height - listY ), NSViewWidthSizable + NSViewHeightSizable )\n", prefix ) )MutableStringAppendString( s, fn StringWithFormat( @"fn %@FormSetUp                                 // its value-list Dropdowns\n", name ) )MutableStringAppendString( s, fn StringWithFormat( @"fn ShellAddNavItem( @\"%@\", @\"%@\", @[ fn NumberWithInteger( _%@List ), fn NumberWithInteger( _%@View ), fn NumberWithInteger( _%@List + _shellCardTagOffset ), fn NumberWithInteger( _%@View + _shellCardTagOffset ) ] )\n", fn AppQuote( fn TypeMapDefaultTitle( name ) ), fn AppQuote( fn DictionaryObjectForKey( resource, @"icon" ) ), prefix, prefix, prefix, prefix ) )MutableStringAppendString( s, fn StringWithFormat( @"fn RecordTilesBuild( %ld, _%@List )                // the Grid / Tiles switch, and the tiles' area (Record Tiles.incl)\n", index, prefix ) )MutableStringAppendString( s, fn StringWithFormat( @"MutableArrayAddObject( gAppPageEntities, @\"%@\" )\n\n", name ) )index++nextMutableStringAppendString( s, @"fn ShellSetPageShownHandler( @fn AppPageShown )     // App Shell.incl tells us when a page is shown\n" )MutableStringAppendString( s, @"fn AppDataSetHandler( @fn AppDataDone )             // App Data answers here\n" )MutableStringAppendString( s, @"fn ShellShowLogin( fn AppDataNeedsLogin )           // Log In only where there is a server to sign in to\n" )MutableStringAppendString( s, @"end fn\n\n\n" )// AppPagesDoDialogMutableStringAppendString( s, @"// the page actions and a row chosen in a List.  YES when the event was a page's.\n" )MutableStringAppendString( s, @"local fn AppPagesHandleDialog( ev as long, tag as long, wnd as long ) as BOOL\n" )MutableStringAppendString( s, @"long          row, tile\nlong          pageIndex = gShellCurrentPage\nCFArrayRef      records\nCFDictionaryRef aRecord\n\n" )MutableStringAppendString( s, @"// the toolbar (App Toolbar.incl): Search, New, Delete, Refresh\n" )MutableStringAppendString( s, @"if ( ev == _toolbarItemClick )\nselect ( tag )\n" )MutableStringAppendString( s, @"case _appToolbarSearch  : fn AppToolbarSearch( fn AppPageTitle, fn AppPageSearchFields, fn DictionaryObjectForKey( gAppPageRecords, fn AppPageEntity ), @fn AppPageSearchChanged )\n" )MutableStringAppendString( s, @"case _appToolbarNew     : fn AppPageNew\ncase _appToolbarSave    : fn AppPageSave\ncase _appToolbarDelete  : fn AppPageDelete\ncase _appToolbarRefresh : fn AppPageRefresh\nend select\nexit fn = YES\nend if\n" )MutableStringAppendString( s, @"// a Dropdown chosen (or cleared): its info button follows (Record Popover.incl)\nif ( ev == _btnClick ) then fn RecordPopoverRefresh\n" )MutableStringAppendString( s, @"// a radio button: the others of its field go off (Binding Support.incl)\n" )MutableStringAppendString( s, @"if ( ev == _btnClick ) then if ( fn BindingRadioClicked( tag ) ) then exit fn = YES\n" )MutableStringAppendString( s, @"// a lookup's info button: the chosen parent's details in a popover (Record Popover.incl)\n" )MutableStringAppendString( s, @"if ( ev == _btnClick ) then if ( fn RecordPopoverClicked( tag ) ) then exit fn = YES\n" )MutableStringAppendString( s, @"// a tile clicked: its record in the Form, as a row would; or the Grid / Tiles switch (Record Tiles.incl)\n" )MutableStringAppendString( s, @"if ( ev == _btnClick )\ntile = fn RecordTilesClicked( tag )\nif ( tile == -2 ) then exit fn = YES\nif ( tile >= 0 )\n" )MutableStringAppendString( s, @"records = fn AppPageRecordsShown\nif ( tile >= fn ArrayCount( records ) ) then exit fn = YES\n" )MutableStringAppendString( s, @"fn AppPageGoTo( tile )                    // the same record in the List, the Form and the navigator\nexit fn = YES\nend if\nend if\n" )MutableStringAppendString( s, @"if ( ev == _btnClick )\nselect ( tag )\n" )MutableStringAppendString( s, @"case _shellNewButton\nfn AppPageNew\nexit fn = YES\n" )MutableStringAppendString( s, @"case _shellSaveButton\nfn AppPageSave\nexit fn = YES\n" )MutableStringAppendString( s, @"case _shellDeleteButton\nfn AppPageDelete\nexit fn = YES\n" )MutableStringAppendString( s, @"case _shellRefreshButton\nfn AppPageRefresh\nexit fn = YES\n" )MutableStringAppendString( s, @"// the record navigator (App Shell.incl dims what does not apply)\n" )MutableStringAppendString( s, @"case _shellFirstButton\nfn AppPageGoTo( 0 )\nexit fn = YES\n" )MutableStringAppendString( s, @"case _shellPreviousButton\nfn AppPageGoTo( gAppPageRow - 1 )\nexit fn = YES\n" )MutableStringAppendString( s, @"case _shellNextButton\nfn AppPageGoTo( gAppPageRow + 1 )\nexit fn = YES\n" )MutableStringAppendString( s, @"case _shellLastButton\nfn AppPageGoTo( fn ArrayCount( fn AppPageRecordsShown ) - 1 )\nexit fn = YES\n" )MutableStringAppendString( s, @"end select\nexit fn = NO\nend if\n\n" )MutableStringAppendString( s, @"if ( ev != _tableViewSelectionDidChange ) then exit fn = NO\n" )MutableStringAppendString( s, @"if ( pageIndex < 0 || tag != fn AppPageTable( pageIndex ) ) then exit fn = NO\n" )MutableStringAppendString( s, @"row = fn TableViewSelectedRow( tag )\n" )MutableStringAppendString( s, @"records = fn AppPageRecordsShown              // the List shows these (the search narrows it)\n" )MutableStringAppendString( s, @"if ( row < 0 ) then exit fn = YES\n" )MutableStringAppendString( s, @"if ( row >= fn ArrayCount( records ) ) then exit fn = YES\n" )MutableStringAppendString( s, @"aRecord = fn ArrayObjectAtIndex( records, row )\n" )MutableStringAppendString( s, @"gAppPageKeys = fn DataKept( fn AppDataKeyValues( fn AppPageEntity, aRecord ), gAppPageKeys )   // Save and Delete act on this record (kept: they come later)\n" )MutableStringAppendString( s, @"gAppPageRow = row\n" )MutableStringAppendString( s, @"fn AppPageShowRecord( pageIndex, aRecord )\n" )MutableStringAppendString( s, @"fn ShellSetNavigator( row, fn ArrayCount( records ) )   // a row clicked, or the arrow keys: the navigator follows\n" )MutableStringAppendString( s, @"fn RecordTilesSelect( pageIndex, row )                  // and the ring in the tiles\n" )MutableStringAppendString( s, @"end fn = YES\n\n\n" )MutableStringAppendString( s, @"// every event: handled, then the toolbar told what applies now (a change in the Form, a record shown)\n" )MutableStringAppendString( s, @"local fn AppPagesDoDialog( ev as long, tag as long, wnd as long ) as BOOL\nBOOL handled = fn AppPagesHandleDialog( ev, tag, wnd )\nfn AppPageUpdateToolbar\nend fn = handled\n\n\n" )// AppPagesDoMenuMutableStringAppendString( s, @"// the Records menu: the same actions as the footer's buttons\n" )MutableStringAppendString( s, @"local fn AppPagesDoMenu( menuID as long, itemID as long ) as BOOL\n" )MutableStringAppendString( s, @"if ( menuID != _shellMenuRecords ) then exit fn = NO\nselect ( itemID )\n" )MutableStringAppendString( s, @"case _shellItemNew     : fn AppPageNew\ncase _shellItemSave    : fn AppPageSave\n" )MutableStringAppendString( s, @"case _shellItemDelete  : fn AppPageDelete\ncase _shellItemRefresh : fn AppPageRefresh\n" )MutableStringAppendString( s, @"end select\nend fn = YES\n" )end fn = s/* *   README.md in the generated project (regenerated): a developer's tour - which file does *   what, which are regenerated and which are yours, how a save and the rules work. */local fn AppDeveloperReadme( projectLabel as CFStringRef, edition as CFStringRef ) as CFStringRefCFMutableStringRef s = fn MutableStringNewMutableStringAppendString( s, fn StringWithFormat( @"# %@ - developer notes\n\n", projectLabel ) )MutableStringAppendString( s, @"A native Mac app in FutureBasic, generated by App Builder for FutureBasic\n" )MutableStringAppendString( s, @"from a data model. Open `" )MutableStringAppendString( s, fn StringWithFormat( @"%@.fbeproj` in FutureBasic and build it.\n\n", projectLabel ) )MutableStringAppendString( s, fn StringWithFormat( @"**Edition:** %@.\n\n", fn EditionDescription( edition ) ) )MutableStringAppendString( s, @"## How it starts\n\n`" )MutableStringAppendString( s, fn StringWithFormat( @"%@.main` registers the event handlers, opens the project's SQLite database\n", projectLabel ) )MutableStringAppendString( s, @"(`DataOpen`), declares the business rules (`DeclareStudioRules`, `DeclareRules`), activates them\n" )MutableStringAppendString( s, @"(`LogicActivate`), builds the menus and the window, and runs FutureBasic's event loop.\n\n" )MutableStringAppendString( s, @"## The files, by group\n\n| Group | File | Regenerated? | What it does |\n|---|---|---|---|\n" )MutableStringAppendString( s, @"| Runtime | `Data SQLite.incl` | yes | SQLite: open, statements, values, transactions (`DataBegin` / `DataEnd`) |\n" )MutableStringAppendString( s, @"| | `DataObject*.incl/.glbl` | yes | the query builder: SQL from a description of the statement |\n" )MutableStringAppendString( s, @"| | `Data Model.incl`, `Data Records.incl` | yes | the entities (`Model.json`); records: `DataFetch`, `DataParent`, `DataChildren`, `DataInsert`, ... |\n" )MutableStringAppendString( s, @"| | `Logic Rules.incl`, `Logic Row.incl`, `Logic Engine.incl` | yes | LogicBank for FutureBasic: rules declared once, enforced on every save |\n" )MutableStringAppendString( s, @"| | `App Data Lite.incl` | yes | the app's data interface: list, save, delete - over the database and the rules |\n" )MutableStringAppendString( s, @"| | `App Shell.incl` | yes | the window's frame: navigation bar, header, footer, pages, page actions, theme menu |\n" )MutableStringAppendString( s, @"| | `Binding Support.incl` | yes | helpers the bindings use: a value as text, a number, a date, a check box |\n" )MutableStringAppendString( s, @"| Model | `Model Tags.incl` | yes | a named constant for every view and control tag |\n" )MutableStringAppendString( s, @"| Bindings | `<Entity> Binding.incl` | yes | record -> Form, Form -> record, records -> List |\n" )MutableStringAppendString( s, @"| Pages | `App Pages.incl` | yes | a page per entity: its List and Form parts, its navigation button, New / Save / Delete / Refresh |\n" )MutableStringAppendString( s, @"| Resources | `<Entity>Form.xib`, `<Entity>List.xib`, `Model.json`, `Credits.rtf`, `AppLogo.png` | yes | the screens (open them in Xcode), the model, the About text, the logo |\n" )MutableStringAppendString( s, @"| Rules | `Studio Rules.incl` | yes | the rules kept in the Studio (Rules.json) |\n" )MutableStringAppendString( s, @"| | `Rules.incl` | **yours** | your own rules, in `DeclareRules` |\n" )MutableStringAppendString( s, @"| Controller | `EventHandlers.incl` | **yours** | what happens on clicks, menus and app events |\n" )MutableStringAppendString( s, @"| View | `Theme.incl` | **yours** | the colours (`ApplyTheme`) |\n" )MutableStringAppendString( s, @"| | `Menus.incl`, `Windows.incl` | **yours** | the menus; the window and its pages |\n" )MutableStringAppendString( s, @"| Main | `" )MutableStringAppendString( s, fn StringWithFormat( @"%@.main` | yes | start-up |\n\n", projectLabel ) )MutableStringAppendString( s, @"Files marked **yours** are written once and never overwritten; delete one to get a fresh copy\n" )MutableStringAppendString( s, @"the next time the app is generated. Change everything else in the Studio, which regenerates it.\n\n" )MutableStringAppendString( s, @"## Screens\n\nEach screen part is a XIB, loaded with FutureBasic's `nibview` (see FutureBasic's reference:\n" )MutableStringAppendString( s, @"`nibwindow`, `nibview`, `nibtoolbar`, `nibmenu`, `nibpopover`). `App Pages.incl` loads each entity's\n" )MutableStringAppendString( s, @"List and Form into the shell's content view (`nibview tag, name, , ( x, y ), _shellContent`).\n\n" )MutableStringAppendString( s, @"## Saving data\n\nThe pages ask App Data, never the database: `AppDataList`, `AppDataSave`, `AppDataRemove`,\n" )MutableStringAppendString( s, @"and the answer comes back in `AppDataDone` (App Pages.incl). Your own code can save the same way,\n" )MutableStringAppendString( s, @"or call the rules engine directly - never with SQL of your own:\n\n```\n" )MutableStringAppendString( s, @"if ( fn LogicInsert( @\"Customer\", fn CustomerFormToRecord ) == NO ) then alert 1, NSAlertStyleWarning, fn LogicMessage, @\"\", @[@\"OK\"], NO\n```\n\n" )MutableStringAppendString( s, @"Each save is one transaction: formulas, sums and counts, constraints and events run in order,\n" )MutableStringAppendString( s, @"and a refused save changes nothing. `LogicMessage` says why. With `isLoggingOn` (App Globals.glbl) the NSLog window\n" )MutableStringAppendString( s, @"shows every rule as it runs.\n\n" )MutableStringAppendString( s, @"## Coding rules\n\nTyped return values (`local fn X as Type`), `//` comments, CR line endings, view tags (not window\n" )MutableStringAppendString( s, @"tags) for `View...` functions. The generated code follows them; please keep to them in yours.\n" )end fn = slocal fn AppMainProgram( projectLabel as CFStringRef, edition as CFStringRef, hostURL as CFStringRef, userName as CFStringRef ) as CFStringRefCFMutableStringRef s = fn MutableStringNewMutableStringAppendString( s, fn StringWithFormat( @"/*\n *   %@\n *\n", projectLabel ) )MutableStringAppendString( s, @" *   The start of the app.  Generated by App Builder for FutureBasic;\n" )MutableStringAppendString( s, @" *   regenerating overwrites it.  Your code goes in EventHandlers.incl, Menus.incl,\n" )MutableStringAppendString( s, @" *   Windows.incl, Theme.incl and Rules.incl, which are never overwritten.\n *\n" )MutableStringAppendString( s, fn StringWithFormat( @" *   Edition: %@\n", fn EditionDescription( edition ) ) )MutableStringAppendString( s, @" *   Developer notes: README.md in this folder is a tour of the project.\n */\n\n" )MutableStringAppendString( s, @"// logging: isLoggingOn in App Globals.glbl (NO by default; every NSLog is gated on it)\n\n" )MutableStringAppendString( s, @"// handlers are in EventHandlers.incl\n" )MutableStringAppendString( s, @"on appevent fn DoAppEvent\n" )MutableStringAppendString( s, @"on menu fn DoMenu\n" )MutableStringAppendString( s, @"on dialog fn DoDialog\n\n" )MutableStringAppendString( s, fn EditionMainStart( edition, hostURL, userName ) )MutableStringAppendString( s, @"\n// the window: the app shell with a page per entity\n" )MutableStringAppendString( s, @"fn BuildMenus                          // Menus.incl\n" )MutableStringAppendString( s, fn StringWithFormat( @"fn BuildWindows( @\"%@\" )   // Windows.incl\n\n", fn AppQuote( projectLabel ) ) )MutableStringAppendString( s, @"HandleEvents\n" )end fn = s// the project file: one FB editor group per concern, in build orderlocal fn AppProjectFile( projectLabel as CFStringRef, edition as CFStringRef, modelResources as CFArrayRef, hasCredits as BOOL, hasLogo as BOOL ) as CFStringRefCFMutableStringRef s = fn MutableStringNewCFDictionaryRef    resourceCFArrayRef         runtimeFiles = fn AppRuntimeFiles( edition )CFStringRef        runtimeFileMutableStringAppendString( s, @"// \"Headers\" 1\ninclude \"App Headers.incl\"\n// \"Globals\" 1\ninclude \"App Globals.glbl\"\n" )   // FB's own headers, included from source (App Headers.incl)MutableStringAppendString( s, @"// \"Runtime\" 1\n" )for runtimeFile in runtimeFilesMutableStringAppendString( s, fn StringWithFormat( @"include \"%@\"\n", runtimeFile ) )nextMutableStringAppendString( s, @"// \"Model\" 1\ninclude \"Model Tags.incl\"\n" )MutableStringAppendString( s, @"// \"Bindings\" 1\n" )for resource in modelResourcesMutableStringAppendString( s, fn StringWithFormat( @"include \"%@ Binding.incl\"\n", fn DictionaryObjectForKey( resource, @"name" ) ) )nextMutableStringAppendString( s, @"// \"Pages\" 1\ninclude \"App Pages.incl\"\n" )MutableStringAppendString( s, @"// \"Resources\" 1\nresources \"Model.json\"\n" )if ( hasCredits ) then MutableStringAppendString( s, @"resources \"Credits.rtf\"\n" )if ( hasLogo ) then MutableStringAppendString( s, @"resources \"AppLogo.png\"\n" )for resource in modelResourcesMutableStringAppendString( s, fn StringWithFormat( @"resources \"%@.xib\"\n", fn DictionaryObjectForKey( resource, @"formNib" ) ) )MutableStringAppendString( s, fn StringWithFormat( @"resources \"%@.xib\"\n", fn DictionaryObjectForKey( resource, @"listNib" ) ) )next// the business rules run in the app only where the edition says so (Lite); Professional runs them on the serverif ( fn EditionRulesInApp( edition ) ) then MutableStringAppendString( s, @"// \"Rules\" 1\ninclude \"Studio Rules.incl\"\ninclude \"Rules.incl\"\n" )MutableStringAppendString( s, @"// \"Controller\" 1\ninclude \"EventHandlers.incl\"\n" )MutableStringAppendString( s, @"// \"View\" 1\ninclude \"Theme.incl\"\ninclude \"Menus.incl\"\ninclude \"Windows.incl\"\n" )MutableStringAppendString( s, fn StringWithFormat( @"// \"Main\" 1\ninclude \"%@.main\"\n", projectLabel ) )end fn = s// <project>.fbeproj: Settings2.plist from the template (only when missing - the// developer's build settings survive regeneration) and a generated data.fbprojlocal fn AppWriteProject( projectLabel as CFStringRef, edition as CFStringRef, modelResources as CFArrayRef, folderURL as CFURLRef, hasCredits as BOOL, hasLogo as BOOL ) as BOOLCFURLRef projectURL  = fn URLByAppendingPathComponent( folderURL, fn StringWithFormat( @"%@.fbeproj", projectLabel ) )if ( fn FileManagerFileExistsAtURL( projectURL ) == NO ) then fn FileManagerCreateDirectoryAtURL( projectURL, YES, NULL )if ( fn AppCopyTemplateFile( @"Project", @"Settings2.plist", projectURL ) == NO ) then exit fn = NOend fn = fn AppWriteSource( fn AppProjectFile( projectLabel, edition, modelResources, hasCredits, hasLogo ), projectURL, @"data.fbproj" )/* *   the whole pipeline - returns YES when every file was written */// the four generation commandsbegin enum 1_genXIBs          // every entity's Form and List parts_genXIB           // one entity's parts_genBinding       // <Entity> Binding.incl for every entity_genApp           // all of it: parts, binding code, Model.json, main program, runtimeend enumlocal fn AppGenerate( projectDict as CFDictionaryRef, folderURL as CFURLRef, projectLabel as CFStringRef, hostURL as CFStringRef, userName as CFStringRef, what as long, onlyName as CFStringRef ) as BOOLCFMutableArrayRef modelResources = fn MutableArrayNewCFStringRef       only = NULLCFStringRef       about = fn DictionaryObjectForKey( projectDict, @"about" )CFStringRef       tagline = fn DictionaryObjectForKey( projectDict, @"tagline" )CFStringRef       copyright = fn DictionaryObjectForKey( projectDict, @"copyright" )CFStringRef       logoPath = fn DictionaryObjectForKey( projectDict, @"logoPath" )CFStringRef       appSymbol = fn DictionaryObjectForKey( projectDict, @"appSymbol" )CFURLRef          logoURLBOOL              hasLogo = NOCFStringRef       databasePath = fn DictionaryObjectForKey( projectDict, @"source" )CFStringRef       edition = fn EditionOfProject( projectDict )CFStringRef       refusalCFArrayRef        runtimeFiles = fn AppRuntimeFiles( edition )CFStringRef       runtimeFilelong              xibCountBOOL              ok = YESif ( fn StringHasSuffix( hostURL, @"/" ) ) then hostURL = fn StringSubstringToIndex( hostURL, fn StringLength( hostURL ) - 1 )if ( what == _genXIB ) then only = onlyNamefn GenerateProgressStep( 0 )                                    // Generate App's progress sheet (Generate Progress.incl)xibCount = fn XibGenerateProject( projectDict, folderURL, projectLabel, modelResources, ( what != _genBinding ), only )if ( fn ArrayCount( modelResources ) == 0 ) then exit fn = NOif ( what == _genXIBs || what == _genXIB ) then exit fn = ( xibCount > 0 )fn GenerateProgressStep( 1 )if ( fn BindingGenerateProject( modelResources, folderURL, NULL ) == 0 ) then ok = NOif ( what == _genBinding ) then exit fn = ok// the runtime and the templates come from the workspace (installed from the repository once)fn GenerateProgressStep( 2 )if ( fn StudioLibraryReady == NO ) then exit fn = NOif ( about == NULL ) then about = @""if ( tagline == NULL ) then tagline = @""if ( appSymbol == NULL ) then appSymbol = @"building.2"if ( copyright == NULL || fn StringLength( copyright ) == 0 ) then copyright = fn StringWithFormat( @"© %@", projectLabel )// the app's logo (Project Settings): AppLogo.png beside the project, listed as a resourcelogoURL = fn URLByAppendingPathComponent( folderURL, @"AppLogo.png" )if ( fn FileManagerFileExistsAtURL( logoURL ) ) then fn FileManagerRemoveItemAtURL( logoURL )if ( logoPath != NULL )if ( fn FileManagerFileExistsAtURL( fn URLFileURLWithPath( logoPath ) ) ) then hasLogo = fn FileManagerCopyItemAtURL( fn URLFileURLWithPath( logoPath ), logoURL )end if// the data runtime works on the project's SQLite copy; an ALS model (metadata JSON, models.py,// app_model.yaml, admin.yaml) is no databaseif ( databasePath == NULL ) then databasePath = @""if ( fn StringIsEqual( fn StringLowercaseString( fn StringPathExtension( databasePath ) ), @"json" ) ) then databasePath = @""if ( fn StringIsEqual( fn StringLowercaseString( fn StringPathExtension( databasePath ) ), @"py" ) ) then databasePath = @""if ( fn StringIsEqual( fn StringLowercaseString( fn StringPathExtension( databasePath ) ), @"yaml" ) ) then databasePath = @""if ( fn StringIsEqual( fn StringLowercaseString( fn StringPathExtension( databasePath ) ), @"yml" ) ) then databasePath = @""// can this edition make an app of this project?  (Lite: it needs the SQLite database)refusal = fn EditionRefusal( edition, ( fn StringLength( databasePath ) > 0 ) )if ( refusal != NULL )alert 1, NSAlertStyleInformational, @"The app was not generated.", refusal, @[@"OK"], NOexit fn = NOend iffn GenerateProgressStep( 3 )ok = fn AppWriteModel( modelResources, folderURL, projectLabel, about, databasePath ) && okif ( fn AppWriteCredits( about, folderURL ) == NO ) then ok = NOfn GenerateProgressStep( 4 )if ( fn AppWriteSource( fn AppMainProgram( projectLabel, edition, hostURL, userName ), folderURL, fn StringWithFormat( @"%@.main", projectLabel ) ) == NO ) then ok = NOif ( fn AppWriteProject( projectLabel, edition, modelResources, folderURL, ( fn StringLength( about ) > 0 ), hasLogo ) == NO ) then ok = NOfn GenerateProgressStep( 5 )if ( fn AppCopyTemplateFile( @"App", @"App Globals.glbl", folderURL ) == NO ) then ok = NOif ( fn AppCopyTemplateFile( @"App", @"EventHandlers.incl", folderURL ) == NO ) then ok = NOif ( fn AppCopyTemplateFile( @"App", @"Menus.incl", folderURL ) == NO ) then ok = NOif ( fn AppCopyTemplateFile( @"App", @"Rules.incl", folderURL ) == NO ) then ok = NOif ( fn AppWriteSourceIfMissing( @"// Studio Rules.incl - generated from the project's Rules.json\n\nvoid local fn DeclareStudioRules\nend fn\n", folderURL, @"Studio Rules.incl" ) == NO ) then ok = NOif ( fn AppWriteSourceIfMissing( fn AppWindowsSource, folderURL, @"Windows.incl" ) == NO ) then ok = NOif ( fn AppCopyTemplateFile( @"App", @"Theme.incl", folderURL ) == NO ) then ok = NOfn GenerateProgressStep( 6 )if ( fn AppWriteSource( fn AppPagesSource( modelResources, tagline, copyright, appSymbol ), folderURL, @"App Pages.incl" ) == NO ) then ok = NO// App Headers.incl: FutureBasic's own headers, included from source so FB finds them in its// Headers folder (listed as project items, FB looks beside the project and crashes)if ( fn AppWriteSource( @"// App Headers.incl - FutureBasic's own headers, from your FB install (never copied)\n\ninclude \"NSLog.incl\"\n", folderURL, @"App Headers.incl" ) == NO ) then ok = NO// README.md: a developer's tour of the project (LF line endings: it is Markdown)fn StringWriteToURL( fn AppDeveloperReadme( projectLabel, edition ), fn URLByAppendingPathComponent( folderURL, @"README.md" ), YES, NSUTF8StringEncoding, NULL )fn GenerateProgressStep( 7 )for runtimeFile in runtimeFilesif ( fn AppCopyRuntimeFile( runtimeFile, folderURL ) == NO ) then ok = NOnextif (isLoggingOn) then NSLog( @"Generated %@: %ld views, %@", projectLabel, xibCount, fn URLPath( folderURL ) )end fn = ok