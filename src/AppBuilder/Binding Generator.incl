/* *   I M A G E R Y    B U S I N E S S     S Y S T E M S,   L L C * *   Binding Generator * *   Writes one readable "<Entity> Binding.incl" per entity: the code that moves a *   record (a dictionary keyed by attribute name) to and from the entity's Form *   part and fills its List part. Every control is named by its tag constant from *   Model Tags.incl, so the generated code reads like hand-written FB. The helpers *   it calls (BindingShow..., BindingTake...) are in src/Runtime/Binding Support.incl. * *   Choices: <Entity>FormSetUp fills the Dropdowns that offer a value list (once, when the page *   is built) and registers each lookup Dropdown's info button (the parent's details, Record Popover.incl); *   <Entity>Lookups names the tables whose rows the Form's other Dropdowns offer, and *   <Entity>FillLookup fills them when App Data answers. */// FB source files use classic-Mac line endingslocal fn BindingWriteSource( source as CFStringRef, folderURL as CFURLRef, fileName as CFStringRef ) as BOOLErrorRef err = NULLCFURLRef url = fn URLByAppendingPathComponent( folderURL, fileName )BOOL     ok  = fn StringWriteToURL( fn StringByReplacingOccurrencesOfString( source, @"\n", @"\r" ), url, YES, NSUTF8StringEncoding, @err )if ( ok == NO && isLoggingOn ) then NSLog( @"Could not write %@: %@", fn URLPath( url ), fn ErrorLocalizedDescription( err ) )end fn = oklocal fn BindingShowCall( kind as long ) as CFStringRefselect ( kind )case _xibKindInteger, _xibKindDecimal : exit fn = @"BindingShowNumber"case _xibKindDate                     : exit fn = @"BindingShowDate"case _xibKindTime                     : exit fn = @"BindingShowTime"case _xibKindDateTime                 : exit fn = @"BindingShowDateTime"case _xibKindCheckbox                 : exit fn = @"BindingShowCheck"case _xibKindDropdown                 : exit fn = @"BindingShowChoice"case _xibKindAutoComplete             : exit fn = @"AutoCompleteShow"end selectend fn = @"BindingShowText"local fn BindingTakeCall( kind as long ) as CFStringRefselect ( kind )case _xibKindInteger  : exit fn = @"BindingTakeInteger"case _xibKindDecimal  : exit fn = @"BindingTakeDecimal"case _xibKindDate     : exit fn = @"BindingTakeDate"case _xibKindTime     : exit fn = @"BindingTakeTime"case _xibKindDateTime : exit fn = @"BindingTakeDateTime"case _xibKindCheckbox : exit fn = @"BindingTakeCheck"case _xibKindDropdown : exit fn = @"BindingTakeChoice"case _xibKindAutoComplete : exit fn = @"AutoCompleteTake"end selectend fn = @"BindingTakeText"// @[ @"Retail", @"Wholesale" ] - a value list as FB sourcelocal fn BindingArraySource( values as CFArrayRef ) as CFStringRefCFMutableArrayRef items = fn MutableArrayNewCFStringRef       value, quotedfor value in valuesquoted = fn StringByReplacingOccurrencesOfString( fn StringByReplacingOccurrencesOfString( value, @"\\", @"\\\\" ), @"\"", @"\\\"" )MutableArrayAddObject( items, fn StringWithFormat( @"@\"%@\"", quoted ) )nextend fn = fn StringWithFormat( @"@[ %@ ]", fn ArrayComponentsJoinedByString( items, @", " ) )// a lookup's parent: its shown fields' names and titles, in the model's order, as FB array source// ( @[ ... ], @[ ... ] ) for RecordPopoverRegister - what the info button's popover listslocal fn BindingParentFieldsSource( parentName as CFStringRef, modelResources as CFArrayRef ) as CFStringRefCFDictionaryRef   parentModel, fieldCFArrayRef        fields = NULLCFMutableArrayRef names = fn MutableArrayNewCFMutableArrayRef titles = fn MutableArrayNewfor parentModel in modelResourcesif ( fn StringIsEqual( fn DictionaryObjectForKey( parentModel, @"name" ), parentName ) ) then fields = fn DictionaryObjectForKey( parentModel, @"fields" )nextif ( fields != NULL )for field in fieldsif ( fn NumberIntegerValue( fn DictionaryObjectForKey( field, @"hidden" ) ) == 0 )MutableArrayAddObject( names, fn DictionaryObjectForKey( field, @"name" ) )MutableArrayAddObject( titles, fn DictionaryObjectForKey( field, @"title" ) )end ifnextend ifend fn = fn StringWithFormat( @"%@, %@", fn BindingArraySource( names ), fn BindingArraySource( titles ) )// the source of <Entity> Binding.incl, from the entity's Model.json entry (modelResources: every// entity's, for the parents a lookup's info button shows)local fn BindingSourceForResource( resourceModel as CFDictionaryRef, modelResources as CFArrayRef ) as CFStringRefCFMutableStringRef s = fn MutableStringNewCFStringRef        name = fn DictionaryObjectForKey( resourceModel, @"name" )CFArrayRef         fields = fn DictionaryObjectForKey( resourceModel, @"fields" )CFDictionaryRef    fieldCFStringRef        attrName, constantNameCFDictionaryRef    lookupCFMutableArrayRef  lookupNameslong               kindMutableStringAppendString( s, fn StringWithFormat( @"/*\n *   %@ Binding.incl\n *\n", name ) )MutableStringAppendString( s, @" *   Generated by App Builder for FutureBasic (Generate Binding Code / Generate App).\n" )MutableStringAppendString( s, @" *   Regenerating replaces this file: put hand-written code in a hooks file.\n *\n" )MutableStringAppendString( s, fn StringWithFormat( @" *   A %@ record is a dictionary keyed by attribute name.\n */\n\n", name ) )// record -> formMutableStringAppendString( s, fn StringWithFormat( @"// record -> %@Form\nvoid local fn %@RecordToForm( aRecord as CFDictionaryRef )\n", name, name ) )for field in fieldsattrName     = fn DictionaryObjectForKey( field, @"name" )kind         = fn NumberIntegerValue( fn DictionaryObjectForKey( field, @"kind" ) )constantName = fn XibConstantName( name, attrName )if ( kind == _xibKindRadio )MutableStringAppendString( s, fn StringWithFormat( @"fn BindingShowRadio( %@, %@, aRecord, @\"%@\" )\n", constantName, fn BindingArraySource( fn TypeMapValueParts( fn DictionaryObjectForKey( field, @"values" ), YES ) ), attrName ) )elseif ( kind != _xibKindHidden ) then MutableStringAppendString( s, fn StringWithFormat( @"fn %@( %@, aRecord, @\"%@\" )\n", fn BindingShowCall( kind ), constantName, attrName ) )end ifnextMutableStringAppendString( s, @"end fn\n\n\n" )// form -> recordMutableStringAppendString( s, fn StringWithFormat( @"// %@Form -> record; empty controls are left out (stored as NULL)\n", name ) )MutableStringAppendString( s, @"// read-only and hidden fields are not read back: a save leaves them as they are\n" )MutableStringAppendString( s, fn StringWithFormat( @"local fn %@FormToRecord as CFMutableDictionaryRef\nCFMutableDictionaryRef aRecord = fn MutableDictionaryNew\n", name ) )for field in fieldsattrName     = fn DictionaryObjectForKey( field, @"name" )kind         = fn NumberIntegerValue( fn DictionaryObjectForKey( field, @"kind" ) )constantName = fn XibConstantName( name, attrName )if ( kind == _xibKindRadio )MutableStringAppendString( s, fn StringWithFormat( @"fn BindingTakeRadio( aRecord, @\"%@\", %@, %@ )\n", attrName, constantName, fn BindingArraySource( fn TypeMapValueParts( fn DictionaryObjectForKey( field, @"values" ), YES ) ) ) )elseif ( kind != _xibKindHidden && kind != _xibKindReadOnly ) then MutableStringAppendString( s, fn StringWithFormat( @"fn %@( aRecord, @\"%@\", %@ )\n", fn BindingTakeCall( kind ), attrName, constantName ) )end ifnextMutableStringAppendString( s, @"end fn = aRecord\n\n\n" )// choices: value lists once, lookups when their rows arriveMutableStringAppendString( s, fn StringWithFormat( @"// %@Form: the Dropdowns that offer a value list (called once, when the page is built)\nvoid local fn %@FormSetUp\n", name, name ) )for field in fieldskind = fn NumberIntegerValue( fn DictionaryObjectForKey( field, @"kind" ) )// a value list written into the code: "R = Retail" stores R and shows Retail, like a lookupif ( kind == _xibKindDropdown && fn DictionaryObjectForKey( field, @"values" ) != NULL )if ( fn TypeMapValuesArePairs( fn DictionaryObjectForKey( field, @"values" ) ) )MutableStringAppendString( s, fn StringWithFormat( @"fn BindingSetChoices( %@, %@, %@ )\n", fn XibConstantName( name, fn DictionaryObjectForKey( field, @"name" ) ), fn BindingArraySource( fn TypeMapValueParts( fn DictionaryObjectForKey( field, @"values" ), NO ) ), fn BindingArraySource( fn TypeMapValueParts( fn DictionaryObjectForKey( field, @"values" ), YES ) ) ) )elseMutableStringAppendString( s, fn StringWithFormat( @"fn BindingFillChoices( %@, %@ )\n", fn XibConstantName( name, fn DictionaryObjectForKey( field, @"name" ) ), fn BindingArraySource( fn DictionaryObjectForKey( field, @"values" ) ) ) )end ifend if// a lookup Dropdown's info button: the chosen parent's details in a popover (Record Popover.incl)lookup = fn DictionaryObjectForKey( field, @"lookup" )// an auto-complete: its settings, and local values when it has them (Auto Complete.incl)if ( kind == _xibKindAutoComplete && fn DictionaryObjectForKey( field, @"autocomplete" ) != NULL )MutableStringAppendString( s, fn StringWithFormat( @"fn AutoCompleteAttach( %@, %ld, %ld )\n", fn XibConstantName( name, fn DictionaryObjectForKey( field, @"name" ) ), fn NumberLongValue( fn DictionaryObjectForKey( fn DictionaryObjectForKey( field, @"autocomplete" ), @"minChars" ) ), fn NumberLongValue( fn DictionaryObjectForKey( fn DictionaryObjectForKey( field, @"autocomplete" ), @"maxResults" ) ) ) )if ( fn DictionaryObjectForKey( field, @"values" ) != NULL )MutableStringAppendString( s, fn StringWithFormat( @"fn AutoCompleteSetValues( %@, %@, %@, %@ )\n", fn XibConstantName( name, fn DictionaryObjectForKey( field, @"name" ) ), fn BindingArraySource( fn TypeMapValueParts( fn DictionaryObjectForKey( field, @"values" ), NO ) ), fn BindingArraySource( fn TypeMapValueParts( fn DictionaryObjectForKey( field, @"values" ), YES ) ), fn ArrayObjectAtIndex( @[ @"NO", @"YES" ], fn NumberIntegerValue( fn DictionaryObjectForKey( fn DictionaryObjectForKey( field, @"autocomplete" ), @"allowsOther" ) ) ) ) )end ifend ifif ( ( kind == _xibKindDropdown || kind == _xibKindAutoComplete ) && lookup != NULL && fn NumberIntegerValue( fn DictionaryObjectForKey( field, @"hidden" ) ) == 0 ) then MutableStringAppendString( s, fn StringWithFormat( @"fn RecordPopoverRegister( %@, @\"%@\", %@ )\n", fn XibConstantName( name, fn DictionaryObjectForKey( field, @"name" ) ), fn DictionaryObjectForKey( lookup, @"entity" ), fn BindingParentFieldsSource( fn DictionaryObjectForKey( lookup, @"entity" ), modelResources ) ) )nextMutableStringAppendString( s, @"end fn\n\n\n" )lookupNames = fn MutableArrayNewfor field in fieldslookup = fn DictionaryObjectForKey( field, @"lookup" )if ( lookup != NULL )if ( fn ArrayContainsObject( lookupNames, fn DictionaryObjectForKey( lookup, @"entity" ) ) == NO ) then MutableArrayAddObject( lookupNames, fn DictionaryObjectForKey( lookup, @"entity" ) )end ifnextMutableStringAppendString( s, fn StringWithFormat( @"// the tables whose rows %@Form's Dropdowns offer (App Pages.incl asks App Data for them)\nlocal fn %@Lookups as CFArrayRef\nend fn = %@\n\n\n", name, name, fn BindingArraySource( lookupNames ) ) )MutableStringAppendString( s, fn StringWithFormat( @"// a lookup table's rows arrived: fill the Dropdowns that offer them\nvoid local fn %@FillLookup( lookupEntity as CFStringRef, records as CFArrayRef )\n", name ) )for field in fieldslookup = fn DictionaryObjectForKey( field, @"lookup" )if ( lookup != NULL )kind = fn NumberIntegerValue( fn DictionaryObjectForKey( field, @"kind" ) )if ( kind == _xibKindAutoComplete && fn DictionaryObjectForKey( field, @"autocomplete" ) != NULL )MutableStringAppendString( s, fn StringWithFormat( @"if ( fn StringIsEqual( lookupEntity, @\"%@\" ) ) then fn AutoCompleteSetRecords( %@, records, @\"%@\", @\"%@\" )\n", fn DictionaryObjectForKey( lookup, @"entity" ), fn XibConstantName( name, fn DictionaryObjectForKey( field, @"name" ) ), fn DictionaryObjectForKey( lookup, @"key" ), fn DictionaryObjectForKey( fn DictionaryObjectForKey( field, @"autocomplete" ), @"display" ) ) )elseMutableStringAppendString( s, fn StringWithFormat( @"if ( fn StringIsEqual( lookupEntity, @\"%@\" ) ) then fn BindingFillLookup( %@, records, @\"%@\", @\"%@\" )\n", fn DictionaryObjectForKey( lookup, @"entity" ), fn XibConstantName( name, fn DictionaryObjectForKey( field, @"name" ) ), fn DictionaryObjectForKey( lookup, @"key" ), fn DictionaryObjectForKey( lookup, @"display" ) ) )end ifend ifnextMutableStringAppendString( s, @"end fn\n\n\n" )// records -> listMutableStringAppendString( s, fn StringWithFormat( @"// records -> %@List (column identifier = attribute name)\nvoid local fn %@RecordsToList( records as CFArrayRef )\n", name, name ) )MutableStringAppendString( s, @"CFMutableArrayRef      rows = fn MutableArrayNew\nCFMutableDictionaryRef row\nCFDictionaryRef        aRecord\n\nfor aRecord in records\nrow = fn MutableDictionaryNew\n" )for field in fieldsattrName = fn DictionaryObjectForKey( field, @"name" )kind     = fn NumberIntegerValue( fn DictionaryObjectForKey( field, @"kind" ) )if ( kind != _xibKindHidden ) then MutableStringAppendString( s, fn StringWithFormat( @"MutableDictionarySetObjectForKey( row, fn BindingString( aRecord, @\"%@\" ), @\"%@\" )\n", attrName, attrName ) )nextMutableStringAppendString( s, @"MutableArrayAddObject( rows, row )\nnext\n" )MutableStringAppendString( s, fn StringWithFormat( @"TableViewSetData( _%@ListTable, rows )\nTableViewReloadData( _%@ListTable )\n", fn XibResourcePrefix( name ), fn XibResourcePrefix( name ) ) )// the list is resized when its page is laid out; start at the first row, not where the resize left itMutableStringAppendString( s, fn StringWithFormat( @"if ( fn ArrayCount( rows ) > 0 ) then TableViewScrollRowToVisible( _%@ListTable, 0 )   // start at the first row\nend fn\n", fn XibResourcePrefix( name ) ) )end fn = s// every entity (or just onlyName) -> <Entity> Binding.incl; returns the files writtenlocal fn BindingGenerateProject( modelResources as CFArrayRef, folderURL as CFURLRef, onlyName as CFStringRef ) as longCFDictionaryRef resourceModelCFStringRef     namelong            written = 0for resourceModel in modelResourcesname = fn DictionaryObjectForKey( resourceModel, @"name" )if ( onlyName == NULL || fn StringIsEqual( onlyName, name ) )if ( fn BindingWriteSource( fn BindingSourceForResource( resourceModel, modelResources ), folderURL, fn StringWithFormat( @"%@ Binding.incl", name ) ) ) then written++end ifnextend fn = written