/* *   Generate Progress.incl - Generate App's progress sheet * *   Generate App shows its steps in a sheet on the Studio's window (author, 2026-11-27): each step listed, ticked *   as it is done, the bar moving forward with it; at the end the message says "Generated" and the button, Done, *   closes it.  While it is generating the sheet cannot be closed (Done is dimmed). * *       fn GenerateProgressBegin( @"Generating Northwind", @[ @"Screens", @"Binding code", ... ] ) *       fn GenerateProgressStep( 0 )          // step 0 under way (the ones before it are done) *       fn GenerateProgressFinish( YES, @"Generated" ) *   GenerateProgressStep and GenerateProgressFinish do nothing when no sheet is showing (the other Generate commands). * *   Generation runs on the main thread, start to end, so the sheet is redrawn after each step and held there a moment, *   long enough to read; no events are handled meanwhile (a menu command cannot start a second generation). *   The sheet is Cocoa: no FB tags in it. */// the C functions FB calls, declared for every part of the project (FB compiles in several chunks)BeginCDeclarationvoid GenProgressBegin( CFStringRef heading, CFArrayRef steps );void GenProgressStep( long index );void GenProgressFinish( long ok, CFStringRef message );EndCBeginCFunction@interface ABGenProgress : NSObject@property (strong) NSPanel *panel;@property (strong) NSProgressIndicator *bar;@property (strong) NSTextField *message;@property (strong) NSButton *doneButton;@property (strong) NSMutableArray *icons;@property (strong) NSMutableArray *labels;@property (assign) BOOL active;@property (assign) long current;          // the step under way@end@implementation ABGenProgress- (void)done:(id)sender {    NSWindow *parent = self.panel.sheetParent;    if ( parent ) [parent endSheet:self.panel]; else [self.panel orderOut:nil];    self.active = NO;}@endstatic ABGenProgress *abGenProgress = nil;// a step's mark: waiting, under way, done, failedstatic void ABGenMark( NSUInteger i, int state ) {    NSImageView *icon;    NSString *name = @"circle";    NSColor *tint = NSColor.tertiaryLabelColor;    if ( abGenProgress == nil || i >= abGenProgress.icons.count ) return;    if ( state == 1 ) { name = @"arrow.right.circle.fill"; tint = NSColor.controlAccentColor; }    if ( state == 2 ) { name = @"checkmark.circle.fill"; tint = NSColor.systemGreenColor; }    if ( state == 3 ) { name = @"xmark.circle.fill"; tint = NSColor.systemRedColor; }    icon = abGenProgress.icons[i];    icon.image = [NSImage imageWithSystemSymbolName:name accessibilityDescription:nil];    icon.contentTintColor = tint;    ((NSTextField *)abGenProgress.labels[i]).textColor = ( state == 0 ) ? NSColor.secondaryLabelColor : NSColor.labelColor;}// draw what changed now, and hold it a moment so the step can be read (generation itself is quick)static void ABGenShow( double seconds ) {    NSDate *until = [NSDate dateWithTimeIntervalSinceNow:seconds];    [abGenProgress.panel.contentView displayIfNeeded];    [CATransaction flush];    while ( [until timeIntervalSinceNow] > 0 ) [[NSRunLoop currentRunLoop] runMode:NSModalPanelRunLoopMode beforeDate:until];}void GenProgressBegin( CFStringRef heading, CFArrayRef steps ) {    NSArray *names = (__bridge NSArray *)steps;    NSWindow *parent = NSApp.mainWindow ? NSApp.mainWindow : NSApp.keyWindow;    NSTextField *title;    NSMutableArray *rows = [NSMutableArray array];    NSStackView *list, *stack, *buttons;    if ( abGenProgress == nil ) abGenProgress = [[ABGenProgress alloc] init];    if ( abGenProgress.panel.sheetParent ) [abGenProgress.panel.sheetParent endSheet:abGenProgress.panel];   // one at a time    abGenProgress.icons = [NSMutableArray array];    abGenProgress.labels = [NSMutableArray array];    title = [NSTextField labelWithString:(__bridge NSString *)heading];    title.font = [NSFont boldSystemFontOfSize:15.0];    for ( NSString *name in names ) {        NSImageView *icon = [NSImageView imageViewWithImage:[NSImage imageWithSystemSymbolName:@"circle" accessibilityDescription:nil]];        NSTextField *label = [NSTextField labelWithString:name];        NSStackView *row = [NSStackView stackViewWithViews:@[ icon, label ]];        row.spacing = 8;        [abGenProgress.icons addObject:icon];        [abGenProgress.labels addObject:label];        [rows addObject:row];    }    list = [NSStackView stackViewWithViews:rows];    list.orientation = NSUserInterfaceLayoutOrientationVertical;    list.alignment = NSLayoutAttributeLeading;    list.spacing = 6;    abGenProgress.bar = [[NSProgressIndicator alloc] init];    abGenProgress.bar.style = NSProgressIndicatorStyleBar;    abGenProgress.bar.indeterminate = NO;    abGenProgress.bar.minValue = 0;    abGenProgress.bar.maxValue = names.count > 0 ? names.count : 1;    abGenProgress.bar.doubleValue = 0;    [abGenProgress.bar.widthAnchor constraintEqualToConstant:400].active = YES;    abGenProgress.message = [NSTextField labelWithString:@"Generating…"];    abGenProgress.message.textColor = NSColor.secondaryLabelColor;    abGenProgress.doneButton = [NSButton buttonWithTitle:@"Done" target:abGenProgress action:@selector(done:)];    abGenProgress.doneButton.keyEquivalent = @"\r";    abGenProgress.doneButton.enabled = NO;                         // not while it is generating    buttons = [NSStackView stackViewWithViews:@[ abGenProgress.message, abGenProgress.doneButton ]];    buttons.distribution = NSStackViewDistributionEqualCentering;    [buttons.widthAnchor constraintEqualToConstant:400].active = YES;    stack = [NSStackView stackViewWithViews:@[ title, list, abGenProgress.bar, buttons ]];    stack.orientation = NSUserInterfaceLayoutOrientationVertical;    stack.alignment = NSLayoutAttributeLeading;    stack.spacing = 16;    stack.edgeInsets = NSEdgeInsetsMake( 20, 24, 20, 24 );    abGenProgress.panel = [[NSPanel alloc] initWithContentRect:NSMakeRect( 0, 0, 448, 200 ) styleMask:NSWindowStyleMaskTitled backing:NSBackingStoreBuffered defer:NO];    abGenProgress.panel.contentView = stack;    [abGenProgress.panel setContentSize:stack.fittingSize];    abGenProgress.active = YES;    abGenProgress.current = -1;    if ( parent ) [parent beginSheet:abGenProgress.panel completionHandler:nil];    else { [abGenProgress.panel center]; [abGenProgress.panel makeKeyAndOrderFront:nil]; }    ABGenShow( 0.25 );}// step index under way: the ones before it done, the bar moved forwardvoid GenProgressStep( long index ) {    NSUInteger i;    if ( abGenProgress == nil || !abGenProgress.active || abGenProgress.doneButton.enabled ) return;   // finished: nothing moves    for ( i = 0; i < abGenProgress.icons.count; i++ ) ABGenMark( i, ( (long)i < index ) ? 2 : ( (long)i == index ? 1 : 0 ) );    abGenProgress.bar.doubleValue = index;    abGenProgress.current = index;    ABGenShow( 0.18 );}// the end: every step done (or the one under way failed), the bar full, the message; Done can close it nowvoid GenProgressFinish( long ok, CFStringRef message ) {    NSUInteger i;    if ( abGenProgress == nil || !abGenProgress.active ) return;    if ( ok ) {        for ( i = 0; i < abGenProgress.icons.count; i++ ) ABGenMark( i, 2 );        abGenProgress.bar.doubleValue = abGenProgress.bar.maxValue;    } else if ( abGenProgress.current >= 0 ) {        ABGenMark( (NSUInteger)abGenProgress.current, 3 );          // the step that was under way    }    abGenProgress.message.stringValue = (__bridge NSString *)message;    abGenProgress.message.textColor = ok ? NSColor.labelColor : NSColor.systemRedColor;    abGenProgress.message.font = [NSFont boldSystemFontOfSize:13.0];    abGenProgress.doneButton.enabled = YES;    [abGenProgress.panel makeFirstResponder:abGenProgress.doneButton];    ABGenShow( 0.0 );}EndCtoolbox GenProgressBegin( CFStringRef heading, CFArrayRef steps )toolbox GenProgressStep( long index )toolbox GenProgressFinish( long ok, CFStringRef message )void local fn GenerateProgressBegin( heading as CFStringRef, steps as CFArrayRef )GenProgressBegin( heading, steps )end fnvoid local fn GenerateProgressStep( index as long )GenProgressStep( index )end fnvoid local fn GenerateProgressFinish( ok as BOOL, message as CFStringRef )GenProgressFinish( ok, message )end fn