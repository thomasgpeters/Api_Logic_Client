/* *   Project Workspace.incl * *   Where a project lives, and its settings: * *   ~/Library/Application Support/App Builder for FutureBasic/ *   └── workspace/ *       └── <project>/             the project: everything the generator keeps about it *           ├── Project.json       settings: name, model source, base URL, user name, About text *           ├── Design.json        the designer's adjustments (Project Actions.incl) *           ├── Database/          the project's own copy of its SQLite database (the model source) *           └── FBapp/             the generated FutureBasic app (App Generator.incl) * *   Passwords and tokens are never written here - they belong in the Keychain. */// APP_SUPPORT_FOLDER_NAME, WORKSPACE_FOLDER_NAME and AppSupportFolderURL: Studio Library.incl#define PROJECT_APP_FOLDER_NAME @"FBapp"#define PROJECT_SETTINGS_FILE   @"Project.json"#define PROJECT_DATABASE_FOLDER @"Database"#define ABOUT_TEXT_MAX          250                 // characters of About text deployed with the app// the heading above the pages: the open project's name, or the product's on the Projects page and when no// project is open (the crumb trail's Projects goes back there with the project still open)void local fn ProjectShowHeading( onProjectsPage as BOOL )if ( onProjectsPage || fn StringLength( (CFStringRef)projectName ) == 0 )ControlSetStringValue( _projectHeadingName, APP_DISPLAY_NAME )elseControlSetStringValue( _projectHeadingName, (CFStringRef)projectName )end ifend fn// .../Api_Logic_Client/workspace/<project>/ (created when missing);local fn ProjectFolderURL as CFURLRefCFURLRef apiLogicWorkFolderURL, projectFolderURLapiLogicWorkFolderURL = fn URLByAppendingPathComponent( fn AppSupportFolderURL, WORKSPACE_FOLDER_NAME )projectFolderURL      = fn URLByAppendingPathComponent( apiLogicWorkFolderURL, projectName )if ( fn FileManagerFileExistsAtURL( projectFolderURL ) == NO ) then fn FileManagerCreateDirectoryAtURL( projectFolderURL, YES, NULL )end fn = projectFolderURL// .../workspace/<name> Project/ for a project name as typed - not created// (GrabProjectDetails names the folder the same way)local fn ProjectFolderURLNamed( name as CFStringRef ) as CFURLRefCFURLRef workspaceURL = fn URLByAppendingPathComponent( fn AppSupportFolderURL, WORKSPACE_FOLDER_NAME )end fn = fn URLByAppendingPathComponent( workspaceURL, fn StringWithFormat( @"%@ Project", name ) )// copy a SQLite file and its -wal / -shm companions (uncommitted pages live in the -wal)local fn ProjectCopyDatabaseFiles( srcURL as CFURLRef, dstURL as CFURLRef ) as BOOLCFArrayRef  suffixes = @[ @"", @"-wal", @"-shm" ]CFStringRef suffixCFURLRef    fromURL, toURLfor suffix in suffixesfromURL = fn URLFileURLWithPath( fn StringWithFormat( @"%@%@", fn URLPath( srcURL ), suffix ) )toURL   = fn URLFileURLWithPath( fn StringWithFormat( @"%@%@", fn URLPath( dstURL ), suffix ) )if ( fn FileManagerFileExistsAtURL( toURL ) ) then fn FileManagerRemoveItemAtURL( toURL )if ( fn FileManagerFileExistsAtURL( fromURL ) )if ( fn FileManagerCopyItemAtURL( fromURL, toURL ) == NO )if (isLoggingOn) then NSLog( @"Could not copy %@ to %@", fn URLPath( fromURL ), fn URLPath( toURL ) )exit fn = NOend ifend ifnextend fn = YES/* *   The project keeps its own copy of the database, in <project>/Database/, so the *   project folder is self-contained (backup and restore copy one folder). *   Returns the copy to read the model from - databaseURL itself when it already is *   the project's copy; NULL when the copy failed or the designer cancelled. */local fn ProjectLocalDatabase( databaseURL as CFURLRef, name as CFStringRef ) as CFURLRefCFURLRef        folderURL = fn URLByAppendingPathComponent( fn ProjectFolderURLNamed( name ), PROJECT_DATABASE_FOLDER )CFURLRef        localURL  = fn URLByAppendingPathComponent( folderURL, fn URLLastPathComponent( databaseURL ) )NSModalResponse responseif ( fn StringIsEqual( fn URLPath( databaseURL ), fn URLPath( localURL ) ) ) then exit fn = databaseURLif ( fn FileManagerFileExistsAtURL( folderURL ) == NO ) then fn FileManagerCreateDirectoryAtURL( folderURL, YES, NULL )if ( fn FileManagerFileExistsAtURL( localURL ) )response = alert 1, NSAlertStyleWarning, fn StringWithFormat( @"The project already has a copy of %@.", fn URLLastPathComponent( databaseURL ) ), @"Replace it with the file you chose, or keep the project's copy?", @[@"Keep Project's Copy", @"Replace", @"Cancel"]if ( response == NSAlertFirstButtonReturn ) then exit fn = localURLif ( response != NSAlertSecondButtonReturn ) then exit fn = NULLend ifif ( fn ProjectCopyDatabaseFiles( databaseURL, localURL ) == NO )alert 1, NSAlertStyleWarning, @"Could not copy the database into the project.", fn URLPath( localURL ), @[@"OK"], NOexit fn = NULLend ifif (isLoggingOn) then NSLog( @"Copied %@ into %@", fn URLPath( databaseURL ), fn URLPath( folderURL ) )end fn = localURL// .../workspace/<project>/FBapp/ (created when missing) - the generated applocal fn ProjectAppFolderURL as CFURLRefCFURLRef folderURL = fn URLByAppendingPathComponent( fn ProjectFolderURL, PROJECT_APP_FOLDER_NAME )if ( fn FileManagerFileExistsAtURL( folderURL ) == NO ) then fn FileManagerCreateDirectoryAtURL( folderURL, YES, NULL )end fn = folderURL// the generated app's name (its .fbeproj, .main and window title): the project name// as typed, without the " Project" the heading addslocal fn ProjectAppName as CFStringRefCFStringRef appName = fn ControlStringValue( _projectNameEdit )if ( fn StringLength( appName ) == 0 ) then appName = projectNameend fn = appName// ~/Library is hidden in Finder: reveal the current project's folder (or the workspace)void local fn ShowWorkspaceInFinderCFURLRef folderURL = fn URLByAppendingPathComponent( fn AppSupportFolderURL, WORKSPACE_FOLDER_NAME )if ( fn FileManagerFileExistsAtURL( folderURL ) == NO ) then fn FileManagerCreateDirectoryAtURL( folderURL, YES, NULL )if ( fn StringLength( projectName ) > 0 && fn DictionaryObjectForKey( gProjectDictionary, @"resources" ) != NULL ) then folderURL = fn ProjectFolderURLWorkspaceActivateFileViewerSelectingURLs( @[ folderURL ] )end fn/* *   Project.json - the project's settings: *   { "name": "Northwind", "source": "/path/db.sqlite", "baseURL": "http://...", "userName": "admin", *     "about": "the About box text, at most ABOUT_TEXT_MAX characters", *     "tagline": "the header's line under the app name", "copyright": "the footer's text", *     "logoPath": "<project>/Branding/logo.png", "appSymbol": "building.2" } */// the About text as typed in Project Settings, cut to ABOUT_TEXT_MAXlocal fn ProjectAboutText as CFStringRefCFStringRef about = fn ControlStringValue( _aboutTextEdit )if ( about == NULL ) then exit fn = @""if ( fn StringLength( about ) > ABOUT_TEXT_MAX ) then about = fn StringSubstringToIndex( about, ABOUT_TEXT_MAX )end fn = about// the tag-line as typed, cut to TAGLINE_TEXT_MAXlocal fn ProjectTaglineText as CFStringRefCFStringRef tagline = fn ControlStringValue( _taglineEdit )if ( tagline == NULL ) then exit fn = @""if ( fn StringLength( tagline ) > TAGLINE_TEXT_MAX ) then tagline = fn StringSubstringToIndex( tagline, TAGLINE_TEXT_MAX )end fn = tagline// <project>/Branding/logo.png - the business logo the generated app shows in its headerlocal fn ProjectLogoURL as CFURLRefend fn = fn URLByAppendingPathComponent( fn URLByAppendingPathComponent( fn ProjectFolderURL, BRANDING_FOLDER ), @"logo.png" )// the logo well's picture as a PNG in the project (removed when the well is empty).// Returns the file's path, or NULL when there is no logo.local fn ProjectSaveLogo as CFStringRefImageRef           image = fn ImageViewImage( _logoImageWell )CFURLRef           logoURL = fn ProjectLogoURLBitmapImageRepRef  bitmapCFDataRef          pngErrorRef           err = NULLif ( image == NULL )if ( fn FileManagerFileExistsAtURL( logoURL ) ) then fn FileManagerRemoveItemAtURL( logoURL )exit fn = NULLend if// NSImage -> TIFF -> bitmap -> PNG: a pasted or dragged picture of any type is kept as PNGbitmap = fn BitmapImageRepWithData( fn ImageTIFFRepresentation( image ) )if ( bitmap == NULL ) then exit fn = NULLpng = fn BitmapImageRepRepresentationUsingType( bitmap, NSBitmapImageFileTypePNG, NULL )if ( png == NULL ) then exit fn = NULLfn FileManagerCreateDirectoryAtURL( fn URLByDeletingLastPathComponent( logoURL ), YES, NULL )if ( fn DataWriteToURL( png, logoURL, NSDataWritingAtomic, @err ) == NO )if (isLoggingOn) then NSLog( @"Could not write %@: %@", fn URLPath( logoURL ), fn ErrorLocalizedDescription( err ) )exit fn = NULLend ifend fn = fn URLPath( logoURL )// the app icon's symbol as chosen (the popup lists TypeMapIconChoices)local fn ProjectAppSymbol as CFStringRefCFStringRef symbolName = fn PopUpButtonTitleOfSelectedItem( _appSymbolPopup )if ( symbolName == NULL ) then symbolName = @"building.2"end fn = symbolNamevoid local fn ProjectAppSymbolChosenImageViewSetImage( _appSymbolPreview, fn ImageWithSystemSymbolName( fn ProjectAppSymbol, @"App icon" ) )end fn// show a saved symbol (Project.json); one that is not in the list is added to itvoid local fn ProjectShowAppSymbol( symbolName as CFStringRef )if ( symbolName == NULL ) then symbolName = @"building.2"if ( fn PopUpButtonItemWithTitle( _appSymbolPopup, symbolName ) == NULL ) then PopUpButtonAddItemWithTitle( _appSymbolPopup, symbolName )PopUpButtonSelectItemWithTitle( _appSymbolPopup, symbolName )fn ProjectAppSymbolChosenend fn// the branding typed in Project Settings, into a settings dictionary (Project.json, or the// dictionary AppGenerate reads)void local fn ProjectBrandingIntoDictionary( settings as CFMutableDictionaryRef )CFStringRef logoPath = fn ProjectSaveLogoMutableDictionarySetObjectForKey( settings, fn ProjectTaglineText, @"tagline" )MutableDictionarySetObjectForKey( settings, fn ControlStringValue( _copyrightEdit ), @"copyright" )MutableDictionarySetObjectForKey( settings, fn ProjectAppSymbol, @"appSymbol" )if ( logoPath != NULL )MutableDictionarySetObjectForKey( settings, logoPath, @"logoPath" )elseMutableDictionaryRemoveObjectForKey( settings, @"logoPath" )end ifend fnlocal fn ProjectSettingsFileURL as CFURLRefend fn = fn URLByAppendingPathComponent( fn ProjectFolderURL, PROJECT_SETTINGS_FILE )void local fn ProjectSettingsSaveCFMutableDictionaryRef settings = fn MutableDictionaryNewCFStringRef            source   = fn DictionaryObjectForKey( gProjectDictionary, @"source" )CFDataRef              jsonErrorRef               err = NULLif ( fn StringLength( projectName ) == 0 ) then exit fnMutableDictionarySetObjectForKey( settings, fn ProjectAppName, @"name" )if ( source != NULL ) then MutableDictionarySetObjectForKey( settings, source, @"source" )// an ALS project: where its model came from (a folder, a file or a GitHub address), and its editionif ( fn DictionaryObjectForKey( gProjectDictionary, @"alsSource" ) != NULL ) then MutableDictionarySetObjectForKey( settings, fn DictionaryObjectForKey( gProjectDictionary, @"alsSource" ), @"alsSource" )if ( fn DictionaryObjectForKey( gProjectDictionary, @"edition" ) != NULL ) then MutableDictionarySetObjectForKey( settings, fn DictionaryObjectForKey( gProjectDictionary, @"edition" ), @"edition" )MutableDictionarySetObjectForKey( settings, fn ControlStringValue( _baseURLEdit ), @"baseURL" )MutableDictionarySetObjectForKey( settings, fn ControlStringValue( _authNameEdit ), @"userName" )MutableDictionarySetObjectForKey( settings, fn ProjectAboutText, @"about" )fn ProjectBrandingIntoDictionary( settings )json = fn JSONSerializationDataWithJSONObject( settings, NSJSONWritingPrettyPrinted, @err )if ( json == NULL ) then exit fnif ( fn DataWriteToURL( json, fn ProjectSettingsFileURL, NSDataWritingAtomic, @err ) == NO )if (isLoggingOn) then NSLog( @"Could not write %@: %@", fn URLPath( fn ProjectSettingsFileURL ), fn ErrorLocalizedDescription( err ) )end ifend fn// fill the connection fields the user left empty from the saved settingsvoid local fn ProjectSettingsLoadCFDictionaryRef settingsCFDataRef       jsonCFStringRef     valueErrorRef        err = NULLif ( fn StringLength( projectName ) == 0 ) then exit fnjson = fn DataWithContentsOfURL( fn ProjectSettingsFileURL, 0, @err )if ( json == NULL ) then exit fn                                    // new projectsettings = fn JSONSerializationJSONObjectWithData( json, 0, @err )if ( settings == NULL ) then exit fnvalue = fn DictionaryObjectForKey( settings, @"baseURL" )if ( value != NULL && fn StringLength( fn ControlStringValue( _baseURLEdit ) ) == 0 ) then ControlSetStringValue( _baseURLEdit, value )value = fn DictionaryObjectForKey( settings, @"userName" )if ( value != NULL && fn StringLength( fn ControlStringValue( _authNameEdit ) ) == 0 ) then ControlSetStringValue( _authNameEdit, value )value = fn DictionaryObjectForKey( settings, @"about" )if ( value != NULL && fn StringLength( fn ControlStringValue( _aboutTextEdit ) ) == 0 ) then ControlSetStringValue( _aboutTextEdit, value )value = fn DictionaryObjectForKey( settings, @"tagline" )if ( value != NULL && fn StringLength( fn ControlStringValue( _taglineEdit ) ) == 0 ) then ControlSetStringValue( _taglineEdit, value )value = fn DictionaryObjectForKey( settings, @"copyright" )if ( value != NULL && fn StringLength( fn ControlStringValue( _copyrightEdit ) ) == 0 ) then ControlSetStringValue( _copyrightEdit, value )if ( fn FileManagerFileExistsAtURL( fn ProjectLogoURL ) ) then ImageViewSetImage( _logoImageWell, fn ImageWithContentsOfURL( fn ProjectLogoURL ) )fn ProjectShowAppSymbol( fn DictionaryObjectForKey( settings, @"appSymbol" ) )if (isLoggingOn) then NSLog( @"Loaded %@", fn URLPath( fn ProjectSettingsFileURL ) )end fn